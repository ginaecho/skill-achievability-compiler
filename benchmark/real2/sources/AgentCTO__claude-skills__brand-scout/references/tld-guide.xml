<tld_selection_guide>

<recommendations_by_project_type>

  <project_type id="saas_startup" label="SaaS / Startup">
    <tld>.com</tld>
    <tld>.io</tld>
    <tld>.co</tld>
    <notes>.com is king for credibility; .io popular in tech.</notes>
  </project_type>

  <project_type id="developer_tool" label="Developer Tool">
    <tld>.dev</tld>
    <tld>.io</tld>
    <tld>.sh</tld>
    <notes>.dev requires HTTPS; .sh for CLI/shell tools.</notes>
  </project_type>

  <project_type id="ai_ml_product" label="AI / ML Product">
    <tld>.ai</tld>
    <tld>.com</tld>
    <notes>.ai is trending but expensive ($50-90/yr).</notes>
  </project_type>

  <project_type id="personal_brand" label="Personal Brand">
    <tld>.com</tld>
    <tld>.me</tld>
    <tld>.io</tld>
    <notes>.me is affordable and memorable.</notes>
  </project_type>

  <project_type id="creative_agency" label="Creative Agency">
    <tld>.co</tld>
    <tld>.design</tld>
    <tld>.studio</tld>
    <notes>.co is short and modern.</notes>
  </project_type>

  <project_type id="open_source" label="Open Source">
    <tld>.dev</tld>
    <tld>.org</tld>
    <tld>.io</tld>
    <notes>.org signals community/nonprofit.</notes>
  </project_type>

  <project_type id="api_platform" label="API / Platform">
    <tld>.io</tld>
    <tld>.dev</tld>
    <tld>.app</tld>
    <notes>.app requires HTTPS.</notes>
  </project_type>

  <project_type id="blog_content" label="Blog / Content">
    <tld>.com</tld>
    <tld>.blog</tld>
    <tld>.co</tld>
    <notes>.com preferred for SEO.</notes>
  </project_type>

  <project_type id="ecommerce" label="E-commerce">
    <tld>.com</tld>
    <tld>.store</tld>
    <tld>.shop</tld>
    <notes>.com strongly preferred for buyer trust.</notes>
  </project_type>

</recommendations_by_project_type>

<price_tiers note="Approximate annual registration costs. Renewal prices may differ.">
  <tier label="budget" range="$8-15/yr">.com, .net, .org, .co, .me, .blog</tier>
  <tier label="mid_range" range="$15-40/yr">.io, .dev, .app, .sh, .so</tier>
  <tier label="premium" range="$40-100+/yr">.ai, .design, .studio</tier>
</price_tiers>

<seo_and_trust>
  <consideration tld=".com">.com remains the most trusted and best for organic search.</consideration>
  <consideration tld="ccTLDs" examples=".uk, .de, .ca">Help with local SEO in their respective countries.</consideration>
  <consideration tld="new_gTLDs" examples=".app, .dev">Treated equally by Google but users may perceive them as less trustworthy.</consideration>
  <consideration tld=".io">.io is technically a ccTLD (British Indian Ocean Territory) but widely accepted as tech-focused.</consideration>
  <consideration tld=".ai">.ai is Anguilla's ccTLD but has become synonymous with AI products.</consideration>
</seo_and_trust>

<quick_decision_rules>
  <rule priority="1">Always check .com first — it's the default people type.</rule>
  <rule priority="2">Match your audience — developers recognize .dev/.io; general public prefers .com.</rule>
  <rule priority="3">Consider HTTPS requirements — .dev and .app enforce HTTPS (good practice anyway).</rule>
  <rule priority="4">Budget matters — .ai costs 5-10x more than .com.</rule>
  <rule priority="5">Protect your brand — register .com even if using another TLD as primary.</rule>
</quick_decision_rules>

</tld_selection_guide>
