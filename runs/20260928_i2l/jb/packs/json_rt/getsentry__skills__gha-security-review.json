{
  "name": "gha-security-review",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_workflows": {
      "owner": "agent",
      "pre": "repo_available",
      "add": [
        "workflows_read"
      ]
    },
    "load_references": {
      "owner": "agent",
      "pre": "workflows_read",
      "add": [
        "references_loaded"
      ]
    },
    "search_codebase": {
      "owner": "agent",
      "pre": "workflows_read",
      "add": [
        "attack_paths_traced"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_workflows",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "load_references",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "search_codebase",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "workflows_read",
      "references_loaded",
      "attack_paths_traced"
    ]
  },
  "init_true": [
    "repo_available"
  ],
  "init_constraints": []
}
