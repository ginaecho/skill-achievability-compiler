{
  "name": "supabase-postgres-best-practices",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_rule_files": {
      "owner": "agent",
      "add": [
        "rules_loaded"
      ]
    },
    "write_sql_change": {
      "owner": "agent",
      "pre": "rules_loaded",
      "add": [
        "sql_written"
      ]
    },
    "run_against_local_postgres": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:docker",
          "sql_written"
        ]
      },
      "add": [
        "sql_verified"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_rule_files",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_sql_change",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "verify_locally": [
            {
              "act": {
                "cap": "run_against_local_postgres",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "rules_loaded",
      "sql_written"
    ]
  },
  "init_true": [
    "needs:docker"
  ],
  "init_constraints": []
}
