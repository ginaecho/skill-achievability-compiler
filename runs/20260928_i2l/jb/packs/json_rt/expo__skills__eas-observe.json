{
  "name": "eas-observe",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "fetch_docs": {
      "owner": "agent",
      "add": [
        "docs_consulted"
      ],
      "pre": {
        "and": [
          "needs:public_internet"
        ]
      }
    },
    "inspect_project": {
      "owner": "agent",
      "add": [
        "sdk_version_known"
      ]
    },
    "install_expo_observe": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:package_registries",
          "sdk_version_known"
        ]
      },
      "add": [
        "observe_installed"
      ]
    },
    "wrap_root_and_mark_interactive": {
      "owner": "agent",
      "pre": {
        "and": [
          "observe_installed",
          "sdk_version_known",
          "docs_consulted"
        ]
      },
      "add": [
        "root_wrapped",
        "interactive_marked"
      ]
    },
    "add_navigation_integration": {
      "owner": "agent",
      "pre": "root_wrapped",
      "add": [
        "nav_metrics_enabled"
      ]
    },
    "typecheck": {
      "owner": "agent",
      "pre": {
        "and": [
          "root_wrapped",
          "interactive_marked"
        ]
      },
      "add": [
        "integration_checked"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "fetch_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "inspect_project",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_expo_observe",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "wrap_root_and_mark_interactive",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "nav_metrics": [
            {
              "act": {
                "cap": "add_navigation_integration",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    },
    {
      "act": {
        "cap": "typecheck",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "observe_installed",
      "root_wrapped",
      "interactive_marked",
      "integration_checked"
    ]
  },
  "init_true": [
    "needs:public_internet",
    "needs:package_registries"
  ],
  "init_constraints": []
}
