{
  "name": "acreadiness-assess",
  "roles": [
    "agent",
    "reporter",
    "user"
  ],
  "capabilities": {
    "read_agentrc_config": {
      "owner": "agent",
      "add": [
        "policy_decided"
      ]
    },
    "render_report_html": {
      "owner": "reporter",
      "pre": "scan_json",
      "add": [
        "report_written"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_node_version",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_agentrc_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_readiness_scan",
        "by": "agent"
      }
    },
    {
      "spawn": {
        "role": "reporter"
      }
    },
    {
      "msg": {
        "from": "agent",
        "to": "reporter",
        "label": "scan_json"
      }
    },
    {
      "act": {
        "cap": "render_report_html",
        "by": "reporter"
      }
    },
    {
      "msg": {
        "from": "reporter",
        "to": "agent",
        "label": "report_done"
      }
    }
  ],
  "goal": {
    "and": [
      "scan_json",
      "report_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
