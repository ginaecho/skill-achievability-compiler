{
  "name": "hf-mcp",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {},
  "protocol": [
    {
      "act": {
        "cap": "model_search",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "hub_repo_details",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "run_job": [
            {
              "act": {
                "cap": "hf_jobs_run",
                "by": "agent"
              }
            }
          ],
          "done": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "candidate_models_found",
      "model_details_retrieved"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
