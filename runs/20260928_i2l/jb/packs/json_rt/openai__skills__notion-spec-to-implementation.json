{
  "name": "notion-spec-to-implementation",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_which_spec": {
      "owner": "agent",
      "pre": "spec_found",
      "add": [
        "spec_selected"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "search_spec",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "multiple_hits": [
            {
              "act": {
                "cap": "ask_which_spec",
                "by": "agent"
              }
            }
          ],
          "single_hit": []
        }
      }
    },
    {
      "act": {
        "cap": "fetch_spec",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_plan_page",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "find_task_database",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_tasks",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "update_spec": [
            {
              "act": {
                "cap": "update_spec_implementation_section",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "track": [
            {
              "act": {
                "cap": "update_progress",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "plan_created",
      "plan_linked_to_spec",
      "tasks_created",
      "tasks_linked"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
