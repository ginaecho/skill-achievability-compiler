{
  "name": "agent-framework-azure-ai-py",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "write_agent_code": {
      "owner": "agent",
      "add": [
        "agent_code_written"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_sdk",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_env",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_agent_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_agent",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "agent_code_written",
      "agent_created",
      "agent_response_received"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
