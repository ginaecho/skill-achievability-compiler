{
  "name": "data-designer",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_workflow_file": {
      "owner": "agent",
      "add": [
        "workflow_loaded"
      ]
    },
    "clarify_requirements": {
      "owner": "agent",
      "pre": "workflow_loaded",
      "add": [
        "requirements_known"
      ]
    },
    "write_config_script": {
      "owner": "agent",
      "pre": "workflow_loaded",
      "add": [
        "config_script_written"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "interactive": [
            {
              "act": {
                "cap": "read_workflow_file",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "clarify_requirements",
                "by": "agent"
              }
            }
          ],
          "autopilot": [
            {
              "act": {
                "cap": "read_workflow_file",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "write_config_script",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "cli_missing_install": [
            {
              "act": {
                "cap": "install_data_designer",
                "by": "agent"
              }
            }
          ],
          "cli_present": []
        }
      }
    },
    {
      "act": {
        "cap": "run_preview_generation",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "config_script_written",
      "dataset_generated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
