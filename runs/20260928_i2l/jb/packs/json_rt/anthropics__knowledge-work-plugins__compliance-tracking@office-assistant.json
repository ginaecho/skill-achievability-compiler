{
  "name": "compliance-tracking",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "gather_compliance_context": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      },
      "add": [
        "context_known"
      ]
    },
    "read_control_files": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      },
      "add": [
        "controls_loaded"
      ]
    },
    "research_framework_requirements": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet",
          "context_known"
        ]
      },
      "add": [
        "requirements_known"
      ]
    },
    "write_compliance_tracker": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "context_known"
        ]
      },
      "add": [
        "tracker_written"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "gather_compliance_context",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "has_control_files": [
            {
              "act": {
                "cap": "read_control_files",
                "by": "agent"
              }
            }
          ],
          "no_files": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "research_needed": [
            {
              "act": {
                "cap": "research_framework_requirements",
                "by": "agent"
              }
            }
          ],
          "known_framework": []
        }
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "save_to_file": [
            {
              "act": {
                "cap": "write_compliance_tracker",
                "by": "agent"
              }
            }
          ],
          "in_chat": []
        }
      }
    }
  ],
  "goal": "context_known",
  "init_true": [
    "needs:user_conversation",
    "needs:local_filesystem",
    "needs:public_internet"
  ],
  "init_constraints": []
}
