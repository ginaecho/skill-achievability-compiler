{
  "name": "close-management",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "gather_close_details": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      },
      "add": [
        "close_details_known"
      ]
    },
    "read_status_file": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      },
      "add": [
        "close_details_known"
      ]
    },
    "write_close_tracker": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "close_details_known"
        ]
      },
      "add": [
        "close_plan_written"
      ]
    },
    "update_task_status": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "close_plan_written"
        ]
      },
      "add": [
        "status_tracked"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "existing_tracker_file": [
            {
              "act": {
                "cap": "read_status_file",
                "by": "agent"
              }
            }
          ],
          "describe_in_chat": [
            {
              "act": {
                "cap": "gather_close_details",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "write_close_tracker",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "update_task_status",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "close_plan_written",
      "status_tracked"
    ]
  },
  "init_true": [
    "needs:user_conversation",
    "needs:local_filesystem"
  ],
  "init_constraints": []
}
