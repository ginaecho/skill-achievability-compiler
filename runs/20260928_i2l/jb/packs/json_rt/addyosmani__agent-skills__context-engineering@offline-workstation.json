{
  "name": "context-engineering",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_project": {
      "owner": "agent",
      "pre": true,
      "add": [
        "project_context_loaded"
      ]
    },
    "check_repo_state": {
      "owner": "agent",
      "pre": true,
      "add": [
        "repo_state_known"
      ]
    },
    "clarify_with_user": {
      "owner": "agent",
      "pre": "project_context_loaded",
      "add": [
        "ambiguities_resolved"
      ]
    },
    "write_rules_file": {
      "owner": "agent",
      "pre": "project_context_loaded",
      "add": [
        "rules_file_exists"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_project",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_repo_state",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "ambiguous": [
            {
              "act": {
                "cap": "clarify_with_user",
                "by": "agent"
              }
            }
          ],
          "clear": []
        }
      }
    },
    {
      "act": {
        "cap": "write_rules_file",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "project_context_loaded",
      "rules_file_exists"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
