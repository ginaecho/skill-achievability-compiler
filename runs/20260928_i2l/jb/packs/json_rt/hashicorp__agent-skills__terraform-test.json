{
  "name": "terraform-test",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "install_terraform": {
      "owner": "agent",
      "add": [
        "terraform_installed"
      ],
      "pre": {
        "and": [
          "needs:package_registries"
        ]
      }
    },
    "read_module": {
      "owner": "agent",
      "add": [
        "module_understood"
      ]
    },
    "write_unit_tests": {
      "owner": "agent",
      "pre": "module_understood",
      "add": [
        "unit_tests_written"
      ]
    },
    "run_unit_tests": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet",
          {
            "and": [
              "terraform_installed",
              "unit_tests_written"
            ]
          }
        ]
      },
      "add": [
        "unit_tests_pass"
      ]
    },
    "fix_tests": {
      "owner": "agent",
      "pre": "unit_tests_written",
      "add": [
        "unit_tests_written"
      ],
      "del": [
        "unit_tests_pass"
      ]
    },
    "write_integration_tests": {
      "owner": "agent",
      "pre": "module_understood",
      "add": [
        "integration_tests_written"
      ]
    },
    "run_integration_tests": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:cloud_account",
          {
            "and": [
              "terraform_installed",
              "integration_tests_written"
            ]
          }
        ]
      },
      "add": [
        "integration_tests_run"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_terraform",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_module",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_unit_tests",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "TEST",
        "body": [
          {
            "act": {
              "cap": "run_unit_tests",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "external": true,
              "branches": {
                "pass": [],
                "fail": [
                  {
                    "act": {
                      "cap": "fix_tests",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "TEST"
                  }
                ]
              }
            }
          }
        ]
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "integration": [
            {
              "act": {
                "cap": "write_integration_tests",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "run_integration_tests",
                "by": "agent"
              }
            }
          ],
          "unit_only": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "unit_tests_written",
      "unit_tests_pass"
    ]
  },
  "init_true": [
    "needs:package_registries",
    "needs:public_internet"
  ],
  "init_constraints": []
}
