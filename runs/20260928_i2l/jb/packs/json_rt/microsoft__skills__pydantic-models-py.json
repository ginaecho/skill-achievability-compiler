{
  "name": "pydantic-models-py",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "read_template": {
      "owner": "agent",
      "add": [
        "template_read"
      ]
    },
    "write_models": {
      "owner": "agent",
      "pre": "template_read",
      "add": [
        "models_written"
      ]
    },
    "export_models": {
      "owner": "agent",
      "pre": "models_written",
      "add": [
        "models_exported"
      ]
    },
    "add_typescript_types": {
      "owner": "agent",
      "pre": "models_written",
      "add": [
        "ts_types_added"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_template",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_models",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "export_models",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "add_typescript_types",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "models_written",
      "models_exported",
      "ts_types_added"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
