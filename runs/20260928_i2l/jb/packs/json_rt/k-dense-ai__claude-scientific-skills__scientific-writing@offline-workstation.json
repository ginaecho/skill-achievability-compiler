{
  "name": "scientific-writing",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "intake": {
      "owner": "agent",
      "add": [
        "intake_done"
      ]
    },
    "scaffold_workspace": {
      "owner": "agent",
      "pre": "intake_done",
      "add": [
        "workspace_ready"
      ]
    },
    "select_guidelines": {
      "owner": "agent",
      "pre": "intake_done",
      "add": [
        "guideline_selected"
      ]
    },
    "write_evidence_registries": {
      "owner": "agent",
      "pre": "intake_done",
      "add": [
        "registries_written"
      ]
    },
    "human_verify_sources": {
      "owner": "agent",
      "pre": "registries_written",
      "add": [
        "sources_verified"
      ]
    },
    "draft_manuscript": {
      "owner": "agent",
      "pre": {
        "and": [
          "registries_written",
          "guideline_selected"
        ]
      },
      "add": [
        "draft_written"
      ]
    },
    "run_local_audits": {
      "owner": "agent",
      "pre": {
        "and": [
          "draft_written",
          "sources_verified"
        ]
      },
      "add": [
        "audits_run"
      ]
    },
    "fix_audit_issues": {
      "owner": "agent",
      "pre": "audits_run",
      "add": [
        "draft_revised"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "intake",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "scaffold": [
            {
              "act": {
                "cap": "scaffold_workspace",
                "by": "agent"
              }
            }
          ],
          "no_scaffold": []
        }
      }
    },
    {
      "act": {
        "cap": "select_guidelines",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_evidence_registries",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "human_verify_sources",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "draft_manuscript",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "Audit",
        "body": [
          {
            "act": {
              "cap": "run_local_audits",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "issues_found": [
                  {
                    "act": {
                      "cap": "fix_audit_issues",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "Audit"
                  }
                ],
                "clean": []
              }
            }
          }
        ]
      }
    }
  ],
  "goal": {
    "and": [
      "draft_written",
      "audits_run"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
