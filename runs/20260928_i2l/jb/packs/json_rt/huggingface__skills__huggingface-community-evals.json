{
  "name": "huggingface_community_evals_local",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_prerequisites": {
      "owner": "agent",
      "pre": true,
      "add": [
        "prereqs_checked"
      ]
    },
    "smoke_test_inference_providers": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:hf_token",
          "prereqs_checked"
        ]
      },
      "add": [
        "smoke_test_passed"
      ]
    },
    "full_eval_inference_providers": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:hf_token",
          "smoke_test_passed"
        ]
      },
      "add": [
        "eval_results_produced"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_prerequisites",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "inspect_inference_providers": [
            {
              "act": {
                "cap": "smoke_test_inference_providers",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "full_eval_inference_providers",
                "by": "agent"
              }
            }
          ],
          "local_gpu_vllm_or_fallback": [
            {
              "act": {
                "cap": "smoke_test_local_gpu",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "full_eval_local_gpu",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "smoke_test_passed",
      "eval_results_produced"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
