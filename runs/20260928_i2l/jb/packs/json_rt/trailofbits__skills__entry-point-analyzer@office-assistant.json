{
  "name": "entry-point-analyzer",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_contract_files": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      },
      "add": [
        "contracts_read",
        "language_detected"
      ]
    },
    "write_audit_report": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          {
            "and": [
              "contracts_read",
              "language_detected"
            ]
          }
        ]
      },
      "add": [
        "report_written"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_contract_files",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_audit_report",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "contracts_read",
      "report_written"
    ]
  },
  "init_true": [
    "needs:local_filesystem"
  ],
  "init_constraints": []
}
