{
  "name": "imagegen",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "install_cli_deps": {
      "owner": "agent",
      "add": [
        "cli_deps_installed"
      ],
      "pre": {
        "and": [
          "needs:package_registries"
        ]
      }
    },
    "generate_image_cli": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:openai_api_key",
          "cli_deps_installed"
        ]
      },
      "add": [
        "image_generated"
      ]
    },
    "copy_to_workspace": {
      "owner": "agent",
      "pre": "image_generated",
      "add": [
        "image_in_workspace"
      ]
    },
    "update_references": {
      "owner": "agent",
      "pre": "image_in_workspace",
      "add": [
        "references_updated"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "builtin": [
            {
              "act": {
                "cap": "generate_image_builtin",
                "by": "agent"
              }
            }
          ],
          "explicit_cli": [
            {
              "act": {
                "cap": "install_cli_deps",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "generate_image_cli",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "project_bound": [
            {
              "act": {
                "cap": "copy_to_workspace",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "update_references",
                "by": "agent"
              }
            }
          ],
          "preview_only": []
        }
      }
    }
  ],
  "goal": "image_generated",
  "init_true": [
    "needs:package_registries"
  ],
  "init_constraints": []
}
