{
  "name": "draft-content",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_content_inputs": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      },
      "add": [
        "inputs_gathered"
      ]
    },
    "read_brand_voice_settings": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      },
      "add": [
        "brand_voice_resolved"
      ]
    },
    "ask_brand_voice": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      },
      "add": [
        "brand_voice_resolved"
      ]
    },
    "ask_revision": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation",
          {
            "and": [
              "inputs_gathered",
              "brand_voice_resolved"
            ]
          }
        ]
      },
      "add": [
        "revision_offered"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "inputs_complete": [],
          "inputs_missing": [
            {
              "act": {
                "cap": "ask_content_inputs",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "brand_voice_configured": [
            {
              "act": {
                "cap": "read_brand_voice_settings",
                "by": "agent"
              }
            }
          ],
          "not_configured": [
            {
              "act": {
                "cap": "ask_brand_voice",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "ask_revision",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "inputs_gathered",
      "brand_voice_resolved"
    ]
  },
  "init_true": [
    "inputs_gathered",
    "needs:user_conversation",
    "needs:local_filesystem"
  ],
  "init_constraints": []
}
