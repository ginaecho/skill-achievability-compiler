{
  "name": "fastapi-router-py",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_template": {
      "owner": "agent",
      "add": [
        "template_loaded"
      ],
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      }
    },
    "create_router_file": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "template_loaded"
        ]
      },
      "add": [
        "router_created"
      ]
    },
    "create_pydantic_models": {
      "owner": "agent",
      "add": [
        "models_created"
      ],
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      }
    },
    "mount_router_in_main": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "router_created"
        ]
      },
      "add": [
        "router_mounted"
      ]
    },
    "create_service_layer": {
      "owner": "agent",
      "add": [
        "service_created"
      ],
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      }
    },
    "add_frontend_api_functions": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "router_created"
        ]
      },
      "add": [
        "frontend_api_added"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_template",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_router_file",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "mount_router_in_main",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_pydantic_models",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "service_needed": [
            {
              "act": {
                "cap": "create_service_layer",
                "by": "agent"
              }
            }
          ],
          "no_service": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "frontend": [
            {
              "act": {
                "cap": "add_frontend_api_functions",
                "by": "agent"
              }
            }
          ],
          "skip_frontend": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "router_created",
      "router_mounted",
      "models_created"
    ]
  },
  "init_true": [
    "needs:local_filesystem"
  ],
  "init_constraints": []
}
