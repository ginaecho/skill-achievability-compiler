{
  "name": "claude_settings_audit",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "detect_tech_stack": {
      "owner": "agent",
      "pre": true,
      "add": [
        "stack_detected"
      ]
    },
    "read_dependency_files": {
      "owner": "agent",
      "pre": "stack_detected",
      "add": [
        "frameworks_and_services_detected"
      ]
    },
    "check_existing_settings": {
      "owner": "agent",
      "pre": "stack_detected",
      "add": [
        "existing_settings_checked"
      ]
    },
    "check_existing_mcp_config": {
      "owner": "agent",
      "pre": "stack_detected",
      "add": [
        "mcp_config_checked"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "detect_tech_stack",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_dependency_files",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_existing_settings",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_existing_mcp_config",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "stack_detected",
      "frameworks_and_services_detected",
      "existing_settings_checked",
      "mcp_config_checked"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
