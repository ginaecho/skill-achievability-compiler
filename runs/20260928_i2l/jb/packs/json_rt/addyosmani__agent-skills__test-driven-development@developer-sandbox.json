{
  "name": "test-driven-development",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "discover_test_stack": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      },
      "add": [
        "stack_discovered"
      ]
    },
    "write_failing_test": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "stack_discovered"
        ]
      },
      "add": [
        "test_written"
      ]
    },
    "run_focused_test_red": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:shell",
          "test_written"
        ]
      },
      "add": [
        "test_failed_first"
      ]
    },
    "implement_minimal_code": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "test_failed_first"
        ]
      },
      "add": [
        "code_implemented"
      ],
      "del": [
        "test_passes"
      ]
    },
    "run_focused_test_green": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:shell",
          "code_implemented"
        ]
      },
      "add": [
        "test_passes"
      ]
    },
    "refactor_code": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "test_passes"
        ]
      },
      "add": [
        "refactored"
      ],
      "del": [
        "full_suite_passes"
      ]
    },
    "run_full_suite": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:shell",
          "test_passes"
        ]
      },
      "add": [
        "full_suite_passes"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "discover_test_stack",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_failing_test",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_focused_test_red",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "GREEN",
        "body": [
          {
            "act": {
              "cap": "implement_minimal_code",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "run_focused_test_green",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "passed": [],
                "failed": [
                  {
                    "continue": "GREEN"
                  }
                ]
              }
            }
          }
        ]
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "refactor": [
            {
              "act": {
                "cap": "refactor_code",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    },
    {
      "act": {
        "cap": "run_full_suite",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "test_failed_first",
      "test_passes",
      "full_suite_passes"
    ]
  },
  "init_true": [
    "needs:local_filesystem",
    "needs:shell"
  ],
  "init_constraints": []
}
