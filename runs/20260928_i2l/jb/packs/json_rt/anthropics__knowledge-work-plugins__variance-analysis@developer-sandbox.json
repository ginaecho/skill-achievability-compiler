{
  "name": "variance-analysis",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_financial_data": {
      "owner": "agent",
      "pre": "data_file_exists",
      "add": [
        "financial_data_available"
      ]
    },
    "ask_for_financial_data": {
      "owner": "agent",
      "add": [
        "financial_data_available"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "data_in_file": [
            {
              "act": {
                "cap": "read_financial_data",
                "by": "agent"
              }
            }
          ],
          "data_not_provided": [
            {
              "act": {
                "cap": "ask_for_financial_data",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": "financial_data_available",
  "init_true": [
    "data_file_exists"
  ],
  "init_constraints": []
}
