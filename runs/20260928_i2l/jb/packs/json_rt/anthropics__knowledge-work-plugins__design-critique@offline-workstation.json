{
  "name": "design-critique",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_design_file": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      },
      "add": [
        "design_available"
      ]
    },
    "ask_for_design": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      },
      "add": [
        "design_available"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "file_referenced": [
            {
              "act": {
                "cap": "read_design_file",
                "by": "agent"
              }
            }
          ],
          "nothing_shared": [
            {
              "act": {
                "cap": "ask_for_design",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": "design_available",
  "init_true": [
    "needs:local_filesystem",
    "needs:user_conversation"
  ],
  "init_constraints": []
}
