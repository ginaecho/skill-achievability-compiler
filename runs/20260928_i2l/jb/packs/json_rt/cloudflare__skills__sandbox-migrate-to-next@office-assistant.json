{
  "name": "sandbox-migrate-to-next",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "fetch_migrate_docs": {
      "owner": "agent",
      "add": [
        "docs_fetched"
      ],
      "pre": {
        "and": [
          "needs:public_internet"
        ]
      }
    },
    "audit_codebase": {
      "owner": "agent",
      "add": [
        "audit_done"
      ],
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      }
    },
    "clarify_with_user": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation",
          "audit_done"
        ]
      },
      "add": [
        "decisions_clarified"
      ]
    },
    "update_dockerfile_image": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "decisions_clarified"
        ]
      },
      "add": [
        "image_upgraded"
      ]
    },
    "port_code": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          {
            "and": [
              "audit_done",
              "decisions_clarified",
              "docs_fetched"
            ]
          }
        ]
      },
      "add": [
        "code_ported"
      ]
    },
    "regrep_removed_apis": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "code_ported"
        ]
      },
      "add": [
        "no_removed_apis"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "fetch_migrate_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "audit_codebase",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "clarify_with_user",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_next_package",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "update_dockerfile_image",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "port_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "typecheck_and_smoke",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "regrep_removed_apis",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "package_upgraded",
      "image_upgraded",
      "code_ported",
      "validated",
      "no_removed_apis"
    ]
  },
  "init_true": [
    "needs:public_internet",
    "needs:local_filesystem",
    "needs:user_conversation"
  ],
  "init_constraints": []
}
