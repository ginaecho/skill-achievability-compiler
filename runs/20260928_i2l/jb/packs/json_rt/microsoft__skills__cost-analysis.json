{
  "name": "azure-cost-analysis",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "confirm_scope": {
      "owner": "agent",
      "add": [
        "scope_confirmed"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "confirm_scope",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "historical_spend_or_ai": [
            {
              "act": {
                "cap": "query_costs",
                "by": "agent"
              }
            }
          ],
          "spike_investigation": [
            {
              "act": {
                "cap": "query_costs",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "query_resource_graph",
                "by": "agent"
              }
            }
          ],
          "aks_costs": [
            {
              "act": {
                "cap": "query_aks_costs",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "scope_confirmed",
      "cost_data_retrieved"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
