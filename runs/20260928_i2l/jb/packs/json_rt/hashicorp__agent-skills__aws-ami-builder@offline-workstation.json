{
  "name": "aws-ami-builder",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "write_packer_template": {
      "owner": "agent",
      "add": [
        "template_written"
      ]
    },
    "packer_init": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:packer_cli",
          "needs:network",
          "template_written"
        ]
      },
      "add": [
        "plugins_installed"
      ]
    },
    "packer_validate": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:packer_cli",
          {
            "and": [
              "template_written",
              "plugins_installed"
            ]
          }
        ]
      },
      "add": [
        "template_valid"
      ]
    },
    "packer_build": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:aws_account",
          "needs:network",
          "needs:packer_cli",
          "template_valid"
        ]
      },
      "add": [
        "ami_built"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_packer_template",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "packer_init",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "packer_validate",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "packer_build",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "template_written",
      "ami_built"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
