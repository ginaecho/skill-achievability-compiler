{
  "name": "vendor-review",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_vendor_details": {
      "owner": "agent",
      "add": [
        "vendor_details_available"
      ]
    },
    "read_proposal_text": {
      "owner": "agent",
      "pre": "proposal_text_file_exists",
      "add": [
        "vendor_details_available"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "proposal_file": [
            {
              "act": {
                "cap": "read_proposal_text",
                "by": "agent"
              }
            }
          ],
          "details_in_chat": [
            {
              "act": {
                "cap": "ask_vendor_details",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": "vendor_details_available",
  "init_true": [
    "proposal_text_file_exists"
  ],
  "init_constraints": []
}
