{
  "name": "ux-copy",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_for_context": {
      "owner": "agent",
      "add": [
        "copy_context_known"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "context_missing": [
            {
              "act": {
                "cap": "ask_for_context",
                "by": "agent"
              }
            }
          ],
          "context_given": []
        }
      }
    }
  ],
  "goal": {
    "or": [
      "copy_context_known",
      "context_in_request"
    ]
  },
  "init_true": [
    "context_in_request"
  ],
  "init_constraints": []
}
