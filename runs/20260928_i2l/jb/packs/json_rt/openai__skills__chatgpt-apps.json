{
  "name": "chatgpt-apps",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_requirements": {
      "owner": "agent",
      "add": [
        "requirements_known"
      ]
    },
    "fetch_apps_sdk_docs": {
      "owner": "agent",
      "add": [
        "docs_fetched"
      ],
      "pre": {
        "and": [
          "needs:public_internet"
        ]
      }
    },
    "copy_upstream_example": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet",
          "docs_fetched"
        ]
      },
      "add": [
        "scaffold_created"
      ]
    },
    "run_fallback_scaffold_script": {
      "owner": "agent",
      "pre": "docs_fetched",
      "add": [
        "scaffold_created"
      ]
    },
    "write_server_and_widget": {
      "owner": "agent",
      "pre": {
        "and": [
          "scaffold_created",
          "docs_fetched"
        ]
      },
      "add": [
        "app_code_written"
      ]
    },
    "install_deps_and_compile": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:package_registries",
          "app_code_written"
        ]
      },
      "add": [
        "app_builds"
      ]
    },
    "local_mcp_health_check": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_servers",
          "app_builds"
        ]
      },
      "add": [
        "local_validated"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "ask_requirements",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_apps_sdk_docs",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "upstream_example": [
            {
              "act": {
                "cap": "copy_upstream_example",
                "by": "agent"
              }
            }
          ],
          "fallback_script": [
            {
              "act": {
                "cap": "run_fallback_scaffold_script",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "write_server_and_widget",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_deps_and_compile",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "local_mcp_health_check",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "docs_fetched",
      "app_code_written",
      "local_validated"
    ]
  },
  "init_true": [
    "needs:public_internet",
    "needs:package_registries",
    "needs:local_servers"
  ],
  "init_constraints": []
}
