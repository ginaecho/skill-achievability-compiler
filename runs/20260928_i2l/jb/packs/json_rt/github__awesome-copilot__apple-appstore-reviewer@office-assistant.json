{
  "name": "apple-appstore-reviewer",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_project_files": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "repo_available"
        ]
      },
      "add": [
        "codebase_reviewed"
      ]
    },
    "verify_current_guidelines": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet"
        ]
      },
      "add": [
        "guidelines_verified"
      ]
    },
    "request_missing_evidence": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation",
          "codebase_reviewed"
        ]
      },
      "add": [
        "evidence_requested"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_project_files",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "verify_online": [
            {
              "act": {
                "cap": "verify_current_guidelines",
                "by": "agent"
              }
            }
          ],
          "skip_verification": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "ask_for_evidence": [
            {
              "act": {
                "cap": "request_missing_evidence",
                "by": "agent"
              }
            }
          ],
          "no_request": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "codebase_reviewed",
      {
        "not": "code_modified"
      }
    ]
  },
  "init_true": [
    "repo_available",
    "needs:local_filesystem",
    "needs:public_internet",
    "needs:user_conversation"
  ],
  "init_constraints": []
}
