{
  "name": "thesis-tracker",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "load_thesis_file": {
      "owner": "agent",
      "add": [
        "thesis_loaded"
      ],
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      }
    },
    "define_new_thesis": {
      "owner": "agent",
      "add": [
        "thesis_loaded",
        "thesis_defined"
      ],
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      }
    },
    "ask_new_data_point": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation",
          "thesis_loaded"
        ]
      },
      "add": [
        "data_point_received"
      ]
    },
    "save_thesis_record": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "thesis_loaded"
        ]
      },
      "add": [
        "update_log_recorded",
        "scorecard_updated",
        "catalyst_calendar_updated",
        "thesis_stored"
      ]
    },
    "write_thesis_summary": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "scorecard_updated"
        ]
      },
      "add": [
        "thesis_summary_written",
        "conviction_stated"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "existing_thesis": [
            {
              "act": {
                "cap": "load_thesis_file",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "ask_new_data_point",
                "by": "agent"
              }
            }
          ],
          "new_thesis": [
            {
              "act": {
                "cap": "define_new_thesis",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "save_thesis_record",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_thesis_summary",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "thesis_stored",
      "update_log_recorded",
      "scorecard_updated",
      "catalyst_calendar_updated",
      "thesis_summary_written",
      "conviction_stated"
    ]
  },
  "init_true": [
    "needs:local_filesystem",
    "needs:user_conversation"
  ],
  "init_constraints": []
}
