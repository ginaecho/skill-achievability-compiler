{
  "name": "comp-analysis",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "web_research_benchmarks": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet"
        ]
      },
      "add": [
        "market_data_gathered"
      ]
    },
    "read_uploaded_comp_csv": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      },
      "add": [
        "employee_data_loaded"
      ]
    },
    "ask_role_details": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      },
      "add": [
        "role_specified"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "role_given": [],
          "role_missing": [
            {
              "act": {
                "cap": "ask_role_details",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "web_research_benchmarks",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "uploaded_data": [
            {
              "act": {
                "cap": "read_uploaded_comp_csv",
                "by": "agent"
              }
            }
          ],
          "no_band_data": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "role_specified",
      "market_data_gathered"
    ]
  },
  "init_true": [
    "role_specified",
    "needs:public_internet",
    "needs:local_filesystem",
    "needs:user_conversation"
  ],
  "init_constraints": []
}
