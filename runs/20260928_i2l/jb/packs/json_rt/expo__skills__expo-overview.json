{
  "name": "expo-overview",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_project": {
      "owner": "agent",
      "pre": "request_received",
      "add": [
        "expo_work_confirmed",
        "sdk_version_detected"
      ]
    },
    "confirm_intent": {
      "owner": "agent",
      "pre": "expo_work_confirmed",
      "add": [
        "intent_confirmed"
      ]
    },
    "scaffold_new_app": {
      "owner": "agent",
      "pre": "expo_work_confirmed",
      "add": [
        "project_scaffolded",
        "sdk_version_detected"
      ]
    },
    "load_leaf_skill": {
      "owner": "agent",
      "pre": {
        "and": [
          "expo_work_confirmed",
          "sdk_version_detected",
          "intent_confirmed"
        ]
      },
      "add": [
        "routed_to_leaf_skill"
      ]
    },
    "submit_feedback": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet",
          "routed_to_leaf_skill"
        ]
      },
      "add": [
        "feedback_submitted"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_project",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "new_app": [
            {
              "act": {
                "cap": "scaffold_new_app",
                "by": "agent"
              }
            }
          ],
          "existing_app": []
        }
      }
    },
    {
      "act": {
        "cap": "confirm_intent",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "load_leaf_skill",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "send_feedback": [
            {
              "act": {
                "cap": "submit_feedback",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "expo_work_confirmed",
      "sdk_version_detected",
      "routed_to_leaf_skill"
    ]
  },
  "init_true": [
    "request_received",
    "needs:public_internet"
  ],
  "init_constraints": []
}
