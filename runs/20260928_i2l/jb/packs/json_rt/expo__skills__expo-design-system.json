{
  "name": "expo_design_system",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "detect_existing_system": {
      "owner": "agent",
      "pre": true,
      "add": [
        "system_detected"
      ]
    },
    "extend_existing_theme": {
      "owner": "agent",
      "pre": {
        "and": [
          "system_detected",
          "existing_system"
        ]
      },
      "add": [
        "theme_tokens_defined"
      ]
    },
    "create_theme_files": {
      "owner": "agent",
      "pre": {
        "and": [
          "system_detected",
          {
            "not": "existing_system"
          }
        ]
      },
      "add": [
        "theme_tokens_defined"
      ]
    },
    "write_shared_components": {
      "owner": "agent",
      "pre": "theme_tokens_defined",
      "add": [
        "components_built"
      ]
    },
    "refactor_screens_to_tokens": {
      "owner": "agent",
      "pre": "components_built",
      "add": [
        "screens_use_system"
      ]
    },
    "run_drift_audit": {
      "owner": "agent",
      "pre": "screens_use_system",
      "add": [
        "drift_audited"
      ]
    },
    "screenshot_web_preview": {
      "owner": "agent",
      "pre": "screens_use_system",
      "add": [
        "screens_critiqued"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "detect_existing_system",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "extend_existing": [
            {
              "act": {
                "cap": "extend_existing_theme",
                "by": "agent"
              }
            }
          ],
          "create_new": [
            {
              "act": {
                "cap": "create_theme_files",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "write_shared_components",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "refactor_screens_to_tokens",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_drift_audit",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "web_preview": [
            {
              "act": {
                "cap": "screenshot_web_preview",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "theme_tokens_defined",
      "components_built",
      "screens_use_system",
      "drift_audited"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
