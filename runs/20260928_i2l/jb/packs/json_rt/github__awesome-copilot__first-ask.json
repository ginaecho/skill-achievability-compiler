{
  "name": "first-ask",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "explore_project": {
      "owner": "agent",
      "add": [
        "project_explored"
      ]
    },
    "web_research": {
      "owner": "agent",
      "add": [
        "web_researched"
      ]
    },
    "carry_out_task": {
      "owner": "agent",
      "pre": "requirements_clarified",
      "add": [
        "task_done"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "explore_project",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "research": [
            {
              "act": {
                "cap": "web_research",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    },
    {
      "rec": {
        "name": "Refine",
        "body": [
          {
            "act": {
              "cap": "request_human_input",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "user",
              "observed": true,
              "branches": {
                "more_input": [
                  {
                    "continue": "Refine"
                  }
                ],
                "no_further_input": [
                  {
                    "act": {
                      "cap": "confirm_no_further_input",
                      "by": "agent"
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    },
    {
      "act": {
        "cap": "carry_out_task",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "requirements_clarified",
      "task_done"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
