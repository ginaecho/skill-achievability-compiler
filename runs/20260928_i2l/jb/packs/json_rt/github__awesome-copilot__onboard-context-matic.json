{
  "name": "onboard-context-matic",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "detect_language": {
      "owner": "agent",
      "add": [
        "language_detected"
      ]
    },
    "ask_api_choice": {
      "owner": "agent",
      "pre": "apis_listed",
      "add": [
        "api_chosen"
      ]
    },
    "ask_integration_goal": {
      "owner": "agent",
      "pre": "api_explained",
      "add": [
        "integration_goal_known"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "detect_language",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_api_list",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "ask_api_choice",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "ask_overview",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "ask_integration_goal",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "ask_integration",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "model_search_demo",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "endpoint_search_demo",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "apis_listed",
      "api_explained",
      "integration_shown",
      "model_search_demoed",
      "endpoint_search_demoed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
