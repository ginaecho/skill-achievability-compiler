{
  "name": "security-threat-model",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_repository": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      },
      "add": [
        "repo_evidence_collected"
      ]
    },
    "ask_user_assumptions": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation",
          "repo_evidence_collected"
        ]
      },
      "add": [
        "assumptions_validated"
      ]
    },
    "write_threat_model_file": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          {
            "and": [
              "repo_evidence_collected",
              "assumptions_validated"
            ]
          }
        ]
      },
      "add": [
        "threat_model_written"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_repository",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "ask_user_assumptions",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_threat_model_file",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "repo_evidence_collected",
      "assumptions_validated",
      "threat_model_written"
    ]
  },
  "init_true": [
    "needs:local_filesystem",
    "needs:user_conversation"
  ],
  "init_constraints": []
}
