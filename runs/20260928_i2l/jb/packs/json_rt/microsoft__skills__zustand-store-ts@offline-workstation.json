{
  "name": "zustand-store-ts",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_template": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      },
      "add": [
        "template_loaded"
      ]
    },
    "create_store_file": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "template_loaded"
        ]
      },
      "add": [
        "store_created"
      ]
    },
    "export_from_index": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "store_created"
        ]
      },
      "add": [
        "store_exported"
      ]
    },
    "write_store_tests": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "store_created"
        ]
      },
      "add": [
        "tests_added"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_template",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_store_file",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "export_from_index",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_store_tests",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "store_created",
      "store_exported",
      "tests_added"
    ]
  },
  "init_true": [
    "needs:local_filesystem"
  ],
  "init_constraints": []
}
