{
  "name": "diagnosing-superpowers",
  "roles": [
    "agent",
    "user",
    "analyst"
  ],
  "capabilities": {
    "problem_intake": {
      "owner": "agent",
      "add": [
        "problem_statement"
      ]
    },
    "locate_sessions": {
      "owner": "agent",
      "pre": "problem_statement",
      "add": [
        "sessions_located"
      ]
    },
    "write_case_file": {
      "owner": "agent",
      "pre": "sessions_located",
      "add": [
        "case_file_written"
      ]
    },
    "read_transcript_region": {
      "owner": "agent",
      "pre": "case_file_written",
      "add": [
        "region_read"
      ]
    },
    "analyze_dimension": {
      "owner": "analyst",
      "pre": "case_file_written",
      "add": [
        "findings_cited"
      ]
    },
    "write_report": {
      "owner": "agent",
      "pre": {
        "and": [
          "region_read",
          "findings_cited"
        ]
      },
      "add": [
        "report_written"
      ]
    },
    "build_and_scrub_bundle": {
      "owner": "agent",
      "pre": "report_written",
      "add": [
        "bundle_scrubbed"
      ]
    },
    "archive_bundle": {
      "owner": "agent",
      "pre": "bundle_scrubbed",
      "add": [
        "bundle_archived"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "problem_intake",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "locate_sessions",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_case_file",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_transcript_region",
        "by": "agent"
      }
    },
    {
      "spawn": {
        "role": "analyst"
      }
    },
    {
      "act": {
        "cap": "analyze_dimension",
        "by": "analyst"
      }
    },
    {
      "act": {
        "cap": "write_report",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "export_bundle": [
            {
              "act": {
                "cap": "build_and_scrub_bundle",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "approve_archive": [
                    {
                      "act": {
                        "cap": "archive_bundle",
                        "by": "agent"
                      }
                    }
                  ],
                  "decline": []
                }
              }
            }
          ],
          "no_export": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "problem_statement",
      "case_file_written",
      "report_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
