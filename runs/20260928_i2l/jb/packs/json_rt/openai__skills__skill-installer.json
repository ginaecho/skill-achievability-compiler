{
  "name": "skill_installer",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "list_curated_skills": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet"
        ]
      },
      "add": [
        "skills_listed"
      ]
    },
    "install_curated_skill": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet",
          "needs:local_filesystem",
          {
            "not": "skill_dir_exists"
          }
        ]
      },
      "add": [
        "skill_installed",
        "skill_dir_exists"
      ]
    },
    "install_from_public_repo": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet",
          "needs:local_filesystem",
          {
            "not": "skill_dir_exists"
          }
        ]
      },
      "add": [
        "skill_installed",
        "skill_dir_exists"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "list_then_install_curated": [
            {
              "act": {
                "cap": "list_curated_skills",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "install_curated_skill",
                "by": "agent"
              }
            }
          ],
          "install_curated_by_name": [
            {
              "act": {
                "cap": "install_curated_skill",
                "by": "agent"
              }
            }
          ],
          "install_from_public_repo": [
            {
              "act": {
                "cap": "install_from_public_repo",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": "skill_installed",
  "init_true": [
    "needs:public_internet",
    "needs:local_filesystem"
  ],
  "init_constraints": []
}
