{
  "name": "notion-research-documentation",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "confirm_scope": {
      "owner": "agent",
      "pre": "sources_found",
      "add": [
        "scope_confirmed"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "search_sources",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "multiple_results": [
            {
              "act": {
                "cap": "confirm_scope",
                "by": "agent"
              }
            }
          ],
          "clear_scope": []
        }
      }
    },
    {
      "act": {
        "cap": "fetch_pages",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_doc_page",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "followups": [
            {
              "act": {
                "cap": "add_followup_tasks",
                "by": "agent"
              }
            }
          ],
          "none": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "update": [
            {
              "act": {
                "cap": "update_doc_page",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "sources_fetched",
      "doc_created",
      "citations_included",
      "sources_linked"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
