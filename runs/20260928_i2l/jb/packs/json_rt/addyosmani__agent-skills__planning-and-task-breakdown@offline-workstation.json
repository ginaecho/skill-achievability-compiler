{
  "name": "planning-and-task-breakdown",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_spec_and_codebase": {
      "owner": "agent",
      "add": [
        "context_gathered"
      ]
    },
    "check_existing_plan_files": {
      "owner": "agent",
      "add": [
        "existing_plan_checked"
      ]
    },
    "ask_user_about_conflict": {
      "owner": "agent",
      "pre": "existing_plan_checked",
      "add": [
        "conflict_resolved"
      ]
    },
    "write_plan_and_todo": {
      "owner": "agent",
      "pre": {
        "and": [
          "context_gathered",
          "existing_plan_checked",
          "conflict_resolved"
        ]
      },
      "add": [
        "plan_written",
        "tasks_recorded"
      ]
    },
    "get_human_approval": {
      "owner": "agent",
      "pre": {
        "and": [
          "plan_written",
          "tasks_recorded"
        ]
      },
      "add": [
        "plan_approved"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_spec_and_codebase",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_existing_plan_files",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "no_conflict": [],
          "incomplete_plan_for_other_work": [
            {
              "act": {
                "cap": "ask_user_about_conflict",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "write_plan_and_todo",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "get_human_approval",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "plan_written",
      "tasks_recorded",
      "plan_approved"
    ]
  },
  "init_true": [
    "conflict_resolved"
  ],
  "init_constraints": []
}
