{
  "name": "documentation-and-adrs",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_repo_conventions": {
      "owner": "agent",
      "pre": "repo_available",
      "add": [
        "conventions_known"
      ]
    },
    "write_adr": {
      "owner": "agent",
      "pre": "conventions_known",
      "add": [
        "adr_written"
      ]
    },
    "add_inline_docs": {
      "owner": "agent",
      "pre": "conventions_known",
      "add": [
        "inline_docs_added"
      ]
    },
    "update_readme_changelog": {
      "owner": "agent",
      "pre": "conventions_known",
      "add": [
        "readme_changelog_updated"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_repo_conventions",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_adr",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "document_api": [
            {
              "act": {
                "cap": "add_inline_docs",
                "by": "agent"
              }
            }
          ],
          "skip_api_docs": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "update_readme": [
            {
              "act": {
                "cap": "update_readme_changelog",
                "by": "agent"
              }
            }
          ],
          "skip_readme": []
        }
      }
    }
  ],
  "goal": "adr_written",
  "init_true": [
    "repo_available"
  ],
  "init_constraints": []
}
