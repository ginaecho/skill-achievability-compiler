{
  "name": "inbox-setup",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "interview_big_picture": {
      "owner": "agent",
      "add": [
        "big_picture_known"
      ]
    },
    "interview_categories": {
      "owner": "agent",
      "pre": "big_picture_known",
      "add": [
        "categories_known"
      ]
    },
    "write_taxonomy": {
      "owner": "agent",
      "pre": "categories_known",
      "add": [
        "taxonomy_file"
      ]
    },
    "interview_voice_and_samples": {
      "owner": "agent",
      "pre": "taxonomy_file",
      "add": [
        "voice_inputs_known"
      ]
    },
    "analyze_voice_samples": {
      "owner": "agent",
      "pre": "voice_inputs_known",
      "add": [
        "voice_patterns_extracted"
      ]
    },
    "write_patterns": {
      "owner": "agent",
      "pre": "voice_inputs_known",
      "add": [
        "patterns_file"
      ]
    },
    "interview_and_write_evaluation": {
      "owner": "agent",
      "pre": "big_picture_known",
      "add": [
        "evaluation_file"
      ]
    },
    "interview_and_write_blocklist": {
      "owner": "agent",
      "pre": "patterns_file",
      "add": [
        "blocklist_file"
      ]
    },
    "interview_and_write_tracker": {
      "owner": "agent",
      "pre": "blocklist_file",
      "add": [
        "tracker_file",
        "triage_log_dir"
      ]
    },
    "save_report_preferences": {
      "owner": "agent",
      "pre": {
        "and": [
          "taxonomy_file",
          "tracker_file"
        ]
      },
      "add": [
        "report_prefs_saved"
      ]
    },
    "validate_kb": {
      "owner": "agent",
      "pre": {
        "and": [
          "taxonomy_file",
          "patterns_file",
          "blocklist_file",
          "tracker_file",
          "triage_log_dir",
          "report_prefs_saved"
        ]
      },
      "add": [
        "kb_validated"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "interview_big_picture",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "interview_categories",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_taxonomy",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "interview_voice_and_samples",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "samples_shared": [
            {
              "act": {
                "cap": "analyze_voice_samples",
                "by": "agent"
              }
            }
          ],
          "samples_refused": []
        }
      }
    },
    {
      "act": {
        "cap": "write_patterns",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "has_opportunity_emails": [
            {
              "act": {
                "cap": "interview_and_write_evaluation",
                "by": "agent"
              }
            }
          ],
          "no_opportunity_emails": []
        }
      }
    },
    {
      "act": {
        "cap": "interview_and_write_blocklist",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "interview_and_write_tracker",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "save_report_preferences",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_kb",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "taxonomy_file",
      "patterns_file",
      "blocklist_file",
      "tracker_file",
      "triage_log_dir",
      "report_prefs_saved",
      "kb_validated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
