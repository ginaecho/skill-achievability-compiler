{
  "name": "legal-response",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_inquiry_type": {
      "owner": "agent",
      "pre": true,
      "add": [
        "inquiry_type_known"
      ]
    },
    "load_local_templates": {
      "owner": "agent",
      "pre": "inquiry_type_known",
      "add": [
        "templates_checked"
      ]
    },
    "gather_details": {
      "owner": "agent",
      "pre": {
        "and": [
          "inquiry_type_known",
          "templates_checked"
        ]
      },
      "add": [
        "details_gathered"
      ]
    },
    "save_new_template": {
      "owner": "agent",
      "pre": "templates_checked",
      "add": [
        "template_saved"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "type_given": [],
          "type_missing": [
            {
              "act": {
                "cap": "ask_inquiry_type",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "load_local_templates",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "create_template": [
            {
              "act": {
                "cap": "save_new_template",
                "by": "agent"
              }
            }
          ],
          "no_template_creation": []
        }
      }
    },
    {
      "act": {
        "cap": "gather_details",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "inquiry_type_known",
      "templates_checked",
      "details_gathered"
    ]
  },
  "init_true": [
    "inquiry_type_known"
  ],
  "init_constraints": []
}
