{
  "name": "constraint-driven-development",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "detect_project_setup": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      },
      "add": [
        "setup_detected"
      ]
    },
    "interview_user": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation",
          "setup_detected"
        ]
      },
      "add": [
        "dimensions_chosen"
      ]
    },
    "write_constraints_file": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "dimensions_chosen"
        ]
      },
      "add": [
        "constraints_md_written"
      ]
    },
    "point_agent_docs_to_constraints": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "constraints_md_written"
        ]
      },
      "add": [
        "agents_md_points_to_constraints"
      ]
    },
    "add_check_scripts": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "constraints_md_written"
        ]
      },
      "add": [
        "check_scripts_added"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "detect_project_setup",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "interview_user",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_check_tools",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "measure_baseline",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_constraints_file",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "point_agent_docs_to_constraints",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "add_check_scripts",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "trial_run_checks",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "constraints_md_written",
      "agents_md_points_to_constraints",
      "tools_installed",
      "check_scripts_added",
      "baseline_measured",
      "trial_run_done"
    ]
  },
  "init_true": [
    "needs:local_filesystem",
    "needs:user_conversation"
  ],
  "init_constraints": []
}
