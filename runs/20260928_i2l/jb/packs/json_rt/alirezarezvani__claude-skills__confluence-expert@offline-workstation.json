{
  "name": "confluence-expert-space-creation",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "gather_team_info": {
      "owner": "agent",
      "add": [
        "team_info_known"
      ]
    },
    "write_team_info_json": {
      "owner": "agent",
      "pre": "team_info_known",
      "add": [
        "team_info_file"
      ]
    },
    "generate_space_structure": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:preinstalled_software",
          "team_info_file"
        ]
      },
      "add": [
        "page_tree_plan"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "gather_team_info",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_team_info_json",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_space_structure",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_space",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_page_tree",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_space_permissions",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_space",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "space_created",
      "homepage_set",
      "page_tree_created",
      "permissions_configured",
      "space_verified"
    ]
  },
  "init_true": [
    "needs:preinstalled_software"
  ],
  "init_constraints": []
}
