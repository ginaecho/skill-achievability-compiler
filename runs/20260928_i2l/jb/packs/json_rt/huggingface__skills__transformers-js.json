{
  "name": "transformers-js",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "browse_models": {
      "owner": "agent",
      "add": [
        "model_selected"
      ],
      "pre": {
        "and": [
          "needs:public_internet"
        ]
      }
    },
    "install_transformers_js": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:package_registries",
          "node_available"
        ]
      },
      "add": [
        "library_installed"
      ]
    },
    "write_pipeline_code": {
      "owner": "agent",
      "pre": "model_selected",
      "add": [
        "pipeline_code_written",
        "pipeline_disposed_in_code"
      ]
    },
    "run_pipeline": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet",
          {
            "and": [
              "library_installed",
              "pipeline_code_written"
            ]
          }
        ]
      },
      "add": [
        "model_downloaded",
        "inference_result_obtained"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "browse_hub_for_model": [
            {
              "act": {
                "cap": "browse_models",
                "by": "agent"
              }
            }
          ],
          "use_default_or_named_model": []
        }
      }
    },
    {
      "act": {
        "cap": "install_transformers_js",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_pipeline_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_pipeline",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "pipeline_code_written",
      "pipeline_disposed_in_code",
      "inference_result_obtained"
    ]
  },
  "init_true": [
    "node_available",
    "model_selected",
    "needs:public_internet",
    "needs:package_registries"
  ],
  "init_constraints": []
}
