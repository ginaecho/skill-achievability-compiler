{
  "name": "notion-knowledge-capture",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "clarify_capture": {
      "owner": "agent",
      "add": [
        "capture_defined"
      ]
    },
    "read_reference_templates": {
      "owner": "agent",
      "pre": "capture_defined",
      "add": [
        "destination_selected"
      ]
    },
    "choose_database_with_user": {
      "owner": "agent",
      "pre": "capture_defined",
      "add": [
        "destination_selected"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "clarify_capture",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "single_database": [
            {
              "act": {
                "cap": "read_reference_templates",
                "by": "agent"
              }
            }
          ],
          "multiple_candidates": [
            {
              "act": {
                "cap": "read_reference_templates",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "choose_database_with_user",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "search_fetch_notion_context",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "new_page": [
            {
              "act": {
                "cap": "create_notion_page",
                "by": "agent"
              }
            }
          ],
          "update_existing": [
            {
              "act": {
                "cap": "update_existing_page",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "link_from_hub_pages",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "has_followups": [
            {
              "act": {
                "cap": "create_followup_tasks",
                "by": "agent"
              }
            }
          ],
          "none": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "capture_defined",
      "page_captured",
      "page_linked"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
