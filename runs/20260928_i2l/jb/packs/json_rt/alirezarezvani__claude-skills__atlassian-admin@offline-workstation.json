{
  "name": "atlassian-admin-user-provisioning",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "collect_user_details": {
      "owner": "agent",
      "add": [
        "user_details_known"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "collect_user_details",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "invite_user",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "add_user_to_groups",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "assign_product_access",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "notify": [
            {
              "act": {
                "cap": "send_welcome_and_notify",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    },
    {
      "act": {
        "cap": "verify_user_active",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "user_account_created",
      "user_in_groups",
      "product_access_granted",
      "user_verified_active"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
