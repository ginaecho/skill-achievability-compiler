{
  "name": "draft-outreach",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_uploaded_context": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      },
      "add": [
        "context_gathered"
      ]
    },
    "ask_org_fact": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      },
      "add": [
        "context_gathered"
      ]
    },
    "web_hook_research": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet"
        ]
      },
      "add": [
        "hook_found"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "files_uploaded": [
            {
              "act": {
                "cap": "read_uploaded_context",
                "by": "agent"
              }
            }
          ],
          "stated_context_only": [
            {
              "act": {
                "cap": "ask_org_fact",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "no_history_web": [
            {
              "act": {
                "cap": "web_hook_research",
                "by": "agent"
              }
            }
          ],
          "hook_known": []
        }
      }
    }
  ],
  "goal": "context_gathered",
  "init_true": [
    "needs:local_filesystem",
    "needs:user_conversation",
    "needs:public_internet"
  ],
  "init_constraints": []
}
