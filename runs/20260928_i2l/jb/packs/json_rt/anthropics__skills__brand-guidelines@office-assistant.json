{
  "name": "brand-guidelines",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_source_artifact": {
      "owner": "agent",
      "add": [
        "artifact_loaded"
      ],
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      }
    },
    "apply_brand_to_text_artifact": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "artifact_loaded"
        ]
      },
      "add": [
        "colors_applied",
        "fonts_applied",
        "artifact_branded"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_source_artifact",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "apply_brand_to_text_artifact",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "colors_applied",
      "fonts_applied",
      "artifact_branded"
    ]
  },
  "init_true": [
    "needs:local_filesystem"
  ],
  "init_constraints": []
}
