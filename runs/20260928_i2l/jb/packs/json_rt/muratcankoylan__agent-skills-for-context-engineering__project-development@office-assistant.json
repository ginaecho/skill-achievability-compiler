{
  "name": "project-development",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "gather_task_requirements": {
      "owner": "agent",
      "add": [
        "requirements_known"
      ]
    },
    "collect_user_prototype_result": {
      "owner": "agent",
      "pre": "requirements_known",
      "add": [
        "prototype_validated"
      ]
    },
    "research_pricing_and_references": {
      "owner": "agent",
      "pre": "requirements_known",
      "add": [
        "pricing_known"
      ]
    },
    "write_project_plan": {
      "owner": "agent",
      "pre": "requirements_known",
      "add": [
        "project_plan_written"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "gather_task_requirements",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "user_prototype": [
            {
              "act": {
                "cap": "collect_user_prototype_result",
                "by": "agent"
              }
            }
          ],
          "skip_prototype": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "lookup_pricing": [
            {
              "act": {
                "cap": "research_pricing_and_references",
                "by": "agent"
              }
            }
          ],
          "skip_lookup": []
        }
      }
    },
    {
      "act": {
        "cap": "write_project_plan",
        "by": "agent"
      }
    }
  ],
  "goal": "project_plan_written",
  "init_true": [],
  "init_constraints": []
}
