{
  "name": "dwarf-expert",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "lookup_dwarf_spec": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet"
        ]
      },
      "add": [
        "spec_consulted"
      ]
    },
    "write_pyelftools_script": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "binary_available"
        ]
      },
      "add": [
        "parse_script_written"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "consult_spec": [
            {
              "act": {
                "cap": "lookup_dwarf_spec",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    },
    {
      "act": {
        "cap": "check_dwarfdump_version",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "dwarfdump_query": [
            {
              "act": {
                "cap": "dump_and_search_dies",
                "by": "agent"
              }
            }
          ],
          "structural_query_script": [
            {
              "act": {
                "cap": "write_pyelftools_script",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "run_pyelftools_script",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "verify": [
            {
              "act": {
                "cap": "verify_dwarf_integrity",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": "dies_extracted",
  "init_true": [
    "binary_available",
    "needs:public_internet",
    "needs:local_filesystem"
  ],
  "init_constraints": []
}
