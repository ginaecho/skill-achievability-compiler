{
  "name": "gh-review-requests",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_team": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      },
      "add": [
        "team_known"
      ]
    },
    "run_fetch_script": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_auth",
          "team_known"
        ]
      },
      "add": [
        "review_requests_fetched"
      ]
    },
    "fetch_manually_via_gh_api": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_auth",
          "team_known"
        ]
      },
      "add": [
        "review_requests_fetched"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "team_given": [],
          "team_missing": [
            {
              "act": {
                "cap": "ask_team",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "run_fetch_script",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "observed": true,
        "branches": {
          "script_ok": [],
          "script_failed": [
            {
              "act": {
                "cap": "fetch_manually_via_gh_api",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": "review_requests_fetched",
  "init_true": [
    "team_known",
    "needs:user_conversation"
  ],
  "init_constraints": []
}
