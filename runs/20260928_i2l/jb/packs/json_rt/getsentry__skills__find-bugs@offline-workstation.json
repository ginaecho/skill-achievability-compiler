{
  "name": "find-bugs",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "resolve_default_branch": {
      "owner": "agent",
      "add": [
        "default_branch_known"
      ],
      "pre": {
        "and": [
          "needs:github_api",
          "needs:network"
        ]
      }
    },
    "get_branch_diff": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:shell",
          "default_branch_known"
        ]
      },
      "add": [
        "diff_obtained"
      ]
    },
    "read_changed_files": {
      "owner": "agent",
      "pre": "diff_obtained",
      "add": [
        "all_changes_read"
      ]
    },
    "search_context_and_tests": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:shell",
          "all_changes_read"
        ]
      },
      "add": [
        "issues_verified"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "resolve_default_branch",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "get_branch_diff",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_changed_files",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "search_context_and_tests",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "diff_obtained",
      "all_changes_read",
      "issues_verified"
    ]
  },
  "init_true": [
    "needs:shell"
  ],
  "init_constraints": []
}
