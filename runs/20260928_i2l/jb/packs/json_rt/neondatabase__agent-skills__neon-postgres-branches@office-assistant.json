{
  "name": "neon-postgres-branches",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_branch_type": {
      "owner": "agent",
      "add": [
        "branch_type_known"
      ],
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      }
    },
    "update_env_file": {
      "owner": "agent",
      "pre": "connection_string_available",
      "add": [
        "env_updated"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "ambiguous": [
            {
              "act": {
                "cap": "ask_branch_type",
                "by": "agent"
              }
            }
          ],
          "clear_from_request": [
            {
              "act": {
                "cap": "ask_branch_type",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "use_cli": [
            {
              "act": {
                "cap": "check_cli",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "create_branch_cli",
                "by": "agent"
              }
            }
          ],
          "use_mcp": [
            {
              "act": {
                "cap": "create_branch_mcp",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "update_env": [
            {
              "act": {
                "cap": "get_connection_string",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "update_env_file",
                "by": "agent"
              }
            }
          ],
          "leave_env": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "branch_type_known",
      "branch_created"
    ]
  },
  "init_true": [
    "needs:user_conversation"
  ],
  "init_constraints": []
}
