{
  "name": "discover-azure-skills",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "list_plugins": {
      "owner": "agent",
      "add": [
        "plugins_listed"
      ],
      "pre": {
        "and": [
          "needs:public_internet"
        ]
      }
    },
    "list_skills": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet",
          "plugins_listed"
        ]
      },
      "add": [
        "skills_listed"
      ]
    },
    "read_skill_descriptions": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet",
          "skills_listed"
        ]
      },
      "add": [
        "relevant_skills_identified"
      ]
    },
    "read_plugin_manifests": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet",
          "relevant_skills_identified"
        ]
      },
      "add": [
        "plugin_names_resolved"
      ]
    },
    "read_install_instructions": {
      "owner": "agent",
      "pre": "plugin_names_resolved",
      "add": [
        "install_instructions_loaded"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "list_plugins",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "list_skills",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_skill_descriptions",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_plugin_manifests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_install_instructions",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "relevant_skills_identified",
      "plugin_names_resolved",
      "install_instructions_loaded"
    ]
  },
  "init_true": [
    "needs:public_internet"
  ],
  "init_constraints": []
}
