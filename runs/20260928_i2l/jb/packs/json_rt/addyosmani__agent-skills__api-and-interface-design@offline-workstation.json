{
  "name": "api-and-interface-design",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_existing_code": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      },
      "add": [
        "context_understood"
      ]
    },
    "write_contract_types": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "context_understood"
        ]
      },
      "add": [
        "contract_defined",
        "types_committed"
      ]
    },
    "implement_boundary_validation": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "contract_defined"
        ]
      },
      "add": [
        "boundary_validation_implemented",
        "errors_consistent",
        "pagination_supported"
      ]
    },
    "implement_idempotency": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "contract_defined"
        ]
      },
      "add": [
        "idempotency_handled"
      ]
    },
    "document_unsafe_retry": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "contract_defined"
        ]
      },
      "add": [
        "idempotency_handled"
      ]
    },
    "typecheck_and_test": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:shell",
          "needs:preinstalled_software",
          {
            "and": [
              "contract_defined",
              "boundary_validation_implemented"
            ]
          }
        ]
      },
      "add": [
        "design_verified"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_existing_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_contract_types",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "implement_boundary_validation",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "honour_idempotency_key": [
            {
              "act": {
                "cap": "implement_idempotency",
                "by": "agent"
              }
            }
          ],
          "document_unsafe": [
            {
              "act": {
                "cap": "document_unsafe_retry",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "typecheck_and_test",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "contract_defined",
      "types_committed",
      "boundary_validation_implemented",
      "errors_consistent",
      "pagination_supported",
      "idempotency_handled",
      "design_verified"
    ]
  },
  "init_true": [
    "needs:local_filesystem",
    "needs:shell",
    "needs:preinstalled_software"
  ],
  "init_constraints": []
}
