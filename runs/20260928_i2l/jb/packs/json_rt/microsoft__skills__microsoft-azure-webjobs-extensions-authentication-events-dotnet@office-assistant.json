{
  "name": "microsoft-azure-webjobs-extensions-authentication-events-dotnet",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "write_function_code": {
      "owner": "agent",
      "pre": "package_installed",
      "add": [
        "function_code_written"
      ]
    },
    "write_function_config": {
      "owner": "agent",
      "pre": true,
      "add": [
        "function_config_written"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_package",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_function_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_function_config",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "package_installed",
      "function_code_written",
      "function_config_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
