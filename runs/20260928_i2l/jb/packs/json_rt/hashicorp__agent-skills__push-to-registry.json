{
  "name": "push-to-registry",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "write_packer_template": {
      "owner": "agent",
      "pre": true,
      "add": [
        "template_has_registry_block"
      ]
    },
    "install_packer": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:package_registries"
        ]
      },
      "add": [
        "packer_installed"
      ]
    },
    "set_hcp_credentials": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:hcp_credentials",
          "service_principal_created"
        ]
      },
      "add": [
        "hcp_auth_configured"
      ]
    },
    "packer_init": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet",
          {
            "and": [
              "packer_installed",
              "template_has_registry_block"
            ]
          }
        ]
      },
      "add": [
        "plugins_initialized"
      ]
    },
    "packer_build_and_push": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:aws_account",
          "needs:hcp_account",
          {
            "and": [
              "plugins_initialized",
              "hcp_auth_configured"
            ]
          }
        ]
      },
      "add": [
        "image_built",
        "metadata_pushed"
      ]
    },
    "write_ci_workflow": {
      "owner": "agent",
      "pre": "template_has_registry_block",
      "add": [
        "ci_workflow_written"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_packer_template",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_packer",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_service_principal",
        "by": "user"
      }
    },
    {
      "act": {
        "cap": "set_hcp_credentials",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "packer_init",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "packer_build_and_push",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "add_ci": [
            {
              "act": {
                "cap": "write_ci_workflow",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "template_has_registry_block",
      "metadata_pushed"
    ]
  },
  "init_true": [
    "needs:package_registries",
    "needs:public_internet"
  ],
  "init_constraints": []
}
