{
  "name": "azure-image-builder",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "write_packer_template": {
      "owner": "agent",
      "pre": true,
      "add": [
        "template_written"
      ]
    },
    "create_service_principal": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account"
        ]
      },
      "add": [
        "credentials_configured"
      ]
    },
    "packer_init": {
      "owner": "agent",
      "pre": "template_written",
      "add": [
        "plugins_initialized"
      ]
    },
    "packer_validate": {
      "owner": "agent",
      "pre": "plugins_initialized",
      "add": [
        "template_validated"
      ]
    },
    "packer_build": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "needs:azure_credentials",
          {
            "and": [
              "template_validated",
              "credentials_configured"
            ]
          }
        ]
      },
      "add": [
        "image_built"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_packer_template",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_service_principal",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "packer_init",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "packer_validate",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "packer_build",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "template_validated",
      "image_built"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
