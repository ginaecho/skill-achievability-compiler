{
  "name": "architecture-blueprint-generator",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "analyze_codebase": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      },
      "add": [
        "codebase_analyzed",
        "stack_detected",
        "pattern_detected"
      ]
    },
    "write_blueprint_document": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          {
            "and": [
              "codebase_analyzed",
              "stack_detected",
              "pattern_detected"
            ]
          }
        ]
      },
      "add": [
        "blueprint_written",
        "diagrams_included"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "analyze_codebase",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_blueprint_document",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "codebase_analyzed",
      "blueprint_written",
      "diagrams_included"
    ]
  },
  "init_true": [
    "needs:local_filesystem"
  ],
  "init_constraints": []
}
