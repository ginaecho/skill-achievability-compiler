{
  "name": "neon-postgres",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_existing_config": {
      "owner": "agent",
      "add": [
        "config_inspected"
      ]
    },
    "write_env_file": {
      "owner": "agent",
      "pre": {
        "and": [
          "config_inspected",
          "connection_string_available"
        ]
      },
      "add": [
        "database_url_stored"
      ]
    },
    "fetch_neon_docs": {
      "owner": "agent",
      "add": [
        "docs_checked"
      ],
      "pre": {
        "and": [
          "needs:public_internet"
        ]
      }
    },
    "write_schema_code": {
      "owner": "agent",
      "pre": "database_url_stored",
      "add": [
        "schema_as_code_written"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_existing_config",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "database_url_supplied": [
            {
              "act": {
                "cap": "write_env_file",
                "by": "agent"
              }
            }
          ],
          "no_database_url": [
            {
              "act": {
                "cap": "select_or_create_project",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "fetch_connection_string",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "write_env_file",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "fetch_neon_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_schema_code",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "test_on_branch": [
            {
              "act": {
                "cap": "create_test_branch",
                "by": "agent"
              }
            }
          ],
          "skip_branch": []
        }
      }
    },
    {
      "act": {
        "cap": "run_migration",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "database_url_stored",
      "schema_as_code_written",
      "migration_applied"
    ]
  },
  "init_true": [
    "needs:public_internet"
  ],
  "init_constraints": []
}
