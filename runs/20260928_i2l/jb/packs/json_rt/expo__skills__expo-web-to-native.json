{
  "name": "expo-web-to-native",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "write_worklist": {
      "owner": "agent",
      "pre": true,
      "add": [
        "worklist_written"
      ]
    },
    "scaffold_expo_shell": {
      "owner": "agent",
      "pre": "worklist_written",
      "add": [
        "shell_scaffolded"
      ]
    },
    "port_screens_to_dom": {
      "owner": "agent",
      "pre": "shell_scaffolded",
      "add": [
        "dom_shell_built"
      ]
    },
    "install_verify_tools": {
      "owner": "agent",
      "pre": true,
      "add": [
        "verify_tools_installed"
      ]
    },
    "capture_web_original": {
      "owner": "agent",
      "pre": "verify_tools_installed",
      "add": [
        "web_captured"
      ]
    },
    "nativize_screen": {
      "owner": "agent",
      "pre": "dom_shell_built",
      "add": [
        "screen_nativized"
      ],
      "del": [
        "native_verified"
      ]
    },
    "wire_data_auth_storage": {
      "owner": "agent",
      "pre": "dom_shell_built",
      "add": [
        "data_wired"
      ]
    },
    "ship_to_stores": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:expo_account",
          "needs:apple_developer_account",
          "needs:google_play_account",
          "native_verified"
        ]
      },
      "add": [
        "shipped"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_worklist",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scaffold_expo_shell",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "port_screens_to_dom",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "install_tools": [
            {
              "act": {
                "cap": "install_verify_tools",
                "by": "agent"
              }
            }
          ],
          "already_installed": []
        }
      }
    },
    {
      "act": {
        "cap": "capture_web_original",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_native_on_simulator",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "Strangle",
        "body": [
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "next_screen": [
                  {
                    "act": {
                      "cap": "nativize_screen",
                      "by": "agent"
                    }
                  },
                  {
                    "act": {
                      "cap": "verify_native_on_simulator",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "Strangle"
                  }
                ],
                "done": []
              }
            }
          }
        ]
      }
    },
    {
      "act": {
        "cap": "wire_data_auth_storage",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "ship": [
            {
              "act": {
                "cap": "ship_to_stores",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "worklist_written",
      "shell_scaffolded",
      "dom_shell_built",
      "native_verified",
      "data_wired"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
