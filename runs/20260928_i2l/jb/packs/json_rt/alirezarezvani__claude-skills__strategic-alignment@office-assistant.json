{
  "name": "strategic-alignment",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_alignment_questions": {
      "owner": "agent",
      "add": [
        "strategy_context_gathered"
      ],
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      }
    },
    "read_okr_file": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "okr_file_provided"
        ]
      },
      "add": [
        "okrs_loaded"
      ]
    },
    "collect_okrs_in_chat": {
      "owner": "agent",
      "add": [
        "okrs_loaded"
      ],
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      }
    },
    "write_alignment_report": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          {
            "and": [
              "okrs_loaded",
              "strategy_context_gathered"
            ]
          }
        ]
      },
      "add": [
        "cascade_map_written",
        "orphans_conflicts_gaps_reported",
        "alignment_score_reported",
        "realignment_plan_written"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "ask_alignment_questions",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "okr_file": [
            {
              "act": {
                "cap": "read_okr_file",
                "by": "agent"
              }
            }
          ],
          "okrs_in_chat": [
            {
              "act": {
                "cap": "collect_okrs_in_chat",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "write_alignment_report",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "cascade_map_written",
      "orphans_conflicts_gaps_reported",
      "alignment_score_reported",
      "realignment_plan_written"
    ]
  },
  "init_true": [
    "needs:user_conversation",
    "needs:local_filesystem"
  ],
  "init_constraints": []
}
