{
  "name": "fuzzing-obstacles",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_source_for_obstacle": {
      "owner": "agent",
      "add": [
        "obstacle_located"
      ]
    },
    "patch_obstacle_conditionally": {
      "owner": "agent",
      "pre": "obstacle_located",
      "add": [
        "obstacle_patched"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "run_fuzzer_baseline_coverage",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "inspect_source_for_obstacle",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "patch_obstacle_conditionally",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "rebuild_and_measure_coverage",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "obstacle_patched",
      "patched_coverage_measured"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
