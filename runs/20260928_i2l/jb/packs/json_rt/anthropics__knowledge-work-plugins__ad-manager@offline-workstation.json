{
  "name": "ad-manager",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "request_csv_export": {
      "owner": "agent",
      "add": [
        "csv_provided"
      ],
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      }
    },
    "read_csv_export": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "csv_provided"
        ]
      },
      "add": [
        "performance_data_loaded"
      ]
    },
    "read_voice_profile": {
      "owner": "agent",
      "add": [
        "voice_profile_checked"
      ],
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      }
    },
    "write_analysis_artifact": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          {
            "and": [
              "performance_data_loaded",
              "voice_profile_checked"
            ]
          }
        ]
      },
      "add": [
        "campaign_verdicts_given",
        "attribution_gap_reported",
        "recommendations_with_dollars",
        "ad_copy_drafted",
        "creative_briefs_written",
        "analysis_artifact_rendered"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "request_csv_export",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_csv_export",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_voice_profile",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_analysis_artifact",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "performance_data_loaded",
      "campaign_verdicts_given",
      "attribution_gap_reported",
      "recommendations_with_dollars",
      "ad_copy_drafted",
      "creative_briefs_written",
      "analysis_artifact_rendered"
    ]
  },
  "init_true": [
    "needs:user_conversation",
    "needs:local_filesystem"
  ],
  "init_constraints": []
}
