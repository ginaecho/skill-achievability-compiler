{
  "name": "api-breaking-change-detector",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_backend_contract": {
      "owner": "agent",
      "pre": true,
      "add": [
        "backend_contract_extracted"
      ]
    },
    "search_client_consumers": {
      "owner": "agent",
      "pre": "backend_contract_extracted",
      "add": [
        "consumers_located"
      ]
    },
    "read_client_code": {
      "owner": "agent",
      "pre": "consumers_located",
      "add": [
        "client_contract_extracted"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_backend_contract",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "search_client_consumers",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_client_code",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "backend_contract_extracted",
      "consumers_located",
      "client_contract_extracted"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
