{
  "name": "client-review",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "gather_client_context": {
      "owner": "agent",
      "add": [
        "client_context_known"
      ],
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      }
    },
    "collect_account_data_from_user": {
      "owner": "agent",
      "add": [
        "account_data_loaded"
      ],
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      }
    },
    "compute_performance_and_allocation": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:shell",
          "needs:preinstalled_software",
          {
            "and": [
              "account_data_loaded",
              "client_context_known"
            ]
          }
        ]
      },
      "add": [
        "performance_table_built",
        "allocation_drift_computed"
      ]
    },
    "render_allocation_chart": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:shell",
          "needs:preinstalled_software",
          "allocation_drift_computed"
        ]
      },
      "add": [
        "allocation_chart_rendered"
      ]
    },
    "produce_review_document": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:shell",
          "needs:preinstalled_software",
          "needs:local_filesystem",
          {
            "and": [
              "performance_table_built",
              "allocation_chart_rendered"
            ]
          }
        ]
      },
      "add": [
        "review_summary_doc",
        "agenda_included",
        "action_items_included"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "gather_client_context",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "collect_account_data_from_user",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "compute_performance_and_allocation",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "render_allocation_chart",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "produce_review_document",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "review_summary_doc",
      "performance_table_built",
      "allocation_chart_rendered",
      "agenda_included",
      "action_items_included"
    ]
  },
  "init_true": [
    "needs:user_conversation",
    "needs:shell",
    "needs:preinstalled_software",
    "needs:local_filesystem"
  ],
  "init_constraints": []
}
