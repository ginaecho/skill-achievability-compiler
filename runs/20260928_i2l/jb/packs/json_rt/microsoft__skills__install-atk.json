{
  "name": "install-atk",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "set_telemetry_env": {
      "owner": "agent",
      "pre": true,
      "add": [
        "telemetry_tagged"
      ]
    },
    "verify_atk_cli": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:package_registries",
          "telemetry_tagged"
        ]
      },
      "add": [
        "cli_verified"
      ]
    },
    "install_vscode_extension": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet"
        ]
      },
      "add": [
        "extension_installed"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "set_telemetry_env",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "everything": [
            {
              "act": {
                "cap": "verify_atk_cli",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "install_vscode_extension",
                "by": "agent"
              }
            }
          ],
          "cli_only": [
            {
              "act": {
                "cap": "verify_atk_cli",
                "by": "agent"
              }
            }
          ],
          "extension_only": [
            {
              "act": {
                "cap": "install_vscode_extension",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "or": [
      "cli_verified",
      "extension_installed"
    ]
  },
  "init_true": [
    "needs:package_registries",
    "needs:public_internet"
  ],
  "init_constraints": []
}
