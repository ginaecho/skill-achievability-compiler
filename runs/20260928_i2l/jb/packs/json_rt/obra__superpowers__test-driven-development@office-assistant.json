{
  "name": "test-driven-development",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "write_failing_test": {
      "owner": "agent",
      "add": [
        "test_written"
      ],
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      }
    },
    "write_minimal_impl": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "watched_fail"
        ]
      },
      "add": [
        "impl_written"
      ]
    },
    "fix_impl": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "suite_run"
        ]
      },
      "del": [
        "suite_run",
        "all_tests_pass"
      ]
    },
    "refactor_code": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "all_tests_pass"
        ]
      },
      "add": [
        "refactored"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_failing_test",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_test_verify_red",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_minimal_impl",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "GREEN",
        "body": [
          {
            "act": {
              "cap": "run_full_suite",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "external": true,
              "observed": true,
              "branches": {
                "pass": [
                  {
                    "act": {
                      "cap": "confirm_suite_green",
                      "by": "agent"
                    }
                  }
                ],
                "fail": [
                  {
                    "act": {
                      "cap": "fix_impl",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "GREEN"
                  }
                ]
              }
            }
          }
        ]
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "refactor": [
            {
              "act": {
                "cap": "refactor_code",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "run_full_suite",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "confirm_suite_green",
                "by": "agent"
              }
            }
          ],
          "no_refactor": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "test_written",
      "watched_fail",
      "impl_written",
      "all_tests_pass"
    ]
  },
  "init_true": [
    "needs:local_filesystem"
  ],
  "init_constraints": []
}
