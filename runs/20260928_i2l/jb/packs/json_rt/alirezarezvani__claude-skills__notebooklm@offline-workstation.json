{
  "name": "notebooklm",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "intake_questions": {
      "owner": "agent",
      "add": [
        "action_chosen",
        "params_gathered"
      ],
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      }
    },
    "save_extract_file": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "answer_extracted"
        ]
      },
      "add": [
        "extract_saved"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "intake_questions",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "open_notebooklm",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "read_extract": [
            {
              "act": {
                "cap": "open_notebook",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "query_notebook",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "save_to_file": [
                    {
                      "act": {
                        "cap": "save_extract_file",
                        "by": "agent"
                      }
                    }
                  ],
                  "chat_only": []
                }
              }
            }
          ],
          "add_source": [
            {
              "act": {
                "cap": "open_notebook",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "add_source",
                "by": "agent"
              }
            }
          ],
          "studio_output": [
            {
              "act": {
                "cap": "open_notebook",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "start_studio_generation",
                "by": "agent"
              }
            }
          ],
          "create_notebook": [
            {
              "act": {
                "cap": "create_notebook",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": "action_done",
  "init_true": [
    "needs:user_conversation",
    "needs:local_filesystem"
  ],
  "init_constraints": []
}
