{
  "name": "board-deck-builder",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_stage_and_metrics": {
      "owner": "agent",
      "add": [
        "cadence_stage_known",
        "metrics_provided"
      ]
    },
    "read_deck_template": {
      "owner": "agent",
      "add": [
        "template_loaded"
      ]
    },
    "write_board_deck": {
      "owner": "agent",
      "pre": {
        "and": [
          "cadence_stage_known",
          "metrics_provided",
          "template_loaded"
        ]
      },
      "add": [
        "deck_written",
        "gaps_marked_as_placeholders",
        "asks_section_included"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "ask_stage_and_metrics",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_deck_template",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_board_deck",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "deck_written",
      "gaps_marked_as_placeholders",
      "asks_section_included"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
