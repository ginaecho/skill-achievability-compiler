{
  "name": "dispatching-parallel-agents",
  "roles": [
    "agent",
    "worker1",
    "worker2",
    "worker3"
  ],
  "capabilities": {
    "fix_domain1": {
      "owner": "worker1",
      "pre": "tasks_dispatched",
      "add": [
        "domain1_fixed"
      ]
    },
    "fix_domain2": {
      "owner": "worker2",
      "pre": "tasks_dispatched",
      "add": [
        "domain2_fixed"
      ]
    },
    "fix_domain3": {
      "owner": "worker3",
      "pre": "tasks_dispatched",
      "add": [
        "domain3_fixed"
      ]
    },
    "check_conflicts": {
      "owner": "agent",
      "pre": {
        "and": [
          "domain1_fixed",
          "domain2_fixed",
          "domain3_fixed"
        ]
      },
      "add": [
        "no_conflicts"
      ]
    },
    "run_full_suite": {
      "owner": "agent",
      "pre": "no_conflicts",
      "add": [
        "full_suite_green"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "dispatch_subagents",
        "by": "agent"
      }
    },
    {
      "spawn": {
        "role": "worker1"
      }
    },
    {
      "spawn": {
        "role": "worker2"
      }
    },
    {
      "spawn": {
        "role": "worker3"
      }
    },
    {
      "msg": {
        "from": "agent",
        "to": "worker1",
        "label": "task_domain1"
      }
    },
    {
      "msg": {
        "from": "agent",
        "to": "worker2",
        "label": "task_domain2"
      }
    },
    {
      "msg": {
        "from": "agent",
        "to": "worker3",
        "label": "task_domain3"
      }
    },
    {
      "act": {
        "cap": "fix_domain1",
        "by": "worker1"
      }
    },
    {
      "act": {
        "cap": "fix_domain2",
        "by": "worker2"
      }
    },
    {
      "act": {
        "cap": "fix_domain3",
        "by": "worker3"
      }
    },
    {
      "msg": {
        "from": "worker1",
        "to": "agent",
        "label": "summary1"
      }
    },
    {
      "msg": {
        "from": "worker2",
        "to": "agent",
        "label": "summary2"
      }
    },
    {
      "msg": {
        "from": "worker3",
        "to": "agent",
        "label": "summary3"
      }
    },
    {
      "act": {
        "cap": "check_conflicts",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_full_suite",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "domain1_fixed",
      "domain2_fixed",
      "domain3_fixed",
      "full_suite_green"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
