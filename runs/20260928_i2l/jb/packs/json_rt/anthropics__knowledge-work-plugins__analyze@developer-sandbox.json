{
  "name": "analyze",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "request_data_from_user": {
      "owner": "agent",
      "add": [
        "data_provided"
      ],
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      }
    },
    "load_user_data": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:shell",
          "needs:local_filesystem",
          "data_provided"
        ]
      },
      "add": [
        "data_available"
      ]
    },
    "analyze_and_validate": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:shell",
          "data_available"
        ]
      },
      "add": [
        "analysis_done",
        "validation_checks_done"
      ]
    },
    "render_visualization": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:shell",
          "needs:package_registries",
          "analysis_done"
        ]
      },
      "add": [
        "chart_rendered"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "request_data_from_user",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "load_user_data",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "analyze_and_validate",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "visualize": [
            {
              "act": {
                "cap": "render_visualization",
                "by": "agent"
              }
            }
          ],
          "no_chart": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "data_available",
      "analysis_done",
      "validation_checks_done"
    ]
  },
  "init_true": [
    "needs:user_conversation",
    "needs:shell",
    "needs:local_filesystem",
    "needs:package_registries"
  ],
  "init_constraints": []
}
