{
  "name": "linear",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "setup_linear_mcp": {
      "owner": "agent",
      "add": [
        "linear_mcp_connected"
      ],
      "pre": {
        "and": [
          "needs:linear_account",
          "needs:codex_cli"
        ]
      }
    },
    "clarify_scope": {
      "owner": "agent",
      "add": [
        "scope_confirmed"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "mcp_not_connected": [
            {
              "act": {
                "cap": "setup_linear_mcp",
                "by": "agent"
              }
            }
          ],
          "mcp_connected": []
        }
      }
    },
    {
      "act": {
        "cap": "clarify_scope",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_linear_context",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_or_update_issues",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "scope_confirmed",
      "context_loaded",
      "issues_changed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
