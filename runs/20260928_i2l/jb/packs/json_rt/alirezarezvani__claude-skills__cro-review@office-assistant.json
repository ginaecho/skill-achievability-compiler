{
  "name": "cro-review",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_plan": {
      "owner": "agent",
      "add": [
        "plan_loaded"
      ]
    },
    "ask_revenue_data": {
      "owner": "agent",
      "add": [
        "revenue_data_known"
      ]
    },
    "write_cro_review": {
      "owner": "agent",
      "pre": {
        "and": [
          "plan_loaded",
          "revenue_data_known"
        ]
      },
      "add": [
        "review_written",
        "verdict_given",
        "next_steps_listed"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_plan",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "ask_revenue_data",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_cro_review",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "review_written",
      "verdict_given",
      "next_steps_listed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
