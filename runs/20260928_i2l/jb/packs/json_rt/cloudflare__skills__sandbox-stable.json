{
  "name": "sandbox-stable",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_app_package_line": {
      "owner": "agent",
      "pre": true,
      "add": [
        "package_line_inspected"
      ]
    },
    "fetch_sandbox_docs": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet"
        ]
      },
      "add": [
        "docs_retrieved"
      ]
    },
    "install_stable_package": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:package_registries",
          {
            "and": [
              "package_line_inspected",
              "is_stable_line"
            ]
          }
        ]
      },
      "add": [
        "stable_types_installed"
      ]
    },
    "implement_worker_code": {
      "owner": "agent",
      "pre": {
        "and": [
          "is_stable_line",
          "docs_retrieved",
          "stable_types_installed"
        ]
      },
      "add": [
        "worker_code_written"
      ]
    },
    "align_container_image": {
      "owner": "agent",
      "pre": "is_stable_line",
      "add": [
        "image_on_stable_line"
      ]
    },
    "typecheck": {
      "owner": "agent",
      "pre": {
        "and": [
          "worker_code_written",
          "stable_types_installed"
        ]
      },
      "add": [
        "typecheck_passed"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_app_package_line",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_sandbox_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_stable_package",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "align_container_image",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "implement_worker_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "typecheck",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "worker_code_written",
      "image_on_stable_line",
      "typecheck_passed"
    ]
  },
  "init_true": [
    "is_stable_line",
    "needs:public_internet",
    "needs:package_registries"
  ],
  "init_constraints": []
}
