{
  "name": "skill-writer",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_workspace": {
      "owner": "agent",
      "add": [
        "workspace_inspected",
        "target_resolved"
      ]
    },
    "ask_target_location": {
      "owner": "agent",
      "add": [
        "target_resolved"
      ]
    },
    "collect_sources": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet",
          "workspace_inspected"
        ]
      },
      "add": [
        "sources_collected"
      ]
    },
    "capture_iteration_examples": {
      "owner": "agent",
      "pre": "workspace_inspected",
      "add": [
        "examples_captured"
      ]
    },
    "author_skill_files": {
      "owner": "agent",
      "pre": {
        "and": [
          "workspace_inspected",
          "target_resolved"
        ]
      },
      "add": [
        "skill_authored"
      ]
    },
    "optimize_description": {
      "owner": "agent",
      "pre": "skill_authored",
      "add": [
        "description_optimized"
      ]
    },
    "register_skill": {
      "owner": "agent",
      "pre": "skill_authored",
      "add": [
        "skill_registered"
      ]
    },
    "run_validation": {
      "owner": "agent",
      "pre": "skill_registered",
      "add": [
        "skill_validated"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_workspace",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "location_unclear": [
            {
              "act": {
                "cap": "ask_target_location",
                "by": "agent"
              }
            }
          ],
          "location_clear": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "synthesis": [
            {
              "act": {
                "cap": "collect_sources",
                "by": "agent"
              }
            }
          ],
          "skip_synthesis": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "iterate": [
            {
              "act": {
                "cap": "capture_iteration_examples",
                "by": "agent"
              }
            }
          ],
          "no_iteration": []
        }
      }
    },
    {
      "act": {
        "cap": "author_skill_files",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "optimize_description",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "register_skill",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_validation",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "skill_authored",
      "description_optimized",
      "skill_registered",
      "skill_validated"
    ]
  },
  "init_true": [
    "needs:public_internet"
  ],
  "init_constraints": []
}
