{
  "name": "nav-tieout",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "read_lp_statement": {
      "owner": "agent",
      "add": [
        "statement_loaded"
      ],
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      }
    },
    "recompute_and_compare": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:shell",
          {
            "and": [
              "statement_loaded",
              "nav_pack_loaded",
              "commitment_register_loaded"
            ]
          }
        ]
      },
      "add": [
        "capital_account_recomputed",
        "lines_compared",
        "additional_checks_done",
        "flags_listed"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_lp_statement",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_nav_pack",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_commitment_register",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "recompute_and_compare",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "capital_account_recomputed",
      "lines_compared",
      "additional_checks_done",
      "flags_listed",
      {
        "not": "statement_edited"
      }
    ]
  },
  "init_true": [
    "needs:local_filesystem",
    "needs:shell"
  ],
  "init_constraints": []
}
