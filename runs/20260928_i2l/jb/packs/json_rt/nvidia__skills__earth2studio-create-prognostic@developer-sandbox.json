{
  "name": "earth2studio-create-prognostic",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "fetch_reference_script": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet"
        ]
      },
      "add": [
        "reference_script"
      ]
    },
    "ask_reference_script": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      },
      "add": [
        "reference_script"
      ]
    },
    "confirm_dependencies": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation",
          "reference_script"
        ]
      },
      "add": [
        "deps_approved"
      ]
    },
    "add_model_extra": {
      "owner": "agent",
      "pre": "deps_approved",
      "add": [
        "pyproject_updated"
      ]
    },
    "write_model_file": {
      "owner": "agent",
      "pre": "reference_script",
      "add": [
        "model_file_created"
      ]
    },
    "write_tests": {
      "owner": "agent",
      "pre": "model_file_created",
      "add": [
        "tests_created"
      ]
    },
    "run_mock_tests": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:package_registries",
          {
            "and": [
              "tests_created",
              "pyproject_updated"
            ]
          }
        ]
      },
      "add": [
        "mock_tests_pass"
      ]
    },
    "run_package_test": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet",
          "needs:package_registries",
          "mock_tests_pass"
        ]
      },
      "add": [
        "package_test_pass"
      ]
    },
    "update_docs_changelog": {
      "owner": "agent",
      "pre": "model_file_created",
      "add": [
        "docs_updated",
        "changelog_updated"
      ]
    },
    "format_and_lint": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:package_registries",
          {
            "and": [
              "model_file_created",
              "tests_created",
              "docs_updated"
            ]
          }
        ]
      },
      "add": [
        "lint_clean"
      ]
    },
    "register_model": {
      "owner": "agent",
      "pre": "model_file_created",
      "add": [
        "model_registered"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "url_given": [
            {
              "act": {
                "cap": "fetch_reference_script",
                "by": "agent"
              }
            }
          ],
          "not_given": [
            {
              "act": {
                "cap": "ask_reference_script",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "confirm_dependencies",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "add_model_extra",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_model_file",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_tests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_mock_tests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_package_test",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "register": [
            {
              "act": {
                "cap": "register_model",
                "by": "agent"
              }
            }
          ],
          "skip_register": []
        }
      }
    },
    {
      "act": {
        "cap": "update_docs_changelog",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "format_and_lint",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "pyproject_updated",
      "model_file_created",
      "tests_created",
      "mock_tests_pass",
      "package_test_pass",
      "docs_updated",
      "changelog_updated",
      "lint_clean"
    ]
  },
  "init_true": [
    "needs:public_internet",
    "needs:user_conversation",
    "needs:package_registries"
  ],
  "init_constraints": []
}
