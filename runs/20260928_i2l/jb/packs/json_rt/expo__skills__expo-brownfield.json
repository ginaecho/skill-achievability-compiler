{
  "name": "expo-brownfield",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_host_app": {
      "owner": "agent",
      "pre": "host_app_available",
      "add": [
        "host_inspected"
      ]
    },
    "install_rn_dependencies": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:package_registries",
          "host_inspected"
        ]
      },
      "add": [
        "rn_dependencies_installed"
      ]
    },
    "write_integration_code": {
      "owner": "agent",
      "pre": "rn_dependencies_installed",
      "add": [
        "integration_code_written"
      ]
    },
    "build_android_artifact_or_host": {
      "owner": "agent",
      "pre": "integration_code_written",
      "add": [
        "android_host_built"
      ]
    },
    "verify_android_feature_in_host": {
      "owner": "agent",
      "pre": "android_host_built",
      "add": [
        "feature_verified_in_host"
      ]
    },
    "submit_feedback": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet",
          "host_inspected"
        ]
      },
      "add": [
        "feedback_submitted"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_host_app",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_rn_dependencies",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_integration_code",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "android_host": [
            {
              "act": {
                "cap": "build_android_artifact_or_host",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "verify_android_feature_in_host",
                "by": "agent"
              }
            }
          ],
          "ios_host": [
            {
              "act": {
                "cap": "build_ios_artifact_or_host",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "verify_ios_feature_in_host",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "send_feedback": [
            {
              "act": {
                "cap": "submit_feedback",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "integration_code_written",
      "feature_verified_in_host"
    ]
  },
  "init_true": [
    "host_app_available",
    "needs:package_registries",
    "needs:public_internet"
  ],
  "init_constraints": []
}
