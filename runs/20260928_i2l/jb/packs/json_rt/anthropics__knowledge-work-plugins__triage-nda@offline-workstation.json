{
  "name": "triage-nda",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_nda_file": {
      "owner": "agent",
      "pre": "nda_file_provided",
      "add": [
        "nda_text_available"
      ]
    },
    "load_playbook": {
      "owner": "agent",
      "pre": "playbook_exists",
      "add": [
        "playbook_loaded"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_nda_file",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "playbook_configured": [
            {
              "act": {
                "cap": "load_playbook",
                "by": "agent"
              }
            }
          ],
          "use_defaults": []
        }
      }
    }
  ],
  "goal": "nda_text_available",
  "init_true": [
    "nda_file_provided",
    "playbook_exists"
  ],
  "init_constraints": []
}
