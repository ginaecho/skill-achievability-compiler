{
  "name": "neon-ai-gateway",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "fetch_neon_docs": {
      "owner": "agent",
      "add": [
        "docs_verified"
      ],
      "pre": {
        "and": [
          "needs:public_internet"
        ]
      }
    },
    "confirm_region_and_plan": {
      "owner": "agent",
      "add": [
        "preconditions_confirmed"
      ]
    },
    "write_neon_config": {
      "owner": "agent",
      "add": [
        "gateway_declared"
      ]
    },
    "write_client_code": {
      "owner": "agent",
      "pre": "docs_verified",
      "add": [
        "client_code_written"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "fetch_neon_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "confirm_region_and_plan",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_neon_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "deploy_gateway",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_client_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_sdk",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_inference_request",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "gateway_provisioned",
      "client_code_written",
      "inference_succeeded"
    ]
  },
  "init_true": [
    "needs:public_internet"
  ],
  "init_constraints": []
}
