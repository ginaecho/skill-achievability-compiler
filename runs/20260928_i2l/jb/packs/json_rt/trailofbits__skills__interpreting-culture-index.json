{
  "name": "interpreting-culture-index",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_for_json": {
      "owner": "agent",
      "pre": "profile_input_provided",
      "add": [
        "json_checked"
      ]
    },
    "locate_existing_json": {
      "owner": "agent",
      "pre": "json_checked",
      "add": [
        "profile_json_available"
      ]
    },
    "check_uv_present": {
      "owner": "agent",
      "pre": "json_checked",
      "add": [
        "uv_installed"
      ]
    },
    "install_uv": {
      "owner": "agent",
      "add": [
        "uv_installed"
      ],
      "pre": {
        "and": [
          "needs:public_internet"
        ]
      }
    },
    "extract_pdf_to_json": {
      "owner": "agent",
      "pre": {
        "and": [
          "json_checked",
          "uv_installed"
        ]
      },
      "add": [
        "profile_json_available",
        "extraction_verified"
      ]
    },
    "load_profile_json": {
      "owner": "agent",
      "pre": "profile_json_available",
      "add": [
        "profile_loaded"
      ]
    },
    "read_workflow_and_references": {
      "owner": "agent",
      "pre": "profile_loaded",
      "add": [
        "workflow_loaded"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_for_json",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "json_available": [
            {
              "act": {
                "cap": "locate_existing_json",
                "by": "agent"
              }
            }
          ],
          "pdf_only": [
            {
              "choice": {
                "by": "agent",
                "observed": true,
                "branches": {
                  "uv_missing": [
                    {
                      "act": {
                        "cap": "install_uv",
                        "by": "agent"
                      }
                    }
                  ],
                  "uv_present": [
                    {
                      "act": {
                        "cap": "check_uv_present",
                        "by": "agent"
                      }
                    }
                  ]
                }
              }
            },
            {
              "act": {
                "cap": "extract_pdf_to_json",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "load_profile_json",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_workflow_and_references",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "profile_loaded",
      "workflow_loaded"
    ]
  },
  "init_true": [
    "profile_input_provided",
    "needs:public_internet"
  ],
  "init_constraints": []
}
