{
  "name": "cloudflare_product_discovery",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_project": {
      "owner": "agent",
      "pre": true,
      "add": [
        "project_inspected"
      ]
    },
    "fetch_cloudflare_docs": {
      "owner": "agent",
      "pre": "project_inspected",
      "add": [
        "docs_retrieved"
      ]
    },
    "load_product_reference": {
      "owner": "agent",
      "pre": "docs_retrieved",
      "add": [
        "product_guidance_loaded"
      ]
    },
    "validate_change": {
      "owner": "agent",
      "pre": "product_guidance_loaded",
      "add": [
        "change_validated"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_project",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_cloudflare_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "load_product_reference",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "validate": [
            {
              "act": {
                "cap": "validate_change",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "project_inspected",
      "docs_retrieved",
      "product_guidance_loaded"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
