{
  "name": "data-breach-blast-radius",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "detect_stack": {
      "owner": "agent",
      "pre": true,
      "add": [
        "stack_detected"
      ]
    },
    "scan_sensitive_data": {
      "owner": "agent",
      "pre": "stack_detected",
      "add": [
        "inventory_built"
      ]
    },
    "trace_data_flows": {
      "owner": "agent",
      "pre": "inventory_built",
      "add": [
        "flows_traced",
        "exposure_vectors_found"
      ]
    },
    "render_data_flow_diagram": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:package_registries",
          "flows_traced"
        ]
      },
      "add": [
        "diagram_rendered"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "detect_stack",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scan_sensitive_data",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "trace_data_flows",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "render_data_flow_diagram",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "inventory_built",
      "flows_traced",
      "exposure_vectors_found",
      "diagram_rendered"
    ]
  },
  "init_true": [
    "needs:package_registries"
  ],
  "init_constraints": []
}
