{
  "name": "journal-entry",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "request_source_data_from_user": {
      "owner": "agent",
      "pre": true,
      "add": [
        "source_data_available"
      ]
    },
    "read_uploaded_schedule": {
      "owner": "agent",
      "pre": "user_uploaded_file",
      "add": [
        "source_data_available"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "request_source_data_from_user",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "pasted_in_chat": [],
          "uploaded_file": [
            {
              "act": {
                "cap": "read_uploaded_schedule",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": "source_data_available",
  "init_true": [
    "user_uploaded_file"
  ],
  "init_constraints": []
}
