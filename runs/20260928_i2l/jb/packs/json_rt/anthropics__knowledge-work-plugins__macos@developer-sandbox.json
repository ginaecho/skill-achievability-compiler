{
  "name": "zoom-video-sdk-macos",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "fetch_sdk_docs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "docs_consulted"
      ]
    },
    "write_app_source": {
      "owner": "agent",
      "pre": "docs_consulted",
      "add": [
        "app_source_written"
      ]
    },
    "generate_session_token": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:zoom_sdk_key_secret"
        ]
      },
      "add": [
        "session_token_ready"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "fetch_sdk_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "download_macos_sdk",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_app_source",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_session_token",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_macos_app",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "join_video_session",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "app_built",
      "session_joined"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
