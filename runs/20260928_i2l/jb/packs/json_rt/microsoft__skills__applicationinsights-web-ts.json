{
  "name": "applicationinsights-web-ts",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "lookup_current_docs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "docs_checked"
      ]
    },
    "verify_package_version": {
      "owner": "agent",
      "pre": true,
      "add": [
        "version_verified"
      ]
    },
    "install_sdk": {
      "owner": "agent",
      "pre": "version_verified",
      "add": [
        "sdk_installed"
      ]
    },
    "write_init_module": {
      "owner": "agent",
      "pre": "sdk_installed",
      "add": [
        "sdk_initialized"
      ]
    },
    "add_env_connection_string": {
      "owner": "agent",
      "pre": true,
      "add": [
        "connection_string_configured"
      ]
    },
    "add_custom_tracking": {
      "owner": "agent",
      "pre": "sdk_initialized",
      "add": [
        "custom_tracking_added"
      ]
    },
    "add_genai_spans": {
      "owner": "agent",
      "pre": "sdk_initialized",
      "add": [
        "genai_traces_added"
      ]
    },
    "build_app": {
      "owner": "agent",
      "pre": {
        "and": [
          "sdk_initialized",
          "connection_string_configured"
        ]
      },
      "add": [
        "app_builds"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "lookup_current_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_package_version",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_sdk",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_init_module",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "add_env_connection_string",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "custom_tracking": [
            {
              "act": {
                "cap": "add_custom_tracking",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "genai": [
            {
              "act": {
                "cap": "add_genai_spans",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    },
    {
      "act": {
        "cap": "build_app",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "sdk_installed",
      "sdk_initialized",
      "connection_string_configured",
      "app_builds"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
