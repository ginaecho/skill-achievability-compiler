{
  "name": "goal-prompt",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_repo_context": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      },
      "add": [
        "elements_grounded"
      ]
    },
    "write_goal_md": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "elements_grounded"
        ]
      },
      "add": [
        "goal_md_written"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_repo_context",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "long_brief": [
            {
              "act": {
                "cap": "write_goal_md",
                "by": "agent"
              }
            }
          ],
          "short_brief": []
        }
      }
    },
    {
      "act": {
        "cap": "run_goal_formatter",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "elements_grounded",
      "goal_formatted"
    ]
  },
  "init_true": [
    "needs:local_filesystem"
  ],
  "init_constraints": []
}
