{
  "name": "teams-app-developer",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_subskill_docs": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      },
      "add": [
        "subskill_read"
      ]
    },
    "collect_env_values": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation",
          "project_created"
        ]
      },
      "add": [
        "env_values_known"
      ]
    },
    "write_env_config": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "env_values_known"
        ]
      },
      "add": [
        "env_configured"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_subskill_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_or_check_atk_cli",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scaffold_project",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "collect_env_values",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_env_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "start_local_app",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "test_in_agents_playground",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "project_created",
      "env_configured",
      "app_tested_locally"
    ]
  },
  "init_true": [
    "needs:local_filesystem",
    "needs:user_conversation"
  ],
  "init_constraints": []
}
