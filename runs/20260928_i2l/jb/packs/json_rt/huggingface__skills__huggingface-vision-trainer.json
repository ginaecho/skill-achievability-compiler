{
  "name": "huggingface-vision-trainer",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "verify_hf_auth": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:hf_token",
          "needs:hf_paid_plan"
        ]
      },
      "add": [
        "auth_verified"
      ]
    },
    "validate_dataset_locally": {
      "owner": "agent",
      "pre": true,
      "add": [
        "dataset_validated"
      ]
    },
    "ask_training_preferences": {
      "owner": "agent",
      "pre": "dataset_validated",
      "add": [
        "preferences_set"
      ]
    },
    "save_training_script": {
      "owner": "agent",
      "pre": "preferences_set",
      "add": [
        "script_saved"
      ]
    },
    "submit_training_job": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:hf_token",
          "needs:hf_paid_plan",
          "needs:hf_jobs_gpu",
          {
            "and": [
              "auth_verified",
              "script_saved",
              "dataset_validated"
            ]
          }
        ]
      },
      "add": [
        "job_submitted",
        "model_push_configured"
      ]
    },
    "check_job_status": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:hf_token",
          "job_submitted"
        ]
      },
      "add": [
        "status_reported"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "verify_hf_auth",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_dataset_locally",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "ask_training_preferences",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "save_training_script",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "submit_training_job",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "check_status": [
            {
              "act": {
                "cap": "check_job_status",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "dataset_validated",
      "script_saved",
      "job_submitted",
      "model_push_configured"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
