{
  "name": "launch-strategy",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_marketing_context": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "context_file_exists"
        ]
      },
      "add": [
        "context_loaded"
      ]
    },
    "ask_launch_questions": {
      "owner": "agent",
      "add": [
        "launch_info_gathered"
      ],
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      }
    },
    "write_launch_plan": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "launch_info_gathered"
        ]
      },
      "add": [
        "launch_plan_written",
        "orb_owned_covered",
        "orb_rented_covered",
        "orb_borrowed_covered",
        "launch_day_checklist_included",
        "post_launch_plan_included"
      ]
    },
    "write_product_hunt_brief": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "launch_info_gathered"
        ]
      },
      "add": [
        "ph_brief_written"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "external": true,
        "observed": true,
        "branches": {
          "context_exists": [
            {
              "act": {
                "cap": "read_marketing_context",
                "by": "agent"
              }
            }
          ],
          "no_context": []
        }
      }
    },
    {
      "act": {
        "cap": "ask_launch_questions",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_launch_plan",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "product_hunt": [
            {
              "act": {
                "cap": "write_product_hunt_brief",
                "by": "agent"
              }
            }
          ],
          "no_product_hunt": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "launch_plan_written",
      "orb_owned_covered",
      "orb_rented_covered",
      "orb_borrowed_covered",
      "launch_day_checklist_included",
      "post_launch_plan_included"
    ]
  },
  "init_true": [
    "needs:local_filesystem",
    "needs:user_conversation"
  ],
  "init_constraints": []
}
