{
  "name": "notion-meeting-intelligence",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_meeting_inputs": {
      "owner": "agent",
      "add": [
        "inputs_known"
      ]
    },
    "read_templates": {
      "owner": "agent",
      "add": [
        "template_chosen"
      ]
    },
    "web_research": {
      "owner": "agent",
      "pre": "inputs_known",
      "add": [
        "research_done"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "ask_meeting_inputs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "search_fetch_notion",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_templates",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_notion_page",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "enrich": [
            {
              "act": {
                "cap": "web_research",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "update_notion_page",
                "by": "agent"
              }
            }
          ],
          "skip_enrich": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "tasks_arise": [
            {
              "act": {
                "cap": "create_notion_tasks",
                "by": "agent"
              }
            }
          ],
          "no_tasks": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "context_gathered",
      "agenda_page_created"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
