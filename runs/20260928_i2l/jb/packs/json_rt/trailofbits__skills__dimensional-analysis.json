{
  "name": "dimensional-analysis",
  "roles": [
    "agent",
    "arithmetic_scanner",
    "dimension_discoverer",
    "dimension_annotator",
    "dimension_propagator",
    "dimension_validator"
  ],
  "capabilities": {
    "check_cached_artifacts": {
      "owner": "agent",
      "pre": "repo_available",
      "add": [
        "cache_checked"
      ]
    },
    "scan_and_write_scope": {
      "owner": "arithmetic_scanner",
      "pre": "repo_available",
      "add": [
        "scope_manifest_written"
      ]
    },
    "discover_and_write_units": {
      "owner": "dimension_discoverer",
      "pre": "scope_manifest_written",
      "add": [
        "units_vocabulary_written"
      ]
    },
    "verify_step1_artifacts": {
      "owner": "agent",
      "pre": {
        "and": [
          "scope_manifest_written",
          "units_vocabulary_written"
        ]
      },
      "add": [
        "step1_complete"
      ]
    },
    "annotate_anchors": {
      "owner": "dimension_annotator",
      "pre": "step1_complete",
      "add": [
        "anchors_annotated"
      ]
    },
    "persist_step2_status": {
      "owner": "agent",
      "pre": "anchors_annotated",
      "add": [
        "step2_complete"
      ]
    },
    "propagate_dimensions": {
      "owner": "dimension_propagator",
      "pre": "step2_complete",
      "add": [
        "dimensions_propagated"
      ]
    },
    "persist_step3_status": {
      "owner": "agent",
      "pre": "dimensions_propagated",
      "add": [
        "step3_complete"
      ]
    },
    "validate_file": {
      "owner": "dimension_validator",
      "pre": "step3_complete",
      "add": [
        "files_validated"
      ]
    },
    "persist_step4_status": {
      "owner": "agent",
      "pre": "files_validated",
      "add": [
        "step4_complete"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_cached_artifacts",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "reuse_cache": [],
          "rerun_step1": [
            {
              "spawn": {
                "role": "arithmetic_scanner"
              }
            },
            {
              "act": {
                "cap": "scan_and_write_scope",
                "by": "arithmetic_scanner"
              }
            },
            {
              "spawn": {
                "role": "dimension_discoverer"
              }
            },
            {
              "act": {
                "cap": "discover_and_write_units",
                "by": "dimension_discoverer"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "verify_step1_artifacts",
        "by": "agent"
      }
    },
    {
      "spawn": {
        "role": "dimension_annotator"
      }
    },
    {
      "act": {
        "cap": "annotate_anchors",
        "by": "dimension_annotator"
      }
    },
    {
      "act": {
        "cap": "persist_step2_status",
        "by": "agent"
      }
    },
    {
      "spawn": {
        "role": "dimension_propagator"
      }
    },
    {
      "act": {
        "cap": "propagate_dimensions",
        "by": "dimension_propagator"
      }
    },
    {
      "act": {
        "cap": "persist_step3_status",
        "by": "agent"
      }
    },
    {
      "spawn": {
        "role": "dimension_validator"
      }
    },
    {
      "act": {
        "cap": "validate_file",
        "by": "dimension_validator"
      }
    },
    {
      "act": {
        "cap": "persist_step4_status",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "scope_manifest_written",
      "units_vocabulary_written",
      "step2_complete",
      "step3_complete",
      "step4_complete"
    ]
  },
  "init_true": [
    "repo_available"
  ],
  "init_constraints": []
}
