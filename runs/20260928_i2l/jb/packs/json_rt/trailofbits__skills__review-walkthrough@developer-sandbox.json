{
  "name": "review-walkthrough",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "discover_default_base": {
      "owner": "agent",
      "add": [
        "base_known"
      ],
      "pre": {
        "and": [
          "needs:shell"
        ]
      }
    },
    "ask_base": {
      "owner": "agent",
      "add": [
        "base_known"
      ],
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      }
    },
    "capture_patch": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:shell",
          "needs:local_filesystem",
          "base_known"
        ]
      },
      "add": [
        "patch_captured"
      ]
    },
    "read_changed_sources": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "patch_captured"
        ]
      },
      "add": [
        "sources_reviewed"
      ]
    },
    "write_walkthrough_json": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          {
            "and": [
              "patch_captured",
              "sources_reviewed"
            ]
          }
        ]
      },
      "add": [
        "data_json_written"
      ]
    },
    "fix_walkthrough_json": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "data_json_written"
        ]
      },
      "add": [
        "data_json_written"
      ]
    },
    "run_renderer": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:shell",
          "needs:package_registries",
          {
            "and": [
              "data_json_written",
              "patch_captured"
            ]
          }
        ]
      },
      "add": [
        "renderer_ran"
      ]
    },
    "confirm_rendered": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:shell",
          "renderer_ran"
        ]
      },
      "add": [
        "walkthrough_rendered"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "external": true,
        "observed": true,
        "branches": {
          "user_supplied_base": [
            {
              "act": {
                "cap": "ask_base",
                "by": "agent"
              }
            }
          ],
          "default_branch": [
            {
              "act": {
                "cap": "discover_default_base",
                "by": "agent"
              }
            }
          ],
          "ambiguous": [
            {
              "act": {
                "cap": "ask_base",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "capture_patch",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_changed_sources",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_walkthrough_json",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "RENDER",
        "body": [
          {
            "act": {
              "cap": "run_renderer",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "external": true,
              "observed": true,
              "branches": {
                "valid": [
                  {
                    "act": {
                      "cap": "confirm_rendered",
                      "by": "agent"
                    }
                  }
                ],
                "input_errors": [
                  {
                    "act": {
                      "cap": "fix_walkthrough_json",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "RENDER"
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "goal": {
    "and": [
      "patch_captured",
      "data_json_written",
      "walkthrough_rendered"
    ]
  },
  "init_true": [
    "needs:shell",
    "needs:user_conversation",
    "needs:local_filesystem",
    "needs:package_registries"
  ],
  "init_constraints": []
}
