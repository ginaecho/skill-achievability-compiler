{
  "name": "entra-agent-id",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_latest_docs": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet"
        ]
      },
      "add": [
        "docs_checked"
      ]
    },
    "install_dependencies": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:package_registries"
        ]
      },
      "add": [
        "deps_installed"
      ]
    },
    "grant_admin_consent": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_entra_tenant",
          "needs:entra_admin_role",
          "deps_installed"
        ]
      },
      "nondet": {
        "consent_granted": true
      }
    },
    "acquire_graph_token": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_entra_tenant",
          "needs:app_registration_client_secret",
          "deps_installed"
        ]
      },
      "add": [
        "graph_token"
      ]
    },
    "create_blueprint": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_entra_tenant",
          "needs:agent_identity_developer_role",
          "graph_token"
        ]
      },
      "add": [
        "blueprint_created"
      ]
    },
    "create_blueprint_principal": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_entra_tenant",
          "needs:agent_identity_developer_role",
          {
            "and": [
              "graph_token",
              "blueprint_created"
            ]
          }
        ]
      },
      "add": [
        "blueprint_principal_created"
      ]
    },
    "create_agent_identity": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_entra_tenant",
          "needs:agent_identity_developer_role",
          {
            "and": [
              "graph_token",
              "blueprint_principal_created"
            ]
          }
        ]
      },
      "add": [
        "agent_identity_created"
      ]
    },
    "cleanup_resources": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_entra_tenant",
          "graph_token"
        ]
      },
      "add": [
        "resources_cleaned"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "check_docs": [
            {
              "act": {
                "cap": "check_latest_docs",
                "by": "agent"
              }
            }
          ],
          "skip_docs": []
        }
      }
    },
    {
      "act": {
        "cap": "install_dependencies",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "consent_needed": [
            {
              "rec": {
                "name": "ConsentRetry",
                "body": [
                  {
                    "act": {
                      "cap": "grant_admin_consent",
                      "by": "agent"
                    }
                  },
                  {
                    "choice": {
                      "by": "agent",
                      "observed": true,
                      "branches": {
                        "done": [],
                        "retry": [
                          {
                            "continue": "ConsentRetry"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            }
          ],
          "already_consented": []
        }
      }
    },
    {
      "act": {
        "cap": "acquire_graph_token",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_blueprint",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_blueprint_principal",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_agent_identity",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "cleanup": [
            {
              "act": {
                "cap": "cleanup_resources",
                "by": "agent"
              }
            }
          ],
          "keep": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "blueprint_created",
      "blueprint_principal_created",
      "agent_identity_created"
    ]
  },
  "init_true": [
    "needs:public_internet",
    "needs:package_registries"
  ],
  "init_constraints": []
}
