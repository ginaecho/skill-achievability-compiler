{
  "name": "call-prep",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_attendees": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      },
      "add": [
        "attendees_known"
      ]
    },
    "read_company_context": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      },
      "add": [
        "company_context_loaded"
      ]
    },
    "web_recency_check": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet",
          "account_researched"
        ]
      },
      "add": [
        "recency_checked"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "attendees_given": [],
          "ask": [
            {
              "act": {
                "cap": "ask_attendees",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "research_account_common_room",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "has_attendees": [
            {
              "act": {
                "cap": "research_contacts_common_room",
                "by": "agent"
              }
            }
          ],
          "no_attendees": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "context_file_present": [
            {
              "act": {
                "cap": "read_company_context",
                "by": "agent"
              }
            }
          ],
          "no_context": []
        }
      }
    },
    {
      "act": {
        "cap": "web_recency_check",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "account_researched",
      "recency_checked"
    ]
  },
  "init_true": [
    "needs:user_conversation",
    "needs:local_filesystem",
    "needs:public_internet"
  ],
  "init_constraints": []
}
