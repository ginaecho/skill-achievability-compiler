{
  "name": "frontend-design-review",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_ui_code": {
      "owner": "agent",
      "add": [
        "ui_code_inspected"
      ]
    },
    "run_ui_locally": {
      "owner": "agent",
      "add": [
        "ui_running"
      ],
      "pre": {
        "and": [
          "needs:package_registries",
          "needs:local_servers"
        ]
      }
    },
    "render_and_screenshot": {
      "owner": "agent",
      "pre": "ui_running",
      "add": [
        "ui_rendered_checked"
      ]
    },
    "write_frontend_code": {
      "owner": "agent",
      "add": [
        "ui_created"
      ]
    },
    "refine_frontend_code": {
      "owner": "agent",
      "pre": "ui_created",
      "add": [
        "ui_refined"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "design_review": [
            {
              "act": {
                "cap": "read_ui_code",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "agent",
                "observed": true,
                "branches": {
                  "visual_check": [
                    {
                      "act": {
                        "cap": "run_ui_locally",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "render_and_screenshot",
                        "by": "agent"
                      }
                    }
                  ],
                  "skip": []
                }
              }
            }
          ],
          "creative_design": [
            {
              "act": {
                "cap": "write_frontend_code",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "agent",
                "observed": true,
                "branches": {
                  "preview": [
                    {
                      "act": {
                        "cap": "run_ui_locally",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "render_and_screenshot",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "refine_frontend_code",
                        "by": "agent"
                      }
                    }
                  ],
                  "skip": []
                }
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "or": [
      "ui_code_inspected",
      "ui_created"
    ]
  },
  "init_true": [
    "needs:package_registries",
    "needs:local_servers"
  ],
  "init_constraints": []
}
