{
  "name": "gdpr-dsgvo-processing-assessment",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_processing_details": {
      "owner": "agent",
      "pre": "scan_report",
      "add": [
        "processing_details_known"
      ]
    },
    "write_dpia_input": {
      "owner": "agent",
      "pre": "processing_details_known",
      "add": [
        "dpia_input_file"
      ]
    },
    "document_processing_record": {
      "owner": "agent",
      "pre": {
        "and": [
          "scan_report",
          "dpia_decided"
        ]
      },
      "add": [
        "processing_record_documented"
      ]
    },
    "decide_dpia_not_required": {
      "owner": "agent",
      "pre": "processing_details_known",
      "add": [
        "dpia_decided"
      ]
    },
    "mark_dpia_done": {
      "owner": "agent",
      "pre": "dpia_report",
      "add": [
        "dpia_decided"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "run_compliance_checker",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "ask_processing_details",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "dpia_required": [
            {
              "act": {
                "cap": "write_dpia_input",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "generate_dpia_report",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "mark_dpia_done",
                "by": "agent"
              }
            }
          ],
          "dpia_not_required": [
            {
              "act": {
                "cap": "decide_dpia_not_required",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "document_processing_record",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "scan_report",
      "compliance_score_known",
      "dpia_decided",
      "processing_record_documented"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
