{
  "name": "azure-ai-translation-document-py",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "install_sdk": {
      "owner": "agent",
      "add": [
        "sdk_installed"
      ],
      "pre": {
        "and": [
          "needs:package_registries"
        ]
      }
    },
    "write_translation_script": {
      "owner": "agent",
      "add": [
        "script_written"
      ]
    },
    "run_batch_translation": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "needs:azure_translator_resource",
          "needs:azure_blob_storage",
          {
            "and": [
              "sdk_installed",
              "script_written"
            ]
          }
        ]
      },
      "add": [
        "translation_started"
      ]
    },
    "poll_translation_status": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "needs:azure_translator_resource",
          "translation_started"
        ]
      },
      "nondet": {
        "documents_translated": true
      }
    },
    "check_document_statuses": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "needs:azure_translator_resource",
          "translation_started"
        ]
      },
      "add": [
        "doc_errors_reviewed"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_sdk",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_translation_script",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_batch_translation",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "poll_translation_status",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "inspect_documents": [
            {
              "act": {
                "cap": "check_document_statuses",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "script_written",
      "translation_started",
      "documents_translated"
    ]
  },
  "init_true": [
    "needs:package_registries"
  ],
  "init_constraints": []
}
