{
  "name": "writing-plans",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_spec_and_codebase": {
      "owner": "agent",
      "add": [
        "spec_read"
      ]
    },
    "save_plan": {
      "owner": "agent",
      "pre": "spec_read",
      "add": [
        "plan_saved"
      ]
    },
    "fix_plan_issues": {
      "owner": "agent",
      "pre": "plan_saved",
      "add": [
        "plan_revised"
      ]
    },
    "request_review_and_method": {
      "owner": "agent",
      "pre": "plan_saved",
      "add": [
        "plan_reviewed",
        "execution_method_chosen"
      ]
    },
    "request_review": {
      "owner": "agent",
      "pre": "plan_saved",
      "add": [
        "plan_reviewed"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_spec_and_codebase",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "save_plan",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "issues_found": [
            {
              "act": {
                "cap": "fix_plan_issues",
                "by": "agent"
              }
            }
          ],
          "no_issues": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "method_not_supplied": [
            {
              "act": {
                "cap": "request_review_and_method",
                "by": "agent"
              }
            }
          ],
          "method_already_supplied": [
            {
              "act": {
                "cap": "request_review",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "plan_saved",
      "plan_reviewed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
