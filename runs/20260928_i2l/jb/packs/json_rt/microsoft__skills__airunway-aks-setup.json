{
  "name": "airunway-aks-setup",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "verify_cluster": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:aks_cluster",
          "needs:azure_account"
        ]
      },
      "add": [
        "cluster_verified"
      ]
    },
    "confirm_install": {
      "owner": "agent",
      "pre": "cluster_verified",
      "add": [
        "install_confirmed"
      ]
    },
    "install_controller": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:aks_cluster",
          "needs:azure_account",
          {
            "and": [
              "cluster_verified",
              "install_confirmed"
            ]
          }
        ]
      },
      "add": [
        "controller_installed"
      ]
    },
    "assess_gpu": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:aks_cluster",
          "needs:azure_account",
          "controller_installed"
        ]
      },
      "add": [
        "gpu_assessed"
      ]
    },
    "install_provider": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:aks_cluster",
          "needs:azure_account",
          {
            "and": [
              "gpu_assessed",
              "install_confirmed"
            ]
          }
        ]
      },
      "add": [
        "provider_installed"
      ]
    },
    "confirm_deploy": {
      "owner": "agent",
      "pre": "provider_installed",
      "add": [
        "deploy_confirmed"
      ]
    },
    "deploy_model": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:aks_cluster",
          "needs:azure_account",
          {
            "and": [
              "provider_installed",
              "deploy_confirmed"
            ]
          }
        ]
      },
      "add": [
        "model_deployed"
      ]
    },
    "verify_ready": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:aks_cluster",
          "needs:azure_account",
          "model_deployed"
        ]
      },
      "add": [
        "model_ready"
      ]
    },
    "smoke_test": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:aks_cluster",
          "needs:azure_account",
          "model_ready"
        ]
      },
      "add": [
        "smoke_tested"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "verify_cluster",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "confirm_install",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_controller",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "assess_gpu",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_provider",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "confirm_deploy",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "deploy_model",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_ready",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "smoke": [
            {
              "act": {
                "cap": "smoke_test",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "controller_installed",
      "provider_installed",
      "model_deployed",
      "model_ready"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
