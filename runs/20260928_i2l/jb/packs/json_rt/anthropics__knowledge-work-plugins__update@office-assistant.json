{
  "name": "productivity-update",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "load_state": {
      "owner": "agent",
      "pre": "tasks_file_exists",
      "add": [
        "state_loaded"
      ]
    },
    "ask_triage_decisions": {
      "owner": "agent",
      "pre": "state_loaded",
      "add": [
        "triage_decided"
      ]
    },
    "apply_triage_to_tasks": {
      "owner": "agent",
      "pre": "triage_decided",
      "add": [
        "tasks_triaged"
      ]
    },
    "ask_about_gaps": {
      "owner": "agent",
      "pre": "state_loaded",
      "add": [
        "gap_answers_received"
      ]
    },
    "write_memory_files": {
      "owner": "agent",
      "pre": "gap_answers_received",
      "add": [
        "memory_updated"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "load_state",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "ask_triage_decisions",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "apply_triage_to_tasks",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "gaps_found": [
            {
              "act": {
                "cap": "ask_about_gaps",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "write_memory_files",
                "by": "agent"
              }
            }
          ],
          "all_decoded": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "state_loaded",
      "tasks_triaged"
    ]
  },
  "init_true": [
    "tasks_file_exists"
  ],
  "init_constraints": []
}
