{
  "name": "crm-hygiene-check",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_pipeline_export": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "export_uploaded"
        ]
      },
      "add": [
        "opps_loaded"
      ]
    },
    "request_export_upload": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      },
      "add": [
        "export_uploaded"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "request_export_upload",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_pipeline_export",
        "by": "agent"
      }
    }
  ],
  "goal": "opps_loaded",
  "init_true": [
    "needs:local_filesystem",
    "needs:user_conversation"
  ],
  "init_constraints": []
}
