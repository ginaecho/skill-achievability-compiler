{
  "name": "i4h-workflow",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "locate_local_checkout": {
      "owner": "agent",
      "pre": "local_checkout_present",
      "add": [
        "checkout_resolved"
      ]
    },
    "read_design_docs": {
      "owner": "agent",
      "pre": "checkout_resolved",
      "add": [
        "architecture_known"
      ]
    },
    "list_supported_workflows": {
      "owner": "agent",
      "pre": "checkout_resolved",
      "add": [
        "live_support_listed"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "external": true,
        "observed": true,
        "branches": {
          "checkout_exists": [
            {
              "act": {
                "cap": "locate_local_checkout",
                "by": "agent"
              }
            }
          ],
          "no_checkout": [
            {
              "act": {
                "cap": "clone_repository",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "read_design_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "list_supported_workflows",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "checkout_resolved",
      "architecture_known",
      "live_support_listed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
