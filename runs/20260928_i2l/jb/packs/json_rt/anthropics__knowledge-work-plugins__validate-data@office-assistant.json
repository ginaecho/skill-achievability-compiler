{
  "name": "validate-data",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_analysis_file": {
      "owner": "agent",
      "pre": "analysis_file_exists",
      "add": [
        "analysis_available"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "analysis_as_file": [
            {
              "act": {
                "cap": "read_analysis_file",
                "by": "agent"
              }
            }
          ],
          "analysis_in_conversation": []
        }
      }
    }
  ],
  "goal": {
    "or": [
      "analysis_available",
      "analysis_in_conversation"
    ]
  },
  "init_true": [
    "analysis_file_exists",
    "analysis_in_conversation"
  ],
  "init_constraints": []
}
