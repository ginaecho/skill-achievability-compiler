{
  "name": "matchms-library-search",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "install_matchms": {
      "owner": "agent",
      "add": [
        "matchms_installed"
      ],
      "pre": {
        "and": [
          "needs:package_registries"
        ]
      }
    },
    "verify_runtime": {
      "owner": "agent",
      "pre": "matchms_installed",
      "add": [
        "runtime_verified"
      ]
    },
    "inspect_inputs": {
      "owner": "agent",
      "pre": {
        "and": [
          "runtime_verified",
          "spectra_files_exist"
        ]
      },
      "add": [
        "inputs_inspected"
      ]
    },
    "load_and_process_spectra": {
      "owner": "agent",
      "pre": "inputs_inspected",
      "add": [
        "spectra_processed"
      ]
    },
    "score_and_write_hits": {
      "owner": "agent",
      "pre": "spectra_processed",
      "add": [
        "hits_written"
      ]
    },
    "plot_mirror_validation": {
      "owner": "agent",
      "pre": "hits_written",
      "add": [
        "top_hits_plotted"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_matchms",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_runtime",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "inspect_inputs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "load_and_process_spectra",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "score_and_write_hits",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "validate_visually": [
            {
              "act": {
                "cap": "plot_mirror_validation",
                "by": "agent"
              }
            }
          ],
          "skip_plots": []
        }
      }
    }
  ],
  "goal": "hits_written",
  "init_true": [
    "spectra_files_exist"
  ],
  "init_constraints": []
}
