{
  "name": "quasi-coder",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_shorthand_and_context": {
      "owner": "agent",
      "pre": "shorthand_file_exists",
      "add": [
        "shorthand_read"
      ]
    },
    "ask_clarification": {
      "owner": "agent",
      "pre": "shorthand_read",
      "add": [
        "intent_clarified"
      ]
    },
    "replace_shorthand_with_code": {
      "owner": "agent",
      "pre": "shorthand_read",
      "add": [
        "code_implemented",
        "shorthand_lines_removed"
      ]
    },
    "run_requested_non_code_action": {
      "owner": "agent",
      "pre": "shorthand_read",
      "add": [
        "non_code_action_done"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_shorthand_and_context",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "intent_unclear": [
            {
              "act": {
                "cap": "ask_clarification",
                "by": "agent"
              }
            }
          ],
          "intent_clear": []
        }
      }
    },
    {
      "act": {
        "cap": "replace_shorthand_with_code",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "shorthand_requests_non_code_action": [
            {
              "act": {
                "cap": "run_requested_non_code_action",
                "by": "agent"
              }
            }
          ],
          "code_only": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "code_implemented",
      "shorthand_lines_removed"
    ]
  },
  "init_true": [
    "shorthand_file_exists"
  ],
  "init_constraints": []
}
