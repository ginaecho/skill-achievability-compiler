{
  "name": "crypto_protocol_diagram",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "clarify_input_type": {
      "owner": "agent",
      "pre": true,
      "add": [
        "input_type_known"
      ]
    },
    "search_code_entry_points": {
      "owner": "agent",
      "pre": "input_type_known",
      "add": [
        "entry_points_found"
      ]
    },
    "read_source_code": {
      "owner": "agent",
      "pre": "entry_points_found",
      "add": [
        "protocol_extracted"
      ]
    },
    "read_spec_file": {
      "owner": "agent",
      "pre": "input_type_known",
      "add": [
        "spec_ingested"
      ]
    },
    "fetch_spec_url": {
      "owner": "agent",
      "pre": "input_type_known",
      "add": [
        "spec_ingested"
      ]
    },
    "extract_from_spec": {
      "owner": "agent",
      "pre": "spec_ingested",
      "add": [
        "protocol_extracted"
      ]
    },
    "write_mermaid_file": {
      "owner": "agent",
      "pre": "protocol_extracted",
      "add": [
        "diagram_file_written"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "ambiguous": [
            {
              "act": {
                "cap": "clarify_input_type",
                "by": "agent"
              }
            }
          ],
          "clear": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "code": [
            {
              "act": {
                "cap": "search_code_entry_points",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "read_source_code",
                "by": "agent"
              }
            }
          ],
          "spec_file": [
            {
              "act": {
                "cap": "read_spec_file",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "extract_from_spec",
                "by": "agent"
              }
            }
          ],
          "spec_url": [
            {
              "act": {
                "cap": "fetch_spec_url",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "extract_from_spec",
                "by": "agent"
              }
            }
          ],
          "both": [
            {
              "act": {
                "cap": "read_spec_file",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "extract_from_spec",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "search_code_entry_points",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "read_source_code",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "write_mermaid_file",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "protocol_extracted",
      "diagram_file_written"
    ]
  },
  "init_true": [
    "input_type_known"
  ],
  "init_constraints": []
}
