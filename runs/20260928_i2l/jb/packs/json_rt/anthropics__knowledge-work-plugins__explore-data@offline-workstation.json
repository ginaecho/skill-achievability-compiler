{
  "name": "explore-data",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_for_data_source": {
      "owner": "agent",
      "pre": true,
      "add": [
        "source_is_file"
      ]
    },
    "read_file_dataset": {
      "owner": "agent",
      "pre": "source_is_file",
      "add": [
        "data_loaded"
      ]
    },
    "profile_file_dataset": {
      "owner": "agent",
      "pre": {
        "and": [
          "source_is_file",
          "data_loaded"
        ]
      },
      "add": [
        "profile_computed",
        "quality_checked"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "file": [
            {
              "act": {
                "cap": "read_file_dataset",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "profile_file_dataset",
                "by": "agent"
              }
            }
          ],
          "neither": [
            {
              "act": {
                "cap": "ask_for_data_source",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "read_file_dataset",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "profile_file_dataset",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "data_loaded",
      "profile_computed",
      "quality_checked"
    ]
  },
  "init_true": [
    "source_is_file"
  ],
  "init_constraints": []
}
