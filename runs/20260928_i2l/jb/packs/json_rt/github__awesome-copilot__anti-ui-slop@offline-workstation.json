{
  "name": "anti-ui-slop",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_product_context": {
      "owner": "agent",
      "add": [
        "product_context_known"
      ]
    },
    "load_playbook": {
      "owner": "agent",
      "add": [
        "playbook_loaded"
      ]
    },
    "implement_ui": {
      "owner": "agent",
      "pre": {
        "and": [
          "product_context_known",
          "playbook_loaded"
        ]
      },
      "add": [
        "ui_implemented"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_product_context",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "load_playbook",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "implement_ui",
        "by": "agent"
      }
    }
  ],
  "goal": "ui_implemented",
  "init_true": [],
  "init_constraints": []
}
