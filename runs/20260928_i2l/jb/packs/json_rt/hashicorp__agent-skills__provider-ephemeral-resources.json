{
  "name": "provider-ephemeral-resources",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_provider_code": {
      "owner": "agent",
      "pre": "provider_repo_available",
      "add": [
        "provider_code_read"
      ]
    },
    "implement_ephemeral_resource": {
      "owner": "agent",
      "pre": "provider_code_read",
      "add": [
        "ephemeral_resource_implemented"
      ]
    },
    "register_ephemeral_resource": {
      "owner": "agent",
      "pre": "ephemeral_resource_implemented",
      "add": [
        "ephemeral_resource_registered"
      ]
    },
    "write_acceptance_tests": {
      "owner": "agent",
      "pre": "ephemeral_resource_implemented",
      "add": [
        "tests_written"
      ]
    },
    "build_provider": {
      "owner": "agent",
      "pre": {
        "and": [
          "ephemeral_resource_implemented",
          "ephemeral_resource_registered",
          "tests_written"
        ]
      },
      "add": [
        "provider_builds"
      ]
    },
    "generate_docs": {
      "owner": "agent",
      "pre": "ephemeral_resource_registered",
      "add": [
        "docs_generated"
      ]
    },
    "edit_docs_lifetime_notes": {
      "owner": "agent",
      "pre": "docs_generated",
      "add": [
        "docs_explain_lifetime"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_provider_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "implement_ephemeral_resource",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "register_ephemeral_resource",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_acceptance_tests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_provider",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "edit_docs_lifetime_notes",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "ephemeral_resource_implemented",
      "ephemeral_resource_registered",
      "tests_written",
      "provider_builds",
      "docs_explain_lifetime"
    ]
  },
  "init_true": [
    "provider_repo_available"
  ],
  "init_constraints": []
}
