{
  "name": "aspnet-core",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_project": {
      "owner": "agent",
      "add": [
        "target_confirmed"
      ]
    },
    "read_references": {
      "owner": "agent",
      "pre": "target_confirmed",
      "add": [
        "references_loaded"
      ]
    },
    "scaffold_from_template": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:dotnet_sdk",
          "references_loaded"
        ]
      },
      "add": [
        "project_exists"
      ]
    },
    "implement_feature": {
      "owner": "agent",
      "pre": {
        "and": [
          "references_loaded",
          "project_exists"
        ]
      },
      "add": [
        "feature_implemented"
      ]
    },
    "build_and_test": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:dotnet_sdk",
          "needs:package_registries",
          "feature_implemented"
        ]
      },
      "add": [
        "build_passes"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_project",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_references",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "new_app": [
            {
              "act": {
                "cap": "scaffold_from_template",
                "by": "agent"
              }
            }
          ],
          "existing_app": []
        }
      }
    },
    {
      "act": {
        "cap": "implement_feature",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_and_test",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "feature_implemented",
      "build_passes"
    ]
  },
  "init_true": [
    "project_exists"
  ],
  "init_constraints": []
}
