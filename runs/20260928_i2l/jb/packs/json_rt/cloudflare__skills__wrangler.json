{
  "name": "wrangler",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_project": {
      "owner": "agent",
      "add": [
        "project_inspected"
      ]
    },
    "install_deps": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:package_registries",
          "project_inspected"
        ]
      },
      "add": [
        "wrangler_installed"
      ]
    },
    "fetch_docs": {
      "owner": "agent",
      "add": [
        "docs_retrieved"
      ],
      "pre": {
        "and": [
          "needs:public_internet"
        ]
      }
    },
    "confirm_target": {
      "owner": "agent",
      "pre": "project_inspected",
      "add": [
        "target_confirmed"
      ]
    },
    "edit_config": {
      "owner": "agent",
      "pre": {
        "and": [
          "project_inspected",
          "docs_retrieved",
          "target_confirmed"
        ]
      },
      "add": [
        "config_updated"
      ]
    },
    "generate_types": {
      "owner": "agent",
      "pre": {
        "and": [
          "config_updated",
          "wrangler_installed"
        ]
      },
      "add": [
        "types_generated"
      ]
    },
    "run_checks": {
      "owner": "agent",
      "pre": "types_generated",
      "add": [
        "checks_passed"
      ]
    },
    "dry_run_deploy": {
      "owner": "agent",
      "pre": {
        "and": [
          "config_updated",
          "wrangler_installed"
        ]
      },
      "add": [
        "dry_run_ok"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_project",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_deps",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "confirm_target",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "edit_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_types",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_checks",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "dry_run_deploy",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "config_updated",
      "types_generated",
      "checks_passed",
      "dry_run_ok"
    ]
  },
  "init_true": [
    "needs:package_registries",
    "needs:public_internet"
  ],
  "init_constraints": []
}
