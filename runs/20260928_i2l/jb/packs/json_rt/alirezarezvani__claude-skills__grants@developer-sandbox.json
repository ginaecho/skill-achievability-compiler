{
  "name": "grants-nih-funding-intelligence",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "grill_me_intake": {
      "owner": "agent",
      "add": [
        "intake_complete"
      ]
    },
    "compute_fiscal_window": {
      "owner": "agent",
      "pre": "intake_complete",
      "add": [
        "fy_window_known"
      ]
    },
    "reporter_post_searches": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet",
          "fy_window_known"
        ]
      },
      "add": [
        "reporter_results",
        "institutes_ranked",
        "study_sections_ranked"
      ]
    },
    "fetch_nosis": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet",
          "reporter_results"
        ]
      },
      "add": [
        "nosis_checked"
      ]
    },
    "match_mechanisms": {
      "owner": "agent",
      "pre": "intake_complete",
      "add": [
        "mechanisms_matched"
      ]
    },
    "install_docx_library": {
      "owner": "agent",
      "add": [
        "docx_lib_available"
      ],
      "pre": {
        "and": [
          "needs:package_registries"
        ]
      }
    },
    "generate_docx": {
      "owner": "agent",
      "pre": {
        "and": [
          "docx_lib_available",
          "positioning_done",
          "institutes_ranked",
          "study_sections_ranked",
          "nosis_checked",
          "mechanisms_matched"
        ]
      },
      "add": [
        "docx_saved",
        "po_recommendation_included",
        "audit_log_included"
      ]
    },
    "validate_docx": {
      "owner": "agent",
      "pre": "docx_saved",
      "add": [
        "docx_validated"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "grill_me_intake",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "consensus_positioning_searches",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "compute_fiscal_window",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "reporter_post_searches",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_nosis",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "match_mechanisms",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_docx_library",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_docx",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_docx",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "positioning_done",
      "institutes_ranked",
      "mechanisms_matched",
      "docx_saved",
      "po_recommendation_included",
      "audit_log_included",
      "docx_validated"
    ]
  },
  "init_true": [
    "needs:public_internet",
    "needs:package_registries"
  ],
  "init_constraints": []
}
