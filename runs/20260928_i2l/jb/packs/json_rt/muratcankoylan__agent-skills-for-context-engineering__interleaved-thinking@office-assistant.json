{
  "name": "reasoning-trace-optimizer",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "write_analysis_report": {
      "owner": "agent",
      "pre": "analysis_done",
      "add": [
        "report_written"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "capture_trace",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "analyze_trace",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_analysis_report",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "analysis_done",
      "report_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
