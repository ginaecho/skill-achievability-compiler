        {
          "and": [
            "story_written",
            "acceptance_criteria_written",
            "story_estimated",
            "invest_validated",
            "priority_assigned"
          ]
        },
        {
          "and": [
            "capacity_calculated",
            "sprint_goal_reviewed",
            "stories_selected",
            "dependencies_identified",
            "tasks_broken_down",
            {
              "cmp": [
                "committed_points",
                "<=",
                {
                  "*": [
                    "capacity_points",
                    85
                  ]
                }
              ]
            },
            {
              "cmp": [
                {
                  "+": [
                    "stretch_points",
                    "committed_points"
                  ]
                },
                "<=",
                "capacity_points"
              ]
            }
          ]
        }
      ]
    },
    "init_true": [
