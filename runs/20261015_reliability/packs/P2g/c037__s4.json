          "and": [
            "needs:shell"
          ]
        },
        "add": [
          "capacity_calculated",
          "sprint_goal_reviewed",
          "stories_selected",
          "dependencies_identified",
          "tasks_broken_down"
        ],
        "del": [],
        "assigns": {},
        "nondet": {
          "capacity_points": {
            "cmp": [
              "capacity_points",
              ">=",
              0
            ]
          },
          "committed_points": {
            "and": [
              {
                "cmp": [
                  "committed_points",
                  ">=",
                  0
                ]
              },
              {
                "cmp": [
                  "committed_points",
                  "<=",
                  "capacity_points"
                ]
              }
            ]
          },
          "stretch_points": {
            "cmp": [
              "stretch_points",
              ">=",
              0
            ]
          }
        }
      }
    },
    "protocol": [
      {
