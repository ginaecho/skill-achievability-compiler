          "not": "url_known"
        },
        "add": [
          "url_known"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "inspect_workspace": {
        "owner": "agent",
        "pre": true,
        "add": [
          "project_structure_known",
          "framework_known",
          "styling_known",
          "review_checklist_known"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "capture_review_evidence": {
        "owner": "agent",
        "pre": {
          "and": [
            "needs:shell",
            "needs:linux",
            "needs:local_filesystem",
            "url_known"
          ]
        },
        "add": [
          "visual_issues_identified",
          "screenshots_captured",
          "responsive_tested",
          "dom_reviewed"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "locate_source_files": {
        "owner": "agent",
        "pre": "visual_issues_identified",
        "add": [
          "source_files_identified"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "apply_design_fixes": {
        "owner": "agent",
        "pre": "source_files_identified",
        "add": [
          "fixes_applied"
        ],
        "del": [
          "visual_issues_identified"
        ],
        "assigns": {},
        "nondet": {}
      },
      "reverify_design": {
        "owner": "agent",
        "pre": {
          "and": [
            "needs:shell",
            "needs:linux",
            "needs:local_filesystem",
            {
              "or": [
                "fixes_applied",
                "screenshots_captured"
              ]
            }
          ]
        },
        "add": [
          "verification_done"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "request_user_consultation": {
        "owner": "agent",
        "pre": "three_fix_attempts_reached",
        "add": [
          "user_consulted"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "prepare_report": {
        "owner": "agent",
        "pre": true,
        "add": [
          "report_prepared"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      }
    },
    "protocol": [
      {
        "choice": {
          "by": "agent",
          "observed": true,
          "branches": {
            "url_already_provided": [],
            "need_url": [
              {
                "act": {
                  "cap": "ask_url",
                  "by": "agent"
                }
              }
            ]
          }
        }
      },
      {
        "act": {
          "cap": "inspect_workspace",
          "by": "agent"
        }
      },
      {
        "rec": {
          "name": "review_cycle",
          "body": [
            {
              "act": {
                "cap": "capture_review_evidence",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "agent",
                "observed": true,
                "branches": {
                  "issues_found_and_fixable": [
                    {
                      "act": {
                        "cap": "locate_source_files",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "apply_design_fixes",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "reverify_design",
                        "by": "agent"
                      }
                    },
                    {
                      "choice": {
                        "by": "agent",
                        "observed": true,
                        "branches": {
                          "more_attempts_allowed": [
                            {
                              "continue": "review_cycle"
                            }
                          ],
                          "three_attempts_reached": [
                            {
                              "act": {
                                "cap": "request_user_consultation",
                                "by": "agent"
                              }
                            }
                          ]
                        }
                      }
                    }
                  ],
                  "no_fixes_needed_or_read_only_review": [
                    {
                      "act": {
                        "cap": "reverify_design",
                        "by": "agent"
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      {
        "act": {
          "cap": "prepare_report",
          "by": "agent"
        }
      }
    ],
    "goal": {
      "and": [
        "report_prepared",
        "screenshots_captured",
        "responsive_tested",
        "verification_done",
        "url_known"
      ]
    },
    "init_true": [
      "needs:shell",
      "needs:linux",
      "needs:local_filesystem"
    ],
    "init_constraints": [
      {
        "cmp": [
          "fix_attempts",
          "==",
          0
        ]
      }
    ]
  },
