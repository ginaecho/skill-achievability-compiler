      "agent",
      "user"
    ],
    "capabilities": {
      "ensure_isolated_workspace": {
        "owner": "agent",
        "pre": "plan_available",
        "add": [
          "isolated_workspace_ready"
        ],
        "del": [
          "on_main_branch"
        ],
        "assigns": {},
        "nondet": {}
      },
      "create_or_resume_ledger": {
        "owner": "agent",
        "pre": "isolated_workspace_ready",
        "add": [
          "workspace_resolved",
          "ledger_ready"
        ],
