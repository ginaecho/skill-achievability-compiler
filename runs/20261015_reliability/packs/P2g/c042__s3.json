          "and": [
            "task_steps_executed",
            "expected_outputs_checked",
            "tests_seen_pass"
          ]
        },
        "add": [
          "task_complete",
          "ledger_updated",
          "all_tasks_complete"
        ],
        "del": [
          "task_in_progress",
          "task_brief_read",
          "task_steps_executed",
          "expected_outputs_checked",
          "tests_seen_fail",
          "tests_seen_pass",
          "base_known"
        ],
        "assigns": {},
        "nondet": {}
      },
      "final_self_review": {
        "owner": "agent",
        "pre": "all_tasks_complete",
