        "owner": "agent",
        "pre": {
          "and": [
            "plan_read",
            "workspace_resolved"
          ]
        },
        "add": [
          "task_brief_read",
          "task_in_progress",
          "base_known"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "execute_task_with_tdd": {
        "owner": "agent",
        "pre": {
          "and": [
            "task_brief_read",
            "tdd_loaded"
          ]
        },
        "add": [
          "task_steps_executed",
          "expected_outputs_checked",
          "tests_seen_fail",
          "tests_seen_pass"
        ],
        "del": [],
        "assigns": {},
        "nondet": {
          "stop_needed": {
            "or": [
              "stop_needed",
              {
                "not": "stop_needed"
              }
            ]
          }
        }
      },
