                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "execute_task_with_tdd",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "agent",
                "observed": true,
                "branches": {
                  "stop_and_ask_user": [
                    {
                      "choice": {
                        "by": "user",
                        "observed": true,
                        "branches": {
                          "answer_and_continue": [],
                          "decline_or_block": []
                        }
                      }
                    }
                  ],
                  "continue_without_stop": []
                }
              }
            },
            {
              "choice": {
                "by": "agent",
                "observed": true,
                "branches": {
                  "ruling_needed": [
                    {
                      "act": {
                        "cap": "record_ruling",
                        "by": "agent"
                      }
                    }
                  ],
                  "no_ruling_needed": []
                }
              }
            },
            {
              "act": {
                "cap": "task_done",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "agent",
                "observed": true,
                "branches": {
                  "more_tasks": [
                    {
                      "continue": "per_task"
                    }
                  ],
                  "last_task": []
                }
              }
            }
          ]
        }
      },
      {
        "act": {
          "cap": "final_self_review",
          "by": "agent"
        }
      },
      {
        "act": {
          "cap": "fix_final_findings",
          "by": "agent"
        }
      },
      {
        "act": {
          "cap": "delete_plan_workspace",
          "by": "agent"
        }
      }
    ],
    "goal": {
      "and": [
        "isolated_workspace_ready",
        "ledger_ready",
        "plan_read",
        "preflight_done",
        "all_tasks_complete",
        "final_review_done",
