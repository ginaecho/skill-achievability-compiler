        "assigns": {},
        "nondet": {}
      },
      "read_plan_and_spec": {
        "owner": "agent",
        "pre": "plan_available",
        "add": [
          "plan_read",
          "spec_checked"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "load_tdd_skill": {
        "owner": "agent",
        "pre": true,
        "add": [
          "tdd_loaded"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "preflight_scan": {
