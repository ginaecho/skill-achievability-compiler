          "and": [
            "needs:shell",
            "needs:linux",
            "target_url_known"
          ]
        },
        "add": [
          "baseline_captured",
          "dom_observed",
          "issues_detected"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
