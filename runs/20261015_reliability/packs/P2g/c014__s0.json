          ]
        },
        "add": [
          "reverified"
        ],
        "del": [],
        "assigns": {},
        "nondet": {
          "issues_remaining": {
            "or": [
              {
                "cmp": [
                  "issues_remaining",
                  "==",
                  0
                ]
              },
              {
                "cmp": [
                  "issues_remaining",
                  ">",
                  0
                ]
              }
            ]
          }
        }
      }
    },
    "protocol": [
      {
        "choice": {
          "by": "agent",
