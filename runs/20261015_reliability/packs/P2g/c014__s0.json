          "review_scope_known"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "inspect_workspace": {
        "owner": "agent",
        "pre": true,
        "add": [
          "project_detected",
          "framework_detected",
          "styling_detected",
          "source_locations_known"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "review_checklist": {
        "owner": "agent",
        "pre": true,
