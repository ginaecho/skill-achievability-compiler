        "owner": "agent",
        "pre": {
          "cmp": [
            "failure_class",
            "==",
            1
          ]
        },
        "add": [
          "preflight_rerun",
          "failure_excerpt_reported"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "apply_divergence_checks": {
        "owner": "agent",
        "pre": {
          "cmp": [
            "failure_class",
            "==",
            2
          ]
        },
        "add": [
          "divergence_checked_in_order",
          "failure_excerpt_reported"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "apply_oom_ladder": {
        "owner": "agent",
        "pre": {
          "cmp": [
            "failure_class",
            "==",
            3
          ]
        },
        "add": [
          "oom_ladder_applied_in_order",
          "failure_excerpt_reported"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "export_artifact_and_smoke_test": {
        "owner": "agent",
        "pre": {
          "and": [
            "promotion_verdict_promote",
            {
              "cmp": [
                "run_outcome",
                "==",
                1
              ]
            }
          ]
        },
        "add": [
          "artifact_exported",
          "smoke_test_passed",
          "export_done"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      }
    },
    "protocol": [
      {
        "act": {
          "cap": "read_brief_and_reports",
          "by": "agent"
        }
      },
