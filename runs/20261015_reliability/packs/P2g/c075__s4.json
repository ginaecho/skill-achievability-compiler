          "method_known",
          "dataset_expectation_known"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "build_dataset_and_reports": {
        "owner": "agent",
        "pre": "brief_read",
        "add": [
          "dataset_built",
          "dataset_card_committed",
          "validation_report_written",
          "packed_samples_attached",
          "phase2_complete"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "confirm_environment": {
        "owner": "agent",
        "pre": "phase2_complete",
        "add": [
          "env_report_present"
        ],
        "del": [],
        "assigns": {},
        "nondet": {
          "env_status": {
            "or": [
              {
                "cmp": [
                  "env_status",
                  "==",
                  1
                ]
              },
              {
                "cmp": [
                  "env_status",
                  "==",
                  2
                ]
              },
              {
                "cmp": [
                  "env_status",
                  "==",
                  3
                ]
              }
            ]
          }
        }
      },
      "generate_training_files": {
        "owner": "agent",
        "pre": {
          "and": [
            "env_report_present",
            {
              "cmp": [
                "env_status",
                "==",
                1
              ]
            },
            "method_known"
          ]
        },
        "add": [
          "train_config_written",
          "train_script_written"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "commit_training_files": {
        "owner": "agent",
        "pre": {
          "and": [
            "train_config_written",
            "train_script_written"
          ]
        },
        "add": [
          "train_files_committed"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "launch_training": {
        "owner": "agent",
        "pre": {
          "and": [
            "train_files_committed",
            {
              "cmp": [
                "env_status",
                "==",
                1
              ]
            }
          ]
        },
        "add": [
          "training_running"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "poll_training_logs": {
        "owner": "agent",
        "pre": "training_running",
        "add": [
          "structured_progress_emitted"
        ],
        "del": [],
        "assigns": {},
        "nondet": {
          "run_outcome": {
            "or": [
              {
                "cmp": [
                  "run_outcome",
                  "==",
                  1
                ]
              },
              {
                "cmp": [
                  "run_outcome",
                  "==",
                  2
                ]
              },
              {
                "cmp": [
                  "run_outcome",
                  "==",
                  3
                ]
              },
              {
                "cmp": [
                  "run_outcome",
                  "==",
                  4
                ]
              }
            ]
          }
        }
      },
      "halt_run_and_triage": {
        "owner": "agent",
        "pre": {
          "cmp": [
            "run_outcome",
            "==",
            3
          ]
        },
        "add": [
          "failure_excerpt_reported"
        ],
        "del": [],
        "assigns": {},
        "nondet": {
          "failure_class": {
            "or": [
              {
                "cmp": [
                  "failure_class",
                  "==",
                  1
                ]
              },
              {
                "cmp": [
                  "failure_class",
                  "==",
                  2
                ]
              },
              {
                "cmp": [
                  "failure_class",
                  "==",
                  3
                ]
              }
            ]
          }
        }
      },
