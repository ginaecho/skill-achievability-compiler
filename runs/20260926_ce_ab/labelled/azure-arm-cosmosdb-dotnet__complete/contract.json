{
  "roles": [
    "agent"
  ],
  "goal": {
    "and": [
      "account_exists",
      "database_exists",
      "container_exists"
    ]
  },
  "capabilities": {
    "create_account": {
      "pre": "arm_write",
      "add": [
        "account_exists"
      ],
      "owner": "agent"
    },
    "create_database": {
      "pre": {
        "and": [
          "account_exists",
          "arm_write"
        ]
      },
      "add": [
        "database_exists"
      ],
      "owner": "agent"
    },
    "create_container": {
      "pre": {
        "and": [
          "database_exists",
          "arm_write"
        ]
      },
      "add": [
        "container_exists"
      ],
      "owner": "agent"
    },
    "get_connection_strings": {
      "pre": "account_exists",
      "add": [
        "connection_strings_read"
      ],
      "owner": "agent"
    }
  },
  "init_true": [
    "arm_write"
  ],
  "init_constraints": []
}
