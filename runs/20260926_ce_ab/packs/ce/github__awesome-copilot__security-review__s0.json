{
  "name": "security-review",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "resolve_scope": {
      "owner": "agent",
      "pre": true,
      "add": [
        "scope_resolved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "audit_dependencies": {
      "owner": "agent",
      "pre": "scope_resolved",
      "add": [
        "dependencies_audited"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scan_secrets": {
      "owner": "agent",
      "pre": "scope_resolved",
      "add": [
        "secrets_scanned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scan_vulnerabilities": {
      "owner": "agent",
      "pre": "scope_resolved",
      "add": [
        "vulnerabilities_scanned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "analyze_data_flow": {
      "owner": "agent",
      "pre": "vulnerabilities_scanned",
      "add": [
        "data_flow_analyzed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_findings": {
      "owner": "agent",
      "pre": "data_flow_analyzed",
      "add": [
        "findings_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_report": {
      "owner": "agent",
      "pre": {
        "and": [
          "findings_verified",
          "dependencies_audited",
          "secrets_scanned"
        ]
      },
      "add": [
        "report_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "propose_patches": {
      "owner": "agent",
      "pre": "report_generated",
      "add": [
        "patches_proposed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "resolve_scope",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "audit_dependencies",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scan_secrets",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scan_vulnerabilities",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "analyze_data_flow",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_findings",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_report",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "propose_patches",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "report_generated",
      "patches_proposed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
