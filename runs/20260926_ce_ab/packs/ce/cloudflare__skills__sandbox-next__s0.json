{
  "name": "sandbox-next",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "inspect_dependencies": {
      "owner": "agent",
      "pre": true,
      "add": [
        "dependencies_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_sandbox_code": {
      "owner": "agent",
      "pre": "dependencies_inspected",
      "add": [
        "code_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "typecheck_code": {
      "owner": "agent",
      "pre": "code_written",
      "add": [
        "typechecked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_dependencies",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "next_line_confirmed": [
            {
              "act": {
                "cap": "write_sandbox_code",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "typecheck_code",
                "by": "agent"
              }
            }
          ],
          "default_package": [],
          "porting_requested": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "dependencies_inspected",
      "code_written",
      "typechecked"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
