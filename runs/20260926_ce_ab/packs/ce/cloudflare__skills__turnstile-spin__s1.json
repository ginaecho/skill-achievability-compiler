{
  "name": "turnstile-spin",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "probe_auth": {
      "owner": "agent",
      "pre": true,
      "add": [
        "auth_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "confirm_domains": {
      "owner": "agent",
      "pre": "auth_verified",
      "add": [
        "domains_confirmed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scan_codebase": {
      "owner": "agent",
      "pre": "domains_confirmed",
      "add": [
        "codebase_scanned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "confirm_insertion_plan": {
      "owner": "agent",
      "pre": "codebase_scanned",
      "add": [
        "plan_confirmed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_widget": {
      "owner": "agent",
      "pre": "plan_confirmed",
      "add": [
        "widget_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "retrieve_existing_secret": {
      "owner": "agent",
      "pre": "plan_confirmed",
      "add": [
        "widget_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "wire_integration": {
      "owner": "agent",
      "pre": "widget_created",
      "add": [
        "integration_wired"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_integration": {
      "owner": "agent",
      "pre": "integration_wired",
      "add": [
        "validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "persist_skill": {
      "owner": "agent",
      "pre": "validated",
      "add": [
        "skill_persisted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "final_report": {
      "owner": "agent",
      "pre": "validated",
      "add": [
        "reported"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "probe_auth",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "confirm_domains",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scan_codebase",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "confirm_insertion_plan",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "new_widget": [
            {
              "act": {
                "cap": "create_widget",
                "by": "agent"
              }
            }
          ],
          "existing_widget": [
            {
              "act": {
                "cap": "retrieve_existing_secret",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "wire_integration",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_integration",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "persist": [
            {
              "act": {
                "cap": "persist_skill",
                "by": "agent"
              }
            }
          ],
          "skip_persist": []
        }
      }
    },
    {
      "act": {
        "cap": "final_report",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "integration_wired",
      "validated",
      "reported"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
