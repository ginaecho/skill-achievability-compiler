{
  "name": "receiving-code-review",
  "roles": [
    "agent",
    "reviewer"
  ],
  "capabilities": {
    "read_feedback": {
      "owner": "agent",
      "pre": true,
      "add": [
        "feedback_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_clarification": {
      "owner": "agent",
      "pre": "feedback_read",
      "add": [
        "clarification_asked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_against_codebase": {
      "owner": "agent",
      "pre": "feedback_read",
      "add": [
        "feedback_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_fix": {
      "owner": "agent",
      "pre": "feedback_verified",
      "add": [
        "fix_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_tests": {
      "owner": "agent",
      "pre": "fix_implemented",
      "add": [
        "fix_tested"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "push_back": {
      "owner": "agent",
      "pre": "feedback_verified",
      "add": [
        "pushback_given"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_feedback",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "reviewer",
        "observed": true,
        "branches": {
          "clear": [
            {
              "act": {
                "cap": "verify_against_codebase",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "agent",
                "observed": true,
                "branches": {
                  "sound": [
                    {
                      "act": {
                        "cap": "implement_fix",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "run_tests",
                        "by": "agent"
                      }
                    }
                  ],
                  "unsound": [
                    {
                      "act": {
                        "cap": "push_back",
                        "by": "agent"
                      }
                    }
                  ]
                }
              }
            }
          ],
          "unclear": [
            {
              "act": {
                "cap": "ask_clarification",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "feedback_read",
      {
        "or": [
          "clarification_asked",
          {
            "and": [
              "feedback_verified",
              {
                "or": [
                  "fix_tested",
                  "pushback_given"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "init_true": [],
  "init_constraints": []
}
