{
  "name": "ui-widget-developer",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "build_widgets": {
      "owner": "agent",
      "pre": true,
      "add": [
        "widget_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "register_resources": {
      "owner": "agent",
      "pre": "widget_built",
      "add": [
        "resources_registered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "start_services": {
      "owner": "agent",
      "pre": "resources_registered",
      "add": [
        "services_running"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_inspector": {
      "owner": "agent",
      "pre": "services_running",
      "add": [
        "tools_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "provision_agent": {
      "owner": "agent",
      "pre": "tools_verified",
      "add": [
        "agent_provisioned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "report_summary": {
      "owner": "agent",
      "pre": "agent_provisioned",
      "add": [
        "summary_reported"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "oai_apps": [
            {
              "act": {
                "cap": "build_widgets",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "register_resources",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "start_services",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "run_inspector",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "provision_agent",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "report_summary",
                "by": "agent"
              }
            }
          ],
          "mcp_apps": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "widget_built",
      "resources_registered",
      "services_running",
      "tools_verified",
      "agent_provisioned",
      "summary_reported"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
