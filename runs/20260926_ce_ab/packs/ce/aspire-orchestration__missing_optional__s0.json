{
  "name": "aspire-orchestration",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "aspire_start": {
      "owner": "agent",
      "pre": "process_permission",
      "add": [
        "app_running"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "aspire_wait": {
      "owner": "agent",
      "pre": "app_running",
      "add": [
        "resource_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "aspire_describe": {
      "owner": "agent",
      "pre": {
        "and": [
          "resource_ready",
          "app_running"
        ]
      },
      "add": [
        "status_recorded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "aspire_stop": {
      "owner": "agent",
      "pre": "app_running",
      "add": [],
      "del": [
        "app_running",
        "resource_ready"
      ],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "aspire_start",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "aspire_wait",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "aspire_describe",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "aspire_stop",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "status_recorded",
      {
        "not": "app_running"
      }
    ]
  },
  "init_true": [
    "process_permission"
  ],
  "init_constraints": []
}
