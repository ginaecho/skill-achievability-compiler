{
  "name": "neon-object-storage",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "declare_buckets": {
      "owner": "agent",
      "pre": true,
      "add": [
        "buckets_declared"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "apply_config": {
      "owner": "agent",
      "pre": "buckets_declared",
      "add": [
        "buckets_provisioned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "pull_env": {
      "owner": "agent",
      "pre": "buckets_provisioned",
      "add": [
        "env_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "upload_object": {
      "owner": "agent",
      "pre": "env_ready",
      "add": [
        "object_uploaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "download_object": {
      "owner": "agent",
      "pre": "object_uploaded",
      "add": [
        "object_downloaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "declare_buckets",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "apply_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "pull_env",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "upload_object",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "download_object",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "object_uploaded",
      "object_downloaded"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
