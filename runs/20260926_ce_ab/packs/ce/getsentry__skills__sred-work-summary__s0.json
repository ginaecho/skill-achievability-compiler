{
  "name": "sred-work-summary",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "get_year": {
      "owner": "agent",
      "pre": true,
      "add": [
        "year_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "collect_user_info": {
      "owner": "agent",
      "pre": "year_known",
      "add": [
        "info_collected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_doc_exists": {
      "owner": "agent",
      "pre": "info_collected",
      "add": [
        "existence_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_notion_doc": {
      "owner": "agent",
      "pre": "existence_checked",
      "add": [
        "doc_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "search_github_prs": {
      "owner": "agent",
      "pre": "doc_created",
      "add": [
        "prs_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "search_notion_docs": {
      "owner": "agent",
      "pre": "doc_created",
      "add": [
        "notion_docs_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "search_linear_tickets": {
      "owner": "agent",
      "pre": "doc_created",
      "add": [
        "tickets_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "add_links": {
      "owner": "agent",
      "pre": {
        "and": [
          "prs_found",
          "notion_docs_found",
          "tickets_found"
        ]
      },
      "add": [
        "links_added"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "group_into_projects": {
      "owner": "agent",
      "pre": "links_added",
      "add": [
        "projects_grouped"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "search_other_users_docs": {
      "owner": "agent",
      "pre": "projects_grouped",
      "add": [
        "other_docs_searched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "add_other_docs_links": {
      "owner": "agent",
      "pre": "other_docs_searched",
      "add": [
        "other_docs_added"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "return_link": {
      "owner": "agent",
      "pre": "other_docs_added",
      "add": [
        "link_returned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "get_year",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "collect_user_info",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_doc_exists",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "doc_missing": [
            {
              "act": {
                "cap": "create_notion_doc",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "search_github_prs",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "search_notion_docs",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "search_linear_tickets",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "add_links",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "group_into_projects",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "search_other_users_docs",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "add_other_docs_links",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "return_link",
                "by": "agent"
              }
            }
          ],
          "doc_exists": []
        }
      }
    }
  ],
  "goal": "link_returned",
  "init_true": [],
  "init_constraints": []
}
