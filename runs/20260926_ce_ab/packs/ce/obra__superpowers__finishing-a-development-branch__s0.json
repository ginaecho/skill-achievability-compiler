{
  "name": "finishing-a-development-branch",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "run_tests": {
      "owner": "agent",
      "pre": true,
      "add": [
        "tests_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "detect_environment": {
      "owner": "agent",
      "pre": true,
      "add": [
        "environment_detected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "determine_base_branch": {
      "owner": "agent",
      "pre": "environment_detected",
      "add": [
        "base_branch_confirmed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "present_options": {
      "owner": "agent",
      "pre": {
        "and": [
          "tests_verified",
          "base_branch_confirmed"
        ]
      },
      "add": [
        "options_presented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "merge_locally": {
      "owner": "agent",
      "pre": "options_presented",
      "add": [
        "merged"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "push_and_create_pr": {
      "owner": "agent",
      "pre": "options_presented",
      "add": [
        "pr_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "keep_as_is": {
      "owner": "agent",
      "pre": "options_presented",
      "add": [
        "kept_as_is"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "cleanup_workspace": {
      "owner": "agent",
      "pre": "merged",
      "add": [
        "cleaned_up"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "run_tests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "detect_environment",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "determine_base_branch",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "present_options",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "merge": [
            {
              "act": {
                "cap": "merge_locally",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "cleanup_workspace",
                "by": "agent"
              }
            }
          ],
          "push_pr": [
            {
              "act": {
                "cap": "push_and_create_pr",
                "by": "agent"
              }
            }
          ],
          "keep": [
            {
              "act": {
                "cap": "keep_as_is",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "tests_verified",
      "options_presented",
      {
        "or": [
          {
            "and": [
              "merged",
              "cleaned_up"
            ]
          },
          "pr_created",
          "kept_as_is"
        ]
      }
    ]
  },
  "init_true": [],
  "init_constraints": []
}
