{
  "name": "kql",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "draft_query": {
      "owner": "agent",
      "pre": true,
      "add": [
        "query_drafted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "apply_checklist": {
      "owner": "agent",
      "pre": "query_drafted",
      "add": [
        "checklist_applied"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fix_error": {
      "owner": "agent",
      "pre": "query_drafted",
      "add": [
        "error_fixed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "draft_query",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "apply_checklist",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "test_query",
        "body": [
          {
            "act": {
              "cap": "run_query",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "error": [
                  {
                    "act": {
                      "cap": "fix_error",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "test_query"
                  }
                ],
                "success": []
              }
            }
          }
        ]
      }
    }
  ],
  "goal": {
    "and": [
      "checklist_applied",
      "query_validated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
