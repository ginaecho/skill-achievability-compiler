{
  "name": "azure-monitor-opentelemetry-exporter-java",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "configure_exporter": {
      "owner": "agent",
      "pre": true,
      "add": [
        "exporter_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "record_span": {
      "owner": "agent",
      "pre": "exporter_configured",
      "add": [
        "span_recorded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "enrich_span": {
      "owner": "agent",
      "pre": "span_recorded",
      "add": [
        "span_enriched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "export_span": {
      "owner": "agent",
      "pre": {
        "and": [
          "span_recorded",
          "ingestion_egress"
        ]
      },
      "add": [
        "telemetry_delivered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "configure_exporter",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "record_span",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "export_span",
        "by": "agent"
      }
    }
  ],
  "goal": "telemetry_delivered",
  "init_true": [
    "ingestion_egress"
  ],
  "init_constraints": []
}
