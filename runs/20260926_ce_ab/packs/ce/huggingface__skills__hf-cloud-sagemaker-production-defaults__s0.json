{
  "name": "hf-cloud-sagemaker-production-defaults",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "deploy_endpoint": {
      "owner": "agent",
      "pre": {
        "and": [
          "image_uri_known",
          "role_arn_known"
        ]
      },
      "add": [
        "endpoint_deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "wait_for_inservice": {
      "owner": "agent",
      "pre": "endpoint_deployed",
      "add": [
        "endpoint_inservice"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "invoke_endpoint": {
      "owner": "agent",
      "pre": "endpoint_inservice",
      "add": [
        "smoke_test_passed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scan_logs": {
      "owner": "agent",
      "pre": "endpoint_inservice",
      "add": [
        "logs_scanned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "teardown": {
      "owner": "agent",
      "pre": "endpoint_deployed",
      "add": [
        "endpoint_torn_down"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "deploy_endpoint",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "wait_for_inservice",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "invoke_endpoint",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scan_logs",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "endpoint_deployed",
      "smoke_test_passed",
      "logs_scanned"
    ]
  },
  "init_true": [
    "image_uri_known",
    "role_arn_known"
  ],
  "init_constraints": []
}
