{
  "name": "cli-exercise-preflight",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_receipt": {
      "owner": "agent",
      "pre": true,
      "add": [
        "capabilities_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_preflight_check": {
      "owner": "agent",
      "pre": true,
      "add": [
        "capabilities_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_dependency": {
      "owner": "agent",
      "pre": true,
      "add": [
        "dependency_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_receipt": {
      "owner": "agent",
      "pre": "capabilities_checked",
      "add": [
        "receipt_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
