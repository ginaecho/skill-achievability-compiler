                                "cap": "install_dependency",
                                "by": "agent"
                              }
                            },
                            {
                              "act": {
                                "cap": "run_preflight_check",
                                "by": "agent"
                              }
                            }
                          ],
                          "decline": []
                        }
                      }
                    }
                  ],
                  "capability_ok": []
                }
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "write_receipt",
        "by": "agent"
      }
    }
  ],
  "goal": "receipt_written",
  "init_true": [],
  "init_constraints": []
