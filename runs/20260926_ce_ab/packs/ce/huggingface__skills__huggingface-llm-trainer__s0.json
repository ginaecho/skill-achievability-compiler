{
  "name": "huggingface-llm-trainer",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "hf_whoami": {
      "owner": "agent",
      "pre": true,
      "add": [
        "auth_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_dataset": {
      "owner": "agent",
      "pre": true,
      "add": [
        "dataset_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_training_script": {
      "owner": "agent",
      "pre": true,
      "add": [
        "script_written",
        "hub_push_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "hf_jobs": {
      "owner": "agent",
      "pre": {
        "and": [
          "auth_verified",
          "script_written"
        ]
      },
      "add": [
        "job_submitted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "report_job_details": {
      "owner": "agent",
      "pre": "job_submitted",
      "add": [
        "job_reported"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "hf_whoami",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_dataset",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_training_script",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "hf_jobs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "report_job_details",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "job_submitted",
      "hub_push_configured",
      "job_reported"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
