{
  "name": "fastapi-router-py",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "create_router": {
      "owner": "agent",
      "pre": true,
      "add": [
        "router_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "mount_router": {
      "owner": "agent",
      "pre": "router_created",
      "add": [
        "router_mounted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_models": {
      "owner": "agent",
      "pre": "router_created",
      "add": [
        "models_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_service_layer": {
      "owner": "agent",
      "pre": "router_created",
      "add": [
        "service_layer_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "add_frontend_api": {
      "owner": "agent",
      "pre": "router_created",
      "add": [
        "frontend_api_added"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "create_router",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "mount_router",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_models",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "needs_service_layer": [
            {
              "act": {
                "cap": "create_service_layer",
                "by": "agent"
              }
            }
          ],
          "no_service_layer": []
        }
      }
    },
    {
      "act": {
        "cap": "add_frontend_api",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "router_created",
      "router_mounted",
      "models_created",
      "frontend_api_added"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
