{
  "name": "preset",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "verify_auth": {
      "owner": "agent",
      "pre": true,
      "add": [
        "auth_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "get_project": {
      "owner": "agent",
      "pre": "auth_verified",
      "add": [
        "project_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "select_model": {
      "owner": "agent",
      "pre": "project_found",
      "add": [
        "model_selected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_region_capacity": {
      "owner": "agent",
      "pre": "model_selected",
      "add": [
        "capacity_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "query_all_regions": {
      "owner": "agent",
      "pre": "capacity_checked",
      "add": [
        "regions_queried"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "select_region_project": {
      "owner": "agent",
      "pre": "regions_queried",
      "add": [
        "region_project_selected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_model": {
      "owner": "agent",
      "pre": "capacity_checked",
      "add": [
        "deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "monitor_deployment": {
      "owner": "agent",
      "pre": "deployed",
      "add": [
        "deployment_monitored"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "verify_auth",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "get_project",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "select_model",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_region_capacity",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "has_capacity": [
            {
              "act": {
                "cap": "deploy_model",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "monitor_deployment",
                "by": "agent"
              }
            }
          ],
          "no_capacity": [
            {
              "act": {
                "cap": "query_all_regions",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "region_selected": [
                    {
                      "act": {
                        "cap": "select_region_project",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "deploy_model",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "monitor_deployment",
                        "by": "agent"
                      }
                    }
                  ],
                  "abort": []
                }
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "deployed",
      "deployment_monitored"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
