{
  "name": "neon-auth",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_existing_identity": {
      "owner": "agent",
      "pre": true,
      "add": [
        "identity_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "enable_managed_auth": {
      "owner": "agent",
      "pre": "identity_inspected",
      "add": [
        "auth_enabled"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "neon_deploy": {
      "owner": "agent",
      "pre": "auth_enabled",
      "add": [
        "deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_login": {
      "owner": "agent",
      "pre": "deployed",
      "add": [
        "login_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_auth_flows": {
      "owner": "agent",
      "pre": "login_implemented",
      "add": [
        "verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_existing_identity",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "no_existing_auth": [
            {
              "act": {
                "cap": "enable_managed_auth",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "neon_deploy",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "implement_login",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "verify_auth_flows",
                "by": "agent"
              }
            }
          ],
          "existing_auth_keep": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "auth_enabled",
      "deployed",
      "login_implemented",
      "verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
