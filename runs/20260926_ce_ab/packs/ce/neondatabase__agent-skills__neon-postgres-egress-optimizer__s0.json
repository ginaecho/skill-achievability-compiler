{
  "name": "neon-postgres-egress-optimizer",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "diagnose_egress": {
      "owner": "agent",
      "pre": true,
      "add": [
        "diagnosis_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "analyze_codebase": {
      "owner": "agent",
      "pre": "diagnosis_done",
      "add": [
        "codebase_analyzed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "apply_fixes": {
      "owner": "agent",
      "pre": "codebase_analyzed",
      "add": [
        "fixes_applied"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_fixes": {
      "owner": "agent",
      "pre": "fixes_applied",
      "add": [
        "fixes_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "diagnose_egress",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "analyze_codebase",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "apply_fixes",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_fixes",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "diagnosis_done",
      "codebase_analyzed",
      "fixes_applied",
      "fixes_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
