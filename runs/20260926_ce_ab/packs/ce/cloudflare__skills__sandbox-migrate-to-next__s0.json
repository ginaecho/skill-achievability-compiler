{
  "name": "sandbox-migrate-to-next",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "review_rules": {
      "owner": "agent",
      "pre": true,
      "add": [
        "rules_reviewed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "audit_codebase": {
      "owner": "agent",
      "pre": "rules_reviewed",
      "add": [
        "audit_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_clarifications": {
      "owner": "agent",
      "pre": "audit_done",
      "add": [
        "clarifications_asked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "upgrade_package": {
      "owner": "agent",
      "pre": "clarifications_asked",
      "add": [
        "package_upgraded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "update_code": {
      "owner": "agent",
      "pre": "package_upgraded",
      "add": [
        "code_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_migration": {
      "owner": "agent",
      "pre": "code_updated",
      "add": [
        "migration_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_cutover": {
      "owner": "agent",
      "pre": "migration_validated",
      "add": [
        "cutover_deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "review_rules",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "audit_codebase",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "ask_clarifications",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "upgrade_package",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "update_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_migration",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "approve_cutover": [
            {
              "act": {
                "cap": "deploy_cutover",
                "by": "agent"
              }
            }
          ],
          "defer_cutover": []
        }
      }
    }
  ],
  "goal": "migration_validated",
  "init_true": [],
  "init_constraints": []
}
