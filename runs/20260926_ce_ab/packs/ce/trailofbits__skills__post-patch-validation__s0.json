{
  "name": "post-patch-validation",
  "roles": [
    "agent",
    "author"
  ],
  "capabilities": {
    "scaffold_plan": {
      "owner": "agent",
      "pre": true,
      "add": [
        "plan_scaffolded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "print_schema": {
      "owner": "agent",
      "pre": true,
      "add": [
        "schema_printed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "populate_checks": {
      "owner": "agent",
      "pre": "plan_scaffolded",
      "add": [
        "checks_populated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_plan": {
      "owner": "agent",
      "pre": "checks_populated",
      "add": [
        "plan_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_validation": {
      "owner": "agent",
      "pre": "plan_validated",
      "add": [
        "validation_run"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "report_results": {
      "owner": "agent",
      "pre": "validation_run",
      "add": [
        "results_reported"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "scaffold_plan",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "print_schema",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "populate_checks",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "validation_cycle",
        "body": [
          {
            "act": {
              "cap": "validate_plan",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "run_validation",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "report_results",
              "by": "agent"
            }
          },
          {
            "msg": {
              "from": "agent",
              "to": "author",
              "label": "findings_reported"
            }
          },
          {
            "choice": {
              "by": "author",
              "external": true,
              "branches": {
                "revise": [
                  {
                    "msg": {
                      "from": "author",
                      "to": "agent",
                      "label": "patch_revised"
                    }
                  },
                  {
                    "continue": "validation_cycle"
                  }
                ],
                "done": []
              }
            }
          }
        ]
      }
    }
  ],
  "goal": {
    "and": [
      "results_reported",
      "validation_run"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
