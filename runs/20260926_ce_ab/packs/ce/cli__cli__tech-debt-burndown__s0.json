{
  "name": "tech-debt-burndown",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_authorization": {
      "owner": "agent",
      "pre": true,
      "add": [
        "authorized"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_preconditions": {
      "owner": "agent",
      "pre": "authorized",
      "add": [
        "preconditions_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_memory": {
      "owner": "agent",
      "pre": "preconditions_checked",
      "add": [
        "memory_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "establish_baseline": {
      "owner": "agent",
      "pre": "memory_read",
      "add": [
        "baseline_established"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "pick_target": {
      "owner": "agent",
      "pre": "baseline_established",
      "add": [
        "target_picked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fix_target": {
      "owner": "agent",
      "pre": "target_picked",
      "add": [
        "fix_made"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_fix": {
      "owner": "agent",
      "pre": "fix_made",
      "add": [
        "fix_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "commit_and_open_pr": {
      "owner": "agent",
      "pre": "fix_validated",
      "add": [
        "pr_opened"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "update_memory_file": {
      "owner": "agent",
      "pre": "pr_opened",
      "add": [
        "memory_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_authorization",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_preconditions",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "preconditions_ok": [
            {
              "act": {
                "cap": "read_memory",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "establish_baseline",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "pick_target",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "fix_target",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "validate_fix",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "commit_and_open_pr",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "update_memory_file",
                "by": "agent"
              }
            }
          ],
          "preconditions_failed": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "pr_opened",
      "memory_updated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
