{
  "name": "expo-examples",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "find_example": {
      "owner": "agent",
      "pre": true,
      "add": [
        "example_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_example": {
      "owner": "agent",
      "pre": "example_found",
      "add": [
        "example_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scaffold_from_example": {
      "owner": "agent",
      "pre": "example_found",
      "add": [
        "project_scaffolded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_missing_deps": {
      "owner": "agent",
      "pre": "example_read",
      "add": [
        "deps_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "merge_config": {
      "owner": "agent",
      "pre": "example_read",
      "add": [
        "config_merged"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "port_integration_code": {
      "owner": "agent",
      "pre": "example_read",
      "add": [
        "code_ported"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "find_example",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "inspiration": [
            {
              "act": {
                "cap": "read_example",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "install_missing_deps",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "merge_config",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "port_integration_code",
                "by": "agent"
              }
            }
          ],
          "scaffold": [
            {
              "act": {
                "cap": "scaffold_from_example",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "example_found",
      {
        "or": [
          {
            "and": [
              "code_ported",
              "deps_installed",
              "config_merged"
            ]
          },
          "project_scaffolded"
        ]
      }
    ]
  },
  "init_true": [],
  "init_constraints": []
}
