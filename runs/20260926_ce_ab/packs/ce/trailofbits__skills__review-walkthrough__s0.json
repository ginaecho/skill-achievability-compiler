{
  "name": "review-walkthrough",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "resolve_base": {
      "owner": "agent",
      "pre": true,
      "add": [
        "base_resolved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "capture_diff": {
      "owner": "agent",
      "pre": "base_resolved",
      "add": [
        "diff_captured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_source_context": {
      "owner": "agent",
      "pre": "diff_captured",
      "add": [
        "context_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_review_data": {
      "owner": "agent",
      "pre": {
        "and": [
          "diff_captured",
          "context_read"
        ]
      },
      "add": [
        "data_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "render_walkthrough": {
      "owner": "agent",
      "pre": "data_written",
      "add": [
        "walkthrough_rendered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "open_walkthrough": {
      "owner": "agent",
      "pre": "walkthrough_rendered",
      "add": [
        "walkthrough_opened"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "report_path": {
      "owner": "agent",
      "pre": "walkthrough_rendered",
      "add": [
        "path_reported"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "resolve_base",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "capture_diff",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_source_context",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_review_data",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "render_walkthrough",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "headless": [
            {
              "act": {
                "cap": "report_path",
                "by": "agent"
              }
            }
          ],
          "browser_available": [
            {
              "act": {
                "cap": "open_walkthrough",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "walkthrough_rendered",
      {
        "or": [
          "walkthrough_opened",
          "path_reported"
        ]
      }
    ]
  },
  "init_true": [],
  "init_constraints": []
}
