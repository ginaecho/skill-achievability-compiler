{
  "name": "declarative-agent-developer",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_atk_cli": {
      "owner": "agent",
      "pre": true,
      "add": [
        "atk_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "inspect_workspace": {
      "owner": "agent",
      "pre": "atk_checked",
      "add": [
        "workspace_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "edit_manifest": {
      "owner": "agent",
      "pre": "workspace_inspected",
      "add": [
        "manifest_edited"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_agent": {
      "owner": "agent",
      "pre": "manifest_edited",
      "add": [
        "agent_deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "present_test_link": {
      "owner": "agent",
      "pre": "agent_deployed",
      "add": [
        "test_link_presented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "report_missing_manifest": {
      "owner": "agent",
      "pre": "workspace_inspected",
      "add": [
        "rejection_reported"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "report_manifest_errors": {
      "owner": "agent",
      "pre": "workspace_inspected",
      "add": [
        "errors_reported"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_atk_cli",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "inspect_workspace",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "manifest_valid": [
            {
              "act": {
                "cap": "edit_manifest",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "deploy_agent",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "present_test_link",
                "by": "agent"
              }
            }
          ],
          "manifest_missing": [
            {
              "act": {
                "cap": "report_missing_manifest",
                "by": "agent"
              }
            }
          ],
          "manifest_errors": [
            {
              "act": {
                "cap": "report_manifest_errors",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "or": [
      "test_link_presented",
      "rejection_reported",
      "errors_reported"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
