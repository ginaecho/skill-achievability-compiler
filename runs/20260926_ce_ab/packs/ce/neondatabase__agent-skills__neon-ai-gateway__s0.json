{
  "name": "neon-ai-gateway",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "enable_gateway": {
      "owner": "agent",
      "pre": true,
      "add": [
        "gateway_declared"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_gateway": {
      "owner": "agent",
      "pre": {
        "and": [
          "gateway_declared",
          "paid_plan"
        ]
      },
      "add": [
        "gateway_provisioned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "pull_env": {
      "owner": "agent",
      "pre": "gateway_provisioned",
      "add": [
        "env_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "call_model": {
      "owner": "agent",
      "pre": "env_ready",
      "add": [
        "inference_request_made"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "enable_gateway",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "deploy_gateway",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "pull_env",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "call_model",
        "by": "agent"
      }
    }
  ],
  "goal": "inference_request_made",
  "init_true": [
    "paid_plan"
  ],
  "init_constraints": []
}
