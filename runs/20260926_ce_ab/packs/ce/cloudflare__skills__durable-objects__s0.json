{
  "name": "durable-objects",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "fetch_docs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "docs_retrieved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_wrangler": {
      "owner": "agent",
      "pre": true,
      "add": [
        "bindings_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_do_class": {
      "owner": "agent",
      "pre": "docs_retrieved",
      "add": [
        "do_class_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_tests": {
      "owner": "agent",
      "pre": {
        "and": [
          "do_class_written",
          "bindings_configured"
        ]
      },
      "add": [
        "tests_run"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "fetch_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_wrangler",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_do_class",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_tests",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "do_class_written",
      "bindings_configured",
      "tests_run"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
