{
  "name": "web-perf",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "navigate_page": {
      "owner": "agent",
      "pre": true,
      "add": [
        "page_loaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "performance_start_trace": {
      "owner": "agent",
      "pre": "page_loaded",
      "add": [
        "trace_captured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "performance_analyze_insight": {
      "owner": "agent",
      "pre": "trace_captured",
      "add": [
        "insights_analyzed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "list_network_requests": {
      "owner": "agent",
      "pre": "page_loaded",
      "add": [
        "network_listed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "get_network_request": {
      "owner": "agent",
      "pre": "network_listed",
      "add": [
        "network_analyzed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "take_snapshot": {
      "owner": "agent",
      "pre": "page_loaded",
      "add": [
        "accessibility_snapshotted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "analyze_codebase": {
      "owner": "agent",
      "pre": true,
      "add": [
        "codebase_analyzed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "report_findings": {
      "owner": "agent",
      "pre": {
        "and": [
          "insights_analyzed",
          "network_analyzed",
          "accessibility_snapshotted"
        ]
      },
      "add": [
        "findings_reported"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "navigate_page",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "performance_start_trace",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "performance_analyze_insight",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "list_network_requests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "get_network_request",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "take_snapshot",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "has_codebase_access": [
            {
              "act": {
                "cap": "analyze_codebase",
                "by": "agent"
              }
            }
          ],
          "third_party_site": []
        }
      }
    },
    {
      "act": {
        "cap": "report_findings",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "insights_analyzed",
      "network_analyzed",
      "accessibility_snapshotted",
      "findings_reported"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
