{
  "name": "pdf",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "generate_pdf": {
      "owner": "agent",
      "pre": true,
      "add": [
        "pdf_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "render_pages": {
      "owner": "agent",
      "pre": "pdf_generated",
      "add": [
        "pages_rendered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "inspect_pages": {
      "owner": "agent",
      "pre": "pages_rendered",
      "add": [
        "pages_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fix_issues": {
      "owner": "agent",
      "pre": "pages_inspected",
      "add": [],
      "del": [
        "pages_inspected",
        "pages_rendered"
      ],
      "assigns": {},
      "nondet": {}
    },
    "deliver_pdf": {
      "owner": "agent",
      "pre": "pages_inspected",
      "add": [
        "pdf_delivered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "generate_pdf",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "refine",
        "body": [
          {
            "act": {
              "cap": "render_pages",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "inspect_pages",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "defects_found": [
                  {
                    "act": {
                      "cap": "fix_issues",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "refine"
                  }
                ],
                "no_defects": [
                  {
                    "act": {
                      "cap": "deliver_pdf",
                      "by": "agent"
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "goal": "pdf_delivered",
  "init_true": [],
  "init_constraints": []
}
