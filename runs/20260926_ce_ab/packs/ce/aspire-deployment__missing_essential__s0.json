{
  "name": "aspire-deployment",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "aspire_publish": {
      "owner": "agent",
      "pre": true,
      "add": [
        "artifacts_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "clear_deployment_cache": {
      "owner": "agent",
      "pre": true,
      "add": [
        "cache_cleared"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "aspire_publish",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "clear_cache": [
            {
              "act": {
                "cap": "clear_deployment_cache",
                "by": "agent"
              }
            }
          ],
          "skip_clear": []
        }
      }
    },
    {
      "act": {
        "cap": "aspire_deploy",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "or": [
      "azure_deployed",
      "kubernetes_deployed"
    ]
  },
  "init_true": [
    "target_access"
  ],
  "init_constraints": []
}
