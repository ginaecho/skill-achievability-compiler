{
  "name": "qdrant-vertical-scaling",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_resource_usage": {
      "owner": "agent",
      "pre": true,
      "add": [
        "usage_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ensure_replication_factor": {
      "owner": "agent",
      "pre": "usage_checked",
      "add": [
        "replication_ensured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "resize_node": {
      "owner": "agent",
      "pre": "usage_checked",
      "add": [
        "node_resized"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "load_test": {
      "owner": "agent",
      "pre": "node_resized",
      "add": [
        "load_tested"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_resource_usage",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "cloud_with_replication": [
            {
              "act": {
                "cap": "ensure_replication_factor",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "resize_node",
                "by": "agent"
              }
            }
          ],
          "self_hosted": [
            {
              "act": {
                "cap": "resize_node",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "scaling_down": [
            {
              "act": {
                "cap": "load_test",
                "by": "agent"
              }
            }
          ],
          "scaling_up": []
        }
      }
    }
  ],
  "goal": "node_resized",
  "init_true": [],
  "init_constraints": []
}
