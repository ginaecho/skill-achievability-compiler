{
  "name": "systematic-debugging",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "investigate_root_cause": {
      "owner": "agent",
      "pre": true,
      "add": [
        "root_cause_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_failing_test": {
      "owner": "agent",
      "pre": "root_cause_found",
      "add": [
        "test_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_fix": {
      "owner": "agent",
      "pre": "test_written",
      "add": [
        "fix_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_fix": {
      "owner": "agent",
      "pre": "fix_implemented",
      "add": [
        "fix_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "rec": {
        "name": "debug_loop",
        "body": [
          {
            "act": {
              "cap": "investigate_root_cause",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "write_failing_test",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "implement_fix",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "verify_fix",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "resolved": [],
                "retry": [
                  {
                    "continue": "debug_loop"
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "goal": "fix_verified",
  "init_true": [],
  "init_constraints": []
}
