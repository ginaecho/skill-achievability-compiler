{
  "name": "huggingface-lora-space-builder",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "authenticate": {
      "owner": "agent",
      "pre": true,
      "add": [
        "authenticated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_lora_repo": {
      "owner": "agent",
      "pre": "authenticated",
      "add": [
        "lora_info_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "pick_pipeline": {
      "owner": "agent",
      "pre": "lora_info_gathered",
      "add": [
        "pipeline_picked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "design_ui": {
      "owner": "agent",
      "pre": "pipeline_picked",
      "add": [
        "ui_designed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_space_files": {
      "owner": "agent",
      "pre": "ui_designed",
      "add": [
        "files_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "publish_space": {
      "owner": "agent",
      "pre": "files_written",
      "add": [
        "space_published"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "wait_for_build": {
      "owner": "agent",
      "pre": "space_published",
      "add": [
        "build_running"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "smoke_test": {
      "owner": "agent",
      "pre": "build_running",
      "add": [
        "smoke_tested"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "share_url": {
      "owner": "agent",
      "pre": "smoke_tested",
      "add": [
        "url_shared"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "authenticate",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_lora_repo",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "pick_pipeline",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "design_ui",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "revise",
        "body": [
          {
            "act": {
              "cap": "write_space_files",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "user",
              "observed": true,
              "branches": {
                "approve": [],
                "request_changes": [
                  {
                    "continue": "revise"
                  }
                ]
              }
            }
          }
        ]
      }
    },
    {
      "act": {
        "cap": "publish_space",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "wait_for_build",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "smoke_test",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "share_url",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "space_published",
      "smoke_tested",
      "url_shared"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
