{
  "name": "expo-native-ui",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "run_expo_go": {
      "owner": "agent",
      "pre": true,
      "add": [
        "app_running"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "test_in_expo_go": {
      "owner": "agent",
      "pre": "app_running",
      "add": [
        "tested_in_expo_go"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_custom": {
      "owner": "agent",
      "pre": "feature_requires_custom_build",
      "add": [
        "custom_build_exists"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_screen": {
      "owner": "agent",
      "pre": "tested_in_expo_go",
      "add": [
        "screen_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "run_expo_go",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "test_in_expo_go",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "expo_go_sufficient": [],
          "needs_custom_build": [
            {
              "act": {
                "cap": "build_custom",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "verify_screen",
        "by": "agent"
      }
    }
  ],
  "goal": "screen_verified",
  "init_true": [],
  "init_constraints": []
}
