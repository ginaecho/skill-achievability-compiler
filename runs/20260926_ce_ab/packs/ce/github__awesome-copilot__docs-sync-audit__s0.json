{
  "name": "docs-sync-audit",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inventory_repo": {
      "owner": "agent",
      "pre": true,
      "add": [
        "repo_inventoried"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_drift_script": {
      "owner": "agent",
      "pre": "repo_inventoried",
      "add": [
        "drift_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "compare_code_and_docs": {
      "owner": "agent",
      "pre": "drift_checked",
      "add": [
        "comparison_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_findings": {
      "owner": "agent",
      "pre": "comparison_done",
      "add": [
        "findings_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_report": {
      "owner": "agent",
      "pre": "findings_verified",
      "add": [
        "report_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "update_docs": {
      "owner": "agent",
      "pre": "report_written",
      "add": [
        "docs_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inventory_repo",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_drift_script",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "compare_code_and_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_findings",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_report",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "update_requested": [
            {
              "act": {
                "cap": "update_docs",
                "by": "agent"
              }
            }
          ],
          "no_update": []
        }
      }
    }
  ],
  "goal": "report_written",
  "init_true": [],
  "init_constraints": []
}
