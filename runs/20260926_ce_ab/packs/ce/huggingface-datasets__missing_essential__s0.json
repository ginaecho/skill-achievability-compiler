{
  "name": "huggingface-datasets",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "validate_dataset": {
      "owner": "agent",
      "pre": "viewer_egress",
      "add": [
        "dataset_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "get_splits": {
      "owner": "agent",
      "pre": "viewer_egress",
      "add": [
        "split_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "get_splits",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_rows",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "split_known",
      "rows_fetched"
    ]
  },
  "init_true": [
    "viewer_egress"
  ],
  "init_constraints": []
}
