{
  "name": "requesting-code-review",
  "roles": [
    "agent",
    "reviewer"
  ],
  "capabilities": {
    "get_shas": {
      "owner": "agent",
      "pre": true,
      "add": [
        "shas_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fix_issues": {
      "owner": "agent",
      "pre": true,
      "add": [
        "issues_fixed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "get_shas",
        "by": "agent"
      }
    },
    {
      "spawn": {
        "role": "reviewer"
      }
    },
    {
      "msg": {
        "from": "reviewer",
        "to": "agent",
        "label": "review_feedback"
      }
    },
    {
      "act": {
        "cap": "fix_issues",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "shas_known",
      "issues_fixed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
