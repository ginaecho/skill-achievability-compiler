{
  "name": "render-deploy",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_git_remote": {
      "owner": "agent",
      "pre": true,
      "add": [],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "analyze_codebase": {
      "owner": "agent",
      "pre": true,
      "add": [
        "codebase_analyzed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_blueprint": {
      "owner": "agent",
      "pre": "codebase_analyzed",
      "add": [
        "blueprint_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_blueprint": {
      "owner": "agent",
      "pre": "blueprint_created",
      "add": [
        "blueprint_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "commit_and_push": {
      "owner": "agent",
      "pre": "blueprint_created",
      "add": [
        "blueprint_pushed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_deeplink": {
      "owner": "agent",
      "pre": "blueprint_pushed",
      "add": [
        "deeplink_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_service_direct": {
      "owner": "agent",
      "pre": "codebase_analyzed",
      "add": [
        "service_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_deploy_status": {
      "owner": "agent",
      "pre": true,
      "add": [
        "deploy_status_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_logs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "logs_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_metrics": {
      "owner": "agent",
      "pre": true,
      "add": [
        "metrics_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_git_remote",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "no_remote": [
            {
              "msg": {
                "from": "agent",
                "to": "user",
                "label": "need_git_remote"
              }
            }
          ],
          "remote_exists": [
            {
              "act": {
                "cap": "analyze_codebase",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "blueprint": [
                    {
                      "act": {
                        "cap": "generate_blueprint",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "validate_blueprint",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "commit_and_push",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "generate_deeplink",
                        "by": "agent"
                      }
                    },
                    {
                      "msg": {
                        "from": "agent",
                        "to": "user",
                        "label": "deeplink_ready"
                      }
                    },
                    {
                      "act": {
                        "cap": "apply_blueprint",
                        "by": "user"
                      }
                    },
                    {
                      "act": {
                        "cap": "check_deploy_status",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "check_logs",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "check_metrics",
                        "by": "agent"
                      }
                    }
                  ],
                  "direct_creation": [
                    {
                      "act": {
                        "cap": "create_service_direct",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "check_deploy_status",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "check_logs",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "check_metrics",
                        "by": "agent"
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "service_deployed",
      "deploy_status_checked",
      "logs_checked",
      "metrics_checked"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
