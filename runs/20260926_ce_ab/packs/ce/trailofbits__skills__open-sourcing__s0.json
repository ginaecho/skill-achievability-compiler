{
  "name": "open-sourcing",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "detect_org": {
      "owner": "agent",
      "pre": true,
      "add": [
        "org_detected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "audit_secrets": {
      "owner": "agent",
      "pre": "org_detected",
      "add": [
        "secrets_audited"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_readiness": {
      "owner": "agent",
      "pre": "secrets_audited",
      "add": [
        "readiness_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_docs": {
      "owner": "agent",
      "pre": "readiness_checked",
      "add": [
        "docs_complete"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "apply_license": {
      "owner": "agent",
      "pre": "readiness_checked",
      "add": [
        "license_applied"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "setup_ci": {
      "owner": "agent",
      "pre": "readiness_checked",
      "add": [
        "ci_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "tag_release": {
      "owner": "agent",
      "pre": "ci_configured",
      "add": [
        "release_tagged"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "final_review": {
      "owner": "agent",
      "pre": {
        "and": [
          "docs_complete",
          "license_applied",
          "ci_configured"
        ]
      },
      "add": [
        "review_passed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "detect_org",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "audit_secrets",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_readiness",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "apply_license",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "setup_ci",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "tag_release",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "final_review",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "make_repo_public",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "secrets_audited",
      "docs_complete",
      "license_applied",
      "ci_configured",
      "review_passed",
      "repo_public"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
