{
  "name": "graph-evolution",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "create_worktrees": {
      "owner": "agent",
      "pre": true,
      "add": [
        "snapshots_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_graph_before": {
      "owner": "agent",
      "pre": "snapshots_created",
      "add": [
        "before_graph_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_graph_after": {
      "owner": "agent",
      "pre": "snapshots_created",
      "add": [
        "after_graph_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_native_diff": {
      "owner": "agent",
      "pre": {
        "and": [
          "before_graph_built",
          "after_graph_built"
        ]
      },
      "add": [
        "native_diff_computed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_subgraph_diff": {
      "owner": "agent",
      "pre": {
        "and": [
          "before_graph_built",
          "after_graph_built"
        ]
      },
      "add": [
        "subgraph_diff_computed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_report": {
      "owner": "agent",
      "pre": {
        "and": [
          "native_diff_computed",
          "subgraph_diff_computed"
        ]
      },
      "add": [
        "report_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "cleanup_worktrees": {
      "owner": "agent",
      "pre": "report_written",
      "add": [
        "worktrees_cleaned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "create_worktrees",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_graph_before",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_graph_after",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_native_diff",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_subgraph_diff",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_report",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "cleanup_worktrees",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "report_written",
      "worktrees_cleaned"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
