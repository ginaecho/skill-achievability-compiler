{
  "name": "eas-update",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "install_expo_updates": {
      "owner": "agent",
      "pre": true,
      "add": [
        "expo_updates_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_update": {
      "owner": "agent",
      "pre": "expo_updates_installed",
      "add": [
        "update_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "publish_update": {
      "owner": "agent",
      "pre": "update_configured",
      "add": [
        "published"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_expo_updates",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_update",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "authorize_publish": [
            {
              "act": {
                "cap": "publish_update",
                "by": "agent"
              }
            }
          ],
          "decline": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "update_configured",
      "published"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
