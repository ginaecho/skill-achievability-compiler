{
  "name": "run-acceptance-tests",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "discover_env_vars": {
      "owner": "agent",
      "pre": true,
      "add": [
        "env_vars_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_acceptance_test": {
      "owner": "agent",
      "pre": "env_vars_known",
      "add": [
        "test_result_observed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "diagnose_failure": {
      "owner": "agent",
      "pre": "test_result_observed",
      "add": [
        "diagnosis_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "flip_test": {
      "owner": "agent",
      "pre": "test_result_observed",
      "add": [
        "flip_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "discover_env_vars",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_acceptance_test",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "test_failed": [
            {
              "act": {
                "cap": "diagnose_failure",
                "by": "agent"
              }
            }
          ],
          "test_passed": [
            {
              "act": {
                "cap": "flip_test",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": "test_result_observed",
  "init_true": [],
  "init_constraints": []
}
