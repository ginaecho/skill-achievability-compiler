{
  "name": "huggingface-trackio",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "trackio_init": {
      "owner": "agent",
      "pre": true,
      "add": [
        "tracking_initialized"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "trackio_log": {
      "owner": "agent",
      "pre": "tracking_initialized",
      "add": [
        "metrics_logged"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "trackio_alert": {
      "owner": "agent",
      "pre": "tracking_initialized",
      "add": [
        "alert_fired"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "trackio_finish": {
      "owner": "agent",
      "pre": "tracking_initialized",
      "add": [
        "tracking_finished"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "trackio_list_alerts": {
      "owner": "agent",
      "pre": "tracking_initialized",
      "add": [
        "alerts_retrieved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "trackio_get_metric": {
      "owner": "agent",
      "pre": "metrics_logged",
      "add": [
        "metrics_retrieved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "trackio_init",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "training_loop",
        "body": [
          {
            "act": {
              "cap": "trackio_log",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "alert_condition": [
                  {
                    "act": {
                      "cap": "trackio_alert",
                      "by": "agent"
                    }
                  }
                ],
                "no_alert": []
              }
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "continue_training": [
                  {
                    "continue": "training_loop"
                  }
                ],
                "done": []
              }
            }
          }
        ]
      }
    },
    {
      "act": {
        "cap": "trackio_finish",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "trackio_list_alerts",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "trackio_get_metric",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "tracking_initialized",
      "metrics_logged",
      "tracking_finished",
      "metrics_retrieved"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
