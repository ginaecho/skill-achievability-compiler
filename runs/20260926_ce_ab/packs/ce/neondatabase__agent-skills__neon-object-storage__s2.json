{
  "name": "neon-object-storage",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_region_availability": {
      "owner": "agent",
      "pre": true,
      "add": [
        "region_confirmed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "declare_buckets": {
      "owner": "agent",
      "pre": "region_confirmed",
      "add": [
        "buckets_declared"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_config": {
      "owner": "agent",
      "pre": "buckets_declared",
      "add": [
        "buckets_provisioned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "pull_env_vars": {
      "owner": "agent",
      "pre": "buckets_provisioned",
      "add": [
        "env_vars_available"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_files_sdk": {
      "owner": "agent",
      "pre": true,
      "add": [
        "sdk_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "upload_object": {
      "owner": "agent",
      "pre": {
        "and": [
          "env_vars_available",
          "sdk_installed"
        ]
      },
      "add": [
        "object_uploaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "download_object": {
      "owner": "agent",
      "pre": "object_uploaded",
      "add": [
        "object_downloaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_region_availability",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "declare_buckets",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "deploy_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "pull_env_vars",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_files_sdk",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "upload_object",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "download_object",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "object_uploaded",
      "object_downloaded"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
