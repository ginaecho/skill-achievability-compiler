{
  "name": "hf-cloud-sagemaker-iam-preflight",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "validate_role": {
      "owner": "agent",
      "pre": true,
      "add": [
        "role_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "discover_roles": {
      "owner": "agent",
      "pre": true,
      "add": [
        "role_discovered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_role": {
      "owner": "agent",
      "pre": true,
      "add": [
        "role_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "role_provided": [
            {
              "act": {
                "cap": "validate_role",
                "by": "agent"
              }
            }
          ],
          "no_role_provided": [
            {
              "choice": {
                "by": "agent",
                "external": true,
                "branches": {
                  "found": [
                    {
                      "act": {
                        "cap": "discover_roles",
                        "by": "agent"
                      }
                    }
                  ],
                  "not_found": [
                    {
                      "choice": {
                        "by": "agent",
                        "external": true,
                        "branches": {
                          "can_create": [
                            {
                              "act": {
                                "cap": "create_role",
                                "by": "agent"
                              }
                            }
                          ],
                          "cannot_create": []
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "or": [
      "role_validated",
      "role_discovered",
      "role_created"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
