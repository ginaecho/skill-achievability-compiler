{
  "name": "diagnosing-superpowers",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "intake_questions": {
      "owner": "agent",
      "pre": true,
      "add": [
        "problem_statement_obtained"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "locate_sessions": {
      "owner": "agent",
      "pre": "problem_statement_obtained",
      "add": [
        "sessions_located"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_region": {
      "owner": "agent",
      "pre": "sessions_located",
      "add": [
        "region_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_analysis": {
      "owner": "agent",
      "pre": "region_read",
      "add": [
        "analysis_complete"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_report": {
      "owner": "agent",
      "pre": "analysis_complete",
      "add": [
        "report_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "search_github_issues": {
      "owner": "agent",
      "pre": "report_written",
      "add": [
        "issues_searched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_github_issue": {
      "owner": "agent",
      "pre": "issues_searched",
      "add": [
        "issue_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_bundle": {
      "owner": "agent",
      "pre": "report_written",
      "add": [
        "bundle_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "archive_bundle": {
      "owner": "agent",
      "pre": "bundle_built",
      "add": [
        "bundle_archived"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "problem_stated": [
            {
              "act": {
                "cap": "intake_questions",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "locate_sessions",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "read_region",
                "by": "agent"
              }
            },
            {
              "spawn": {
                "role": "analyst"
              }
            },
            {
              "act": {
                "cap": "run_analysis",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "write_report",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "wants_github_issue": [
                    {
                      "act": {
                        "cap": "search_github_issues",
                        "by": "agent"
                      }
                    },
                    {
                      "choice": {
                        "by": "user",
                        "observed": true,
                        "branches": {
                          "approve_issue": [
                            {
                              "act": {
                                "cap": "create_github_issue",
                                "by": "agent"
                              }
                            }
                          ],
                          "decline_issue": []
                        }
                      }
                    }
                  ],
                  "no_issue": []
                }
              }
            },
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "wants_export": [
                    {
                      "act": {
                        "cap": "build_bundle",
                        "by": "agent"
                      }
                    },
                    {
                      "choice": {
                        "by": "user",
                        "observed": true,
                        "branches": {
                          "approve_archive": [
                            {
                              "act": {
                                "cap": "archive_bundle",
                                "by": "agent"
                              }
                            }
                          ],
                          "decline_archive": []
                        }
                      }
                    }
                  ],
                  "no_export": []
                }
              }
            }
          ],
          "user_away": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "problem_statement_obtained",
      "report_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
