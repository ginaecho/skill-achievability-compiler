{
  "name": "cli-exercise",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "preflight_check": {
      "owner": "agent",
      "pre": true,
      "add": [
        "ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "classify_case": {
      "owner": "agent",
      "pre": "ready",
      "add": [
        "case_classified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "prepare_case": {
      "owner": "agent",
      "pre": "case_classified",
      "add": [
        "case_prepared"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "execute_case": {
      "owner": "agent",
      "pre": "case_prepared",
      "add": [
        "case_executed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_case": {
      "owner": "agent",
      "pre": "case_executed",
      "add": [
        "case_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "render_evidence": {
      "owner": "agent",
      "pre": "case_validated",
      "add": [
        "evidence_rendered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "preflight_check",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "classify_case",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "cases",
        "body": [
          {
            "act": {
              "cap": "prepare_case",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "execute_case",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "validate_case",
              "by": "agent"
            }
          },
          {
            "continue": "cases"
          }
        ]
      }
    },
    {
      "act": {
        "cap": "render_evidence",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "ready",
      "case_validated",
      "evidence_rendered"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
