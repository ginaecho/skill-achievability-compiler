{
  "name": "php-mcp-server-generator",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "gather_requirements": {
      "owner": "agent",
      "pre": true,
      "add": [
        "requirements_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scaffold_project": {
      "owner": "agent",
      "pre": "requirements_gathered",
      "add": [
        "project_scaffolded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_dependencies": {
      "owner": "agent",
      "pre": "project_scaffolded",
      "add": [
        "dependencies_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_tests": {
      "owner": "agent",
      "pre": "dependencies_installed",
      "add": [
        "tests_passing"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "gather_requirements",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scaffold_project",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_dependencies",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_tests",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "project_scaffolded",
      "dependencies_installed",
      "tests_passing"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
