{
  "name": "expo-module",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "scaffold_module": {
      "owner": "agent",
      "pre": true,
      "add": [
        "module_scaffolded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "add_platform_support": {
      "owner": "agent",
      "pre": "module_scaffolded",
      "add": [
        "platform_support_added"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_module": {
      "owner": "agent",
      "pre": "module_scaffolded",
      "add": [
        "module_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "scaffold_module",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "implement_module",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "add_platform": [
            {
              "act": {
                "cap": "add_platform_support",
                "by": "agent"
              }
            }
          ],
          "skip_platform": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "module_scaffolded",
      "module_implemented"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
