{
  "name": "aspire-project-v2-migration",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_codebase": {
      "owner": "agent",
      "pre": true,
      "add": [
        "inventory_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "present_migration_plan": {
      "owner": "agent",
      "pre": "inventory_done",
      "add": [
        "plan_presented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "apply_approved_edits": {
      "owner": "agent",
      "pre": "plan_presented",
      "add": [
        "edits_applied"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "clean_project_references": {
      "owner": "agent",
      "pre": "edits_applied",
      "add": [
        "references_cleaned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "restore_and_build": {
      "owner": "agent",
      "pre": "edits_applied",
      "add": [
        "build_passed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "start_apphost": {
      "owner": "agent",
      "pre": "build_passed",
      "add": [
        "apphost_started"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "wait_resource_ready": {
      "owner": "agent",
      "pre": "apphost_started",
      "add": [
        "resource_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_migration": {
      "owner": "agent",
      "pre": "resource_ready",
      "add": [
        "validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "report_results": {
      "owner": "agent",
      "pre": "validated",
      "add": [
        "reported"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_codebase",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "eligible": [
            {
              "act": {
                "cap": "present_migration_plan",
                "by": "agent"
              }
            },
            {
              "msg": {
                "from": "agent",
                "to": "user",
                "label": "plan_proposal"
              }
            },
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "approve": [
                    {
                      "act": {
                        "cap": "apply_approved_edits",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "clean_project_references",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "restore_and_build",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "start_apphost",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "wait_resource_ready",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "validate_migration",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "report_results",
                        "by": "agent"
                      }
                    }
                  ],
                  "reject": []
                }
              }
            }
          ],
          "not_eligible": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "edits_applied",
      "validated",
      "reported"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
