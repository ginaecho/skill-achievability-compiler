{
  "name": "graph-evolution",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "install_trailmark": {
      "owner": "agent",
      "pre": true,
      "add": [
        "trailmark_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_worktrees": {
      "owner": "agent",
      "pre": true,
      "add": [
        "snapshots_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_and_export": {
      "owner": "agent",
      "pre": {
        "and": [
          "trailmark_installed",
          "snapshots_created"
        ]
      },
      "add": [
        "graphs_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "compute_native_diff": {
      "owner": "agent",
      "pre": "graphs_built",
      "add": [
        "native_diff_computed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "compute_subgraph_diff": {
      "owner": "agent",
      "pre": "graphs_built",
      "add": [
        "subgraph_diff_computed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_report": {
      "owner": "agent",
      "pre": {
        "and": [
          "native_diff_computed",
          "subgraph_diff_computed"
        ]
      },
      "add": [
        "report_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "cleanup_worktrees": {
      "owner": "agent",
      "pre": "snapshots_created",
      "add": [
        "worktrees_cleaned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_trailmark",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_worktrees",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_and_export",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "compute_native_diff",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "compute_subgraph_diff",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_report",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "cleanup_worktrees",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "report_written",
      "worktrees_cleaned"
    ]
