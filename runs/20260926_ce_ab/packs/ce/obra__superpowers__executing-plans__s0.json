{
  "name": "executing-plans",
  "roles": [
    "implementer",
    "reviewer"
  ],
  "capabilities": {
    "setup_workspace": {
      "owner": "implementer",
      "pre": true,
      "add": [
        "workspace_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_plan_spec": {
      "owner": "implementer",
      "pre": "workspace_ready",
      "add": [
        "plan_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "preflight_scan": {
      "owner": "implementer",
      "pre": "plan_read",
      "add": [
        "preflight_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "task_start": {
      "owner": "implementer",
      "pre": "preflight_done",
      "add": [
        "task_briefed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "work_steps": {
      "owner": "implementer",
      "pre": "task_briefed",
      "add": [
        "steps_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "commit_task": {
      "owner": "implementer",
      "pre": "steps_done",
      "add": [
        "task_committed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "task_done": {
      "owner": "implementer",
      "pre": "task_committed",
      "add": [
        "task_complete"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "final_review": {
      "owner": "reviewer",
      "pre": "task_complete",
      "add": [
        "review_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "self_review": {
      "owner": "implementer",
      "pre": "task_complete",
      "add": [
        "review_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fix_pass": {
      "owner": "implementer",
      "pre": "review_done",
      "add": [
        "fixes_applied"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "delete_workspace": {
      "owner": "implementer",
      "pre": "fixes_applied",
      "add": [
        "workspace_deleted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "finish_branch": {
      "owner": "implementer",
      "pre": "workspace_deleted",
      "add": [
        "branch_finished"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "setup_workspace",
        "by": "implementer"
      }
    },
    {
      "act": {
        "cap": "read_plan_spec",
        "by": "implementer"
      }
    },
    {
      "act": {
        "cap": "preflight_scan",
        "by": "implementer"
      }
    },
    {
      "rec": {
        "name": "task_loop",
        "body": [
          {
            "act": {
              "cap": "task_start",
              "by": "implementer"
            }
          },
          {
            "act": {
              "cap": "work_steps",
              "by": "implementer"
            }
          },
          {
            "act": {
              "cap": "commit_task",
              "by": "implementer"
            }
          },
          {
            "act": {
              "cap": "task_done",
              "by": "implementer"
            }
          },
          {
            "choice": {
              "by": "implementer",
              "observed": true,
              "branches": {
                "more_tasks": [
                  {
                    "continue": "task_loop"
                  }
                ],
                "no_more_tasks": []
              }
            }
          }
        ]
      }
    },
    {
      "choice": {
        "by": "implementer",
        "external": true,
        "branches": {
          "has_subagent": [
            {
              "spawn": {
                "role": "reviewer"
              }
            },
            {
              "act": {
                "cap": "final_review",
                "by": "reviewer"
              }
            }
          ],
          "no_subagent": [
            {
              "act": {
                "cap": "self_review",
                "by": "implementer"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "fix_pass",
        "by": "implementer"
      }
    },
    {
      "act": {
        "cap": "delete_workspace",
        "by": "implementer"
      }
    },
    {
      "act": {
        "cap": "finish_branch",
        "by": "implementer"
      }
    }
  ],
  "goal": {
    "and": [
      "branch_finished",
      "review_done",
      "fixes_applied"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
