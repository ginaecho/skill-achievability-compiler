{
  "name": "vhs-demo",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "preflight_check": {
      "owner": "agent",
      "pre": true,
      "add": [
        "toolchain_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_workspace": {
      "owner": "agent",
      "pre": true,
      "add": [
        "workspace_isolated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "author_tape": {
      "owner": "agent",
      "pre": "workspace_isolated",
      "add": [
        "tape_authored"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "render_tape": {
      "owner": "agent",
      "pre": {
        "and": [
          "tape_authored",
          "toolchain_verified"
        ]
      },
      "add": [
        "gif_rendered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "inspect_gif": {
      "owner": "agent",
      "pre": "gif_rendered",
      "add": [
        "gif_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "report_evidence": {
      "owner": "agent",
      "pre": "gif_inspected",
      "add": [
        "evidence_reported"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "preflight_check",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "toolchain_missing": [],
          "toolchain_ok": [
            {
              "act": {
                "cap": "create_workspace",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "author_tape",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "render_tape",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "inspect_gif",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "report_evidence",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "evidence_reported",
      "gif_inspected",
      "gif_rendered"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
