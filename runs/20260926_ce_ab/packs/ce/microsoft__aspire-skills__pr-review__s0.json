{
  "name": "pr-review",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "identify_pr": {
      "owner": "agent",
      "pre": true,
      "add": [
        "pr_identified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ensure_branch_available": {
      "owner": "agent",
      "pre": "pr_identified",
      "add": [
        "branch_available"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "gather_context": {
      "owner": "agent",
      "pre": "branch_available",
      "add": [
        "context_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "categorize_changes": {
      "owner": "agent",
      "pre": "context_gathered",
      "add": [
        "changes_categorized"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "review_code": {
      "owner": "agent",
      "pre": "changes_categorized",
      "add": [
        "findings_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "present_findings": {
      "owner": "agent",
      "pre": "findings_ready",
      "add": [
        "findings_presented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "post_review": {
      "owner": "agent",
      "pre": "findings_presented",
      "add": [
        "review_posted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "confirm_none_posted": {
      "owner": "agent",
      "pre": "findings_presented",
      "add": [
        "none_selected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "identify_pr",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "ensure_branch_available",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "gather_context",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "categorize_changes",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "review_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "present_findings",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "post_selected": [
            {
              "act": {
                "cap": "post_review",
                "by": "agent"
              }
            }
          ],
          "post_none": [
            {
              "act": {
                "cap": "confirm_none_posted",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "findings_presented",
      {
        "or": [
          "review_posted",
          "none_selected"
        ]
      }
    ]
  },
  "init_true": [],
  "init_constraints": []
}
