{
  "name": "theme-factory",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "show_theme_showcase": {
      "owner": "agent",
      "pre": true,
      "add": [
        "showcase_shown"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_theme_choice": {
      "owner": "agent",
      "pre": "showcase_shown",
      "add": [
        "choice_asked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "select_preset_theme": {
      "owner": "agent",
      "pre": "choice_asked",
      "add": [
        "theme_selected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_custom_theme": {
      "owner": "agent",
      "pre": "choice_asked",
      "add": [
        "custom_theme_shown"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "confirm_custom_theme": {
      "owner": "agent",
      "pre": "custom_theme_shown",
      "add": [
        "theme_selected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_theme_file": {
      "owner": "agent",
      "pre": "theme_selected",
      "add": [
        "theme_loaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "apply_theme": {
      "owner": "agent",
      "pre": "theme_loaded",
      "add": [
        "theme_applied"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "show_theme_showcase",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "ask_theme_choice",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "preset": [
            {
              "act": {
                "cap": "select_preset_theme",
                "by": "agent"
              }
            }
          ],
          "custom": [
            {
              "act": {
                "cap": "create_custom_theme",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "approved": [
                    {
                      "act": {
                        "cap": "confirm_custom_theme",
                        "by": "agent"
                      }
                    }
                  ],
                  "rejected": []
                }
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "read_theme_file",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "apply_theme",
        "by": "agent"
      }
    }
  ],
  "goal": "theme_applied",
  "init_true": [],
  "init_constraints": []
}
