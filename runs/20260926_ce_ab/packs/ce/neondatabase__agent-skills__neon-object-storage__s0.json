{
  "name": "neon-object-storage",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_region_availability": {
      "owner": "agent",
      "pre": true,
      "add": [
        "region_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "declare_buckets": {
      "owner": "agent",
      "pre": "region_checked",
      "add": [
        "buckets_declared"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "provision_buckets": {
      "owner": "agent",
      "pre": "buckets_declared",
      "add": [
        "buckets_provisioned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "pull_env_vars": {
      "owner": "agent",
      "pre": "buckets_provisioned",
      "add": [
        "env_vars_pulled"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_sdk": {
      "owner": "agent",
      "pre": true,
      "add": [
        "sdk_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_storage_code": {
      "owner": "agent",
      "pre": {
        "and": [
          "env_vars_pulled",
          "sdk_installed"
        ]
      },
      "add": [
        "code_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_region_availability",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "declare_buckets",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "provision_buckets",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "pull_env_vars",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_sdk",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_storage_code",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "region_checked",
      "buckets_provisioned",
      "env_vars_pulled",
      "code_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
