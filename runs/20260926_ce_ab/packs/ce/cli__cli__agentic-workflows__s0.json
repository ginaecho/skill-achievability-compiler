{
  "name": "agentic-workflows-router",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "identify_task_type": {
      "owner": "agent",
      "pre": true,
      "add": [
        "task_identified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "load_repo_overlay": {
      "owner": "agent",
      "pre": "overlay_exists",
      "add": [
        "overlay_loaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "identify_task_type",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "load_workflow_prompt",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "overlay_present": [
            {
              "act": {
                "cap": "load_repo_overlay",
                "by": "agent"
              }
            }
          ],
          "overlay_absent": []
        }
      }
    },
    {
      "act": {
        "cap": "follow_workflow_prompt",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "workflow_loaded",
      "workflow_followed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
