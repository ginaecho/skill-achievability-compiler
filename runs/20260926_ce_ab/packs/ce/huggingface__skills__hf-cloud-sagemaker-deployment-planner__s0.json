{
  "name": "hf-cloud-sagemaker-deployment-planner",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_discovery_questions": {
      "owner": "agent",
      "pre": true,
      "add": [
        "discovery_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_quota": {
      "owner": "agent",
      "pre": "discovery_done",
      "add": [
        "quota_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "recommend_pathway": {
      "owner": "agent",
      "pre": "quota_checked",
      "add": [
        "pathway_recommended"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "confirm_pathway": {
      "owner": "agent",
      "pre": "pathway_recommended",
      "add": [
        "pathway_confirmed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "ask_discovery_questions",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_quota",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "recommend_pathway",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "confirm": [
            {
              "act": {
                "cap": "confirm_pathway",
                "by": "agent"
              }
            }
          ],
          "decline": []
        }
      }
    }
  ],
  "goal": "pathway_confirmed",
  "init_true": [],
  "init_constraints": []
}
