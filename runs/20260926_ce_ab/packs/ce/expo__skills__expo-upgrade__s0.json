{
  "name": "expo-upgrade",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "upgrade_expo": {
      "owner": "agent",
      "pre": true,
      "add": [
        "expo_upgraded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_doctor": {
      "owner": "agent",
      "pre": "expo_upgraded",
      "add": [
        "doctor_run"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "clear_caches": {
      "owner": "agent",
      "pre": "doctor_run",
      "add": [
        "caches_cleared"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "prebuild_native": {
      "owner": "agent",
      "pre": "caches_cleared",
      "add": [
        "prebuilt"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "review_breaking_changes": {
      "owner": "agent",
      "pre": "expo_upgraded",
      "add": [
        "breaking_changes_reviewed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "update_housekeeping": {
      "owner": "agent",
      "pre": "breaking_changes_reviewed",
      "add": [
        "housekeeping_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "upgrade_expo",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_doctor",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "clear_caches",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "native_changes_needed": [
            {
              "act": {
                "cap": "prebuild_native",
                "by": "agent"
              }
            }
          ],
          "no_native_changes": []
        }
      }
    },
    {
      "act": {
        "cap": "review_breaking_changes",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "update_housekeeping",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "expo_upgraded",
      "doctor_run",
      "caches_cleared",
      "breaking_changes_reviewed",
      "housekeeping_done"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
