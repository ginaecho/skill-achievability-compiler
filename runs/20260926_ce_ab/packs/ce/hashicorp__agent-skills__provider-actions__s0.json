{
  "name": "provider-actions",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "setup_action_scaffolding": {
      "owner": "agent",
      "pre": true,
      "add": [
        "scaffolding_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "define_action_schema": {
      "owner": "agent",
      "pre": "scaffolding_done",
      "add": [
        "schema_defined"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_invoke": {
      "owner": "agent",
      "pre": "schema_defined",
      "add": [
        "invoke_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_acceptance_tests": {
      "owner": "agent",
      "pre": "invoke_implemented",
      "add": [
        "tests_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_tests": {
      "owner": "agent",
      "pre": "tests_written",
      "add": [
        "tests_passed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_docs": {
      "owner": "agent",
      "pre": "tests_passed",
      "add": [
        "docs_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "setup_action_scaffolding",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "define_action_schema",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "implement_invoke",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_acceptance_tests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_tests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_docs",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "invoke_implemented",
      "tests_passed",
      "docs_generated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
