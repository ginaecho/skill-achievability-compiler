{
  "name": "gh-fix-ci",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "gh_auth_status": {
      "owner": "agent",
      "pre": true,
      "add": [
        "auth_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "resolve_pr": {
      "owner": "agent",
      "pre": "auth_verified",
      "add": [
        "pr_resolved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "inspect_pr_checks": {
      "owner": "agent",
      "pre": "pr_resolved",
      "add": [
        "checks_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "summarize_failures": {
      "owner": "agent",
      "pre": "checks_inspected",
      "add": [
        "failures_summarized"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "draft_plan": {
      "owner": "agent",
      "pre": "failures_summarized",
      "add": [
        "plan_drafted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_fix": {
      "owner": "agent",
      "pre": "plan_drafted",
      "add": [
        "fix_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "recheck_status": {
      "owner": "agent",
      "pre": "fix_implemented",
      "add": [
        "status_rechecked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "gh_auth_status",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "resolve_pr",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "inspect_pr_checks",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "summarize_failures",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "draft_plan",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "approve": [
            {
              "act": {
                "cap": "implement_fix",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "recheck_status",
                "by": "agent"
              }
            }
          ],
          "reject": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "fix_implemented",
      "status_rechecked"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
