{
  "name": "speech",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "install_deps": {
      "owner": "agent",
      "pre": true,
      "add": [
        "deps_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_tts_cli": {
      "owner": "agent",
      "pre": {
        "and": [
          "deps_installed",
          "api_key_set"
        ]
      },
      "add": [
        "audio_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_output": {
      "owner": "agent",
      "pre": "audio_generated",
      "add": [
        "output_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_deps",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_tts_cli",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_output",
        "by": "agent"
      }
    }
  ],
  "goal": "output_validated",
  "init_true": [
    "api_key_set"
  ],
  "init_constraints": []
}
