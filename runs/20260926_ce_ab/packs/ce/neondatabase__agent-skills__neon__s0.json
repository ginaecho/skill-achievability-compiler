{
  "name": "neon",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_repo": {
      "owner": "agent",
      "pre": true,
      "add": [
        "repo_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_credentials": {
      "owner": "agent",
      "pre": "repo_inspected",
      "add": [
        "credentials_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "provision_neon": {
      "owner": "agent",
      "pre": "credentials_checked",
      "add": [
        "neon_provisioned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_app_flow": {
      "owner": "agent",
      "pre": "neon_provisioned",
      "add": [
        "app_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_repo",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_credentials",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "credentials_available": [
            {
              "act": {
                "cap": "provision_neon",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "verify_app_flow",
                "by": "agent"
              }
            }
          ],
          "credentials_missing": [
            {
              "msg": {
                "from": "agent",
                "to": "user",
                "label": "sign_in_request"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "repo_inspected",
      "neon_provisioned",
      "app_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
