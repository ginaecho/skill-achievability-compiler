{
  "name": "doc-coauthoring",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "offer_workflow": {
      "owner": "agent",
      "pre": true,
      "add": [
        "workflow_offered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "gather_context": {
      "owner": "agent",
      "pre": "workflow_offered",
      "add": [
        "context_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_scaffold": {
      "owner": "agent",
      "pre": "context_gathered",
      "add": [
        "scaffold_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "draft_section": {
      "owner": "agent",
      "pre": "scaffold_created",
      "add": [
        "sections_drafted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "refine_section": {
      "owner": "agent",
      "pre": "sections_drafted",
      "add": [
        "sections_refined"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "test_with_subagent": {
      "owner": "agent",
      "pre": "sections_refined",
      "add": [
        "reader_tested"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "instruct_manual_test": {
      "owner": "agent",
      "pre": "sections_refined",
      "add": [
        "reader_tested"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "final_review": {
      "owner": "agent",
      "pre": "reader_tested",
      "add": [
        "doc_complete"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "offer_workflow",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "accept": [
            {
              "act": {
                "cap": "gather_context",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "create_scaffold",
                "by": "agent"
              }
            },
            {
              "rec": {
                "name": "sections",
                "body": [
                  {
                    "act": {
                      "cap": "draft_section",
                      "by": "agent"
                    }
                  },
                  {
                    "act": {
                      "cap": "refine_section",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "sections"
                  }
                ]
              }
            },
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "subagent_available": [
                    {
                      "spawn": {
                        "role": "reader"
                      }
                    },
                    {
                      "act": {
                        "cap": "test_with_subagent",
                        "by": "agent"
                      }
                    }
                  ],
                  "manual_test": [
                    {
                      "act": {
                        "cap": "instruct_manual_test",
                        "by": "agent"
                      }
                    }
                  ]
                }
              }
            },
            {
              "act": {
                "cap": "final_review",
                "by": "agent"
              }
            }
          ],
          "decline": []
        }
      }
    }
  ],
  "goal": "doc_complete",
  "init_true": [],
  "init_constraints": []
}
