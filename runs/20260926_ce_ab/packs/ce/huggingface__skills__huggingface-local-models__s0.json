{
  "name": "huggingface-local-models",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "search_hub": {
      "owner": "agent",
      "pre": true,
      "add": [
        "repo_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "confirm_gguf_files": {
      "owner": "agent",
      "pre": "repo_found",
      "add": [
        "gguf_confirmed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "convert_to_gguf": {
      "owner": "agent",
      "pre": "repo_found",
      "add": [
        "gguf_confirmed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "launch_model_server": {
      "owner": "agent",
      "pre": "gguf_confirmed",
      "add": [
        "model_running"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "search_hub",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "gguf_available": [
            {
              "act": {
                "cap": "confirm_gguf_files",
                "by": "agent"
              }
            }
          ],
          "gguf_missing": [
            {
              "act": {
                "cap": "convert_to_gguf",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "launch_model_server",
        "by": "agent"
      }
    }
  ],
  "goal": "model_running",
  "init_true": [],
  "init_constraints": []
}
