{
  "name": "eas-hosting",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "author_api_route": {
      "owner": "agent",
      "pre": true,
      "add": [
        "api_route_authored"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_eas_cli": {
      "owner": "agent",
      "pre": true,
      "add": [
        "eas_cli_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "eas_login": {
      "owner": "agent",
      "pre": "eas_cli_installed",
      "add": [
        "eas_authenticated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "export_web_bundle": {
      "owner": "agent",
      "pre": true,
      "add": [
        "web_bundle_exported"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "eas_deploy_preview": {
      "owner": "agent",
      "pre": {
        "and": [
          "web_bundle_exported",
          "eas_authenticated"
        ]
      },
      "add": [
        "preview_deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "eas_deploy_prod": {
      "owner": "agent",
      "pre": {
        "and": [
          "web_bundle_exported",
          "eas_authenticated"
        ]
      },
      "add": [
        "production_deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_env_secret": {
      "owner": "agent",
      "pre": true,
      "add": [
        "env_secret_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "author_api_route",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_eas_cli",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "eas_login",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "export_web_bundle",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "preview": [
            {
              "act": {
                "cap": "eas_deploy_preview",
                "by": "agent"
              }
            }
          ],
          "production": [
            {
              "act": {
                "cap": "create_env_secret",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "eas_deploy_prod",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "web_bundle_exported",
      {
        "or": [
          "preview_deployed",
          "production_deployed"
        ]
      }
    ]
  },
  "init_true": [],
  "init_constraints": []
}
