{
  "name": "aspire",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "detect_apphost": {
      "owner": "agent",
      "pre": true,
      "add": [
        "apphost_detected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "route_to_subskill": {
      "owner": "agent",
      "pre": "apphost_detected",
      "add": [
        "routed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "start_apphost": {
      "owner": "agent",
      "pre": "routed",
      "add": [
        "app_running"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "wait_for_resource": {
      "owner": "agent",
      "pre": "app_running",
      "add": [
        "resource_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "inspect_state": {
      "owner": "agent",
      "pre": "resource_ready",
      "add": [
        "state_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "detect_apphost",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "no_apphost": [],
          "apphost_present": [
            {
              "act": {
                "cap": "route_to_subskill",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "start_apphost",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "wait_for_resource",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "inspect_state",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": "state_inspected",
  "init_true": [],
  "init_constraints": []
}
