{
  "name": "qdrant-scaling-qps",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "configure_segments": {
      "owner": "agent",
      "pre": true,
      "add": [],
      "del": [],
      "assigns": {
        "segment_number": 2
      },
      "nondet": {}
    },
    "enable_quantization": {
      "owner": "agent",
      "pre": true,
      "add": [
        "quantization_enabled"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "use_batch_search": {
      "owner": "agent",
      "pre": true,
      "add": [
        "batch_search_used"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_update_throttling": {
      "owner": "agent",
      "pre": true,
      "add": [
        "update_throttling_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scale_replicas": {
      "owner": "agent",
      "pre": "cpu_saturated",
      "add": [],
      "del": [],
      "assigns": {
        "replication_factor": 2
      },
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "configure_segments",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "enable_quantization",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "use_batch_search",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_update_throttling",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "saturated": [
            {
              "act": {
                "cap": "scale_replicas",
                "by": "agent"
              }
            }
          ],
          "not_saturated": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      {
        "cmp": [
          "segment_number",
          "==",
          2
        ]
      },
      "quantization_enabled",
      "batch_search_used",
      "update_throttling_configured"
    ]
  },
  "init_true": [],
  "init_constraints": [
    {
      "cmp": [
        "segment_number",
        "==",
        1
      ]
    }
  ]
}
