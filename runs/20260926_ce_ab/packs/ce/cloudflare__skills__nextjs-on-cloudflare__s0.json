{
  "name": "nextjs-on-cloudflare",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "install_vinext_skills": {
      "owner": "agent",
      "pre": true,
      "add": [
        "vinext_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_vinext_app": {
      "owner": "agent",
      "pre": "vinext_installed",
      "add": [
        "new_project_setup"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_vinext_skills",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "new_project": [
            {
              "act": {
                "cap": "create_vinext_app",
                "by": "agent"
              }
            }
          ],
          "existing_project": [
            {
              "act": {
                "cap": "migrate_to_vinext",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "or": [
      "new_project_setup",
      "existing_project_migrated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
