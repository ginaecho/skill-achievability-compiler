{
  "name": "gh-cli-code-review",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "read_repo_contract": {
      "owner": "agent",
      "pre": "workspace_readable",
      "add": [
        "contract_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deliver_review": {
      "owner": "agent",
      "pre": {
        "and": [
          "diff_read",
          "contract_read"
        ]
      },
      "add": [
        "review_delivered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_go_tests": {
      "owner": "agent",
      "pre": "workspace_readable",
      "add": [
        "tests_observed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_repo_contract",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_diff",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "run_tests": [
            {
              "act": {
                "cap": "run_go_tests",
                "by": "agent"
              }
            }
          ],
          "skip_tests": []
        }
      }
    },
    {
      "act": {
        "cap": "deliver_review",
        "by": "agent"
      }
    }
  ],
  "goal": "review_delivered",
  "init_true": [
    "workspace_readable"
  ],
  "init_constraints": []
}
