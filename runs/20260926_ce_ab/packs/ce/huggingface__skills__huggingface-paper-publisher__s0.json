{
  "name": "huggingface-paper-publisher",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "create_research_article": {
      "owner": "agent",
      "pre": true,
      "add": [
        "article_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "index_paper": {
      "owner": "agent",
      "pre": "arxiv_id_available",
      "add": [
        "paper_indexed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "link_paper_to_repo": {
      "owner": "agent",
      "pre": "paper_indexed",
      "add": [
        "paper_linked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "claim_authorship": {
      "owner": "agent",
      "pre": "paper_indexed",
      "add": [
        "authorship_claimed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "toggle_visibility": {
      "owner": "agent",
      "pre": "authorship_claimed",
      "add": [
        "visibility_set"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "create_research_article",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "arxiv_id_received": [
            {
              "act": {
                "cap": "index_paper",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "link_paper_to_repo",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "claim_authorship",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "agent",
                "observed": true,
                "branches": {
                  "toggle": [
                    {
                      "act": {
                        "cap": "toggle_visibility",
                        "by": "agent"
                      }
                    }
                  ],
                  "skip": []
                }
              }
            }
          ],
          "no_arxiv_id": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "article_created",
      "paper_linked",
      "authorship_claimed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
