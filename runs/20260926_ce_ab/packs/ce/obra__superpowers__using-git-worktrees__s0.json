{
  "name": "using-git-worktrees",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "detect_isolation": {
      "owner": "agent",
      "pre": true,
      "add": [
        "isolation_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "acknowledge_existing_isolation": {
      "owner": "agent",
      "pre": "isolation_checked",
      "add": [
        "workspace_isolated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_worktree_native": {
      "owner": "agent",
      "pre": "isolation_checked",
      "add": [
        "workspace_isolated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_worktree_git": {
      "owner": "agent",
      "pre": "isolation_checked",
      "add": [
        "workspace_isolated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "project_setup": {
      "owner": "agent",
      "pre": "workspace_isolated",
      "add": [
        "dependencies_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_baseline_tests": {
      "owner": "agent",
      "pre": "dependencies_installed",
      "add": [
        "baseline_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "detect_isolation",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "already_isolated": [
            {
              "act": {
                "cap": "acknowledge_existing_isolation",
                "by": "agent"
              }
            }
          ],
          "needs_isolation": [
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "consent_given": [
                    {
                      "choice": {
                        "by": "agent",
                        "external": true,
                        "branches": {
                          "native_tool_available": [
                            {
                              "act": {
                                "cap": "create_worktree_native",
                                "by": "agent"
                              }
                            }
                          ],
                          "native_tool_unavailable": [
                            {
                              "act": {
                                "cap": "create_worktree_git",
                                "by": "agent"
                              }
                            }
                          ]
                        }
                      }
                    }
                  ],
                  "consent_declined": []
                }
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "project_setup",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_baseline_tests",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "workspace_isolated",
      "baseline_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
