{
  "name": "graph-evolution",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "install_trailmark": {
      "owner": "agent",
      "pre": true,
      "add": [
        "trailmark_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_worktrees": {
      "owner": "agent",
      "pre": true,
      "add": [
        "worktrees_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_graphs": {
      "owner": "agent",
      "pre": {
        "and": [
          "trailmark_installed",
          "worktrees_created"
        ]
      },
      "add": [
        "graphs_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "compute_diff": {
      "owner": "agent",
      "pre": "graphs_built",
      "add": [
        "diff_computed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_report": {
      "owner": "agent",
      "pre": "diff_computed",
      "add": [
        "report_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "remove_worktrees": {
      "owner": "agent",
      "pre": "report_written",
      "add": [
        "worktrees_removed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_trailmark",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_worktrees",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_graphs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "compute_diff",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_report",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "remove_worktrees",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "report_written",
      "worktrees_removed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
