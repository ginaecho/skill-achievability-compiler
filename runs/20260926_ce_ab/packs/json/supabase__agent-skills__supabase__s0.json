{
  "name": "supabase",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "fetch_changelog": {
      "owner": "agent",
      "pre": true,
      "add": [
        "changelog_checked"
      ]
    },
    "fetch_docs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "docs_consulted"
      ]
    },
    "edit_schema_declarative": {
      "owner": "agent",
      "pre": {
        "and": [
          "changelog_checked",
          "docs_consulted"
        ]
      },
      "add": [
        "schema_edited"
      ]
    },
    "run_sql_imperative": {
      "owner": "agent",
      "pre": {
        "and": [
          "changelog_checked",
          "docs_consulted"
        ]
      },
      "add": [
        "schema_edited"
      ]
    },
    "run_advisors": {
      "owner": "agent",
      "pre": "schema_edited",
      "add": [
        "advisors_checked"
      ]
    },
    "review_security_checklist": {
      "owner": "agent",
      "pre": "schema_edited",
      "add": [
        "security_reviewed"
      ]
    },
    "generate_migration": {
      "owner": "agent",
      "pre": {
        "and": [
          "advisors_checked",
          "security_reviewed"
        ]
      },
      "add": [
        "migration_generated"
      ]
    },
    "verify_migration": {
      "owner": "agent",
      "pre": "migration_generated",
      "add": [
        "migration_verified"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "fetch_changelog",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_docs",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "declarative": [
            {
              "act": {
                "cap": "edit_schema_declarative",
                "by": "agent"
              }
            }
          ],
          "imperative": [
            {
              "act": {
                "cap": "run_sql_imperative",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "run_advisors",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "review_security_checklist",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_migration",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_migration",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "migration_generated",
      "migration_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
