{
  "name": "provider-actions",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "scaffold_first_action": {
      "owner": "agent",
      "pre": true,
      "add": [
        "scaffolding_done"
      ]
    },
    "write_action_schema": {
      "owner": "agent",
      "pre": "scaffolding_done",
      "add": [
        "schema_written"
      ]
    },
    "implement_invoke": {
      "owner": "agent",
      "pre": "schema_written",
      "add": [
        "invoke_implemented"
      ]
    },
    "implement_polling": {
      "owner": "agent",
      "pre": "invoke_implemented",
      "add": [
        "polling_implemented"
      ]
    },
    "write_tests": {
      "owner": "agent",
      "pre": "invoke_implemented",
      "add": [
        "tests_written"
      ]
    },
    "run_tests": {
      "owner": "agent",
      "pre": "tests_written",
      "add": [
        "tests_passed"
      ]
    },
    "generate_docs": {
      "owner": "agent",
      "pre": "schema_written",
      "add": [
        "docs_generated"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "scaffold_first_action",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_action_schema",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "implement_invoke",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "implement_polling",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_tests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_tests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_docs",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "invoke_implemented",
      "tests_passed",
      "docs_generated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
