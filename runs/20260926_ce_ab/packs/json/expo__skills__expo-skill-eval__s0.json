{
  "name": "expo-skill-eval",
  "roles": [
    "agent",
    "grader"
  ],
  "capabilities": {
    "clarify_scope": {
      "owner": "agent",
      "add": [
        "scope_confirmed"
      ]
    },
    "write_eval_cases": {
      "owner": "agent",
      "pre": "scope_confirmed",
      "add": [
        "eval_cases_written"
      ]
    },
    "run_trigger_eval": {
      "owner": "agent",
      "pre": "eval_cases_written",
      "add": [
        "trigger_eval_done"
      ]
    },
    "build_fixtures": {
      "owner": "agent",
      "pre": "eval_cases_written",
      "add": [
        "fixtures_built"
      ]
    },
    "run_executors": {
      "owner": "agent",
      "pre": "fixtures_built",
      "add": [
        "executors_run"
      ]
    },
    "run_static_gate": {
      "owner": "agent",
      "pre": "executors_run",
      "add": [
        "static_checked"
      ]
    },
    "run_snapshots": {
      "owner": "agent",
      "pre": "static_checked",
      "add": [
        "screenshots_captured"
      ]
    },
    "grade_eval": {
      "owner": "grader",
      "pre": "screenshots_captured",
      "add": [
        "grading_done"
      ]
    },
    "generate_viewer": {
      "owner": "agent",
      "pre": "grading_done",
      "add": [
        "viewer_generated"
      ]
    },
    "publish_artifact": {
      "owner": "agent",
      "pre": "viewer_generated",
      "add": [
        "artifact_published"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "clarify_scope",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_eval_cases",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_trigger_eval",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_fixtures",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_executors",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_static_gate",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_snapshots",
        "by": "agent"
      }
    },
    {
      "spawn": {
        "role": "grader"
      }
    },
    {
      "act": {
        "cap": "grade_eval",
        "by": "grader"
      }
    },
    {
      "act": {
        "cap": "generate_viewer",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "publish_artifact",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "viewer_generated",
      "grading_done"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
