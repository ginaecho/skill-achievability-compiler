{
  "name": "neon-object-storage",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_region_availability": {
      "owner": "agent",
      "add": [
        "availability_checked"
      ]
    },
    "declare_buckets_config": {
      "owner": "agent",
      "pre": "availability_checked",
      "add": [
        "buckets_declared"
      ]
    },
    "apply_config": {
      "owner": "agent",
      "pre": "buckets_declared",
      "add": [
        "buckets_provisioned"
      ]
    },
    "pull_env_vars": {
      "owner": "agent",
      "pre": "buckets_provisioned",
      "add": [
        "env_vars_pulled"
      ]
    },
    "install_sdk": {
      "owner": "agent",
      "pre": "buckets_provisioned",
      "add": [
        "sdk_installed"
      ]
    },
    "implement_upload_download": {
      "owner": "agent",
      "pre": {
        "and": [
          "env_vars_pulled",
          "sdk_installed"
        ]
      },
      "add": [
        "upload_download_implemented"
      ]
    },
    "pair_with_db": {
      "owner": "agent",
      "pre": "upload_download_implemented",
      "add": [
        "db_paired"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_region_availability",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "region_supported": [
            {
              "act": {
                "cap": "declare_buckets_config",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "apply_config",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "pull_env_vars",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "install_sdk",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "implement_upload_download",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "pair_with_db",
                "by": "agent"
              }
            }
          ],
          "region_unsupported": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "buckets_provisioned",
      "upload_download_implemented"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
