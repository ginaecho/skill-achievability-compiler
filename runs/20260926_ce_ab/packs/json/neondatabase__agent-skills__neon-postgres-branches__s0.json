{
  "name": "neon-postgres-branches",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "create_normal_branch": {
      "owner": "agent",
      "add": [
        "branch_created"
      ]
    },
    "create_schema_only_branch": {
      "owner": "agent",
      "add": [
        "branch_created"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "normal": [
            {
              "act": {
                "cap": "create_normal_branch",
                "by": "agent"
              }
            }
          ],
          "schema_only": [
            {
              "act": {
                "cap": "create_schema_only_branch",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": "branch_created",
  "init_true": [],
  "init_constraints": []
}
