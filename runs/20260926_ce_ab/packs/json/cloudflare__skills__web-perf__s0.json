{
  "name": "web-perf",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "navigate_page": {
      "owner": "agent",
      "pre": true,
      "add": [
        "page_loaded"
      ]
    },
    "list_network_requests": {
      "owner": "agent",
      "pre": "page_loaded",
      "add": [
        "network_analyzed"
      ]
    },
    "take_snapshot": {
      "owner": "agent",
      "pre": "page_loaded",
      "add": [
        "a11y_snapshotted"
      ]
    },
    "codebase_analysis": {
      "owner": "agent",
      "pre": true,
      "add": [
        "codebase_analyzed"
      ]
    },
    "produce_report": {
      "owner": "agent",
      "pre": {
        "and": [
          "network_analyzed",
          "a11y_snapshotted",
          "codebase_analyzed"
        ]
      },
      "add": [
        "report_produced"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "navigate_page",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "start_trace",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "analyze_insight",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "list_network_requests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "take_snapshot",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "codebase_analysis",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "produce_report",
        "by": "agent"
      }
    }
  ],
  "goal": "report_produced",
  "init_true": [],
  "init_constraints": []
}
