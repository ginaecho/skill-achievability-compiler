{
  "name": "skill-scanner",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "discover_skill": {
      "owner": "agent",
      "add": [
        "target_identified"
      ]
    },
    "run_scanner": {
      "owner": "agent",
      "pre": "target_identified",
      "add": [
        "scan_run"
      ]
    },
    "validate_frontmatter": {
      "owner": "agent",
      "pre": "target_identified",
      "add": [
        "frontmatter_checked"
      ]
    },
    "analyze_injection": {
      "owner": "agent",
      "pre": "scan_run",
      "add": [
        "injection_analyzed"
      ]
    },
    "analyze_behavior": {
      "owner": "agent",
      "pre": "frontmatter_checked",
      "add": [
        "behavior_analyzed"
      ]
    },
    "analyze_scripts": {
      "owner": "agent",
      "pre": "scan_run",
      "add": [
        "scripts_analyzed"
      ]
    },
    "assess_supply_chain": {
      "owner": "agent",
      "pre": "scan_run",
      "add": [
        "supply_chain_assessed"
      ]
    },
    "assess_permissions": {
      "owner": "agent",
      "pre": "frontmatter_checked",
      "add": [
        "permissions_assessed"
      ]
    },
    "produce_report": {
      "owner": "agent",
      "pre": {
        "and": [
          "injection_analyzed",
          "behavior_analyzed",
          "scripts_analyzed",
          "supply_chain_assessed",
          "permissions_assessed"
        ]
      },
      "add": [
        "report_produced"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "discover_skill",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_scanner",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_frontmatter",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "analyze_injection",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "analyze_behavior",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "analyze_scripts",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "assess_supply_chain",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "assess_permissions",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "produce_report",
        "by": "agent"
      }
    }
  ],
  "goal": "report_produced",
  "init_true": [],
  "init_constraints": []
}
