{
  "name": "expo-module",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "choose_scaffold_type": {
      "owner": "agent",
      "add": [
        "scaffold_type_chosen"
      ]
    },
    "determine_features": {
      "owner": "agent",
      "pre": "scaffold_type_chosen",
      "add": [
        "features_determined"
      ]
    },
    "scaffold_module": {
      "owner": "agent",
      "pre": "features_determined",
      "add": [
        "module_scaffolded"
      ]
    },
    "implement_code": {
      "owner": "agent",
      "pre": "module_scaffolded",
      "add": [
        "code_implemented"
      ]
    },
    "add_platform_support": {
      "owner": "agent",
      "pre": "module_scaffolded",
      "add": [
        "platform_added"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "choose_scaffold_type",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "determine_features",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scaffold_module",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "implement_code",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "needs_more_platforms": [
            {
              "act": {
                "cap": "add_platform_support",
                "by": "agent"
              }
            }
          ],
          "done": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "module_scaffolded",
      "code_implemented"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
