{
  "name": "debian-linux-triage",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "confirm_environment": {
      "owner": "agent",
      "pre": true,
      "add": [
        "environment_confirmed"
      ]
    },
    "provide_triage_steps": {
      "owner": "agent",
      "pre": "environment_confirmed",
      "add": [
        "triage_provided"
      ]
    },
    "provide_remediation": {
      "owner": "agent",
      "pre": "triage_provided",
      "add": [
        "remediation_provided"
      ]
    },
    "provide_validation": {
      "owner": "agent",
      "pre": "remediation_provided",
      "add": [
        "validation_provided"
      ]
    },
    "provide_rollback": {
      "owner": "agent",
      "pre": "validation_provided",
      "add": [
        "rollback_provided"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "confirm_environment",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "provide_triage_steps",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "provide_remediation",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "provide_validation",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "provide_rollback",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "triage_provided",
      "remediation_provided",
      "validation_provided",
      "rollback_provided"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
