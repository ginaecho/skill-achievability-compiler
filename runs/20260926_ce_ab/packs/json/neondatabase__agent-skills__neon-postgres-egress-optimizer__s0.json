{
  "name": "neon-postgres-egress-optimizer",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_pg_stat_statements": {
      "owner": "agent",
      "pre": true,
      "add": [
        "extension_checked"
      ]
    },
    "create_extension_if_missing": {
      "owner": "agent",
      "pre": "extension_checked",
      "add": [
        "extension_available"
      ]
    },
    "run_diagnostic_queries": {
      "owner": "agent",
      "pre": "extension_available",
      "add": [
        "diagnostics_ready"
      ]
    },
    "analyze_codebase": {
      "owner": "agent",
      "pre": "diagnostics_ready",
      "add": [
        "codebase_analyzed"
      ]
    },
    "apply_fixes": {
      "owner": "agent",
      "pre": "codebase_analyzed",
      "add": [
        "fixes_applied"
      ]
    },
    "run_tests": {
      "owner": "agent",
      "pre": "fixes_applied",
      "add": [
        "tests_verified"
      ]
    },
    "measure_improvement": {
      "owner": "agent",
      "pre": "tests_verified",
      "add": [
        "improvement_measured"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_pg_stat_statements",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_extension_if_missing",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_diagnostic_queries",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "analyze_codebase",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "apply_fixes",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_tests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "measure_improvement",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "fixes_applied",
      "tests_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
