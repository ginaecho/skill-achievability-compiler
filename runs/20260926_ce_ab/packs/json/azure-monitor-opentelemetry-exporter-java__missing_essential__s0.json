{
  "name": "azure-monitor-exporter-java-span-delivery",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "configure_exporter": {
      "owner": "agent",
      "add": [
        "exporter_configured"
      ]
    },
    "record_span": {
      "owner": "agent",
      "pre": "exporter_configured",
      "add": [
        "span_recorded"
      ]
    },
    "enrich_span": {
      "owner": "agent",
      "pre": "span_recorded",
      "add": [
        "span_enriched"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "configure_exporter",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "record_span",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "deliver_telemetry",
        "by": "agent"
      }
    }
  ],
  "goal": "telemetry_delivered",
  "init_true": [
    "ingestion_egress"
  ],
  "init_constraints": []
}
