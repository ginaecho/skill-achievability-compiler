{
  "name": "post-patch-validation",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "scaffold_plan": {
      "owner": "agent",
      "add": [
        "plan_scaffolded"
      ]
    },
    "populate_checks": {
      "owner": "agent",
      "pre": "plan_scaffolded",
      "add": [
        "checks_populated"
      ]
    },
    "validate_plan": {
      "owner": "agent",
      "pre": "checks_populated",
      "add": [
        "plan_validated"
      ]
    },
    "run_plan": {
      "owner": "agent",
      "pre": "plan_validated",
      "nondet": {
        "evidence_ready": true
      }
    },
    "invoke_workflow": {
      "owner": "agent",
      "nondet": {
        "evidence_ready": true
      }
    },
    "report_results": {
      "owner": "agent",
      "pre": "evidence_ready",
      "add": [
        "reported"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "manual": [
            {
              "act": {
                "cap": "scaffold_plan",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "populate_checks",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "validate_plan",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "run_plan",
                "by": "agent"
              }
            }
          ],
          "dynamic_workflow": [
            {
              "act": {
                "cap": "invoke_workflow",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "report_results",
        "by": "agent"
      }
    }
  ],
  "goal": "reported",
  "init_true": [],
  "init_constraints": []
}
