{
  "name": "open-sourcing",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "detect_org": {
      "owner": "agent",
      "add": [
        "org_profile_known"
      ]
    },
    "audit_secrets": {
      "owner": "agent",
      "pre": "org_profile_known",
      "add": [
        "secrets_audited"
      ]
    },
    "recreate_repo": {
      "owner": "agent",
      "pre": "secrets_audited",
      "add": [
        "repo_recreated"
      ]
    },
    "run_readiness_check": {
      "owner": "agent",
      "pre": "secrets_audited",
      "add": [
        "readiness_checked"
      ]
    },
    "write_docs": {
      "owner": "agent",
      "pre": "readiness_checked",
      "add": [
        "docs_complete"
      ]
    },
    "add_license": {
      "owner": "agent",
      "pre": "readiness_checked",
      "add": [
        "license_added"
      ]
    },
    "verify_tests_ci": {
      "owner": "agent",
      "pre": "readiness_checked",
      "add": [
        "tests_ci_verified"
      ]
    },
    "harden_workflows": {
      "owner": "agent",
      "pre": "tests_ci_verified",
      "add": [
        "workflows_hardened"
      ]
    },
    "tag_release": {
      "owner": "agent",
      "pre": {
        "and": [
          "docs_complete",
          "license_added",
          "tests_ci_verified"
        ]
      },
      "add": [
        "release_tagged"
      ]
    },
    "final_review": {
      "owner": "agent",
      "pre": "release_tagged",
      "add": [
        "final_review_done"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "detect_org",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "audit_secrets",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "secrets_found": [
            {
              "act": {
                "cap": "recreate_repo",
                "by": "agent"
              }
            }
          ],
          "no_secrets": []
        }
      }
    },
    {
      "act": {
        "cap": "run_readiness_check",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "add_license",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_tests_ci",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "harden_workflows",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_repo_settings",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "tag_release",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "final_review",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "make_repo_public",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "docs_complete",
      "license_added",
      "tests_ci_verified",
      "final_review_done"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
