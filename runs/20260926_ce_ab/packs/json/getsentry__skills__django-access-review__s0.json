{
  "name": "django-access-review",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "understand_auth_model": {
      "owner": "agent",
      "pre": true,
      "add": [
        "auth_model_understood"
      ]
    },
    "map_attack_surface": {
      "owner": "agent",
      "pre": "auth_model_understood",
      "add": [
        "attack_surface_mapped"
      ]
    },
    "trace_flows": {
      "owner": "agent",
      "pre": "attack_surface_mapped",
      "add": [
        "flows_traced"
      ]
    },
    "report_findings": {
      "owner": "agent",
      "pre": "flows_traced",
      "add": [
        "findings_reported"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "understand_auth_model",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "map_attack_surface",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "trace_flows",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "report_findings",
        "by": "agent"
      }
    }
  ],
  "goal": "findings_reported",
  "init_true": [],
  "init_constraints": []
}
