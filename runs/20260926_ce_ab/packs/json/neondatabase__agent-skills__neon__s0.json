{
  "name": "neon",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "map_capabilities": {
      "owner": "agent",
      "pre": true,
      "add": [
        "capabilities_mapped"
      ]
    },
    "inspect_existing": {
      "owner": "agent",
      "pre": "capabilities_mapped",
      "add": [
        "existing_inspected"
      ]
    },
    "select_primitives": {
      "owner": "agent",
      "pre": "existing_inspected",
      "add": [
        "primitives_selected"
      ]
    },
    "provision_neon": {
      "owner": "agent",
      "pre": "primitives_selected",
      "add": [
        "backend_ready"
      ]
    },
    "reuse_existing": {
      "owner": "agent",
      "pre": "primitives_selected",
      "add": [
        "backend_ready"
      ]
    },
    "verify_app_flow": {
      "owner": "agent",
      "pre": "backend_ready",
      "add": [
        "app_verified"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "map_capabilities",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "inspect_existing",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "select_primitives",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "provision_needed": [
            {
              "act": {
                "cap": "provision_neon",
                "by": "agent"
              }
            }
          ],
          "already_present": [
            {
              "act": {
                "cap": "reuse_existing",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "verify_app_flow",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "backend_ready",
      "app_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
