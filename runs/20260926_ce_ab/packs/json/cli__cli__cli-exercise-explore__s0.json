{
  "name": "cli-exercise-explore",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "execute_case": {
      "owner": "agent",
      "pre": {
        "and": [
          "context_ready",
          "approved_scope"
        ]
      },
      "add": [
        "case_executed"
      ]
    },
    "validate_case": {
      "owner": "agent",
      "pre": "case_executed",
      "add": [
        "case_validated"
      ]
    },
    "report_results": {
      "owner": "agent",
      "pre": "case_validated",
      "add": [
        "report_produced"
      ]
    }
  },
  "protocol": [
    {
      "rec": {
        "name": "ExploreLoop",
        "body": [
          {
            "act": {
              "cap": "execute_case",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "validate_case",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "more_cases": [
                  {
                    "continue": "ExploreLoop"
                  }
                ],
                "done_exploring": []
              }
            }
          }
        ]
      }
    },
    {
      "act": {
        "cap": "report_results",
        "by": "agent"
      }
    }
  ],
  "goal": "report_produced",
  "init_true": [
    "context_ready",
    "approved_scope"
  ],
  "init_constraints": []
}
