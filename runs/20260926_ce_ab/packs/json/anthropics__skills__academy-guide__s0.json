{
  "name": "academy-guide",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "answer_question": {
      "owner": "agent",
      "pre": true,
      "add": [
        "question_answered"
      ]
    },
    "fetch_catalog": {
      "owner": "agent",
      "pre": true,
      "add": [
        "catalog_fetched"
      ]
    },
    "recommend_from_catalog": {
      "owner": "agent",
      "pre": {
        "and": [
          "catalog_fetched",
          "question_answered"
        ]
      },
      "add": [
        "recommendation_given"
      ]
    },
    "recommend_hub_fallback": {
      "owner": "agent",
      "pre": "question_answered",
      "add": [
        "recommendation_given"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "answer_question",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "strong_match_catalog_ok": [
            {
              "act": {
                "cap": "fetch_catalog",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "recommend_from_catalog",
                "by": "agent"
              }
            }
          ],
          "weak_match_or_no_catalog": [
            {
              "act": {
                "cap": "recommend_hub_fallback",
                "by": "agent"
              }
            }
          ],
          "no_match": []
        }
      }
    }
  ],
  "goal": "question_answered",
  "init_true": [],
  "init_constraints": []
}
