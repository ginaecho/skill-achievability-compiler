{
  "name": "webapp-testing",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "start_server": {
      "owner": "agent",
      "pre": true,
      "add": [
        "server_running"
      ]
    },
    "write_script": {
      "owner": "agent",
      "pre": true,
      "add": [
        "script_written"
      ]
    },
    "navigate_page": {
      "owner": "agent",
      "pre": "script_written",
      "add": [
        "page_loaded"
      ]
    },
    "wait_networkidle": {
      "owner": "agent",
      "pre": "page_loaded",
      "add": [
        "dom_ready"
      ]
    },
    "inspect_dom": {
      "owner": "agent",
      "pre": "dom_ready",
      "add": [
        "selectors_identified"
      ]
    },
    "execute_actions": {
      "owner": "agent",
      "pre": "selectors_identified",
      "add": [
        "actions_executed"
      ]
    },
    "close_browser": {
      "owner": "agent",
      "pre": "actions_executed",
      "add": [
        "browser_closed"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "server_needed": [
            {
              "act": {
                "cap": "start_server",
                "by": "agent"
              }
            }
          ],
          "server_already_running": []
        }
      }
    },
    {
      "act": {
        "cap": "write_script",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "navigate_page",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "wait_networkidle",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "inspect_dom",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "execute_actions",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "close_browser",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "actions_executed",
      "browser_closed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
