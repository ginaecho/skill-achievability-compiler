{
  "name": "aws-ami-builder",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "write_template": {
      "owner": "agent",
      "add": [
        "template_written"
      ]
    },
    "init_plugins": {
      "owner": "agent",
      "pre": "template_written",
      "add": [
        "plugins_initialized"
      ]
    },
    "validate_template": {
      "owner": "agent",
      "pre": "plugins_initialized",
      "add": [
        "template_validated"
      ]
    },
    "build_ami": {
      "owner": "agent",
      "pre": "template_validated",
      "add": [
        "ami_built"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_template",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "init_plugins",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_template",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_ami",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "ami_built"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
