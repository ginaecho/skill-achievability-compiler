{
  "name": "security-threat-model",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "scope_system": {
      "owner": "agent",
      "pre": true,
      "add": [
        "system_scoped"
      ]
    },
    "derive_boundaries": {
      "owner": "agent",
      "pre": "system_scoped",
      "add": [
        "boundaries_derived"
      ]
    },
    "enumerate_threats": {
      "owner": "agent",
      "pre": "boundaries_derived",
      "add": [
        "threats_enumerated"
      ]
    },
    "prioritize_threats": {
      "owner": "agent",
      "pre": "threats_enumerated",
      "add": [
        "threats_prioritized"
      ]
    },
    "ask_user_clarification": {
      "owner": "agent",
      "pre": "threats_prioritized",
      "add": [
        "user_consulted"
      ]
    },
    "recommend_mitigations": {
      "owner": "agent",
      "pre": "user_consulted",
      "add": [
        "mitigations_recommended"
      ]
    },
    "quality_check": {
      "owner": "agent",
      "pre": "mitigations_recommended",
      "add": [
        "quality_checked"
      ]
    },
    "write_report": {
      "owner": "agent",
      "pre": "quality_checked",
      "add": [
        "report_written"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "scope_system",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "derive_boundaries",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "enumerate_threats",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "prioritize_threats",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "ask_user_clarification",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "confirmed": [
            {
              "act": {
                "cap": "recommend_mitigations",
                "by": "agent"
              }
            }
          ],
          "declined": [
            {
              "act": {
                "cap": "recommend_mitigations",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "quality_check",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_report",
        "by": "agent"
      }
    }
  ],
  "goal": "report_written",
  "init_true": [],
  "init_constraints": []
}
