{
  "name": "expo-eas-hosting",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "install_eas_cli": {
      "owner": "agent",
      "add": [
        "eas_cli_installed"
      ]
    },
    "eas_login": {
      "owner": "agent",
      "pre": "eas_cli_installed",
      "add": [
        "authenticated"
      ]
    },
    "export_web_bundle": {
      "owner": "agent",
      "add": [
        "bundle_exported"
      ]
    },
    "eas_deploy": {
      "owner": "agent",
      "pre": {
        "and": [
          "bundle_exported",
          "authenticated"
        ]
      },
      "add": [
        "deployed"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_eas_cli",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "eas_login",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "export_web_bundle",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "eas_deploy",
        "by": "agent"
      }
    }
  ],
  "goal": "deployed",
  "init_true": [],
  "init_constraints": []
}
