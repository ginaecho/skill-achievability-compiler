{
  "name": "sagemaker-iam-preflight",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_role": {
      "owner": "agent",
      "pre": true,
      "add": [
        "checked"
      ]
    },
    "adopt_existing_role": {
      "owner": "agent",
      "pre": "checked",
      "add": [
        "role_usable"
      ]
    },
    "create_role": {
      "owner": "agent",
      "pre": "checked",
      "add": [
        "role_usable"
      ]
    },
    "ask_admin_for_role_or_permissions": {
      "owner": "agent",
      "pre": "checked",
      "add": [
        "escalation_requested"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_role",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "existing_role_found": [
            {
              "act": {
                "cap": "adopt_existing_role",
                "by": "agent"
              }
            }
          ],
          "no_role_found": [
            {
              "choice": {
                "by": "agent",
                "external": true,
                "branches": {
                  "user_can_create": [
                    {
                      "act": {
                        "cap": "create_role",
                        "by": "agent"
                      }
                    }
                  ],
                  "user_cannot_create": [
                    {
                      "act": {
                        "cap": "ask_admin_for_role_or_permissions",
                        "by": "agent"
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    }
  ],
  "goal": "role_usable",
  "init_true": [],
  "init_constraints": []
}
