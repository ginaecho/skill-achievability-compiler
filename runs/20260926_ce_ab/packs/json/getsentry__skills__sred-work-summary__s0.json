{
  "name": "sred-work-summary",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_access": {
      "owner": "agent",
      "add": [
        "access_granted"
      ]
    },
    "compute_year": {
      "owner": "agent",
      "add": [
        "year_computed"
      ]
    },
    "collect_user_info": {
      "owner": "agent",
      "pre": {
        "and": [
          "access_granted",
          "year_computed"
        ]
      },
      "add": [
        "user_info_collected"
      ]
    },
    "create_notion_doc": {
      "owner": "agent",
      "pre": "user_info_collected",
      "add": [
        "doc_created"
      ]
    },
    "find_github_prs": {
      "owner": "agent",
      "pre": "doc_created",
      "add": [
        "prs_found"
      ]
    },
    "find_notion_docs": {
      "owner": "agent",
      "pre": "doc_created",
      "add": [
        "notion_docs_found"
      ]
    },
    "find_linear_tickets": {
      "owner": "agent",
      "pre": "doc_created",
      "add": [
        "linear_tickets_found"
      ]
    },
    "add_links_to_doc": {
      "owner": "agent",
      "pre": {
        "and": [
          "prs_found",
          "notion_docs_found",
          "linear_tickets_found"
        ]
      },
      "add": [
        "links_added"
      ]
    },
    "group_into_projects": {
      "owner": "agent",
      "pre": "links_added",
      "add": [
        "projects_grouped"
      ]
    },
    "search_other_users_docs": {
      "owner": "agent",
      "pre": "projects_grouped",
      "add": [
        "other_docs_searched"
      ]
    },
    "add_other_docs_links": {
      "owner": "agent",
      "pre": "other_docs_searched",
      "add": [
        "other_docs_added"
      ]
    },
    "return_link_to_user": {
      "owner": "agent",
      "pre": "other_docs_added",
      "add": [
        "link_returned"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_access",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "compute_year",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "collect_user_info",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "doc_already_exists": [],
          "doc_is_new": [
            {
              "act": {
                "cap": "create_notion_doc",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "find_github_prs",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "find_notion_docs",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "find_linear_tickets",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "add_links_to_doc",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "group_into_projects",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "search_other_users_docs",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "add_other_docs_links",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "return_link_to_user",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "links_added",
      "projects_grouped",
      "other_docs_added",
      "link_returned"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
