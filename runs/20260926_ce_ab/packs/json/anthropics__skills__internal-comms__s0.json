{
  "name": "internal-comms",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "identify_comm_type": {
      "owner": "agent",
      "add": [
        "type_identified"
      ]
    },
    "load_guideline_file": {
      "owner": "agent",
      "pre": "type_identified",
      "add": [
        "guideline_loaded"
      ]
    },
    "ask_clarification": {
      "owner": "agent",
      "pre": "type_identified",
      "add": [
        "clarification_asked"
      ]
    },
    "write_communication": {
      "owner": "agent",
      "pre": "guideline_loaded",
      "add": [
        "communication_written"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "identify_comm_type",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "type_matches_guideline": [
            {
              "act": {
                "cap": "load_guideline_file",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "write_communication",
                "by": "agent"
              }
            }
          ],
          "type_unclear": [
            {
              "act": {
                "cap": "ask_clarification",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "or": [
      "communication_written",
      "clarification_asked"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
