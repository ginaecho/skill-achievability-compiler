{
  "name": "finetuning",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "baseline_eval": {
      "owner": "agent",
      "pre": true,
      "add": [
        "baseline_evaluated"
      ]
    },
    "validate_data": {
      "owner": "agent",
      "pre": true,
      "add": [
        "data_validated"
      ]
    },
    "submit_job": {
      "owner": "agent",
      "pre": {
        "and": [
          "data_validated",
          "baseline_evaluated"
        ]
      },
      "add": [
        "job_submitted"
      ]
    },
    "monitor_job": {
      "owner": "agent",
      "pre": "job_submitted",
      "add": [
        "job_completed"
      ]
    },
    "evaluate_checkpoints": {
      "owner": "agent",
      "pre": "job_completed",
      "add": [
        "checkpoints_evaluated"
      ]
    },
    "deploy_model": {
      "owner": "agent",
      "pre": "checkpoints_evaluated",
      "add": [
        "model_deployed"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "baseline_eval",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_data",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "submit_job",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "monitor_job",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "evaluate_checkpoints",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "deploy_model",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "baseline_evaluated",
      "data_validated",
      "job_completed",
      "checkpoints_evaluated",
      "model_deployed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
