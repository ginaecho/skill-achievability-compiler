{
  "name": "turnstile-spin",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "auth_probe_ok": {
      "owner": "agent",
      "pre": true,
      "add": [
        "auth_ok"
      ]
    },
    "auth_probe_needs_token": {
      "owner": "agent",
      "pre": true,
      "add": [
        "auth_needs_token"
      ]
    },
    "obtain_token": {
      "owner": "user",
      "pre": "auth_needs_token",
      "add": [
        "token_provided"
      ],
      "del": [
        "auth_needs_token"
      ]
    },
    "confirm_domains": {
      "owner": "user",
      "pre": "auth_ok",
      "add": [
        "domains_confirmed"
      ]
    },
    "scan_codebase": {
      "owner": "agent",
      "pre": "domains_confirmed",
      "add": [
        "codebase_scanned"
      ]
    },
    "confirm_insertion_plan": {
      "owner": "user",
      "pre": "codebase_scanned",
      "add": [
        "insertion_plan_confirmed"
      ]
    },
    "create_widget": {
      "owner": "agent",
      "pre": "insertion_plan_confirmed",
      "add": [
        "widget_created"
      ]
    },
    "wire_integration": {
      "owner": "agent",
      "pre": "widget_created",
      "add": [
        "integration_wired"
      ]
    },
    "store_secret": {
      "owner": "agent",
      "pre": "integration_wired",
      "add": [
        "secret_stored"
      ]
    },
    "validate_integration": {
      "owner": "agent",
      "pre": "secret_stored",
      "add": [
        "integration_validated"
      ]
    },
    "final_report": {
      "owner": "agent",
      "pre": "integration_validated",
      "add": [
        "report_delivered"
      ]
    }
  },
  "protocol": [
    {
      "rec": {
        "name": "auth_loop",
        "body": [
          {
            "choice": {
              "by": "agent",
              "external": true,
              "branches": {
                "ok": [
                  {
                    "act": {
                      "cap": "auth_probe_ok",
                      "by": "agent"
                    }
                  }
                ],
                "needs_token": [
                  {
                    "act": {
                      "cap": "auth_probe_needs_token",
                      "by": "agent"
                    }
                  },
                  {
                    "act": {
                      "cap": "obtain_token",
                      "by": "user"
                    }
                  },
                  {
                    "continue": "auth_loop"
                  }
                ]
              }
            }
          }
        ]
      }
    },
    {
      "act": {
        "cap": "confirm_domains",
        "by": "user"
      }
    },
    {
      "act": {
        "cap": "scan_codebase",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "confirm_insertion_plan",
        "by": "user"
      }
    },
    {
      "act": {
        "cap": "create_widget",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "wire_integration",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "store_secret",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_integration",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "final_report",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "integration_wired",
      "integration_validated",
      "report_delivered"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
