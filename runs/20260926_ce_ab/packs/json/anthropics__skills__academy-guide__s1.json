{
  "name": "academy-guide",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "answer_question": {
      "owner": "agent",
      "pre": true,
      "add": [
        "answer_given"
      ]
    },
    "recommend_item": {
      "owner": "agent",
      "pre": "catalog_fetched",
      "add": [
        "recommendation_given"
      ]
    },
    "recommend_hub": {
      "owner": "agent",
      "pre": "answer_given",
      "add": [
        "recommendation_given"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "answer_question",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "strong_match_with_catalog": [
            {
              "act": {
                "cap": "fetch_catalog",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "recommend_item",
                "by": "agent"
              }
            }
          ],
          "weak_match_or_no_catalog": [
            {
              "act": {
                "cap": "recommend_hub",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "answer_given"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
