{
  "name": "expo-native-ui-screen",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_expo_ui_components": {
      "owner": "agent",
      "pre": true,
      "add": [
        "checked_expo_ui"
      ]
    },
    "run_expo_go": {
      "owner": "agent",
      "pre": true,
      "add": [
        "dev_environment_ready"
      ]
    },
    "create_custom_build": {
      "owner": "agent",
      "pre": true,
      "add": [
        "dev_environment_ready"
      ]
    },
    "implement_screen": {
      "owner": "agent",
      "pre": {
        "and": [
          "checked_expo_ui",
          "dev_environment_ready"
        ]
      },
      "add": [
        "screen_implemented"
      ]
    },
    "style_screen": {
      "owner": "agent",
      "pre": "screen_implemented",
      "add": [
        "screen_styled"
      ]
    },
    "verify_screen": {
      "owner": "agent",
      "pre": "screen_styled",
      "add": [
        "screen_verified"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_expo_ui_components",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "use_expo_go": [
            {
              "act": {
                "cap": "run_expo_go",
                "by": "agent"
              }
            }
          ],
          "needs_custom_build": [
            {
              "act": {
                "cap": "create_custom_build",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "implement_screen",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "style_screen",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_screen",
        "by": "agent"
      }
    }
  ],
  "goal": "screen_verified",
  "init_true": [],
  "init_constraints": []
}
