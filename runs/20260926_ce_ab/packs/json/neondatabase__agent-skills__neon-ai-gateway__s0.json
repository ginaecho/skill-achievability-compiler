{
  "name": "neon-ai-gateway-setup",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_preconditions": {
      "owner": "agent",
      "pre": true,
      "add": [
        "preconditions_checked"
      ]
    },
    "declare_gateway_config": {
      "owner": "agent",
      "pre": "preconditions_checked",
      "add": [
        "config_declared"
      ]
    },
    "apply_config": {
      "owner": "agent",
      "pre": "config_declared",
      "add": [
        "gateway_enabled"
      ]
    },
    "pull_env": {
      "owner": "agent",
      "pre": "gateway_enabled",
      "add": [
        "env_ready"
      ]
    },
    "install_sdk": {
      "owner": "agent",
      "pre": true,
      "add": [
        "sdk_installed"
      ]
    },
    "implement_call": {
      "owner": "agent",
      "pre": {
        "and": [
          "env_ready",
          "sdk_installed"
        ]
      },
      "add": [
        "call_implemented"
      ]
    },
    "run_call": {
      "owner": "agent",
      "pre": "call_implemented",
      "add": [
        "llm_call_succeeded"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_preconditions",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "declare_gateway_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "apply_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "pull_env",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_sdk",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "implement_call",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_call",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "gateway_enabled",
      "llm_call_succeeded"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
