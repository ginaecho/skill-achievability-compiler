{
  "name": "writing-acceptance-tests",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "read_docs_and_examples": {
      "owner": "agent",
      "pre": true,
      "add": [
        "docs_read"
      ]
    },
    "write_script": {
      "owner": "agent",
      "pre": "docs_read",
      "add": [
        "script_written"
      ]
    },
    "run_metadata_checks": {
      "owner": "agent",
      "pre": "script_written",
      "add": [
        "metadata_validated"
      ]
    },
    "run_live_script": {
      "owner": "agent",
      "pre": "metadata_validated",
      "add": [
        "live_run_done"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_docs_and_examples",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_script",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_metadata_checks",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "script_written",
      "metadata_validated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
