{
  "name": "durable-objects",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "configure_bindings": {
      "owner": "agent",
      "pre": true,
      "add": [
        "bindings_configured"
      ]
    },
    "write_do_code": {
      "owner": "agent",
      "pre": "bindings_configured",
      "add": [
        "do_written"
      ]
    },
    "run_tests": {
      "owner": "agent",
      "pre": "do_written",
      "add": [
        "tests_passed"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "configure_bindings",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_do_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_tests",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "bindings_configured",
      "do_written",
      "tests_passed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
