{
  "name": "typespec-create-api-plugin",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "ask_requirements": {
      "owner": "agent",
      "pre": true,
      "add": [
        "requirements_gathered"
      ]
    },
    "write_main_tsp": {
      "owner": "agent",
      "pre": "requirements_gathered",
      "add": [
        "main_tsp_written"
      ]
    },
    "write_actions_tsp": {
      "owner": "agent",
      "pre": "requirements_gathered",
      "add": [
        "actions_tsp_written"
      ]
    },
    "write_card_json": {
      "owner": "agent",
      "pre": "requirements_gathered",
      "add": [
        "card_json_written"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "ask_requirements",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_main_tsp",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_actions_tsp",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "cards_needed": [
            {
              "act": {
                "cap": "write_card_json",
                "by": "agent"
              }
            }
          ],
          "no_cards": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "main_tsp_written",
      "actions_tsp_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
