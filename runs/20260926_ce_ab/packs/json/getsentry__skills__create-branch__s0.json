{
  "name": "create-branch",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "inspect_changes": {
      "owner": "agent",
      "add": [
        "changes_inspected"
      ]
    },
    "resolve_description": {
      "owner": "agent",
      "pre": "changes_inspected",
      "add": [
        "description_resolved"
      ]
    },
    "classify_type": {
      "owner": "agent",
      "pre": "description_resolved",
      "add": [
        "type_classified"
      ]
    },
    "determine_base": {
      "owner": "agent",
      "add": [
        "base_determined"
      ]
    },
    "check_name_collision": {
      "owner": "agent",
      "pre": "type_classified",
      "add": [
        "name_available"
      ]
    },
    "create_branch": {
      "owner": "agent",
      "pre": {
        "and": [
          "name_available",
          "base_determined"
        ]
      },
      "add": [
        "branch_created"
      ]
    },
    "report_branch": {
      "owner": "agent",
      "pre": "branch_created",
      "add": [
        "reported"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_changes",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "resolve_description",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "classify_type",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "determine_base",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_name_collision",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_branch",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "report_branch",
        "by": "agent"
      }
    }
  ],
  "goal": "reported",
  "init_true": [],
  "init_constraints": []
}
