{
  "name": "qdrant-vertical-scaling",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_resource_usage": {
      "owner": "agent",
      "add": [
        "usage_checked"
      ]
    },
    "ensure_replication": {
      "owner": "agent",
      "pre": "usage_checked",
      "add": [
        "replication_ok"
      ]
    },
    "resize_node": {
      "owner": "agent",
      "pre": "replication_ok",
      "add": [
        "resized"
      ]
    },
    "monitor_after_resize": {
      "owner": "agent",
      "pre": "resized",
      "add": [
        "monitored"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_resource_usage",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "ensure_replication",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "resize_node",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "monitor_after_resize",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "resized",
      "monitored"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
