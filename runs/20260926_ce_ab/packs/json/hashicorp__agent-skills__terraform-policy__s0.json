{
  "name": "terraform-policy-authoring",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_cli_version": {
      "owner": "agent",
      "add": [
        "cli_version_known"
      ]
    },
    "author_policy_file": {
      "owner": "agent",
      "pre": "cli_version_known",
      "add": [
        "policy_authored"
      ]
    },
    "author_policytest_file": {
      "owner": "agent",
      "pre": "cli_version_known",
      "add": [
        "policytest_authored"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_cli_version",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "author_policy_file",
        "by": "agent"
      }
    }
  ],
  "goal": "policy_authored",
  "init_true": [],
  "init_constraints": []
}
