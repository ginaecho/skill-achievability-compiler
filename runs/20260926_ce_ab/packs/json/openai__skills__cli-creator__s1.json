{
  "name": "cli-creator",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "inventory_source": {
      "owner": "agent",
      "pre": true,
      "add": [
        "source_inventoried"
      ]
    },
    "sketch_commands": {
      "owner": "agent",
      "pre": "source_inventoried",
      "add": [
        "commands_sketched"
      ]
    },
    "scaffold_cli": {
      "owner": "agent",
      "pre": "commands_sketched",
      "add": [
        "cli_scaffolded"
      ]
    },
    "implement_commands": {
      "owner": "agent",
      "pre": "cli_scaffolded",
      "add": [
        "commands_implemented"
      ]
    },
    "install_cli": {
      "owner": "agent",
      "pre": "commands_implemented",
      "add": [
        "cli_installed"
      ]
    },
    "smoke_test": {
      "owner": "agent",
      "pre": "cli_installed",
      "add": [
        "smoke_tested"
      ]
    },
    "run_checks": {
      "owner": "agent",
      "pre": "commands_implemented",
      "add": [
        "checks_passed"
      ]
    },
    "write_companion_skill": {
      "owner": "agent",
      "pre": "cli_installed",
      "add": [
        "companion_skill_written"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inventory_source",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "sketch_commands",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scaffold_cli",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "implement_commands",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_cli",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "smoke_test",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_checks",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_companion_skill",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "cli_installed",
      "smoke_tested",
      "checks_passed",
      "companion_skill_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
