{
  "name": "workers-best-practices",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "retrieve_docs": {
      "owner": "agent",
      "add": [
        "docs_retrieved"
      ]
    },
    "check_compat_date": {
      "owner": "agent",
      "pre": "docs_retrieved",
      "add": [
        "compat_checked"
      ]
    },
    "enable_observability": {
      "owner": "agent",
      "pre": "compat_checked",
      "add": [
        "observability_enabled"
      ]
    },
    "flag_antipatterns": {
      "owner": "agent",
      "pre": "docs_retrieved",
      "add": [
        "antipatterns_flagged"
      ]
    },
    "run_validation": {
      "owner": "agent",
      "pre": {
        "and": [
          "observability_enabled",
          "antipatterns_flagged"
        ]
      },
      "add": [
        "validated"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "retrieve_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_compat_date",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "enable_observability",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "flag_antipatterns",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_validation",
        "by": "agent"
      }
    }
  ],
  "goal": "validated",
  "init_true": [],
  "init_constraints": []
}
