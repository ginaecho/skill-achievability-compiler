{
  "name": "fastapi-router-py",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "copy_template": {
      "owner": "agent",
      "add": [
        "template_copied"
      ]
    },
    "customize_router": {
      "owner": "agent",
      "pre": "template_copied",
      "add": [
        "router_customized"
      ]
    },
    "create_models": {
      "owner": "agent",
      "pre": "router_customized",
      "add": [
        "models_created"
      ]
    },
    "mount_router": {
      "owner": "agent",
      "pre": "router_customized",
      "add": [
        "router_mounted"
      ]
    },
    "create_service_layer": {
      "owner": "agent",
      "pre": "router_customized",
      "add": [
        "service_layer_created"
      ]
    },
    "add_frontend_api": {
      "owner": "agent",
      "pre": "router_mounted",
      "add": [
        "frontend_api_added"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "copy_template",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "customize_router",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_models",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "mount_router",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_service_layer",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "add_frontend_api",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "router_mounted",
      "models_created"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
