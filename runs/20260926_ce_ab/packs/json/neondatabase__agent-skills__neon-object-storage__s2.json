{
  "name": "neon-object-storage",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_region": {
      "owner": "agent",
      "pre": true,
      "add": [
        "region_confirmed"
      ]
    },
    "declare_bucket_config": {
      "owner": "agent",
      "pre": "region_confirmed",
      "add": [
        "bucket_declared"
      ]
    },
    "deploy_config": {
      "owner": "agent",
      "pre": "bucket_declared",
      "add": [
        "bucket_provisioned"
      ]
    },
    "pull_env_vars": {
      "owner": "agent",
      "pre": "bucket_provisioned",
      "add": [
        "env_vars_available"
      ]
    },
    "write_upload_download_code": {
      "owner": "agent",
      "pre": "env_vars_available",
      "add": [
        "code_written"
      ]
    },
    "run_upload": {
      "owner": "agent",
      "pre": "code_written",
      "add": [
        "file_uploaded"
      ]
    },
    "run_download": {
      "owner": "agent",
      "pre": "file_uploaded",
      "add": [
        "file_downloaded"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_region",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "declare_bucket_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "deploy_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "pull_env_vars",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_upload_download_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_upload",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_download",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "file_uploaded",
      "file_downloaded"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
