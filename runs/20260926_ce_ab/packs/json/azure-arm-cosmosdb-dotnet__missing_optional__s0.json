{
  "name": "azure-arm-cosmosdb-provision",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "create_account": {
      "owner": "agent",
      "pre": "arm_write",
      "add": [
        "account_exists"
      ]
    },
    "create_database": {
      "owner": "agent",
      "pre": {
        "and": [
          "account_exists",
          "arm_write"
        ]
      },
      "add": [
        "database_exists"
      ]
    },
    "create_container": {
      "owner": "agent",
      "pre": {
        "and": [
          "database_exists",
          "arm_write"
        ]
      },
      "add": [
        "container_exists"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "create_account",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_database",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_container",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "account_exists",
      "database_exists",
      "container_exists"
    ]
  },
  "init_true": [
    "arm_write"
  ],
  "init_constraints": []
}
