{
  "name": "speech",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "install_deps": {
      "owner": "agent",
      "pre": true,
      "add": [
        "deps_installed"
      ]
    },
    "collect_inputs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "inputs_collected"
      ]
    },
    "set_api_key": {
      "owner": "user",
      "pre": true,
      "add": [
        "api_key_set"
      ]
    },
    "generate_audio": {
      "owner": "agent",
      "pre": {
        "and": [
          "deps_installed",
          "inputs_collected",
          "api_key_set"
        ]
      },
      "add": [
        "audio_generated"
      ]
    },
    "save_output": {
      "owner": "agent",
      "pre": "audio_generated",
      "add": [
        "output_saved"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_deps",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "collect_inputs",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "key_set": [
            {
              "act": {
                "cap": "set_api_key",
                "by": "user"
              }
            },
            {
              "act": {
                "cap": "generate_audio",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "save_output",
                "by": "agent"
              }
            }
          ],
          "key_missing": []
        }
      }
    }
  ],
  "goal": "output_saved",
  "init_true": [],
  "init_constraints": []
}
