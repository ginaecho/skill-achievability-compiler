{
  "name": "huggingface-llm-trainer",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_auth": {
      "owner": "agent",
      "pre": true,
      "add": [
        "authenticated"
      ]
    },
    "validate_dataset": {
      "owner": "agent",
      "pre": true,
      "add": [
        "dataset_validated"
      ]
    },
    "create_training_script": {
      "owner": "agent",
      "pre": true,
      "add": [
        "script_ready"
      ]
    },
    "submit_training_job": {
      "owner": "agent",
      "pre": {
        "and": [
          "authenticated",
          "script_ready",
          "dataset_validated"
        ]
      },
      "add": [
        "job_submitted"
      ]
    },
    "report_job_details": {
      "owner": "agent",
      "pre": "job_submitted",
      "add": [
        "job_reported"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_auth",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_dataset",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_training_script",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "submit_training_job",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "report_job_details",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "job_submitted",
      "job_reported"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
