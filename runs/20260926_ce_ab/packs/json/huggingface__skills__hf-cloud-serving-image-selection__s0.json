{
  "name": "hf-cloud-serving-image-selection",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "inspect_model_architecture": {
      "owner": "agent",
      "pre": true,
      "add": [
        "architecture_checked"
      ]
    },
    "select_container_family": {
      "owner": "agent",
      "pre": "architecture_checked",
      "add": [
        "family_selected"
      ]
    },
    "fetch_image_uri_from_catalog": {
      "owner": "agent",
      "pre": "family_selected",
      "add": [
        "image_uri_selected"
      ]
    },
    "check_ami_requirement": {
      "owner": "agent",
      "pre": "image_uri_selected",
      "add": [
        "ami_checked"
      ]
    },
    "configure_deploy_script": {
      "owner": "agent",
      "pre": "ami_checked",
      "add": [
        "deploy_configured"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_model_architecture",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "select_container_family",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_image_uri_from_catalog",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_ami_requirement",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_deploy_script",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "image_uri_selected",
      "deploy_configured"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
