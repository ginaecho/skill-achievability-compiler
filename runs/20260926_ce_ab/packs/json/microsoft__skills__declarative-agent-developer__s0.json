{
  "name": "declarative-agent-developer",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_atk_cli": {
      "owner": "agent",
      "pre": true,
      "add": [
        "atk_verified"
      ]
    },
    "fingerprint_workspace": {
      "owner": "agent",
      "pre": "atk_verified",
      "add": [
        "workspace_fingerprinted"
      ]
    },
    "edit_manifest": {
      "owner": "agent",
      "pre": "workspace_fingerprinted",
      "add": [
        "manifest_edited"
      ]
    },
    "update_instructions_and_starters": {
      "owner": "agent",
      "pre": "manifest_edited",
      "add": [
        "instructions_updated"
      ]
    },
    "deploy_agent": {
      "owner": "agent",
      "pre": {
        "and": [
          "manifest_edited",
          "instructions_updated"
        ]
      },
      "add": [
        "agent_deployed"
      ]
    },
    "present_test_link": {
      "owner": "agent",
      "pre": "agent_deployed",
      "add": [
        "test_link_presented"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_atk_cli",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fingerprint_workspace",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "edit_manifest",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "update_instructions_and_starters",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "deploy_agent",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "present_test_link",
        "by": "agent"
      }
    }
  ],
  "goal": "test_link_presented",
  "init_true": [],
  "init_constraints": []
}
