{
  "name": "constant-time-testing",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "write_harness": {
      "owner": "agent",
      "pre": true,
      "add": [
        "harness_written"
      ]
    },
    "run_dudect": {
      "owner": "agent",
      "pre": "harness_written",
      "add": [
        "dudect_run"
      ]
    },
    "run_timecop": {
      "owner": "agent",
      "pre": "dudect_run",
      "add": [
        "leak_localized"
      ]
    },
    "fix_code": {
      "owner": "agent",
      "pre": "leak_localized",
      "add": [
        "code_fixed"
      ]
    },
    "rerun_dudect": {
      "owner": "agent",
      "pre": "code_fixed",
      "add": [
        "timing_verified"
      ]
    },
    "accept_clean_result": {
      "owner": "agent",
      "pre": "dudect_run",
      "add": [
        "timing_verified"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_harness",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_dudect",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "leak_found": [
            {
              "act": {
                "cap": "run_timecop",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "fix_code",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "rerun_dudect",
                "by": "agent"
              }
            }
          ],
          "no_leak": [
            {
              "act": {
                "cap": "accept_clean_result",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": "timing_verified",
  "init_true": [],
  "init_constraints": []
}
