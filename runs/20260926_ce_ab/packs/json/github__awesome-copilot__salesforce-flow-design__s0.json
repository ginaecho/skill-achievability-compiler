{
  "name": "salesforce-flow-design",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "confirm_flow_is_right_tool": {
      "owner": "agent",
      "pre": true,
      "add": [
        "tool_confirmed"
      ]
    },
    "select_flow_type": {
      "owner": "agent",
      "pre": "tool_confirmed",
      "add": [
        "type_selected"
      ]
    },
    "bulk_safety_check": {
      "owner": "agent",
      "pre": "type_selected",
      "add": [
        "bulk_safety_validated"
      ]
    },
    "fault_path_check": {
      "owner": "agent",
      "pre": "type_selected",
      "add": [
        "fault_paths_validated"
      ]
    },
    "automation_density_check": {
      "owner": "agent",
      "pre": "type_selected",
      "add": [
        "density_checked"
      ]
    },
    "screen_ux_check": {
      "owner": "agent",
      "pre": "type_selected",
      "add": [
        "ux_checked"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "confirm_flow_is_right_tool",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "select_flow_type",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "bulk_safety_check",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fault_path_check",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "automation_density_check",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "screen_ux_check",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "deploy_flow",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "bulk_safety_validated",
      "fault_paths_validated",
      "density_checked",
      "flow_deployed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
