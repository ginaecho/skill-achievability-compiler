{
  "name": "slack-gif-creator",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "install_dependencies": {
      "owner": "agent",
      "add": [
        "deps_installed"
      ]
    },
    "generate_frames": {
      "owner": "agent",
      "pre": "deps_installed",
      "add": [
        "frames_generated"
      ]
    },
    "build_gif": {
      "owner": "agent",
      "pre": "frames_generated",
      "add": [
        "gif_saved"
      ]
    },
    "validate_gif": {
      "owner": "agent",
      "pre": "gif_saved",
      "nondet": {
        "gif_valid": true
      }
    },
    "deliver_gif": {
      "owner": "agent",
      "pre": "gif_valid",
      "add": [
        "delivered"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_dependencies",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_frames",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_gif",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_gif",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "deliver_gif",
        "by": "agent"
      }
    }
  ],
  "goal": "delivered",
  "init_true": [],
  "init_constraints": []
}
