{
  "name": "expo-upgrade",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "upgrade_deps": {
      "owner": "agent",
      "add": [
        "deps_upgraded"
      ]
    },
    "run_doctor": {
      "owner": "agent",
      "pre": "deps_upgraded",
      "add": [
        "doctor_run"
      ]
    },
    "clear_caches": {
      "owner": "agent",
      "pre": "doctor_run",
      "add": [
        "caches_cleared"
      ]
    },
    "check_breaking_changes": {
      "owner": "agent",
      "pre": "caches_cleared",
      "add": [
        "breaking_changes_checked"
      ]
    },
    "prebuild_native": {
      "owner": "agent",
      "pre": "breaking_changes_checked",
      "add": [
        "prebuilt"
      ]
    },
    "housekeeping": {
      "owner": "agent",
      "pre": "breaking_changes_checked",
      "add": [
        "housekeeping_done"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "upgrade_deps",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_doctor",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "clear_caches",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_breaking_changes",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "bare_workflow": [
            {
              "act": {
                "cap": "prebuild_native",
                "by": "agent"
              }
            }
          ],
          "cng": []
        }
      }
    },
    {
      "act": {
        "cap": "housekeeping",
        "by": "agent"
      }
    }
  ],
  "goal": "housekeeping_done",
  "init_true": [],
  "init_constraints": []
}
