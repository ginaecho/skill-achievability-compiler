{
  "name": "sentry-create-branch",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "inspect_git_state": {
      "owner": "agent",
      "add": [
        "state_known"
      ]
    },
    "determine_base_branch": {
      "owner": "agent",
      "pre": "state_known",
      "add": [
        "base_determined"
      ]
    },
    "check_name_available": {
      "owner": "agent",
      "pre": "base_determined",
      "add": [
        "name_available"
      ]
    },
    "create_branch": {
      "owner": "agent",
      "pre": "name_available",
      "add": [
        "branch_created"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_git_state",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "determine_base_branch",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_name_available",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_branch",
        "by": "agent"
      }
    }
  ],
  "goal": "branch_created",
  "init_true": [],
  "init_constraints": []
}
