{
  "name": "neon-auth",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "configure_managed_auth": {
      "owner": "agent",
      "pre": true,
      "add": [
        "auth_configured"
      ]
    },
    "deploy": {
      "owner": "agent",
      "pre": "auth_configured",
      "add": [
        "auth_deployed"
      ]
    },
    "implement_login": {
      "owner": "agent",
      "pre": "auth_deployed",
      "add": [
        "login_implemented"
      ]
    },
    "verify_auth_flows": {
      "owner": "agent",
      "pre": "login_implemented",
      "add": [
        "auth_verified"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "configure_managed_auth",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "deploy",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "implement_login",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_auth_flows",
        "by": "agent"
      }
    }
  ],
  "goal": "auth_verified",
  "init_true": [],
  "init_constraints": []
}
