{
  "name": "turnstile-spin",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "acknowledge_plan": {
      "owner": "agent",
      "pre": true,
      "add": [
        "ack_given"
      ]
    },
    "auth_probe": {
      "owner": "agent",
      "pre": "ack_given",
      "add": [
        "auth_ok"
      ]
    },
    "confirm_domains": {
      "owner": "agent",
      "pre": "auth_ok",
      "add": [
        "domain_confirmed"
      ]
    },
    "scan_codebase": {
      "owner": "agent",
      "pre": "domain_confirmed",
      "add": [
        "scan_done"
      ]
    },
    "confirm_insertion_plan": {
      "owner": "agent",
      "pre": "scan_done",
      "add": [
        "insertion_confirmed"
      ]
    },
    "create_widget": {
      "owner": "agent",
      "pre": "insertion_confirmed",
      "add": [
        "widget_ready"
      ]
    },
    "retrieve_existing_secret": {
      "owner": "agent",
      "pre": "insertion_confirmed",
      "add": [
        "widget_ready",
        "secret_stored"
      ]
    },
    "wire_integration": {
      "owner": "agent",
      "pre": "widget_ready",
      "add": [
        "integration_wired"
      ]
    },
    "store_secret": {
      "owner": "agent",
      "pre": "integration_wired",
      "add": [
        "secret_stored"
      ]
    },
    "validate_integration": {
      "owner": "agent",
      "pre": {
        "and": [
          "secret_stored",
          "integration_wired"
        ]
      },
      "add": [
        "validated"
      ]
    },
    "persist_skill": {
      "owner": "agent",
      "pre": "validated",
      "add": [
        "skill_persisted"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "acknowledge_plan",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "auth_probe",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "confirm_domains",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scan_codebase",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "confirm_insertion_plan",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "new_widget": [
            {
              "act": {
                "cap": "create_widget",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "wire_integration",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "store_secret",
                "by": "agent"
              }
            }
          ],
          "existing_widget": [
            {
              "act": {
                "cap": "retrieve_existing_secret",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "wire_integration",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "validate_integration",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "persist_skill",
        "by": "agent"
      }
    }
  ],
  "goal": "validated",
  "init_true": [],
  "init_constraints": []
}
