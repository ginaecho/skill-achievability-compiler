{
  "name": "theme-factory",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "show_showcase": {
      "owner": "agent",
      "pre": true,
      "add": [
        "showcase_shown"
      ]
    },
    "ask_choice": {
      "owner": "agent",
      "pre": "showcase_shown",
      "add": [
        "choice_asked"
      ]
    },
    "confirm_choice": {
      "owner": "agent",
      "pre": "choice_asked",
      "add": [
        "theme_confirmed"
      ]
    },
    "read_theme_file": {
      "owner": "agent",
      "pre": "theme_confirmed",
      "add": [
        "theme_read"
      ]
    },
    "apply_theme": {
      "owner": "agent",
      "pre": "theme_read",
      "add": [
        "theme_applied"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "show_showcase",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "ask_choice",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "selected": [
            {
              "act": {
                "cap": "confirm_choice",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "read_theme_file",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "apply_theme",
        "by": "agent"
      }
    }
  ],
  "goal": "theme_applied",
  "init_true": [],
  "init_constraints": []
}
