{
  "name": "aspire-deployment",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "aspire_publish": {
      "owner": "agent",
      "pre": true,
      "add": [
        "artifacts_ready"
      ]
    },
    "aspire_deploy_azure": {
      "owner": "agent",
      "pre": {
        "and": [
          "artifacts_ready",
          "target_access"
        ]
      },
      "add": [
        "azure_deployed"
      ]
    },
    "kubectl_apply": {
      "owner": "agent",
      "pre": {
        "and": [
          "artifacts_ready",
          "target_access"
        ]
      },
      "add": [
        "kubernetes_deployed"
      ]
    },
    "clear_deployment_cache": {
      "owner": "agent",
      "pre": true,
      "add": [
        "cache_cleared"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "aspire_publish",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "clear_cache_then_deploy": [
            {
              "act": {
                "cap": "clear_deployment_cache",
                "by": "agent"
              }
            }
          ],
          "deploy_directly": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "azure": [
            {
              "act": {
                "cap": "aspire_deploy_azure",
                "by": "agent"
              }
            }
          ],
          "kubernetes": [
            {
              "act": {
                "cap": "kubectl_apply",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "or": [
      "azure_deployed",
      "kubernetes_deployed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
