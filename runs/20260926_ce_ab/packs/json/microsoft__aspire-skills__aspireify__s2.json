{
  "name": "aspireify-wiring",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "scan_repo": {
      "owner": "agent",
      "pre": true,
      "add": [
        "scan_complete"
      ]
    },
    "propose_graph": {
      "owner": "agent",
      "pre": "scan_complete",
      "add": [
        "graph_proposed"
      ]
    },
    "edit_apphost": {
      "owner": "agent",
      "pre": "graph_proposed",
      "add": [
        "apphost_edited"
      ]
    },
    "validate_start": {
      "owner": "agent",
      "pre": "apphost_edited",
      "add": [
        "validated"
      ]
    },
    "deactivate": {
      "owner": "agent",
      "pre": "validated",
      "add": [
        "deactivated"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "scan_repo",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "propose_graph",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "confirm": [],
          "revise": []
        }
      }
    },
    {
      "act": {
        "cap": "edit_apphost",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_start",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "deactivate",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "validated",
      "deactivated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
