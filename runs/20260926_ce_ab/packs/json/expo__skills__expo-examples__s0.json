{
  "name": "expo-examples",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "find_example": {
      "owner": "agent",
      "add": [
        "example_found"
      ]
    },
    "read_example": {
      "owner": "agent",
      "pre": "example_found",
      "add": [
        "example_read"
      ]
    },
    "adapt_into_app": {
      "owner": "agent",
      "pre": "example_read",
      "add": [
        "adapted"
      ]
    },
    "scaffold_new_project": {
      "owner": "agent",
      "pre": "example_found",
      "add": [
        "scaffolded"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "find_example",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "inspiration_mode": [
            {
              "act": {
                "cap": "read_example",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "adapt_into_app",
                "by": "agent"
              }
            }
          ],
          "scaffold_mode": [
            {
              "act": {
                "cap": "scaffold_new_project",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "or": [
      "adapted",
      "scaffolded"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
