{
  "name": "slack-to-teams",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_platform": {
      "owner": "agent",
      "pre": true,
      "add": [
        "platform_chosen"
      ]
    },
    "read_expert_docs": {
      "owner": "agent",
      "pre": "platform_chosen",
      "add": [
        "experts_loaded"
      ]
    },
    "write_plan": {
      "owner": "agent",
      "pre": "experts_loaded",
      "add": [
        "plan_written"
      ]
    },
    "implement_features": {
      "owner": "agent",
      "pre": "plan_written",
      "add": [
        "features_implemented"
      ]
    },
    "analyze_existing_project": {
      "owner": "agent",
      "pre": true,
      "add": [
        "project_analyzed"
      ]
    },
    "gap_analysis": {
      "owner": "agent",
      "pre": "project_analyzed",
      "add": [
        "gaps_identified"
      ]
    },
    "build_missing_experts": {
      "owner": "agent",
      "pre": "gaps_identified",
      "add": [
        "experts_loaded"
      ]
    },
    "load_expert_system_existing": {
      "owner": "agent",
      "pre": "project_analyzed",
      "add": [
        "experts_loaded"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "new_project": [
            {
              "act": {
                "cap": "ask_platform",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "read_expert_docs",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "write_plan",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "implement_features",
                "by": "agent"
              }
            }
          ],
          "existing_project": [
            {
              "act": {
                "cap": "analyze_existing_project",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "gap_analysis",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "build_missing_experts",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "load_expert_system_existing",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "write_plan",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "implement_features",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "plan_written",
      "features_implemented"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
