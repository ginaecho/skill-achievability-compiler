{
  "name": "graph-evolution-analysis",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "install_trailmark": {
      "owner": "agent",
      "add": [
        "trailmark_installed"
      ]
    },
    "create_snapshots": {
      "owner": "agent",
      "add": [
        "snapshots_created"
      ]
    },
    "build_graphs": {
      "owner": "agent",
      "pre": {
        "and": [
          "snapshots_created",
          "trailmark_installed"
        ]
      },
      "add": [
        "graphs_built"
      ]
    },
    "run_preanalysis": {
      "owner": "agent",
      "pre": "graphs_built",
      "add": [
        "preanalysis_done"
      ]
    },
    "compute_native_diff": {
      "owner": "agent",
      "pre": "preanalysis_done",
      "add": [
        "native_diff_computed"
      ]
    },
    "compute_subgraph_diff": {
      "owner": "agent",
      "pre": "preanalysis_done",
      "add": [
        "subgraph_diff_computed"
      ]
    },
    "generate_report": {
      "owner": "agent",
      "pre": {
        "and": [
          "native_diff_computed",
          "subgraph_diff_computed"
        ]
      },
      "add": [
        "report_generated"
      ]
    },
    "cleanup_worktrees": {
      "owner": "agent",
      "pre": "report_generated",
      "add": [
        "worktrees_cleaned"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_trailmark",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_snapshots",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_graphs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_preanalysis",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "compute_native_diff",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "compute_subgraph_diff",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_report",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "cleanup_worktrees",
        "by": "agent"
      }
    }
  ],
  "goal": "report_generated",
  "init_true": [],
  "init_constraints": []
}
