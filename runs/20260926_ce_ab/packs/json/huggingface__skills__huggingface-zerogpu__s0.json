{
  "name": "huggingface-zerogpu",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "write_module_code": {
      "owner": "agent",
      "pre": true,
      "add": [
        "models_loaded"
      ]
    },
    "decorate_gpu_function": {
      "owner": "agent",
      "pre": "models_loaded",
      "add": [
        "gpu_function_decorated"
      ]
    },
    "configure_duration": {
      "owner": "agent",
      "pre": "gpu_function_decorated",
      "add": [
        "duration_configured"
      ]
    },
    "configure_dependencies": {
      "owner": "agent",
      "pre": true,
      "add": [
        "deps_configured"
      ]
    },
    "deploy_space": {
      "owner": "agent",
      "pre": {
        "and": [
          "duration_configured",
          "deps_configured"
        ]
      },
      "add": [
        "space_deployed"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_module_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "decorate_gpu_function",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_duration",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_dependencies",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "deploy_space",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "space_deployed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
