{
  "name": "hf-cloud-sagemaker-production-defaults",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "run_deploy_script": {
      "owner": "agent",
      "pre": true,
      "add": [
        "endpoint_created",
        "model_created",
        "autoscaling_configured",
        "alarms_configured"
      ]
    },
    "smoke_test_invocation": {
      "owner": "agent",
      "pre": "endpoint_created",
      "add": [
        "invocation_verified"
      ]
    },
    "scan_logs": {
      "owner": "agent",
      "pre": "endpoint_created",
      "add": [
        "logs_scanned"
      ]
    },
    "report_deployment": {
      "owner": "agent",
      "pre": {
        "and": [
          "invocation_verified",
          "logs_scanned"
        ]
      },
      "add": [
        "deployment_reported"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "run_deploy_script",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "smoke_test_invocation",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scan_logs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "report_deployment",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "endpoint_created",
      "autoscaling_configured",
      "alarms_configured",
      "deployment_reported"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
