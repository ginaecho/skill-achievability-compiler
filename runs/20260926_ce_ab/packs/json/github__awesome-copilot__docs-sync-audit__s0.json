{
  "name": "docs-sync-audit",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "establish_source_of_truth": {
      "owner": "agent",
      "pre": true,
      "add": [
        "source_established"
      ]
    },
    "locate_documentation": {
      "owner": "agent",
      "pre": "source_established",
      "add": [
        "docs_located"
      ]
    },
    "run_drift_script": {
      "owner": "agent",
      "pre": "docs_located",
      "add": [
        "drift_checked"
      ]
    },
    "compare_code_and_docs": {
      "owner": "agent",
      "pre": "drift_checked",
      "add": [
        "comparison_done"
      ]
    },
    "verify_safely": {
      "owner": "agent",
      "pre": "comparison_done",
      "add": [
        "verified"
      ]
    },
    "produce_report": {
      "owner": "agent",
      "pre": "verified",
      "add": [
        "report_delivered"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "establish_source_of_truth",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "locate_documentation",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_drift_script",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "compare_code_and_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_safely",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "produce_report",
        "by": "agent"
      }
    }
  ],
  "goal": "report_delivered",
  "init_true": [],
  "init_constraints": []
}
