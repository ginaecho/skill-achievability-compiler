{
  "name": "neon-object-storage-setup",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "confirm_region_availability": {
      "owner": "agent",
      "pre": true,
      "add": [
        "region_confirmed"
      ]
    },
    "declare_bucket_config": {
      "owner": "agent",
      "pre": "region_confirmed",
      "add": [
        "config_declared"
      ]
    },
    "apply_config": {
      "owner": "agent",
      "pre": "config_declared",
      "add": [
        "bucket_provisioned"
      ]
    },
    "pull_env": {
      "owner": "agent",
      "pre": "bucket_provisioned",
      "add": [
        "env_ready"
      ]
    },
    "install_sdk": {
      "owner": "agent",
      "pre": true,
      "add": [
        "sdk_installed"
      ]
    },
    "implement_upload_download": {
      "owner": "agent",
      "pre": {
        "and": [
          "env_ready",
          "sdk_installed"
        ]
      },
      "add": [
        "flow_implemented"
      ]
    },
    "verify_flow": {
      "owner": "agent",
      "pre": "flow_implemented",
      "add": [
        "flow_verified"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "confirm_region_availability",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "declare_bucket_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "apply_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "pull_env",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_sdk",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "implement_upload_download",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_flow",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "bucket_provisioned",
      "flow_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
