{
  "name": "mcp-builder",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_user_clarification": {
      "owner": "agent",
      "pre": true,
      "add": [
        "user_clarified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_reference_files": {
      "owner": "agent",
      "pre": true,
      "add": [
        "references_loaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_web_docs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "web_docs_loaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "search_api_docs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "api_understood"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_project_files": {
      "owner": "agent",
      "pre": true,
      "add": [
        "project_structure_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_server_code": {
      "owner": "agent",
      "pre": {
        "and": [
          "project_structure_created",
          "api_understood"
        ]
      },
      "add": [
        "core_infrastructure_implemented",
        "tools_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "review_code_quality": {
      "owner": "agent",
      "pre": "tools_implemented",
      "add": [
        "code_review_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_build_and_tests": {
      "owner": "agent",
      "pre": "tools_implemented",
      "add": [],
      "del": [],
      "assigns": {},
      "nondet": {
        "build_ok": {
          "or": [
            {
              "cmp": [
                "build_ok",
                "==",
                0
              ]
            },
            {
              "cmp": [
                "build_ok",
                "==",
                1
              ]
            }
          ]
        }
      }
    },
    "revise_implementation": {
      "owner": "agent",
      "pre": {
        "cmp": [
          "build_ok",
          "==",
          0
        ]
      },
      "add": [],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "clarify": [
            {
              "act": {
                "cap": "ask_user_clarification",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    },
    {
      "act": {
        "cap": "read_reference_files",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_web_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "search_api_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_project_files",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "implement_server_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "review_code_quality",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "fix_build_loop",
        "body": [
          {
            "act": {
              "cap": "run_build_and_tests",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "pass": [],
                "fail": [
                  {
                    "act": {
                      "cap": "revise_implementation",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "fix_build_loop"
                  }
                ]
              }
            }
          }
        ]
      }
    },
    {
      "act": {
        "cap": "create_evaluation_xml",
        "by": "agent"
      }
    },
    {
      "goal": {
        "and": [
          "tools_implemented",
          "core_infrastructure_implemented",
          "code_review_done",
          {
            "cmp": [
              "build_ok",
              "==",
              1
            ]
          },
          "evaluation_created",
          {
            "cmp": [
              "qa_count",
              "==",
              10
            ]
          }
        ]
      }
    }
  ],
  "goal": {
    "and": [
      "tools_implemented",
      "core_infrastructure_implemented",
      "code_review_done",
      {
        "cmp": [
          "build_ok",
          "==",
          1
        ]
      },
      "evaluation_created",
      {
        "cmp": [
          "qa_count",
          "==",
          10
        ]
      }
    ]
  },
  "init_true": [],
  "init_constraints": [
    {
      "or": [
        {
          "cmp": [
            "build_ok",
            "==",
            0
          ]
        },
        {
          "cmp": [
            "build_ok",
            "==",
            1
          ]
        }
      ]
    }
  ]
}
