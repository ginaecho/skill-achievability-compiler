{
  "name": "neon-postgres-egress-optimizer",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "diagnose_egress": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:postgres_database"
        ]
      },
      "add": [
        "egress_diagnosed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "analyze_codebase": {
      "owner": "agent",
      "pre": true,
      "add": [
        "codebase_analyzed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "apply_fixes": {
      "owner": "agent",
      "pre": "codebase_analyzed",
      "add": [
        "fixes_applied"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_fixes": {
      "owner": "agent",
      "pre": "fixes_applied",
      "add": [
        "fixes_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "stats_available": [
            {
              "act": {
                "cap": "diagnose_egress",
                "by": "agent"
              }
            }
          ],
          "no_stats": []
        }
      }
    },
    {
      "act": {
        "cap": "analyze_codebase",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "apply_fixes",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_fixes",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "fixes_applied",
      "fixes_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
