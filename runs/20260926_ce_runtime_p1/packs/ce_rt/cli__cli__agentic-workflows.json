{
  "name": "agentic-workflows",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "read_workflow_docs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "docs_loaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_workflow_file": {
      "owner": "agent",
      "pre": "docs_loaded",
      "add": [
        "workflow_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_workflow_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_workflow_file",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "docs_loaded",
      "workflow_created"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
