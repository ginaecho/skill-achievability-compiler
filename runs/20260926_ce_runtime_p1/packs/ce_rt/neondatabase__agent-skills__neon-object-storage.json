{
  "name": "neon-object-storage",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_region": {
      "owner": "agent",
      "pre": true,
      "add": [
        "region_confirmed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "declare_buckets": {
      "owner": "agent",
      "pre": "region_confirmed",
      "add": [
        "buckets_declared"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "provision_buckets": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:neon_account",
          "buckets_declared"
        ]
      },
      "add": [
        "buckets_provisioned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "pull_env_vars": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:neon_account",
          "buckets_provisioned"
        ]
      },
      "add": [
        "env_vars_pulled"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "upload_download_flow": {
      "owner": "agent",
      "pre": "env_vars_pulled",
      "add": [
        "upload_download_working"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_region",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "declare_buckets",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "provision_buckets",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "pull_env_vars",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "upload_download_flow",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "buckets_provisioned",
      "upload_download_working"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
