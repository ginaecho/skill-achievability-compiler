{
  "name": "neon-auth",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "configure_auth": {
      "owner": "agent",
      "pre": true,
      "add": [
        "auth_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_config": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:neon_account",
          "auth_configured"
        ]
      },
      "add": [
        "auth_deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_status": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:neon_account",
          "auth_deployed"
        ]
      },
      "add": [
        "status_confirmed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_login_ui": {
      "owner": "agent",
      "pre": "auth_deployed",
      "add": [
        "login_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_flows": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:neon_account",
          "login_implemented"
        ]
      },
      "add": [
        "flows_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "configure_auth",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "deploy_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_status",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "implement_login_ui",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_flows",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "auth_deployed",
      "login_implemented",
      "flows_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
