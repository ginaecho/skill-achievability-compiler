{
  "name": "cli-exercise",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_prerequisites": {
      "owner": "agent",
      "pre": true,
      "add": [
        "prereqs_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_dependencies": {
      "owner": "agent",
      "pre": "prereqs_checked",
      "add": [
        "dependencies_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "prepare_case": {
      "owner": "agent",
      "pre": "prereqs_checked",
      "add": [
        "case_prepared"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "execute_invocation": {
      "owner": "agent",
      "pre": "case_prepared",
      "add": [
        "case_executed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_case": {
      "owner": "agent",
      "pre": "case_executed",
      "add": [
        "case_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "render_video": {
      "owner": "agent",
      "pre": "case_validated",
      "add": [
        "video_rendered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "render_html": {
      "owner": "agent",
      "pre": "case_validated",
      "add": [
        "html_rendered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "cleanup": {
      "owner": "agent",
      "pre": "video_rendered",
      "add": [
        "cleaned_up"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_prerequisites",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "needs_setup": [
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "approve": [
                    {
                      "act": {
                        "cap": "install_dependencies",
                        "by": "agent"
                      }
                    }
                  ],
                  "decline": []
                }
              }
            }
          ],
          "ready": []
        }
      }
    },
    {
      "act": {
        "cap": "prepare_case",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "execute_invocation",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_case",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "render_video",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "wants_html": [
            {
              "act": {
                "cap": "render_html",
                "by": "agent"
              }
            }
          ],
          "video_only": []
        }
      }
    },
    {
      "act": {
        "cap": "cleanup",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "video_rendered",
      "cleaned_up"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
