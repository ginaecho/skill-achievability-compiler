{
  "name": "provider-test-patterns",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "write_test_file": {
      "owner": "agent",
      "pre": true,
      "add": [
        "tests_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_acceptance_tests": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:cloud_provider_credentials",
          "tests_written"
        ]
      },
      "add": [
        "tests_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_test_file",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "run_tests": [
            {
              "act": {
                "cap": "run_acceptance_tests",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": "tests_written",
  "init_true": [],
  "init_constraints": []
}
