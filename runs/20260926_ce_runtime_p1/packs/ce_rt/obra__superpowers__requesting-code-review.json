{
  "name": "requesting-code-review",
  "roles": [
    "agent",
    "reviewer"
  ],
  "capabilities": {
    "get_shas": {
      "owner": "agent",
      "pre": true,
      "add": [
        "shas_obtained"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fix_issues": {
      "owner": "agent",
      "pre": "shas_obtained",
      "add": [
        "issues_fixed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "get_shas",
        "by": "agent"
      }
    },
    {
      "spawn": {
        "role": "reviewer"
      }
    },
    {
      "msg": {
        "from": "reviewer",
        "to": "agent",
        "label": "review_feedback"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "issues_found": [
            {
              "act": {
                "cap": "fix_issues",
                "by": "agent"
              }
            }
          ],
          "clean": []
        }
      }
    }
  ],
  "goal": "shas_obtained",
  "init_true": [],
  "init_constraints": []
}
