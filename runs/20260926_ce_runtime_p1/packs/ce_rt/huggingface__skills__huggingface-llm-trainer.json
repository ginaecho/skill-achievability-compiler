{
  "name": "huggingface-llm-trainer",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "validate_dataset": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:huggingface_account"
        ]
      },
      "add": [
        "dataset_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip_validation": []
        }
      }
    },
    {
      "act": {
        "cap": "submit_training_job",
        "by": "agent"
      }
    }
  ],
  "goal": "job_submitted",
  "init_true": [],
  "init_constraints": []
}
