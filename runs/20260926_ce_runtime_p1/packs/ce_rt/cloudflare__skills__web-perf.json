{
  "name": "web-perf",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "analyze_codebase": {
      "owner": "agent",
      "pre": true,
      "add": [
        "codebase_analyzed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "navigate_page",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "start_trace",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "analyze_insight",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "list_network_requests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "take_snapshot",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "codebase_access": [
            {
              "act": {
                "cap": "analyze_codebase",
                "by": "agent"
              }
            }
          ],
          "third_party_site": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "vitals_analyzed",
      "network_analyzed",
      "a11y_analyzed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
