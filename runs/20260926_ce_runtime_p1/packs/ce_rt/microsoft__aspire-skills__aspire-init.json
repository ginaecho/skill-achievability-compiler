{
  "name": "aspire-init",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_prereqs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "prereqs_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "aspire_new": {
      "owner": "agent",
      "pre": "prereqs_checked",
      "add": [
        "apphost_ready",
        "resources_wired"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "aspire_init_cmd": {
      "owner": "agent",
      "pre": "prereqs_checked",
      "add": [
        "apphost_ready",
        "skeleton_dropped"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "wire_resources": {
      "owner": "agent",
      "pre": "skeleton_dropped",
      "add": [
        "resources_wired"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_prereqs",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "new_project": [
            {
              "act": {
                "cap": "aspire_new",
                "by": "agent"
              }
            }
          ],
          "existing_repo": [
            {
              "act": {
                "cap": "aspire_init_cmd",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "wire_resources",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "apphost_ready",
      "resources_wired"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
