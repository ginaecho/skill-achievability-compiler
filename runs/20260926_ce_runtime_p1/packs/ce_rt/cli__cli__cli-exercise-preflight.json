{
  "name": "cli-exercise-preflight",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "build_helper": {
      "owner": "agent",
      "pre": true,
      "add": [
        "helper_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_preflight_check": {
      "owner": "agent",
      "pre": "helper_built",
      "add": [
        "capabilities_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_dependency": {
      "owner": "agent",
      "pre": "capabilities_checked",
      "add": [
        "dependency_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "build_helper",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_preflight_check",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "dependency_missing": [
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "approve": [
                    {
                      "act": {
                        "cap": "install_dependency",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "run_preflight_check",
                        "by": "agent"
                      }
                    }
                  ],
                  "decline": []
                }
              }
            }
          ],
          "all_present": []
        }
      }
    }
  ],
  "goal": "capabilities_checked",
  "init_true": [],
  "init_constraints": []
}
