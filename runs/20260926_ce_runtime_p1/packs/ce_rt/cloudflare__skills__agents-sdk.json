{
  "name": "agents-sdk",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_installed": {
      "owner": "agent",
      "pre": true,
      "add": [
        "install_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_package": {
      "owner": "agent",
      "pre": "install_checked",
      "add": [
        "package_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_wrangler": {
      "owner": "agent",
      "pre": "install_checked",
      "add": [
        "wrangler_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_agent_code": {
      "owner": "agent",
      "pre": "wrangler_configured",
      "add": [
        "agent_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_installed",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "not_installed": [
            {
              "act": {
                "cap": "install_package",
                "by": "agent"
              }
            }
          ],
          "installed": []
        }
      }
    },
    {
      "act": {
        "cap": "configure_wrangler",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_agent_code",
        "by": "agent"
      }
    }
  ],
  "goal": "agent_written",
  "init_true": [],
  "init_constraints": []
}
