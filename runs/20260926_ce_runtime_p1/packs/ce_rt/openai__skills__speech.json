{
  "name": "speech",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "install_deps": {
      "owner": "agent",
      "pre": true,
      "add": [
        "deps_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_batch_file": {
      "owner": "agent",
      "pre": true,
      "add": [
        "batch_file_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_tts_cli": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:openai_api_key",
          "deps_installed"
        ]
      },
      "add": [
        "audio_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "save_output": {
      "owner": "agent",
      "pre": "audio_generated",
      "add": [
        "output_saved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_deps",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "single": [],
          "batch": [
            {
              "act": {
                "cap": "write_batch_file",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "run_tts_cli",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "save_output",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "audio_generated",
      "output_saved"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
