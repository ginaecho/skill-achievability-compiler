{
  "name": "terraform-policy",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_cli_version": {
      "owner": "agent",
      "pre": true,
      "add": [
        "version_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "author_policy": {
      "owner": "agent",
      "pre": "version_known",
      "add": [
        "policy_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "author_policytest": {
      "owner": "agent",
      "pre": "policy_written",
      "add": [
        "test_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_tfpolicy_test": {
      "owner": "agent",
      "pre": "test_written",
      "add": [
        "tests_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_cli_version",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "author_policy",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "write_test": [
            {
              "act": {
                "cap": "author_policytest",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "run_tfpolicy_test",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": "policy_written",
  "init_true": [],
  "init_constraints": []
}
