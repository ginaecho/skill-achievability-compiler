{
  "name": "preset",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_auth": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account"
        ]
      },
      "add": [
        "auth_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "get_project": {
      "owner": "agent",
      "pre": "auth_verified",
      "add": [
        "project_resolved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "select_model": {
      "owner": "agent",
      "pre": "project_resolved",
      "add": [
        "model_selected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_capacity": {
      "owner": "agent",
      "pre": "model_selected",
      "add": [
        "capacity_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "query_regions": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "capacity_checked"
        ]
      },
      "add": [
        "region_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_model": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "capacity_checked"
        ]
      },
      "add": [
        "model_deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_auth",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "get_project",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "select_model",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_capacity",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "capacity_available": [
            {
              "act": {
                "cap": "deploy_model",
                "by": "agent"
              }
            }
          ],
          "no_capacity": [
            {
              "act": {
                "cap": "query_regions",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "deploy_model",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": "model_deployed",
  "init_true": [],
  "init_constraints": []
}
