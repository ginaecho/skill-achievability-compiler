{
  "name": "systematic-debugging",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "reproduce_bug": {
      "owner": "agent",
      "pre": true,
      "add": [
        "reproduced"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_recent_changes": {
      "owner": "agent",
      "pre": "reproduced",
      "add": [
        "changes_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "add_diagnostics": {
      "owner": "agent",
      "pre": "changes_checked",
      "add": [
        "diagnostics_added"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "gather_evidence": {
      "owner": "agent",
      "pre": "diagnostics_added",
      "add": [
        "root_cause_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_failing_test": {
      "owner": "agent",
      "pre": "root_cause_found",
      "add": [
        "test_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_fix": {
      "owner": "agent",
      "pre": "test_written",
      "add": [
        "fix_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_tests": {
      "owner": "agent",
      "pre": "fix_implemented",
      "add": [
        "tests_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "reproduce_bug",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_recent_changes",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "add_diagnostics",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "gather_evidence",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "attempt",
        "body": [
          {
            "act": {
              "cap": "write_failing_test",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "implement_fix",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "run_tests",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "pass": [],
                "fail": [
                  {
                    "continue": "attempt"
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "goal": "tests_pass",
  "init_true": [],
  "init_constraints": []
}
