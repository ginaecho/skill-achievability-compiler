{
  "name": "declarative-agent-developer",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_atk_cli": {
      "owner": "agent",
      "pre": true,
      "add": [
        "atk_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scaffold_agent": {
      "owner": "agent",
      "pre": "atk_installed",
      "add": [
        "manifest_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "update_instructions": {
      "owner": "agent",
      "pre": "manifest_created",
      "add": [
        "instructions_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_agent": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:m365_account",
          {
            "and": [
              "manifest_created",
              "instructions_updated"
            ]
          }
        ]
      },
      "add": [
        "deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "get_test_link": {
      "owner": "agent",
      "pre": "deployed",
      "add": [
        "test_link_shown"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_atk_cli",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scaffold_agent",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "update_instructions",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "deploy_agent",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "get_test_link",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "manifest_created",
      "instructions_updated",
      "deployed",
      "test_link_shown"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
