{
  "name": "cli-creator",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_existing_command": {
      "owner": "agent",
      "pre": true,
      "add": [
        "command_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "inspect_toolchain": {
      "owner": "agent",
      "pre": "command_checked",
      "add": [
        "toolchain_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scaffold_cli": {
      "owner": "agent",
      "pre": "toolchain_known",
      "add": [
        "cli_scaffolded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_commands": {
      "owner": "agent",
      "pre": "cli_scaffolded",
      "add": [
        "commands_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_tests": {
      "owner": "agent",
      "pre": "commands_implemented",
      "add": [
        "tests_passed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_cli": {
      "owner": "agent",
      "pre": "commands_implemented",
      "add": [
        "cli_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "smoke_test": {
      "owner": "agent",
      "pre": "cli_installed",
      "add": [
        "smoke_tested"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_companion_skill": {
      "owner": "agent",
      "pre": "smoke_tested",
      "add": [
        "companion_skill_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_existing_command",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "inspect_toolchain",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scaffold_cli",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "implement_commands",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_tests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_cli",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "smoke_test",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_companion_skill",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "cli_installed",
      "smoke_tested",
      "tests_passed",
      "companion_skill_created"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
