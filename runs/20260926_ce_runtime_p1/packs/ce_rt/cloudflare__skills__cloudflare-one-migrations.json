{
  "name": "cloudflare-one-migrations",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "fetch_docs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "docs_retrieved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "request_exports": {
      "owner": "agent",
      "pre": true,
      "add": [
        "exports_received"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_inventory": {
      "owner": "agent",
      "pre": {
        "and": [
          "docs_retrieved",
          "exports_received"
        ]
      },
      "add": [
        "inventory_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_assessment": {
      "owner": "agent",
      "pre": "inventory_built",
      "add": [
        "assessment_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "stage_rules": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:cloudflare_account",
          "assessment_written"
        ]
      },
      "add": [
        "rules_staged"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "fetch_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "request_exports",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_inventory",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_assessment",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "stage_config": [
            {
              "act": {
                "cap": "stage_rules",
                "by": "agent"
              }
            }
          ],
          "plan_only": []
        }
      }
    }
  ],
  "goal": "assessment_written",
  "init_true": [],
  "init_constraints": []
}
