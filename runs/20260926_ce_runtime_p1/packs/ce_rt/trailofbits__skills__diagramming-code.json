{
  "name": "diagramming-code",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_trailmark": {
      "owner": "agent",
      "pre": true,
      "add": [
        "checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_trailmark": {
      "owner": "agent",
      "pre": "checked",
      "add": [
        "installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_preanalysis": {
      "owner": "agent",
      "pre": "checked",
      "add": [
        "preanalysis_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_diagram_script": {
      "owner": "agent",
      "pre": "preanalysis_done",
      "add": [
        "diagram_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_trailmark",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "not_installed": [
            {
              "act": {
                "cap": "install_trailmark",
                "by": "agent"
              }
            }
          ],
          "installed": []
        }
      }
    },
    {
      "act": {
        "cap": "run_preanalysis",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_diagram_script",
        "by": "agent"
      }
    }
  ],
  "goal": "diagram_generated",
  "init_true": [],
  "init_constraints": []
}
