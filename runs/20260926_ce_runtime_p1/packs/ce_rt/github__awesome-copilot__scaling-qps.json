{
  "name": "qdrant-scaling-qps",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "apply_segment_config": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:qdrant_account"
        ]
      },
      "add": [
        "segments_tuned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "enable_quantization": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:qdrant_account"
        ]
      },
      "add": [
        "quantization_enabled"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "add_read_replicas": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:qdrant_account",
          "segments_tuned"
        ]
      },
      "add": [
        "replicas_added"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "apply_segment_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "enable_quantization",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "segments_tuned",
      "quantization_enabled"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
