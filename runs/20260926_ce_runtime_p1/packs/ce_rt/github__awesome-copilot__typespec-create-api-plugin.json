{
  "name": "typespec-create-api-plugin",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "gather_requirements": {
      "owner": "agent",
      "pre": true,
      "add": [
        "requirements_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_actions": {
      "owner": "agent",
      "pre": "requirements_known",
      "add": [
        "actions_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_main": {
      "owner": "agent",
      "pre": "actions_written",
      "add": [
        "main_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_card": {
      "owner": "agent",
      "pre": "main_written",
      "add": [
        "card_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "gather_requirements",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_actions",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_main",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "cards_needed": [
            {
              "act": {
                "cap": "write_card",
                "by": "agent"
              }
            }
          ],
          "no_cards": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "actions_written",
      "main_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
