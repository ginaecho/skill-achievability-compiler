{
  "name": "nextjs-on-cloudflare",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "install_upstream_skills": {
      "owner": "agent",
      "pre": true,
      "add": [
        "skills_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_project": {
      "owner": "agent",
      "pre": true,
      "add": [
        "project_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_dev_server": {
      "owner": "agent",
      "pre": "project_created",
      "add": [
        "dev_server_running"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "install": [
            {
              "act": {
                "cap": "install_upstream_skills",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    },
    {
      "act": {
        "cap": "create_project",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_dev_server",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "project_created",
      "dev_server_running"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
