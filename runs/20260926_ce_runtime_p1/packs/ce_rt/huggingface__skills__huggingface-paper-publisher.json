{
  "name": "huggingface-paper-publisher",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "index_paper": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:hf_write_token"
        ]
      },
      "add": [
        "paper_indexed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "link_paper": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:hf_write_token",
          "paper_indexed"
        ]
      },
      "add": [
        "paper_linked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "claim_authorship": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:hf_write_token",
          "paper_indexed"
        ]
      },
      "add": [
        "authorship_claimed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "index_paper",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "link_paper",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "claim": [
            {
              "act": {
                "cap": "claim_authorship",
                "by": "agent"
              }
            }
          ],
          "skip_claim": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "paper_indexed",
      "paper_linked"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
