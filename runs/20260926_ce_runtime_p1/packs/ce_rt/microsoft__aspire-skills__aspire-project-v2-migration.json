{
  "name": "aspire-project-v2-migration",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inventory_apphost": {
      "owner": "agent",
      "pre": true,
      "add": [
        "inventoried"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "resolve_version": {
      "owner": "agent",
      "pre": "inventoried",
      "add": [
        "version_resolved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "apply_migration": {
      "owner": "agent",
      "pre": "version_resolved",
      "add": [
        "migration_applied"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_migration": {
      "owner": "agent",
      "pre": "migration_applied",
      "add": [
        "validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inventory_apphost",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "resolve_version",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "eligible": [
            {
              "msg": {
                "from": "agent",
                "to": "user",
                "label": "migration_plan"
              }
            },
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "approve": [
                    {
                      "act": {
                        "cap": "apply_migration",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "validate_migration",
                        "by": "agent"
                      }
                    }
                  ],
                  "reject": []
                }
              }
            }
          ],
          "ineligible": []
        }
      }
    }
  ],
  "goal": "validated",
  "init_true": [],
  "init_constraints": []
}
