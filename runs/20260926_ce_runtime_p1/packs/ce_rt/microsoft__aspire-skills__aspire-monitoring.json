{
  "name": "aspire-monitoring",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "aspire_describe": {
      "owner": "agent",
      "pre": true,
      "add": [
        "resource_state_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "aspire_otel_logs": {
      "owner": "agent",
      "pre": "resource_state_known",
      "add": [
        "structured_logs_collected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "aspire_logs": {
      "owner": "agent",
      "pre": "resource_state_known",
      "add": [
        "console_logs_collected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "aspire_otel_traces": {
      "owner": "agent",
      "pre": "resource_state_known",
      "add": [
        "traces_collected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "aspire_export": {
      "owner": "agent",
      "pre": true,
      "add": [
        "telemetry_exported"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "aspire_describe",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "aspire_otel_logs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "aspire_logs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "aspire_otel_traces",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "export_snapshot": [
            {
              "act": {
                "cap": "aspire_export",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "resource_state_known",
      "structured_logs_collected",
      "console_logs_collected",
      "traces_collected"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
