{
  "name": "huggingface-trackio",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "init_tracking": {
      "owner": "agent",
      "pre": true,
      "add": [
        "tracking_initialized"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "log_metrics": {
      "owner": "agent",
      "pre": "tracking_initialized",
      "add": [
        "metrics_logged"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "finish_tracking": {
      "owner": "agent",
      "pre": "metrics_logged",
      "add": [
        "tracking_finished"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "retrieve_metrics": {
      "owner": "agent",
      "pre": "tracking_finished",
      "add": [
        "metrics_retrieved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "init_tracking",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "log_metrics",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "finish_tracking",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "retrieve_metrics",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "metrics_logged",
      "tracking_finished",
      "metrics_retrieved"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
