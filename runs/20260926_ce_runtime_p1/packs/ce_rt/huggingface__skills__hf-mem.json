{
  "name": "hf-mem",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "install_uv": {
      "owner": "agent",
      "pre": true,
      "add": [
        "uv_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_hf_mem": {
      "owner": "agent",
      "pre": "uv_installed",
      "add": [
        "memory_estimated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_hf_mem_gated": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:hf_token",
          "uv_installed"
        ]
      },
      "add": [
        "memory_estimated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_uv",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "gated_model": [
            {
              "act": {
                "cap": "run_hf_mem_gated",
                "by": "agent"
              }
            }
          ],
          "public_model": [
            {
              "act": {
                "cap": "run_hf_mem",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": "memory_estimated",
  "init_true": [],
  "init_constraints": []
}
