{
  "name": "cli-exercise-explore",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "run_case": {
      "owner": "agent",
      "pre": true,
      "add": [
        "case_executed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_case": {
      "owner": "agent",
      "pre": "case_executed",
      "add": [
        "case_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "record_evidence": {
      "owner": "agent",
      "pre": "case_validated",
      "add": [
        "evidence_recorded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "cleanup": {
      "owner": "agent",
      "pre": "case_validated",
      "add": [
        "cleanup_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "run_case",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_case",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "record_evidence",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "cleanup": [
            {
              "act": {
                "cap": "cleanup",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "case_validated",
      "evidence_recorded"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
