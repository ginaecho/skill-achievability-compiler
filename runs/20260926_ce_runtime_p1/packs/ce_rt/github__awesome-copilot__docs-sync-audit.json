{
  "name": "docs-sync-audit",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_git_status": {
      "owner": "agent",
      "pre": true,
      "add": [
        "git_status_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_docs_drift_script": {
      "owner": "agent",
      "pre": "git_status_checked",
      "add": [
        "drift_analyzed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_verification_checks": {
      "owner": "agent",
      "pre": "drift_analyzed",
      "add": [
        "verification_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "update_docs": {
      "owner": "agent",
      "pre": "verification_done",
      "add": [
        "docs_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_git_status",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_docs_drift_script",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_verification_checks",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "request_update": [
            {
              "act": {
                "cap": "update_docs",
                "by": "agent"
              }
            }
          ],
          "read_only": []
        }
      }
    }
  ],
  "goal": "verification_done",
  "init_true": [],
  "init_constraints": []
}
