{
  "name": "hf-cloud-sagemaker-production-defaults",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "deploy_endpoint": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:aws_account"
        ]
      },
      "add": [
        "endpoint_deployed",
        "autoscaling_configured",
        "alarms_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "invoke_endpoint": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:aws_account",
          "endpoint_deployed"
        ]
      },
      "add": [
        "smoke_tested"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scan_logs": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:aws_account",
          "endpoint_deployed"
        ]
      },
      "add": [
        "logs_scanned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "deploy_endpoint",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "invoke_endpoint",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scan_logs",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "endpoint_deployed",
      "autoscaling_configured",
      "alarms_configured",
      "smoke_tested",
      "logs_scanned"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
