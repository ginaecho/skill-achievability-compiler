{
  "name": "huggingface-lora-space-builder",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_lora_repo": {
      "owner": "agent",
      "pre": true,
      "add": [
        "lora_info_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "pick_pipeline": {
      "owner": "agent",
      "pre": "lora_info_gathered",
      "add": [
        "pipeline_picked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_space_files": {
      "owner": "agent",
      "pre": "pipeline_picked",
      "add": [
        "files_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "publish_space": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:hf_account",
          "files_written"
        ]
      },
      "add": [
        "space_published"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "wait_build": {
      "owner": "agent",
      "pre": "space_published",
      "add": [
        "build_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "smoke_test": {
      "owner": "agent",
      "pre": "build_ready",
      "add": [
        "smoke_test_passed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_lora_repo",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "pick_pipeline",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_space_files",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "approve": [
            {
              "act": {
                "cap": "publish_space",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "wait_build",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "smoke_test",
                "by": "agent"
              }
            }
          ],
          "reject": []
        }
      }
    }
  ],
  "goal": "smoke_test_passed",
  "init_true": [],
  "init_constraints": []
}
