{
  "name": "eas-hosting",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "install_cli": {
      "owner": "agent",
      "pre": true,
      "add": [
        "cli_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "eas_login": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:eas_account",
          "cli_installed"
        ]
      },
      "add": [
        "logged_in"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "export_bundle": {
      "owner": "agent",
      "pre": true,
      "add": [
        "bundle_exported"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "eas_deploy": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:eas_account",
          "needs:eas_hosting_service",
          {
            "and": [
              "bundle_exported",
              "logged_in"
            ]
          }
        ]
      },
      "add": [
        "deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_cli",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "eas_login",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "export_bundle",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "eas_deploy",
        "by": "agent"
      }
    }
  ],
  "goal": "deployed",
  "init_true": [],
  "init_constraints": []
}
