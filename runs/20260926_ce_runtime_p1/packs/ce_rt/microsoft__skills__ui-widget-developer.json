{
  "name": "ui-widget-developer",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "select_path": {
      "owner": "agent",
      "pre": true,
      "add": [
        "path_selected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_widget": {
      "owner": "agent",
      "pre": "path_selected",
      "add": [
        "widget_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_server": {
      "owner": "agent",
      "pre": "widget_built",
      "add": [
        "server_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "start_server": {
      "owner": "agent",
      "pre": "server_built",
      "add": [
        "server_running"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "start_devtunnel": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:devtunnel_account",
          "server_running"
        ]
      },
      "add": [
        "tunnel_running"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_inspector": {
      "owner": "agent",
      "pre": "server_running",
      "add": [
        "verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "provision_agent": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:m365_account",
          "tunnel_running"
        ]
      },
      "add": [
        "agent_provisioned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "select_path",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_widget",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_server",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "start_server",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "start_devtunnel",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_inspector",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "provision_agent",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "server_running",
      "verified",
      "tunnel_running",
      "agent_provisioned"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
