{
  "name": "provider-actions",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "write_action_code": {
      "owner": "agent",
      "pre": true,
      "add": [
        "action_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_code": {
      "owner": "agent",
      "pre": "action_implemented",
      "add": [
        "build_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_acceptance_tests": {
      "owner": "agent",
      "pre": "action_implemented",
      "add": [
        "tests_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_acceptance_tests": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:cloud_provider_account",
          {
            "and": [
              "tests_written",
              "build_pass"
            ]
          }
        ]
      },
      "add": [
        "tests_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_docs": {
      "owner": "agent",
      "pre": "action_implemented",
      "add": [
        "docs_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_action_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_acceptance_tests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_acceptance_tests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_docs",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "action_implemented",
      "build_pass",
      "tests_written",
      "tests_pass",
      "docs_generated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
