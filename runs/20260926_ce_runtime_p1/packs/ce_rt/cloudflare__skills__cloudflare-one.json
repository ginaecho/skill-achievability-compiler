{
  "name": "cloudflare-one",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "gather_context": {
      "owner": "agent",
      "pre": true,
      "add": [
        "context_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_docs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "docs_retrieved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "inspect_resources": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:cloudflare_account",
          "context_gathered"
        ]
      },
      "add": [
        "resources_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "propose_changes": {
      "owner": "agent",
      "pre": {
        "and": [
          "docs_retrieved",
          "resources_inspected"
        ]
      },
      "add": [
        "plan_proposed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "apply_changes": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:cloudflare_account",
          "plan_proposed"
        ]
      },
      "add": [
        "changes_applied"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "gather_context",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "inspect_resources",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "propose_changes",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "apply": [
            {
              "act": {
                "cap": "apply_changes",
                "by": "agent"
              }
            }
          ],
          "plan_only": []
        }
      }
    }
  ],
  "goal": "plan_proposed",
  "init_true": [],
  "init_constraints": []
}
