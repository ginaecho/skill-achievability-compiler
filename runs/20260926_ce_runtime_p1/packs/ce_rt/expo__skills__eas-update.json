{
  "name": "eas-update",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "install_expo_updates": {
      "owner": "agent",
      "pre": true,
      "add": [
        "expo_updates_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_eas_update": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:expo_eas_account",
          "expo_updates_installed"
        ]
      },
      "add": [
        "eas_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "publish_update": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:expo_eas_account",
          "eas_configured"
        ]
      },
      "add": [
        "update_published"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_expo_updates",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_eas_update",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "publish_update",
        "by": "agent"
      }
    }
  ],
  "goal": "update_published",
  "init_true": [],
  "init_constraints": []
}
