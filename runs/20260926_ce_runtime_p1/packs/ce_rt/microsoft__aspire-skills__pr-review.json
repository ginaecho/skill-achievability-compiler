{
  "name": "pr-review",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ensure_branch_available": {
      "owner": "agent",
      "pre": true,
      "add": [
        "branch_available"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "gather_pr_context": {
      "owner": "agent",
      "pre": "branch_available",
      "add": [
        "context_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "review_changes": {
      "owner": "agent",
      "pre": "context_gathered",
      "add": [
        "findings_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "post_review_comments": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_account",
          "findings_ready"
        ]
      },
      "add": [
        "comments_posted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "ensure_branch_available",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "gather_pr_context",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "review_changes",
        "by": "agent"
      }
    },
    {
      "msg": {
        "from": "agent",
        "to": "user",
        "label": "findings_presented"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "post_selected_findings": [
            {
              "act": {
                "cap": "post_review_comments",
                "by": "agent"
              }
            }
          ],
          "post_none": []
        }
      }
    }
  ],
  "goal": "findings_ready",
  "init_true": [],
  "init_constraints": []
}
