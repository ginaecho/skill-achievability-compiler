{
  "name": "finetuning",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "validate_data": {
      "owner": "agent",
      "pre": true,
      "add": [
        "data_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "baseline_evaluate": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:foundry_account",
          "data_validated"
        ]
      },
      "add": [
        "baseline_evaluated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "submit_training": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:foundry_account",
          "data_validated"
        ]
      },
      "add": [
        "job_submitted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "monitor_training": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:foundry_account",
          "job_submitted"
        ]
      },
      "add": [
        "job_complete"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_model": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:foundry_account",
          "job_complete"
        ]
      },
      "add": [
        "model_deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "evaluate_model": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:foundry_account",
          {
            "and": [
              "model_deployed",
              "baseline_evaluated"
            ]
          }
        ]
      },
      "add": [
        "model_evaluated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "validate_data",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "baseline_evaluate",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "submit_training",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "monitor_training",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "deploy_model",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "evaluate_model",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "job_complete",
      "model_deployed",
      "model_evaluated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
