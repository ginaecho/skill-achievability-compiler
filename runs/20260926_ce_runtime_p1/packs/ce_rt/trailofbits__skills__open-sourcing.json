{
  "name": "open-sourcing",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "detect_org_profile": {
      "owner": "agent",
      "pre": true,
      "add": [
        "org_profile_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "audit_secrets": {
      "owner": "agent",
      "pre": "org_profile_known",
      "add": [
        "secrets_audited"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_readiness_check": {
      "owner": "agent",
      "pre": "secrets_audited",
      "add": [
        "readiness_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "add_license": {
      "owner": "agent",
      "pre": "readiness_checked",
      "add": [
        "license_added"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "setup_ci": {
      "owner": "agent",
      "pre": "readiness_checked",
      "add": [
        "ci_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "make_repo_public": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_write_access",
          {
            "and": [
              "secrets_audited",
              "license_added",
              "ci_configured"
            ]
          }
        ]
      },
      "add": [
        "repo_public"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "detect_org_profile",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "audit_secrets",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_readiness_check",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "add_license",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "setup_ci",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "make_repo_public",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "secrets_audited",
      "license_added",
      "repo_public"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
