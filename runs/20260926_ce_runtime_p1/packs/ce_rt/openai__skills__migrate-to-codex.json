{
  "name": "migrate-to-codex",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "scan_source": {
      "owner": "agent",
      "pre": true,
      "add": [
        "source_scanned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "plan_migration": {
      "owner": "agent",
      "pre": "source_scanned",
      "add": [
        "plan_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "dry_run_migration": {
      "owner": "agent",
      "pre": "plan_ready",
      "add": [
        "dry_run_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_migration": {
      "owner": "agent",
      "pre": "dry_run_done",
      "add": [
        "migration_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fix_manual_items": {
      "owner": "agent",
      "pre": "migration_written",
      "add": [
        "manual_fixes_applied"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_target": {
      "owner": "agent",
      "pre": "migration_written",
      "add": [
        "target_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "scan_source",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "plan_migration",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "dry_run_migration",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_migration",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "self_heal",
        "body": [
          {
            "act": {
              "cap": "fix_manual_items",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "validate_target",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "resolved": [],
                "retry": [
                  {
                    "continue": "self_heal"
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "goal": {
    "and": [
      "migration_written",
      "target_validated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
