        ]
      },
      "add": [
        "tests_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_docs": {
      "owner": "agent",
      "pre": "resource_implemented",
      "add": [
        "docs_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
