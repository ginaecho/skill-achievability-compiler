{
  "name": "windows-builder",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "write_packer_template": {
      "owner": "agent",
      "pre": true,
      "add": [
        "template_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_packer_build": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:cloud_account",
          "template_written"
        ]
      },
      "add": [
        "image_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_cleanup": {
      "owner": "agent",
      "pre": "image_built",
      "add": [
        "cleanup_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_packer_template",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_packer_build",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "check_cleanup": [
            {
              "act": {
                "cap": "verify_cleanup",
                "by": "agent"
              }
            }
          ],
          "skip_cleanup_check": []
        }
      }
    }
  ],
  "goal": "image_built",
  "init_true": [],
  "init_constraints": []
}
