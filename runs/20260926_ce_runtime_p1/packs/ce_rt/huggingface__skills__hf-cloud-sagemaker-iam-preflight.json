{
  "name": "hf-cloud-sagemaker-iam-preflight",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_role_found": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:aws_account"
        ]
      },
      "add": [
        "usable_role"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_role_notfound": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:aws_account"
        ]
      },
      "add": [
        "role_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_role": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:aws_account",
          "needs:iam_write_permission",
          "role_checked"
        ]
      },
      "add": [
        "usable_role"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "found": [
            {
              "act": {
                "cap": "check_role_found",
                "by": "agent"
              }
            }
          ],
          "not_found": [
            {
              "act": {
                "cap": "check_role_notfound",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "create_role",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": "usable_role",
  "init_true": [],
  "init_constraints": []
}
