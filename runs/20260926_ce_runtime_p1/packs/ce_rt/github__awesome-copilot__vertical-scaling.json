{
  "name": "qdrant-vertical-scaling",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_metrics": {
      "owner": "agent",
      "pre": true,
      "add": [
        "metrics_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "resize_self_hosted": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:cloud_account",
          "metrics_checked"
        ]
      },
      "add": [
        "cluster_resized"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_metrics",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "cloud": [
            {
              "act": {
                "cap": "ensure_replication",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "resize_cloud_cluster",
                "by": "agent"
              }
            }
          ],
          "self_hosted": [
            {
              "act": {
                "cap": "resize_self_hosted",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": "cluster_resized",
  "init_true": [],
  "init_constraints": []
}
