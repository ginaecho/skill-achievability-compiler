{
  "name": "slack-gif-creator",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_clarification": {
      "owner": "agent",
      "pre": true,
      "add": [
        "clarified_request"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "inspect_user_upload": {
      "owner": "agent",
      "pre": "user_uploaded_image",
      "add": [
        "upload_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_gif": {
      "owner": "agent",
      "pre": true,
      "add": [
        "gif_created",
        "gif_file_exists"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "save_optimized_gif": {
      "owner": "agent",
      "pre": "gif_created",
      "add": [
        "gif_saved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {
        "gif_width": {
          "or": [
            {
              "cmp": [
                "gif_width",
                "==",
                128
              ]
            },
            {
              "cmp": [
                "gif_width",
                "==",
                480
              ]
            }
          ]
        },
        "gif_height": {
          "or": [
            {
              "cmp": [
                "gif_height",
                "==",
                128
              ]
            },
            {
              "cmp": [
                "gif_height",
                "==",
                480
              ]
            }
          ]
        },
        "gif_fps": {
          "and": [
            {
              "cmp": [
                "gif_fps",
                ">=",
                10
              ]
            },
            {
              "cmp": [
                "gif_fps",
                "<=",
                30
              ]
            }
          ]
        },
        "gif_colors": {
          "and": [
            {
              "cmp": [
                "gif_colors",
                ">=",
                48
              ]
            },
            {
              "cmp": [
                "gif_colors",
                "<=",
                128
              ]
            }
          ]
        }
      }
    },
    "validate_gif": {
      "owner": "agent",
      "pre": "gif_saved",
      "add": [],
      "del": [],
      "assigns": {},
      "nondet": {
        "slack_ready": {
          "or": [
            {
              "cmp": [
                "slack_ready",
                "==",
                0
              ]
            },
            {
              "cmp": [
                "slack_ready",
                "==",
                1
              ]
            }
          ]
        }
      }
    },
    "reduce_file_size": {
      "owner": "agent",
      "pre": "gif_saved",
      "add": [
        "size_optimized"
      ],
      "del": [],
      "assigns": {},
      "nondet": {
        "gif_width": {
          "or": [
            {
              "cmp": [
                "gif_width",
                "==",
                128
              ]
            },
            {
              "cmp": [
                "gif_width",
                "==",
                480
              ]
            }
          ]
        },
        "gif_height": {
          "or": [
            {
              "cmp": [
                "gif_height",
                "==",
                128
              ]
            },
            {
              "cmp": [
                "gif_height",
                "==",
                480
              ]
            }
          ]
        },
        "gif_fps": {
          "and": [
            {
              "cmp": [
                "gif_fps",
                ">=",
                10
              ]
            },
            {
              "cmp": [
                "gif_fps",
                "<=",
                30
              ]
            }
          ]
        },
        "gif_colors": {
          "and": [
            {
              "cmp": [
                "gif_colors",
                ">=",
                48
              ]
            },
            {
              "cmp": [
                "gif_colors",
                "<=",
                128
              ]
            }
          ]
        }
      }
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "clarify": [
            {
              "act": {
                "cap": "ask_clarification",
                "by": "agent"
              }
            }
          ],
          "skip_clarify": []
        }
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "uploaded_image": [
            {
              "act": {
                "cap": "inspect_user_upload",
                "by": "agent"
              }
            }
          ],
          "no_upload": []
        }
      }
    },
    {
      "act": {
        "cap": "create_gif",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "save_optimized_gif",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_gif",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "size_reduction_requested": [
            {
              "act": {
                "cap": "reduce_file_size",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "validate_gif",
                "by": "agent"
              }
            }
          ],
          "no_size_reduction_requested": []
        }
      }
    },
    {
      "goal": {
        "and": [
          "gif_saved",
          {
            "cmp": [
              "slack_ready",
              "==",
              1
            ]
          }
        ]
      }
    }
  ],
  "goal": {
    "and": [
      "gif_saved",
      {
        "cmp": [
          "slack_ready",
          "==",
          1
        ]
      }
    ]
  },
  "init_true": [],
  "init_constraints": [
    {
      "or": [
        {
          "cmp": [
            "slack_ready",
            "==",
            0
          ]
        },
        {
          "cmp": [
            "slack_ready",
            "==",
            1
          ]
        }
      ]
    }
  ]
}
