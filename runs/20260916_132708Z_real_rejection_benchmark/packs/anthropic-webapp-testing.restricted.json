{
  "name": "webapp-testing",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "read_html_file": {
      "owner": "agent",
      "pre": true,
      "add": [
        "html_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_help_for_with_server": {
      "owner": "agent",
      "pre": true,
      "add": [
        "with_server_help_seen"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_playwright_script": {
      "owner": "agent",
      "pre": true,
      "add": [
        "playwright_script_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_playwright_on_running_app": {
      "owner": "agent",
      "pre": "playwright_script_written",
      "add": [
        "navigated",
        "networkidle_reached",
        "browser_closed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_with_server_and_playwright": {
      "owner": "agent",
      "pre": {
        "and": [
          "with_server_help_seen",
          "playwright_script_written"
        ]
      },
      "add": [
        "server_managed",
        "navigated",
        "networkidle_reached",
        "browser_closed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "inspect_rendered_dom": {
      "owner": "agent",
      "pre": "networkidle_reached",
      "add": [
        "rendered_dom_inspected",
        "selectors_identified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "take_screenshot": {
      "owner": "agent",
      "pre": "networkidle_reached",
      "add": [
        "screenshot_captured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "capture_browser_logs": {
      "owner": "agent",
      "pre": "networkidle_reached",
      "add": [
        "browser_logs_captured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "static_html": [
            {
              "act": {
                "cap": "read_html_file",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "agent",
                "observed": true,
                "branches": {
                  "selectors_found": [
                    {
                      "act": {
                        "cap": "write_playwright_script",
                        "by": "agent"
                      }
                    }
                  ],
                  "incomplete_treat_dynamic": [
                    {
                      "choice": {
                        "by": "agent",
                        "observed": true,
                        "branches": {
                          "server_not_running": [
                            {
                              "act": {
                                "cap": "run_help_for_with_server",
                                "by": "agent"
                              }
                            },
                            {
                              "act": {
                                "cap": "write_playwright_script",
                                "by": "agent"
                              }
                            },
                            {
                              "act": {
                                "cap": "run_with_server_and_playwright",
                                "by": "agent"
                              }
                            }
                          ],
                          "server_running": [
                            {
                              "act": {
                                "cap": "write_playwright_script",
                                "by": "agent"
                              }
                            },
                            {
                              "act": {
                                "cap": "run_playwright_on_running_app",
                                "by": "agent"
                              }
                            },
                            {
                              "choice": {
                                "by": "agent",
                                "observed": true,
                                "branches": {
                                  "inspect_dom": [
                                    {
                                      "act": {
                                        "cap": "inspect_rendered_dom",
                                        "by": "agent"
                                      }
                                    }
                                  ],
                                  "take_screenshot": [
                                    {
                                      "act": {
                                        "cap": "take_screenshot",
                                        "by": "agent"
                                      }
                                    }
                                  ]
                                }
                              }
                            },
                            {
                              "act": {
                                "cap": "execute_actions_with_selectors",
                                "by": "agent"
                              }
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          ],
          "dynamic_webapp": [
            {
              "choice": {
                "by": "agent",
                "observed": true,
                "branches": {
                  "server_not_running": [
                    {
                      "act": {
                        "cap": "run_help_for_with_server",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "write_playwright_script",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "run_with_server_and_playwright",
                        "by": "agent"
                      }
                    }
                  ],
                  "server_running": [
                    {
                      "act": {
                        "cap": "write_playwright_script",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "run_playwright_on_running_app",
                        "by": "agent"
                      }
                    },
                    {
                      "choice": {
                        "by": "agent",
                        "observed": true,
                        "branches": {
                          "inspect_dom": [
                            {
                              "act": {
                                "cap": "inspect_rendered_dom",
                                "by": "agent"
                              }
                            }
                          ],
                          "take_screenshot": [
                            {
                              "act": {
                                "cap": "take_screenshot",
                                "by": "agent"
                              }
                            }
                          ]
                        }
                      }
                    },
                    {
                      "act": {
                        "cap": "execute_actions_with_selectors",
                        "by": "agent"
                      }
                    }
                  ]
                }
              }
            }
          ],
          "capture_logs": [
            {
              "choice": {
                "by": "agent",
                "observed": true,
                "branches": {
                  "server_not_running": [
                    {
                      "act": {
                        "cap": "run_help_for_with_server",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "write_playwright_script",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "run_with_server_and_playwright",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "capture_browser_logs",
                        "by": "agent"
                      }
                    }
                  ],
                  "server_running": [
                    {
                      "act": {
                        "cap": "write_playwright_script",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "run_playwright_on_running_app",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "capture_browser_logs",
                        "by": "agent"
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "or": [
      "playwright_script_written",
      "frontend_actions_executed",
      "screenshot_captured",
      "browser_logs_captured",
      "rendered_dom_inspected"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
