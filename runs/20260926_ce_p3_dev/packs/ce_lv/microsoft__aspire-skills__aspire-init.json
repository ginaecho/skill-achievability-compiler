{
  "name": "aspire-init",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_prerequisites": {
      "owner": "agent",
      "pre": true,
      "add": [
        "prereqs_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "detect_existing_apphost": {
      "owner": "agent",
      "pre": "prereqs_checked",
      "add": [
        "detection_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_aspire_new": {
      "owner": "agent",
      "pre": "detection_done",
      "add": [
        "project_scaffolded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_aspire_init": {
      "owner": "agent",
      "pre": "detection_done",
      "add": [
        "skeleton_dropped"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_prerequisites",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "detect_existing_apphost",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "new_project": [
            {
              "act": {
                "cap": "run_aspire_new",
                "by": "agent"
              }
            }
          ],
          "existing_repo": [
            {
              "act": {
                "cap": "run_aspire_init",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "or": [
      "project_scaffolded",
      "skeleton_dropped"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
