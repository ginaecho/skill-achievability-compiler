{
  "name": "hf-cloud-sagemaker-iam-preflight",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "validate_named_role": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:aws_account"
        ]
      },
      "add": [
        "role_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "discover_roles": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:aws_account"
        ]
      },
      "add": [
        "role_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_role": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:aws_account",
          "needs:iam_write_permission",
          {
            "not": "role_found"
          }
        ]
      },
      "add": [
        "role_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "role_given": [
            {
              "act": {
                "cap": "validate_named_role",
                "by": "agent"
              }
            }
          ],
          "no_role_given": [
            {
              "act": {
                "cap": "discover_roles",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "agent",
                "observed": true,
                "branches": {
                  "found": [],
                  "not_found": [
                    {
                      "choice": {
                        "by": "agent",
                        "observed": true,
                        "branches": {
                          "cannot_create": []
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "or": [
      "role_validated",
      "role_found",
      "role_created"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
