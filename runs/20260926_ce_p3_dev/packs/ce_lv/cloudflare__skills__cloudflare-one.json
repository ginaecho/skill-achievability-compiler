{
  "name": "cloudflare-one",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "retrieve_docs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "docs_retrieved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "gather_context": {
      "owner": "agent",
      "pre": true,
      "add": [
        "context_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "apply_changes": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:cloudflare_account",
          {
            "and": [
              "docs_retrieved",
              "context_gathered"
            ]
          }
        ]
      },
      "add": [
        "changes_applied"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "retrieve_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "gather_context",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "docs_retrieved",
      "context_gathered"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
