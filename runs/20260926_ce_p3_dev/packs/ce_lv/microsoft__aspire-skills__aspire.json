{
  "name": "aspire",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "detect_apphost": {
      "owner": "agent",
      "pre": true,
      "add": [
        "apphost_detected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "bootstrap_apphost": {
      "owner": "agent",
      "pre": true,
      "add": [
        "apphost_wired"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "start_apphost": {
      "owner": "agent",
      "pre": {
        "or": [
          "apphost_detected",
          "apphost_wired"
        ]
      },
      "add": [
        "app_running"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "wait_resource": {
      "owner": "agent",
      "pre": "app_running",
      "add": [
        "resource_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "inspect_state": {
      "owner": "agent",
      "pre": "resource_ready",
      "add": [
        "state_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "add_integration": {
      "owner": "agent",
      "pre": {
        "or": [
          "apphost_detected",
          "apphost_wired"
        ]
      },
      "add": [
        "integration_added"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "restart_apphost": {
      "owner": "agent",
      "pre": "app_running",
      "add": [
        "apphost_restarted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "stop_apphost": {
      "owner": "agent",
      "pre": "app_running",
      "add": [],
      "del": [
        "app_running"
      ],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "detect_apphost",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "apphost_found": [],
          "apphost_missing": [
            {
              "act": {
                "cap": "bootstrap_apphost",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "start_apphost",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "wait_resource",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "inspect_state",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "add_integration_branch": [
            {
              "act": {
                "cap": "add_integration",
                "by": "agent"
              }
            }
          ],
          "skip_integration": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "restart_branch": [
            {
              "act": {
                "cap": "restart_apphost",
                "by": "agent"
              }
            }
          ],
          "skip_restart": []
        }
      }
    },
    {
      "act": {
        "cap": "stop_apphost",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "state_inspected",
      {
        "not": "app_running"
      }
    ]
  },
  "init_true": [],
  "init_constraints": []
}
