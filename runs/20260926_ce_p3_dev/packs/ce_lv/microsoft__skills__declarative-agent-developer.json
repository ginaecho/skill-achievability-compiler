{
  "name": "declarative-agent-developer",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_atk_cli": {
      "owner": "agent",
      "pre": true,
      "add": [
        "atk_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "inspect_workspace": {
      "owner": "agent",
      "pre": "atk_installed",
      "add": [
        "workspace_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "edit_manifest": {
      "owner": "agent",
      "pre": "workspace_checked",
      "add": [
        "manifest_edited"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "update_instructions": {
      "owner": "agent",
      "pre": "manifest_edited",
      "add": [
        "instructions_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_agent": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:m365_account",
          "instructions_updated"
        ]
      },
      "add": [
        "deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_atk_cli",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "inspect_workspace",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "edit_manifest",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "update_instructions",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "manifest_edited",
      "instructions_updated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
