{
  "name": "hf-cloud-sagemaker-deployment-planner",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_discovery_questions": {
      "owner": "agent",
      "pre": true,
      "add": [
        "requirements_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_quota": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:aws_account",
          "requirements_known"
        ]
      },
      "add": [
        "quota_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "record_confirmation": {
      "owner": "agent",
      "pre": "quota_checked",
      "add": [
        "pathway_confirmed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "ask_discovery_questions",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_quota",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "confirm": [
            {
              "act": {
                "cap": "record_confirmation",
                "by": "agent"
              }
            }
          ],
          "revise": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "requirements_known",
      "quota_checked",
      "pathway_confirmed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
