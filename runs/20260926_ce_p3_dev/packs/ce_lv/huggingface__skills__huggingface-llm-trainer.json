{
  "name": "huggingface-llm-trainer",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "write_training_script": {
      "owner": "agent",
      "pre": true,
      "add": [
        "script_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_dataset": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:huggingface_account",
          "script_written"
        ]
      },
      "add": [
        "dataset_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "submit_job": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:huggingface_account",
          "script_written"
        ]
      },
      "add": [
        "job_submitted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_training_script",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip": []
        }
      }
    },
    {
      "act": {
        "cap": "submit_job",
        "by": "agent"
      }
    }
  ],
  "goal": "job_submitted",
  "init_true": [],
  "init_constraints": []
}
