{
  "name": "cli-exercise-preflight",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "build_helper": {
      "owner": "agent",
      "pre": true,
      "add": [
        "helper_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_preflight_check": {
      "owner": "agent",
      "pre": "helper_built",
      "add": [
        "receipt_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_install_approval": {
      "owner": "agent",
      "pre": true,
      "add": [
        "approval_asked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_dependency": {
      "owner": "agent",
      "pre": "approval_asked",
      "add": [
        "dependency_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "build_helper",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_preflight_check",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "capable": [],
          "missing_dependency": [
            {
              "act": {
                "cap": "ask_install_approval",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "approve": [
                    {
                      "act": {
                        "cap": "install_dependency",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "run_preflight_check",
                        "by": "agent"
                      }
                    }
                  ],
                  "decline": []
                }
              }
            }
          ]
        }
      }
    }
  ],
  "goal": "receipt_written",
  "init_true": [],
  "init_constraints": []
}
