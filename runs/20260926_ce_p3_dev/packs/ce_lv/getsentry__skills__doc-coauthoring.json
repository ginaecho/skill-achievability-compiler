{
  "name": "doc-coauthoring",
  "roles": [
    "agent",
    "user",
    "reader"
  ],
  "capabilities": {
    "create_doc": {
      "owner": "agent",
      "pre": true,
      "add": [
        "doc_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "draft_section": {
      "owner": "agent",
      "pre": "doc_created",
      "add": [
        "sections_drafted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "refine_section": {
      "owner": "agent",
      "pre": "sections_drafted",
      "add": [
        "doc_refined"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "accept": [
            {
              "act": {
                "cap": "create_doc",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "draft_section",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "refine_section",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "agent",
                "observed": true,
                "branches": {
                  "test": [
                    {
                      "spawn": {
                        "role": "reader"
                      }
                    }
                  ],
                  "skip": []
                }
              }
            }
          ],
          "decline": [
            {
              "act": {
                "cap": "create_doc",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "draft_section",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "refine_section",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "doc_created",
      "sections_drafted",
      "doc_refined"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
