{
  "name": "gh-skill",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "search_skill": {
      "owner": "agent",
      "pre": true,
      "add": [
        "skill_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "preview_skill": {
      "owner": "agent",
      "pre": "skill_found",
      "add": [
        "skill_previewed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_skill": {
      "owner": "agent",
      "pre": "skill_previewed",
      "add": [
        "skill_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "update_skill": {
      "owner": "agent",
      "pre": "skill_installed",
      "add": [
        "skill_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "publish_skill": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_write_access"
        ]
      },
      "add": [
        "skill_published"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "search_skill",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "preview_skill",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_skill",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "update_later": [
            {
              "act": {
                "cap": "update_skill",
                "by": "agent"
              }
            }
          ],
          "skip_update": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip_publish": []
        }
      }
    }
  ],
  "goal": "skill_installed",
  "init_true": [],
  "init_constraints": []
}
