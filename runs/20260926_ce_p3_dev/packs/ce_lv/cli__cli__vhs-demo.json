{
  "name": "vhs-demo",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "run_preflight": {
      "owner": "agent",
      "pre": true,
      "add": [
        "toolchain_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_workspace": {
      "owner": "agent",
      "pre": "toolchain_verified",
      "add": [
        "workspace_isolated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "author_tape": {
      "owner": "agent",
      "pre": "workspace_isolated",
      "add": [
        "tape_authored"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "render_tape": {
      "owner": "agent",
      "pre": "tape_authored",
      "add": [
        "gif_rendered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "inspect_evidence": {
      "owner": "agent",
      "pre": "gif_rendered",
      "add": [
        "evidence_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "run_preflight",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "toolchain_ok": [
            {
              "act": {
                "cap": "create_workspace",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "author_tape",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "render_tape",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "inspect_evidence",
                "by": "agent"
              }
            }
          ],
          "toolchain_missing": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "toolchain_verified",
      "workspace_isolated",
      "tape_authored",
      "gif_rendered",
      "evidence_inspected"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
