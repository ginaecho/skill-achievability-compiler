{
  "name": "writing-acceptance-tests",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "write_test_script": {
      "owner": "agent",
      "pre": true,
      "add": [
        "test_script_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_metadata_checks": {
      "owner": "agent",
      "pre": "test_script_written",
      "add": [
        "metadata_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_live_test": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_account",
          "metadata_validated"
        ]
      },
      "add": [
        "live_test_run"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_test_script",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_metadata_checks",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "test_script_written",
      "metadata_validated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
