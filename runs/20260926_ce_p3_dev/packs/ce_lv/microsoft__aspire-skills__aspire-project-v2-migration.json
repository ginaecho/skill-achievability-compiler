{
  "name": "aspire-project-v2-migration",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_apphost": {
      "owner": "agent",
      "pre": true,
      "add": [
        "inventory_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "add_package": {
      "owner": "agent",
      "pre": "inventory_done",
      "add": [
        "package_added"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "edit_apphost": {
      "owner": "agent",
      "pre": "inventory_done",
      "add": [
        "resources_migrated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "restore_build": {
      "owner": "agent",
      "pre": {
        "and": [
          "resources_migrated",
          "package_added"
        ]
      },
      "add": [
        "build_passed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "start_apphost": {
      "owner": "agent",
      "pre": "build_passed",
      "add": [
        "apphost_started"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "wait_resource": {
      "owner": "agent",
      "pre": "apphost_started",
      "add": [
        "validation_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "rerun_assessment": {
      "owner": "agent",
      "pre": "validation_done",
      "add": [
        "idempotence_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_apphost",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "approve": [
            {
              "act": {
                "cap": "add_package",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "edit_apphost",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "restore_build",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "start_apphost",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "wait_resource",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "rerun_assessment",
                "by": "agent"
              }
            }
          ],
          "decline": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "resources_migrated",
      "build_passed",
      "validation_done",
      "idempotence_checked"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
