{
  "name": "theme-factory",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "show_showcase": {
      "owner": "agent",
      "pre": true,
      "add": [
        "showcase_shown"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_theme_file": {
      "owner": "agent",
      "pre": "showcase_shown",
      "add": [
        "theme_file_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_custom_theme": {
      "owner": "agent",
      "pre": "showcase_shown",
      "add": [
        "custom_theme_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "apply_theme": {
      "owner": "agent",
      "pre": {
        "or": [
          "theme_file_read",
          "custom_theme_generated"
        ]
      },
      "add": [
        "theme_applied"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "show_showcase",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "existing_theme": [
            {
              "act": {
                "cap": "read_theme_file",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "apply_theme",
                "by": "agent"
              }
            }
          ],
          "custom_theme": [
            {
              "act": {
                "cap": "generate_custom_theme",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "approved": [
                    {
                      "act": {
                        "cap": "apply_theme",
                        "by": "agent"
                      }
                    }
                  ],
                  "revise": []
                }
              }
            }
          ]
        }
      }
    }
  ],
  "goal": "theme_applied",
  "init_true": [],
  "init_constraints": []
}
