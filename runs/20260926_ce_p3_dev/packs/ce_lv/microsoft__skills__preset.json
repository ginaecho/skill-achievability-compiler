{
  "name": "preset",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "verify_auth": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account"
        ]
      },
      "add": [
        "auth_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "get_project": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "auth_verified"
        ]
      },
      "add": [
        "project_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_capacity": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "project_found"
        ]
      },
      "add": [
        "capacity_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "query_all_regions": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "capacity_checked"
        ]
      },
      "add": [
        "regions_queried"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_model": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "capacity_checked"
        ]
      },
      "add": [
        "model_deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "verify_auth",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "get_project",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_capacity",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "has_capacity": [
            {
              "act": {
                "cap": "deploy_model",
                "by": "agent"
              }
            }
          ],
          "no_capacity": [
            {
              "act": {
                "cap": "query_all_regions",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "abort": []
                }
              }
            }
          ]
        }
      }
    }
  ],
  "goal": "model_deployed",
  "init_true": [],
  "init_constraints": []
}
