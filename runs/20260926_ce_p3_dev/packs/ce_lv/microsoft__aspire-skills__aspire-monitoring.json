{
  "name": "aspire-monitoring",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "describe_resources": {
      "owner": "agent",
      "pre": true,
      "add": [
        "state_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_otel_logs": {
      "owner": "agent",
      "pre": "state_known",
      "add": [
        "logs_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_console_logs": {
      "owner": "agent",
      "pre": "state_known",
      "add": [
        "console_logs_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_traces": {
      "owner": "agent",
      "pre": "state_known",
      "add": [
        "traces_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "export_telemetry": {
      "owner": "agent",
      "pre": "traces_fetched",
      "add": [
        "telemetry_exported"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "describe_resources",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_otel_logs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_console_logs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_traces",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "export": [
            {
              "act": {
                "cap": "export_telemetry",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "state_known",
      "logs_fetched",
      "traces_fetched"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
