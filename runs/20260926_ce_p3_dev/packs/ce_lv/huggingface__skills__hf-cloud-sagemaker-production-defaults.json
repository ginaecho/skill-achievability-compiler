{
  "name": "hf-cloud-sagemaker-production-defaults",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "run_deploy_script": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:aws_account"
        ]
      },
      "add": [
        "endpoint_created",
        "autoscaling_configured",
        "alarms_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "invoke_endpoint": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:aws_account",
          "endpoint_created"
        ]
      },
      "add": [
        "smoke_test_passed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scan_logs": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:aws_account",
          "endpoint_created"
        ]
      },
      "add": [
        "logs_scanned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "teardown_endpoint": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:aws_account",
          "endpoint_created"
        ]
      },
      "add": [
        "endpoint_torn_down"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "run_deploy_script",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "invoke_endpoint",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scan_logs",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "endpoint_created",
      "autoscaling_configured",
      "alarms_configured",
      "smoke_test_passed",
      "logs_scanned"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
