    "scaffold_cli": {
      "owner": "agent",
      "pre": "runtime_checked",
      "add": [
        "cli_scaffolded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_commands": {
      "owner": "agent",
      "pre": "cli_scaffolded",
      "add": [
        "commands_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_cli": {
      "owner": "agent",
      "pre": "commands_implemented",
      "add": [
        "cli_installed"
      ],
      "del": [],
      "assigns": {},
