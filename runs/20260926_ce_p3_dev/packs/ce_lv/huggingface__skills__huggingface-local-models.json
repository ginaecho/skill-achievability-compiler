{
  "name": "huggingface-local-models",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "install_llama_cpp": {
      "owner": "agent",
      "pre": true,
      "add": [
        "llama_cpp_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "search_hub": {
      "owner": "agent",
      "pre": true,
      "add": [
        "repo_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_gguf_tree": {
      "owner": "agent",
      "pre": "repo_found",
      "add": [
        "gguf_confirmed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "convert_to_gguf": {
      "owner": "agent",
      "pre": "repo_found",
      "add": [
        "gguf_confirmed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "launch_server": {
      "owner": "agent",
      "pre": {
        "and": [
          "llama_cpp_installed",
          "gguf_confirmed"
        ]
      },
      "add": [
        "server_running"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "smoke_test": {
      "owner": "agent",
      "pre": "server_running",
      "add": [
        "smoke_tested"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_llama_cpp",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "search_hub",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "has_gguf": [
            {
              "act": {
                "cap": "fetch_gguf_tree",
                "by": "agent"
              }
            }
          ],
          "no_gguf": [
            {
              "act": {
                "cap": "convert_to_gguf",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "launch_server",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "test": [
            {
              "act": {
                "cap": "smoke_test",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": "server_running",
  "init_true": [],
  "init_constraints": []
}
