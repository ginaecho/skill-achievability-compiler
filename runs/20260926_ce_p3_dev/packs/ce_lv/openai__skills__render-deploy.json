{
  "name": "render-deploy",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "generate_blueprint": {
      "owner": "agent",
      "pre": true,
      "add": [
        "blueprint_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_blueprint": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:render_account",
          "blueprint_created"
        ]
      },
      "add": [
        "blueprint_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "commit_blueprint": {
      "owner": "agent",
      "pre": "blueprint_created",
      "add": [
        "blueprint_committed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "push_blueprint": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:git_remote_write",
          "blueprint_committed"
        ]
      },
      "add": [
        "blueprint_pushed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_deeplink": {
      "owner": "agent",
      "pre": "blueprint_pushed",
      "add": [
        "deeplink_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "generate_blueprint",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip_validate": []
        }
      }
    },
    {
      "act": {
        "cap": "commit_blueprint",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip": []
        }
      }
    }
  ],
  "goal": "blueprint_created",
  "init_true": [],
  "init_constraints": []
}
