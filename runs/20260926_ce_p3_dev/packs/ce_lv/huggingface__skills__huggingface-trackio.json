{
  "name": "huggingface-trackio",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "install_trackio": {
      "owner": "agent",
      "pre": true,
      "add": [
        "trackio_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "log_metrics": {
      "owner": "agent",
      "pre": "trackio_installed",
      "add": [
        "metrics_logged"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "retrieve_metrics": {
      "owner": "agent",
      "pre": "metrics_logged",
      "add": [
        "metrics_retrieved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "sync_to_space": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:huggingface_account",
          "metrics_logged"
        ]
      },
      "add": [
        "space_synced"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_trackio",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "log_metrics",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "retrieve_metrics",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "metrics_logged",
      "metrics_retrieved"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
