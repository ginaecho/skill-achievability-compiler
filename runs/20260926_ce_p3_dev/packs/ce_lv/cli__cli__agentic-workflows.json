{
  "name": "agentic-workflows",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "load_matched_doc": {
      "owner": "agent",
      "pre": true,
      "add": [
        "doc_loaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "load_repo_overlay": {
      "owner": "agent",
      "pre": "doc_loaded",
      "add": [
        "overlay_loaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "apply_workflow_change": {
      "owner": "agent",
      "pre": "doc_loaded",
      "add": [
        "workflow_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "load_matched_doc",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "overlay_present": [
            {
              "act": {
                "cap": "load_repo_overlay",
                "by": "agent"
              }
            }
          ],
          "no_overlay": []
        }
      }
    },
    {
      "act": {
        "cap": "apply_workflow_change",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "doc_loaded",
      "workflow_updated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
