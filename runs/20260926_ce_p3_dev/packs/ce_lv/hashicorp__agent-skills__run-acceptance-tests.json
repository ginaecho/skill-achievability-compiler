{
  "name": "run-acceptance-tests",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "discover_env_vars": {
      "owner": "agent",
      "pre": true,
      "add": [
        "env_vars_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_acceptance_test": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:provider_test_account",
          "env_vars_known"
        ]
      },
      "add": [
        "test_run_complete"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "diagnose_test": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:provider_test_account",
          "test_run_complete"
        ]
      },
      "add": [
        "diagnosis_run"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "edit_test_assertion": {
      "owner": "agent",
      "pre": "test_run_complete",
      "add": [
        "assertion_edited"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "flip_verify": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:provider_test_account",
          "assertion_edited"
        ]
      },
      "add": [
        "flip_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_sweepers": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:provider_test_account",
          "test_run_complete"
        ]
      },
      "add": [
        "resources_cleaned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "discover_env_vars",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_acceptance_test",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "test_failed": [
            {
              "act": {
                "cap": "diagnose_test",
                "by": "agent"
              }
            }
          ],
          "test_passed": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip_flip": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip_cleanup": []
        }
      }
    }
  ],
  "goal": "test_run_complete",
  "init_true": [],
  "init_constraints": []
}
