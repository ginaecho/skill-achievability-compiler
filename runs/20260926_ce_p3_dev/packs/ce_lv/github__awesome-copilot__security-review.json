{
  "name": "security-review",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "audit_dependencies": {
      "owner": "agent",
      "pre": true,
      "add": [
        "dependencies_audited"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scan_secrets": {
      "owner": "agent",
      "pre": true,
      "add": [
        "secrets_scanned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deep_scan": {
      "owner": "agent",
      "pre": {
        "and": [
          "dependencies_audited",
          "secrets_scanned"
        ]
      },
      "add": [
        "vulnerabilities_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_findings": {
      "owner": "agent",
      "pre": "vulnerabilities_found",
      "add": [
        "findings_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "audit_dependencies",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scan_secrets",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "deep_scan",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_findings",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "dependencies_audited",
      "secrets_scanned",
      "vulnerabilities_found",
      "findings_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
