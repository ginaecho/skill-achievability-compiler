{
  "name": "eas-hosting",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "write_api_route": {
      "owner": "agent",
      "pre": true,
      "add": [
        "api_route_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "export_web_bundle": {
      "owner": "agent",
      "pre": "api_route_written",
      "add": [
        "web_exported"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "test_locally": {
      "owner": "agent",
      "pre": "web_exported",
      "add": [
        "tested_locally"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_eas_cli": {
      "owner": "agent",
      "pre": true,
      "add": [
        "eas_cli_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "eas_login": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:eas_account",
          "eas_cli_installed"
        ]
      },
      "add": [
        "eas_authenticated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "set_env_secret": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:eas_account",
          "eas_authenticated"
        ]
      },
      "add": [
        "secret_set"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_eas": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:eas_account",
          {
            "and": [
              "web_exported",
              "eas_authenticated"
            ]
          }
        ]
      },
      "add": [
        "deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_api_route",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "export_web_bundle",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "test_locally",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "api_route_written",
      "web_exported",
      "tested_locally"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
