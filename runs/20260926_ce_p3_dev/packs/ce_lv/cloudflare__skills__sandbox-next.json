{
  "name": "sandbox-next",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "fetch_docs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "docs_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_worker_code": {
      "owner": "agent",
      "pre": "docs_fetched",
      "add": [
        "code_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_worker": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:cloudflare_account",
          "code_written"
        ]
      },
      "add": [
        "worker_deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "fetch_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_worker_code",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip": []
        }
      }
    }
  ],
  "goal": "code_written",
  "init_true": [],
  "init_constraints": []
}
