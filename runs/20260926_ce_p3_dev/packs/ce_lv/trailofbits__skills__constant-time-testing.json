{
  "name": "constant-time-testing",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "write_dudect_harness": {
      "owner": "agent",
      "pre": true,
      "add": [
        "harness_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_test": {
      "owner": "agent",
      "pre": "harness_written",
      "add": [
        "test_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_dudect": {
      "owner": "agent",
      "pre": "test_built",
      "add": [
        "dudect_run"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_timecop": {
      "owner": "agent",
      "pre": "dudect_run",
      "add": [
        "root_cause_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_report": {
      "owner": "agent",
      "pre": "dudect_run",
      "add": [
        "report_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_dudect_harness",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_test",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_dudect",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "leak_detected": [
            {
              "act": {
                "cap": "run_timecop",
                "by": "agent"
              }
            }
          ],
          "no_leak": []
        }
      }
    },
    {
      "act": {
        "cap": "write_report",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "dudect_run",
      "report_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
