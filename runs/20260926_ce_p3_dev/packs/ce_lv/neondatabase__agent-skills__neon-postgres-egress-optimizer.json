{
  "name": "neon-postgres-egress-optimizer",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "diagnose_db": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:postgres_db_access"
        ]
      },
      "add": [
        "diagnosis_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "analyze_codebase": {
      "owner": "agent",
      "pre": true,
      "add": [
        "analysis_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "apply_fixes": {
      "owner": "agent",
      "pre": "analysis_done",
      "add": [
        "fixes_applied"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_tests": {
      "owner": "agent",
      "pre": "fixes_applied",
      "add": [
        "tests_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_egress": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:postgres_db_access",
          "tests_pass"
        ]
      },
      "add": [
        "egress_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "codebase_only": []
        }
      }
    },
    {
      "act": {
        "cap": "analyze_codebase",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "apply_fixes",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_tests",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "fixes_applied",
      "tests_pass"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
