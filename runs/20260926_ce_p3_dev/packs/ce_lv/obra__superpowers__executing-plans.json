{
  "name": "executing-plans",
  "roles": [
    "agent",
    "reviewer"
  ],
  "capabilities": {
    "setup_workspace": {
      "owner": "agent",
      "pre": true,
      "add": [
        "workspace_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_plan": {
      "owner": "agent",
      "pre": "workspace_ready",
      "add": [
        "plan_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_failing_test": {
      "owner": "agent",
      "pre": "plan_read",
      "add": [
        "test_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_test_red": {
      "owner": "agent",
      "pre": "test_written",
      "add": [
        "test_failed_confirmed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_step": {
      "owner": "agent",
      "pre": "test_failed_confirmed",
      "add": [
        "code_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_test_green": {
      "owner": "agent",
      "pre": "code_implemented",
      "add": [
        "tests_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "commit_task": {
      "owner": "agent",
      "pre": "tests_pass",
      "add": [
        "task_committed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_final_tests": {
      "owner": "agent",
      "pre": "task_committed",
      "add": [
        "all_tasks_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "self_review": {
      "owner": "agent",
      "pre": "all_tasks_done",
      "add": [
        "review_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fix_findings": {
      "owner": "agent",
      "pre": "review_done",
      "add": [
        "findings_fixed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "delete_workspace": {
      "owner": "agent",
      "pre": "findings_fixed",
      "add": [
        "workspace_cleaned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "setup_workspace",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_plan",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "task_loop",
        "body": [
          {
            "act": {
              "cap": "write_failing_test",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "run_test_red",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "implement_step",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "run_test_green",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "commit_task",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "more_tasks": [
                  {
                    "continue": "task_loop"
                  }
                ],
                "no_more_tasks": []
              }
            }
          }
        ]
      }
    },
    {
      "act": {
        "cap": "run_final_tests",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "has_subagent": [
            {
              "spawn": {
                "role": "reviewer"
              }
            },
            {
              "msg": {
                "from": "reviewer",
                "to": "agent",
                "label": "review_findings"
              }
            }
          ],
          "no_subagent": [
            {
              "act": {
                "cap": "self_review",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "fix_findings",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "delete_workspace",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "all_tasks_done",
      "review_done",
      "findings_fixed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
