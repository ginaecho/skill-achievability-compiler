{
  "name": "neon-auth",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "configure_auth": {
      "owner": "agent",
      "pre": true,
      "add": [
        "auth_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_login": {
      "owner": "agent",
      "pre": "auth_configured",
      "add": [
        "login_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_auth": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:neon_account",
          "auth_configured"
        ]
      },
      "add": [
        "auth_deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_login": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:neon_account",
          {
            "and": [
              "login_implemented",
              "auth_deployed"
            ]
          }
        ]
      },
      "add": [
        "login_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "configure_auth",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "implement_login",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "auth_configured",
      "login_implemented"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
