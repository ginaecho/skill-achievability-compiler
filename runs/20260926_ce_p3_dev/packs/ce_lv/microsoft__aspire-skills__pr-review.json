{
  "name": "pr-review",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "checkout_pr_branch": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_account"
        ]
      },
      "add": [
        "branch_checked_out"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "gather_pr_context": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_account",
          "branch_checked_out"
        ]
      },
      "add": [
        "context_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "review_code": {
      "owner": "agent",
      "pre": "context_gathered",
      "add": [
        "findings_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "post_review": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_account",
          "findings_ready"
        ]
      },
      "add": [
        "review_posted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "checkout_pr_branch",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "gather_pr_context",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "review_code",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip": []
        }
      }
    }
  ],
  "goal": "findings_ready",
  "init_true": [],
  "init_constraints": []
}
