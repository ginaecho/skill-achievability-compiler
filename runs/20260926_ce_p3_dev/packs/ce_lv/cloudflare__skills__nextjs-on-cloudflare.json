{
  "name": "nextjs-on-cloudflare",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "install_vinext_skills": {
      "owner": "agent",
      "pre": true,
      "add": [
        "skills_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_new_project": {
      "owner": "agent",
      "pre": "skills_installed",
      "add": [
        "project_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "migrate_existing_project": {
      "owner": "agent",
      "pre": "skills_installed",
      "add": [
        "project_migrated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_dev_server": {
      "owner": "agent",
      "pre": {
        "or": [
          "project_created",
          "project_migrated"
        ]
      },
      "add": [
        "dev_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_to_workers": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:cloudflare_account",
          "dev_verified"
        ]
      },
      "add": [
        "deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_vinext_skills",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "new_project": [
            {
              "act": {
                "cap": "create_new_project",
                "by": "agent"
              }
            }
          ],
          "existing_project": [
            {
              "act": {
                "cap": "migrate_existing_project",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "run_dev_server",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "or": [
      "project_created",
      "project_migrated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
