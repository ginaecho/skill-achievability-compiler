{
  "name": "provider-actions",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "write_action_code": {
      "owner": "agent",
      "pre": true,
      "add": [
        "action_code_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_schema": {
      "owner": "agent",
      "pre": "action_code_written",
      "add": [
        "schema_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_code": {
      "owner": "agent",
      "pre": "schema_written",
      "add": [
        "code_builds"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "compile_tests": {
      "owner": "agent",
      "pre": "code_builds",
      "add": [
        "tests_compile"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "format_code": {
      "owner": "agent",
      "pre": "code_builds",
      "add": [
        "code_formatted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_docs": {
      "owner": "agent",
      "pre": "code_builds",
      "add": [
        "docs_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_acceptance_tests": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:cloud_provider_account",
          "tests_compile"
        ]
      },
      "add": [
        "acceptance_tests_run"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_action_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_schema",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "compile_tests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "format_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_docs",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "code_builds",
      "tests_compile",
      "code_formatted",
      "docs_generated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
