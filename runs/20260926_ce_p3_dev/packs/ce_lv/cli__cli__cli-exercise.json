{
  "name": "cli-exercise",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "prepare_environment": {
      "owner": "agent",
      "pre": true,
      "add": [
        "environment_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_case": {
      "owner": "agent",
      "pre": "environment_ready",
      "add": [
        "case_executed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "capture_recording": {
      "owner": "agent",
      "pre": "case_executed",
      "add": [
        "recording_captured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "render_video": {
      "owner": "agent",
      "pre": "recording_captured",
      "add": [
        "video_rendered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_html_report": {
      "owner": "agent",
      "pre": "recording_captured",
      "add": [
        "html_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "cleanup_resources": {
      "owner": "agent",
      "pre": "video_rendered",
      "add": [
        "cleanup_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "prepare_environment",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_case",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "capture_recording",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "render_video",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "html_requested": [
            {
              "act": {
                "cap": "generate_html_report",
                "by": "agent"
              }
            }
          ],
          "media_only": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "cleanup_approved": [
            {
              "act": {
                "cap": "cleanup_resources",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "case_executed",
      "recording_captured",
      "video_rendered"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
