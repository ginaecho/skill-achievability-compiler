{
  "name": "speech",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "install_deps": {
      "owner": "agent",
      "pre": true,
      "add": [
        "deps_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_batch_jsonl": {
      "owner": "agent",
      "pre": "deps_installed",
      "add": [
        "batch_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_tts_cli": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:openai_api_key",
          "deps_installed"
        ]
      },
      "add": [
        "audio_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_audio": {
      "owner": "agent",
      "pre": "audio_generated",
      "add": [
        "validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "delete_batch_jsonl": {
      "owner": "agent",
      "pre": "batch_written",
      "add": [],
      "del": [
        "batch_written"
      ],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_deps",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "batch": [
            {
              "act": {
                "cap": "write_batch_jsonl",
                "by": "agent"
              }
            }
          ],
          "single": []
        }
      }
    },
    {
      "act": {
        "cap": "run_tts_cli",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "cleanup": [
            {
              "act": {
                "cap": "delete_batch_jsonl",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    },
    {
      "act": {
        "cap": "validate_audio",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "audio_generated",
      "validated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
