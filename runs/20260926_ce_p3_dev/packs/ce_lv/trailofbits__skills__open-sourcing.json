{
  "name": "open-sourcing",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "detect_org": {
      "owner": "agent",
      "pre": true,
      "add": [
        "org_detected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "audit_secrets": {
      "owner": "agent",
      "pre": "org_detected",
      "add": [
        "secrets_audited"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "recreate_repo": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_account",
          "secrets_audited"
        ]
      },
      "add": [
        "repo_recreated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_readiness": {
      "owner": "agent",
      "pre": "secrets_audited",
      "add": [
        "readiness_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_docs": {
      "owner": "agent",
      "pre": "readiness_checked",
      "add": [
        "docs_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "add_license": {
      "owner": "agent",
      "pre": "readiness_checked",
      "add": [
        "license_added"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_tests_ci": {
      "owner": "agent",
      "pre": {
        "and": [
          "docs_written",
          "license_added"
        ]
      },
      "add": [
        "tests_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "harden_workflows": {
      "owner": "agent",
      "pre": "tests_pass",
      "add": [
        "workflows_hardened"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_repo_settings": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_account",
          "workflows_hardened"
        ]
      },
      "add": [
        "settings_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "make_repo_public": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_account",
          "settings_configured"
        ]
      },
      "add": [
        "repo_public"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "detect_org",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "audit_secrets",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "clean": []
        }
      }
    },
    {
      "act": {
        "cap": "check_readiness",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "add_license",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_tests_ci",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "harden_workflows",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "docs_written",
      "license_added",
      "tests_pass"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
