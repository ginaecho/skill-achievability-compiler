{
  "name": "terraform-policy",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_cli_version": {
      "owner": "agent",
      "pre": true,
      "add": [
        "cli_version_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_policy": {
      "owner": "agent",
      "pre": "cli_version_checked",
      "add": [
        "policy_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_policy": {
      "owner": "agent",
      "pre": "policy_written",
      "add": [
        "policy_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_policy_test": {
      "owner": "agent",
      "pre": "policy_written",
      "add": [
        "test_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_policy_test": {
      "owner": "agent",
      "pre": {
        "and": [
          "test_written",
          "policy_validated"
        ]
      },
      "add": [
        "test_passed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_cli_version",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_policy",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_policy",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_policy_test",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_policy_test",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "policy_written",
      "test_written",
      "policy_validated",
      "test_passed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
