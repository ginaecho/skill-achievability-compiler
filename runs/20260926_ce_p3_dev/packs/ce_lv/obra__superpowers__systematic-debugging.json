{
  "name": "systematic-debugging",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "reproduce_bug": {
      "owner": "agent",
      "pre": true,
      "add": [
        "bug_reproduced"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "investigate_root_cause": {
      "owner": "agent",
      "pre": "bug_reproduced",
      "add": [
        "root_cause_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_failing_test": {
      "owner": "agent",
      "pre": "root_cause_found",
      "add": [
        "failing_test_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_fix": {
      "owner": "agent",
      "pre": "failing_test_written",
      "add": [
        "fix_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_tests": {
      "owner": "agent",
      "pre": "fix_implemented",
      "add": [
        "tests_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "reproduce_bug",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "debug_loop",
        "body": [
          {
            "act": {
              "cap": "investigate_root_cause",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "write_failing_test",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "implement_fix",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "run_tests",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "fixed": [],
                "retry": [
                  {
                    "continue": "debug_loop"
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "goal": {
    "and": [
      "root_cause_found",
      "tests_pass"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
