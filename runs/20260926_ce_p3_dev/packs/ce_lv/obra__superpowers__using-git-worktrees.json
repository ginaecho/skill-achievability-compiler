{
  "name": "using-git-worktrees",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_isolation": {
      "owner": "agent",
      "pre": true,
      "add": [
        "isolation_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_consent": {
      "owner": "agent",
      "pre": "isolation_checked",
      "add": [
        "consent_given"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_worktree": {
      "owner": "agent",
      "pre": "consent_given",
      "add": [
        "worktree_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "project_setup": {
      "owner": "agent",
      "pre": "isolation_checked",
      "add": [
        "setup_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_baseline_tests": {
      "owner": "agent",
      "pre": "setup_done",
      "add": [
        "tests_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_isolation",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "already_isolated": [],
          "not_isolated": [
            {
              "act": {
                "cap": "ask_consent",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "consent_yes": [
                    {
                      "act": {
                        "cap": "create_worktree",
                        "by": "agent"
                      }
                    }
                  ],
                  "consent_no": []
                }
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "project_setup",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_baseline_tests",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "setup_done",
      "tests_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
