    },
    "write_properties": {
      "owner": "agent",
      "pre": true,
      "add": [
        "properties_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_script": {
      "owner": "agent",
      "pre": true,
      "add": [
        "script_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_server_code": {
      "owner": "agent",
      "pre": true,
      "add": [
        "server_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_tools": {
      "owner": "agent",
      "pre": "server_written",
      "add": [
        "tools_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
