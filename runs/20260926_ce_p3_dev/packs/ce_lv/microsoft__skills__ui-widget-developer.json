{
  "name": "ui-widget-developer",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "ask_path_choice": {
      "owner": "agent",
      "pre": true,
      "add": [
        "path_chosen"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scaffold_mcp_server": {
      "owner": "agent",
      "pre": "path_chosen",
      "add": [
        "server_scaffolded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_fluent_deps": {
      "owner": "agent",
      "pre": "server_scaffolded",
      "add": [
        "fluent_deps_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_widget_code": {
      "owner": "agent",
      "pre": "fluent_deps_installed",
      "add": [
        "widget_code_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "register_mcp_resource": {
      "owner": "agent",
      "pre": "widget_code_written",
      "add": [
        "resource_registered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "start_server_background": {
      "owner": "agent",
      "pre": "resource_registered",
      "add": [
        "server_running"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "start_devtunnel": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:devtunnel_account",
          "server_running"
        ]
      },
      "add": [
        "tunnel_running"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_mcp_inspector_e2e": {
      "owner": "agent",
      "pre": "tunnel_running",
      "add": [
        "e2e_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "provision_agent": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:m365_tenant",
          "e2e_verified"
        ]
      },
      "add": [
        "agent_provisioned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "ask_path_choice",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "oai_app": [
            {
              "act": {
                "cap": "scaffold_mcp_server",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "install_fluent_deps",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "build_widget_code",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "register_mcp_resource",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "agent",
                "observed": true,
                "branches": {
                  "skip_deploy": []
                }
              }
            }
          ],
          "mcp_apps_extension": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "path_chosen",
      "server_scaffolded",
      "widget_code_written",
      "resource_registered"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
