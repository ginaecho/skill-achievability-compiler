{
  "name": "turnstile-spin",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "auth_probe": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:cloudflare_account"
        ]
      },
      "add": [
        "authenticated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scan_codebase": {
      "owner": "agent",
      "pre": true,
      "add": [
        "codebase_scanned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_widget": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:cloudflare_account",
          {
            "and": [
              "authenticated",
              "codebase_scanned"
            ]
          }
        ]
      },
      "add": [
        "widget_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "embed_frontend": {
      "owner": "agent",
      "pre": "widget_created",
      "add": [
        "frontend_embedded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "wire_backend": {
      "owner": "agent",
      "pre": "widget_created",
      "add": [
        "backend_wired"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "store_secret": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:cloudflare_account",
          "backend_wired"
        ]
      },
      "add": [
        "secret_stored"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_integration": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:cloudflare_account",
          {
            "and": [
              "secret_stored",
              "frontend_embedded"
            ]
          }
        ]
      },
      "add": [
        "validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "persist_skill": {
      "owner": "agent",
      "pre": true,
      "add": [
        "skill_persisted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "auth_probe",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scan_codebase",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_widget",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "decline": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "persist": [
            {
              "act": {
                "cap": "persist_skill",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "widget_created",
      "frontend_embedded",
      "backend_wired",
      "secret_stored",
      "validated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
