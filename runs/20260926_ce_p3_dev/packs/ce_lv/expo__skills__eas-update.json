{
  "name": "eas-update",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "inspect_project": {
      "owner": "agent",
      "pre": true,
      "add": [
        "project_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_expo_updates": {
      "owner": "agent",
      "pre": "project_inspected",
      "add": [
        "expo_updates_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_update_configure": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:eas_account",
          "expo_updates_installed"
        ]
      },
      "add": [
        "update_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "publish_update": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:eas_account",
          "update_configured"
        ]
      },
      "add": [
        "update_published"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_project",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_expo_updates",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_update_configure",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip": []
        }
      }
    }
  ],
  "goal": "update_configured",
  "init_true": [],
  "init_constraints": []
