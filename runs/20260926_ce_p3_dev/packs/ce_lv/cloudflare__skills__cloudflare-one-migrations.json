{
  "name": "cloudflare-one-migrations",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "fetch_cf_docs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "docs_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "request_exports": {
      "owner": "agent",
      "pre": true,
      "add": [
        "exports_received"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_assessment": {
      "owner": "agent",
      "pre": {
        "and": [
          "docs_fetched",
          "exports_received"
        ]
      },
      "add": [
        "assessment_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "fetch_cf_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "request_exports",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_assessment",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip": []
        }
      }
    }
  ],
  "goal": "assessment_written",
  "init_true": [],
  "init_constraints": []
}
