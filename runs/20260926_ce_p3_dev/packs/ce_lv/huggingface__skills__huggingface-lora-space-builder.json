{
  "name": "huggingface-lora-space-builder",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "read_lora_repo": {
      "owner": "agent",
      "pre": true,
      "add": [
        "lora_info_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_app_files": {
      "owner": "agent",
      "pre": "lora_info_gathered",
      "add": [
        "app_files_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "publish_space": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:hf_account",
          "app_files_written"
        ]
      },
      "add": [
        "space_published"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "smoke_test_space": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:hf_account",
          "space_published"
        ]
      },
      "add": [
        "space_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_lora_repo",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_app_files",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "publish_space",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "smoke_test_space",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "space_published",
      "space_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
