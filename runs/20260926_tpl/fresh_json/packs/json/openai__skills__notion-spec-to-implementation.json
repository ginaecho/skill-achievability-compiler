{
  "name": "notion-spec-to-implementation",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "setup_mcp": {
      "owner": "agent",
      "add": [
        "mcp_connected"
      ]
    },
    "notion_search": {
      "owner": "agent",
      "add": [
        "spec_located"
      ]
    },
    "notion_fetch": {
      "owner": "agent",
      "pre": "spec_located",
      "add": [
        "spec_read"
      ]
    },
    "create_plan_page": {
      "owner": "agent",
      "pre": "spec_read",
      "add": [
        "plan_created"
      ]
    },
    "find_task_db": {
      "owner": "agent",
      "pre": "plan_created",
      "add": [
        "task_db_found"
      ]
    },
    "create_tasks": {
      "owner": "agent",
      "pre": "task_db_found",
      "add": [
        "tasks_created"
      ]
    },
    "link_artifacts": {
      "owner": "agent",
      "pre": "tasks_created",
      "add": [
        "artifacts_linked"
      ]
    },
    "update_progress": {
      "owner": "agent",
      "pre": "artifacts_linked",
      "add": [
        "progress_tracked"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "mcp_already_connected": [],
          "mcp_not_connected": [
            {
              "act": {
                "cap": "setup_mcp",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "notion_search",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "notion_fetch",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_plan_page",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "find_task_db",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_tasks",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "link_artifacts",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "update_progress",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "plan_created",
      {
        "and": [
          "tasks_created",
          "artifacts_linked"
        ]
      }
    ]
  },
  "init_true": [],
  "init_constraints": []
}
