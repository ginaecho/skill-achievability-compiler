{
  "name": "notion-research-documentation",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "setup_mcp": {
      "owner": "agent",
      "pre": true,
      "add": [
        "mcp_connected"
      ]
    },
    "search_notion": {
      "owner": "agent",
      "pre": "mcp_connected",
      "add": [
        "sources_found"
      ]
    },
    "fetch_pages": {
      "owner": "agent",
      "pre": "sources_found",
      "add": [
        "content_gathered"
      ]
    },
    "create_page": {
      "owner": "agent",
      "pre": "content_gathered",
      "add": [
        "doc_created"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "needs_setup": [
            {
              "act": {
                "cap": "setup_mcp",
                "by": "agent"
              }
            }
          ],
          "already_connected": []
        }
      }
    },
    {
      "act": {
        "cap": "search_notion",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_pages",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_page",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "mcp_connected",
      "sources_found",
      "content_gathered",
      "doc_created"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
