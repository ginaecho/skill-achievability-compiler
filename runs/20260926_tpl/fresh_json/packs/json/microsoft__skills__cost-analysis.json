{
  "name": "cost-analysis",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "confirm_scope": {
      "owner": "agent",
      "add": [
        "scope_confirmed"
      ]
    },
    "query_costs": {
      "owner": "agent",
      "pre": "scope_confirmed",
      "add": [
        "costs_queried"
      ]
    },
    "query_aks_costs": {
      "owner": "agent",
      "pre": "scope_confirmed",
      "add": [
        "costs_queried"
      ]
    },
    "report_results": {
      "owner": "agent",
      "pre": "costs_queried",
      "add": [
        "results_reported"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "confirm_scope",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "general_query": [
            {
              "act": {
                "cap": "query_costs",
                "by": "agent"
              }
            }
          ],
          "aks_query": [
            {
              "act": {
                "cap": "query_aks_costs",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "report_results",
        "by": "agent"
      }
    }
  ],
  "goal": "results_reported",
  "init_true": [],
  "init_constraints": []
}
