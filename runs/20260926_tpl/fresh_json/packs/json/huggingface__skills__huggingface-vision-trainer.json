{
  "name": "huggingface-vision-trainer",
  "roles": [
    "assistant"
  ],
  "capabilities": {
    "check_prerequisites": {
      "owner": "assistant",
      "pre": true,
      "add": [
        "prereqs_verified"
      ]
    },
    "validate_dataset": {
      "owner": "assistant",
      "pre": "prereqs_verified",
      "add": [
        "dataset_validated"
      ]
    },
    "ask_user_preferences": {
      "owner": "assistant",
      "pre": "dataset_validated",
      "add": [
        "preferences_collected"
      ]
    },
    "prepare_training_script": {
      "owner": "assistant",
      "pre": "preferences_collected",
      "add": [
        "script_prepared"
      ]
    },
    "save_script_locally": {
      "owner": "assistant",
      "pre": "script_prepared",
      "add": [
        "script_saved"
      ]
    },
    "submit_job": {
      "owner": "assistant",
      "pre": "script_saved",
      "add": [
        "job_submitted"
      ]
    },
    "report_job_details": {
      "owner": "assistant",
      "pre": "job_submitted",
      "add": [
        "job_reported"
      ]
    },
    "check_job_status": {
      "owner": "assistant",
      "pre": "job_submitted",
      "add": [
        "status_checked"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_prerequisites",
        "by": "assistant"
      }
    },
    {
      "act": {
        "cap": "validate_dataset",
        "by": "assistant"
      }
    },
    {
      "act": {
        "cap": "ask_user_preferences",
        "by": "assistant"
      }
    },
    {
      "act": {
        "cap": "prepare_training_script",
        "by": "assistant"
      }
    },
    {
      "act": {
        "cap": "save_script_locally",
        "by": "assistant"
      }
    },
    {
      "act": {
        "cap": "submit_job",
        "by": "assistant"
      }
    },
    {
      "act": {
        "cap": "report_job_details",
        "by": "assistant"
      }
    },
    {
      "choice": {
        "by": "assistant",
        "observed": true,
        "branches": {
          "user_requests_status": [
            {
              "act": {
                "cap": "check_job_status",
                "by": "assistant"
              }
            }
          ],
          "no_request": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "job_submitted",
      "job_reported"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
