{
  "name": "property-based-testing",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "analyze_code_shape": {
      "owner": "agent",
      "add": [
        "shape_analyzed"
      ]
    },
    "refactor_for_testability": {
      "owner": "agent",
      "pre": "shape_analyzed",
      "add": [
        "refactored"
      ]
    },
    "select_property": {
      "owner": "agent",
      "add": [
        "property_selected"
      ]
    },
    "introduce_pbt_library": {
      "owner": "agent",
      "add": [
        "library_added"
      ]
    },
    "write_property_test": {
      "owner": "agent",
      "pre": "property_selected",
      "add": [
        "test_written"
      ]
    },
    "run_test": {
      "owner": "agent",
      "pre": "test_written",
      "add": [
        "test_run"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "analyze_code_shape",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "has_shape": [
            {
              "act": {
                "cap": "select_property",
                "by": "agent"
              }
            }
          ],
          "no_shape": [
            {
              "act": {
                "cap": "refactor_for_testability",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "select_property",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "library_exists": [],
          "no_library": [
            {
              "act": {
                "cap": "introduce_pbt_library",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "write_property_test",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_test",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "property_selected",
      "test_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
