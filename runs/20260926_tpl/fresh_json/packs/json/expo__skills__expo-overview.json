{
  "name": "expo-overview",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "confirm_expo_context": {
      "owner": "agent",
      "add": [
        "context_confirmed"
      ]
    },
    "classify_goal": {
      "owner": "agent",
      "pre": "context_confirmed",
      "add": [
        "goal_classified"
      ]
    },
    "confirm_intent": {
      "owner": "agent",
      "pre": "goal_classified",
      "add": [
        "intent_confirmed"
      ]
    },
    "scaffold_new_app": {
      "owner": "agent",
      "add": [
        "app_scaffolded"
      ]
    },
    "detect_sdk_version": {
      "owner": "agent",
      "add": [
        "sdk_detected"
      ]
    },
    "load_leaf_skill": {
      "owner": "agent",
      "pre": "goal_classified",
      "add": [
        "leaf_skill_loaded"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "confirm_expo_context",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "classify_goal",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "ambiguous": [
            {
              "act": {
                "cap": "confirm_intent",
                "by": "agent"
              }
            }
          ],
          "clear": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "new_app": [
            {
              "act": {
                "cap": "scaffold_new_app",
                "by": "agent"
              }
            }
          ],
          "existing_app": []
        }
      }
    },
    {
      "act": {
        "cap": "detect_sdk_version",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "load_leaf_skill",
        "by": "agent"
      }
    }
  ],
  "goal": "leaf_skill_loaded",
  "init_true": [],
  "init_constraints": []
}
