{
  "name": "applicationinsights-web-ts",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "install_package": {
      "owner": "agent",
      "add": [
        "package_installed"
      ]
    },
    "write_sdk_init": {
      "owner": "agent",
      "pre": "package_installed",
      "add": [
        "sdk_initialized"
      ]
    },
    "add_tracking_calls": {
      "owner": "agent",
      "pre": "sdk_initialized",
      "add": [
        "tracking_added"
      ]
    },
    "configure_distributed_tracing": {
      "owner": "agent",
      "pre": "sdk_initialized",
      "add": [
        "distributed_tracing_configured"
      ]
    },
    "instrument_genai_traces": {
      "owner": "agent",
      "pre": "sdk_initialized",
      "add": [
        "genai_traces_instrumented"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "search_microsoft_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_package",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_sdk_init",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "add_tracking_calls",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_distributed_tracing",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "instrument_genai_traces",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "package_installed",
      "sdk_initialized",
      "tracking_added"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
