{
  "name": "airunway-aks-setup",
  "roles": [
    "assistant"
  ],
  "capabilities": {
    "verify_cluster": {
      "owner": "assistant",
      "pre": true,
      "add": [
        "cluster_verified"
      ]
    },
    "install_controller": {
      "owner": "assistant",
      "pre": "cluster_verified",
      "add": [
        "controller_installed"
      ]
    },
    "assess_gpu": {
      "owner": "assistant",
      "pre": "controller_installed",
      "add": [
        "gpu_assessed"
      ]
    },
    "install_provider": {
      "owner": "assistant",
      "pre": "gpu_assessed",
      "add": [
        "provider_installed"
      ]
    },
    "deploy_model": {
      "owner": "assistant",
      "pre": "provider_installed",
      "add": [
        "model_deployed"
      ]
    },
    "summarize": {
      "owner": "assistant",
      "pre": "model_deployed",
      "add": [
        "summary_given"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "verify_cluster",
        "by": "assistant"
      }
    },
    {
      "choice": {
        "by": "assistant",
        "observed": true,
        "branches": {
          "confirm": [
            {
              "act": {
                "cap": "install_controller",
                "by": "assistant"
              }
            }
          ],
          "decline": []
        }
      }
    },
    {
      "act": {
        "cap": "assess_gpu",
        "by": "assistant"
      }
    },
    {
      "choice": {
        "by": "assistant",
        "observed": true,
        "branches": {
          "confirm": [
            {
              "act": {
                "cap": "install_provider",
                "by": "assistant"
              }
            }
          ],
          "decline": []
        }
      }
    },
    {
      "choice": {
        "by": "assistant",
        "observed": true,
        "branches": {
          "confirm": [
            {
              "act": {
                "cap": "deploy_model",
                "by": "assistant"
              }
            }
          ],
          "decline": []
        }
      }
    },
    {
      "act": {
        "cap": "summarize",
        "by": "assistant"
      }
    }
  ],
  "goal": {
    "and": [
      "cluster_verified",
      {
        "and": [
          "controller_installed",
          {
            "and": [
              "gpu_assessed",
              {
                "and": [
                  "provider_installed",
                  {
                    "and": [
                      "model_deployed",
                      "summary_given"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "init_true": [],
  "init_constraints": []
}
