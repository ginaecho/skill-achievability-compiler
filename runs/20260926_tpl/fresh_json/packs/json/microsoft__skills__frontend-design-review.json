{
  "name": "frontend-design-review",
  "roles": [
    "reviewer"
  ],
  "capabilities": {
    "identify_user_task": {
      "owner": "reviewer",
      "pre": true,
      "add": [
        "task_identified"
      ]
    },
    "check_design_system": {
      "owner": "reviewer",
      "pre": "task_identified",
      "add": [
        "design_system_checked"
      ]
    },
    "get_figma_specs": {
      "owner": "reviewer",
      "pre": "task_identified",
      "add": [
        "figma_specs_obtained"
      ]
    },
    "implement_ui": {
      "owner": "reviewer",
      "pre": {
        "and": [
          "design_system_checked",
          "figma_specs_obtained"
        ]
      },
      "add": [
        "ui_implemented"
      ]
    },
    "evaluate_pillars": {
      "owner": "reviewer",
      "pre": "ui_implemented",
      "add": [
        "pillars_evaluated"
      ]
    },
    "score_issues": {
      "owner": "reviewer",
      "pre": "pillars_evaluated",
      "add": [
        "issues_scored"
      ]
    },
    "provide_recommendations": {
      "owner": "reviewer",
      "pre": "issues_scored",
      "add": [
        "recommendations_given"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "identify_user_task",
        "by": "reviewer"
      }
    },
    {
      "act": {
        "cap": "check_design_system",
        "by": "reviewer"
      }
    },
    {
      "act": {
        "cap": "get_figma_specs",
        "by": "reviewer"
      }
    },
    {
      "act": {
        "cap": "implement_ui",
        "by": "reviewer"
      }
    },
    {
      "act": {
        "cap": "evaluate_pillars",
        "by": "reviewer"
      }
    },
    {
      "act": {
        "cap": "score_issues",
        "by": "reviewer"
      }
    },
    {
      "act": {
        "cap": "provide_recommendations",
        "by": "reviewer"
      }
    }
  ],
  "goal": "recommendations_given",
  "init_true": [],
  "init_constraints": []
}
