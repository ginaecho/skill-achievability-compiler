{
  "name": "interpreting-culture-index",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "extract_pdf": {
      "owner": "agent",
      "pre": true,
      "add": [
        "has_json"
      ]
    },
    "read_file": {
      "owner": "agent",
      "pre": true,
      "add": [
        "has_data"
      ]
    },
    "read_workflow": {
      "owner": "agent",
      "pre": true,
      "add": [
        "workflow_loaded"
      ]
    },
    "interpret": {
      "owner": "agent",
      "pre": {
        "and": [
          "has_data",
          "workflow_loaded"
        ]
      },
      "add": [
        "used_relative_positions",
        "referenced_arrow",
        "compared_survey_job",
        "avoided_value_judgments",
        "checked_eu"
      ]
    },
    "report": {
      "owner": "agent",
      "pre": {
        "and": [
          "used_relative_positions",
          "referenced_arrow",
          "compared_survey_job",
          "avoided_value_judgments",
          "checked_eu"
        ]
      },
      "add": [
        "interpretation_reported"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "json_provided": [
            {
              "act": {
                "cap": "read_file",
                "by": "agent"
              }
            }
          ],
          "pdf_provided": [
            {
              "act": {
                "cap": "extract_pdf",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "read_file",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "read_workflow",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "interpret",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "report",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "interpretation_reported",
      "used_relative_positions",
      "referenced_arrow",
      "compared_survey_job",
      "avoided_value_judgments",
      "checked_eu"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
