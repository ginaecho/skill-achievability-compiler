{
  "name": "provider-ephemeral-resources",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "define_schema": {
      "owner": "agent",
      "add": [
        "schema_defined"
      ]
    },
    "implement_open": {
      "owner": "agent",
      "pre": "schema_defined",
      "add": [
        "open_implemented"
      ]
    },
    "implement_renew": {
      "owner": "agent",
      "pre": "open_implemented",
      "add": [
        "renew_implemented"
      ]
    },
    "implement_close": {
      "owner": "agent",
      "pre": "open_implemented",
      "add": [
        "close_implemented"
      ]
    },
    "register_resource": {
      "owner": "agent",
      "pre": "open_implemented",
      "add": [
        "registered"
      ]
    },
    "write_tests": {
      "owner": "agent",
      "pre": "registered",
      "add": [
        "tested"
      ]
    },
    "write_docs": {
      "owner": "agent",
      "pre": "registered",
      "add": [
        "documented"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "define_schema",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "implement_open",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "renewable": [
            {
              "act": {
                "cap": "implement_renew",
                "by": "agent"
              }
            }
          ],
          "not_renewable": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "revocable": [
            {
              "act": {
                "cap": "implement_close",
                "by": "agent"
              }
            }
          ],
          "not_revocable": []
        }
      }
    },
    {
      "act": {
        "cap": "register_resource",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_tests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_docs",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "registered",
      "tested",
      "documented"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
