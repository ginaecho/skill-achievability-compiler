{
  "name": "provider-docs",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "confirm_scope": {
      "owner": "agent",
      "add": [
        "scope_confirmed"
      ]
    },
    "write_schema_descriptions": {
      "owner": "agent",
      "pre": "scope_confirmed",
      "add": [
        "descriptions_written"
      ]
    },
    "update_templates": {
      "owner": "agent",
      "pre": "descriptions_written",
      "add": [
        "templates_updated"
      ]
    },
    "generate_docs": {
      "owner": "agent",
      "pre": "templates_updated",
      "add": [
        "docs_generated"
      ]
    },
    "validate_docs": {
      "owner": "agent",
      "pre": "docs_generated",
      "add": [
        "docs_validated"
      ]
    },
    "prepare_release": {
      "owner": "agent",
      "pre": "docs_validated",
      "add": [
        "release_prepared"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "confirm_scope",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_schema_descriptions",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "update_templates",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_docs",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "templates_updated",
      "docs_generated",
      "docs_validated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
