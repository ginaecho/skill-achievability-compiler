{
  "name": "code-review",
  "roles": [
    "reviewer"
  ],
  "capabilities": {
    "inspect_code": {
      "owner": "reviewer",
      "pre": true,
      "add": [
        "code_inspected"
      ]
    },
    "check_tests": {
      "owner": "reviewer",
      "pre": "code_inspected",
      "add": [
        "tests_checked"
      ]
    },
    "assess_design": {
      "owner": "reviewer",
      "pre": "code_inspected",
      "add": [
        "design_assessed"
      ]
    },
    "give_feedback": {
      "owner": "reviewer",
      "pre": {
        "and": [
          "tests_checked",
          "design_assessed"
        ]
      },
      "add": [
        "feedback_given"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_code",
        "by": "reviewer"
      }
    },
    {
      "act": {
        "cap": "check_tests",
        "by": "reviewer"
      }
    },
    {
      "act": {
        "cap": "assess_design",
        "by": "reviewer"
      }
    },
    {
      "act": {
        "cap": "give_feedback",
        "by": "reviewer"
      }
    }
  ],
  "goal": "feedback_given",
  "init_true": [],
  "init_constraints": []
}
