{
  "name": "hf-mcp",
  "roles": [
    "assistant"
  ],
  "capabilities": {
    "model_search": {
      "owner": "assistant",
      "pre": true,
      "add": [
        "have_model_results"
      ]
    },
    "dataset_search": {
      "owner": "assistant",
      "pre": true,
      "add": [
        "have_dataset_results"
      ]
    },
    "space_search": {
      "owner": "assistant",
      "pre": true,
      "add": [
        "have_space_results"
      ]
    },
    "paper_search": {
      "owner": "assistant",
      "pre": true,
      "add": [
        "have_paper_results"
      ]
    },
    "hub_repo_details": {
      "owner": "assistant",
      "pre": {
        "or": [
          "have_model_results",
          {
            "or": [
              "have_dataset_results",
              "have_paper_results"
            ]
          }
        ]
      },
      "add": [
        "have_repo_details"
      ]
    },
    "hf_doc_search": {
      "owner": "assistant",
      "pre": true,
      "add": [
        "have_doc_results"
      ]
    },
    "hf_doc_fetch": {
      "owner": "assistant",
      "pre": "have_doc_results",
      "add": [
        "have_doc_content"
      ]
    },
    "dynamic_space": {
      "owner": "assistant",
      "pre": "have_space_results",
      "add": [
        "space_invoked"
      ]
    },
    "gr1_flux1_schnell_infer": {
      "owner": "assistant",
      "pre": true,
      "add": [
        "image_generated"
      ]
    },
    "hf_jobs": {
      "owner": "assistant",
      "pre": true,
      "add": [
        "job_run"
      ]
    },
    "hf_whoami": {
      "owner": "assistant",
      "pre": true,
      "add": [
        "auth_checked"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "assistant",
        "observed": true,
        "branches": {
          "find_model": [
            {
              "act": {
                "cap": "model_search",
                "by": "assistant"
              }
            },
            {
              "act": {
                "cap": "hub_repo_details",
                "by": "assistant"
              }
            }
          ],
          "find_dataset": [
            {
              "act": {
                "cap": "dataset_search",
                "by": "assistant"
              }
            },
            {
              "act": {
                "cap": "hub_repo_details",
                "by": "assistant"
              }
            }
          ],
          "discover_tool": [
            {
              "act": {
                "cap": "space_search",
                "by": "assistant"
              }
            },
            {
              "act": {
                "cap": "dynamic_space",
                "by": "assistant"
              }
            }
          ],
          "generate_image": [
            {
              "act": {
                "cap": "gr1_flux1_schnell_infer",
                "by": "assistant"
              }
            }
          ],
          "research_topic": [
            {
              "act": {
                "cap": "paper_search",
                "by": "assistant"
              }
            }
          ],
          "learn_library": [
            {
              "act": {
                "cap": "hf_doc_search",
                "by": "assistant"
              }
            },
            {
              "act": {
                "cap": "hf_doc_fetch",
                "by": "assistant"
              }
            }
          ],
          "run_job": [
            {
              "act": {
                "cap": "hf_jobs",
                "by": "assistant"
              }
            }
          ],
          "check_auth": [
            {
              "act": {
                "cap": "hf_whoami",
                "by": "assistant"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "or": [
      "have_repo_details",
      {
        "or": [
          "space_invoked",
          {
            "or": [
              "image_generated",
              {
                "or": [
                  "job_run",
                  {
                    "or": [
                      "have_doc_content",
                      "auth_checked"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "init_true": [],
  "init_constraints": []
}
