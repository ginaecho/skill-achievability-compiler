{
  "name": "gha-security-review",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "read_workflows": {
      "owner": "agent",
      "add": [
        "workflows_read"
      ]
    },
    "load_reference": {
      "owner": "agent",
      "pre": "workflows_read",
      "add": [
        "references_loaded"
      ]
    },
    "analyze_vulnerabilities": {
      "owner": "agent",
      "pre": "references_loaded",
      "add": [
        "vulnerabilities_analyzed"
      ]
    },
    "validate_findings": {
      "owner": "agent",
      "pre": "vulnerabilities_analyzed",
      "add": [
        "findings_validated"
      ]
    },
    "report_findings": {
      "owner": "agent",
      "pre": "findings_validated",
      "add": [
        "findings_reported"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_workflows",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "load_reference",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "analyze_vulnerabilities",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_findings",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "report_findings",
        "by": "agent"
      }
    }
  ],
  "goal": "findings_reported",
  "init_true": [],
  "init_constraints": []
}
