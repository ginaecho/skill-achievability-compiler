{
  "name": "dimensional-analysis",
  "roles": [
    "orchestrator",
    "scanner",
    "discoverer",
    "annotator",
    "propagator",
    "validator"
  ],
  "capabilities": {
    "scan": {
      "owner": "scanner",
      "pre": true,
      "add": [
        "scope_written"
      ]
    },
    "discover": {
      "owner": "discoverer",
      "pre": "scope_written",
      "add": [
        "vocab_written"
      ]
    },
    "annotate": {
      "owner": "annotator",
      "pre": {
        "and": [
          "scope_written",
          "vocab_written"
        ]
      },
      "add": [
        "step2_done"
      ]
    },
    "propagate": {
      "owner": "propagator",
      "pre": "step2_done",
      "add": [
        "step3_done"
      ]
    },
    "validate": {
      "owner": "validator",
      "pre": "step3_done",
      "add": [
        "step4_done"
      ]
    },
    "report": {
      "owner": "orchestrator",
      "pre": "step4_done",
      "add": [
        "final_report_written"
      ]
    }
  },
  "protocol": [
    {
      "spawn": {
        "role": "scanner"
      }
    },
    {
      "act": {
        "cap": "scan",
        "by": "scanner"
      }
    },
    {
      "spawn": {
        "role": "discoverer"
      }
    },
    {
      "act": {
        "cap": "discover",
        "by": "discoverer"
      }
    },
    {
      "spawn": {
        "role": "annotator"
      }
    },
    {
      "act": {
        "cap": "annotate",
        "by": "annotator"
      }
    },
    {
      "spawn": {
        "role": "propagator"
      }
    },
    {
      "act": {
        "cap": "propagate",
        "by": "propagator"
      }
    },
    {
      "spawn": {
        "role": "validator"
      }
    },
    {
      "act": {
        "cap": "validate",
        "by": "validator"
      }
    },
    {
      "act": {
        "cap": "report",
        "by": "orchestrator"
      }
    }
  ],
  "goal": {
    "and": [
      "scope_written",
      "vocab_written",
      "step2_done",
      "step3_done",
      "step4_done",
      "final_report_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
