{
  "name": "expo-overview",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "detect_sdk_version": {
      "owner": "agent",
      "pre": true,
      "add": [
        "sdk_detected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_docs": {
      "owner": "agent",
      "pre": "sdk_detected",
      "add": [
        "docs_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scaffold_app": {
      "owner": "agent",
      "pre": true,
      "add": [
        "app_scaffolded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_package": {
      "owner": "agent",
      "pre": true,
      "add": [
        "package_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "detect_sdk_version",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "new_app": [
            {
              "act": {
                "cap": "scaffold_app",
                "by": "agent"
              }
            }
          ],
          "existing_app": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "needs_package": [
            {
              "act": {
                "cap": "install_package",
                "by": "agent"
              }
            }
          ],
          "no_package_needed": []
        }
      }
    },
    {
      "act": {
        "cap": "read_docs",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "sdk_detected",
      "docs_read"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
