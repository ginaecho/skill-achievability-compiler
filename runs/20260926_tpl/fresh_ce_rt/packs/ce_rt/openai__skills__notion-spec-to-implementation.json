{
  "name": "notion-spec-to-implementation",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {},
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "multiple_matches": [
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "select_spec": []
                }
              }
            }
          ],
          "single_match": []
        }
      }
    },
    {
      "act": {
        "cap": "search_spec",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_spec",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_plan_page",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_tasks",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "link_artifacts",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "spec_read",
      "plan_created",
      "tasks_created",
      "artifacts_linked"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
