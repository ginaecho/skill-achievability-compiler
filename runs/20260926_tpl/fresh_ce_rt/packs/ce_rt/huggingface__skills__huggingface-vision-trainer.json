      "act": {
        "cap": "validate_dataset",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_training_script",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "ask_preferences",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "submit_job",
        "by": "agent"
      }
    }
  ],
  "goal": "job_submitted",
  "init_true": [],
  "init_constraints": []
}
