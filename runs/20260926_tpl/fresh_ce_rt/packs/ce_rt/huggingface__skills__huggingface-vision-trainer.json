{
  "name": "huggingface-vision-trainer",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "validate_dataset": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:hf_account"
        ]
      },
      "add": [
        "dataset_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_training_script": {
      "owner": "agent",
      "pre": "dataset_validated",
      "add": [
        "script_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_preferences": {
      "owner": "agent",
      "pre": "script_written",
      "add": [
        "preferences_set"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "submit_job": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:hf_account",
          "preferences_set"
        ]
      },
      "add": [
        "job_submitted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
