{
  "name": "expo-app-clip",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "set_bundle_id": {
      "owner": "agent",
      "pre": true,
      "add": [
        "bundle_id_set"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "add_clip_target": {
      "owner": "agent",
      "pre": "bundle_id_set",
      "add": [
        "clip_target_added"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_associated_domains": {
      "owner": "agent",
      "pre": "clip_target_added",
      "add": [
        "domains_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "register_bundle_ids": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:apple_developer_account",
          "domains_configured"
        ]
      },
      "add": [
        "bundle_ids_registered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_aasa_file": {
      "owner": "agent",
      "pre": "bundle_ids_registered",
      "add": [
        "aasa_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "add_smart_app_banner": {
      "owner": "agent",
      "pre": "aasa_written",
      "add": [
        "banner_added"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_website": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:eas_account",
          "banner_added"
        ]
      },
      "add": [
        "website_deployed",
        "aasa_hosted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "mirror_permissions": {
      "owner": "agent",
      "pre": "website_deployed",
      "add": [
        "permissions_mirrored"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_and_submit_testflight": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:apple_developer_account",
          "needs:eas_account",
          "permissions_mirrored"
        ]
      },
      "add": [
        "testflight_submitted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_appclip_metadata": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:eas_account",
          "testflight_submitted"
        ]
      },
      "add": [
        "metadata_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "set_bundle_id",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "add_clip_target",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_associated_domains",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "register_bundle_ids",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_aasa_file",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "add_smart_app_banner",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "deploy_website",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "mirror_permissions",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_and_submit_testflight",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_appclip_metadata",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "aasa_hosted",
      "testflight_submitted"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
