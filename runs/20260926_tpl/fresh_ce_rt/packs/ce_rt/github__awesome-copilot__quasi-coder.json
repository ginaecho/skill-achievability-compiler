{
  "name": "quasi-coder",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "read_source": {
      "owner": "agent",
      "pre": true,
      "add": [
        "shorthand_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_user_clarify": {
      "owner": "agent",
      "pre": "shorthand_read",
      "add": [
        "clarified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_code": {
      "owner": "agent",
      "pre": "shorthand_read",
      "add": [
        "code_implemented"
      ],
      "del": [
