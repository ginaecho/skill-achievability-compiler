{
  "name": "huggingface-spaces",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_hf_cli": {
      "owner": "agent",
      "pre": true,
      "add": [
        "hf_cli_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "login_hf": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:hf_account",
          "hf_cli_checked"
        ]
      },
      "add": [
        "logged_in"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "search_existing_spaces": {
      "owner": "agent",
      "pre": "logged_in",
      "add": [
        "prior_art_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_space": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:hf_account",
          "prior_art_checked"
        ]
      },
      "add": [
        "space_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_app_files": {
      "owner": "agent",
      "pre": "space_created",
      "add": [
        "app_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "push_space": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:hf_account",
          "app_written"
        ]
      },
      "add": [
        "space_pushed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_space": {
      "owner": "agent",
      "pre": "space_pushed",
      "add": [
        "space_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_hf_cli",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "login_hf",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "search_existing_spaces",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_space",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_app_files",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "push_space",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_space",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "space_pushed",
      "space_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
