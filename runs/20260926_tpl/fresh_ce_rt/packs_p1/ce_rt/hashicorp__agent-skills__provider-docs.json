{
  "name": "provider-docs",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "write_schema_descriptions": {
      "owner": "agent",
      "pre": true,
      "add": [
        "descriptions_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_templates": {
      "owner": "agent",
      "pre": "descriptions_written",
      "add": [
        "templates_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_docs": {
      "owner": "agent",
      "pre": "templates_written",
      "add": [
        "docs_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_docs": {
      "owner": "agent",
      "pre": "docs_generated",
      "add": [
        "docs_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "tag_release": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:registry_publish_rights",
          "docs_validated"
        ]
      },
      "add": [
        "released"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_schema_descriptions",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_templates",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_docs",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "release": [
            {
              "act": {
                "cap": "tag_release",
                "by": "agent"
              }
            }
          ],
          "skip_release": []
        }
      }
    }
  ],
  "goal": "docs_validated",
  "init_true": [],
  "init_constraints": []
}
