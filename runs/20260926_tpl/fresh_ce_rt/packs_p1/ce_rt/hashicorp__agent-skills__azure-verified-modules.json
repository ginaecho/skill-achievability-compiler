{
  "name": "azure-verified-modules",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "write_module": {
      "owner": "agent",
      "pre": true,
      "add": [
        "module_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_tests": {
      "owner": "agent",
      "pre": "module_written",
      "add": [
        "tests_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_docs": {
      "owner": "agent",
      "pre": "module_written",
      "add": [
        "docs_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "set_branch_protection": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_repo_admin",
          "module_written"
        ]
      },
      "add": [
        "branch_protected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_module",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_tests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_docs",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "set_up_branch_protection": [
            {
              "act": {
                "cap": "set_branch_protection",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "module_written",
      "tests_pass",
      "docs_generated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
