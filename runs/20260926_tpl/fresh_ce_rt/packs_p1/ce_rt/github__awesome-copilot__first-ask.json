{
  "name": "first-ask",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_human_input": {
      "owner": "agent",
      "pre": true,
      "add": [
        "input_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "explore_project": {
      "owner": "agent",
      "pre": true,
      "add": [
        "project_explored"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "web_research": {
      "owner": "agent",
      "pre": true,
      "add": [
        "web_researched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "confirm_understanding": {
      "owner": "agent",
      "pre": "input_gathered",
      "add": [
        "understanding_confirmed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "rec": {
        "name": "refine",
        "body": [
          {
            "act": {
              "cap": "ask_human_input",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "explore_more": [
                  {
                    "act": {
                      "cap": "explore_project",
                      "by": "agent"
                    }
                  }
                ],
                "research_more": [
                  {
                    "act": {
                      "cap": "web_research",
                      "by": "agent"
                    }
                  }
                ],
                "no_extra_investigation": []
              }
            }
          },
          {
            "choice": {
              "by": "user",
              "observed": true,
              "branches": {
                "has_more_input": [
                  {
                    "continue": "refine"
                  }
                ],
                "no_further_input": [
                  {
                    "act": {
                      "cap": "confirm_understanding",
                      "by": "agent"
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "goal": {
    "and": [
      "input_gathered",
      "understanding_confirmed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
