{
  "name": "huggingface-best",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "fetch_benchmark_list": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:huggingface_token"
        ]
      },
      "add": [
        "benchmarks_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_leaderboards": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:huggingface_token",
          "benchmarks_found"
        ]
      },
      "add": [
        "leaderboards_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_model_metadata": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:huggingface_token",
          "leaderboards_fetched"
        ]
      },
      "add": [
        "metadata_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "fetch_benchmark_list",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_leaderboards",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_model_metadata",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "user_wants_run": [
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "run_local": [],
                  "run_hf_jobs": []
                }
              }
            }
          ],
          "user_declines": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "benchmarks_found",
      "leaderboards_fetched",
      "metadata_fetched"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
