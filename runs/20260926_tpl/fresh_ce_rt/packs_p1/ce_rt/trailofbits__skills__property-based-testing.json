{
  "name": "property-based-testing",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "install_pbt_library": {
      "owner": "agent",
      "pre": true,
      "add": [
        "library_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_property_tests": {
      "owner": "agent",
      "pre": true,
      "add": [
        "tests_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_tests": {
      "owner": "agent",
      "pre": "tests_written",
      "add": [
        "tests_run"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "library_missing": [
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "user_accepts": [
                    {
                      "act": {
                        "cap": "install_pbt_library",
                        "by": "agent"
                      }
                    }
                  ],
                  "user_declines": []
                }
              }
            }
          ],
          "library_present": []
        }
      }
    },
    {
      "act": {
        "cap": "write_property_tests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_tests",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "tests_written",
      "tests_run"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
