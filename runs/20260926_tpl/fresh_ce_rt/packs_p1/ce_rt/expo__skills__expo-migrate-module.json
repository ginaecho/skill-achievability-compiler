{
  "name": "expo-migrate-module",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_contract": {
      "owner": "agent",
      "pre": true,
      "add": [
        "contract_established"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_macro_surface": {
      "owner": "agent",
      "pre": "contract_established",
      "add": [
        "surface_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "apply_migration": {
      "owner": "agent",
      "pre": "surface_verified",
      "add": [
        "migration_applied"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_verification": {
      "owner": "agent",
      "pre": "migration_applied",
      "add": [
        "verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_resolution": {
      "owner": "agent",
      "pre": true,
      "add": [
        "resolution_chosen"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "open_tracking_issue": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_write_access",
          "migration_applied"
        ]
      },
      "add": [
        "issue_opened"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_contract",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_macro_surface",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "apply_migration",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "blocked_item": [
            {
              "act": {
                "cap": "ask_resolution",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "coexist": [],
                  "revert": []
                }
              }
            },
            {
              "choice": {
                "by": "agent",
                "observed": true,
                "branches": {
                  "open_issue": [
                    {
                      "act": {
                        "cap": "open_tracking_issue",
                        "by": "agent"
                      }
                    }
                  ],
                  "skip_issue": []
                }
              }
            }
          ],
          "no_blocked_item": []
        }
      }
    },
    {
      "act": {
        "cap": "run_verification",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "migration_applied",
      "verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
