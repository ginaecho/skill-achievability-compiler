{
  "name": "acquire-codebase-knowledge",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "run_scan": {
      "owner": "agent",
      "pre": true,
      "add": [
        "scan_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_intent_docs": {
      "owner": "agent",
      "pre": "scan_done",
      "add": [
        "intent_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "populate_docs": {
      "owner": "agent",
      "pre": "intent_read",
      "add": [
        "docs_populated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_docs": {
      "owner": "agent",
      "pre": "docs_populated",
      "add": [
        "docs_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "run_scan",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_intent_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "populate_docs",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "validate_loop",
        "body": [
          {
            "act": {
              "cap": "validate_docs",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "fix_needed": [
                  {
                    "act": {
                      "cap": "populate_docs",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "validate_loop"
                  }
                ],
                "pass": []
              }
            }
          }
        ]
      }
    }
  ],
  "goal": {
    "and": [
      "docs_populated",
      "docs_validated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
