{
  "name": "document-api-endpoint",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "write_schema_decorators": {
      "owner": "agent",
      "pre": true,
      "add": [
        "schema_documented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "remove_legacy_docs": {
      "owner": "agent",
      "pre": "schema_documented",
      "add": [
        "legacy_removed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_live_endpoint": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:sentry_api_token",
          "schema_documented"
        ]
      },
      "add": [
        "runtime_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_docs": {
      "owner": "agent",
      "pre": "schema_documented",
      "add": [
        "docs_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "promote_endpoint": {
      "owner": "agent",
      "pre": "schema_documented",
      "add": [
        "endpoint_public"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_schema_decorators",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "has_legacy_docs": [
            {
              "act": {
                "cap": "remove_legacy_docs",
                "by": "agent"
              }
            }
          ],
          "no_legacy_docs": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "verify_live": [
            {
              "act": {
                "cap": "check_live_endpoint",
                "by": "agent"
              }
            }
          ],
          "skip_verify": []
        }
      }
    },
    {
      "act": {
        "cap": "validate_docs",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "promote": [
            {
              "act": {
                "cap": "promote_endpoint",
                "by": "agent"
              }
            }
          ],
          "keep_private": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "schema_documented",
      "docs_validated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
