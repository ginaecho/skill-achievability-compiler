{
  "name": "expo-web-to-native",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "write_worklist": {
      "owner": "agent",
      "pre": true,
      "add": [
        "worklist_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scaffold_shell": {
      "owner": "agent",
      "pre": "worklist_written",
      "add": [
        "shell_scaffolded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "wrap_dom_components": {
      "owner": "agent",
      "pre": "shell_scaffolded",
      "add": [
        "dom_shell_shipped"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_app": {
      "owner": "agent",
      "pre": "dom_shell_shipped",
      "add": [
        "app_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "nativize_screen": {
      "owner": "agent",
      "pre": "dom_shell_shipped",
      "add": [
        "screen_nativized"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "submit_to_stores": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:app_store_account",
          "dom_shell_shipped"
        ]
      },
      "add": [
        "app_published"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_worklist",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scaffold_shell",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "wrap_dom_components",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_app",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "nativize_more": [
            {
              "act": {
                "cap": "nativize_screen",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "publish": [
            {
              "act": {
                "cap": "submit_to_stores",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "dom_shell_shipped",
      "app_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
