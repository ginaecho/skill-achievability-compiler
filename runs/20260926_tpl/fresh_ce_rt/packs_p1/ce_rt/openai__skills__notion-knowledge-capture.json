{
  "name": "notion-knowledge-capture",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "setup_notion_mcp": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:notion_account"
        ]
      },
      "add": [
        "notion_connected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "setup_notion_mcp",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "existing_context": [
            {
              "act": {
                "cap": "search_notion",
                "by": "agent"
              }
            }
          ],
          "new": []
        }
      }
    },
    {
      "act": {
        "cap": "create_page",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "request_update": [
            {
              "act": {
                "cap": "update_page",
                "by": "agent"
              }
            }
          ],
          "done": []
        }
      }
    }
  ],
  "goal": "page_created",
  "init_true": [],
  "init_constraints": []
}
