{
  "name": "azure-resource-manager-postgresql-dotnet",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "create_server": {
      "owner": "agent",
      "pre": "arm_write",
      "add": [
        "server_exists"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_firewall": {
      "owner": "agent",
      "pre": {
        "and": [
          "server_exists",
          "arm_write"
        ]
      },
      "add": [
        "client_allowed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "create_server",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_database",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "add_firewall": [
            {
              "act": {
                "cap": "configure_firewall",
                "by": "agent"
              }
            }
          ],
          "skip_firewall": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "server_exists",
      "database_exists"
    ]
  },
  "init_true": [
    "arm_write"
  ],
  "init_constraints": []
}
