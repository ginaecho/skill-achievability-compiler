{
  "name": "huggingface-vision-trainer",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "validate_dataset": {
      "owner": "agent",
      "pre": true,
      "add": [
        "dataset_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_preferences": {
      "owner": "agent",
      "pre": true,
      "add": [
        "preferences_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "submit_training_job": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:huggingface_account",
          {
            "and": [
              "dataset_validated",
              "preferences_known"
            ]
          }
        ]
      },
      "add": [
        "job_submitted",
        "model_on_hub"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "validate_dataset",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "ask_preferences",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "submit_training_job",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "job_submitted",
      "model_on_hub"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
