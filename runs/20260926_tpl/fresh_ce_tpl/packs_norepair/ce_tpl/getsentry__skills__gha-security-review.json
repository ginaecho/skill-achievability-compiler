{
  "name": "gha-security-review",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "scan_workflows": {
      "owner": "agent",
      "pre": true,
      "add": [
        "workflows_scanned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "trace_attack_path": {
      "owner": "agent",
      "pre": "workflows_scanned",
      "add": [
        "attack_paths_traced"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "prepare_finding_report": {
      "owner": "agent",
      "pre": "attack_paths_traced",
      "add": [
        "report_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "post_findings": {
      "owner": "agent",
      "pre": {
        "and": [
          "policy:writes_external",
          "report_ready"
        ]
      },
      "add": [
        "findings_posted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "scan_workflows",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "trace_attack_path",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "prepare_finding_report",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "no_post": []
        }
      }
    }
  ],
  "goal": "report_ready",
  "init_true": [],
  "init_constraints": []
}
