{
  "name": "huggingface-spaces",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_and_login": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:huggingface_account"
        ]
      },
      "add": [
        "logged_in"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_space": {
      "owner": "agent",
      "pre": {
        "and": [
          "policy:publishes",
          "logged_in"
        ]
      },
      "add": [
        "space_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_app_files": {
      "owner": "agent",
      "pre": "space_created",
      "add": [
        "app_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "push_space": {
      "owner": "agent",
      "pre": {
        "and": [
          "policy:writes_external",
          {
            "and": [
              "app_built",
              "logged_in"
            ]
          }
        ]
      },
      "add": [
        "space_deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_space": {
      "owner": "agent",
      "pre": "space_deployed",
      "add": [
        "space_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_and_login",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_space",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_app_files",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "push_space",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_space",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "space_deployed",
      "space_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
