{
  "name": "first-ask",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_clarifying_question": {
      "owner": "agent",
      "pre": true,
      "add": [
        "input_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "explore_project": {
      "owner": "agent",
      "pre": true,
      "add": [
        "explored"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "web_research": {
      "owner": "agent",
      "pre": true,
      "add": [
        "researched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_further_input": {
      "owner": "agent",
      "pre": true,
      "add": [
        "checked_further_input"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "rec": {
        "name": "refine",
        "body": [
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "clarify": [
                  {
                    "act": {
                      "cap": "ask_clarifying_question",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "refine"
                  }
                ],
                "explore": [
                  {
                    "act": {
                      "cap": "explore_project",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "refine"
                  }
                ],
                "research": [
                  {
                    "act": {
                      "cap": "web_research",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "refine"
                  }
                ],
                "sufficient": []
              }
            }
          }
        ]
      }
    },
    {
      "rec": {
        "name": "confirm",
        "body": [
          {
            "act": {
              "cap": "ask_further_input",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "user",
              "observed": true,
              "branches": {
                "more_input": [
                  {
                    "continue": "confirm"
                  }
                ],
                "no_further_input": []
              }
            }
          }
        ]
      }
    }
  ],
  "goal": "checked_further_input",
  "init_true": [],
  "init_constraints": []
}
