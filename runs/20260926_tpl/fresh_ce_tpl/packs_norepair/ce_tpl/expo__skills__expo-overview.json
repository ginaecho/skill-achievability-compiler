{
  "name": "expo-overview",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "scaffold_project": {
      "owner": "agent",
      "pre": true,
      "add": [
        "project_scaffolded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_packages": {
      "owner": "agent",
      "pre": "project_scaffolded",
      "add": [
        "packages_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_app_code": {
      "owner": "agent",
      "pre": "packages_installed",
      "add": [
        "code_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "type_check": {
      "owner": "agent",
      "pre": "code_written",
      "add": [
        "verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "eas_action": {
      "owner": "agent",
      "pre": {
        "and": [
          "policy:writes_external",
          {
            "and": [
              "needs:expo_account",
              "code_written"
            ]
          }
        ]
      },
      "add": [
        "eas_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "submit_feedback": {
      "owner": "agent",
      "pre": {
        "and": [
          "policy:writes_external"
        ]
      },
      "add": [
        "feedback_submitted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "scaffold_project",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_packages",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_app_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "type_check",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip_device": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip_eas": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip_feedback": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "project_scaffolded",
      "packages_installed",
      "code_written",
      "verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
