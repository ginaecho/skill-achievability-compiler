{
  "name": "huggingface-best",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "fetch_benchmarks": {
      "owner": "agent",
      "pre": true,
      "add": [
        "benchmarks_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_leaderboards": {
      "owner": "agent",
      "pre": "benchmarks_found",
      "add": [
        "leaderboard_data"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_model_metadata": {
      "owner": "agent",
      "pre": "leaderboard_data",
      "add": [
        "model_metadata"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_hf_job": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:huggingface_account",
          "model_metadata"
        ]
      },
      "add": [
        "job_run"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "fetch_benchmarks",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_leaderboards",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_model_metadata",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "run_locally_or_skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "benchmarks_found",
      "leaderboard_data",
      "model_metadata"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
