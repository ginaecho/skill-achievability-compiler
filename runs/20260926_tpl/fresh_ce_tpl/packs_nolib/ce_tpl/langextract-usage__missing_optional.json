{
  "name": "langextract-usage",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "extract_hosted": {
      "owner": "agent",
      "pre": {
        "and": [
          "examples_valid",
          "hosted_ready"
        ]
      },
      "add": [
        "grounded_entities"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "extract_local": {
      "owner": "agent",
      "pre": {
        "and": [
          "examples_valid",
          "ollama_ready"
        ]
      },
      "add": [
        "grounded_entities"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "save_results": {
      "owner": "agent",
      "pre": "grounded_entities",
      "add": [
        "results_saved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "hosted": [
            {
              "act": {
                "cap": "extract_hosted",
                "by": "agent"
              }
            }
          ],
          "local": [
            {
              "act": {
                "cap": "extract_local",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "save_results",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "grounded_entities",
      "results_saved"
    ]
  },
  "init_true": [
    "examples_valid",
    "hosted_ready",
    "ollama_ready"
  ],
  "init_constraints": []
}
