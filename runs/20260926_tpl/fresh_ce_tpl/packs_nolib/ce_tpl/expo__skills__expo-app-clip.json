{
  "name": "expo-app-clip",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "set_bundle_config": {
      "owner": "agent",
      "pre": true,
      "add": [
        "config_set"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "add_clip_target": {
      "owner": "agent",
      "pre": "config_set",
      "add": [
        "clip_target_added"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_associated_domains": {
      "owner": "agent",
      "pre": "clip_target_added",
      "add": [
        "domains_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "register_bundle_ids": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:apple_developer_account",
          "domains_configured"
        ]
      },
      "add": [
        "bundle_registered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_aasa_file": {
      "owner": "agent",
      "pre": "bundle_registered",
      "add": [
        "aasa_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "add_smart_app_banner": {
      "owner": "agent",
      "pre": "clip_target_added",
      "add": [
        "banner_added"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_website": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:expo_account",
          {
            "and": [
              "aasa_written",
              "banner_added"
            ]
          }
        ]
      },
      "add": [
        "aasa_hosted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_and_submit_testflight": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:expo_account",
          "aasa_hosted"
        ]
      },
      "add": [
        "testflight_build_submitted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "submit_feedback": {
      "owner": "agent",
      "pre": true,
      "add": [
        "feedback_submitted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "set_bundle_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "add_clip_target",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_associated_domains",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "register_bundle_ids",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_aasa_file",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "add_smart_app_banner",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "deploy_website",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_and_submit_testflight",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "feedback": [
            {
              "act": {
                "cap": "submit_feedback",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "aasa_hosted",
      "testflight_build_submitted"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
