{
  "name": "provider-docs",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "write_schema_descriptions": {
      "owner": "agent",
      "pre": true,
      "add": [
        "schema_described"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "add_templates": {
      "owner": "agent",
      "pre": "schema_described",
      "add": [
        "templates_added"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_docs": {
      "owner": "agent",
      "pre": "templates_added",
      "add": [
        "docs_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_docs": {
      "owner": "agent",
      "pre": "docs_generated",
      "add": [
        "docs_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_release_tag": {
      "owner": "agent",
      "pre": {
        "and": [
          "policy:publishes",
          "docs_validated"
        ]
      },
      "add": [
        "release_tagged"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_schema_descriptions",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "add_templates",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_docs",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "validate_loop",
        "body": [
          {
            "act": {
              "cap": "validate_docs",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "fix": [
                  {
                    "act": {
                      "cap": "add_templates",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "validate_loop"
                  }
                ],
                "pass": []
              }
            }
          }
        ]
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "release": [
            {
              "act": {
                "cap": "create_release_tag",
                "by": "agent"
              }
            }
          ],
          "no_release": []
        }
      }
    }
  ],
  "goal": "docs_validated",
  "init_true": [],
  "init_constraints": []
}
