{
  "name": "azure-verified-modules",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "write_module": {
      "owner": "agent",
      "pre": true,
      "add": [
        "module_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_terraform_validate": {
      "owner": "agent",
      "pre": "module_written",
      "add": [
        "validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_tflint": {
      "owner": "agent",
      "pre": "module_written",
      "add": [
        "linted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_checkov": {
      "owner": "agent",
      "pre": "module_written",
      "add": [
        "security_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_docs": {
      "owner": "agent",
      "pre": "module_written",
      "add": [
        "docs_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "set_branch_protection": {
      "owner": "agent",
      "pre": {
        "and": [
          "policy:writes_external",
          {
            "and": [
              "needs:github_write_access",
              "module_written"
            ]
          }
        ]
      },
      "add": [
        "branch_protected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_module",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_terraform_validate",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_tflint",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_checkov",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_docs",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "protect_branch": [
            {
              "act": {
                "cap": "set_branch_protection",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "validated",
      "linted",
      "security_checked",
      "docs_generated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
