{
  "name": "transformers-js",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "install_transformers": {
      "owner": "agent",
      "pre": true,
      "add": [
        "library_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_pipeline": {
      "owner": "agent",
      "pre": "library_installed",
      "add": [
        "inference_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "push_to_hub": {
      "owner": "agent",
      "pre": {
        "and": [
          "policy:publishes",
          {
            "and": [
              "needs:huggingface_account",
              "inference_done"
            ]
          }
        ]
      },
      "add": [
        "model_published"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_transformers",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_pipeline",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "publish": [
            {
              "act": {
                "cap": "push_to_hub",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": "inference_done",
  "init_true": [],
  "init_constraints": []
}
