{
  "name": "applicationinsights-web-ts",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "install_sdk": {
      "owner": "agent",
      "pre": true,
      "add": [
        "sdk_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "init_sdk": {
      "owner": "agent",
      "pre": "sdk_installed",
      "add": [
        "sdk_initialized"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "add_click_analytics": {
      "owner": "agent",
      "pre": "sdk_initialized",
      "add": [
        "click_analytics_added"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "instrument_genai_agent": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:llm_api_key",
          "sdk_initialized"
        ]
      },
      "add": [
        "genai_traces_emitted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "send_telemetry": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "sdk_initialized"
        ]
      },
      "add": [
        "telemetry_sent"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_sdk",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "init_sdk",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "add_click_analytics": [
            {
              "act": {
                "cap": "add_click_analytics",
                "by": "agent"
              }
            }
          ],
          "skip_click_analytics": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "add_genai_traces": [
            {
              "act": {
                "cap": "instrument_genai_agent",
                "by": "agent"
              }
            }
          ],
          "skip_genai_traces": []
        }
      }
    },
    {
      "act": {
        "cap": "send_telemetry",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "sdk_installed",
      "sdk_initialized",
      "telemetry_sent"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
