{
  "name": "expo-brownfield",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_host": {
      "owner": "agent",
      "pre": true,
      "add": [
        "host_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_rn_deps": {
      "owner": "agent",
      "pre": "host_inspected",
      "add": [
        "deps_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_android_release": {
      "owner": "agent",
      "pre": "deps_installed",
      "add": [
        "host_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_feature": {
      "owner": "agent",
      "pre": "host_built",
      "add": [
        "feature_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "typecheck_local": {
      "owner": "agent",
      "pre": "deps_installed",
      "add": [
        "feature_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "eas_build": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:expo_account",
          "deps_installed"
        ]
      },
      "add": [
        "eas_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "submit_feedback": {
      "owner": "agent",
      "pre": {
        "and": [
          "policy:writes_external"
        ]
      },
      "add": [
        "feedback_submitted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_host",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_rn_deps",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "android": [
            {
              "act": {
                "cap": "build_android_release",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "verify_feature",
                "by": "agent"
              }
            }
          ],
          "ios": [
            {
              "act": {
                "cap": "build_ios_release",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "verify_feature",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "device_check": [
            {
              "act": {
                "cap": "run_on_device",
                "by": "agent"
              }
            }
          ],
          "local_check": [
            {
              "act": {
                "cap": "typecheck_local",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "use_eas": [
            {
              "act": {
                "cap": "eas_build",
                "by": "agent"
              }
            }
          ],
          "skip_eas": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "send_feedback": [
            {
              "act": {
                "cap": "submit_feedback",
                "by": "agent"
              }
            }
          ],
          "skip_feedback": []
        }
      }
    }
  ],
  "goal": "feature_verified",
  "init_true": [],
  "init_constraints": []
}
