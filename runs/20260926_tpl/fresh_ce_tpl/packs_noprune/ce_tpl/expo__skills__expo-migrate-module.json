{
  "name": "expo-migrate-module",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inventory_exports": {
      "owner": "agent",
      "pre": true,
      "add": [
        "inventory_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_macro_surface": {
      "owner": "agent",
      "pre": "inventory_done",
      "add": [
        "surface_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "migrate_group": {
      "owner": "agent",
      "pre": "surface_verified",
      "add": [
        "migration_applied"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_and_test": {
      "owner": "agent",
      "pre": "migration_applied",
      "add": [
        "verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "open_tracking_issue": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_account",
          "migration_applied"
        ]
      },
      "add": [
        "issue_opened"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "submit_feedback": {
      "owner": "agent",
      "pre": {
        "and": [
          "policy:writes_external"
        ]
      },
      "add": [
        "feedback_submitted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inventory_exports",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_macro_surface",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "migrate_group",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_and_test",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "blocked_item": [
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "coexist": [],
                  "revert": [
                    {
                      "act": {
                        "cap": "open_tracking_issue",
                        "by": "agent"
                      }
                    }
                  ]
                }
              }
            }
          ],
          "no_blocked": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "send_feedback": [
            {
              "act": {
                "cap": "submit_feedback",
                "by": "agent"
              }
            }
          ],
          "skip_feedback": []
        }
      }
    }
  ],
  "goal": "verified",
  "init_true": [],
  "init_constraints": []
}
