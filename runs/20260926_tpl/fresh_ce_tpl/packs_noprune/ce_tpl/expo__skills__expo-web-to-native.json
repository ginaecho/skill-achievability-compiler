{
  "name": "expo-web-to-native",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "write_worklist": {
      "owner": "agent",
      "pre": true,
      "add": [
        "worklist_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scaffold_shell": {
      "owner": "agent",
      "pre": "worklist_written",
      "add": [
        "shell_scaffolded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "dom_shell_screens": {
      "owner": "agent",
      "pre": "shell_scaffolded",
      "add": [
        "dom_shell_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "nativize_screens": {
      "owner": "agent",
      "pre": "dom_shell_done",
      "add": [
        "screens_nativized"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_hosting": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:expo_account",
          "screens_nativized"
        ]
      },
      "add": [
        "backend_hosted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "wire_data": {
      "owner": "agent",
      "pre": "screens_nativized",
      "add": [
        "data_wired"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_native_local": {
      "owner": "agent",
      "pre": "data_wired",
      "add": [
        "native_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ship_app": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:expo_account",
          "native_verified"
        ]
      },
      "add": [
        "app_shipped"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "submit_feedback": {
      "owner": "agent",
      "pre": {
        "and": [
          "policy:writes_external"
        ]
      },
      "add": [
        "feedback_submitted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_worklist",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scaffold_shell",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "dom_shell_screens",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "nativize_screens",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "keep_backend_deployed": [],
          "move_to_eas_hosting": [
            {
              "act": {
                "cap": "deploy_hosting",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "wire_data",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "verify_on_device": [
            {
              "act": {
                "cap": "verify_native",
                "by": "agent"
              }
            }
          ],
          "verify_local": [
            {
              "act": {
                "cap": "verify_native_local",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "ship_to_stores": [
            {
              "act": {
                "cap": "ship_app",
                "by": "agent"
              }
            }
          ],
          "skip_ship": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "report_feedback": [
            {
              "act": {
                "cap": "submit_feedback",
                "by": "agent"
              }
            }
          ],
          "skip_feedback": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "worklist_written",
      "shell_scaffolded",
      "dom_shell_done",
      "screens_nativized",
      "data_wired",
      "native_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
