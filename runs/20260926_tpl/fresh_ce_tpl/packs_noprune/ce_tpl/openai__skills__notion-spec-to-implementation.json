{
  "name": "notion-spec-to-implementation",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {},
  "protocol": [
    {
      "act": {
        "cap": "search_spec",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_spec",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_plan_page",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_tasks",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "link_artifacts",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "track_progress": [
            {
              "act": {
                "cap": "update_spec_status",
                "by": "agent"
              }
            }
          ],
          "skip_tracking": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "plan_created",
      "tasks_created",
      "artifacts_linked"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
