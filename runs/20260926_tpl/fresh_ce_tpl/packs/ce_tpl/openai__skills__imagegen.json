{
  "name": "imagegen",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "generate_image_cli": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:llm_api_key"
        ]
      },
      "add": [
        "image_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "save_to_workspace": {
      "owner": "agent",
      "pre": "image_generated",
      "add": [
        "asset_saved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "builtin_mode": [
            {
              "act": {
                "cap": "generate_image_builtin",
                "by": "agent"
              }
            }
          ],
          "cli_fallback_mode": [
            {
              "act": {
                "cap": "generate_image_cli",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "project_bound": [
            {
              "act": {
                "cap": "save_to_workspace",
                "by": "agent"
              }
            }
          ],
          "preview_only": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "image_generated",
      "asset_saved"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
