{
  "name": "document-api-endpoint",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "add_schema_decorators": {
      "owner": "agent",
      "pre": true,
      "add": [
        "schema_documented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "add_response_types": {
      "owner": "agent",
      "pre": "schema_documented",
      "add": [
        "response_typed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_live_endpoint": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:sentry_api_token",
          "response_typed"
        ]
      },
      "add": [
        "verified_live"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "remove_legacy_docs": {
      "owner": "agent",
      "pre": "response_typed",
      "add": [
        "legacy_removed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_docs": {
      "owner": "agent",
      "pre": "response_typed",
      "add": [
        "docs_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "add_schema_decorators",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "add_response_types",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip_live": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "has_legacy": [
            {
              "act": {
                "cap": "remove_legacy_docs",
                "by": "agent"
              }
            }
          ],
          "no_legacy": []
        }
      }
    },
    {
      "act": {
        "cap": "validate_docs",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "schema_documented",
      "response_typed",
      "docs_validated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
