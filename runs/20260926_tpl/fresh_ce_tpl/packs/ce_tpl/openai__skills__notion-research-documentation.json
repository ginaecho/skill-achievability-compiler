{
  "name": "notion-research-documentation",
  "roles": [
    "agent"
  ],
  "capabilities": {},
  "protocol": [
    {
      "act": {
        "cap": "notion_search",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "notion_fetch",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "notion_create_pages",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip_update": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "sources_found",
      "sources_fetched",
      "doc_created"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
