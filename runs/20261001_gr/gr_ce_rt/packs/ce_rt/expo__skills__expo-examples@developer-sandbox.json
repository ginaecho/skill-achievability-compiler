    "study_example": {
      "owner": "agent",
      "pre": "example_found",
      "add": [
        "example_studied"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_missing_deps": {
      "owner": "agent",
      "pre": "example_studied",
      "add": [
        "deps_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "merge_config": {
      "owner": "agent",
      "pre": "example_studied",
      "add": [
        "config_merged"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
