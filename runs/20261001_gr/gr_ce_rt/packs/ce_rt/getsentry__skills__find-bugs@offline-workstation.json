{
  "name": "find-bugs",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "get_diff": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet"
        ]
      },
      "add": [
        "diff_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_changed_files": {
      "owner": "agent",
      "pre": "diff_gathered",
      "add": [
        "files_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_issues": {
      "owner": "agent",
      "pre": "files_read",
      "add": [
        "issues_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "get_diff",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_changed_files",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_issues",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "diff_gathered",
      "files_read",
      "issues_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
