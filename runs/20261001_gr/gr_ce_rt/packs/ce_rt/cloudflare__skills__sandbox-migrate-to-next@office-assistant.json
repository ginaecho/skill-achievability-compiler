{
  "name": "sandbox-migrate-to-next",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "fetch_docs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "docs_reviewed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "audit_codebase": {
      "owner": "agent",
      "pre": "docs_reviewed",
      "add": [
        "audit_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "upgrade_package": {
      "owner": "agent",
      "pre": "audit_done",
      "add": [
        "package_upgraded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "upgrade_image": {
      "owner": "agent",
      "pre": "audit_done",
      "add": [
        "image_upgraded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "update_code": {
      "owner": "agent",
      "pre": {
        "and": [
          "package_upgraded",
          "image_upgraded"
        ]
      },
      "add": [
        "code_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate": {
      "owner": "agent",
      "pre": "code_updated",
      "add": [
        "validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "fetch_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "audit_codebase",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "upgrade_package",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "upgrade_image",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "update_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "package_upgraded",
      "image_upgraded",
      "code_updated",
      "validated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
