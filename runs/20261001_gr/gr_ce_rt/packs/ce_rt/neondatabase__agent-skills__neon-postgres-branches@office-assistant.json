{
  "name": "neon-postgres-branches",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "update_env_file": {
      "owner": "agent",
      "pre": "connection_string_obtained",
      "add": [
        "env_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_cli",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_branch",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "update_env": [
            {
              "act": {
                "cap": "get_connection_string",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "update_env_file",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": "branch_created",
  "init_true": [],
  "init_constraints": []
}
