{
  "name": "kermt-embed",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_system": {
      "owner": "agent",
      "pre": true,
      "add": [
        "system_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "download_ckpt": {
      "owner": "agent",
      "pre": "system_checked",
      "add": [
        "ckpt_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_ckpt": {
      "owner": "agent",
      "pre": "ckpt_ready",
      "add": [
        "ckpt_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_data": {
      "owner": "agent",
      "pre": "system_checked",
      "add": [
        "data_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "prepare_data": {
      "owner": "agent",
      "pre": "data_validated",
      "add": [
        "data_prepared"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_extract_embeddings": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:gpu",
          {
            "and": [
              "ckpt_validated",
              "data_prepared"
            ]
          }
        ]
      },
      "add": [
        "embeddings_extracted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_system",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "consent": [
            {
              "act": {
                "cap": "download_ckpt",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "validate_ckpt",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "validate_data",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "prepare_data",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "run_extract_embeddings",
                "by": "agent"
              }
            }
          ],
          "decline": []
        }
      }
    }
  ],
  "goal": "embeddings_extracted",
  "init_true": [],
  "init_constraints": []
}
