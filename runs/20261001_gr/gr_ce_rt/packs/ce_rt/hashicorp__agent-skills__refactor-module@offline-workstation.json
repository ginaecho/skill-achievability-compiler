{
  "name": "refactor-module",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "analyze_codebase": {
      "owner": "agent",
      "pre": true,
      "add": [
        "analysis_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "design_interface": {
      "owner": "agent",
      "pre": "analysis_done",
      "add": [
        "interface_designed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "transform_code": {
      "owner": "agent",
      "pre": "interface_designed",
      "add": [
        "code_transformed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "inspect_state": {
      "owner": "agent",
      "pre": true,
      "add": [
        "state_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "migrate_state": {
      "owner": "agent",
      "pre": {
        "and": [
          "code_transformed",
          "state_inspected"
        ]
      },
      "add": [
        "state_migrated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_documentation": {
      "owner": "agent",
      "pre": "code_transformed",
      "add": [
        "documented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_tests": {
      "owner": "agent",
      "pre": "code_transformed",
      "add": [
        "tests_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_tests": {
      "owner": "agent",
      "pre": "tests_written",
      "add": [
        "tests_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_plan_no_diff": {
      "owner": "agent",
      "pre": "state_migrated",
      "add": [
        "plan_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "analyze_codebase",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "design_interface",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "transform_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "inspect_state",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "migrate_state",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_documentation",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_tests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_tests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_plan_no_diff",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "code_transformed",
      "documented",
      "state_migrated",
      "plan_verified",
      "tests_pass"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
