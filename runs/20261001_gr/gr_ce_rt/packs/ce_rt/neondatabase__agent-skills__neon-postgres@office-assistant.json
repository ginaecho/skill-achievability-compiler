      "owner": "agent",
      "pre": "connection_string_obtained",
      "add": [
        "env_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "get_connection_string",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_env_file",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_migration",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_empty_plan",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "migration_applied",
      "plan_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
