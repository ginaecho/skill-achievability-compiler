{
  "name": "explore-data",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "load_file": {
      "owner": "agent",
      "pre": true,
      "add": [
        "data_loaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "profile_data": {
      "owner": "agent",
      "pre": "data_loaded",
      "add": [
        "profile_generated",
        "quality_assessed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_for_source": {
      "owner": "agent",
      "pre": true,
      "add": [
        "source_asked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "file_provided": [
            {
              "act": {
                "cap": "load_file",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "profile_data",
                "by": "agent"
              }
            }
          ],
          "no_source": [
            {
              "act": {
                "cap": "ask_for_source",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "data_loaded",
      "profile_generated",
      "quality_assessed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
