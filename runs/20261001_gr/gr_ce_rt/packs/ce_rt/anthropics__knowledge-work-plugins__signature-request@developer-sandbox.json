{
  "name": "signature-request",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "accept_document": {
      "owner": "agent",
      "pre": true,
      "add": [
        "document_accepted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "gather_signing_config": {
      "owner": "agent",
      "pre": "document_accepted",
      "add": [
        "signing_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_signing_instructions": {
      "owner": "agent",
      "pre": "signing_configured",
      "add": [
        "instructions_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "accept_document",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "gather_signing_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_signing_instructions",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "document_accepted",
      "signing_configured",
      {
        "or": [
          "sent_for_signature",
          "instructions_generated"
        ]
      }
    ]
  },
  "init_true": [],
  "init_constraints": []
}
