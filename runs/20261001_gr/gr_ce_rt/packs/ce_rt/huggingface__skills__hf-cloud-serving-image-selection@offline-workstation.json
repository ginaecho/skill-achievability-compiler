{
  "name": "hf-cloud-serving-image-selection",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "select_image_uri": {
      "owner": "agent",
      "pre": "catalog_fetched",
      "add": [
        "image_uri_selected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_model": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:aws_account",
          "image_uri_selected"
        ]
      },
      "add": [
        "model_deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_model_architecture",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_catalog",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "select_image_uri",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "deploy_model",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "image_uri_selected",
      "model_deployed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
