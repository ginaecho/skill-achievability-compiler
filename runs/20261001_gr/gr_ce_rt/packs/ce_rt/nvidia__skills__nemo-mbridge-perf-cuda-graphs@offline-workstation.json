{
  "name": "nemo-mbridge-perf-cuda-graphs",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "edit_config": {
      "owner": "agent",
      "pre": true,
      "add": [
        "config_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_unit_tests": {
      "owner": "agent",
      "pre": "config_updated",
      "add": [
        "unit_tests_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_functional_test": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:gpu_hardware",
          "unit_tests_pass"
        ]
      },
      "add": [
        "functional_test_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "edit_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_unit_tests",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "run_functional": [
            {
              "act": {
                "cap": "run_functional_test",
                "by": "agent"
              }
            }
          ],
          "skip_functional": []
        }
      }
    }
  ],
  "goal": "unit_tests_pass",
  "init_true": [],
  "init_constraints": []
}
