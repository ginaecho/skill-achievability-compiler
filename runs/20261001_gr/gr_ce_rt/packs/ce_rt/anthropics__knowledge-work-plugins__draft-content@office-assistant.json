{
  "name": "draft-content",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "gather_inputs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "inputs_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_brand_voice_file": {
      "owner": "agent",
      "pre": "inputs_gathered",
      "add": [
        "brand_voice_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_brand_voice": {
      "owner": "agent",
      "pre": "inputs_gathered",
      "add": [
        "brand_voice_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "gather_inputs",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
