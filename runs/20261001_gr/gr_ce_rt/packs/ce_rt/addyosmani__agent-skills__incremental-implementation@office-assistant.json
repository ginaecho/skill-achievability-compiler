{
  "name": "incremental-implementation",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "implement_slice": {
      "owner": "agent",
      "pre": true,
      "add": [
        "slice_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "implement_slice",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_tests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "commit_change",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "slice_implemented",
      "tests_pass",
      "committed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
