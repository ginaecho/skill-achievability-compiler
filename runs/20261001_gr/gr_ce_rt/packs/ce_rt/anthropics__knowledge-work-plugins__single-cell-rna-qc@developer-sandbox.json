{
  "name": "single-cell-rna-qc",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "install_dependencies": {
      "owner": "agent",
      "pre": true,
      "add": [
        "dependencies_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_qc_pipeline": {
      "owner": "agent",
      "pre": "dependencies_installed",
      "add": [
        "qc_completed",
        "filtered_data_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_dependencies",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_qc_pipeline",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "dependencies_installed",
      "qc_completed",
      "filtered_data_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
