{
  "name": "terraform-search-import",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "write_query_file": {
      "owner": "agent",
      "pre": "provider_checked",
      "add": [
        "query_file_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "review_cleanup": {
      "owner": "agent",
      "pre": "config_generated",
      "add": [
        "config_cleaned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_provider_support",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_terraform_init",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_query_file",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_query",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "review_cleanup",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "terraform_plan_apply",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_state",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "resources_imported",
      "state_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
