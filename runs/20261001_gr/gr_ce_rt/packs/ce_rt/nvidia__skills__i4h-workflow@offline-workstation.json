    },
    "list_live_support": {
      "owner": "agent",
      "pre": "checkout_resolved",
      "add": [
        "support_listed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "resolve_checkout",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_design_docs",
        "by": "agent"
      }
    },
    {
