        ]
      },
      "add": [
        "checkout_resolved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_design_docs": {
      "owner": "agent",
      "pre": "checkout_resolved",
      "add": [
        "design_read"
      ],
      "del": [],
      "assigns": {},
