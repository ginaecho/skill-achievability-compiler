{
  "name": "agentic-actions-auditor",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "discover_local_workflows": {
      "owner": "agent",
      "pre": true,
      "add": [
        "workflows_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_reference_docs": {
      "owner": "agent",
      "pre": "workflows_found",
      "add": [
        "references_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "local": [
            {
              "act": {
                "cap": "discover_local_workflows",
                "by": "agent"
              }
            }
          ],
          "remote": []
        }
      }
    },
    {
      "act": {
        "cap": "read_reference_docs",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "workflows_found",
      "references_read"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
