{
  "name": "planning-and-task-breakdown",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_existing_plan": {
      "owner": "agent",
      "pre": true,
      "add": [
        "plan_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_plan": {
      "owner": "agent",
      "pre": "plan_checked",
      "add": [
        "plan_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_todo": {
      "owner": "agent",
      "pre": "plan_checked",
      "add": [
        "todo_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_existing_plan",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_plan",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_todo",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "plan_written",
      "todo_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
