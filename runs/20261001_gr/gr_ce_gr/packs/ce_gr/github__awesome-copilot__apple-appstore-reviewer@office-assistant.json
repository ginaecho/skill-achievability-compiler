{
  "name": "apple-appstore-reviewer",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "review_codebase": {
      "owner": "agent",
      "pre": true,
      "add": [
        "codebase_reviewed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_guidelines_online": {
      "owner": "agent",
      "pre": "codebase_reviewed",
      "add": [
        "guidelines_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_missing_info": {
      "owner": "agent",
      "pre": "codebase_reviewed",
      "add": [
        "gaps_clarified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_report": {
      "owner": "agent",
      "pre": "codebase_reviewed",
      "add": [
        "report_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "review_codebase",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "verify_online": [
            {
              "act": {
                "cap": "verify_guidelines_online",
                "by": "agent"
              }
            }
          ],
          "skip_verify": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "ask_gaps": [
            {
              "act": {
                "cap": "ask_missing_info",
                "by": "agent"
              }
            }
          ],
          "no_gaps": []
        }
      }
    },
    {
      "act": {
        "cap": "write_report",
        "by": "agent"
      }
    }
  ],
  "goal": "report_written",
  "init_true": [],
  "init_constraints": []
}
