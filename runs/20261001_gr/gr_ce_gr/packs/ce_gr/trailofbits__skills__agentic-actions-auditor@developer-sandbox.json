{
  "name": "agentic-actions-auditor",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "discover_workflows_local": {
      "owner": "agent",
      "pre": true,
      "add": [
        "workflows_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_workflows_remote": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_account"
        ]
      },
      "add": [
        "workflows_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_workflows": {
      "owner": "agent",
      "pre": "workflows_found",
      "add": [
        "workflows_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "resolve_cross_file_refs": {
      "owner": "agent",
      "pre": "workflows_read",
      "add": [
        "refs_resolved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "local": [
            {
              "act": {
                "cap": "discover_workflows_local",
                "by": "agent"
              }
            }
          ],
          "remote": [
            {
              "act": {
                "cap": "fetch_workflows_remote",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "read_workflows",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "resolve_cross_file_refs",
        "by": "agent"
      }
    },
    {
      "msg": {
        "from": "agent",
        "to": "user",
        "label": "findings_report"
      }
    }
  ],
  "goal": "refs_resolved",
  "init_true": [],
  "init_constraints": []
}
