{
  "name": "kermt-embed",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_system": {
      "owner": "agent",
      "pre": true,
      "add": [
        "system_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "download_model": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet",
          "system_checked"
        ]
      },
      "add": [
        "model_downloaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_checkpoint": {
      "owner": "agent",
      "pre": "model_downloaded",
      "add": [
        "ckpt_valid"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_data": {
      "owner": "agent",
      "pre": "system_checked",
      "add": [
        "data_valid"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "prepare_data": {
      "owner": "agent",
      "pre": "data_valid",
      "add": [
        "data_prepared"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_system",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "consent": [
            {
              "act": {
                "cap": "download_model",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "validate_checkpoint",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "validate_data",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "prepare_data",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "run_extraction",
                "by": "agent"
              }
            }
          ],
          "decline": []
        }
      }
    }
  ],
  "goal": "embeddings_extracted",
  "init_true": [
    "needs:public_internet"
  ],
  "init_constraints": []
}
