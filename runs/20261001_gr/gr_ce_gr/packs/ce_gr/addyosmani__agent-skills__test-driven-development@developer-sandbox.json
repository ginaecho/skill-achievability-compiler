{
  "name": "test-driven-development",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "discover_stack": {
      "owner": "agent",
      "pre": true,
      "add": [
        "stack_discovered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_failing_test": {
      "owner": "agent",
      "pre": "stack_discovered",
      "add": [
        "test_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_tests_red": {
      "owner": "agent",
      "pre": "test_written",
      "add": [
        "red_confirmed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_code": {
      "owner": "agent",
      "pre": "red_confirmed",
      "add": [
        "code_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_tests_green": {
      "owner": "agent",
      "pre": "code_written",
      "add": [
        "tests_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "refactor": {
      "owner": "agent",
      "pre": "tests_pass",
      "add": [
        "refactored"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_full_suite": {
      "owner": "agent",
      "pre": "tests_pass",
      "add": [
        "suite_passes"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "discover_stack",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_failing_test",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_tests_red",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "implement_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_tests_green",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "refactor_now": [
            {
              "act": {
                "cap": "refactor",
                "by": "agent"
              }
            }
          ],
          "skip_refactor": []
        }
      }
    },
    {
      "act": {
        "cap": "run_full_suite",
        "by": "agent"
      }
    }
  ],
  "goal": "suite_passes",
  "init_true": [],
  "init_constraints": []
}
