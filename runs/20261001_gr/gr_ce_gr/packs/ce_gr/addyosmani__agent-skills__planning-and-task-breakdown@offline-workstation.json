{
  "name": "planning-and-task-breakdown",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_existing_plan": {
      "owner": "agent",
      "pre": true,
      "add": [
        "checked_existing"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_plan": {
      "owner": "agent",
      "pre": "checked_existing",
      "add": [
        "plan_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_todo": {
      "owner": "agent",
      "pre": "checked_existing",
      "add": [
        "todo_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_about_conflict": {
      "owner": "agent",
      "pre": "checked_existing",
      "add": [
        "user_consulted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_existing_plan",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "no_conflict": [
            {
              "act": {
                "cap": "write_plan",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "write_todo",
                "by": "agent"
              }
            }
          ],
          "conflict": [
            {
              "act": {
                "cap": "ask_about_conflict",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "plan_written",
      "todo_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
