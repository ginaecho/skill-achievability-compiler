{
  "name": "receiving-code-review",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_clarification": {
      "owner": "agent",
      "pre": true,
      "add": [
        "clarified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_against_codebase": {
      "owner": "agent",
      "pre": true,
      "add": [
        "verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_fix": {
      "owner": "agent",
      "pre": "verified",
      "add": [
        "fix_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_tests": {
      "owner": "agent",
      "pre": "fix_implemented",
      "add": [
        "tests_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "clear": [
            {
              "act": {
                "cap": "verify_against_codebase",
                "by": "agent"
              }
            }
          ],
          "unclear": [
            {
              "act": {
                "cap": "ask_clarification",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "verify_against_codebase",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "implement_fix",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_tests",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "fix_implemented",
      "tests_pass"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
