{
  "name": "neon-postgres",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "write_env_file": {
      "owner": "agent",
      "pre": "connection_string_obtained",
      "add": [
        "env_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "get_connection_string",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_env_file",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_migration",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "diagnostics": [
            {
              "act": {
                "cap": "run_diagnostics",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "env_written",
      "schema_migrated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
