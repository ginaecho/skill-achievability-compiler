{
  "name": "expo-skill-eval",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "clarify_scope": {
      "owner": "agent",
      "pre": true,
      "add": [
        "scope_confirmed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_orchestrators": {
      "owner": "agent",
      "pre": "scope_confirmed",
      "add": [
        "orchestrators_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "publish_artifact": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:claude_ai_account",
          "viewer_generated"
        ]
      },
      "add": [
        "artifact_published"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "clarify_scope",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_orchestrators",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "trigger_eval": [
            {
              "act": {
                "cap": "run_trigger_eval",
                "by": "agent"
              }
            }
          ],
          "skip_trigger": []
        }
      }
    },
    {
      "act": {
        "cap": "build_fixture",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_executors",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_static_gate",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "runtime_screenshots": [
            {
              "act": {
                "cap": "run_snapshot_ios",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "run_snapshot_android",
                "by": "agent"
              }
            }
          ],
          "skip_runtime": []
        }
      }
    },
    {
      "act": {
        "cap": "grade_results",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_viewer",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "publish": [
            {
              "act": {
                "cap": "publish_artifact",
                "by": "agent"
              }
            }
          ],
          "local_only": []
        }
      }
    }
  ],
  "goal": "viewer_generated",
  "init_true": [],
  "init_constraints": []
}
