{
  "name": "aiq-research",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {},
  "protocol": [
    {
      "act": {
        "cap": "check_health",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "send_chat_query",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "direct_answer": [],
          "deep_research": [
            {
              "act": {
                "cap": "submit_research_job",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "poll_research_job",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "msg": {
        "from": "agent",
        "to": "user",
        "label": "research_report"
      }
    }
  ],
  "goal": {
    "or": [
      "report_ready",
      "chat_sent"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
