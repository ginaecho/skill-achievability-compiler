{
  "name": "build-agent",
  "roles": [
    "agent",
    "owner"
  ],
  "capabilities": {
    "capture_task": {
      "owner": "agent",
      "pre": true,
      "add": [
        "task_captured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_skill_file": {
      "owner": "agent",
      "pre": "task_captured",
      "add": [
        "skill_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "register_skill": {
      "owner": "agent",
      "pre": "skill_written",
      "add": [
        "skill_registered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "offer_schedule": {
      "owner": "agent",
      "pre": "skill_registered",
      "add": [
        "schedule_offered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "offer_share": {
      "owner": "agent",
      "pre": "skill_registered",
      "add": [
        "share_offered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "capture_task",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_skill_file",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "register_skill",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "owner",
        "observed": true,
        "branches": {
          "schedule": [
            {
              "act": {
                "cap": "offer_schedule",
                "by": "agent"
              }
            }
          ],
          "no_schedule": []
        }
      }
    },
    {
      "choice": {
        "by": "owner",
        "observed": true,
        "branches": {
          "share": [
            {
              "act": {
                "cap": "offer_share",
                "by": "agent"
              }
            }
          ],
          "no_share": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "skill_written",
      "skill_registered"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
