{
  "name": "ad-manager",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "request_csv_export": {
      "owner": "agent",
      "pre": true,
      "add": [
        "csv_requested"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_csv_data": {
      "owner": "agent",
      "pre": "csv_requested",
      "add": [
        "data_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "analyze_performance": {
      "owner": "agent",
      "pre": "data_gathered",
      "add": [
        "analysis_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_recommendations": {
      "owner": "agent",
      "pre": "analysis_done",
      "add": [
        "recommendations_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "draft_ad_copy": {
      "owner": "agent",
      "pre": "analysis_done",
      "add": [
        "copy_drafted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_execution_instructions": {
      "owner": "agent",
      "pre": "recommendations_written",
      "add": [
        "change_executed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "request_csv_export",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_csv_data",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "analyze_performance",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_recommendations",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "draft_copy": [
            {
              "act": {
                "cap": "draft_ad_copy",
                "by": "agent"
              }
            }
          ],
          "skip_copy": []
        }
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "execute": [
            {
              "act": {
                "cap": "write_execution_instructions",
                "by": "agent"
              }
            }
          ],
          "no_execute": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "data_gathered",
      "analysis_done",
      "recommendations_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
