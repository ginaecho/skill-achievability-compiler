{
  "name": "neon",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "write_config": {
      "owner": "agent",
      "pre": "project_provisioned",
      "add": [
        "config_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_cli",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_cli",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_credentials",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "has_account": [
            {
              "act": {
                "cap": "neon_init",
                "by": "agent"
              }
            }
          ],
          "no_account": [
            {
              "act": {
                "cap": "claim_project",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "write_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "neon_deploy",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_app_flow",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "neon_provisioned",
      "app_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
