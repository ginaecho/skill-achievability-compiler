{
  "name": "gh-fix-ci",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_gh_auth": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_account"
        ]
      },
      "add": [
        "gh_authenticated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "resolve_pr": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_account",
          "gh_authenticated"
        ]
      },
      "add": [
        "pr_resolved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "inspect_checks": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_account",
          "pr_resolved"
        ]
      },
      "add": [
        "checks_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_fix": {
      "owner": "agent",
      "pre": "checks_inspected",
      "add": [
        "fix_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_gh_auth",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "resolve_pr",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "inspect_checks",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "approve": [
            {
              "act": {
                "cap": "implement_fix",
                "by": "agent"
              }
            }
          ],
          "decline": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "checks_inspected",
      "fix_implemented"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
