{
  "name": "sandbox-migrate-to-next",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "audit_codebase": {
      "owner": "agent",
      "pre": true,
      "add": [
        "codebase_audited"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "update_code": {
      "owner": "agent",
      "pre": "package_upgraded",
      "add": [
        "code_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "audit_codebase",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "upgrade_package",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "update_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_build",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "cutover": [
            {
              "act": {
                "cap": "deploy_cutover",
                "by": "agent"
              }
            }
          ],
          "no_cutover": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "package_upgraded",
      "code_updated",
      "validated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
