{
  "name": "pr-writer",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_branch": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_account"
        ]
      },
      "add": [
        "branch_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_pr_body": {
      "owner": "agent",
      "pre": "branch_inspected",
      "add": [
        "pr_body_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_pr": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_account",
          "pr_body_written"
        ]
      },
      "add": [
        "pr_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "update_pr": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_account",
          "pr_body_written"
        ]
      },
      "add": [
        "pr_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_branch",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_pr_body",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "new_pr": [
            {
              "act": {
                "cap": "create_pr",
                "by": "agent"
              }
            }
          ],
          "existing_pr": [
            {
              "act": {
                "cap": "update_pr",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "or": [
      "pr_created",
      "pr_updated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
