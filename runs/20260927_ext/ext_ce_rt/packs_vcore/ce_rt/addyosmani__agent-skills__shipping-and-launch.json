{
  "name": "shipping-and-launch",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "run_tests": {
      "owner": "agent",
      "pre": true,
      "add": [
        "tests_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_build": {
      "owner": "agent",
      "pre": true,
      "add": [
        "build_succeeds"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_lint": {
      "owner": "agent",
      "pre": true,
      "add": [
        "lint_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_dependency_audit": {
      "owner": "agent",
      "pre": true,
      "add": [
        "audit_clean"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_rollback_plan": {
      "owner": "agent",
      "pre": true,
      "add": [
        "rollback_documented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "setup_monitoring": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:monitoring_service"
        ]
      },
      "add": [
        "monitoring_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_production": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:hosting_account",
          {
            "and": [
              "tests_pass",
              "build_succeeds",
              "lint_pass",
              "audit_clean",
              "rollback_documented",
              "monitoring_configured"
            ]
          }
        ]
      },
      "add": [
        "deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_health": {
      "owner": "agent",
      "pre": "deployed",
      "add": [
        "health_ok"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "run_tests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_build",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_lint",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_dependency_audit",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_rollback_plan",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "setup_monitoring",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "deploy_production",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_health",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "tests_pass",
      "build_succeeds",
      "lint_pass",
      "audit_clean",
      "rollback_documented",
      "monitoring_configured",
      "deployed",
      "health_ok"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
