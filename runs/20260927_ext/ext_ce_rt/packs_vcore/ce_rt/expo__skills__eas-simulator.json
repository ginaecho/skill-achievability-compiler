{
  "name": "eas-simulator",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_availability": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:expo_account"
        ]
      },
      "add": [
        "availability_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "start_session": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:expo_account",
          "availability_checked"
        ]
      },
      "add": [
        "session_started"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_app": {
      "owner": "agent",
      "pre": "session_started",
      "add": [
        "app_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "drive_app": {
      "owner": "agent",
      "pre": "app_installed",
      "add": [
        "app_driven"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "screenshot_app": {
      "owner": "agent",
      "pre": "app_driven",
      "add": [
        "screenshot_taken"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "stop_session": {
      "owner": "agent",
      "pre": "session_started",
      "add": [
        "session_stopped"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_availability",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "available": [
            {
              "act": {
                "cap": "start_session",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "install_app",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "drive_app",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "screenshot_app",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "stop_session",
                "by": "agent"
              }
            }
          ],
          "not_available": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "screenshot_taken",
      "session_stopped"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
