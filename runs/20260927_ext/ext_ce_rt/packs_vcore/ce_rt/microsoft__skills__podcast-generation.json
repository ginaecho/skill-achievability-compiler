{
  "name": "podcast-generation",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "implement_backend": {
      "owner": "agent",
      "pre": true,
      "add": [
        "backend_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_frontend": {
      "owner": "agent",
      "pre": true,
      "add": [
        "frontend_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_env": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_openai_realtime_credentials",
          "backend_implemented"
        ]
      },
      "add": [
        "env_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_audio": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_openai_realtime_credentials",
          "env_configured"
        ]
      },
      "add": [
        "audio_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "convert_pcm_to_wav": {
      "owner": "agent",
      "pre": "audio_generated",
      "add": [
        "wav_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "return_audio_to_frontend": {
      "owner": "agent",
      "pre": {
        "and": [
          "wav_created",
          "frontend_implemented"
        ]
      },
      "add": [
        "audio_returned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "implement_backend",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "implement_frontend",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_env",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_audio",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "convert_pcm_to_wav",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "return_audio_to_frontend",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "backend_implemented",
      "frontend_implemented",
      "audio_generated",
      "wav_created",
      "audio_returned"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
