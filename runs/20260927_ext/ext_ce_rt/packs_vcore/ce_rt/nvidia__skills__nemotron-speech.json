{
  "name": "nemotron-speech",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "pip_install_riva_client": {
      "owner": "agent",
      "pre": true,
      "add": [
        "client_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "call_cloud_nim": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:nvidia_api_key",
          "client_installed"
        ]
      },
      "add": [
        "cloud_asr_tested"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_prereqs": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:nvaie_entitlement"
        ]
      },
      "add": [
        "prereqs_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "docker_login_ngc": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:ngc_api_key",
          "prereqs_ready"
        ]
      },
      "add": [
        "logged_in"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_container": {
      "owner": "agent",
      "pre": "logged_in",
      "add": [
        "container_running"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_health_check": {
      "owner": "agent",
      "pre": "container_running",
      "add": [
        "deployment_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_asr_client": {
      "owner": "agent",
      "pre": "deployment_ready",
      "add": [
        "asr_tested"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "cloud": [
            {
              "act": {
                "cap": "pip_install_riva_client",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "call_cloud_nim",
                "by": "agent"
              }
            }
          ],
          "self_hosted": [
            {
              "act": {
                "cap": "install_prereqs",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "docker_login_ngc",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "deploy_container",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "run_health_check",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "run_asr_client",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "or": [
      "cloud_asr_tested",
      "asr_tested"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
