{
  "name": "make-repo-contribution",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "explore_repo": {
      "owner": "agent",
      "pre": true,
      "add": [
        "guidelines_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_issue": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_write_access",
          "guidelines_found"
        ]
      },
      "add": [
        "issue_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_branch": {
      "owner": "agent",
      "pre": "guidelines_found",
      "add": [
        "branch_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "commit_changes": {
      "owner": "agent",
      "pre": "branch_created",
      "add": [
        "changes_committed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_pr": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_write_access",
          "changes_committed"
        ]
      },
      "add": [
        "pr_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "explore_repo",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "issue_needed": [
            {
              "act": {
                "cap": "create_issue",
                "by": "agent"
              }
            }
          ],
          "no_issue": []
        }
      }
    },
    {
      "act": {
        "cap": "create_branch",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "commit_changes",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_pr",
        "by": "agent"
      }
    }
  ],
  "goal": "pr_created",
  "init_true": [],
  "init_constraints": []
}
