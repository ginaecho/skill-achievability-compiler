{
  "name": "isaac-mission-control-showcase",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "resolve_dependencies": {
      "owner": "agent",
      "pre": true,
      "add": [
        "deps_resolved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "resolve_dependencies",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_preflight",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "start_stack",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_demo_mission",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "deps_resolved",
      "preflight_passed",
      "stack_running",
      "mission_completed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
