{
  "name": "plugin-creator",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_plugin_location": {
      "owner": "agent",
      "pre": true,
      "add": [
        "location_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_scaffold": {
      "owner": "agent",
      "pre": "location_known",
      "add": [
        "plugin_scaffolded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "edit_manifest": {
      "owner": "agent",
      "pre": "plugin_scaffolded",
      "add": [
        "manifest_edited"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "update_marketplace": {
      "owner": "agent",
      "pre": "plugin_scaffolded",
      "add": [
        "marketplace_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "ask_plugin_location",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_scaffold",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "edit_manifest",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "with_marketplace": [
            {
              "act": {
                "cap": "update_marketplace",
                "by": "agent"
              }
            }
          ],
          "skip_marketplace": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "plugin_scaffolded",
      "manifest_edited"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
