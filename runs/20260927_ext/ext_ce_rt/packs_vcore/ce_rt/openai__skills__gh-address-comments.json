{
  "name": "gh-address-comments",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_gh_auth": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_account"
        ]
      },
      "add": [
        "gh_authenticated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_comments": {
      "owner": "agent",
      "pre": "gh_authenticated",
      "add": [
        "comments_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "apply_fix": {
      "owner": "agent",
      "pre": "comments_fetched",
      "add": [
        "fixes_applied"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_gh_auth",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_comments",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "address_comments": [
            {
              "act": {
                "cap": "apply_fix",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": "fixes_applied",
  "init_true": [],
  "init_constraints": []
}
