{
  "name": "audit-augmentation",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "install_trailmark": {
      "owner": "agent",
      "pre": true,
      "add": [
        "trailmark_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_graph": {
      "owner": "agent",
      "pre": "trailmark_installed",
      "add": [
        "graph_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_preanalysis": {
      "owner": "agent",
      "pre": "graph_built",
      "add": [
        "preanalysis_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "augment_sarif": {
      "owner": "agent",
      "pre": "preanalysis_done",
      "add": [
        "sarif_augmented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "augment_weaudit": {
      "owner": "agent",
      "pre": "preanalysis_done",
      "add": [
        "weaudit_augmented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "query_findings": {
      "owner": "agent",
      "pre": {
        "or": [
          "sarif_augmented",
          "weaudit_augmented"
        ]
      },
      "add": [
        "findings_queried"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_trailmark",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_graph",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_preanalysis",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "augment_sarif",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "also_weaudit": [
            {
              "act": {
                "cap": "augment_weaudit",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    },
    {
      "act": {
        "cap": "query_findings",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "sarif_augmented",
      "findings_queried"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
