{
  "name": "eas-app-stores",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "install_eas_cli": {
      "owner": "agent",
      "pre": true,
      "add": [
        "eas_cli_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "eas_login": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:expo_account",
          "eas_cli_installed"
        ]
      },
      "add": [
        "eas_logged_in"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "eas_init": {
      "owner": "agent",
      "pre": "eas_logged_in",
      "add": [
        "eas_initialized"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_app": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:eas_paid_plan",
          "eas_initialized"
        ]
      },
      "add": [
        "app_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "submit_app": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:app_store_credentials",
          "app_built"
        ]
      },
      "add": [
        "app_submitted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_eas_cli",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "eas_login",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "eas_init",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_app",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "submit_app",
        "by": "agent"
      }
    }
  ],
  "goal": "app_submitted",
  "init_true": [],
  "init_constraints": []
}
