{
  "name": "iterate-pr",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "fetch_pr": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_write_access"
        ]
      },
      "add": [
        "pr_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_checks": {
      "owner": "agent",
      "pre": "pr_fetched",
      "add": [
        "checks_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_feedback": {
      "owner": "agent",
      "pre": "pr_fetched",
      "add": [
        "feedback_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fix_issues": {
      "owner": "agent",
      "pre": {
        "and": [
          "checks_fetched",
          "feedback_fetched"
        ]
      },
      "add": [
        "fixes_applied"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_locally": {
      "owner": "agent",
      "pre": "fixes_applied",
      "add": [
        "verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "commit_and_push": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_write_access",
          "verified"
        ]
      },
      "add": [
        "ci_passed",
        "feedback_addressed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "fetch_pr",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "iterate",
        "body": [
          {
            "act": {
              "cap": "fetch_checks",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "fetch_feedback",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "fix_issues",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "verify_locally",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "commit_and_push",
              "by": "agent"
            }
          },
          {
            "continue": "iterate"
          }
        ]
      }
    }
  ],
  "goal": {
    "and": [
      "ci_passed",
      "feedback_addressed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
