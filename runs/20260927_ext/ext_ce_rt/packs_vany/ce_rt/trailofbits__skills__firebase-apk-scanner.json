{
  "name": "firebase-apk-scanner",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "validate_input": {
      "owner": "agent",
      "pre": true,
      "add": [
        "input_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_scanner": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:authorization_to_test",
          "input_validated"
        ]
      },
      "add": [
        "scan_completed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_report": {
      "owner": "agent",
      "pre": "scan_completed",
      "add": [
        "report_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "validate_input",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_scanner",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_report",
        "by": "agent"
      }
    }
  ],
  "goal": "report_read",
  "init_true": [],
  "init_constraints": []
}
