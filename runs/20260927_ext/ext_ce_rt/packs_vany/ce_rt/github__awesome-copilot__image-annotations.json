{
  "name": "image-annotations",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "install_pillow": {
      "owner": "agent",
      "pre": true,
      "add": [
        "pillow_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_annotate_script": {
      "owner": "agent",
      "pre": true,
      "add": [
        "script_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_annotation": {
      "owner": "agent",
      "pre": {
        "and": [
          "pillow_installed",
          "script_written"
        ]
      },
      "add": [
        "image_annotated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "save_image": {
      "owner": "agent",
      "pre": "image_annotated",
      "add": [
        "image_saved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_pillow",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_annotate_script",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_annotation",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "save_image",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "image_annotated",
      "image_saved"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
