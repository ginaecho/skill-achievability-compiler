{
  "name": "resemble-detect",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "submit_detection": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:resemble_api_key"
        ]
      },
      "add": [
        "detection_submitted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "poll_detection": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:resemble_api_key",
          "detection_submitted"
        ]
      },
      "add": [
        "detection_completed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "submit_detection",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "poll_loop",
        "body": [
          {
            "act": {
              "cap": "poll_detection",
              "by": "agent"
            }
          },
          {
            "continue": "poll_loop"
          }
        ]
      }
    }
  ],
  "goal": "detection_completed",
  "init_true": [],
  "init_constraints": []
}
