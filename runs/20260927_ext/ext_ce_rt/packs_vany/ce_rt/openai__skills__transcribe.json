{
  "name": "transcribe",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_api_key": {
      "owner": "agent",
      "pre": true,
      "add": [
        "key_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_user_set_key": {
      "owner": "agent",
      "pre": true,
      "add": [
        "key_set"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_deps": {
      "owner": "agent",
      "pre": true,
      "add": [
        "deps_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_transcribe": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:openai_api_key",
          {
            "and": [
              "deps_installed",
              "key_checked"
            ]
          }
        ]
      },
      "add": [
        "transcript_produced"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "save_output": {
      "owner": "agent",
      "pre": "transcript_produced",
      "add": [
        "output_saved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_api_key",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "key_missing": [
            {
              "act": {
                "cap": "ask_user_set_key",
                "by": "agent"
              }
            }
          ],
          "key_present": []
        }
      }
    },
    {
      "act": {
        "cap": "install_deps",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_transcribe",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "save_output",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "transcript_produced",
      "output_saved"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
