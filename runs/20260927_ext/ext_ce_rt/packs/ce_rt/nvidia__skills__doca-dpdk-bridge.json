{
  "name": "doca-dpdk-bridge",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_pkgconfig": {
      "owner": "agent",
      "pre": true,
      "add": [
        "bridge_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "bind_port_to_doca_dev": {
      "owner": "agent",
      "pre": "bridge_verified",
      "add": [
        "port_bound"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "convert_mbuf_docabuf": {
      "owner": "agent",
      "pre": "port_bound",
      "add": [
        "buffers_converted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_app": {
      "owner": "agent",
      "pre": "buffers_converted",
      "add": [
        "app_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_app": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:dpu_hardware",
          "app_built"
        ]
      },
      "add": [
        "app_running"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_pkgconfig",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "bind_port_to_doca_dev",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "convert_mbuf_docabuf",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_app",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_app",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "port_bound",
      "buffers_converted",
      "app_built",
      "app_running"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
