{
  "name": "openai-docs",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "search_docs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "docs_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_doc": {
      "owner": "agent",
      "pre": "docs_found",
      "add": [
        "doc_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_mcp": {
      "owner": "agent",
      "pre": true,
      "add": [
        "mcp_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "web_search_fallback": {
      "owner": "agent",
      "pre": true,
      "add": [
        "doc_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "mcp_available": [
            {
              "act": {
                "cap": "search_docs",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "fetch_doc",
                "by": "agent"
              }
            }
          ],
          "mcp_missing": [
            {
              "act": {
                "cap": "install_mcp",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "search_docs",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "fetch_doc",
                "by": "agent"
              }
            }
          ],
          "mcp_unhelpful": [
            {
              "act": {
                "cap": "web_search_fallback",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": "doc_fetched",
  "init_true": [],
  "init_constraints": []
}
