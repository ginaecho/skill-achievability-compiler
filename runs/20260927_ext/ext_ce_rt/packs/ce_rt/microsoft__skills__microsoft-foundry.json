{
  "name": "microsoft-foundry",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "run_dependency_check": {
      "owner": "agent",
      "pre": true,
      "add": [
        "dependencies_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scaffold_agent": {
      "owner": "agent",
      "pre": "dependencies_checked",
      "add": [
        "agent_scaffolded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "azd_provision": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "agent_scaffolded"
        ]
      },
      "add": [
        "infra_provisioned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "azd_deploy": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "infra_provisioned"
        ]
      },
      "add": [
        "agent_deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "invoke_agent": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "agent_deployed"
        ]
      },
      "add": [
        "agent_invoked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "smoke_test": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "agent_invoked"
        ]
      },
      "add": [
        "smoke_test_passed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "run_dependency_check",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scaffold_agent",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "azd_provision",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "azd_deploy",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "invoke_agent",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "smoke_test",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "dependencies_checked",
      "agent_scaffolded",
      "infra_provisioned",
      "agent_deployed",
      "agent_invoked",
      "smoke_test_passed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
