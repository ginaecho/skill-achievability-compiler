{
  "name": "nvidia-skill-finder",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_catalog_cli": {
      "owner": "agent",
      "pre": true,
      "add": [
        "catalog_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_skill": {
      "owner": "agent",
      "pre": "catalog_checked",
      "add": [
        "skill_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_catalog_cli",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "approve_install": [
            {
              "act": {
                "cap": "install_skill",
                "by": "agent"
              }
            }
          ],
          "decline": []
        }
      }
    }
  ],
  "goal": "catalog_checked",
  "init_true": [],
  "init_constraints": []
}
