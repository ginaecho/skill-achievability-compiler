{
  "name": "cargo-fuzz",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "install_nightly_toolchain": {
      "owner": "agent",
      "pre": true,
      "add": [
        "nightly_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_cargo_fuzz": {
      "owner": "agent",
      "pre": true,
      "add": [
        "cargo_fuzz_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "init_fuzz_project": {
      "owner": "agent",
      "pre": "cargo_fuzz_installed",
      "add": [
        "fuzz_initialized"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_harness": {
      "owner": "agent",
      "pre": "fuzz_initialized",
      "add": [
        "harness_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_fuzz_campaign": {
      "owner": "agent",
      "pre": {
        "and": [
          "nightly_installed",
          "harness_written"
        ]
      },
      "add": [
        "fuzzing_run"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_coverage_report": {
      "owner": "agent",
      "pre": "fuzzing_run",
      "add": [
        "coverage_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_nightly_toolchain",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_cargo_fuzz",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "init_fuzz_project",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_harness",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_fuzz_campaign",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "generate_coverage": [
            {
              "act": {
                "cap": "generate_coverage_report",
                "by": "agent"
              }
            }
          ],
          "skip_coverage": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "nightly_installed",
      "cargo_fuzz_installed",
      "fuzz_initialized",
      "harness_written",
      "fuzzing_run"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
