{
  "name": "medtech-model-evidence-export",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "dry_run_export": {
      "owner": "agent",
      "pre": true,
      "add": [
        "dry_run_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_mlflow": {
      "owner": "agent",
      "pre": "dry_run_done",
      "add": [
        "mlflow_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_local_export": {
      "owner": "agent",
      "pre": "mlflow_installed",
      "add": [
        "export_completed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "dry_run_export",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_mlflow",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_local_export",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "dry_run_done",
      "export_completed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
