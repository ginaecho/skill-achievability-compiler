{
  "name": "doubt-driven-development",
  "roles": [
    "agent",
    "reviewer"
  ],
  "capabilities": {
    "ask_cross_model_choice": {
      "owner": "agent",
      "pre": "findings_produced",
      "add": [
        "cross_model_asked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_external_cli": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:ai_cli_credentials",
          "cross_model_asked"
        ]
      },
      "add": [
        "cross_model_review_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "spawn": {
        "role": "reviewer"
      }
    },
    {
      "act": {
        "cap": "adversarial_review",
        "by": "reviewer"
      }
    },
    {
      "act": {
        "cap": "ask_cross_model_choice",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "run_cli": [
            {
              "act": {
                "cap": "run_external_cli",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": "findings_produced",
  "init_true": [],
  "init_constraints": []
}
