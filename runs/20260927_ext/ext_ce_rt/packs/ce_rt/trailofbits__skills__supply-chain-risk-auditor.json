{
  "name": "supply-chain-risk-auditor",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_manifests": {
      "owner": "agent",
      "pre": true,
      "add": [
        "manifests_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_gh_auth": {
      "owner": "agent",
      "pre": "manifests_checked",
      "add": [
        "gh_auth_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "collect_findings": {
      "owner": "agent",
      "pre": "gh_auth_checked",
      "add": [
        "findings_collected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "render_report": {
      "owner": "agent",
      "pre": "findings_collected",
      "add": [
        "report_rendered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_report": {
      "owner": "agent",
      "pre": "report_rendered",
      "add": [
        "report_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_manifests",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "manifests_found": [
            {
              "act": {
                "cap": "check_gh_auth",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "collect_findings",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "render_report",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "read_report",
                "by": "agent"
              }
            }
          ],
          "no_manifests": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "findings_collected",
      "report_rendered",
      "report_read"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
