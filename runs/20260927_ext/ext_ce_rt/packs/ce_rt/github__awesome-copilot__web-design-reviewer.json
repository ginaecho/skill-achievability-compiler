{
  "name": "web-design-reviewer",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_url": {
      "owner": "agent",
      "pre": true,
      "add": [
        "url_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "detect_project": {
      "owner": "agent",
      "pre": "url_known",
      "add": [
        "project_detected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "inspect_page": {
      "owner": "agent",
      "pre": "url_known",
      "add": [
        "issues_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "search_source": {
      "owner": "agent",
      "pre": "issues_found",
      "add": [
        "source_located"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "apply_fix": {
      "owner": "agent",
      "pre": "source_located",
      "add": [
        "issues_fixed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "reverify": {
      "owner": "agent",
      "pre": "issues_fixed",
      "add": [
        "verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_report": {
      "owner": "agent",
      "pre": "verified",
      "add": [
        "report_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "url_provided": [],
          "url_missing": [
            {
              "act": {
                "cap": "ask_url",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "detect_project",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "inspect_page",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "search_source",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "fix_loop",
        "body": [
          {
            "act": {
              "cap": "apply_fix",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "reverify",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "user",
              "observed": true,
              "branches": {
                "issues_remain": [
                  {
                    "continue": "fix_loop"
                  }
                ],
                "resolved": []
              }
            }
          }
        ]
      }
    },
    {
      "act": {
        "cap": "write_report",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "issues_fixed",
      "verified",
      "report_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
