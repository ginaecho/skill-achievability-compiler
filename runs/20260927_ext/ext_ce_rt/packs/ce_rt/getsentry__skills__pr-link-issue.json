{
  "name": "pr-link-issue",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "resolve_pr": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_access"
        ]
      },
      "add": [
        "pr_resolved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_linear_key": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_access",
          "pr_resolved"
        ]
      },
      "add": [
        "linear_key_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_pr_body": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_access",
          "pr_resolved"
        ]
      },
      "add": [
        "pr_body_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "update_pr_body": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_access",
          {
            "and": [
              "pr_body_read",
              "linear_key_fetched"
            ]
          }
        ]
      },
      "add": [
        "pr_body_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "confirm_pr_url": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_access",
          "pr_body_updated"
        ]
      },
      "add": [
        "pr_confirmed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "resolve_pr",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_linear_key",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_pr_body",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "update_pr_body",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "confirm_pr_url",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "pr_body_updated",
      "pr_confirmed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
