{
  "name": "hf-cloud-aws-context-discovery",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "discover_profile": {
      "owner": "agent",
      "pre": true,
      "add": [
        "profile_resolved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "discover_region": {
      "owner": "agent",
      "pre": "profile_resolved",
      "add": [
        "region_resolved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_region": {
      "owner": "agent",
      "pre": "profile_resolved",
      "add": [
        "region_resolved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "get_caller_identity": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:aws_credentials",
          "region_resolved"
        ]
      },
      "add": [
        "identity_confirmed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "discover_profile",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "region_found": [
            {
              "act": {
                "cap": "discover_region",
                "by": "agent"
              }
            }
          ],
          "region_missing": [
            {
              "act": {
                "cap": "ask_region",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "get_caller_identity",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "profile_resolved",
      "region_resolved",
      "identity_confirmed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
