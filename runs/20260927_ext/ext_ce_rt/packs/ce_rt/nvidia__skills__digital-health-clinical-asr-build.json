{
  "name": "digital-health-clinical-asr-build",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "interview_user": {
      "owner": "agent",
      "pre": true,
      "add": [
        "terms_confirmed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_term_seed": {
      "owner": "agent",
      "pre": "terms_confirmed",
      "add": [
        "term_seed_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_sentences": {
      "owner": "agent",
      "pre": "term_seed_written",
      "add": [
        "sentences_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "lookup_mw": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:dictionary_api_key",
          "sentences_generated"
        ]
      },
      "add": [
        "ipa_tagged"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "synthesize_qa_audio": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:nvidia_api_key",
          "sentences_generated"
        ]
      },
      "add": [
        "qa_audio_synthesized"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "audition_gate": {
      "owner": "agent",
      "pre": "qa_audio_synthesized",
      "add": [
        "audition_confirmed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "synthesize_full": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:nvidia_api_key",
          "audition_confirmed"
        ]
      },
      "add": [
        "manifest_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "interview_user",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_term_seed",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_sentences",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "mw_lookup": [
            {
              "act": {
                "cap": "lookup_mw",
                "by": "agent"
              }
            }
          ],
          "skip_mw": []
        }
      }
    },
    {
      "act": {
        "cap": "synthesize_qa_audio",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "user_auditions": [
            {
              "act": {
                "cap": "audition_gate",
                "by": "agent"
              }
            }
          ],
          "skip_audition": []
        }
      }
    },
    {
      "act": {
        "cap": "synthesize_full",
        "by": "agent"
      }
    }
  ],
  "goal": "manifest_written",
  "init_true": [],
  "init_constraints": []
}
