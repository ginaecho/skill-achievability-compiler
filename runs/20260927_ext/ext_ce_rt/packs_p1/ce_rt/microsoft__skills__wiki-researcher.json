{
  "name": "wiki-researcher",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_git_remote": {
      "owner": "agent",
      "pre": true,
      "add": [
        "remote_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_repo_context": {
      "owner": "agent",
      "pre": "remote_checked",
      "add": [
        "repo_context_resolved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_default_branch": {
      "owner": "agent",
      "pre": "repo_context_resolved",
      "add": [
        "branch_determined"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_code": {
      "owner": "agent",
      "pre": "branch_determined",
      "add": [
        "code_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_git_remote",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "ask_repo_context",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_default_branch",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "research_iterations",
        "body": [
          {
            "act": {
              "cap": "read_code",
              "by": "agent"
            }
          },
          {
            "continue": "research_iterations"
          }
        ]
      }
    }
  ],
  "goal": {
    "and": [
      "repo_context_resolved",
      "branch_determined",
      "code_read"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
