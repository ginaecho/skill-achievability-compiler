{
  "name": "burpsuite-project-parser",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "run_search": {
      "owner": "agent",
      "pre": "extension_installed",
      "add": [
        "search_run"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_control_query": {
      "owner": "agent",
      "pre": {
        "and": [
          "extension_installed",
          "search_run"
        ]
      },
      "add": [
        "control_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_burp_pro",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_parser_extension",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_search",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_control_query",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "search_run",
      "control_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
