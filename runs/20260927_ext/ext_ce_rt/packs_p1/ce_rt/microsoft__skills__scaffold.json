{
  "name": "azure-app-onboard-scaffold",
  "roles": [
    "agent",
    "iac_gen_agent",
    "review_agent",
    "validate_agent"
  ],
  "capabilities": {
    "read_inputs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "inputs_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_existing_infra": {
      "owner": "agent",
      "pre": "inputs_read",
      "add": [
        "infra_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_infra_decision": {
      "owner": "agent",
      "pre": "infra_checked",
      "add": [
        "infra_decision_made"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "precheck_api_versions": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "infra_decision_made"
        ]
      },
      "add": [
        "api_versions_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_iac": {
      "owner": "iac_gen_agent",
      "pre": "api_versions_known",
      "add": [
        "iac_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "self_review_iac": {
      "owner": "review_agent",
      "pre": "iac_generated",
      "add": [
        "self_review_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "format_iac": {
      "owner": "agent",
      "pre": "self_review_done",
      "add": [
        "iac_formatted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_conformance_check": {
      "owner": "agent",
      "pre": "iac_formatted",
      "add": [
        "conformance_passed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_iac": {
      "owner": "validate_agent",
      "pre": "conformance_passed",
      "add": [
        "iac_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_manifest": {
      "owner": "agent",
      "pre": "iac_validated",
      "add": [
        "manifest_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "update_context_phase": {
      "owner": "agent",
      "pre": "manifest_written",
      "add": [
        "phase_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_inputs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_existing_infra",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "ask_infra_decision",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "start_fresh": [
            {
              "act": {
                "cap": "precheck_api_versions",
                "by": "agent"
              }
            },
            {
              "spawn": {
                "role": "iac_gen_agent"
              }
            },
            {
              "act": {
                "cap": "generate_iac",
                "by": "iac_gen_agent"
              }
            },
            {
              "spawn": {
                "role": "review_agent"
              }
            },
            {
              "act": {
                "cap": "self_review_iac",
                "by": "review_agent"
              }
            },
            {
              "act": {
                "cap": "format_iac",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "run_conformance_check",
                "by": "agent"
              }
            },
            {
              "spawn": {
                "role": "validate_agent"
              }
            },
            {
              "act": {
                "cap": "validate_iac",
                "by": "validate_agent"
              }
            },
            {
              "act": {
                "cap": "write_manifest",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "update_context_phase",
                "by": "agent"
              }
            }
          ],
          "use_existing": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "iac_generated",
      "self_review_done",
      "conformance_passed",
      "iac_validated",
      "manifest_written",
      "phase_updated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
