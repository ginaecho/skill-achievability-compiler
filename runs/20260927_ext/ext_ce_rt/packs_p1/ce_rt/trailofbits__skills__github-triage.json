{
  "name": "github-triage",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_auth": {
      "owner": "agent",
      "pre": true,
      "add": [
        "auth_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "select_repo": {
      "owner": "agent",
      "pre": "auth_checked",
      "add": [
        "repo_selected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "gather_data": {
      "owner": "agent",
      "pre": "repo_selected",
      "add": [
        "data_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "triage_prs": {
      "owner": "agent",
      "pre": "data_gathered",
      "add": [
        "prs_triaged"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "merge_pr": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_write_access",
          "prs_triaged"
        ]
      },
      "add": [
        "prs_merged"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "review_pr": {
      "owner": "agent",
      "pre": "prs_triaged",
      "add": [
        "prs_reviewed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "classify_issues": {
      "owner": "agent",
      "pre": "data_gathered",
      "add": [
        "issues_classified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "score_issues": {
      "owner": "agent",
      "pre": "issues_classified",
      "add": [
        "issues_scored"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "present_triage": {
      "owner": "agent",
      "pre": "issues_scored",
      "add": [
        "triage_presented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "execute_writes": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_write_access",
          "triage_presented"
        ]
      },
      "add": [
        "writes_executed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deliver_report": {
      "owner": "agent",
      "pre": "issues_scored",
      "add": [
        "report_delivered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_auth",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "select_repo",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "gather_data",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "handle_prs": [
            {
              "act": {
                "cap": "triage_prs",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "agent",
                "observed": true,
                "branches": {
                  "merge": [
                    {
                      "act": {
                        "cap": "merge_pr",
                        "by": "agent"
                      }
                    }
                  ],
                  "review": [
                    {
                      "act": {
                        "cap": "review_pr",
                        "by": "agent"
                      }
                    }
                  ],
                  "none": []
                }
              }
            }
          ],
          "skip_prs": []
        }
      }
    },
    {
      "act": {
        "cap": "classify_issues",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "score_issues",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "present_triage",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "approve": [
            {
              "act": {
                "cap": "execute_writes",
                "by": "agent"
              }
            }
          ],
          "skip_writes": []
        }
      }
    },
    {
      "act": {
        "cap": "deliver_report",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "issues_scored",
      "report_delivered"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
