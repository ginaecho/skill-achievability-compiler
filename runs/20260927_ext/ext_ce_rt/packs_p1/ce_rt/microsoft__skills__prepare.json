{
  "name": "prepare",
  "roles": [
    "agent",
    "orchestrator"
  ],
  "capabilities": {
    "read_session_state": {
      "owner": "agent",
      "pre": true,
      "add": [
        "session_loaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "query_policy": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "session_loaded"
        ]
      },
      "add": [
        "policy_queried"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_quota": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "session_loaded"
        ]
      },
      "add": [
        "quota_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "estimate_costs": {
      "owner": "agent",
      "pre": "session_loaded",
      "add": [
        "costs_estimated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "determine_iac_format": {
      "owner": "agent",
      "pre": "session_loaded",
      "add": [
        "iac_format_determined"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_plan": {
      "owner": "agent",
      "pre": {
        "and": [
          "policy_queried",
          "quota_validated",
          "costs_estimated",
          "iac_format_determined"
        ]
      },
      "add": [
        "plan_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_plan": {
      "owner": "agent",
      "pre": "plan_written",
      "add": [
        "plan_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_session_state",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "query_policy",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_quota",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "estimate_costs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "determine_iac_format",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_plan",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_plan",
        "by": "agent"
      }
    },
    {
      "msg": {
        "from": "agent",
        "to": "orchestrator",
        "label": "plan_ready"
      }
    }
  ],
  "goal": {
    "and": [
      "plan_written",
      "plan_validated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
