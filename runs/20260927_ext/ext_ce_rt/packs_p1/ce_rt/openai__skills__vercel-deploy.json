{
  "name": "vercel-deploy",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_vercel_cli": {
      "owner": "agent",
      "pre": true,
      "add": [
        "cli_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_via_cli": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:vercel_account",
          "cli_checked"
        ]
      },
      "add": [
        "deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_via_script": {
      "owner": "agent",
      "pre": "cli_checked",
      "add": [
        "deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_prod": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:vercel_account",
          "deployed"
        ]
      },
      "add": [
        "deployed_prod"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_vercel_cli",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "cli_available": [
            {
              "act": {
                "cap": "deploy_via_cli",
                "by": "agent"
              }
            }
          ],
          "cli_unavailable": [
            {
              "act": {
                "cap": "deploy_via_script",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "production": [
            {
              "act": {
                "cap": "deploy_prod",
                "by": "agent"
              }
            }
          ],
          "preview": []
        }
      }
    }
  ],
  "goal": "deployed",
  "init_true": [],
  "init_constraints": []
}
