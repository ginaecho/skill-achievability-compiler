{
  "name": "automate-this",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_prereqs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "prereqs_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "extract_frames": {
      "owner": "agent",
      "pre": "prereqs_checked",
      "add": [
        "frames_extracted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "extract_audio": {
      "owner": "agent",
      "pre": "frames_extracted",
      "add": [
        "audio_extracted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "transcribe_audio": {
      "owner": "agent",
      "pre": "audio_extracted",
      "add": [
        "transcript_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fingerprint_env": {
      "owner": "agent",
      "pre": "frames_extracted",
      "add": [
        "env_fingerprinted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_automation": {
      "owner": "agent",
      "pre": "env_fingerprinted",
      "add": [
        "automation_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "test_automation": {
      "owner": "agent",
      "pre": "automation_written",
      "add": [
        "automation_tested"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "cleanup": {
      "owner": "agent",
      "pre": true,
      "add": [
        "cleaned_up"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_prereqs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "extract_frames",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "has_audio": [
            {
              "act": {
                "cap": "extract_audio",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "transcribe_audio",
                "by": "agent"
              }
            }
          ],
          "no_audio": []
        }
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "reconstruction_confirmed": []
        }
      }
    },
    {
      "act": {
        "cap": "fingerprint_env",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "tier_1": [],
          "tier_2": [],
          "tier_3": []
        }
      }
    },
    {
      "act": {
        "cap": "write_automation",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "test_automation",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "cleanup",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "automation_tested",
      "cleaned_up"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
