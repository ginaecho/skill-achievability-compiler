{
  "name": "playwright",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_npx": {
      "owner": "agent",
      "pre": true,
      "add": [
        "npx_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_install_node": {
      "owner": "agent",
      "pre": true,
      "add": [
        "node_install_requested"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "open_page": {
      "owner": "agent",
      "pre": "npx_checked",
      "add": [
        "page_open"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "snapshot_page": {
      "owner": "agent",
      "pre": "page_open",
      "add": [
        "snapshot_taken"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "interact_page": {
      "owner": "agent",
      "pre": "snapshot_taken",
      "add": [
        "interacted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "capture_screenshot": {
      "owner": "agent",
      "pre": "page_open",
      "add": [
        "screenshot_captured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_npx",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "npx_missing": [
            {
              "act": {
                "cap": "ask_install_node",
                "by": "agent"
              }
            }
          ],
          "npx_available": [
            {
              "act": {
                "cap": "open_page",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "snapshot_page",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "interact_page",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "capture_screenshot",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "page_open",
      "snapshot_taken",
      "interacted",
      "screenshot_captured"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
