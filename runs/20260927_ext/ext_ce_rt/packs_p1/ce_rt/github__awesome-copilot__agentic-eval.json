{
  "name": "agentic-eval",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "generate_code": {
      "owner": "agent",
      "pre": true,
      "add": [
        "code_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_tests": {
      "owner": "agent",
      "pre": "code_generated",
      "add": [
        "tests_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fix_code": {
      "owner": "agent",
      "pre": "code_generated",
      "add": [
        "code_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "generate_code",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "refine",
        "body": [
          {
            "act": {
              "cap": "run_tests",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "needs_fix": [
                  {
                    "act": {
                      "cap": "fix_code",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "refine"
                  }
                ],
                "done": []
              }
            }
          }
        ]
      }
    }
  ],
  "goal": "tests_pass",
  "init_true": [],
  "init_constraints": []
}
