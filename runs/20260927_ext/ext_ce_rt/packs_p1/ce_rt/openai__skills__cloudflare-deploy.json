{
  "name": "cloudflare-deploy",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_auth": {
      "owner": "agent",
      "pre": true,
      "add": [
        "auth_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "login": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:cloudflare_account",
          "auth_checked"
        ]
      },
      "add": [
        "authenticated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:cloudflare_account",
          "authenticated"
        ]
      },
      "add": [
        "deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_auth",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "already_authenticated": [],
          "not_authenticated": [
            {
              "act": {
                "cap": "login",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "deploy",
        "by": "agent"
      }
    }
  ],
  "goal": "deployed",
  "init_true": [],
  "init_constraints": []
}
