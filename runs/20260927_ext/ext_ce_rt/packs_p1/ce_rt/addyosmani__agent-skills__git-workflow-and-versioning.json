{
  "name": "git-workflow-and-versioning",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "edit_code": {
      "owner": "agent",
      "pre": true,
      "add": [
        "code_changed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_tests": {
      "owner": "agent",
      "pre": "code_changed",
      "add": [
        "tests_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_lint": {
      "owner": "agent",
      "pre": "code_changed",
      "add": [
        "lint_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_typecheck": {
      "owner": "agent",
      "pre": "code_changed",
      "add": [
        "typecheck_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_no_secrets": {
      "owner": "agent",
      "pre": "code_changed",
      "add": [
        "no_secrets"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "git_commit": {
      "owner": "agent",
      "pre": {
        "and": [
          "tests_pass",
          "lint_pass",
          "typecheck_pass",
          "no_secrets"
        ]
      },
      "add": [
        "committed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "tag_release": {
      "owner": "agent",
      "pre": "committed",
      "add": [
        "tagged"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "update_changelog": {
      "owner": "agent",
      "pre": "committed",
      "add": [
        "changelog_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "edit_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_tests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_lint",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_typecheck",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_no_secrets",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "git_commit",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "cut_release": [
            {
              "act": {
                "cap": "tag_release",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "update_changelog",
                "by": "agent"
              }
            }
          ],
          "no_release": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "code_changed",
      "tests_pass",
      "lint_pass",
      "typecheck_pass",
      "no_secrets",
      "committed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
