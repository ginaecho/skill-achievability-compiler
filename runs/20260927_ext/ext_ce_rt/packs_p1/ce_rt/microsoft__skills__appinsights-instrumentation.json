{
  "name": "appinsights-instrumentation",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_app_code": {
      "owner": "agent",
      "pre": true,
      "add": [
        "context_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_hosting": {
      "owner": "agent",
      "pre": "context_gathered",
      "add": [
        "hosting_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_resource_bicep": {
      "owner": "agent",
      "pre": "hosting_known",
      "add": [
        "resource_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_resource_cli": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "hosting_known"
        ]
      },
      "add": [
        "resource_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "modify_app_code": {
      "owner": "agent",
      "pre": "resource_created",
      "add": [
        "code_instrumented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_app_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "ask_hosting",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "bicep": [
            {
              "act": {
                "cap": "create_resource_bicep",
                "by": "agent"
              }
            }
          ],
          "cli": [
            {
              "act": {
                "cap": "create_resource_cli",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "modify_app_code",
        "by": "agent"
      }
    }
  ],
  "goal": "code_instrumented",
  "init_true": [],
  "init_constraints": []
}
