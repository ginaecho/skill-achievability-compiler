{
  "name": "ci-cd-and-automation",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "write_ci_config": {
      "owner": "agent",
      "pre": true,
      "add": [
        "ci_config_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_local_verification": {
      "owner": "agent",
      "pre": "ci_config_written",
      "add": [
        "verified_locally"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_branch_protection": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_admin_access",
          "ci_config_written"
        ]
      },
      "add": [
        "branch_protection_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_ci_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_local_verification",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "configure_protection": [
            {
              "act": {
                "cap": "configure_branch_protection",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "ci_config_written",
      "verified_locally"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
