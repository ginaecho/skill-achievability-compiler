{
  "name": "jupyter-notebook",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "scaffold_notebook": {
      "owner": "agent",
      "pre": true,
      "add": [
        "notebook_scaffolded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "edit_notebook": {
      "owner": "agent",
      "pre": "notebook_scaffolded",
      "add": [
        "notebook_filled"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_notebook": {
      "owner": "agent",
      "pre": "notebook_filled",
      "add": [
        "notebook_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "scaffold_notebook",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "edit_notebook",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "validate": [
            {
              "act": {
                "cap": "run_notebook",
                "by": "agent"
              }
            }
          ],
          "skip_validate": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "notebook_scaffolded",
      "notebook_filled"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
