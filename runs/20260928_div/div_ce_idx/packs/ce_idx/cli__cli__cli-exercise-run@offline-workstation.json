{
  "name": "cli-exercise-run",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "verify_checksum": {
      "owner": "agent",
      "pre": {
        "and": [
          "preflight_ready",
          "contract_approved"
        ]
      },
      "add": [
        "checksum_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "verify_checksum",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "start_run",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "observe_terminal",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "record_evidence",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "finish_run",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "run_finished",
      "evidence_recorded"
    ]
  },
  "init_true": [
    "preflight_ready",
    "contract_approved"
  ],
  "init_constraints": []
}
