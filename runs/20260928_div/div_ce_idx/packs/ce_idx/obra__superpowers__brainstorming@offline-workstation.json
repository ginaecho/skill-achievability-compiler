{
  "name": "brainstorming",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_clarifying_questions": {
      "owner": "agent",
      "pre": true,
      "add": [
        "requirements_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "present_design": {
      "owner": "agent",
      "pre": "requirements_gathered",
      "add": [
        "design_presented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_design_doc": {
      "owner": "agent",
      "pre": "design_presented",
      "add": [
        "design_doc_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "commit_design_doc": {
      "owner": "agent",
      "pre": "design_doc_written",
      "add": [
        "design_doc_committed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "get_spec_review": {
      "owner": "agent",
      "pre": "design_doc_committed",
      "add": [
        "spec_approved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "ask_clarifying_questions",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "present_design",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "approve": [
            {
              "act": {
                "cap": "write_design_doc",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "commit_design_doc",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "get_spec_review",
                "by": "agent"
              }
            }
          ],
          "revise": []
        }
      }
    }
  ],
  "goal": "spec_approved",
  "init_true": [],
  "init_constraints": []
}
