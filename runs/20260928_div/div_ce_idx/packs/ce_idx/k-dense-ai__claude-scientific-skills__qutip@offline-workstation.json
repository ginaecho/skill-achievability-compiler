      "pre": {
        "and": [
          "needs:network_access"
        ]
      },
      "add": [
        "qutip_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_simulation": {
      "owner": "agent",
      "pre": "qutip_installed",
      "add": [
        "simulation_run"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
