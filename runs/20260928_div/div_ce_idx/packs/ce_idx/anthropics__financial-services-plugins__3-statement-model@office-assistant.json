{
  "name": "3-statement-model",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "map_template": {
      "owner": "agent",
      "pre": true,
      "add": [
        "template_mapped"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "map_template",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "confirm_mapping": [
            {
              "act": {
                "cap": "populate_historicals",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "confirm_historicals": [
                    {
                      "act": {
                        "cap": "build_is",
                        "by": "agent"
                      }
                    },
                    {
                      "choice": {
                        "by": "user",
                        "observed": true,
                        "branches": {
                          "confirm_is": [
                            {
                              "act": {
                                "cap": "build_bs",
                                "by": "agent"
                              }
                            },
                            {
                              "choice": {
                                "by": "user",
                                "observed": true,
                                "branches": {
                                  "confirm_bs": [
                                    {
                                      "act": {
                                        "cap": "build_cf",
                                        "by": "agent"
                                      }
                                    },
                                    {
                                      "choice": {
                                        "by": "user",
                                        "observed": true,
                                        "branches": {
                                          "confirm_cf": [
                                            {
                                              "act": {
                                                "cap": "final_review",
                                                "by": "agent"
                                              }
                                            }
                                          ],
                                          "revise": []
                                        }
                                      }
                                    }
                                  ],
                                  "revise": []
                                }
                              }
                            }
                          ],
                          "revise": []
                        }
                      }
                    }
                  ],
                  "revise": []
                }
              }
            }
          ],
          "revise": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "template_mapped",
      "historicals_populated",
      "is_built",
      "bs_built",
      "cf_built",
      "model_complete"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
