      "owner": "agent",
      "pre": true,
      "add": [
        "deps_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "provision_foundry_project": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "deps_checked"
        ]
      },
      "add": [
        "project_provisioned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_agent": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "project_provisioned"
        ]
      },
      "add": [
        "agent_deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "invoke_agent": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "agent_deployed"
        ]
      },
      "add": [
        "agent_invoked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
