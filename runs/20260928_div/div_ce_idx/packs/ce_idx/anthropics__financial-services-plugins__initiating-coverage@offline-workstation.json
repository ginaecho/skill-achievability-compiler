{
  "name": "initiating-coverage",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_task": {
      "owner": "agent",
      "pre": true,
      "add": [
        "task_selected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "research_company": {
      "owner": "agent",
      "pre": "task_selected",
      "add": [
        "research_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_financial_model": {
      "owner": "agent",
      "pre": "task_selected",
      "add": [
        "model_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_valuation": {
      "owner": "agent",
      "pre": "model_built",
      "add": [
        "valuation_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "ask_task",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "task1_research": [
            {
              "act": {
                "cap": "research_company",
                "by": "agent"
              }
            }
          ],
          "task2_model": [
            {
              "act": {
                "cap": "build_financial_model",
                "by": "agent"
              }
            }
          ],
          "task3_valuation": [
            {
              "act": {
                "cap": "build_financial_model",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "build_valuation",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "task_selected",
      {
        "or": [
          "research_done",
          "model_built",
          "valuation_built",
          "charts_generated",
          "report_assembled"
        ]
      }
    ]
  },
  "init_true": [],
  "init_constraints": []
}
