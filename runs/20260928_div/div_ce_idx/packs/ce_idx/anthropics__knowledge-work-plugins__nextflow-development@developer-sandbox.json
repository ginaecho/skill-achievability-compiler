{
  "name": "nextflow-development",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "use_local_data": {
      "owner": "agent",
      "pre": true,
      "add": [
        "data_acquired"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "acquire_data": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet"
        ]
      },
      "add": [
        "data_acquired"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_environment": {
      "owner": "agent",
      "pre": true,
      "add": [
        "env_ok"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_test_profile": {
      "owner": "agent",
      "pre": "env_ok",
      "add": [
        "test_passed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_samplesheet": {
      "owner": "agent",
      "pre": "data_acquired",
      "add": [
        "samplesheet_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_pipeline": {
      "owner": "agent",
      "pre": {
        "and": [
          "test_passed",
          "samplesheet_created"
        ]
      },
      "add": [
        "pipeline_run"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_outputs": {
      "owner": "agent",
      "pre": "pipeline_run",
      "add": [
        "outputs_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "local_data": [
            {
              "act": {
                "cap": "use_local_data",
                "by": "agent"
              }
            }
          ],
          "geo_sra": [
            {
              "act": {
                "cap": "acquire_data",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "check_environment",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_test_profile",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_samplesheet",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_pipeline",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_outputs",
        "by": "agent"
      }
    }
  ],
  "goal": "outputs_verified",
  "init_true": [
    "needs:public_internet"
  ],
  "init_constraints": []
}
