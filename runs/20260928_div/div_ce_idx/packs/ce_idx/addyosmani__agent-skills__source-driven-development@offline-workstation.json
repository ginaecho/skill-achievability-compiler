{
  "name": "source-driven-development",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "detect_stack": {
      "owner": "agent",
      "pre": true,
      "add": [
        "stack_detected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_versions": {
      "owner": "agent",
      "pre": "stack_detected",
      "add": [
        "versions_confirmed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_code": {
      "owner": "agent",
      "pre": "docs_fetched",
      "add": [
        "code_implemented",
        "sources_cited"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "detect_stack",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "versions_clear": [],
          "versions_ambiguous": [
            {
              "act": {
                "cap": "ask_versions",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "fetch_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "implement_code",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "code_implemented",
      "sources_cited"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
