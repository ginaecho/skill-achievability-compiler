{
  "name": "tax-season-organizer",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_business_context": {
      "owner": "agent",
      "pre": true,
      "add": [
        "country_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_country": {
      "owner": "agent",
      "pre": true,
      "add": [
        "country_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_uploaded_csv": {
      "owner": "agent",
      "pre": true,
      "add": [
        "financials_pulled"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_user_financials": {
      "owner": "agent",
      "pre": true,
      "add": [
        "financials_pulled"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_prior_payments": {
      "owner": "agent",
      "pre": "financials_pulled",
      "add": [
        "prior_payments_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_report": {
      "owner": "agent",
      "pre": {
        "and": [
          "prior_payments_known",
          "country_known"
        ]
      },
      "add": [
        "report_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_business_context",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "country_missing": [
            {
              "act": {
                "cap": "ask_country",
                "by": "agent"
              }
            }
          ],
          "country_present": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "us_business": [
            {
              "choice": {
                "by": "agent",
                "observed": true,
                "branches": {
                  "csv_uploaded": [
                    {
                      "act": {
                        "cap": "read_uploaded_csv",
                        "by": "agent"
                      }
                    }
                  ],
                  "manual_paste": [
                    {
                      "act": {
                        "cap": "ask_user_financials",
                        "by": "agent"
                      }
                    }
                  ]
                }
              }
            },
            {
              "act": {
                "cap": "ask_prior_payments",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "write_report",
                "by": "agent"
              }
            }
          ],
          "non_us_business": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "country_known",
      "financials_pulled",
      "prior_payments_known",
      "report_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
