{
  "name": "eas-app-stores",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "write_eas_config": {
      "owner": "agent",
      "pre": true,
      "add": [
        "eas_config_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_eas_cli": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:network_access"
        ]
      },
      "add": [
        "eas_cli_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "eas_login": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:expo_account",
          "eas_cli_installed"
        ]
      },
      "add": [
        "eas_authenticated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "eas_init": {
      "owner": "agent",
      "pre": "eas_authenticated",
      "add": [
        "eas_project_linked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "eas_build": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:expo_account",
          {
            "and": [
              "eas_project_linked",
              "eas_config_written"
            ]
          }
        ]
      },
      "add": [
        "build_completed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "eas_submit": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:apple_developer_account",
          "build_completed"
        ]
      },
      "add": [
        "submitted_to_store"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_eas_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_eas_cli",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "eas_login",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "eas_init",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "eas_build",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "eas_submit",
        "by": "agent"
      }
    }
  ],
  "goal": "submitted_to_store",
  "init_true": [],
  "init_constraints": []
}
