{
  "name": "interpreting-culture-index",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_existing_json": {
      "owner": "agent",
      "pre": true,
      "add": [
        "json_provided"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "extract_pdf": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:preinstalled_software"
        ]
      },
      "add": [
        "json_extracted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_profile_json": {
      "owner": "agent",
      "pre": {
        "or": [
          "json_provided",
          "json_extracted"
        ]
      },
      "add": [
        "profile_loaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "json_available": [
            {
              "act": {
                "cap": "check_existing_json",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "read_profile_json",
                "by": "agent"
              }
            }
          ],
          "pdf_only": [
            {
              "act": {
                "cap": "extract_pdf",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "read_profile_json",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": "profile_loaded",
  "init_true": [
    "needs:preinstalled_software"
  ],
  "init_constraints": []
}
