{
  "name": "social-content-engine",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_voice_profile": {
      "owner": "agent",
      "pre": true,
      "add": [
        "voice_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_voice_profile": {
      "owner": "agent",
      "pre": true,
      "add": [
        "voice_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_calendar": {
      "owner": "agent",
      "pre": true,
      "add": [
        "calendar_loaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_calendar_approval": {
      "owner": "agent",
      "pre": "calendar_loaded",
      "add": [
        "calendar_approved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_budget_approval": {
      "owner": "agent",
      "pre": true,
      "add": [
        "budget_approved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_asset_briefs": {
      "owner": "agent",
      "pre": {
        "and": [
          "calendar_approved",
          "budget_approved"
        ]
      },
      "add": [
        "designs_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_scheduling_csv": {
      "owner": "agent",
      "pre": "designs_generated",
      "add": [
        "posts_staged"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_calendar_artifact": {
      "owner": "agent",
      "pre": "posts_staged",
      "add": [
        "calendar_delivered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_final_confirmation": {
      "owner": "agent",
      "pre": "posts_staged",
      "add": [
        "final_confirmed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_calendar",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "no_voice_profile": [
            {
              "act": {
                "cap": "build_voice_profile",
                "by": "agent"
              }
            }
          ],
          "voice_profile_exists": [
            {
              "act": {
                "cap": "read_voice_profile",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "ask_calendar_approval",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "shopify_connected": [
            {
              "act": {
                "cap": "pull_shopify",
                "by": "agent"
              }
            }
          ],
          "no_shopify": []
        }
      }
    },
    {
      "act": {
        "cap": "ask_budget_approval",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "canva_connected": [
            {
              "act": {
                "cap": "generate_design",
                "by": "agent"
              }
            }
          ],
          "no_canva": [
            {
              "act": {
                "cap": "write_asset_briefs",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "hubspot_connected": [
            {
              "act": {
                "cap": "stage_hubspot",
                "by": "agent"
              }
            }
          ],
          "csv_fallback": [
            {
              "act": {
                "cap": "write_scheduling_csv",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "write_calendar_artifact",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "ask_final_confirmation",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "calendar_approved",
      "designs_generated",
      "posts_staged",
      "calendar_delivered",
      "final_confirmed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
