{
  "name": "deep-work",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "run_shallow_work_auditor": {
      "owner": "agent",
      "pre": "tasklist_provided",
      "add": [
        "audit_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_time_block_planner": {
      "owner": "agent",
      "pre": "audit_done",
      "add": [
        "schedule_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "run_shallow_work_auditor",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_time_block_planner",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "audit_done",
      "schedule_built"
    ]
  },
  "init_true": [
    "tasklist_provided"
  ],
  "init_constraints": []
}
