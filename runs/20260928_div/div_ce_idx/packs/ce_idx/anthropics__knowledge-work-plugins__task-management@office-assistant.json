{
  "name": "task-management",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_tasks": {
      "owner": "agent",
      "pre": true,
      "add": [
        "tasks_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_tasks_file": {
      "owner": "agent",
      "pre": true,
      "add": [
        "tasks_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_tasks": {
      "owner": "agent",
      "pre": "tasks_read",
      "add": [
        "tasks_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "file_exists": [
            {
              "act": {
                "cap": "read_tasks",
                "by": "agent"
              }
            }
          ],
          "no_file": [
            {
              "act": {
                "cap": "create_tasks_file",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "write_tasks",
        "by": "agent"
      }
    }
  ],
  "goal": "tasks_updated",
  "init_true": [],
  "init_constraints": []
}
