{
  "name": "search-strategy",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_user": {
      "owner": "agent",
      "pre": true,
      "add": [
        "clarification_received"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "ambiguous": [
            {
              "act": {
                "cap": "ask_user",
                "by": "agent"
              }
            }
          ],
          "clear": []
        }
      }
    },
    {
      "act": {
        "cap": "search_chat",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "search_kb",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "search_tracker",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "chat_searched",
      "kb_searched",
      "tracker_searched"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
