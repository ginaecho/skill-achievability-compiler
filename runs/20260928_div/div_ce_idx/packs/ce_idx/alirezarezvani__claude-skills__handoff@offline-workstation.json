{
  "name": "handoff",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_config": {
      "owner": "agent",
      "pre": true,
      "add": [
        "config_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_setup": {
      "owner": "agent",
      "pre": "config_checked",
      "add": [
        "setup_asked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_setup": {
      "owner": "agent",
      "pre": "setup_asked",
      "add": [
        "config_saved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "determine_save_path": {
      "owner": "agent",
      "pre": true,
      "add": [
        "save_path_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_handoff": {
      "owner": "agent",
      "pre": "save_path_ready",
      "add": [
        "handoff_drafted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "redact_draft": {
      "owner": "agent",
      "pre": "handoff_drafted",
      "add": [
        "redacted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "save_handoff": {
      "owner": "agent",
      "pre": "redacted",
      "add": [
        "handoff_saved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_config",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "first_run": [
            {
              "act": {
                "cap": "ask_setup",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "accept_setup": [
                    {
                      "act": {
                        "cap": "run_setup",
                        "by": "agent"
                      }
                    }
                  ],
                  "decline_setup": []
                }
              }
            }
          ],
          "already_configured": []
        }
      }
    },
    {
      "act": {
        "cap": "determine_save_path",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_handoff",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "redact_draft",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "save_handoff",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "handoff_saved",
      "redacted"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
