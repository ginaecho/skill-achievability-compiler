{
  "name": "hf-cloud-python-env-setup",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "create_venv": {
      "owner": "agent",
      "pre": true,
      "add": [
        "venv_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_packages": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:network_access",
          "venv_created"
        ]
      },
      "add": [
        "packages_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_versions": {
      "owner": "agent",
      "pre": "packages_installed",
      "add": [
        "versions_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "create_venv",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_packages",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_versions",
        "by": "agent"
      }
    }
  ],
  "goal": "versions_verified",
  "init_true": [],
  "init_constraints": []
}
