{
  "name": "acme-release-notes",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "pull_changelog": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:acmectl_cli",
          "needs:acme_sso_session"
        ]
      },
      "add": [
        "changes_pulled"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_notes": {
      "owner": "agent",
      "pre": "changes_pulled",
      "add": [
        "notes_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "pull_changelog",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_notes",
        "by": "agent"
      }
    }
  ],
  "goal": "notes_written",
  "init_true": [],
  "init_constraints": []
}
