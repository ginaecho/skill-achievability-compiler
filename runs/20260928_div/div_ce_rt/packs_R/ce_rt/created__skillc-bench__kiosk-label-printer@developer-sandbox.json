{
  "name": "kiosk-label-printer",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_orders": {
      "owner": "agent",
      "pre": true,
      "add": [
        "orders_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_labels": {
      "owner": "agent",
      "pre": "orders_read",
      "add": [
        "labels_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_orders",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_labels",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "print_loop",
        "body": [
          {
            "act": {
              "cap": "print_label",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "user",
              "observed": true,
              "branches": {
                "printed": [],
                "jammed": [
                  {
                    "continue": "print_loop"
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "goal": "label_printed",
  "init_true": [],
  "init_constraints": []
}
