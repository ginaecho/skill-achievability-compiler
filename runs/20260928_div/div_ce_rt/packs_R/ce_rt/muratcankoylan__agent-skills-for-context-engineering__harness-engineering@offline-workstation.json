{
  "name": "harness-engineering",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "create_file_layout": {
      "owner": "agent",
      "pre": true,
      "add": [
        "layout_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_thread_log": {
      "owner": "agent",
      "pre": "layout_created",
      "add": [
        "log_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_evaluator": {
      "owner": "agent",
      "pre": "layout_created",
      "add": [
        "evaluated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "prepare_pr": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:git_remote_access",
          "evaluated"
        ]
      },
      "add": [
        "pr_prepared"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "create_file_layout",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_thread_log",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "prepare_pr": [
            {
              "act": {
                "cap": "run_evaluator",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "prepare_pr",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "layout_created",
      "log_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
