{
  "name": "expo-web-to-native",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "assess_repo": {
      "owner": "agent",
      "pre": true,
      "add": [
        "worklist_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scaffold_shell": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:package_registry",
          "worklist_written"
        ]
      },
      "add": [
        "shell_scaffolded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "dom_shell": {
      "owner": "agent",
      "pre": "shell_scaffolded",
      "add": [
        "dom_shell_shipped"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "nativize_screen": {
      "owner": "agent",
      "pre": "dom_shell_shipped",
      "add": [
        "screen_nativized"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "wire_data": {
      "owner": "agent",
      "pre": "dom_shell_shipped",
      "add": [
        "data_wired"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ship_app": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:app_store_account",
          {
            "and": [
              "verified",
              "data_wired"
            ]
          }
        ]
      },
      "add": [
        "shipped"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "assess_repo",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scaffold_shell",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "dom_shell",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "nativize_loop",
        "body": [
          {
            "act": {
              "cap": "nativize_screen",
              "by": "agent"
            }
          },
          {
            "continue": "nativize_loop"
          }
        ]
      }
    },
    {
      "act": {
        "cap": "wire_data",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_on_device",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "ship_app",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "dom_shell_shipped",
      "screen_nativized",
      "data_wired",
      "shipped"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
