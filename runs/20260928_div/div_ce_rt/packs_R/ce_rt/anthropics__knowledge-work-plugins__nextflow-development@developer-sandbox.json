{
  "name": "nextflow-development",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_environment": {
      "owner": "agent",
      "pre": true,
      "add": [
        "env_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "select_pipeline": {
      "owner": "agent",
      "pre": "env_checked",
      "add": [
        "pipeline_selected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_test_profile": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:docker",
          "needs:public_internet",
          "pipeline_selected"
        ]
      },
      "add": [
        "test_passed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_samplesheet": {
      "owner": "agent",
      "pre": "test_passed",
      "add": [
        "samplesheet_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "confirm_genome": {
      "owner": "agent",
      "pre": "samplesheet_created",
      "add": [
        "genome_confirmed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_and_run": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:docker",
          "needs:public_internet",
          {
            "and": [
              "samplesheet_created",
              "genome_confirmed"
            ]
          }
        ]
      },
      "add": [
        "pipeline_run"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_outputs": {
      "owner": "agent",
      "pre": "pipeline_run",
      "add": [
        "outputs_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_environment",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "rnaseq": [
            {
              "act": {
                "cap": "select_pipeline",
                "by": "agent"
              }
            }
          ],
          "sarek": [
            {
              "act": {
                "cap": "select_pipeline",
                "by": "agent"
              }
            }
          ],
          "atacseq": [
            {
              "act": {
                "cap": "select_pipeline",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "run_test_profile",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_samplesheet",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "genome_confirm": [
            {
              "act": {
                "cap": "confirm_genome",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "configure_and_run",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_outputs",
        "by": "agent"
      }
    }
  ],
  "goal": "outputs_verified",
  "init_true": [
    "needs:docker",
    "needs:public_internet"
  ],
  "init_constraints": []
}
