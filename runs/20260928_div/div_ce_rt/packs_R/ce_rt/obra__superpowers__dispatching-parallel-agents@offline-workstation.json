{
  "name": "dispatching-parallel-agents",
  "roles": [
    "agent",
    "sub_a",
    "sub_b"
  ],
  "capabilities": {
    "fix_domain_a": {
      "owner": "sub_a",
      "pre": true,
      "add": [
        "domain_a_fixed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fix_domain_b": {
      "owner": "sub_b",
      "pre": true,
      "add": [
        "domain_b_fixed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_full_suite": {
      "owner": "agent",
      "pre": {
        "and": [
          "domain_a_fixed",
          "domain_b_fixed"
        ]
      },
      "add": [
        "tests_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "spawn": {
        "role": "sub_a"
      }
    },
    {
      "spawn": {
        "role": "sub_b"
      }
    },
    {
      "act": {
        "cap": "fix_domain_a",
        "by": "sub_a"
      }
    },
    {
      "act": {
        "cap": "fix_domain_b",
        "by": "sub_b"
      }
    },
    {
      "msg": {
        "from": "sub_a",
        "to": "agent",
        "label": "domain_a_done"
      }
    },
    {
      "msg": {
        "from": "sub_b",
        "to": "agent",
        "label": "domain_b_done"
      }
    },
    {
      "act": {
        "cap": "run_full_suite",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "domain_a_fixed",
      "domain_b_fixed",
      "tests_pass"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
