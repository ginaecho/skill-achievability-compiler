{
  "name": "chatgpt-apps",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "fetch_docs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "docs_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scaffold_server": {
      "owner": "agent",
      "pre": "docs_fetched",
      "add": [
        "server_scaffolded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scaffold_widget": {
      "owner": "agent",
      "pre": "docs_fetched",
      "add": [
        "widget_scaffolded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_repo": {
      "owner": "agent",
      "pre": {
        "and": [
          "server_scaffolded",
          "widget_scaffolded"
        ]
      },
      "add": [
        "repo_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "fetch_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scaffold_server",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scaffold_widget",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_repo",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "server_scaffolded",
      "widget_scaffolded",
      "repo_validated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
