{
  "name": "research-synthesis",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "extract_themes": {
      "owner": "agent",
      "pre": "research_data_provided",
      "add": [
        "themes_extracted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "identify_segments": {
      "owner": "agent",
      "pre": "themes_extracted",
      "add": [
        "segments_identified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "produce_synthesis": {
      "owner": "agent",
      "pre": {
        "and": [
          "themes_extracted",
          "segments_identified"
        ]
      },
      "add": [
        "synthesis_produced"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "extract_themes",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "identify_segments",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "produce_synthesis",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "synthesis_produced",
      "themes_extracted",
      "segments_identified"
    ]
  },
  "init_true": [
    "research_data_provided"
  ],
  "init_constraints": []
}
