{
  "name": "accelerated-computing-cudf",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "write_cudf_script": {
      "owner": "agent",
      "pre": true,
      "add": [
        "script_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_cudf_script": {
      "owner": "agent",
      "pre": "script_written",
      "add": [
        "script_run"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_parity": {
      "owner": "agent",
      "pre": "script_run",
      "add": [
        "parity_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_cudf_script",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_cudf_script",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "parity_needed": [
            {
              "act": {
                "cap": "validate_parity",
                "by": "agent"
              }
            }
          ],
          "parity_not_needed": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "script_written",
      "script_run"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
