{
  "name": "review-reputation",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "gather_reviews": {
      "owner": "agent",
      "pre": true,
      "add": [
        "reviews_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "produce_report": {
      "owner": "agent",
      "pre": "reviews_gathered",
      "add": [
        "themes_extracted",
        "responses_drafted",
        "report_produced"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "gather_reviews",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "produce_report",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "report_produced",
      "themes_extracted",
      "responses_drafted"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
