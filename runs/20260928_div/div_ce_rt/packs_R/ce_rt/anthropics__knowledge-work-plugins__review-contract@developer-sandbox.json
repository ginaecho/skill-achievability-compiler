{
  "name": "review-contract",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_contract": {
      "owner": "agent",
      "pre": true,
      "add": [
        "contract_loaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "gather_context": {
      "owner": "agent",
      "pre": "contract_loaded",
      "add": [
        "context_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "load_playbook": {
      "owner": "agent",
      "pre": "context_gathered",
      "add": [
        "playbook_loaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_playbook": {
      "owner": "agent",
      "pre": "context_gathered",
      "add": [
        "playbook_loaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "analyze_clauses": {
      "owner": "agent",
      "pre": {
        "and": [
          "contract_loaded",
          "context_gathered"
        ]
      },
      "add": [
        "clauses_analyzed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "flag_deviations": {
      "owner": "agent",
      "pre": "clauses_analyzed",
      "add": [
        "deviations_flagged"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_redlines": {
      "owner": "agent",
      "pre": "deviations_flagged",
      "add": [
        "redlines_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "produce_summary": {
      "owner": "agent",
      "pre": "redlines_generated",
      "add": [
        "summary_produced"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_contract",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "gather_context",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "playbook_found": [
            {
              "act": {
                "cap": "load_playbook",
                "by": "agent"
              }
            }
          ],
          "no_playbook": [
            {
              "msg": {
                "from": "agent",
                "to": "user",
                "label": "no_playbook_found"
              }
            },
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "setup_playbook": [
                    {
                      "act": {
                        "cap": "write_playbook",
                        "by": "agent"
                      }
                    }
                  ],
                  "proceed_generic": []
                }
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "analyze_clauses",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "flag_deviations",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_redlines",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "produce_summary",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "summary_produced",
      "redlines_generated",
      "deviations_flagged"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
