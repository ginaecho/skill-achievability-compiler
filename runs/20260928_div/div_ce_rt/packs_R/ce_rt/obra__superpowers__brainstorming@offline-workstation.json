{
  "name": "brainstorming",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "explore_context": {
      "owner": "agent",
      "pre": true,
      "add": [
        "context_explored"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_clarifying": {
      "owner": "agent",
      "pre": "context_explored",
      "add": [
        "requirements_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "present_design": {
      "owner": "agent",
      "pre": "requirements_known",
      "add": [
        "design_presented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_spec": {
      "owner": "agent",
      "pre": "design_presented",
      "add": [
        "spec_written",
        "design_approved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "commit_spec": {
      "owner": "agent",
      "pre": "spec_written",
      "add": [
        "spec_committed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "explore_context",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "ask_clarifying",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "present_design",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "approve": [
            {
              "act": {
                "cap": "write_spec",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "commit_spec",
                "by": "agent"
              }
            }
          ],
          "revise": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "spec_written",
      "spec_committed",
      "design_approved"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
