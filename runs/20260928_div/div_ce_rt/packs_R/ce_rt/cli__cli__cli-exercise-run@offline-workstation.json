{
  "name": "cli-exercise-run",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "verify_checksum": {
      "owner": "agent",
      "pre": true,
      "add": [
        "checksum_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "start_run": {
      "owner": "agent",
      "pre": "checksum_verified",
      "add": [
        "run_started"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_setup": {
      "owner": "agent",
      "pre": "run_started",
      "add": [
        "setup_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "exercise": {
      "owner": "agent",
      "pre": "setup_done",
      "add": [
        "exercised"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate": {
      "owner": "agent",
      "pre": "exercised",
      "add": [
        "validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "finish_run": {
      "owner": "agent",
      "pre": "validated",
      "add": [
        "run_finished"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "cleanup": {
      "owner": "agent",
      "pre": "run_finished",
      "add": [
        "cleaned_up"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "verify_checksum",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "start_run",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_setup",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "exercise",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "finish_run",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "cleanup_approved": [
            {
              "act": {
                "cap": "cleanup",
                "by": "agent"
              }
            }
          ],
          "no_cleanup": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "run_finished",
      "validated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
