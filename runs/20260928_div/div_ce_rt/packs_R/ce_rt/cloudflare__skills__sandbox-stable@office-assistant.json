{
  "name": "sandbox-stable",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_package": {
      "owner": "agent",
      "pre": true,
      "add": [
        "package_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_docs": {
      "owner": "agent",
      "pre": "package_checked",
      "add": [
        "docs_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_code": {
      "owner": "agent",
      "pre": "docs_fetched",
      "add": [
        "code_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_package",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "stable_confirmed": [
            {
              "act": {
                "cap": "fetch_docs",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "write_code",
                "by": "agent"
              }
            }
          ],
          "next_detected": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "code_written",
      "docs_fetched"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
