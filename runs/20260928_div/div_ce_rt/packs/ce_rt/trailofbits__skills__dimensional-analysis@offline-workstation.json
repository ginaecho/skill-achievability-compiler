{
  "name": "dimensional-analysis",
  "roles": [
    "orchestrator",
    "scanner",
    "discoverer",
    "annotator",
    "propagator",
    "validator"
  ],
  "capabilities": {
    "scan_repo": {
      "owner": "scanner",
      "pre": true,
      "add": [
        "scope_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "discover_vocab": {
      "owner": "discoverer",
      "pre": "scope_written",
      "add": [
        "vocab_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "annotate_files": {
      "owner": "annotator",
      "pre": "vocab_written",
      "add": [
        "annotated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "propagate_dimensions": {
      "owner": "propagator",
      "pre": "annotated",
      "add": [
        "propagated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_files": {
      "owner": "validator",
      "pre": "propagated",
      "add": [
        "validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "spawn": {
        "role": "scanner"
      }
    },
    {
      "act": {
        "cap": "scan_repo",
        "by": "scanner"
      }
    },
    {
      "msg": {
        "from": "scanner",
        "to": "orchestrator",
        "label": "scan_done"
      }
    },
    {
      "spawn": {
        "role": "discoverer"
      }
    },
    {
      "act": {
        "cap": "discover_vocab",
        "by": "discoverer"
      }
    },
    {
      "msg": {
        "from": "discoverer",
        "to": "orchestrator",
        "label": "vocab_done"
      }
    },
    {
      "spawn": {
        "role": "annotator"
      }
    },
    {
      "act": {
        "cap": "annotate_files",
        "by": "annotator"
      }
    },
    {
      "msg": {
        "from": "annotator",
        "to": "orchestrator",
        "label": "annotate_done"
      }
    },
    {
      "spawn": {
        "role": "propagator"
      }
    },
    {
      "act": {
        "cap": "propagate_dimensions",
        "by": "propagator"
      }
    },
    {
      "msg": {
        "from": "propagator",
        "to": "orchestrator",
        "label": "propagate_done"
      }
    },
    {
      "spawn": {
        "role": "validator"
      }
    },
    {
      "act": {
        "cap": "validate_files",
        "by": "validator"
      }
    },
    {
      "msg": {
        "from": "validator",
        "to": "orchestrator",
        "label": "validate_done"
      }
    }
  ],
  "goal": {
    "and": [
      "scope_written",
      "vocab_written",
      "annotated",
      "propagated",
      "validated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
