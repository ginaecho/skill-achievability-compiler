{
  "name": "buyer-list",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "gather_target_info": {
      "owner": "agent",
      "pre": true,
      "add": [
        "target_info_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "research_strategic_buyers": {
      "owner": "agent",
      "pre": "target_info_gathered",
      "add": [
        "strategic_buyers_identified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "research_financial_sponsors": {
      "owner": "agent",
      "pre": "target_info_gathered",
      "add": [
        "sponsors_identified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_workbook": {
      "owner": "agent",
      "pre": {
        "and": [
          "strategic_buyers_identified",
          "sponsors_identified"
        ]
      },
      "add": [
        "workbook_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "gather_target_info",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "research_strategic_buyers",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "research_financial_sponsors",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "adjust_list": [
            {
              "act": {
                "cap": "gather_target_info",
                "by": "agent"
              }
            }
          ],
          "no_changes": []
        }
      }
    },
    {
      "act": {
        "cap": "build_workbook",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "strategic_buyers_identified",
      "sponsors_identified",
      "workbook_built"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
