{
  "name": "process-optimization",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "analyze_process": {
      "owner": "agent",
      "pre": "process_described",
      "add": [
        "current_state_mapped",
        "waste_identified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "design_future_state": {
      "owner": "agent",
      "pre": {
        "and": [
          "current_state_mapped",
          "waste_identified"
        ]
      },
      "add": [
        "future_state_designed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "estimate_impact": {
      "owner": "agent",
      "pre": "future_state_designed",
      "add": [
        "impact_estimated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "produce_comparison": {
      "owner": "agent",
      "pre": {
        "and": [
          "future_state_designed",
          "impact_estimated"
        ]
      },
      "add": [
        "comparison_produced"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "analyze_process",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "design_future_state",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "estimate_impact",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "produce_comparison",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "comparison_produced",
      "future_state_designed",
      "impact_estimated"
    ]
  },
  "init_true": [
    "process_described"
  ],
  "init_constraints": []
}
