{
  "name": "iterate-pr",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "fix_feedback": {
      "owner": "agent",
      "pre": "feedback_fetched",
      "add": [
        "feedback_addressed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fix_failure": {
      "owner": "agent",
      "pre": "ci_checked",
      "add": [
        "fix_applied"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_pr_status",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_feedback",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fix_feedback",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "ci_loop",
        "body": [
          {
            "act": {
              "cap": "fetch_ci_checks",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "failed": [
                  {
                    "act": {
                      "cap": "fix_failure",
                      "by": "agent"
                    }
                  },
                  {
                    "act": {
                      "cap": "verify_locally",
                      "by": "agent"
                    }
                  },
                  {
                    "act": {
                      "cap": "commit_push",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "ci_loop"
                  }
                ],
                "passed": [
                  {
                    "act": {
                      "cap": "monitor_ci",
                      "by": "agent"
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "goal": {
    "and": [
      "ci_passed",
      "feedback_addressed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
