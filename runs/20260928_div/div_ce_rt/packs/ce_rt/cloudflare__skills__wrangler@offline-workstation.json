{
  "name": "wrangler",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "inspect_project": {
      "owner": "agent",
      "pre": true,
      "add": [
        "project_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "edit_config": {
      "owner": "agent",
      "pre": "project_inspected",
      "add": [
        "config_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_worker": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:cloudflare_account",
          "config_updated"
        ]
      },
      "add": [
        "deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_deploy": {
      "owner": "agent",
      "pre": "deployed",
      "add": [
        "validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_project",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "docs_available": [
            {
              "act": {
                "cap": "fetch_docs",
                "by": "agent"
              }
            }
          ],
          "docs_unavailable": []
        }
      }
    },
    {
      "act": {
        "cap": "edit_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "deploy_worker",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_deploy",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "deployed",
      "validated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
