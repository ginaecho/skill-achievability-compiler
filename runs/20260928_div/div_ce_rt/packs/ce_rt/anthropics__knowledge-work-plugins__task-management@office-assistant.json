{
  "name": "task-management",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_tasks": {
      "owner": "agent",
      "pre": true,
      "add": [
        "tasks_loaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_tasks_file": {
      "owner": "agent",
      "pre": true,
      "add": [
        "tasks_loaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "copy_dashboard": {
      "owner": "agent",
      "pre": true,
      "add": [
        "dashboard_added"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "update_tasks": {
      "owner": "agent",
      "pre": "tasks_loaded",
      "add": [
        "tasks_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "exists": [
            {
              "act": {
                "cap": "read_tasks",
                "by": "agent"
              }
            }
          ],
          "missing": [
            {
              "act": {
                "cap": "create_tasks_file",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "dashboard_missing": [
            {
              "act": {
                "cap": "copy_dashboard",
                "by": "agent"
              }
            }
          ],
          "dashboard_present": []
        }
      }
    },
    {
      "act": {
        "cap": "update_tasks",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "tasks_loaded",
      "tasks_updated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
