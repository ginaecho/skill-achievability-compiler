{
  "name": "hf-cloud-aws-context-discovery",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_aws_config": {
      "owner": "agent",
      "pre": true,
      "add": [
        "profile_region_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_caller_identity": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:aws_account",
          "profile_region_known"
        ]
      },
      "add": [
        "identity_confirmed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_aws_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_caller_identity",
        "by": "agent"
      }
    }
  ],
  "goal": "identity_confirmed",
  "init_true": [],
  "init_constraints": []
}
