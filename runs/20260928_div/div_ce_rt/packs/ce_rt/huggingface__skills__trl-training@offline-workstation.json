{
  "name": "trl-training",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "train_model": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:network_access"
        ]
      },
      "add": [
        "model_trained"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "push_to_hub": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:huggingface_account",
          "model_trained"
        ]
      },
      "add": [
        "model_published"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "train_model",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "push": [
            {
              "act": {
                "cap": "push_to_hub",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": "model_trained",
  "init_true": [],
  "init_constraints": []
}
