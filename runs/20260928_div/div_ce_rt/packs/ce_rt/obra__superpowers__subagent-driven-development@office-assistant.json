{
  "name": "subagent-driven-development",
  "roles": [
    "controller",
    "implementer",
    "reviewer"
  ],
  "capabilities": {
    "read_plan": {
      "owner": "controller",
      "pre": "workspace_ready",
      "add": [
        "plan_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "review_task": {
      "owner": "reviewer",
      "pre": "review_package_ready",
      "add": [
        "task_reviewed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "final_code_review": {
      "owner": "reviewer",
      "pre": "task_reviewed",
      "add": [
        "branch_reviewed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "setup_workspace",
        "by": "controller"
      }
    },
    {
      "act": {
        "cap": "read_plan",
        "by": "controller"
      }
    },
    {
      "act": {
        "cap": "generate_task_brief",
        "by": "controller"
      }
    },
    {
      "spawn": {
        "role": "implementer"
      }
    },
    {
      "act": {
        "cap": "implement_task",
        "by": "implementer"
      }
    },
    {
      "msg": {
        "from": "implementer",
        "to": "controller",
        "label": "report"
      }
    },
    {
      "act": {
        "cap": "generate_review_package",
        "by": "controller"
      }
    },
    {
      "spawn": {
        "role": "reviewer"
      }
    },
    {
      "act": {
        "cap": "review_task",
        "by": "reviewer"
      }
    },
    {
      "msg": {
        "from": "reviewer",
        "to": "controller",
        "label": "review_result"
      }
    },
    {
      "choice": {
        "by": "controller",
        "observed": true,
        "branches": {
          "approved": [
            {
              "act": {
                "cap": "final_code_review",
                "by": "reviewer"
              }
            }
          ],
          "needs_fix": [
            {
              "act": {
                "cap": "implement_task",
                "by": "implementer"
              }
            },
            {
              "act": {
                "cap": "generate_review_package",
                "by": "controller"
              }
            },
            {
              "act": {
                "cap": "review_task",
                "by": "reviewer"
              }
            },
            {
              "act": {
                "cap": "final_code_review",
                "by": "reviewer"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "task_implemented",
      "task_reviewed",
      "branch_reviewed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
