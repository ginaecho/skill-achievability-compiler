{
  "name": "social-content-engine",
  "roles": [
    "agent",
    "owner"
  ],
  "capabilities": {
    "read_voice_profile": {
      "owner": "agent",
      "pre": true,
      "add": [
        "voice_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_voice_profile": {
      "owner": "agent",
      "pre": {
        "not": "voice_known"
      },
      "add": [
        "voice_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "load_calendar": {
      "owner": "agent",
      "pre": true,
      "add": [
        "calendar_loaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "get_calendar_approval": {
      "owner": "agent",
      "pre": "calendar_loaded",
      "add": [
        "calendar_approved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "get_budget_approval": {
      "owner": "agent",
      "pre": "calendar_approved",
      "add": [
        "budget_approved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "get_copy_approval": {
      "owner": "agent",
      "pre": "budget_approved",
      "add": [
        "copy_approved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "stage_posts": {
      "owner": "agent",
      "pre": "copy_approved",
      "add": [
        "staged"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "render_calendar_artifact": {
      "owner": "agent",
      "pre": "staged",
      "add": [
        "delivered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "existing_voice": [
            {
              "act": {
                "cap": "read_voice_profile",
                "by": "agent"
              }
            }
          ],
          "no_voice": [
            {
              "act": {
                "cap": "build_voice_profile",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "load_calendar",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "get_calendar_approval",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "shopify_connected": [
            {
              "act": {
                "cap": "pull_shopify",
                "by": "agent"
              }
            }
          ],
          "manual_source": []
        }
      }
    },
    {
      "act": {
        "cap": "get_budget_approval",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "get_copy_approval",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "stage_posts",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "render_calendar_artifact",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "voice_known",
      "calendar_approved",
      "copy_approved",
      "staged",
      "delivered"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
