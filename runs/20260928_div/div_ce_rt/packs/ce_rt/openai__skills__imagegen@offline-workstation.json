{
  "name": "imagegen",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "run_cli_generate": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:openai_api_key"
        ]
      },
      "add": [
        "image_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "save_to_workspace": {
      "owner": "agent",
      "pre": "image_generated",
      "add": [
        "image_saved_to_workspace"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "builtin_mode": [
            {
              "act": {
                "cap": "generate_image_builtin",
                "by": "agent"
              }
            }
          ],
          "cli_fallback_mode": [
            {
              "act": {
                "cap": "run_cli_generate",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "save_to_workspace",
        "by": "agent"
      }
    }
  ],
  "goal": "image_saved_to_workspace",
  "init_true": [],
  "init_constraints": []
}
