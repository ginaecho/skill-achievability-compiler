{
  "name": "deep-work",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "run_shallow_work_auditor": {
      "owner": "agent",
      "pre": true,
      "add": [
        "tasks_audited"
      ],
      "del": [],
      "assigns": {},
      "nondet": {
        "shallow_share": {
          "cmp": [
            "shallow_share",
            "<=",
            50
          ]
        }
      }
    },
    "run_time_block_planner": {
      "owner": "agent",
      "pre": "tasks_audited",
      "add": [
        "schedule_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {
        "deep_hours": {
          "cmp": [
            "deep_hours",
            "<=",
            4
          ]
        }
      }
    },
    "run_focus_session_logger": {
      "owner": "agent",
      "pre": "schedule_built",
      "add": [
        "session_logged"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "msg": {
        "from": "user",
        "to": "agent",
        "label": "task_list"
      }
    },
    {
      "rec": {
        "name": "audit_loop",
        "body": [
          {
            "act": {
              "cap": "run_shallow_work_auditor",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "user",
              "observed": true,
              "branches": {
                "within_budget": [],
                "revise_tasks": [
                  {
                    "continue": "audit_loop"
                  }
                ]
              }
            }
          }
        ]
      }
    },
    {
      "act": {
        "cap": "run_time_block_planner",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_focus_session_logger",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "tasks_audited",
      "schedule_built",
      "session_logged"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
