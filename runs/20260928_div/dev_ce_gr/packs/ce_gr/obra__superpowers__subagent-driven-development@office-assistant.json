{
  "name": "subagent-driven-development",
  "roles": [
    "controller",
    "implementer",
    "reviewer"
  ],
  "capabilities": {
    "write_task_brief": {
      "owner": "controller",
      "pre": "workspace_ready",
      "add": [
        "brief_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "setup_workspace",
        "by": "controller"
      }
    },
    {
      "act": {
        "cap": "write_task_brief",
        "by": "controller"
      }
    },
    {
      "spawn": {
        "role": "implementer"
      }
    },
    {
      "act": {
        "cap": "implement_task",
        "by": "implementer"
      }
    },
    {
      "spawn": {
        "role": "reviewer"
      }
    },
    {
      "act": {
        "cap": "review_task",
        "by": "reviewer"
      }
    },
    {
      "act": {
        "cap": "final_review",
        "by": "reviewer"
      }
    }
  ],
  "goal": "branch_reviewed",
  "init_true": [],
  "init_constraints": []
}
