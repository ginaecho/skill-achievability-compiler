{
  "name": "cli-exercise-run",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "verify_checksum": {
      "owner": "agent",
      "pre": "contract_approved",
      "add": [
        "checksum_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "start_run": {
      "owner": "agent",
      "pre": "checksum_verified",
      "add": [
        "run_started"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "observe_terminal": {
      "owner": "agent",
      "pre": "run_started",
      "add": [
        "observation_made"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "send_action": {
      "owner": "agent",
      "pre": "observation_made",
      "add": [
        "action_sent"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "finish_run": {
      "owner": "agent",
      "pre": {
        "and": [
          "run_started",
          "action_sent"
        ]
      },
      "add": [
        "run_finished"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "record_evidence": {
      "owner": "agent",
      "pre": "run_finished",
      "add": [
        "evidence_recorded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "verify_checksum",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "start_run",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "observe_terminal",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "send_action",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "finish_run",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "record_evidence",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "run_finished",
      "evidence_recorded"
    ]
  },
  "init_true": [
    "contract_approved"
  ],
  "init_constraints": []
}
