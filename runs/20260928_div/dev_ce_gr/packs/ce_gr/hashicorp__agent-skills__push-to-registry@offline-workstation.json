{
  "name": "push-to-registry",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "write_packer_template": {
      "owner": "agent",
      "pre": true,
      "add": [
        "template_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "set_hcp_credentials": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:hcp_account",
          "template_written"
        ]
      },
      "add": [
        "credentials_set"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_packer_template",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "set_hcp_credentials",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "packer_build_push",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "template_written",
      "credentials_set",
      "metadata_pushed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
