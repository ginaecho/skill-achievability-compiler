{
  "name": "kiosk-label-printer",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "build_labels": {
      "owner": "agent",
      "pre": "orders_present",
      "add": [
        "labels_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_packer": {
      "owner": "agent",
      "pre": "labels_printed",
      "add": [
        "packer_responded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "build_labels",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "print_cycle",
        "body": [
          {
            "act": {
              "cap": "print_label",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "ask_packer",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "all_printed": [],
                "jammed": [
                  {
                    "continue": "print_cycle"
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "goal": {
    "and": [
      "labels_printed",
      "packer_responded"
    ]
  },
  "init_true": [
    "orders_present"
  ],
  "init_constraints": []
}
