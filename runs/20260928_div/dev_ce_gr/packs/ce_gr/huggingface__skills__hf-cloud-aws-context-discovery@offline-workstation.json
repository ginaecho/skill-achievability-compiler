{
  "name": "hf-cloud-aws-context-discovery",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_region": {
      "owner": "agent",
      "pre": true,
      "add": [
        "region_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_aws_config",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "region_found": [],
          "region_unknown": [
            {
              "act": {
                "cap": "ask_region",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "get_caller_identity",
        "by": "agent"
      }
    }
  ],
  "goal": "identity_verified",
  "init_true": [],
  "init_constraints": []
}
