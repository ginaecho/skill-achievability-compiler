{
  "name": "social-content-engine",
  "roles": [
    "agent",
    "owner"
  ],
  "capabilities": {
    "build_voice_profile": {
      "owner": "agent",
      "pre": true,
      "add": [
        "voice_profile_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_calendar": {
      "owner": "agent",
      "pre": "voice_profile_built",
      "add": [
        "calendar_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "draft_asset_briefs": {
      "owner": "agent",
      "pre": "calendar_built",
      "add": [
        "designs_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_captions": {
      "owner": "agent",
      "pre": "designs_generated",
      "add": [
        "captions_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "stage_csv": {
      "owner": "agent",
      "pre": "captions_written",
      "add": [
        "posts_staged"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deliver_calendar": {
      "owner": "agent",
      "pre": "posts_staged",
      "add": [
        "calendar_delivered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "build_voice_profile",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_calendar",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "owner",
        "observed": true,
        "branches": {
          "approve_calendar": [
            {
              "act": {
                "cap": "draft_asset_briefs",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "write_captions",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "stage_csv",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "deliver_calendar",
                "by": "agent"
              }
            }
          ],
          "reject_calendar": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "calendar_built",
      "captions_written",
      "posts_staged",
      "calendar_delivered"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
