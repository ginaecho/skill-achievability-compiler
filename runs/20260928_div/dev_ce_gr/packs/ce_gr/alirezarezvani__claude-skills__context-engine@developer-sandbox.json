{
  "name": "context-engine",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_context_file": {
      "owner": "agent",
      "pre": "context_file_exists",
      "add": [
        "context_loaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_context_update": {
      "owner": "agent",
      "pre": "context_loaded",
      "add": [
        "context_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_context_file",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "update_context": [
            {
              "act": {
                "cap": "write_context_update",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": "context_loaded",
  "init_true": [
    "context_file_exists"
  ],
  "init_constraints": []
}
