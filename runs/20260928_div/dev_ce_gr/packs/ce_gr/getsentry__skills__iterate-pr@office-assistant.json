{
  "name": "iterate-pr",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "fix_feedback": {
      "owner": "agent",
      "pre": "feedback_fetched",
      "add": [
        "feedback_fixed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fix_ci_failures": {
      "owner": "agent",
      "pre": "checks_fetched",
      "add": [
        "ci_fixed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "identify_pr",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_checks",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_feedback",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fix_ci_failures",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fix_feedback",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "commit_and_push",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "monitor_loop",
        "body": [
          {
            "act": {
              "cap": "monitor_ci",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "checks_passed": [],
                "still_pending": [
                  {
                    "continue": "monitor_loop"
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "goal": {
    "and": [
      "ci_passed",
      "feedback_fixed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
