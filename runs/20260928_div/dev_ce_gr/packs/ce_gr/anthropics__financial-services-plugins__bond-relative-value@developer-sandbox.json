{
  "name": "bond-relative-value",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {},
  "protocol": [
    {
      "act": {
        "cap": "price_bond",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "get_rate_curve",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "get_credit_curve",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_scenarios",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "include_historical": [
            {
              "act": {
                "cap": "get_historical_context",
                "by": "agent"
              }
            }
          ],
          "skip_historical": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "bond_priced",
      "rate_curve_obtained",
      "credit_curve_obtained",
      "scenarios_run"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
