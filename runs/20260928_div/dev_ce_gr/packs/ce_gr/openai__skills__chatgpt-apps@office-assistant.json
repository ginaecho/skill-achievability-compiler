{
  "name": "chatgpt-apps",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "fetch_docs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "docs_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_server_scaffold": {
      "owner": "agent",
      "pre": "docs_fetched",
      "add": [
        "server_scaffolded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_widget_scaffold": {
      "owner": "agent",
      "pre": "docs_fetched",
      "add": [
        "widget_scaffolded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_locally": {
      "owner": "agent",
      "pre": {
        "and": [
          "server_scaffolded",
          "widget_scaffolded"
        ]
      },
      "add": [
        "validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "fetch_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_server_scaffold",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_widget_scaffold",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_locally",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "server_scaffolded",
      "widget_scaffolded",
      "validated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
