{
  "name": "brainstorming",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_questions": {
      "owner": "agent",
      "pre": true,
      "add": [
        "context_understood"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_design_doc": {
      "owner": "agent",
      "pre": "context_understood",
      "add": [
        "design_doc_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "commit_design_doc": {
      "owner": "agent",
      "pre": "design_doc_written",
      "add": [
        "design_doc_committed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "ask_questions",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "design_cycle",
        "body": [
          {
            "act": {
              "cap": "write_design_doc",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "user",
              "observed": true,
              "branches": {
                "approved": [
                  {
                    "act": {
                      "cap": "commit_design_doc",
                      "by": "agent"
                    }
                  }
                ],
                "changes_requested": [
                  {
                    "continue": "design_cycle"
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "goal": "design_doc_committed",
  "init_true": [],
  "init_constraints": []
}
