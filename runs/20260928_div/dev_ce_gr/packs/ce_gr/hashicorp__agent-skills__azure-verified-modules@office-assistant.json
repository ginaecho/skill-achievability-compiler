{
  "name": "azure-verified-modules",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "review_module": {
      "owner": "agent",
      "pre": true,
      "add": [
        "module_reviewed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fix_module_code": {
      "owner": "agent",
      "pre": "module_reviewed",
      "add": [
        "module_compliant"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "review_module",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fix_module_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_tests",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "module_compliant",
      "docs_generated",
      "tests_pass"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
