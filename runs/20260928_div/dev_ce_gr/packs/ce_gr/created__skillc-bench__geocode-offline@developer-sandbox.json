{
  "name": "geocode-offline",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "install_reverse_geocoder": {
      "owner": "agent",
      "pre": true,
      "add": [
        "package_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "geocode_points": {
      "owner": "agent",
      "pre": {
        "and": [
          "package_installed",
          "points_present"
        ]
      },
      "add": [
        "points_geocoded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_output": {
      "owner": "agent",
      "pre": "points_geocoded",
      "add": [
        "output_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_reverse_geocoder",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "geocode_points",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_output",
        "by": "agent"
      }
    }
  ],
  "goal": "output_written",
  "init_true": [
    "points_present"
  ],
  "init_constraints": []
}
