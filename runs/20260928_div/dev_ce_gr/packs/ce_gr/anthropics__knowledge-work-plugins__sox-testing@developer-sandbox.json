{
  "name": "sox-testing",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "identify_controls": {
      "owner": "agent",
      "pre": true,
      "add": [
        "controls_identified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_sample": {
      "owner": "agent",
      "pre": "controls_identified",
      "add": [
        "sample_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_workpaper": {
      "owner": "agent",
      "pre": "sample_generated",
      "add": [
        "workpaper_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "evaluate_deficiency": {
      "owner": "agent",
      "pre": "workpaper_created",
      "add": [
        "deficiency_evaluated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "identify_controls",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_sample",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_workpaper",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "exceptions_found": [
            {
              "act": {
                "cap": "evaluate_deficiency",
                "by": "agent"
              }
            }
          ],
          "no_exceptions": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "controls_identified",
      "sample_generated",
      "workpaper_created"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
