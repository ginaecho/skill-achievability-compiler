{
  "name": "imagegen",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "install_cli_deps": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:openai_account"
        ]
      },
      "add": [
        "cli_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "save_image": {
      "owner": "agent",
      "pre": "image_generated",
      "add": [
        "image_saved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "builtin_tool": [
            {
              "act": {
                "cap": "generate_image_builtin",
                "by": "agent"
              }
            }
          ],
          "cli_fallback": [
            {
              "act": {
                "cap": "install_cli_deps",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "generate_image_cli",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "save_image",
        "by": "agent"
      }
    }
  ],
  "goal": "image_saved",
  "init_true": [],
  "init_constraints": []
}
