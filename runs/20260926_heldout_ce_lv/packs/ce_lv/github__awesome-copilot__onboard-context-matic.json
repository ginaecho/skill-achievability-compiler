{
  "name": "onboard-context-matic",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "detect_language": {
      "owner": "agent",
      "pre": true,
      "add": [
        "language_detected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_user_choose_api": {
      "owner": "agent",
      "pre": "apis_fetched",
      "add": [
        "api_chosen"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_user_integration_goal": {
      "owner": "agent",
      "pre": "overview_given",
      "add": [
        "goal_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "detect_language",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_apis",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "no_api_available": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "apis_fetched",
      "overview_given",
      "integration_shown",
      "model_search_shown",
      "endpoint_search_shown"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
