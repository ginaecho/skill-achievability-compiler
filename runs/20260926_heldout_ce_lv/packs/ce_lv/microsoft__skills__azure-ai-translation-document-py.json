{
  "name": "azure-ai-translation-document-py",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "install_sdk": {
      "owner": "agent",
      "pre": true,
      "add": [
        "sdk_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_translation_script": {
      "owner": "agent",
      "pre": "sdk_installed",
      "add": [
        "script_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_translation_job": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_translation_resource",
          "needs:blob_storage_account",
          "script_written"
        ]
      },
      "add": [
        "translation_completed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "list_document_statuses": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_translation_resource",
          "translation_completed"
        ]
      },
      "add": [
        "statuses_listed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_sdk",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_translation_script",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_translation_job",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "list_document_statuses",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "translation_completed",
      "statuses_listed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
