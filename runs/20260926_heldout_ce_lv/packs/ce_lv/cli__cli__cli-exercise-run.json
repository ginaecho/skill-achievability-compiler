{
  "name": "cli-exercise-run",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "verify_checksum": {
      "owner": "agent",
      "pre": true,
      "add": [
        "checksum_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "start_run": {
      "owner": "agent",
      "pre": "checksum_verified",
      "add": [
        "run_started"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_setup": {
      "owner": "agent",
      "pre": "run_started",
      "add": [
        "setup_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_exercise": {
      "owner": "agent",
      "pre": "setup_done",
      "add": [
        "exercise_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_validation": {
      "owner": "agent",
      "pre": "exercise_done",
      "add": [
        "validation_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_cleanup": {
      "owner": "agent",
      "pre": "validation_done",
      "add": [
        "cleanup_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "finish_run": {
      "owner": "agent",
      "pre": "validation_done",
      "add": [
        "run_finished"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_report": {
      "owner": "agent",
      "pre": "run_finished",
      "add": [
        "report_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "verify_checksum",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "start_run",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_setup",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_exercise",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_validation",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "cleanup_approved": [
            {
              "act": {
                "cap": "run_cleanup",
                "by": "agent"
              }
            }
          ],
          "no_cleanup": []
        }
      }
    },
    {
      "act": {
        "cap": "finish_run",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_report",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "validation_done",
      "run_finished",
      "report_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
