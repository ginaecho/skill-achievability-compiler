{
  "name": "cloudflare",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_project": {
      "owner": "agent",
      "pre": true,
      "add": [
        "project_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_docs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "docs_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_change": {
      "owner": "agent",
      "pre": {
        "and": [
          "project_inspected",
          "docs_fetched"
        ]
      },
      "add": [
        "change_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_change": {
      "owner": "agent",
      "pre": "change_implemented",
      "add": [
        "change_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_worker": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:cloudflare_account",
          "change_validated"
        ]
      },
      "add": [
        "deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_project",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "implement_change",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_change",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "change_implemented",
      "change_validated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
