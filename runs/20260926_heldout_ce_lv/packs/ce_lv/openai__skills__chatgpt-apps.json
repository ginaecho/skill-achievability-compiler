{
  "name": "chatgpt-apps",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "fetch_docs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "docs_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scaffold_app": {
      "owner": "agent",
      "pre": "docs_fetched",
      "add": [
        "app_scaffolded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_local": {
      "owner": "agent",
      "pre": "app_scaffolded",
      "add": [
        "validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "expose_tunnel": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:tunnel_account",
          "validated"
        ]
      },
      "add": [
        "tunnel_exposed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_hosting": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:hosting_account",
          "validated"
        ]
      },
      "add": [
        "deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "fetch_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scaffold_app",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_local",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip_test": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip_deploy": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "app_scaffolded",
      "validated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
