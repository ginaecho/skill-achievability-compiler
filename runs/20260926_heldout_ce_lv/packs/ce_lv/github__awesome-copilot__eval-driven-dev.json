{
  "name": "eval-driven-dev",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "run_setup": {
      "owner": "agent",
      "pre": true,
      "add": [
        "setup_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_project_analysis": {
      "owner": "agent",
      "pre": "setup_done",
      "add": [
        "project_analysis_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_entry_point": {
      "owner": "agent",
      "pre": "project_analysis_written",
      "add": [
        "entry_point_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_eval_criteria": {
      "owner": "agent",
      "pre": "entry_point_written",
      "add": [
        "eval_criteria_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "instrument_app": {
      "owner": "agent",
      "pre": "eval_criteria_written",
      "add": [
        "app_instrumented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_runnable": {
      "owner": "agent",
      "pre": "app_instrumented",
      "add": [
        "runnable_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "capture_trace": {
      "owner": "agent",
      "pre": "runnable_written",
      "add": [
        "trace_captured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_evaluators": {
      "owner": "agent",
      "pre": "trace_captured",
      "add": [
        "evaluators_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_dataset": {
      "owner": "agent",
      "pre": "evaluators_written",
      "add": [
        "dataset_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_pixie_test": {
      "owner": "agent",
      "pre": "dataset_built",
      "add": [
        "tests_scored"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "analyze_outcomes": {
      "owner": "agent",
      "pre": "tests_scored",
      "add": [
        "analysis_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_user_for_help": {
      "owner": "agent",
      "pre": true,
      "add": [
        "help_requested"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "run_setup",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "setup_ok": [
            {
              "act": {
                "cap": "write_project_analysis",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "write_entry_point",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "write_eval_criteria",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "instrument_app",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "implement_runnable",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "capture_trace",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "implement_evaluators",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "build_dataset",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "run_pixie_test",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "analyze_outcomes",
                "by": "agent"
              }
            }
          ],
          "setup_failed": [
            {
              "act": {
                "cap": "ask_user_for_help",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "tests_scored",
      "analysis_done"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
