{
  "name": "foundry-agent-sync",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "scaffold_manifest": {
      "owner": "agent",
      "pre": true,
      "add": [
        "manifest_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scaffold_script": {
      "owner": "agent",
      "pre": "manifest_written",
      "add": [
        "script_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "collect_params": {
      "owner": "agent",
      "pre": true,
      "add": [
        "params_collected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "sync_agents": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          {
            "and": [
              "script_written",
              "params_collected"
            ]
          }
        ]
      },
      "add": [
        "agents_synced"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_agents": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "agents_synced"
        ]
      },
      "add": [
        "agents_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "scaffold_manifest",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scaffold_script",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "collect_params",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "manifest_written",
      "script_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
