{
  "name": "eas-workflows",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "fetch_schema": {
      "owner": "agent",
      "pre": true,
      "add": [
        "schema_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_workflow": {
      "owner": "agent",
      "pre": "schema_fetched",
      "add": [
        "workflow_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_workflow": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:expo_account",
          "workflow_written"
        ]
      },
      "add": [
        "workflow_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "fetch_schema",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_workflow",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_workflow",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "workflow_written",
      "workflow_validated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
