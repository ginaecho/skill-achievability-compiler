{
  "name": "sandbox-stable",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "inspect_project": {
      "owner": "agent",
      "pre": true,
      "add": [
        "project_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_docs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "docs_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_code": {
      "owner": "agent",
      "pre": {
        "and": [
          "project_inspected",
          "docs_fetched"
        ]
      },
      "add": [
        "code_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "typecheck": {
      "owner": "agent",
      "pre": "code_written",
      "add": [
        "typecheck_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:cloudflare_account",
          "typecheck_pass"
        ]
      },
      "add": [
        "deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_project",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "typecheck",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "code_written",
      "typecheck_pass"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
