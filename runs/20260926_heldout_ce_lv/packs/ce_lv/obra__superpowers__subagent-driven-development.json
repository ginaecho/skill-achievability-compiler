{
  "name": "subagent-driven-development",
  "roles": [
    "controller",
    "implementer",
    "reviewer"
  ],
  "capabilities": {
    "setup_worktree": {
      "owner": "controller",
      "pre": true,
      "add": [
        "worktree_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_brief": {
      "owner": "controller",
      "pre": "worktree_ready",
      "add": [
        "brief_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_task": {
      "owner": "implementer",
      "pre": "brief_written",
      "add": [
        "task_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "review_task": {
      "owner": "reviewer",
      "pre": "task_implemented",
      "add": [
        "task_reviewed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fix_task": {
      "owner": "implementer",
      "pre": "task_reviewed",
      "add": [
        "task_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "record_ledger": {
      "owner": "controller",
      "pre": "task_reviewed",
      "add": [
        "task_complete"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "final_review": {
      "owner": "reviewer",
      "pre": "task_complete",
      "add": [
        "branch_reviewed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "cleanup_workspace": {
      "owner": "controller",
      "pre": "branch_reviewed",
      "add": [
        "workspace_cleaned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "setup_worktree",
        "by": "controller"
      }
    },
    {
      "act": {
        "cap": "write_brief",
        "by": "controller"
      }
    },
    {
      "spawn": {
        "role": "implementer"
      }
    },
    {
      "act": {
        "cap": "implement_task",
        "by": "implementer"
      }
    },
    {
      "spawn": {
        "role": "reviewer"
      }
    },
    {
      "act": {
        "cap": "review_task",
        "by": "reviewer"
      }
    },
    {
      "rec": {
        "name": "fix_loop",
        "body": [
          {
            "choice": {
              "by": "controller",
              "observed": true,
              "branches": {
                "approved": [],
                "needs_fix": [
                  {
                    "act": {
                      "cap": "fix_task",
                      "by": "implementer"
                    }
                  },
                  {
                    "act": {
                      "cap": "review_task",
                      "by": "reviewer"
                    }
                  },
                  {
                    "continue": "fix_loop"
                  }
                ]
              }
            }
          }
        ]
      }
    },
    {
      "act": {
        "cap": "record_ledger",
        "by": "controller"
      }
    },
    {
      "act": {
        "cap": "final_review",
        "by": "reviewer"
      }
    },
    {
      "act": {
        "cap": "cleanup_workspace",
        "by": "controller"
      }
    }
  ],
  "goal": {
    "and": [
      "task_complete",
      "branch_reviewed",
      "workspace_cleaned"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
