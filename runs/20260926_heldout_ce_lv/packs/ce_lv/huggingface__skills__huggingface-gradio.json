{
  "name": "huggingface-gradio",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "write_app": {
      "owner": "agent",
      "pre": true,
      "add": [
        "app_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_deps": {
      "owner": "agent",
      "pre": true,
      "add": [
        "deps_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_app": {
      "owner": "agent",
      "pre": {
        "and": [
          "app_written",
          "deps_installed"
        ]
      },
      "add": [
        "app_running"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "share_app": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_sharing",
          "app_running"
        ]
      },
      "add": [
        "app_shared"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_app",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_deps",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_app",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "app_written",
      "deps_installed",
      "app_running"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
