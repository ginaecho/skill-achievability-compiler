{
  "name": "brainstorming",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_question": {
      "owner": "agent",
      "pre": true,
      "add": [
        "requirements_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_spec": {
      "owner": "agent",
      "pre": "requirements_gathered",
      "add": [
        "spec_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "commit_spec": {
      "owner": "agent",
      "pre": "spec_written",
      "add": [
        "spec_committed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "ask_question",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_spec",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "commit_spec",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "review",
        "body": [
          {
            "choice": {
              "by": "user",
              "observed": true,
              "branches": {
                "approved": [],
                "changes_requested": [
                  {
                    "act": {
                      "cap": "write_spec",
                      "by": "agent"
                    }
                  },
                  {
                    "act": {
                      "cap": "commit_spec",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "review"
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "goal": "spec_committed",
  "init_true": [],
  "init_constraints": []
}
