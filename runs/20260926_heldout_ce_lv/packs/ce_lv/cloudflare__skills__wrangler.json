{
  "name": "wrangler",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "inspect_project": {
      "owner": "agent",
      "pre": true,
      "add": [
        "project_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_docs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "docs_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "edit_config": {
      "owner": "agent",
      "pre": {
        "and": [
          "project_inspected",
          "docs_fetched"
        ]
      },
      "add": [
        "config_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "regen_types": {
      "owner": "agent",
      "pre": "config_updated",
      "add": [
        "types_regenerated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_tests": {
      "owner": "agent",
      "pre": "types_regenerated",
      "add": [
        "tests_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "dry_run_deploy": {
      "owner": "agent",
      "pre": "tests_pass",
      "add": [
        "dry_run_ok"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:cloudflare_account",
          "dry_run_ok"
        ]
      },
      "add": [
        "deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_project",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "edit_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "regen_types",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_tests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "dry_run_deploy",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "config_updated",
      "dry_run_ok"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
