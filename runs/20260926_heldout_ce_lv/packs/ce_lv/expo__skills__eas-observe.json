      "owner": "agent",
      "pre": true,
      "add": [
        "package_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "wrap_root_layout": {
      "owner": "agent",
      "pre": "package_installed",
      "add": [
        "root_wrapped"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "mark_interactive": {
      "owner": "agent",
      "pre": "root_wrapped",
      "add": [
        "interactive_marked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_runtime": {
