{
  "name": "entra-app-registration",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_user_requirements": {
      "owner": "agent",
      "pre": true,
      "add": [
        "requirements_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "register_app": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "requirements_known"
        ]
      },
      "add": [
        "app_registered",
        "service_principal_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_auth": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "app_registered"
        ]
      },
      "add": [
        "auth_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_permissions": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "app_registered"
        ]
      },
      "add": [
        "permissions_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_credentials": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "app_registered"
        ]
      },
      "add": [
        "credentials_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_oauth_code": {
      "owner": "agent",
      "pre": "app_registered",
      "add": [
        "oauth_code_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "ask_user_requirements",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "register_app",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_auth",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_permissions",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "no_credentials": []
        }
      }
    },
    {
      "act": {
        "cap": "implement_oauth_code",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "app_registered",
      "auth_configured",
      "permissions_configured",
      "oauth_code_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
