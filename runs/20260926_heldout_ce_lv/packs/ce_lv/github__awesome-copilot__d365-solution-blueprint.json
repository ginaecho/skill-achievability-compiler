{
  "name": "d365-solution-blueprint",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "verify_docs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "docs_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "draft_track_a": {
      "owner": "agent",
      "pre": true,
      "add": [
        "track_a_drafted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "save_blueprint": {
      "owner": "agent",
      "pre": "track_a_drafted",
      "add": [
        "blueprint_saved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "draft_other_track": {
      "owner": "agent",
      "pre": "track_a_drafted",
      "add": [
        "other_track_drafted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "verify_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "draft_track_a",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "save_blueprint",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "continue_other_tracks": [
            {
              "act": {
                "cap": "draft_other_track",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "save_blueprint",
                "by": "agent"
              }
            }
          ],
          "stop": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "track_a_drafted",
      "blueprint_saved"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
