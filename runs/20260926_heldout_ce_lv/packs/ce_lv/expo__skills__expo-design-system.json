{
  "name": "expo-design-system",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "detect_existing_system": {
      "owner": "agent",
      "pre": true,
      "add": [
        "system_detected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_theme_files": {
      "owner": "agent",
      "pre": "system_detected",
      "add": [
        "theme_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_components": {
      "owner": "agent",
      "pre": "theme_written",
      "add": [
        "components_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "submit_feedback": {
      "owner": "agent",
      "pre": "components_written",
      "add": [
        "feedback_submitted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "detect_existing_system",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_theme_files",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_components",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "submit_feedback": [
            {
              "act": {
                "cap": "submit_feedback",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "theme_written",
      "components_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
