{
  "name": "playwright-interactive",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "install_playwright": {
      "owner": "agent",
      "pre": true,
      "add": [
        "playwright_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "start_dev_server": {
      "owner": "agent",
      "pre": true,
      "add": [
        "server_running"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "launch_browser": {
      "owner": "agent",
      "pre": {
        "and": [
          "playwright_installed",
          "server_running"
        ]
      },
      "add": [
        "browser_launched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_functional_qa": {
      "owner": "agent",
      "pre": "browser_launched",
      "add": [
        "functional_qa_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_visual_qa": {
      "owner": "agent",
      "pre": "browser_launched",
      "add": [
        "visual_qa_pass",
        "screenshots_captured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "cleanup_session": {
      "owner": "agent",
      "pre": "browser_launched",
      "add": [],
      "del": [
        "browser_launched"
      ],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_playwright",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "start_dev_server",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "launch_browser",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_functional_qa",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_visual_qa",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "cleanup": [
            {
              "act": {
                "cap": "cleanup_session",
                "by": "agent"
              }
            }
          ],
          "keep_alive": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "functional_qa_pass",
      "visual_qa_pass",
      "screenshots_captured"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
