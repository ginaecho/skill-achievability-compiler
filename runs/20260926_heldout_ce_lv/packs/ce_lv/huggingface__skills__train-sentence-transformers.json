{
  "name": "train-sentence-transformers",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "install_deps": {
      "owner": "agent",
      "pre": true,
      "add": [
        "deps_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "copy_template": {
      "owner": "agent",
      "pre": "deps_installed",
      "add": [
        "script_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "smoke_test": {
      "owner": "agent",
      "pre": "script_written",
      "add": [
        "smoke_test_passed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_training": {
      "owner": "agent",
      "pre": "smoke_test_passed",
      "add": [
        "model_trained"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "push_to_hub": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:huggingface_account",
          "model_trained"
        ]
      },
      "add": [
        "model_pushed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_deps",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "copy_template",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "smoke_test",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_training",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip": []
        }
      }
    }
  ],
  "goal": "model_trained",
  "init_true": [],
  "init_constraints": []
}
