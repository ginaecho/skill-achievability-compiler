{
  "name": "foundry-agent-sync",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "locate_manifest": {
      "owner": "agent",
      "pre": true,
      "add": [
        "manifest_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_agent_specs": {
      "owner": "agent",
      "pre": "manifest_checked",
      "add": [
        "specs_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scaffold_manifest": {
      "owner": "agent",
      "pre": "specs_known",
      "add": [
        "manifest_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "locate_script": {
      "owner": "agent",
      "pre": "manifest_checked",
      "add": [
        "script_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scaffold_script": {
      "owner": "agent",
      "pre": "script_checked",
      "add": [
        "script_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "collect_params": {
      "owner": "agent",
      "pre": "script_checked",
      "add": [
        "params_collected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_sync": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "params_collected"
        ]
      },
      "add": [
        "agents_synced"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_agents": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_account",
          "agents_synced"
        ]
      },
      "add": [
        "agents_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "locate_manifest",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "manifest_found": [],
          "manifest_missing": [
            {
              "act": {
                "cap": "ask_agent_specs",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "scaffold_manifest",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "locate_script",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "script_found": [],
          "script_missing": [
            {
              "act": {
                "cap": "scaffold_script",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "collect_params",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_sync",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "skip_verify": []
        }
      }
    }
  ],
  "goal": "agents_synced",
  "init_true": [],
  "init_constraints": []
}
