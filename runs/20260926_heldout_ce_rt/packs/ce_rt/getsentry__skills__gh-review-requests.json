{
  "name": "gh-review-requests",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_team": {
      "owner": "agent",
      "pre": true,
      "add": [
        "team_identified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_fetch_script": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_account",
          "team_identified"
        ]
      },
      "add": [
        "results_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fallback_gh_api": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:github_account",
          "team_identified"
        ]
      },
      "add": [
        "results_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "team_given": [
            {
              "act": {
                "cap": "ask_team",
                "by": "agent"
              }
            }
          ],
          "team_missing": [
            {
              "act": {
                "cap": "ask_team",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "script_succeeds": [
            {
              "act": {
                "cap": "run_fetch_script",
                "by": "agent"
              }
            }
          ],
          "script_fails": [
            {
              "act": {
                "cap": "fallback_gh_api",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": "results_fetched",
  "init_true": [],
  "init_constraints": []
}
