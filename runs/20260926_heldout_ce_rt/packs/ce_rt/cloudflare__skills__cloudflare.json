{
  "name": "cloudflare",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "inspect_project": {
      "owner": "agent",
      "pre": true,
      "add": [
        "project_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_docs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "docs_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_change": {
      "owner": "agent",
      "pre": {
        "and": [
          "project_inspected",
          "docs_fetched"
        ]
      },
      "add": [
        "change_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_change": {
      "owner": "agent",
      "pre": "change_implemented",
      "add": [
        "change_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_project",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "implement_change",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_change",
        "by": "agent"
      }
    }
  ],
  "goal": "change_validated",
  "init_true": [],
  "init_constraints": []
}
