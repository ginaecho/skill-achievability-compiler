{
  "name": "azure-ai-translation-document-py",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "install_package": {
      "owner": "agent",
      "pre": true,
      "add": [
        "package_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "begin_translation": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:azure_translation_account",
          "package_installed"
        ]
      },
      "add": [
        "translation_started"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "wait_translation_result": {
      "owner": "agent",
      "pre": "translation_started",
      "add": [
        "translation_complete"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_package",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "begin_translation",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "wait_translation_result",
        "by": "agent"
      }
    }
  ],
  "goal": "translation_complete",
  "init_true": [],
  "init_constraints": []
}
