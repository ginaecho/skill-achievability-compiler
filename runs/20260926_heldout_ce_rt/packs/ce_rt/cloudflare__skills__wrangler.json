{
  "name": "wrangler",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "inspect_project": {
      "owner": "agent",
      "pre": true,
      "add": [
        "project_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_docs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "docs_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "edit_config": {
      "owner": "agent",
      "pre": {
        "and": [
          "project_inspected",
          "docs_fetched"
        ]
      },
      "add": [
        "config_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_dry_run": {
      "owner": "agent",
      "pre": "config_updated",
      "add": [
        "validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_project",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "edit_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_dry_run",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "project_inspected",
      "docs_fetched",
      "config_updated",
      "validated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
