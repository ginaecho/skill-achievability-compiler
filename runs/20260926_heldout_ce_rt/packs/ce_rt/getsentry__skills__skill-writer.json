{
  "name": "skill-writer",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_workspace": {
      "owner": "agent",
      "pre": true,
      "add": [
        "workspace_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_target_location": {
      "owner": "agent",
      "pre": "workspace_inspected",
      "add": [
        "target_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_skill_md": {
      "owner": "agent",
      "pre": "workspace_inspected",
      "add": [
        "skill_md_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_spec_md": {
      "owner": "agent",
      "pre": "skill_md_written",
      "add": [
        "spec_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "register_skill": {
      "owner": "agent",
      "pre": "skill_md_written",
      "add": [
        "skill_registered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_validation": {
      "owner": "agent",
      "pre": "skill_registered",
      "add": [
        "validation_run"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_workspace",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "location_unclear": [
            {
              "act": {
                "cap": "ask_target_location",
                "by": "agent"
              }
            }
          ],
          "location_clear": []
        }
      }
    },
    {
      "act": {
        "cap": "write_skill_md",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "spec_needed": [
            {
              "act": {
                "cap": "write_spec_md",
                "by": "agent"
              }
            }
          ],
          "spec_not_needed": []
        }
      }
    },
    {
      "act": {
        "cap": "register_skill",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_validation",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "skill_md_written",
      "skill_registered",
      "validation_run"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
