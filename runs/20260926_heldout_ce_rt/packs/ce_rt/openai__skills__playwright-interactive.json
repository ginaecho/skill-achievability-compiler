{
  "name": "playwright-interactive",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "setup_playwright": {
      "owner": "agent",
      "pre": true,
      "add": [
        "playwright_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "start_dev_server": {
      "owner": "agent",
      "pre": true,
      "add": [
        "dev_server_running"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "launch_browser_session": {
      "owner": "agent",
      "pre": {
        "and": [
          "playwright_installed",
          "dev_server_running"
        ]
      },
      "add": [
        "session_active"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_functional_qa": {
      "owner": "agent",
      "pre": "session_active",
      "add": [
        "functional_qa_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_visual_qa": {
      "owner": "agent",
      "pre": "functional_qa_done",
      "add": [
        "visual_qa_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "capture_screenshots": {
      "owner": "agent",
      "pre": "visual_qa_done",
      "add": [
        "screenshots_captured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "cleanup_session": {
      "owner": "agent",
      "pre": "session_active",
      "add": [
        "session_closed"
      ],
      "del": [
        "session_active"
      ],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "setup_playwright",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "start_dev_server",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "launch_browser_session",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_functional_qa",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_visual_qa",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "capture_screenshots",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "task_finished": [
            {
              "act": {
                "cap": "cleanup_session",
                "by": "agent"
              }
            }
          ],
          "keep_session_alive": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "functional_qa_done",
      "visual_qa_done",
      "screenshots_captured"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
