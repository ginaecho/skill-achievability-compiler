{
  "name": "new-terraform-provider",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "confirm_new_workspace": {
      "owner": "agent",
      "pre": true,
      "add": [
        "confirmation_asked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_workspace": {
      "owner": "agent",
      "pre": true,
      "add": [
        "workspace_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "init_go_module": {
      "owner": "agent",
      "pre": "workspace_created",
      "add": [
        "module_initialized"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "get_plugin_framework": {
      "owner": "agent",
      "pre": "module_initialized",
      "add": [
        "framework_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_main_go": {
      "owner": "agent",
      "pre": "framework_fetched",
      "add": [
        "main_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_provider_go": {
      "owner": "agent",
      "pre": "framework_fetched",
      "add": [
        "provider_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "remove_todos": {
      "owner": "agent",
      "pre": {
        "and": [
          "main_written",
          "provider_written"
        ]
      },
      "add": [
        "todos_removed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "go_mod_tidy": {
      "owner": "agent",
      "pre": "todos_removed",
      "add": [
        "mod_tidied"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "go_build": {
      "owner": "agent",
      "pre": "mod_tidied",
      "add": [
        "build_ok"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "go_test": {
      "owner": "agent",
      "pre": "build_ok",
      "add": [
        "tests_ok"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "already_in_workspace": [
            {
              "act": {
                "cap": "confirm_new_workspace",
                "by": "agent"
              }
            }
          ],
          "fresh_start": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "proceed": [
            {
              "act": {
                "cap": "create_workspace",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "init_go_module",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "get_plugin_framework",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "write_main_go",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "write_provider_go",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "remove_todos",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "go_mod_tidy",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "go_build",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "go_test",
                "by": "agent"
              }
            }
          ],
          "abort": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "main_written",
      "provider_written",
      "build_ok",
      "tests_ok"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
