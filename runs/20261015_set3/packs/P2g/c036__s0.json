                                        }
                                      },
                                      {
                                        "act": {
                                          "cap": "send_post_install_guidance",
                                          "by": "agent"
                                        }
                                      }
                                    ],
                                    "decline_install": []
                                  }
                                }
                              }
                            ],
                            "no_strong_match": [
                              {
                                "act": {
                                  "cap": "report_no_catalog_match",
                                  "by": "agent"
                                }
                              }
                            ]
                          }
                        }
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
