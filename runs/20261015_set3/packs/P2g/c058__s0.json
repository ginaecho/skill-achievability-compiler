          "branches": {
            "no_material_ambiguity": [],
            "material_ambiguity_present": [
              {
                "act": {
                  "cap": "ask_for_interpretation",
                  "by": "agent"
                }
              }
            ]
          }
        }
      },
      {
        "choice": {
          "by": "agent",
