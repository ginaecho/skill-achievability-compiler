          ]
        },
        "add": [
          "human_escalated"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      }
    },
    "protocol": [
      {
        "act": {
          "cap": "read_state_and_inputs",
          "by": "agent"
        }
      },
      {
        "choice": {
          "by": "agent",
          "observed": true,
          "branches": {
            "backend_task": [
              {
                "act": {
