        "assigns": {},
        "nondet": {}
      },
      "update_state_completed": {
        "owner": "agent",
        "pre": "qa_report_written",
        "add": [
          "state_updated",
          "playwright_completed",
          "stage_complete"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "route_failure_to_developer": {
        "owner": "agent",
        "pre": "tests_executed",
        "add": [
          "developer_routed"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "escalate_to_human": {
        "owner": "agent",
        "pre": {
          "and": [
            "tests_executed",
