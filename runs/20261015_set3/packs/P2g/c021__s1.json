{
  "pack": {
    "name": "preset",
    "roles": [
      "agent",
      "user"
    ],
    "capabilities": {
      "check_azure_auth": {
        "owner": "agent",
        "pre": "azure_cli_available",
        "add": [
          "authenticated"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "get_project": {
        "owner": "agent",
        "pre": {
          "and": [
            "authenticated",
            "project_id_available"
          ]
        },
        "add": [
          "project_verified",
          "current_region_known"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "list_models": {
        "owner": "agent",
        "pre": "project_verified",
        "add": [
          "models_listed"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "record_model_selection": {
        "owner": "agent",
        "pre": "models_listed",
        "add": [
          "model_selected",
          "version_selected"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "check_current_region_capacity": {
        "owner": "agent",
        "pre": {
          "and": [
            "project_verified",
            "current_region_known",
            "model_selected",
            "version_selected"
          ]
        },
        "add": [
          "current_region_has_capacity"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "query_all_regions_capacity": {
        "owner": "agent",
        "pre": {
          "and": [
            "project_verified",
            "model_selected",
            "version_selected"
          ]
        },
        "add": [
          "alternatives_shown"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "filter_projects_by_region": {
        "owner": "agent",
        "pre": {
          "and": [
            "authenticated",
            "region_selected"
          ]
        },
        "add": [
          "project_in_selected_region_found"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "deploy_model": {
        "owner": "agent",
        "pre": {
          "and": [
            "model_selected",
            "version_selected",
            {
              "or": [
                "current_region_has_capacity",
                "project_in_selected_region_found"
              ]
            }
          ]
        },
        "add": [
          "deployment_created",
          "globalstandard_used"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "monitor_deployment": {
        "owner": "agent",
        "pre": "deployment_created",
        "add": [
          "deployment_succeeded"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      }
    },
    "protocol": [
      {
        "act": {
          "cap": "check_azure_auth",
          "by": "agent"
        }
      },
      {
        "act": {
          "cap": "get_project",
          "by": "agent"
        }
      },
      {
        "act": {
          "cap": "list_models",
          "by": "agent"
        }
      },
      {
        "act": {
          "cap": "record_model_selection",
          "by": "agent"
        }
      },
      {
        "choice": {
          "by": "agent",
          "observed": true,
          "branches": {
            "current_region_has_capacity": [
              {
                "act": {
                  "cap": "check_current_region_capacity",
                  "by": "agent"
                }
              },
              {
                "act": {
                  "cap": "deploy_model",
                  "by": "agent"
                }
              },
              {
                "act": {
                  "cap": "monitor_deployment",
                  "by": "agent"
                }
              }
            ],
            "no_current_region_capacity": [
              {
                "act": {
                  "cap": "query_all_regions_capacity",
                  "by": "agent"
                }
              },
              {
                "choice": {
                  "by": "user",
                  "observed": true,
                  "branches": {
                    "use_existing_project_in_selected_region": [
                      {
                        "act": {
                          "cap": "filter_projects_by_region",
                          "by": "agent"
                        }
                      },
                      {
                        "act": {
                          "cap": "deploy_model",
                          "by": "agent"
                        }
                      },
                      {
                        "act": {
                          "cap": "monitor_deployment",
                          "by": "agent"
                        }
                      }
                    ],
                    "skip": []
                  }
                }
              }
            ]
          }
        }
      }
    ],
    "goal": {
      "and": [
        "deployment_succeeded",
        "globalstandard_used"
      ]
    },
    "init_true": [
      "azure_cli_available",
      "project_id_available"
    ],
    "init_constraints": []
  },
