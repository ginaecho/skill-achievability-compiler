                "act": {
                  "cap": "ask_clarifications",
                  "by": "agent"
                }
              },
              {
                "act": {
                  "cap": "ask_stage_transition",
                  "by": "agent"
                }
              },
              {
                "act": {
                  "cap": "create_doc_file",
                  "by": "agent"
                }
              },
              {
                "act": {
                  "cap": "update_doc_section",
                  "by": "agent"
                }
              },
              {
                "act": {
