                  "by": "agent"
                }
              },
              {
                "act": {
                  "cap": "test_doc_with_subagent",
                  "by": "agent"
                }
              },
              {
                "act": {
                  "cap": "ask_final_review_choice",
                  "by": "agent"
                }
              },
              {
                "choice": {
                  "by": "user",
                  "observed": true,
                  "branches": {
                    "want_final_review": [
                      {
                        "act": {
                          "cap": "review_full_doc",
                          "by": "agent"
                        }
                      }
                    ],
                    "done": []
                  }
                }
              }
            ]
          }
        }
      }
    ],
    "goal": {
      "or": [
        "freeform_mode",
        {
          "and": [
            "workflow_used",
            "context_sufficient",
            "doc_exists",
            "all_sections_completed",
