{
  "roles": [
    "agent"
  ],
  "goal": {
    "and": [
      "status_recorded",
      {
        "not": "app_running"
      }
    ]
  },
  "capabilities": {
    "aspire_start": {
      "pre": "process_permission",
      "add": [
        "app_running"
      ],
      "owner": "agent"
    },
    "aspire_wait": {
      "pre": "app_running",
      "add": [
        "resource_ready"
      ],
      "owner": "agent"
    },
    "aspire_describe": {
      "pre": {
        "and": [
          "resource_ready",
          "app_running"
        ]
      },
      "add": [
        "status_recorded"
      ],
      "owner": "agent"
    },
    "aspire_stop": {
      "pre": "app_running",
      "del": [
        "app_running",
        "resource_ready"
      ],
      "owner": "agent"
    }
  },
  "init_true": [
    "process_permission"
  ],
  "init_constraints": []
}
