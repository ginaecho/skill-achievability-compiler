{
  "name": "brainstorming",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "explore_context": {
      "owner": "agent",
      "pre": true,
      "add": [
        "context_explored"
      ]
    },
    "present_probe": {
      "owner": "agent",
      "pre": "context_explored",
      "add": [
        "probe_presented"
      ]
    },
    "investigate": {
      "owner": "agent",
      "pre": "probe_presented",
      "add": [
        "investigation_done"
      ]
    },
    "report_findings": {
      "owner": "agent",
      "pre": "investigation_done",
      "add": [
        "findings_reported"
      ]
    },
    "ask_clarifying_questions": {
      "owner": "agent",
      "pre": "context_explored",
      "add": [
        "questions_asked"
      ]
    },
    "present_bounded_design": {
      "owner": "agent",
      "pre": "questions_asked",
      "add": [
        "bounded_design_presented"
      ]
    },
    "implement_bounded": {
      "owner": "agent",
      "pre": "bounded_design_presented",
      "add": [
        "bounded_implemented"
      ]
    },
    "propose_approaches": {
      "owner": "agent",
      "pre": "questions_asked",
      "add": [
        "approaches_proposed"
      ]
    },
    "present_design_sections": {
      "owner": "agent",
      "pre": "approaches_proposed",
      "add": [
        "design_presented"
      ]
    },
    "write_design_doc": {
      "owner": "agent",
      "pre": "design_presented",
      "add": [
        "design_doc_written"
      ]
    },
    "spec_self_review": {
      "owner": "agent",
      "pre": "design_doc_written",
      "add": [
        "spec_reviewed"
      ]
    },
    "invoke_writing_plans": {
      "owner": "agent",
      "pre": "spec_reviewed",
      "add": [
        "plan_invoked"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "spike": [
            {
              "act": {
                "cap": "explore_context",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "present_probe",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "approved": [
                    {
                      "act": {
                        "cap": "investigate",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "report_findings",
                        "by": "agent"
                      }
                    }
                  ],
                  "declined": []
                }
              }
            }
          ],
          "bounded": [
            {
              "act": {
                "cap": "explore_context",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "ask_clarifying_questions",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "present_bounded_design",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "approved": [
                    {
                      "act": {
                        "cap": "implement_bounded",
                        "by": "agent"
                      }
                    }
                  ],
                  "declined": []
                }
              }
            }
          ],
          "architectural": [
            {
              "act": {
                "cap": "explore_context",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "ask_clarifying_questions",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "propose_approaches",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "present_design_sections",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "approved": [
                    {
                      "act": {
                        "cap": "write_design_doc",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "spec_self_review",
                        "by": "agent"
                      }
                    },
                    {
                      "choice": {
                        "by": "user",
                        "observed": true,
                        "branches": {
                          "approved": [
                            {
                              "act": {
                                "cap": "invoke_writing_plans",
                                "by": "agent"
                              }
                            }
                          ],
                          "changes_requested": []
                        }
                      }
                    }
                  ],
                  "declined": []
                }
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "or": [
      "findings_reported",
      "bounded_implemented",
      "plan_invoked"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
