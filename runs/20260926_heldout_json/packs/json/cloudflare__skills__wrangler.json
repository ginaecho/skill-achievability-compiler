{
  "name": "wrangler",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "inspect_project": {
      "owner": "agent",
      "pre": true,
      "add": [
        "project_inspected"
      ]
    },
    "fetch_docs": {
      "owner": "agent",
      "pre": "project_inspected",
      "add": [
        "docs_fetched"
      ]
    },
    "edit_config": {
      "owner": "agent",
      "pre": "docs_fetched",
      "add": [
        "config_edited"
      ]
    },
    "validate_config": {
      "owner": "agent",
      "pre": "config_edited",
      "add": [
        "config_validated"
      ]
    },
    "report_results": {
      "owner": "agent",
      "pre": "config_validated",
      "add": [
        "reported"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_project",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_docs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "edit_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "report_results",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "config_validated",
      "reported"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
