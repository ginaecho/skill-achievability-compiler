{
  "name": "eas-observe",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "install_expo_observe": {
      "owner": "agent",
      "add": [
        "observe_installed"
      ]
    },
    "wrap_root_layout": {
      "owner": "agent",
      "pre": "observe_installed",
      "add": [
        "root_wrapped"
      ]
    },
    "mark_interactive": {
      "owner": "agent",
      "pre": "root_wrapped",
      "add": [
        "interactive_marked"
      ]
    },
    "query_metrics": {
      "owner": "agent",
      "pre": "interactive_marked",
      "add": [
        "metrics_queried"
      ]
    },
    "interpret_metrics": {
      "owner": "agent",
      "pre": "metrics_queried",
      "add": [
        "metrics_interpreted"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_expo_observe",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "wrap_root_layout",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "mark_interactive",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "query_metrics",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "interpret_metrics",
        "by": "agent"
      }
    }
  ],
  "goal": "metrics_interpreted",
  "init_true": [],
  "init_constraints": []
}
