{
  "name": "new-terraform-provider",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "create_workspace": {
      "owner": "agent",
      "pre": true,
      "add": [
        "workspace_created"
      ]
    },
    "init_go_module": {
      "owner": "agent",
      "pre": "workspace_created",
      "add": [
        "go_module_initialized"
      ]
    },
    "get_plugin_framework": {
      "owner": "agent",
      "pre": "go_module_initialized",
      "add": [
        "framework_added"
      ]
    },
    "write_main_go": {
      "owner": "agent",
      "pre": "framework_added",
      "add": [
        "main_go_written"
      ]
    },
    "write_provider_go": {
      "owner": "agent",
      "pre": "framework_added",
      "add": [
        "provider_go_written"
      ]
    },
    "remove_todos": {
      "owner": "agent",
      "pre": {
        "and": [
          "main_go_written",
          "provider_go_written"
        ]
      },
      "add": [
        "todos_removed"
      ]
    },
    "go_mod_tidy": {
      "owner": "agent",
      "pre": "todos_removed",
      "add": [
        "mod_tidy_done"
      ]
    },
    "go_build": {
      "owner": "agent",
      "pre": "mod_tidy_done",
      "add": [
        "build_success"
      ]
    },
    "go_test": {
      "owner": "agent",
      "pre": "build_success",
      "add": [
        "test_pass"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "create_workspace",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "init_go_module",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "get_plugin_framework",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_main_go",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_provider_go",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "remove_todos",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "go_mod_tidy",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "go_build",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "go_test",
        "by": "agent"
      }
    }
  ],
  "goal": "test_pass",
  "init_true": [],
  "init_constraints": []
}
