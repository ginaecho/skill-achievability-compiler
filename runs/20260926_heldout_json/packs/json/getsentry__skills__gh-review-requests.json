{
  "name": "gh-review-requests",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_team": {
      "owner": "agent",
      "pre": true,
      "add": [
        "team_known"
      ]
    },
    "run_fetch_script": {
      "owner": "agent",
      "pre": "team_known",
      "add": [
        "script_run"
      ]
    },
    "parse_script_output": {
      "owner": "agent",
      "pre": "script_run",
      "add": [
        "results_obtained"
      ]
    },
    "fallback_manual_check": {
      "owner": "agent",
      "pre": "script_run",
      "add": [
        "results_obtained"
      ]
    },
    "present_results": {
      "owner": "agent",
      "pre": "results_obtained",
      "add": [
        "results_presented"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "ask_team",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_fetch_script",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "observed": true,
        "branches": {
          "success": [
            {
              "act": {
                "cap": "parse_script_output",
                "by": "agent"
              }
            }
          ],
          "failure": [
            {
              "act": {
                "cap": "fallback_manual_check",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "present_results",
        "by": "agent"
      }
    }
  ],
  "goal": "results_presented",
  "init_true": [],
  "init_constraints": []
}
