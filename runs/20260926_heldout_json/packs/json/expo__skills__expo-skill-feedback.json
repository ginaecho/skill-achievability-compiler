{
  "name": "expo-skill-feedback",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "submit_feedback": {
      "owner": "agent",
      "pre": true,
      "add": [
        "feedback_submitted"
      ]
    },
    "submit_eval_candidate": {
      "owner": "agent",
      "pre": true,
      "add": [
        "eval_submitted"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "branches": {
          "general_feedback": [
            {
              "act": {
                "cap": "submit_feedback",
                "by": "agent"
              }
            }
          ],
          "eval_candidate": [
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "approve": [
                    {
                      "act": {
                        "cap": "submit_eval_candidate",
                        "by": "agent"
                      }
                    }
                  ],
                  "reject": []
                }
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "or": [
      "feedback_submitted",
      "eval_submitted"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
