{
  "name": "azure-ai-translation-document-py",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "create_client": {
      "owner": "agent",
      "add": [
        "client_ready"
      ]
    },
    "begin_translation": {
      "owner": "agent",
      "pre": "client_ready",
      "add": [
        "translation_started"
      ]
    },
    "get_result": {
      "owner": "agent",
      "pre": "translation_started",
      "add": [
        "translation_completed"
      ]
    },
    "check_status": {
      "owner": "agent",
      "pre": "translation_started",
      "add": [
        "status_checked"
      ]
    },
    "cancel_translation": {
      "owner": "agent",
      "pre": "translation_started",
      "add": [
        "translation_cancelled"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "create_client",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "begin_translation",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "get_result",
        "by": "agent"
      }
    }
  ],
  "goal": "translation_completed",
  "init_true": [],
  "init_constraints": []
}
