{
  "name": "entra-app-registration",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "register_app": {
      "owner": "agent",
      "add": [
        "app_registered"
      ]
    },
    "configure_auth": {
      "owner": "agent",
      "pre": "app_registered",
      "add": [
        "auth_configured"
      ]
    },
    "configure_permissions": {
      "owner": "agent",
      "pre": "app_registered",
      "add": [
        "permissions_configured"
      ]
    },
    "create_credentials": {
      "owner": "agent",
      "pre": "app_registered",
      "add": [
        "credentials_created"
      ]
    },
    "implement_oauth": {
      "owner": "agent",
      "pre": {
        "and": [
          "auth_configured",
          "permissions_configured",
          "credentials_created"
        ]
      },
      "add": [
        "oauth_implemented"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "register_app",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_auth",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_permissions",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_credentials",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "implement_oauth",
        "by": "agent"
      }
    }
  ],
  "goal": "oauth_implemented",
  "init_true": [],
  "init_constraints": []
}
