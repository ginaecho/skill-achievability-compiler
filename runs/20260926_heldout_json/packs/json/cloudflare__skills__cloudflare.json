{
  "name": "cloudflare-product-discovery",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "gather_requirements": {
      "owner": "agent",
      "add": [
        "requirements_known"
      ]
    },
    "recommend_products": {
      "owner": "agent",
      "pre": "requirements_known",
      "add": [
        "products_recommended"
      ]
    },
    "load_reference": {
      "owner": "agent",
      "pre": "products_recommended",
      "add": [
        "guidance_loaded"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "gather_requirements",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "recommend_products",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "load_reference",
        "by": "agent"
      }
    }
  ],
  "goal": "guidance_loaded",
  "init_true": [],
  "init_constraints": []
}
