{
  "name": "pydantic-models-py",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "create_models": {
      "owner": "agent",
      "add": [
        "models_created"
      ]
    },
    "export_models": {
      "owner": "agent",
      "pre": "models_created",
      "add": [
        "models_exported"
      ]
    },
    "add_ts_types": {
      "owner": "agent",
      "pre": "models_exported",
      "add": [
        "ts_types_added"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "create_models",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "export_models",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "add_ts_types",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "models_created",
      "models_exported",
      "ts_types_added"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
