{
  "name": "foundry-agent-sync",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "locate_or_scaffold_manifest": {
      "owner": "agent",
      "pre": true,
      "add": [
        "manifest_ready"
      ]
    },
    "locate_or_scaffold_script": {
      "owner": "agent",
      "pre": true,
      "add": [
        "script_ready"
      ]
    },
    "collect_params": {
      "owner": "agent",
      "pre": true,
      "add": [
        "params_collected"
      ]
    },
    "run_sync_script": {
      "owner": "agent",
      "pre": {
        "and": [
          "manifest_ready",
          "script_ready",
          "params_collected"
        ]
      },
      "add": [
        "agents_synced"
      ]
    },
    "verify_agents": {
      "owner": "agent",
      "pre": "agents_synced",
      "add": [
        "agents_verified"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "locate_or_scaffold_manifest",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "locate_or_scaffold_script",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "collect_params",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_sync_script",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_agents",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "agents_synced",
      "agents_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
