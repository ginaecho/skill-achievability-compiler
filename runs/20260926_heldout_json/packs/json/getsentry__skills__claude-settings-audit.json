{
  "name": "claude-settings-audit",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "detect_tech_stack": {
      "owner": "agent",
      "pre": true,
      "add": [
        "tech_stack_detected"
      ]
    },
    "detect_services": {
      "owner": "agent",
      "pre": "tech_stack_detected",
      "add": [
        "services_detected"
      ]
    },
    "check_existing_settings": {
      "owner": "agent",
      "pre": true,
      "add": [
        "existing_settings_checked"
      ]
    },
    "generate_recommendations": {
      "owner": "agent",
      "pre": {
        "and": [
          "tech_stack_detected",
          "services_detected",
          "existing_settings_checked"
        ]
      },
      "add": [
        "recommendations_generated"
      ]
    },
    "present_output": {
      "owner": "agent",
      "pre": "recommendations_generated",
      "add": [
        "output_presented"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "detect_tech_stack",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "detect_services",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_existing_settings",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_recommendations",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "present_output",
        "by": "agent"
      }
    }
  ],
  "goal": "output_presented",
  "init_true": [],
  "init_constraints": []
}
