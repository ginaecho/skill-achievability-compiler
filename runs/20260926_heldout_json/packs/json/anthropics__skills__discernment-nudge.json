{
  "name": "discernment-nudge",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "answer_completely": {
      "owner": "agent",
      "pre": true,
      "add": [
        "answer_given"
      ]
    },
    "append_nudge": {
      "owner": "agent",
      "pre": {
        "and": [
          "answer_given",
          {
            "not": "nudge_used"
          }
        ]
      },
      "add": [
        "nudge_appended",
        "nudge_used"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "answer_completely",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "qualifies_for_nudge": [
            {
              "act": {
                "cap": "append_nudge",
                "by": "agent"
              }
            }
          ],
          "does_not_qualify": []
        }
      }
    }
  ],
  "goal": "answer_given",
  "init_true": [],
  "init_constraints": []
}
