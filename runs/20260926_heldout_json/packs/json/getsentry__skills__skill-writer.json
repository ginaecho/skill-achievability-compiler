{
  "name": "skill-writer",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "inspect_workspace": {
      "owner": "agent",
      "pre": true,
      "add": [
        "workspace_inspected"
      ]
    },
    "gather_sources": {
      "owner": "agent",
      "pre": "workspace_inspected",
      "add": [
        "sources_gathered"
      ]
    },
    "author_skill_files": {
      "owner": "agent",
      "pre": "sources_gathered",
      "add": [
        "skill_authored"
      ]
    },
    "optimize_description": {
      "owner": "agent",
      "pre": "skill_authored",
      "add": [
        "description_optimized"
      ]
    },
    "register_skill": {
      "owner": "agent",
      "pre": "description_optimized",
      "add": [
        "skill_registered"
      ]
    },
    "validate_skill": {
      "owner": "agent",
      "pre": "skill_registered",
      "add": [
        "skill_validated"
      ]
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_workspace",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "gather_sources",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "author_skill_files",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "optimize_description",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "register_skill",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_skill",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "skill_authored",
      "skill_registered",
      "skill_validated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
