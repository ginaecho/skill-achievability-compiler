{
  "name": "crypto-protocol-diagram",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_input_type": {
      "owner": "agent",
      "pre": true,
      "add": [
        "input_type_known"
      ]
    },
    "extract_code_protocol": {
      "owner": "agent",
      "pre": true,
      "add": [
        "protocol_extracted"
      ]
    },
    "extract_spec_protocol": {
      "owner": "agent",
      "pre": true,
      "add": [
        "protocol_extracted"
      ]
    },
    "annotate_divergences": {
      "owner": "agent",
      "pre": "protocol_extracted",
      "add": [
        "divergences_annotated"
      ]
    },
    "generate_diagram": {
      "owner": "agent",
      "pre": "protocol_extracted",
      "add": [
        "diagram_generated"
      ]
    },
    "verify_diagram": {
      "owner": "agent",
      "pre": "diagram_generated",
      "add": [
        "diagram_verified"
      ]
    },
    "write_diagram_file": {
      "owner": "agent",
      "pre": "diagram_verified",
      "add": [
        "diagram_written"
      ]
    },
    "print_ascii_diagram": {
      "owner": "agent",
      "pre": "diagram_verified",
      "add": [
        "ascii_printed"
      ]
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "external": true,
        "observed": true,
        "branches": {
          "code": [
            {
              "act": {
                "cap": "extract_code_protocol",
                "by": "agent"
              }
            }
          ],
          "spec": [
            {
              "act": {
                "cap": "extract_spec_protocol",
                "by": "agent"
              }
            }
          ],
          "both": [
            {
              "act": {
                "cap": "extract_spec_protocol",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "extract_code_protocol",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "annotate_divergences",
                "by": "agent"
              }
            }
          ],
          "ambiguous": [
            {
              "act": {
                "cap": "ask_input_type",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "extract_spec_protocol",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "generate_diagram",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_diagram",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_diagram_file",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "print_ascii_diagram",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "diagram_written",
      "ascii_printed",
      "diagram_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
