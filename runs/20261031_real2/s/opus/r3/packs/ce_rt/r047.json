      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "inspect_model": {
      "owner": "agent",
      "pre": "model_supplied",
      "add": [
        "model_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
