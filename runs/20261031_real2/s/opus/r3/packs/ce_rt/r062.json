{
  "name": "nvshmem-troubleshoot-and-report-bugs",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "request_inputs": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      },
      "add": [
        "inputs_obtained"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "request_info_rerun": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation",
          "inputs_obtained"
        ]
      },
      "add": [
        "info_logs_obtained"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "inspect_artifacts": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "inputs_obtained"
        ]
      },
      "add": [
        "evidence_recorded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_version": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet",
          "evidence_recorded"
        ]
      },
      "add": [
        "version_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "request_inputs",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "info_logging_missing": [
            {
              "act": {
                "cap": "request_info_rerun",
                "by": "agent"
              }
            }
          ],
          "logs_already_sufficient": []
        }
      }
    },
    {
      "act": {
        "cap": "inspect_artifacts",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "check_version": [
            {
              "act": {
                "cap": "verify_version",
                "by": "agent"
              }
            }
          ],
          "label_unverified": []
        }
      }
    }
  ],
  "goal": "evidence_recorded",
  "init_true": [
    "needs:user_conversation",
    "needs:local_filesystem",
    "needs:public_internet"
  ],
  "init_constraints": []
}
