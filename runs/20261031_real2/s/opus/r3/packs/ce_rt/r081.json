{
  "name": "mcp-oauth-triage",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "collect_artifacts": {
      "owner": "agent",
      "pre": true,
      "add": [
        "artifacts_collected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "apply_fix": {
      "owner": "agent",
      "pre": "fault_classified",
      "add": [
        "fix_applied"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "rec": {
        "name": "triage",
        "body": [
          {
            "act": {
              "cap": "collect_artifacts",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "run_classifier",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "artifacts_sound": [],
                "artifacts_wrong": [
                  {
                    "continue": "triage"
                  }
                ]
              }
            }
          }
        ]
      }
    },
    {
      "act": {
        "cap": "apply_fix",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_round_trip",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "fault_classified",
      "fix_applied",
      "fix_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
