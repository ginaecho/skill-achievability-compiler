{
  "name": "linkerd-patterns",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "install_cli": {
      "owner": "agent",
      "pre": true,
      "add": [
        "cli_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_cluster": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:kubernetes_cluster",
          "cli_installed"
        ]
      },
      "add": [
        "cluster_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_crds": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:kubernetes_cluster",
          "cluster_ready"
        ]
      },
      "add": [
        "crds_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_control_plane": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:kubernetes_cluster",
          "crds_installed"
        ]
      },
      "add": [
        "mesh_installed",
        "mtls_enabled"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_mesh": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:kubernetes_cluster",
          "mesh_installed"
        ]
      },
      "add": [
        "mesh_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "inject_namespace": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:kubernetes_cluster",
          "mesh_verified"
        ]
      },
      "add": [
        "namespace_injected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_manifests": {
      "owner": "agent",
      "pre": true,
      "add": [
        "manifests_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "apply_manifests": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:kubernetes_cluster",
          {
            "and": [
              "manifests_written",
              "namespace_injected"
            ]
          }
        ]
      },
      "add": [
        "policies_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_cli",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_cluster",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_crds",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_control_plane",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_mesh",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "inject_namespace",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_manifests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "apply_manifests",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "mesh_installed",
      "mtls_enabled",
      "mesh_verified",
      "namespace_injected",
      "policies_configured"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
