{
  "name": "pva-opgen",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "validate_inputs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "inputs_valid"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_references": {
      "owner": "agent",
      "pre": "inputs_valid",
      "add": [
        "references_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "inspect_project": {
      "owner": "agent",
      "pre": "references_read",
      "add": [
        "project_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_deliverables": {
      "owner": "agent",
      "pre": "project_inspected",
      "add": [
        "deliverables_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_test": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:pva_sdk_toolchain",
          "needs:tegra_target",
          {
            "and": [
              "deliverables_created",
              "build_test_available"
            ]
          }
        ]
      },
      "add": [
        "build_test_passed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "debug": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:pva_sdk_toolchain",
          {
            "and": [
              "deliverables_created",
              "debug_available"
            ]
          }
        ]
      },
      "add": [],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_report": {
      "owner": "agent",
      "pre": true,
      "add": [
        "report_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "validate_inputs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_references",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "inspect_project",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_deliverables",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "repair",
        "body": [
          {
            "act": {
              "cap": "build_test",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "external": true,
              "branches": {
                "passed": [],
                "failed": [
                  {
                    "act": {
                      "cap": "debug",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "repair"
                  }
                ]
              }
            }
          }
        ]
      }
    },
    {
      "act": {
        "cap": "write_report",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "deliverables_created",
      "build_test_passed",
      "report_written"
    ]
  },
  "init_true": [
    "build_test_available",
    "debug_available"
  ],
  "init_constraints": []
}
