{
  "name": "java-diagnostics",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "capture_symptom": {
      "owner": "agent",
      "pre": true,
      "add": [
        "symptom_captured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "get_consent": {
      "owner": "agent",
      "pre": "primary_collected",
      "add": [
        "consent_given"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "capture_symptom",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "identify_jvm",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "collect_primary",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "get_consent",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "collect_confirming",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "fix_and_clean": [
            {
              "act": {
                "cap": "apply_fix",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "remeasure",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "cleanup",
                "by": "agent"
              }
            }
          ],
          "diagnosis_only": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "symptom_captured",
      "jvm_identified",
      "hypothesis_confirmed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
