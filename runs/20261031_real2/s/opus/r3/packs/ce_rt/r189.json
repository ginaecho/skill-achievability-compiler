{
  "name": "fireflies-ci-integration",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_repo": {
      "owner": "agent",
      "pre": true,
      "add": [
        "repo_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_offline_lane": {
      "owner": "agent",
      "pre": "repo_inspected",
      "add": [
        "offline_lane_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "request_live_approval": {
      "owner": "agent",
      "pre": true,
      "add": [
        "live_approved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "publish_receipt": {
      "owner": "agent",
      "pre": "offline_lane_built",
      "add": [
        "receipt_published"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_repo",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_offline_lane",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "enable_live": [
            {
              "act": {
                "cap": "request_live_approval",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "run_live_tests",
                "by": "agent"
              }
            }
          ],
          "skip_live": []
        }
      }
    },
    {
      "act": {
        "cap": "publish_receipt",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "offline_lane_built",
      "receipt_published"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
