{
  "name": "java-upgrade",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_build": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      },
      "add": [
        "versions_detected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_target": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      },
      "add": [
        "target_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_guide": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet",
          "versions_detected"
        ]
      },
      "add": [
        "guide_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "update_build": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          {
            "and": [
              "target_known",
              "guide_fetched"
            ]
          }
        ]
      },
      "add": [
        "build_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "adopt_features": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "tests_pass"
        ]
      },
      "add": [
        "features_adopted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_build",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "ask_target",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_guide",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "update_build",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "adopt": [
            {
              "act": {
                "cap": "adopt_features",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "build_updated",
      "tests_pass"
    ]
  },
  "init_true": [
    "needs:local_filesystem",
    "needs:user_conversation",
    "needs:public_internet"
  ],
  "init_constraints": []
}
