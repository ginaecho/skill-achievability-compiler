{
  "name": "connectivity-triage",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "define_symptom": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      },
      "add": [
        "symptom_defined"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "define_symptom",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "sample_responsiveness": [
            {
              "act": {
                "cap": "network_quality",
                "by": "agent"
              }
            }
          ],
          "skip_responsiveness": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "inspect_resolver": [
            {
              "act": {
                "cap": "inspect_resolver",
                "by": "agent"
              }
            }
          ],
          "skip_resolver": []
        }
      }
    },
    {
      "act": {
        "cap": "dns_query",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "ping_probe",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "traceroute_probe",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "process_specific": [
            {
              "act": {
                "cap": "nettop_capture",
                "by": "agent"
              }
            }
          ],
          "skip_process": []
        }
      }
    },
    {
      "act": {
        "cap": "curl_timing",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "symptom_defined",
      "dns_behavior_observed",
      "reachability_observed",
      "path_observed",
      "http_timed"
    ]
  },
  "init_true": [
    "needs:user_conversation"
  ],
  "init_constraints": []
}
