{
  "name": "agentic-verify",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "write_check_test": {
      "owner": "agent",
      "pre": "change_present",
      "add": [
        "test_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "close_gap": {
      "owner": "agent",
      "pre": "test_written",
      "add": [
        "gap_closed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_report": {
      "owner": "agent",
      "pre": "verified",
      "add": [
        "evidence_reported"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_check_test",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "base_check",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "verify_loop",
        "body": [
          {
            "act": {
              "cap": "run_verify",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "external": true,
              "branches": {
                "pass": [],
                "gaps": [
                  {
                    "act": {
                      "cap": "close_gap",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "verify_loop"
                  }
                ]
              }
            }
          }
        ]
      }
    },
    {
      "act": {
        "cap": "write_report",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "verified",
      "evidence_reported"
    ]
  },
  "init_true": [
    "change_present"
  ],
  "init_constraints": []
}
