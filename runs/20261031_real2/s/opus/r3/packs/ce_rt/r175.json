{
  "name": "wow-digest",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "save_candidates": {
      "owner": "agent",
      "pre": "candidates_ready",
      "add": [
        "candidates_saved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "append_daily_note": {
      "owner": "agent",
      "pre": "items_selected",
      "add": [
        "items_appended"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "ingest",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "save_candidates",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "enrich",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "salience_filter",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "wow_score",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "append_daily_note",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "eval_mode": [
            {
              "act": {
                "cap": "collect_feedback",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "confirm": [
                    {
                      "act": {
                        "cap": "archive_emails",
                        "by": "agent"
                      }
                    }
                  ],
                  "hold": []
                }
              }
            }
          ],
          "auto_mode": [
            {
              "act": {
                "cap": "archive_emails",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "items_appended",
      {
        "cmp": [
          "selected",
          ">=",
          3
        ]
      },
      {
        "cmp": [
          "selected",
          "<=",
          7
        ]
      }
    ]
  },
  "init_true": [],
  "init_constraints": [
    {
      "cmp": [
        "selected",
        "==",
        0
      ]
    }
  ]
}
