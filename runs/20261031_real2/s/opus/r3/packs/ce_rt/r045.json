{
  "name": "qiime2-amplicon",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "validate_inputs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "inputs_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_workflow": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:qiime2_env",
          "needs:trusted_classifier",
          "inputs_validated"
        ]
      },
      "add": [
        "asvs_produced",
        "taxonomy_produced",
        "provenance_retained"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "inspect_results": {
      "owner": "agent",
      "pre": "provenance_retained",
      "add": [],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "validate_inputs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_workflow",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "inspect": [
            {
              "act": {
                "cap": "inspect_results",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "asvs_produced",
      "taxonomy_produced",
      "provenance_retained"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
