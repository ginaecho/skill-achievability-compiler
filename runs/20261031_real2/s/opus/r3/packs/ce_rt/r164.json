{
  "name": "open-knowledge-vault",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_vault": {
      "owner": "agent",
      "pre": true,
      "add": [
        "scope_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "init_vault": {
      "owner": "agent",
      "pre": "scope_inspected",
      "add": [
        "vault_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_sources": {
      "owner": "agent",
      "pre": true,
      "add": [
        "sources_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_notes": {
      "owner": "agent",
      "pre": {
        "and": [
          "sources_read",
          "vault_created"
        ]
      },
      "add": [
        "notes_grounded",
        "sources_attached"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "refresh_indexes": {
      "owner": "agent",
      "pre": "notes_grounded",
      "add": [
        "indexes_refreshed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "audit_vault": {
      "owner": "agent",
      "pre": "vault_created",
      "add": [
        "structure_valid"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_dataview": {
      "owner": "agent",
      "pre": "vault_created",
      "add": [
        "dataview_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_vault",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "init_vault",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_sources",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_notes",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "refresh_indexes",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "audit_vault",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "with_dataview": [
            {
              "act": {
                "cap": "install_dataview",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "verify_dataview",
                "by": "agent"
              }
            }
          ],
          "portable_only": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "vault_created",
      "notes_grounded",
      "sources_attached",
      "indexes_refreshed",
      "structure_valid"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
