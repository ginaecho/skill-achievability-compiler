{
  "name": "cmux-diagnostics",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "run_diagnostics": {
      "owner": "agent",
      "pre": true,
      "add": [
        "diagnostics_collected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_cli_socket": {
      "owner": "agent",
      "pre": true,
      "add": [
        "cli_socket_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_settings": {
      "owner": "agent",
      "pre": true,
      "add": [
        "settings_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_session_store": {
      "owner": "agent",
      "pre": true,
      "add": [
        "session_store_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fix_hooks": {
      "owner": "agent",
      "pre": "cli_socket_checked",
      "add": [
        "hooks_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "test_notification": {
      "owner": "agent",
      "pre": true,
      "add": [
        "notification_sent"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "run_diagnostics",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_cli_socket",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_settings",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_session_store",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "apply_fix": [
            {
              "act": {
                "cap": "fix_hooks",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "run_diagnostics",
                "by": "agent"
              }
            }
          ],
          "read_only": []
        }
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "send_test": [
            {
              "act": {
                "cap": "test_notification",
                "by": "agent"
              }
            }
          ],
          "skip_notification": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "diagnostics_collected",
      "cli_socket_checked",
      "settings_checked",
      "session_store_checked"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
