{
  "name": "link-building",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_pm_context": {
      "owner": "agent",
      "pre": true,
      "add": [
        "context_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_context": {
      "owner": "agent",
      "pre": true,
      "add": [
        "context_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "find_prospects": {
      "owner": "agent",
      "pre": "context_gathered",
      "add": [
        "prospects_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "find_contacts": {
      "owner": "agent",
      "pre": "prospects_found",
      "add": [
        "contacts_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_plan": {
      "owner": "agent",
      "pre": {
        "and": [
          "gap_diagnosed",
          "prospects_found",
          "contacts_found"
        ]
      },
      "add": [
        "plan_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "pm_context_exists": [
            {
              "act": {
                "cap": "read_pm_context",
                "by": "agent"
              }
            }
          ],
          "no_pm_context": []
        }
      }
    },
    {
      "act": {
        "cap": "ask_context",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "link_gap",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "find_prospects",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "find_contacts",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_plan",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "gap_diagnosed",
      "prospects_found",
      "contacts_found",
      "plan_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
