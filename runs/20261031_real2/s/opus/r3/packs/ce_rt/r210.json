{
  "name": "course-upskilling-requests",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "gather_facts": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      },
      "add": [
        "facts_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_artifacts": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "facts_gathered"
        ]
      },
      "add": [
        "csv_emitted",
        "sql_emitted",
        "json_emitted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_notion_mapping": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "facts_gathered"
        ]
      },
      "add": [
        "notion_mapping_emitted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "gather_facts",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "request_build": [
            {
              "act": {
                "cap": "build_artifacts",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "build_notion_mapping",
                "by": "agent"
              }
            }
          ],
          "advice_only": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "csv_emitted",
      "sql_emitted",
      "json_emitted",
      "notion_mapping_emitted"
    ]
  },
  "init_true": [
    "needs:user_conversation",
    "needs:local_filesystem"
  ],
  "init_constraints": []
}
