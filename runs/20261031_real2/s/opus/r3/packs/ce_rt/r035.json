{
  "name": "cellprofiler",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "write_manifest": {
      "owner": "agent",
      "pre": true,
      "add": [
        "manifest_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_manifest",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "prepare",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "calibrate": [
            {
              "act": {
                "cap": "run_pilot",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "tune_pipeline",
                "by": "agent"
              }
            }
          ],
          "use_starter": []
        }
      }
    },
    {
      "act": {
        "cap": "run_assay",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "summarize",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "measurements_produced",
      "qc_summarized"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
