{
  "name": "linear-ticket-triage",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "verify_repo": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "issues_read"
        ]
      },
      "add": [
        "repo_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "list_issues",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "statuses_matter": [
            {
              "act": {
                "cap": "fetch_statuses",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    },
    {
      "act": {
        "cap": "read_issues",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_repo",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "add_comment",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "close_issue",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "repo_verified",
      "evidence_comments_added",
      "clear_issues_closed"
    ]
  },
  "init_true": [
    "needs:local_filesystem"
  ],
  "init_constraints": []
}
