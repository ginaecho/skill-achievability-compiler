{
  "name": "anima-security-basics",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_integration": {
      "owner": "agent",
      "pre": true,
      "add": [
        "integration_reviewed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_server_guard": {
      "owner": "agent",
      "pre": "integration_reviewed",
      "add": [
        "server_side_enforced"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "integrate_secret_manager": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:gcp_account"
        ]
      },
      "add": [
        "secrets_loaded_from_manager"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scan_for_leaks": {
      "owner": "agent",
      "pre": "generated_output_present",
      "add": [
        "leak_scan_passed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_preflight": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:figma_account",
          {
            "and": [
              "figma_token_minimal_scope",
              "server_side_enforced",
              "secrets_loaded_from_manager"
            ]
          }
        ]
      },
      "add": [
        "preflight_passed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_integration",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_figma_token",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_server_guard",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "integrate_secret_manager",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "staging_preflight": [
            {
              "act": {
                "cap": "scan_for_leaks",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "run_preflight",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "figma_token_minimal_scope",
      "server_side_enforced",
      "secrets_loaded_from_manager"
    ]
  },
  "init_true": [
    "generated_output_present"
  ],
  "init_constraints": []
}
