{
  "name": "prd-full",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "scope_preflight": {
      "owner": "agent",
      "pre": "args_valid",
      "add": [
        "scope_ok"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_worktree": {
      "owner": "agent",
      "pre": "scope_ok",
      "add": [
        "isolated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_branch": {
      "owner": "agent",
      "pre": "scope_ok",
      "add": [
        "isolated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "prd_start": {
      "owner": "agent",
      "pre": "isolated",
      "add": [
        "started"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "prd_next": {
      "owner": "agent",
      "pre": "started",
      "add": [
        "task_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "prd_update_progress": {
      "owner": "agent",
      "pre": "task_done",
      "add": [
        "prd_complete"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_pr": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:github_account",
          "prd_complete"
        ]
      },
      "add": [
        "pr_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "scope_preflight",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "stop": [],
          "continue": [
            {
              "choice": {
                "by": "agent",
                "observed": true,
                "branches": {
                  "worktree": [
                    {
                      "act": {
                        "cap": "create_worktree",
                        "by": "agent"
                      }
                    }
                  ],
                  "branch": [
                    {
                      "act": {
                        "cap": "create_branch",
                        "by": "agent"
                      }
                    }
                  ]
                }
              }
            },
            {
              "act": {
                "cap": "prd_start",
                "by": "agent"
              }
            },
            {
              "rec": {
                "name": "iterate",
                "body": [
                  {
                    "act": {
                      "cap": "prd_next",
                      "by": "agent"
                    }
                  },
                  {
                    "act": {
                      "cap": "prd_update_progress",
                      "by": "agent"
                    }
                  },
                  {
                    "choice": {
                      "by": "agent",
                      "observed": true,
                      "branches": {
                        "done": [],
                        "again": [
                          {
                            "continue": "iterate"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            },
            {
              "act": {
                "cap": "create_pr",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "prd_complete",
      "pr_created"
    ]
  },
  "init_true": [
    "args_valid"
  ],
  "init_constraints": []
}
