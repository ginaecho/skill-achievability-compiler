{
  "name": "py-quality-gates",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "assess_repo": {
      "owner": "agent",
      "pre": true,
      "add": [
        "repo_assessed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_deps": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:package_registries",
          "repo_assessed"
        ]
      },
      "add": [
        "deps_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_ruff_config": {
      "owner": "agent",
      "pre": "repo_assessed",
      "add": [
        "ruff_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_pytest_config": {
      "owner": "agent",
      "pre": "repo_assessed",
      "add": [
        "pytest_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_type_config": {
      "owner": "agent",
      "pre": "repo_assessed",
      "add": [
        "type_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_check_sh": {
      "owner": "agent",
      "pre": "deps_installed",
      "add": [
        "check_sh_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_precommit_config": {
      "owner": "agent",
      "pre": "check_sh_created",
      "add": [
        "precommit_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_hooks": {
      "owner": "agent",
      "pre": {
        "and": [
          "precommit_configured",
          "deps_installed"
        ]
      },
      "add": [
        "hooks_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_gate": {
      "owner": "agent",
      "pre": {
        "and": [
          "deps_installed",
          "ruff_configured",
          "pytest_configured",
          "check_sh_created",
          "precommit_configured",
          "hooks_installed"
        ]
      },
      "add": [
        "gate_passes"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "update_claude_md": {
      "owner": "agent",
      "pre": "gate_passes",
      "add": [
        "claude_md_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "assess_repo",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_deps",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_ruff_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_pytest_config",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "type_checker_ty": [],
          "type_checker_mypy_or_pyright": [
            {
              "act": {
                "cap": "write_type_config",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "write_check_sh",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_precommit_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_hooks",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_gate",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "document": [
            {
              "act": {
                "cap": "update_claude_md",
                "by": "agent"
              }
            }
          ],
          "skip_docs": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "deps_installed",
      "ruff_configured",
      "pytest_configured",
      "check_sh_created",
      "precommit_configured",
      "hooks_installed",
      "gate_passes"
    ]
  },
  "init_true": [
    "needs:package_registries"
  ],
  "init_constraints": []
}
