{
  "name": "tao-generate-od-defects",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "validate_inputs": {
      "owner": "agent",
      "pre": "inputs_provided",
      "add": [
        "inputs_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "launch_workflow": {
      "owner": "agent",
      "pre": true,
      "add": [
        "platform_reviewed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_checkpoints": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:checkpoints",
          "platform_reviewed"
        ]
      },
      "add": [
        "checkpoints_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_defects": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:gpu",
          {
            "and": [
              "inputs_validated",
              "checkpoints_validated"
            ]
          }
        ]
      },
      "add": [
        "images_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "pseudo_label": {
      "owner": "agent",
      "pre": "images_generated",
      "add": [
        "pseudo_labels_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_outputs": {
      "owner": "agent",
      "pre": "pseudo_labels_created",
      "add": [
        "outputs_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "publish_labels": {
      "owner": "agent",
      "pre": "outputs_validated",
      "add": [
        "fine_grained_coco_published",
        "binary_coco_published"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "validate_inputs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "launch_workflow",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_checkpoints",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_defects",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "pseudo_label",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_outputs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "publish_labels",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "fine_grained_coco_published",
      "binary_coco_published",
      "outputs_validated",
      {
        "not": "training_pool_mutated"
      }
    ]
  },
  "init_true": [
    "inputs_provided"
  ],
  "init_constraints": []
}
