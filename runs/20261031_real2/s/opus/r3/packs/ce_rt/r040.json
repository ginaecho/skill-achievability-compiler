{
  "name": "nmrglue",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "establish_parameters": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation",
          "fid_available"
        ]
      },
      "add": [
        "parameters_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_settings": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "parameters_known"
        ]
      },
      "add": [
        "settings_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "adjust_phase": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "settings_ready"
        ]
      },
      "add": [
        "phase_revised"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "adjust_baseline": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "settings_ready"
        ]
      },
      "add": [
        "baseline_set"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "establish_parameters",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_settings",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "phasing",
        "body": [
          {
            "act": {
              "cap": "run_helper",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "revise": [
                  {
                    "act": {
                      "cap": "adjust_phase",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "phasing"
                  }
                ],
                "accept": []
              }
            }
          }
        ]
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "fit_baseline": [
            {
              "act": {
                "cap": "adjust_baseline",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "run_helper",
                "by": "agent"
              }
            }
          ],
          "no_baseline": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "spectrum_produced",
      "peaks_found",
      "integrals_computed",
      "report_written"
    ]
  },
  "init_true": [
    "fid_available",
    "needs:user_conversation",
    "needs:local_filesystem"
  ],
  "init_constraints": []
