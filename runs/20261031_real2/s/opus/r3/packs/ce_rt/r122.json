{
  "name": "azure-logic-apps-standard-cli",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_tooling": {
      "owner": "agent",
      "pre": true,
      "add": [
        "tooling_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_extension": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:package_registries",
          "tooling_verified"
        ]
      },
      "add": [
        "extension_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scaffold_project": {
      "owner": "agent",
      "pre": "extension_installed",
      "add": [
        "project_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "author_workflow": {
      "owner": "agent",
      "pre": "project_created",
      "add": [
        "workflow_authored"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_identity": {
      "owner": "agent",
      "pre": "project_created",
      "add": [
        "identity_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_project": {
      "owner": "agent",
      "pre": "workflow_authored",
      "add": [
        "project_valid"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "package_app": {
      "owner": "agent",
      "pre": "project_valid",
      "add": [
        "package_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_app": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:azure_account",
          {
            "and": [
              "package_built",
              "identity_configured"
            ]
          }
        ]
      },
      "add": [
        "deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_tooling",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_extension",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scaffold_project",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "author_workflow",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_identity",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_project",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "release": [
            {
              "act": {
                "cap": "package_app",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "deploy_app",
                "by": "agent"
              }
            }
          ],
          "local_only": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "project_created",
      "workflow_authored",
      "identity_configured",
      "project_valid"
    ]
  },
  "init_true": [
    "needs:package_registries"
  ],
  "init_constraints": []
}
