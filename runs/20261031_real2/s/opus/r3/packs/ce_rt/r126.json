{
  "name": "cypress-flake-fixer",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "read_version": {
      "owner": "agent",
      "pre": true,
      "add": [
        "version_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scan": {
      "owner": "agent",
      "pre": true,
      "add": [
        "scanned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "measure_baseline": {
      "owner": "agent",
      "pre": "scanned",
      "add": [
        "baseline_recorded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fix_tests": {
      "owner": "agent",
      "pre": {
        "and": [
          "scanned",
          "version_known"
        ]
      },
      "add": [
        "fixes_applied"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify": {
      "owner": "agent",
      "pre": "fixes_applied",
      "add": [
        "verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_version",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scan",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "fix_specific_spec": [
            {
              "act": {
                "cap": "measure_baseline",
                "by": "agent"
              }
            }
          ],
          "audit_only": []
        }
      }
    },
    {
      "act": {
        "cap": "fix_tests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "scanned",
      "fixes_applied",
      "verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
