{
  "name": "java-debugging",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "add_regression_test": {
      "owner": "agent",
      "pre": "root_cause_found",
      "add": [
        "regression_test_added"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "cleanup": {
      "owner": "agent",
      "pre": "root_cause_found",
      "add": [
        "debug_flags_removed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "reproduce",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "investigate",
        "body": [
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "logs_suffice": [
                  {
                    "act": {
                      "cap": "probe_with_logs",
                      "by": "agent"
                    }
                  }
                ],
                "attach_debugger": [
                  {
                    "act": {
                      "cap": "attach_debugger",
                      "by": "agent"
                    }
                  },
                  {
                    "act": {
                      "cap": "inspect_state",
                      "by": "agent"
                    }
                  }
                ]
              }
            }
          },
          {
            "continue": "investigate"
          }
        ]
      }
    },
    {
      "act": {
        "cap": "add_regression_test",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "cleanup",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "root_cause_found",
      "regression_test_added",
      "debug_flags_removed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
