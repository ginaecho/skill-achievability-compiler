{
  "name": "fowler-refactoring",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "build_tests": {
      "owner": "agent",
      "pre": true,
      "add": [
        "baseline_tests"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_baseline": {
      "owner": "agent",
      "pre": "baseline_tests",
      "add": [
        "baseline_green"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "apply_refactor_step": {
      "owner": "agent",
      "pre": "baseline_green",
      "add": [
        "refactored"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_step": {
      "owner": "agent",
      "pre": "refactored",
      "add": [
        "tests_pass",
        "behavior_preserved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "revert_step": {
      "owner": "agent",
      "pre": true,
      "add": [],
      "del": [
        "refactored",
        "tests_pass",
        "behavior_preserved"
      ],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "build_tests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_baseline",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "refine",
        "body": [
          {
            "act": {
              "cap": "apply_refactor_step",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "verify_step",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "verified": [],
                "failed": [
                  {
                    "act": {
                      "cap": "revert_step",
                      "by": "agent"
                    }
                  }
                ]
              }
            }
          },
          {
            "continue": "refine"
          }
        ]
      }
    }
  ],
  "goal": {
    "and": [
      "refactored",
      "tests_pass",
      "behavior_preserved"
    ]
  },
  "init_true": [],
  "init_constraints": []
