{
  "name": "cull-release-prepare",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "create_worktree": {
      "owner": "agent",
      "pre": true,
      "add": [
        "worktree_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "store_notes": {
      "owner": "agent",
      "pre": "notes_provided",
      "add": [
        "notes_stored"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "prepare_dry_run": {
      "owner": "agent",
      "pre": {
        "and": [
          "worktree_ready",
          "notes_stored",
          "check_evidence_green",
          "bump_specified"
        ]
      },
      "add": [
        "dry_run_ok"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "prepare_release": {
      "owner": "agent",
      "pre": "dry_run_ok",
      "add": [
        "commit_created",
        "state_prepared"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "show_diagnostics": {
      "owner": "agent",
      "pre": true,
      "add": [
        "diagnostics_shown"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "create_worktree",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "store_notes",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "prepare_dry_run",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "proceed": [
            {
              "act": {
                "cap": "prepare_release",
                "by": "agent"
              }
            }
          ],
          "fail": [
            {
              "act": {
                "cap": "show_diagnostics",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "commit_created",
      "state_prepared",
      {
        "not": "tag_created"
      },
      {
        "not": "remote_mutated"
      }
    ]
  },
  "init_true": [
    "bump_specified",
    "check_evidence_green",
    "notes_provided"
  ],
  "init_constraints": []
}
