{
  "name": "pva-spec",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "verify_references": {
      "owner": "agent",
      "pre": "doctor_report_ready",
      "add": [
        "references_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_reference_url": {
      "owner": "agent",
      "pre": "references_verified",
      "add": [
        "sources_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_sources": {
      "owner": "agent",
      "pre": "references_verified",
      "add": [
        "sources_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_spec": {
      "owner": "agent",
      "pre": {
        "and": [
          "sources_read",
          {
            "not": "blocking_requirement"
          }
        ]
      },
      "add": [
        "spec_written",
        "configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_matrix": {
      "owner": "agent",
      "pre": "spec_written",
      "add": [
        "matrix_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_evidence": {
      "owner": "agent",
      "pre": "sources_read",
      "add": [
        "evidence_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "link_test": {
      "owner": "agent",
      "pre": "matrix_written",
      "add": [
        "test_linked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "finalize_handoff": {
      "owner": "agent",
      "pre": {
        "and": [
          "spec_written",
          "matrix_written",
          "evidence_written",
          "doctor_report_ready"
        ]
      },
      "add": [
        "handoff_finalized"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_handoff": {
      "owner": "agent",
      "pre": "handoff_finalized",
      "add": [
        "handoff_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_report": {
      "owner": "agent",
      "pre": "handoff_checked",
      "add": [
        "report_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "verify_references",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "public_url": [
            {
              "act": {
                "cap": "fetch_reference_url",
                "by": "agent"
              }
            }
          ],
          "local_sources": [
            {
              "act": {
                "cap": "read_sources",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "write_spec",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_matrix",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_evidence",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "finalize",
        "body": [
          {
            "act": {
              "cap": "finalize_handoff",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "external": true,
              "branches": {
                "missing_test": [
                  {
                    "act": {
                      "cap": "link_test",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "finalize"
                  }
                ],
                "ready": []
              }
            }
          }
        ]
      }
    },
    {
      "act": {
        "cap": "check_handoff",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_report",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "references_verified",
      "sources_read",
      "spec_written",
      "matrix_written",
      "evidence_written",
      "handoff_finalized",
      "handoff_checked",
      "report_written",
      "configured"
    ]
  },
  "init_true": [
    "doctor_report_ready"
  ],
  "init_constraints": []
}
