  ],
  "capabilities": {
    "consult_docs": {
      "owner": "agent",
      "pre": true,
      "add": [
        "requirements_resolved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "probe_target": {
      "owner": "agent",
      "pre": true,
      "add": [
        "target_assessed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "collect_probe_output": {
      "owner": "agent",
      "pre": true,
      "add": [
        "target_assessed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "execute_install": {
      "owner": "agent",
      "pre": {
        "and": [
          "requirements_resolved",
          "target_assessed"
        ]
      },
      "add": [
        "installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_install": {
      "owner": "agent",
      "pre": "installed",
      "add": [
        "validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
