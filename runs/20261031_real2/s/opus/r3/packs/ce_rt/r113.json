{
  "name": "shopify-development",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "install_cli": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:package_registries"
        ]
      },
      "add": [
        "cli_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "init_app": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:shopify_partner_account",
          "cli_installed"
        ]
      },
      "add": [
        "app_scaffolded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_app": {
      "owner": "agent",
      "pre": "app_scaffolded",
      "add": [
        "app_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_extension": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:shopify_partner_account",
          "app_scaffolded"
        ]
      },
      "add": [
        "extension_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_code": {
      "owner": "agent",
      "pre": "extension_generated",
      "add": [
        "code_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_app": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:shopify_partner_account",
          {
            "and": [
              "code_written",
              "app_configured"
            ]
          }
        ]
      },
      "add": [
        "deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_cli",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "init_app",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_app",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_extension",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_code",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "deploy": [
            {
              "act": {
                "cap": "deploy_app",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "app_scaffolded",
      "app_configured",
      "code_written"
    ]
  },
  "init_true": [
    "needs:package_registries"
  ],
  "init_constraints": []
}
