{
  "name": "google-image-search",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "install_llm": {
      "owner": "agent",
      "pre": true,
      "add": [
        "llm_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "search_images": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:google_search_credentials"
        ]
      },
      "add": [
        "candidates_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "llm_select": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:openrouter_api_key",
          {
            "and": [
              "candidates_found",
              "llm_installed"
            ]
          }
        ]
      },
      "add": [
        "best_selected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "download_images": {
      "owner": "agent",
      "pre": "best_selected",
      "add": [
        "images_downloaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_llm",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "search_images",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "llm_select",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "download_images",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "best_selected",
      "images_downloaded"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
