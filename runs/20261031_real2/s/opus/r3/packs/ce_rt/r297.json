{
  "name": "social-publishing",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "install_socialclaw": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:package_registry"
        ]
      },
      "add": [
        "socialclaw_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_socialclaw",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "with_media": [
            {
              "act": {
                "cap": "upload_media",
                "by": "agent"
              }
            }
          ],
          "no_media": []
        }
      }
    },
    {
      "act": {
        "cap": "publish_posts",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "pull_metrics": [
            {
              "act": {
                "cap": "pull_analytics",
                "by": "agent"
              }
            }
          ],
          "skip_metrics": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "posts_published",
      "confirmation_received"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
