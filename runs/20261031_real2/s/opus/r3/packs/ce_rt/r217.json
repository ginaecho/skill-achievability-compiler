{
  "name": "logic-fix-all",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "prompt_consent": {
      "owner": "agent",
      "pre": true,
      "add": [
        "consent_prompted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "enumerate_scope": {
      "owner": "agent",
      "pre": "consent_prompted",
      "add": [
        "scope_enumerated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_methods": {
      "owner": "agent",
      "pre": "scope_enumerated",
      "add": [
        "methods_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_sources": {
      "owner": "agent",
      "pre": "scope_enumerated",
      "add": [
        "review_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "apply_fix": {
      "owner": "agent",
      "pre": "review_done",
      "add": [
        "fixes_applied"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_fixes": {
      "owner": "agent",
      "pre": "fixes_applied",
      "add": [
        "fixes_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "prompt_consent",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "consent": [
            {
              "act": {
                "cap": "enumerate_scope",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "read_methods",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "agent",
                "external": true,
                "branches": {
                  "methods_present": [
                    {
                      "act": {
                        "cap": "read_sources",
                        "by": "agent"
                      }
                    },
                    {
                      "rec": {
                        "name": "fix_iterate",
                        "body": [
                          {
                            "act": {
                              "cap": "apply_fix",
                              "by": "agent"
                            }
                          },
                          {
                            "act": {
                              "cap": "verify_fixes",
                              "by": "agent"
                            }
                          },
                          {
                            "act": {
                              "cap": "read_sources",
                              "by": "agent"
                            }
                          },
                          {
                            "continue": "fix_iterate"
                          }
                        ]
                      }
                    }
                  ],
                  "methods_absent": [
                    {
                      "act": {
                        "cap": "read_sources",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "apply_fix",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "verify_fixes",
                        "by": "agent"
                      }
                    }
                  ]
                }
              }
            }
          ],
          "decline": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "fixes_applied",
      "fixes_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
