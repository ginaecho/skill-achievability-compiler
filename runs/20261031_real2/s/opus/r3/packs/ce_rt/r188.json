{
  "name": "firecrawl-data-handling",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_sources": {
      "owner": "agent",
      "pre": "repository_provided",
      "add": [
        "sources_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "document_inventory": {
      "owner": "agent",
      "pre": "sources_inspected",
      "add": [
        "inventory_documented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_normalization": {
      "owner": "agent",
      "pre": "inventory_documented",
      "add": [
        "normalization_implemented",
        "provenance_preserved",
        "injection_safe"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "separate_stores": {
      "owner": "agent",
      "pre": "normalization_implemented",
      "add": [
        "stores_separated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "store_sensitive": {
      "owner": "agent",
      "pre": "stores_separated",
      "add": [
        "sensitive_stored"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_disposal": {
      "owner": "agent",
      "pre": "stores_separated",
      "add": [
        "disposal_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_sources",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "document_inventory",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "implement_normalization",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "separate_stores",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "approve_sensitive": [
            {
              "act": {
                "cap": "store_sensitive",
                "by": "agent"
              }
            }
          ],
          "skip_sensitive": []
        }
      }
    },
    {
      "act": {
        "cap": "implement_disposal",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "inventory_documented",
      "normalization_implemented",
      "provenance_preserved",
      "injection_safe",
      "stores_separated",
      "disposal_verified"
    ]
  },
  "init_true": [
    "repository_provided"
  ],
  "init_constraints": []
}
