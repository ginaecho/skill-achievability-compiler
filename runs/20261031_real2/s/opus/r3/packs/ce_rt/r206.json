{
  "name": "neon-realtime",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "write_backend": {
      "owner": "agent",
      "pre": {
        "and": [
          "env_ready",
          "packages_installed"
        ]
      },
      "add": [
        "query_exposed",
        "write_path_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_frontend": {
      "owner": "agent",
      "pre": {
        "and": [
          "query_exposed",
          "write_path_ready"
        ]
      },
      "add": [
        "client_subscribes",
        "optimistic_writes"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "enable_realtime",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "pull_env",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_packages",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_backend",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_frontend",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "verify": [
            {
              "act": {
                "cap": "check_query",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "realtime_enabled",
      "env_ready",
      "query_exposed",
      "client_subscribes",
      "optimistic_writes"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
