{
  "name": "claude-design-prompt",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "gather_product_truth": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      },
      "add": [
        "product_truth_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_prompt": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "product_truth_gathered"
        ]
      },
      "add": [
        "prompt_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "gather_product_truth",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_prompt",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "share_generated_design": [
            {
              "act": {
                "cap": "review_design",
                "by": "agent"
              }
            }
          ],
          "prompt_only": []
        }
      }
    }
  ],
  "goal": "prompt_written",
  "init_true": [
    "needs:user_conversation",
    "needs:local_filesystem"
  ],
  "init_constraints": []
}
