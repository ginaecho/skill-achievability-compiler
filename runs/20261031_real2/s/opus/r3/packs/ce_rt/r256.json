{
  "name": "prd-close",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "identify_prd": {
      "owner": "agent",
      "pre": true,
      "add": [
        "prd_identified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_prd": {
      "owner": "agent",
      "pre": "prd_identified",
      "add": [
        "prd_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "update_prd_metadata": {
      "owner": "agent",
      "pre": "prd_read",
      "add": [
        "prd_metadata_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_done_dir": {
      "owner": "agent",
      "pre": true,
      "add": [
        "done_dir_exists"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "archive_prd": {
      "owner": "agent",
      "pre": {
        "and": [
          "prd_metadata_updated",
          "done_dir_exists"
        ]
      },
      "add": [
        "prd_archived"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "update_roadmap": {
      "owner": "agent",
      "pre": "prd_archived",
      "add": [
        "roadmap_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "reopen_issue": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:forge_account",
          "prd_identified"
        ]
      },
      "add": [
        "issue_reopened"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "update_issue": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:forge_account",
          {
            "and": [
              "issue_reopened",
              "prd_archived"
            ]
          }
        ]
      },
      "add": [
        "issue_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "close_issue": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:forge_account",
          "issue_updated"
        ]
      },
      "add": [
        "issue_closed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "commit_changes": {
      "owner": "agent",
      "pre": "prd_archived",
      "add": [
        "changes_committed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "push_changes": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:git_remote",
          "changes_committed"
        ]
      },
      "add": [
        "changes_pushed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "identify_prd",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_prd",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "proceed": [
            {
              "act": {
                "cap": "update_prd_metadata",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "create_done_dir",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "archive_prd",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "agent",
                "observed": true,
                "branches": {
                  "roadmap_exists": [
                    {
                      "act": {
                        "cap": "update_roadmap",
                        "by": "agent"
                      }
                    }
                  ],
                  "no_roadmap": []
                }
              }
            },
            {
              "act": {
                "cap": "reopen_issue",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "update_issue",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "close_issue",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "commit_changes",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "push_changes",
                "by": "agent"
              }
            }
          ],
          "cancel": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "prd_metadata_updated",
      "prd_archived",
      "issue_updated",
      "issue_closed",
      "changes_committed",
      "changes_pushed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
