{
  "name": "task-execution-engine",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "get_next_task": {
      "owner": "agent",
      "pre": "design_doc_exists",
      "add": [
        "task_selected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_task": {
      "owner": "agent",
      "pre": "task_selected",
      "add": [
        "task_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_criteria": {
      "owner": "agent",
      "pre": "task_implemented",
      "add": [
        "criteria_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "mark_done": {
      "owner": "agent",
      "pre": "criteria_verified",
      "add": [
        "task_processed"
      ],
      "del": [
        "task_selected",
        "task_implemented",
        "criteria_verified"
      ],
      "assigns": {},
      "nondet": {}
    },
    "mark_failed": {
      "owner": "agent",
      "pre": "task_selected",
      "add": [
        "task_processed"
      ],
      "del": [
        "task_selected",
        "task_implemented",
        "criteria_verified"
      ],
      "assigns": {},
      "nondet": {}
    },
    "check_status": {
      "owner": "agent",
      "pre": "design_doc_exists",
      "add": [
        "all_tasks_processed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "rec": {
        "name": "tasks",
        "body": [
          {
            "act": {
              "cap": "get_next_task",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "implemented": [
                  {
                    "act": {
                      "cap": "implement_task",
                      "by": "agent"
                    }
                  },
                  {
                    "act": {
                      "cap": "verify_criteria",
                      "by": "agent"
                    }
                  },
                  {
                    "act": {
                      "cap": "mark_done",
                      "by": "agent"
                    }
                  }
                ],
                "blocked": [
                  {
                    "act": {
                      "cap": "mark_failed",
                      "by": "agent"
                    }
                  }
                ]
              }
            }
          },
          {
            "choice": {
              "by": "agent",
              "external": true,
              "branches": {
                "more_tasks": [
                  {
                    "continue": "tasks"
                  }
                ],
                "no_tasks_remain": [
                  {
                    "act": {
                      "cap": "check_status",
                      "by": "agent"
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "goal": "all_tasks_processed",
  "init_true": [
    "design_doc_exists"
  ],
  "init_constraints": []
}
