{
  "name": "adjudicate-regression",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "read_evidence": {
      "owner": "agent",
      "pre": "evidence_available",
      "add": [
        "evidence_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_seals": {
      "owner": "agent",
      "pre": "evidence_read",
      "add": [
        "seals_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_known_findings": {
      "owner": "agent",
      "pre": "evidence_read",
      "add": [
        "novelty_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_decision": {
      "owner": "agent",
      "pre": "seals_verified",
      "add": [
        "decision_written",
        "evidence_cited"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "seal_decision": {
      "owner": "agent",
      "pre": "decision_written",
      "add": [
        "decision_sealed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_evidence",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_seals",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "confirm": [
            {
              "act": {
                "cap": "check_known_findings",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "write_decision",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "seal_decision",
                "by": "agent"
              }
            }
          ],
          "exclude": [
            {
              "act": {
                "cap": "write_decision",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "seal_decision",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "decision_written",
      "decision_sealed",
      "evidence_cited"
    ]
  },
  "init_true": [
    "evidence_available"
  ],
  "init_constraints": []
}
