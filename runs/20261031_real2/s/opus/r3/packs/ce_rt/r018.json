{
  "name": "go-modern-review",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "confirm_version": {
      "owner": "agent",
      "pre": true,
      "add": [
        "version_confirmed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "review_code": {
      "owner": "agent",
      "pre": "version_confirmed",
      "add": [
        "code_reviewed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_go_fix": {
      "owner": "agent",
      "pre": "code_reviewed",
      "add": [
        "code_changed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "apply_refactor": {
      "owner": "agent",
      "pre": "code_reviewed",
      "add": [
        "code_changed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_gates": {
      "owner": "agent",
      "pre": "code_changed",
      "add": [
        "gates_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "confirm_version",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "review_code",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "refactor": [
            {
              "act": {
                "cap": "run_go_fix",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "apply_refactor",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "run_gates",
                "by": "agent"
              }
            }
          ],
          "review_only": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "version_confirmed",
      "code_reviewed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
