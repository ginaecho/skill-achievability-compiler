{
  "name": "design-orchestration",
  "roles": [
    "agent",
    "reviewer"
  ],
  "capabilities": {
    "brainstorm": {
      "owner": "agent",
      "pre": true,
      "add": [
        "understanding_locked",
        "design_created",
        "decision_log_started"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "single_agent_review": {
      "owner": "agent",
      "pre": {
        "and": [
          "understanding_locked",
          "design_created",
          "decision_log_started"
        ]
      },
      "add": [
        "design_approved",
        "risks_acknowledged"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "complete_decision_log": {
      "owner": "agent",
      "pre": {
        "and": [
          "decision_log_started",
          "design_approved"
        ]
      },
      "add": [
        "decision_log_complete"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "brainstorm",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "escalate_multi_agent": [
            {
              "spawn": {
                "role": "reviewer"
              }
            },
            {
              "act": {
                "cap": "multi_agent_review",
                "by": "agent"
              }
            }
          ],
          "single_agent": [
            {
              "act": {
                "cap": "single_agent_review",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "complete_decision_log",
        "by": "agent"
      }
    },
    {
      "goal": {
        "and": [
          "design_approved",
          "decision_log_complete",
          "risks_acknowledged"
        ]
      }
    }
  ],
  "goal": {
    "and": [
      "design_approved",
      "decision_log_complete",
      "risks_acknowledged"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
