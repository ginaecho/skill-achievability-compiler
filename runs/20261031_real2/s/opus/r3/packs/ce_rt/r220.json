{
  "name": "options-flow-analyzer",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "cross_verify": {
      "owner": "agent",
      "pre": true,
      "add": [
        "cross_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_report": {
      "owner": "agent",
      "pre": {
        "and": [
          "chain_retrieved",
          "coverage_recorded"
        ]
      },
      "add": [
        "raw_and_filtered_reported",
        "assumptions_documented",
        "report_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "flag_anomalies": {
      "owner": "agent",
      "pre": {
        "and": [
          "report_written",
          "baseline_available"
        ]
      },
      "add": [
        "anomalies_flagged"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "retrieve_chain",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "cross_verify",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_report",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "history_exists": [
            {
              "act": {
                "cap": "fetch_baseline",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "flag_anomalies",
                "by": "agent"
              }
            }
          ],
          "no_history": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "raw_and_filtered_reported",
      "assumptions_documented",
      "report_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
