{
  "name": "aggregating-crypto-news",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {},
  "protocol": [
    {
      "act": {
        "cap": "run_aggregator",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "export": [
            {
              "act": {
                "cap": "export_results",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "news_aggregated",
      "articles_ranked"
    ]
  },
  "init_true": [
    "environment_ready"
  ],
  "init_constraints": []
}
