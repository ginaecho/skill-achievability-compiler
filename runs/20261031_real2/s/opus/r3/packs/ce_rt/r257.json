{
  "name": "prd-create",
  "roles": [
    "agent",
    "user",
    "reviewer"
  ],
  "capabilities": {
    "detect_forge": {
      "owner": "agent",
      "pre": true,
      "add": [
        "forge_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_issue": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:forge_account",
          "forge_known"
        ]
      },
      "add": [
        "issue_created",
        "prd_label_added"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_prd_file": {
      "owner": "agent",
      "pre": "issue_created",
      "add": [
        "prd_file_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "update_issue": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:forge_account",
          {
            "and": [
              "issue_created",
              "prd_file_created"
            ]
          }
        ]
      },
      "add": [
        "issue_linked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "commit_push": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:forge_account",
          {
            "and": [
              "prd_file_created",
              "issue_linked"
            ]
          }
        ]
      },
      "add": [
        "prd_committed",
        "prd_pushed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "send_uzi": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:uzi",
          "prd_pushed"
        ]
      },
      "add": [
        "sent_to_uzi"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "queue_sweep": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:forge_account",
          "needs:uzi",
          "prd_pushed"
        ]
      },
      "add": [
        "queued_for_sweep"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "detect_forge",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_issue",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_prd_file",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "update_issue",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "review": [
            {
              "spawn": {
                "role": "reviewer"
              }
            }
          ],
          "no_review": []
        }
      }
    },
    {
      "act": {
        "cap": "commit_push",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "start_now": [],
          "commit_for_later": [],
          "send_to_uzi": [
            {
              "act": {
                "cap": "send_uzi",
                "by": "agent"
              }
            }
          ],
          "queue_for_sweep": [
            {
              "act": {
                "cap": "queue_sweep",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "issue_created",
      "prd_label_added",
      "prd_file_created",
      "issue_linked",
      "prd_committed",
      "prd_pushed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
