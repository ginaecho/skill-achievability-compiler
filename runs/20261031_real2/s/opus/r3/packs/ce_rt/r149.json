{
  "name": "agent-roundtable",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "write_brief": {
      "owner": "agent",
      "pre": true,
      "add": [
        "brief_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_agents": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:agent_cli_logins"
        ]
      },
      "add": [
        "agents_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_debate": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:agent_cli_logins",
          {
            "and": [
              "brief_written",
              "agents_ready"
            ]
          }
        ]
      },
      "add": [
        "debate_concluded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_synthesis": {
      "owner": "agent",
      "pre": "debate_concluded",
      "add": [
        "synthesis_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "collect_veto": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:agent_cli_logins",
          "synthesis_written"
        ]
      },
      "add": [
        "veto_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fix_synthesis": {
      "owner": "agent",
      "pre": "veto_done",
      "add": [
        "synthesis_fixed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deliver_handoff": {
      "owner": "agent",
      "pre": {
        "and": [
          "synthesis_written",
          "veto_done"
        ]
      },
      "add": [
        "delivered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_brief",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_agents",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_debate",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_synthesis",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "collect_veto",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "approved": [],
          "objection": [
            {
              "act": {
                "cap": "fix_synthesis",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "handoff": [
            {
              "act": {
                "cap": "deliver_handoff",
                "by": "agent"
              }
            }
          ],
          "chat": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "synthesis_written",
      "veto_done"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
