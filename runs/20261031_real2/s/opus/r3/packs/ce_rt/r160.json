      "owner": "agent",
      "pre": true,
      "add": [
        "preflight_passed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_draft": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:openai_account",
          "preflight_passed"
        ]
      },
      "add": [
        "draft_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_final": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:openai_account",
          "draft_generated"
        ]
      },
      "add": [
        "final_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "show_image": {
      "owner": "agent",
      "pre": true,
      "add": [
        "result_shown"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "rec": {
        "name": "draft_loop",
        "body": [
          {
            "act": {
              "cap": "preflight_check",
              "by": "agent"
            }
          },
          {
