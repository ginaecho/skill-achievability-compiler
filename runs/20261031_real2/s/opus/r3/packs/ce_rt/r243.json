{
  "name": "agent-team",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "confirm_teams_enabled": {
      "owner": "agent",
      "pre": true,
      "add": [
        "teams_enabled"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "discover_repo": {
      "owner": "agent",
      "pre": {
        "and": [
          "teams_enabled",
          "version_ok"
        ]
      },
      "add": [
        "repo_discovered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "load_library": {
      "owner": "agent",
      "pre": "repo_discovered",
      "add": [
        "library_loaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_agent_files": {
      "owner": "agent",
      "pre": "library_loaded",
      "add": [
        "agents_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_manifest": {
      "owner": "agent",
      "pre": "library_loaded",
      "add": [
        "manifest_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "confirm_teams_enabled",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_cli_version",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "discover_repo",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "load_library",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "accept": [
            {
              "act": {
                "cap": "write_agent_files",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "write_manifest",
                "by": "agent"
              }
            }
          ],
          "decline": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "agents_written",
      "manifest_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
