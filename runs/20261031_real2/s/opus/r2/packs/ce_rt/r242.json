              }
            }
          ],
          "runtime": [
            {
              "act": {
                "cap": "rerun_runtime_poc",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "write_validate_record",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "manifest",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_checker",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "validate_written",
      "manifested",
      "checked"
    ]
  },
  "init_true": [
    "poc_supplied"
  ],
  "init_constraints": []
