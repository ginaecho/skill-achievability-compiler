{
  "name": "validate-bug",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "read_finding": {
      "owner": "agent",
      "pre": "poc_supplied",
      "add": [
        "inputs_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_validate_record": {
      "owner": "agent",
      "pre": "receipts_saved",
      "add": [
        "validate_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_finding",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
