{
  "name": "npm-trusted-publishing",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_config": {
      "owner": "agent",
      "pre": true,
      "add": [
        "repo_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "edit_workflow": {
      "owner": "agent",
      "pre": "repo_inspected",
      "add": [
        "oidc_permission",
        "registry_set",
        "npm_upgraded",
        "token_removed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fix_package_json": {
      "owner": "agent",
      "pre": "repo_inspected",
      "add": [
        "repository_matches"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "go_tokenless_apply": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:npm_registry",
          "repo_inspected"
        ]
      },
      "add": [
        "oidc_permission",
        "registry_set",
        "npm_upgraded",
        "token_removed",
        "repository_matches"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_config",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "manual": [
            {
              "act": {
                "cap": "edit_workflow",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "fix_package_json",
                "by": "agent"
              }
            }
          ],
          "automated": [
            {
              "act": {
                "cap": "go_tokenless_apply",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "create_trusted_publisher",
        "by": "user"
      }
    }
  ],
  "goal": {
    "and": [
      "oidc_permission",
      "registry_set",
      "npm_upgraded",
      "token_removed",
      "repository_matches",
      "trusted_publisher_set"
    ]
  },
  "init_true": [
    "package_exists"
  ],
  "init_constraints": []
}
