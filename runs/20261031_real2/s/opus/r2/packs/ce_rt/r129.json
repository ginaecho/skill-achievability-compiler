{
  "name": "java-debugging",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_evidence": {
      "owner": "agent",
      "pre": "reproduced",
      "add": [
        "evidence_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "remove_debug_flags": {
      "owner": "agent",
      "pre": "regression_test_added",
      "add": [
        "cleanup_done"
      ],
      "del": [
        "debug_agent_listening"
      ],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "reproduce",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_evidence",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "hypothesis",
        "body": [
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "logging": [
                  {
                    "act": {
                      "cap": "test_with_logging",
                      "by": "agent"
                    }
                  }
                ],
                "debugger": [
                  {
                    "act": {
                      "cap": "start_debug_jvm",
                      "by": "agent"
                    }
                  },
                  {
                    "act": {
                      "cap": "attach_debugger",
                      "by": "agent"
                    }
                  },
                  {
                    "act": {
                      "cap": "inspect_state",
                      "by": "agent"
                    }
                  }
                ]
              }
            }
          },
          {
            "continue": "hypothesis"
          }
        ]
      }
    },
    {
      "act": {
        "cap": "add_regression_test",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "remove_debug_flags",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "root_cause_found",
      "regression_test_added",
      "cleanup_done"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
