{
  "name": "options-flow-analyzer",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "verify_provider": {
      "owner": "agent",
      "pre": true,
      "add": [
        "provider_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_chain": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:provider_credential",
          "provider_verified"
        ]
      },
      "add": [
        "chain_retrieved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_baseline": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:provider_credential",
          "provider_verified"
        ]
      },
      "add": [
        "baseline_retrieved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "cross_verify": {
      "owner": "agent",
      "pre": true,
      "add": [
        "cross_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_report": {
      "owner": "agent",
      "pre": {
        "and": [
          "chain_retrieved",
          "baseline_retrieved",
          "cross_verified"
        ]
      },
      "add": [
        "report_written",
        "assumptions_documented",
        "raw_and_filtered_reported",
        "anomalies_flagged"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
