      "act": {
        "cap": "verify_provider",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_chain",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_baseline",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "cross_verify",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_report",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "report_written",
      "assumptions_documented",
      "raw_and_filtered_reported",
      "anomalies_flagged",
      "cross_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
