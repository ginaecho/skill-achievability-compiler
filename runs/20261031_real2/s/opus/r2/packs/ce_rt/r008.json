{
  "name": "better-auth-best-practices",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "scan_repo": {
      "owner": "agent",
      "pre": true,
      "add": [
        "project_detected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:package_registries"
        ]
      },
      "add": [
        "installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "set_env": {
      "owner": "agent",
      "pre": true,
      "add": [
        "env_set"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_server_config": {
      "owner": "agent",
      "pre": "installed",
      "add": [
        "config_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_route_handler": {
      "owner": "agent",
      "pre": "config_written",
      "add": [
        "route_handler_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_migration": {
      "owner": "agent",
      "pre": {
        "and": [
          "config_written",
          "env_set"
        ]
      },
      "add": [
        "schema_migrated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_auth_pages": {
      "owner": "agent",
      "pre": "route_handler_written",
      "add": [
        "pages_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_setup": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_servers",
          {
            "and": [
              "route_handler_written",
              "schema_migrated"
            ]
          }
        ]
      },
      "add": [
        "verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "scan_repo",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "set_env",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_server_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_route_handler",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_migration",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "with_pages": [
            {
              "act": {
                "cap": "write_auth_pages",
                "by": "agent"
              }
            }
          ],
          "config_only": []
        }
      }
    },
    {
      "act": {
        "cap": "verify_setup",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "installed",
      "env_set",
      "config_written",
      "route_handler_written",
      "schema_migrated",
      "verified"
    ]
  },
  "init_true": [
    "needs:package_registries",
    "needs:local_servers"
  ],
  "init_constraints": []
}
