{
  "name": "primer-design",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "setup_env": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:package_registries"
        ]
      },
      "add": [
        "env_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "design_primers": {
      "owner": "agent",
      "pre": {
        "and": [
          "env_ready",
          "reference_available"
        ]
      },
      "add": [
        "primers_designed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_thermodynamics": {
      "owner": "agent",
      "pre": "primers_designed",
      "add": [
        "thermodynamics_assessed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "screen_exhaustive": {
      "owner": "agent",
      "pre": "primers_designed",
      "add": [
        "specificity_screened"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "screen_blast": {
      "owner": "agent",
      "pre": "primers_designed",
      "add": [
        "specificity_screened"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deliver_report": {
      "owner": "agent",
      "pre": {
        "and": [
          "thermodynamics_assessed",
          "specificity_screened"
        ]
      },
      "add": [
        "report_delivered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "setup_env",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "design",
        "body": [
          {
            "act": {
              "cap": "design_primers",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "candidates_found": [],
                "no_candidates": [
                  {
                    "continue": "design"
                  }
                ]
              }
            }
          }
        ]
      }
    },
    {
      "act": {
        "cap": "check_thermodynamics",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "exhaustive_engine": [
            {
              "act": {
                "cap": "screen_exhaustive",
                "by": "agent"
              }
            }
          ],
          "blast_engine": [
            {
              "act": {
                "cap": "screen_blast",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "deliver_report",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "primers_designed",
      "thermodynamics_assessed",
      "specificity_screened",
      "report_delivered"
    ]
  },
  "init_true": [
    "reference_available",
    "needs:package_registries"
  ],
  "init_constraints": []
}
