{
  "name": "create-quarkus-project",
  "roles": [
    "agent"
  ],
  "capabilities": {},
  "protocol": [
    {
      "act": {
        "cap": "detect_env",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "cli": [
            {
              "act": {
                "cap": "install_cli",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "scaffold_cli",
                "by": "agent"
              }
            }
          ],
          "maven": [
            {
              "act": {
                "cap": "scaffold_maven",
                "by": "agent"
              }
            }
          ],
          "web": [
            {
              "act": {
                "cap": "scaffold_web",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "run_dev",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "project_created",
      "dev_mode_running"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
