{
  "name": "task-execution-engine",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "get_next_task": {
      "owner": "agent",
      "pre": "design_document_exists",
      "add": [
        "task_retrieved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_task": {
      "owner": "agent",
      "pre": "task_retrieved",
      "add": [
        "task_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_criteria": {
      "owner": "agent",
      "pre": "task_implemented",
      "add": [
        "criteria_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "mark_done": {
      "owner": "agent",
      "pre": "criteria_checked",
      "add": [
        "task_processed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "mark_failed": {
      "owner": "agent",
      "pre": "task_retrieved",
      "add": [
        "task_processed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "report_status": {
      "owner": "agent",
      "pre": "design_document_exists",
      "add": [
        "all_tasks_processed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "rec": {
        "name": "execute",
        "body": [
          {
            "act": {
              "cap": "get_next_task",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "external": true,
              "branches": {
                "task_remaining": [
                  {
                    "act": {
                      "cap": "implement_task",
                      "by": "agent"
                    }
                  },
                  {
                    "act": {
                      "cap": "verify_criteria",
                      "by": "agent"
                    }
                  },
                  {
                    "choice": {
                      "by": "agent",
                      "external": true,
                      "branches": {
                        "criteria_met": [
                          {
                            "act": {
                              "cap": "mark_done",
                              "by": "agent"
                            }
                          }
                        ],
                        "blocked": [
                          {
                            "act": {
                              "cap": "mark_failed",
                              "by": "agent"
                            }
                          }
                        ]
                      }
                    }
                  },
                  {
                    "continue": "execute"
                  }
                ],
                "none_left": [
                  {
                    "act": {
                      "cap": "report_status",
                      "by": "agent"
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "goal": "all_tasks_processed",
  "init_true": [
    "design_document_exists"
  ],
  "init_constraints": []
}
