{
  "name": "shopify-upgrade-migration",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_current_version": {
      "owner": "agent",
      "pre": true,
      "add": [
        "current_version_identified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_supported_versions": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:shopify_access_token",
          "current_version_identified"
        ]
      },
      "add": [
        "versions_available"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "migrate_rest_to_graphql": {
      "owner": "agent",
      "pre": "current_version_identified",
      "add": [
        "rest_migrated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "update_api_version": {
      "owner": "agent",
      "pre": "current_version_identified",
      "add": [
        "version_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "handle_breaking_changes": {
      "owner": "agent",
      "pre": "current_version_identified",
      "add": [
        "breaking_changes_addressed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_tests": {
      "owner": "agent",
      "pre": {
        "and": [
          "version_updated",
          "rest_migrated",
          "breaking_changes_addressed"
        ]
      },
      "add": [
        "tests_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_current_version",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "query_store": [
            {
              "act": {
                "cap": "check_supported_versions",
                "by": "agent"
              }
            }
          ],
          "skip_query": []
        }
      }
    },
    {
      "act": {
        "cap": "migrate_rest_to_graphql",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "update_api_version",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "handle_breaking_changes",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_tests",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "version_updated",
      "rest_migrated",
      "breaking_changes_addressed",
      "tests_pass"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
