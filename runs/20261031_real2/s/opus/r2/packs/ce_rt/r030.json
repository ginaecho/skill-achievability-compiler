{
  "name": "ts-quality-gates",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "inspect_repo": {
      "owner": "agent",
      "pre": true,
      "add": [
        "repo_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_oxlint": {
      "owner": "agent",
      "pre": "tools_installed",
      "add": [
        "oxlint_only_linter",
        "type_diagnostics_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_gates": {
      "owner": "agent",
      "pre": "tools_installed",
      "add": [
        "remaining_gates_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_orchestrator": {
      "owner": "agent",
      "pre": {
        "and": [
          "oxlint_only_linter",
          "remaining_gates_configured"
        ]
      },
      "add": [
        "orchestrator_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_hooks": {
      "owner": "agent",
      "pre": "orchestrator_written",
      "add": [
        "hooks_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_ci": {
      "owner": "agent",
      "pre": "orchestrator_written",
      "add": [
        "ci_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_repo",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_tools",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_oxlint",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_gates",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_orchestrator",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_hooks",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_ci",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_gate",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "oxlint_only_linter",
      "type_diagnostics_configured",
      "remaining_gates_configured",
      "hooks_configured",
      "ci_configured",
      "gate_passes"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
