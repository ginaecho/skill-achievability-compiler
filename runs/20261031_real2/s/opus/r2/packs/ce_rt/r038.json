{
  "name": "mageck",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "gather_design": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      },
      "add": [
        "contrast_defined"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "load_counts": {
      "owner": "agent",
      "pre": "contrast_defined",
      "add": [
        "counts_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "gather_design",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_inputs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_mageck",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "fastq": [
            {
              "act": {
                "cap": "count_reads",
                "by": "agent"
              }
            }
          ],
          "precounted": [
            {
              "act": {
                "cap": "load_counts",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "run_qc",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_test",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "counts_ready",
      "qc_done",
      "gene_results",
      "report_written"
    ]
  },
  "init_true": [
    "needs:user_conversation"
  ],
  "init_constraints": []
}
