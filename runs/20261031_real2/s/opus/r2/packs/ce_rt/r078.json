{
  "name": "commit-craft",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "plan_series": {
      "owner": "agent",
      "pre": true,
      "add": [
        "series_planned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "stage_group": {
      "owner": "agent",
      "pre": "series_planned",
      "add": [
        "group_staged"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scan_secrets": {
      "owner": "agent",
      "pre": "group_staged",
      "add": [
        "gate_passed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "lint_message": {
      "owner": "agent",
      "pre": "group_staged",
      "add": [
        "message_ok"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "commit_group": {
      "owner": "agent",
      "pre": {
        "and": [
          "gate_passed",
          "message_ok"
        ]
      },
      "add": [
        "series_committed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "lint_series": {
      "owner": "agent",
      "pre": "series_committed",
      "add": [
        "series_linted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_builds": {
      "owner": "agent",
      "pre": "series_committed",
      "add": [
        "builds_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "plan_series",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "groups",
        "body": [
          {
            "act": {
              "cap": "stage_group",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "scan_secrets",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "lint_message",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "commit_group",
              "by": "agent"
            }
          },
          {
            "continue": "groups"
          }
        ]
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "prepush": [
            {
              "act": {
                "cap": "lint_series",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "verify_builds",
                "by": "agent"
              }
            }
          ],
          "done": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "series_committed",
      "gate_passed",
      "message_ok"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
