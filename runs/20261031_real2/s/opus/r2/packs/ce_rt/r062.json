{
  "name": "nvshmem-troubleshoot-and-report-bugs",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "request_launch_evidence": {
      "owner": "agent",
      "pre": true,
      "add": [
        "command_and_output"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scan_for_info_logging": {
      "owner": "agent",
      "pre": "command_and_output",
      "add": [
        "info_logs"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "request_debug_rerun": {
      "owner": "agent",
      "pre": "command_and_output",
      "add": [
        "info_logs"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "note_prestart_exception": {
      "owner": "agent",
      "pre": "command_and_output",
      "add": [
        "prestart_exception"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_evidence_record": {
      "owner": "agent",
      "pre": {
        "and": [
          "command_and_output",
          {
            "or": [
              "info_logs",
              "prestart_exception"
            ]
          }
        ]
      },
      "add": [
        "evidence_record"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_version": {
      "owner": "agent",
      "pre": "evidence_record",
      "add": [
        "version_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "request_launch_evidence",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "info_logs_present": [
            {
              "act": {
                "cap": "scan_for_info_logging",
                "by": "agent"
              }
            }
          ],
          "needs_debug_rerun": [
            {
              "act": {
                "cap": "request_debug_rerun",
                "by": "agent"
              }
            }
          ],
          "prestart_failure": [
            {
              "act": {
                "cap": "note_prestart_exception",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "build_evidence_record",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_version",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "prepare_report": [
            {
              "act": {
                "cap": "request_debug_rerun",
                "by": "agent"
              }
            }
          ],
          "no_report": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "evidence_record",
      {
        "or": [
          "info_logs",
          "prestart_exception"
        ]
      }
    ]
  },
  "init_true": [],
  "init_constraints": []
}
