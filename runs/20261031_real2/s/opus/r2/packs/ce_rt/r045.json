{
  "name": "qiime2-amplicon",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "validate_inputs": {
      "owner": "agent",
      "pre": {
        "and": [
          "inputs_present",
          {
            "cmp": [
              {
                "-": [
                  {
                    "+": [
                      "trunc_f",
                      "trunc_r"
                    ]
                  },
                  "maximum_insert_length"
                ]
              },
              ">=",
              12
            ]
          }
        ]
      },
      "add": [
        "validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_workflow": {
      "owner": "agent",
      "pre": {
        "and": [
          "validated",
          "qiime_installed",
          "classifier_ready"
        ]
      },
      "add": [
        "asvs_produced",
        "taxonomy_produced",
        "provenance_retained"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "validate_inputs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_workflow",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "asvs_produced",
      "taxonomy_produced",
      "provenance_retained"
    ]
  },
  "init_true": [
    "inputs_present",
    "qiime_installed",
    "classifier_ready"
  ],
  "init_constraints": [
    {
      "cmp": [
        "trunc_f",
        "==",
        220
      ]
    },
    {
      "cmp": [
        "trunc_r",
        "==",
        200
      ]
    },
    {
      "cmp": [
        "maximum_insert_length",
        "==",
        300
      ]
    }
  ]
}
