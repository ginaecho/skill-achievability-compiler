{
  "name": "mcp-oauth-triage",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "collect_artifacts": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      },
      "add": [
        "artifacts_collected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "apply_fix": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "fault_classified"
        ]
      },
      "add": [
        "fix_applied"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "collect_artifacts",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_classifier",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "apply_fix",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_roundtrip",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "fault_classified",
      "fix_applied",
      "fix_verified"
    ]
  },
  "init_true": [
    "needs:local_filesystem"
  ],
  "init_constraints": []
}
