{
  "name": "youtube-transcript",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "install_ytdlp": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:package_registries"
        ]
      },
      "add": [
        "ytdlp_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "extract_transcript": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet",
          {
            "and": [
              "ytdlp_installed",
              "subtitles_available"
            ]
          }
        ]
      },
      "add": [
        "transcript_saved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deduplicate_transcript": {
      "owner": "agent",
      "pre": "transcript_saved",
      "add": [
        "deduplicated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_ytdlp",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "extract_transcript",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "deduplicate": [
            {
              "act": {
                "cap": "deduplicate_transcript",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": "transcript_saved",
  "init_true": [
    "subtitles_available",
    "needs:package_registries",
    "needs:public_internet"
  ],
  "init_constraints": []
}
