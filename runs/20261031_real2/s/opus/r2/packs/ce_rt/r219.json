{
  "name": "n8n-multi-instance",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {},
  "protocol": [
    {
      "act": {
        "cap": "list_instances",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "switch_instance",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_current",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "confirm": [
            {
              "act": {
                "cap": "write_credential",
                "by": "agent"
              }
            }
          ],
          "decline": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "credential_written",
      "current_verified",
      "bound_to_target"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
