{
  "name": "ai-sre-incident-response",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_provider_status": {
      "owner": "agent",
      "pre": "alert_acknowledged",
      "add": [
        "provider_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "acknowledge_alert",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_provider_status",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "provider_down": [
            {
              "act": {
                "cap": "enable_fallback",
                "by": "agent"
              }
            }
          ],
          "self_hosted_down": [
            {
              "act": {
                "cap": "restart_inference",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "verify_traffic",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "communicate_eta",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_smoke_tests",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "service_restored",
      "traffic_verified",
      "eta_communicated",
      "smoke_tests_pass"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
