{
  "name": "azure-logic-apps-standard-cli",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_tooling": {
      "owner": "agent",
      "pre": true,
      "add": [
        "tooling_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_extension": {
      "owner": "agent",
      "pre": "tooling_verified",
      "add": [
        "extension_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scaffold_project": {
      "owner": "agent",
      "pre": {
        "and": [
          "tooling_verified",
          "extension_installed"
        ]
      },
      "add": [
        "project_created",
        "secrets_excluded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_workflow": {
      "owner": "agent",
      "pre": "project_created",
      "add": [
        "workflow_authored"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_local_identity": {
      "owner": "agent",
      "pre": "project_created",
      "add": [
        "local_identity_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_workflow": {
      "owner": "agent",
      "pre": "workflow_authored",
      "add": [
        "validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_full_strict": {
      "owner": "agent",
      "pre": {
        "and": [
          "workflow_authored",
          "validated",
          "local_identity_configured",
          "secrets_excluded"
        ]
      },
      "add": [
        "strict_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "enable_app_identity": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:azure_account",
          "strict_validated"
        ]
      },
      "add": [
        "app_identity_enabled"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_app": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:azure_account",
          {
            "and": [
              "strict_validated",
              "app_identity_enabled"
            ]
          }
        ]
      },
      "add": [
        "deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_tooling",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "install": [
            {
              "act": {
                "cap": "install_extension",
                "by": "agent"
              }
            }
          ],
          "already_present": []
        }
      }
    },
    {
      "act": {
        "cap": "scaffold_project",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_workflow",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_local_identity",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_workflow",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_full_strict",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "deploy_to_cloud": [
            {
              "act": {
                "cap": "enable_app_identity",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "deploy_app",
                "by": "agent"
              }
            }
          ],
          "local_only": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "project_created",
      "workflow_authored",
      "local_identity_configured",
      "strict_validated"
    ]
  },
  "init_true": [
    "extension_installed"
  ],
  "init_constraints": []
}
