        ]
      },
      "add": [
        "images_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_llm_cli": {
      "owner": "agent",
      "pre": true,
      "add": [
        "llm_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "select_best": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:openrouter_account",
