    "download_images": {
      "owner": "agent",
      "pre": "images_found",
      "add": [
        "images_downloaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "simple_query": [],
          "batch_config": []
        }
      }
    },
    {
      "act": {
        "cap": "search_images",
