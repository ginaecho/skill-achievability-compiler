{
  "name": "microsoft-store-publisher",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "reserve_product": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:partner_center_account"
        ]
      },
      "add": [
        "product_reserved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "capture_identity": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:partner_center_account",
          "product_reserved"
        ]
      },
      "add": [
        "identity_captured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "complete_sections": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:partner_center_account",
          {
            "and": [
              "package_built",
              "identity_captured"
            ]
          }
        ]
      },
      "add": [
        "sections_complete",
        "package_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "accept_agreement": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:partner_center_account"
        ]
      },
      "add": [
        "agreement_accepted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "submit_certification": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:partner_center_account",
          {
            "and": [
              "sections_complete",
              "package_validated",
              "wack_passed"
            ]
          }
        ]
      },
      "add": [
        "in_certification"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "monitor_status": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:partner_center_account",
          "in_certification"
        ]
      },
      "add": [
        "published"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_store_url": {
      "owner": "agent",
      "pre": "published",
      "add": [
        "url_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "reserve_product",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "capture_identity",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_package",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "inspect_msix",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_wack",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "complete_sections",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "agreement_shown": [
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "accept": [
                    {
                      "act": {
                        "cap": "accept_agreement",
                        "by": "agent"
                      }
                    }
                  ],
                  "refuse": []
                }
              }
            }
          ],
          "no_agreement": []
        }
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "approve_submit": [
            {
              "act": {
                "cap": "submit_certification",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "monitor_status",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "verify_store_url",
                "by": "agent"
              }
            }
          ],
          "decline": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "in_certification",
      "sections_complete",
      "package_validated",
      "wack_passed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
