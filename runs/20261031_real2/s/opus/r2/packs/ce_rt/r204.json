{
  "name": "git-analyzer",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {},
  "protocol": [
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "summary": [
            {
              "act": {
                "cap": "analyze_repo",
                "by": "agent"
              }
            }
          ],
          "status": [
            {
              "act": {
                "cap": "get_changed_files",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "or": [
      "repo_analyzed",
      "status_checked"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
