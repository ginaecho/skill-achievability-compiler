          "needs:docker",
          "logging_enabled"
        ]
      },
      "add": [
        "statements_measured",
        "problem_diagnosed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "apply_fix": {
      "owner": "agent",
      "pre": "problem_diagnosed",
      "add": [
        "fix_applied"
      ],
      "del": [],
