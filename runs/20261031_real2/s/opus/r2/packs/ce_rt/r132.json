      "pre": true,
      "add": [
        "stack_detected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "enable_sql_logging": {
      "owner": "agent",
      "pre": "stack_detected",
      "add": [
        "logging_enabled"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "measure_statements": {
      "owner": "agent",
      "pre": {
