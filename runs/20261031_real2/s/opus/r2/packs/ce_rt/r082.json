{
  "name": "month-end-close",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "plan_calendar": {
      "owner": "agent",
      "pre": "inputs_provided",
      "add": [
        "calendar_planned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {
        "critical_path_wd": {
          "cmp": [
            "critical_path_wd",
            "<=",
            "target_wd"
          ]
        }
      }
    },
    "reconcile_accounts": {
      "owner": "agent",
      "pre": "inputs_provided",
      "add": [
        "reconciliation_proven"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "analyze_flux": {
      "owner": "agent",
      "pre": "inputs_provided",
      "add": [
        "flux_complete"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "plan_calendar",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "reconcile_accounts",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "analyze_flux",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "calendar_planned",
      "reconciliation_proven",
      "flux_complete",
      {
        "cmp": [
          "critical_path_wd",
          "<=",
          "target_wd"
        ]
      }
    ]
  },
  "init_true": [
    "inputs_provided"
  ],
  "init_constraints": [
    {
      "cmp": [
        "target_wd",
        "==",
        5
      ]
    },
    {
      "cmp": [
        "critical_path_wd",
        "==",
        0
      ]
    }
  ]
}
