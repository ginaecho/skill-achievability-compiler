{
  "name": "workers-profiling",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "fetch_guide": {
      "owner": "agent",
      "pre": true,
      "add": [
        "guide_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "confirm_target": {
      "owner": "agent",
      "pre": true,
      "add": [
        "target_confirmed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_cf": {
      "owner": "agent",
      "pre": true,
      "add": [
        "cf_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "capture_profile": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:cloudflare_account",
          {
            "and": [
              "guide_read",
              "target_confirmed",
              "cf_installed"
            ]
          }
        ]
      },
      "add": [
        "profile_captured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "analyze_pprof": {
      "owner": "agent",
      "pre": "profile_captured",
      "add": [
        "hotspots_identified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "fetch_guide",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "confirm_target",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "install": [
            {
              "act": {
                "cap": "install_cf",
                "by": "agent"
              }
            }
          ],
          "already_present": []
        }
      }
    },
    {
      "act": {
        "cap": "capture_profile",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "analyze_pprof",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "profile_captured",
      "hotspots_identified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
