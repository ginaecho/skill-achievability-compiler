{
  "name": "upgrade-advisor",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "discover_version": {
      "owner": "agent",
      "pre": true,
      "add": [
        "current_version_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "find_latest": {
      "owner": "agent",
      "pre": true,
      "add": [
        "latest_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_changelog": {
      "owner": "agent",
      "pre": {
        "and": [
          "current_version_found",
          "latest_found"
        ]
      },
      "add": [
        "changelog_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "cross_reference_usage": {
      "owner": "agent",
      "pre": "changelog_read",
      "add": [
        "usage_classified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_downstream": {
      "owner": "agent",
      "pre": "latest_found",
      "add": [
        "downstream_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_report": {
      "owner": "agent",
      "pre": {
        "and": [
          "usage_classified",
          "downstream_checked"
        ]
      },
      "add": [
        "report_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "discover_version",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "find_latest",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_changelog",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "cross_reference_usage",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_downstream",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_report",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "apply": [
            {
              "act": {
                "cap": "apply_upgrade",
                "by": "agent"
              }
            }
          ],
          "investigate_only": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "report_written",
      "current_version_found",
      "latest_found",
      "changelog_read",
      "usage_classified",
      "downstream_checked"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
