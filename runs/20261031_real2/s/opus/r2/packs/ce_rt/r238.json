{
  "name": "regression-hunt",
  "roles": [
    "coordinator",
    "stage_agent"
  ],
  "capabilities": {
    "obtain_inputs": {
      "owner": "coordinator",
      "pre": true,
      "add": [
        "inputs_obtained"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_standard": {
      "owner": "coordinator",
      "pre": true,
      "add": [
        "standard_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "init_campaign": {
      "owner": "coordinator",
      "pre": {
        "and": [
          "inputs_obtained",
          "standard_read"
        ]
      },
      "add": [
        "campaign_initialized"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "freeze_guidance": {
      "owner": "coordinator",
      "pre": "campaign_initialized",
      "add": [
        "guidance_frozen"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "reserve_assignment": {
      "owner": "coordinator",
      "pre": "guidance_frozen",
      "add": [
        "assignment_reserved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "bind_launch_evidence": {
      "owner": "coordinator",
      "pre": "assignment_reserved",
      "add": [
        "launch_bound"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "accept_record": {
      "owner": "coordinator",
      "pre": "launch_bound",
      "add": [
        "records_accepted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "produce_reports": {
      "owner": "coordinator",
      "pre": "records_accepted",
      "add": [
        "reports_produced"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "obtain_inputs",
        "by": "coordinator"
      }
    },
    {
      "act": {
        "cap": "read_standard",
        "by": "coordinator"
      }
    },
    {
      "act": {
        "cap": "init_campaign",
        "by": "coordinator"
      }
    },
    {
      "act": {
        "cap": "freeze_guidance",
        "by": "coordinator"
      }
    },
    {
      "rec": {
        "name": "dispatch",
        "body": [
          {
            "act": {
              "cap": "reserve_assignment",
              "by": "coordinator"
            }
          },
          {
            "act": {
              "cap": "bind_launch_evidence",
              "by": "coordinator"
            }
          },
          {
            "spawn": {
              "role": "stage_agent"
            }
          },
          {
            "act": {
              "cap": "accept_record",
              "by": "coordinator"
            }
          },
          {
            "continue": "dispatch"
          }
        ]
      }
    },
    {
      "spawn": {
        "role": "stage_agent"
      }
    },
    {
      "act": {
        "cap": "produce_reports",
        "by": "coordinator"
      }
    }
  ],
  "goal": {
    "and": [
      "campaign_initialized",
      "records_accepted",
      "reports_produced"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
