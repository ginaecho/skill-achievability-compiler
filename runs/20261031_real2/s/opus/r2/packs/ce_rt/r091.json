{
  "name": "link-building",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_marketing_context": {
      "owner": "agent",
      "pre": true,
      "add": [
        "context_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "gather_context": {
      "owner": "agent",
      "pre": true,
      "add": [
        "context_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "link_gap": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:backlink_tool",
          "context_gathered"
        ]
      },
      "add": [
        "gap_assessed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "prospect": {
      "owner": "agent",
      "pre": "gap_assessed",
      "add": [
        "prospects_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "find_contact": {
      "owner": "agent",
      "pre": "prospects_found",
      "add": [
        "contacts_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deliver_plan": {
      "owner": "agent",
      "pre": {
        "and": [
          "gap_assessed",
          "prospects_found",
          "contacts_found"
        ]
      },
      "add": [
        "plan_delivered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "pm_context_exists": [
            {
              "act": {
                "cap": "read_marketing_context",
                "by": "agent"
              }
            }
          ],
          "no_pm_context": []
        }
      }
    },
    {
      "act": {
        "cap": "gather_context",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "link_gap",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "prospect",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "find_contact",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "deliver_plan",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "approve_and_send": [
            {
              "act": {
                "cap": "send_outreach",
                "by": "agent"
              }
            }
          ],
          "hold": []
        }
      }
    }
  ],
  "goal": "plan_delivered",
  "init_true": [],
  "init_constraints": []
}
