{
  "name": "protocol-reverse-engineering",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "capture_traffic": {
      "owner": "agent",
      "pre": true,
      "add": [
        "traffic_captured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "analyze_capture": {
      "owner": "agent",
      "pre": "traffic_captured",
      "add": [
        "structure_mapped",
        "fields_identified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "document_protocol": {
      "owner": "agent",
      "pre": {
        "and": [
          "structure_mapped",
          "fields_identified"
        ]
      },
      "add": [
        "protocol_documented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_parser": {
      "owner": "agent",
      "pre": "protocol_documented",
      "add": [
        "parser_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_parser": {
      "owner": "agent",
      "pre": {
        "and": [
          "parser_implemented",
          "traffic_captured"
        ]
      },
      "add": [
        "parser_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fuzz_test": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:target_service",
          "protocol_documented"
        ]
      },
      "add": [
        "edge_cases_tested"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "capture_traffic",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "analyze_capture",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "document_protocol",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "implement_parser",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_parser",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "fuzz": [
            {
              "act": {
                "cap": "fuzz_test",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "traffic_captured",
      "structure_mapped",
      "fields_identified",
      "protocol_documented",
      "parser_validated"
    ]
