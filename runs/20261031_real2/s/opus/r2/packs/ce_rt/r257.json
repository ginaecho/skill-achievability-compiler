                "cap": "commit_push",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "send_to_uzi",
                "by": "agent"
              }
            }
          ],
          "queue_sweep": [
            {
              "act": {
                "cap": "commit_push",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "queue_sweep",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "issue_created",
      "prd_file_written",
      "issue_linked"
