      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "queue_sweep": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:forge_account",
          "prd_pushed"
        ]
      },
      "add": [
        "queued_for_sweep"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "detect_forge",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_issue",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_prd",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "update_issue",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "review": [
            {
              "spawn": {
                "role": "reviewer"
              }
            }
          ],
          "no_review": []
        }
      }
    },
    {
