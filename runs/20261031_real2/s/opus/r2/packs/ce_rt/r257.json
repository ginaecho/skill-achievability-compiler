      "pre": true,
      "add": [
        "forge_detected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_issue": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:forge_account",
          "forge_detected"
        ]
      },
      "add": [
        "issue_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_prd": {
      "owner": "agent",
      "pre": "issue_created",
      "add": [
        "prd_file_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "update_issue": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:forge_account",
          "prd_file_written"
        ]
      },
      "add": [
        "issue_linked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "commit_push": {
      "owner": "agent",
