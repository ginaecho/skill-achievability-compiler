{
  "name": "py-quality-gates",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "assess_repo": {
      "owner": "agent",
      "pre": true,
      "add": [
        "repo_assessed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_dev_deps": {
      "owner": "agent",
      "pre": "repo_assessed",
      "add": [
        "deps_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_prek": {
      "owner": "agent",
      "pre": true,
      "add": [
        "prek_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_tool_configs": {
      "owner": "agent",
      "pre": "repo_assessed",
      "add": [
        "configs_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_check_sh": {
      "owner": "agent",
      "pre": "configs_written",
      "add": [
        "check_sh_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_precommit_config": {
      "owner": "agent",
      "pre": "check_sh_created",
      "add": [
        "precommit_config_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "wire_git_hooks": {
      "owner": "agent",
      "pre": {
        "and": [
          "prek_installed",
          "precommit_config_created"
        ]
      },
      "add": [
        "hooks_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "update_claude_md": {
      "owner": "agent",
      "pre": true,
      "add": [
        "claude_md_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_gates": {
      "owner": "agent",
      "pre": {
        "and": [
          "check_sh_created",
          "deps_installed"
        ]
      },
      "add": [
        "gates_run"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "auto_fix": {
      "owner": "agent",
      "pre": "check_sh_created",
      "add": [
        "fixes_applied"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "assess_repo",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_dev_deps",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_prek",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_tool_configs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_check_sh",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_precommit_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "wire_git_hooks",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "update_claude_md",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "fix",
        "body": [
          {
            "act": {
              "cap": "run_gates",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "issues": [
                  {
                    "act": {
                      "cap": "auto_fix",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "fix"
                  }
                ],
                "clean": []
              }
            }
          }
        ]
      }
    }
  ],
  "goal": {
    "and": [
      "deps_installed",
      "configs_written",
      "check_sh_created",
      "precommit_config_created",
      "hooks_installed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
