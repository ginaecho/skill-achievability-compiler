{
  "name": "ai-debt-detector",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_sources": {
      "owner": "agent",
      "pre": true,
      "add": [
        "code_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_dependencies": {
      "owner": "agent",
      "pre": "code_read",
      "add": [
        "deps_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "apply_fix": {
      "owner": "agent",
      "pre": "code_read",
      "add": [
        "debt_fixed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
