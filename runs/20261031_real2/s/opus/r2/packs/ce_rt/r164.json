{
  "name": "open-knowledge-vault",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_vault": {
      "owner": "agent",
      "pre": true,
      "add": [
        "vault_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "init_bundle": {
      "owner": "agent",
      "pre": "vault_inspected",
      "add": [
        "bundle_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_notes": {
      "owner": "agent",
      "pre": "vault_inspected",
      "add": [
        "notes_curated",
        "sources_attached"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "audit_vault": {
      "owner": "agent",
      "pre": "notes_curated",
      "add": [
        "structure_valid"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_dataview": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:dataview_plugin_build",
          "structure_valid"
        ]
      },
      "add": [
        "dataview_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_vault",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "new_bundle": [
            {
              "act": {
                "cap": "init_bundle",
                "by": "agent"
              }
            }
          ],
          "existing_vault": []
        }
      }
    },
    {
      "act": {
        "cap": "write_notes",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "audit_vault",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "with_dataview": [
            {
              "act": {
                "cap": "install_dataview",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "verify_dataview",
                "by": "agent"
              }
            }
          ],
          "skip_dataview": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "notes_curated",
      "sources_attached",
      "structure_valid"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
