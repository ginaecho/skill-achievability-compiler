{
  "name": "adjudicate-regression",
  "roles": [
    "agent",
    "caller"
  ],
  "capabilities": {
    "verify_seals": {
      "owner": "agent",
      "pre": true,
      "add": [
        "seals_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "inspect_evidence": {
      "owner": "agent",
      "pre": "seals_verified",
      "add": [
        "evidence_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_known_findings": {
      "owner": "agent",
      "pre": "evidence_inspected",
      "add": [
        "novelty_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_decision": {
      "owner": "agent",
      "pre": "evidence_inspected",
      "add": [
        "decision_written",
        "evidence_cited"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "seal_decision": {
      "owner": "agent",
      "pre": "decision_written",
      "add": [
        "decision_sealed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "verify_seals",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "inspect_evidence",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "confirm": [
            {
              "act": {
                "cap": "check_known_findings",
                "by": "agent"
              }
            }
          ],
          "exclude_or_unresolved": []
        }
      }
    },
    {
      "act": {
        "cap": "write_decision",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "seal_decision",
        "by": "agent"
      }
    },
    {
      "msg": {
        "from": "agent",
        "to": "caller",
        "label": "report"
      }
    }
  ],
  "goal": {
    "and": [
      "decision_written",
      "decision_sealed",
      "evidence_cited"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
