{
  "name": "better-auth-security-best-practices",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "gather_requirements": {
      "owner": "agent",
      "pre": true,
      "add": [
        "requirements_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_config": {
      "owner": "agent",
      "pre": "config_exists",
      "add": [
        "config_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "harden_config": {
      "owner": "agent",
      "pre": {
        "and": [
          "config_read",
          "requirements_gathered"
        ]
      },
      "add": [
        "secret_configured",
        "rate_limiting_enabled",
        "csrf_enabled",
        "trusted_origins_set",
        "sessions_secured",
        "cookies_secured",
        "oauth_tokens_encrypted",
        "ip_tracking_configured",
        "audit_logging_added"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "gather_requirements",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "harden_config",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "secret_configured",
      "rate_limiting_enabled",
      "csrf_enabled",
      "trusted_origins_set",
      "sessions_secured",
      "cookies_secured",
      "oauth_tokens_encrypted",
      "ip_tracking_configured",
      "audit_logging_added"
    ]
  },
  "init_true": [
    "config_exists"
  ],
  "init_constraints": []
}
