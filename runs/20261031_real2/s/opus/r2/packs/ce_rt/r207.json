{
  "name": "agentic-verify",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "write_test": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      },
      "add": [
        "tests_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_test",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "base_check",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "close_gaps",
        "body": [
          {
            "act": {
              "cap": "verify",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "external": true,
              "branches": {
                "verified": [],
                "incomplete": [],
                "no_change": [],
                "gaps": [
                  {
                    "act": {
                      "cap": "write_test",
                      "by": "agent"
                    }
                  },
                  {
                    "act": {
                      "cap": "replay",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "close_gaps"
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "goal": {
    "and": [
      "mutants_killed",
      "fails_on_old_code"
    ]
  },
  "init_true": [
    "code_changed",
    "needs:local_filesystem"
  ],
  "init_constraints": []
}
