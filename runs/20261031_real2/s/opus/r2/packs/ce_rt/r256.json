    "commit_changes": {
      "owner": "agent",
      "pre": "prd_archived",
      "add": [
        "committed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "push_changes": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:git_remote",
          "committed"
        ]
      },
      "add": [
        "pushed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
