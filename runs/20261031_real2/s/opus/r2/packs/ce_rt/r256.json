      "owner": "agent",
      "pre": "prd_file_exists",
      "add": [
        "prd_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "update_prd_file": {
      "owner": "agent",
      "pre": "prd_read",
      "add": [
        "prd_metadata_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "archive_prd": {
      "owner": "agent",
      "pre": "prd_metadata_updated",
      "add": [
        "prd_archived"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "reopen_issue": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:github_account"
        ]
      },
      "add": [
