{
  "name": "connectivity-triage",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {},
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "lan_target_known": [
            {
              "act": {
                "cap": "check_lan",
                "by": "agent"
              }
            }
          ],
          "no_lan_target": []
        }
      }
    },
    {
      "act": {
        "cap": "inspect_resolver",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "query_dns",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "probe_path",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "process_specific": [
            {
              "act": {
                "cap": "inspect_app_activity",
                "by": "agent"
              }
            }
          ],
          "not_process_specific": []
        }
      }
    },
    {
      "act": {
        "cap": "time_http_path",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "dns_config_checked",
      "dns_resolved",
      "path_checked",
      "app_timed"
    ]
  },
  "init_true": [
    "symptom_defined"
  ],
  "init_constraints": []
}
