{
  "name": "shopify-development",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "install_cli": {
      "owner": "agent",
      "pre": true,
      "add": [
        "cli_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scaffold_app": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:shopify_partner_account",
          "cli_installed"
        ]
      },
      "add": [
        "app_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_app": {
      "owner": "agent",
      "pre": "app_created",
      "add": [
        "scopes_configured",
        "webhooks_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_extension": {
      "owner": "agent",
      "pre": "app_created",
      "add": [
        "extension_added"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_dev": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:shopify_dev_store",
          "app_created"
        ]
      },
      "add": [
        "app_tested"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_app": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:shopify_partner_account",
          {
            "and": [
              "extension_added",
              "scopes_configured"
            ]
          }
        ]
      },
      "add": [
        "app_deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "query_graphql": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:shopify_admin_token",
          "app_deployed"
        ]
      },
      "add": [
        "data_integrated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_cli",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "scaffold_app",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_app",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_extension",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_dev",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "deploy_app",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "integrate_data": [
            {
              "act": {
                "cap": "query_graphql",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "app_deployed",
      "extension_added",
      "scopes_configured"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
