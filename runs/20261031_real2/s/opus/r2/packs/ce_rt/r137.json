{
  "name": "markdown-to-word-mermaid",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "check_output_free": {
      "owner": "agent",
      "pre": true,
      "add": [
        "output_path_free"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_python_deps": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:package_registries"
        ]
      },
      "add": [
        "python_deps_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "detect_mermaid_cli": {
      "owner": "agent",
      "pre": true,
      "add": [
        "mermaid_cli_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_mermaid_cli": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:package_registries"
        ]
      },
      "add": [
        "mermaid_cli_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_converter": {
      "owner": "agent",
      "pre": {
        "and": [
          "output_path_free",
          "python_deps_ready",
          "mermaid_cli_ready"
        ]
      },
      "add": [
        "docx_created",
        "svg_embedded",
        "png_fallback"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_package": {
      "owner": "agent",
      "pre": "docx_created",
      "add": [
        "package_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_output_free",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_python_deps",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "reuse_cli": [
            {
              "act": {
                "cap": "detect_mermaid_cli",
                "by": "agent"
              }
            }
          ],
          "install_cli": [
            {
              "act": {
                "cap": "install_mermaid_cli",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "run_converter",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_package",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "word_available": [
            {
              "act": {
                "cap": "inspect_in_word",
                "by": "agent"
              }
            }
          ],
          "no_word": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "docx_created",
      "svg_embedded",
      "png_fallback",
      "package_verified"
    ]
  },
  "init_true": [
    "needs:package_registries"
  ],
  "init_constraints": []
}
