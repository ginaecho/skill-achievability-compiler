{
  "name": "fowler-refactoring",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "build_tests": {
      "owner": "agent",
      "pre": true,
      "add": [
        "baseline_tests"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_tests": {
      "owner": "agent",
      "pre": "baseline_tests",
      "add": [
        "tests_green"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "refactor_step": {
      "owner": "agent",
      "pre": "baseline_tests",
      "add": [
        "refactored"
      ],
      "del": [
        "tests_green"
      ],
      "assigns": {},
      "nondet": {}
    },
    "revert": {
      "owner": "agent",
      "pre": "baseline_tests",
      "add": [
        "tests_green"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "build_tests",
        "by": "agent"
      }
    },
    {
      "act": {
