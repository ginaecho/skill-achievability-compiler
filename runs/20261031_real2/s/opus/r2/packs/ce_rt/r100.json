          "needs:package_registries"
        ]
      },
      "add": [
        "lightning_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_training_code": {
      "owner": "agent",
      "pre": true,
      "add": [
        "code_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "train_model": {
