{
  "name": "rust-quality-gates",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "assess_repo": {
      "owner": "agent",
      "pre": "rust_repo",
      "add": [
        "repo_assessed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_tools": {
      "owner": "agent",
      "pre": "repo_assessed",
      "add": [
        "tools_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_clippy_config": {
      "owner": "agent",
      "pre": "repo_assessed",
      "add": [
        "clippy_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_rustfmt_config": {
      "owner": "agent",
      "pre": "repo_assessed",
      "add": [
        "rustfmt_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_check_script": {
      "owner": "agent",
      "pre": "repo_assessed",
      "add": [
        "check_script_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_precommit_config": {
      "owner": "agent",
      "pre": "check_script_created",
      "add": [
        "precommit_config_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_hooks": {
      "owner": "agent",
      "pre": "precommit_config_written",
      "add": [
        "hooks_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_gates": {
      "owner": "agent",
      "pre": {
        "and": [
          "tools_installed",
          "check_script_created",
          "precommit_config_written"
        ]
      },
      "add": [
        "gates_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fix_issues": {
      "owner": "agent",
      "pre": "repo_assessed",
      "add": [],
      "del": [
        "gates_pass"
      ],
      "assigns": {},
      "nondet": {}
    },
    "document_gates": {
      "owner": "agent",
      "pre": "repo_assessed",
      "add": [
        "docs_documented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "assess_repo",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_tools",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_clippy_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_rustfmt_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_check_script",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_precommit_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_hooks",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "first_run",
        "body": [
          {
            "act": {
              "cap": "run_gates",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "external": true,
              "branches": {
                "needs_fixes": [
                  {
                    "act": {
                      "cap": "fix_issues",
                      "by": "agent"
                    }
                  },
                  {
                    "act": {
                      "cap": "run_gates",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "first_run"
                  }
                ],
                "clean": []
              }
            }
          }
        ]
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "document": [
            {
              "act": {
                "cap": "document_gates",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "clippy_configured",
      "rustfmt_configured",
      "check_script_created",
      "precommit_config_written",
      "hooks_installed",
      "gates_pass"
    ]
  },
  "init_true": [
    "rust_repo"
  ],
  "init_constraints": []
}
