{
  "name": "ai-testing",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_code": {
      "owner": "agent",
      "pre": true,
      "add": [
        "code_understood"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_test": {
      "owner": "agent",
      "pre": "code_understood",
      "add": [
        "test_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fix_test": {
      "owner": "agent",
      "pre": "test_written",
      "add": [],
      "del": [
        "tests_pass"
      ],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_test",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "verify",
        "body": [
          {
            "act": {
              "cap": "run_tests",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "external": true,
              "branches": {
                "failing": [
                  {
                    "act": {
                      "cap": "fix_test",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "verify"
                  }
                ],
                "passing": []
              }
            }
          }
        ]
      }
    }
  ],
  "goal": {
    "and": [
      "test_written",
      "tests_pass"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
