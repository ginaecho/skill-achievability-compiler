{
  "name": "runapi-cli",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "install_cli": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:internet_access"
        ]
      },
      "add": [
        "cli_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "authenticate": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:runapi_api_key",
          "cli_installed"
        ]
      },
      "add": [
        "authenticated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "inspect_help": {
      "owner": "agent",
      "pre": "cli_installed",
      "add": [
        "fields_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_model": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:runapi_account",
          {
            "and": [
              "authenticated",
              "fields_known"
            ]
          }
        ]
      },
      "add": [
        "task_completed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_output": {
      "owner": "agent",
      "pre": "task_completed",
      "add": [
        "output_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_cli",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "authenticate",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "inspect_help",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_model",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_output",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "cli_installed",
      "authenticated",
      "task_completed",
      "output_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
