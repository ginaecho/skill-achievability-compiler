{
  "name": "fireflies-ci-integration",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_repo": {
      "owner": "agent",
      "pre": true,
      "add": [
        "repo_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "author_ci_lane": {
      "owner": "agent",
      "pre": "repo_inspected",
      "add": [
        "graphql_checks_written",
        "fixture_tests_written",
        "webhook_vectors_written",
        "secret_assertions_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_repo",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "author_ci_lane",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_checks",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "enable_live": [
            {
              "act": {
                "cap": "run_live_tests",
                "by": "agent"
              }
            }
          ],
          "offline_only": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "graphql_checks_written",
      "fixture_tests_written",
      "webhook_vectors_written",
      "secret_assertions_written",
      "checks_pass"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
