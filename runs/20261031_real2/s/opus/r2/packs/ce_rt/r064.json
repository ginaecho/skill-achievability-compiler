{
  "name": "omniverse-content-services",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "gather_requirements": {
      "owner": "agent",
      "pre": true,
      "add": [
        "requirements_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_local_expert": {
      "owner": "agent",
      "pre": "requirements_known",
      "add": [
        "expert_consulted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_expert": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:github_access",
          "requirements_known"
        ]
      },
      "add": [
        "expert_consulted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "gather_requirements",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "local_checkout": [
            {
              "act": {
                "cap": "read_local_expert",
                "by": "agent"
              }
            }
          ],
          "fetch_upstream": [
            {
              "act": {
                "cap": "fetch_expert",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "requirements_known",
      "expert_consulted"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
