{
  "name": "cmux-customization",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_config": {
      "owner": "agent",
      "pre": true,
      "add": [
        "config_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "backup_config": {
      "owner": "agent",
      "pre": "config_inspected",
      "add": [
        "config_backed_up"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "edit_config": {
      "owner": "agent",
      "pre": {
        "and": [
          "config_inspected",
          "config_backed_up"
        ]
      },
      "add": [
        "config_edited"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_entrypoint": {
      "owner": "agent",
      "pre": "config_edited",
      "add": [
        "entrypoint_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "backup_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "edit_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_entrypoint",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "reload": [
            {
              "act": {
                "cap": "reload_config",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "config_edited",
      "config_valid",
      "entrypoint_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
