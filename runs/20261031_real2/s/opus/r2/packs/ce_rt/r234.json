{
  "name": "implement-patch",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "check_before_repair": {
      "owner": "agent",
      "pre": "run_dir_exists",
      "add": [
        "gate_passed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_suite_before": {
      "owner": "agent",
      "pre": true,
      "add": [
        "suite_before_recorded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_regression_test": {
      "owner": "agent",
      "pre": "gate_passed",
      "add": [
        "regression_test_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "observe_baseline_failure": {
      "owner": "agent",
      "pre": {
        "and": [
          "regression_test_written",
          "baseline_exists"
        ]
      },
      "add": [
        "baseline_failure_shown"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fix_invariant": {
      "owner": "agent",
      "pre": {
        "and": [
          "gate_passed",
          "baseline_failure_shown"
        ]
      },
      "add": [
        "invariant_fixed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_suite_after": {
      "owner": "agent",
      "pre": {
        "and": [
          "invariant_fixed",
          "suite_before_recorded"
        ]
      },
      "add": [
        "suite_after_green"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_patch_files": {
      "owner": "agent",
      "pre": {
        "and": [
          "invariant_fixed",
          "baseline_exists"
        ]
      },
      "add": [
        "patch_files_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "make_commit": {
      "owner": "agent",
      "pre": {
        "and": [
          "patch_files_written",
          "suite_after_green"
        ]
      },
      "add": [
        "commit_made"
      ],
      "del": [],
      "assigns": {},
      "nondet": {
        "commit_count": {
          "cmp": [
            "commit_count",
            "==",
            1
          ]
        }
      }
    },
    "write_patch_json": {
      "owner": "agent",
      "pre": "commit_made",
      "add": [
        "patch_json_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "manifest_attempt": {
      "owner": "agent",
      "pre": {
        "and": [
          "patch_json_written",
          "patch_files_written"
        ]
      },
      "add": [
        "manifested"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_manifest": {
      "owner": "agent",
      "pre": "manifested",
      "add": [
        "manifest_valid"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_before_repair",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_suite_before",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_regression_test",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "observe_baseline_failure",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fix_invariant",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_suite_after",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_patch_files",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "make_commit",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_patch_json",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "manifest_attempt",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_manifest",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "invariant_fixed",
      "baseline_failure_shown",
      "suite_after_green",
      "commit_made",
      {
        "cmp": [
          "commit_count",
          "==",
          1
        ]
      },
      "patch_files_written",
      "patch_json_written",
      "manifest_valid"
    ]
  },
  "init_true": [
    "run_dir_exists",
    "baseline_exists"
  ],
  "init_constraints": [
    {
      "cmp": [
        "commit_count",
        "==",
        0
      ]
    }
  ]
}
