{
  "name": "rebase-current-branch",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_repo": {
      "owner": "agent",
      "pre": true,
      "add": [
        "inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "identify_default": {
      "owner": "agent",
      "pre": "inspected",
      "add": [
        "default_identified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_default": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet",
          "default_identified"
        ]
      },
      "add": [
        "fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "rebase_branch": {
      "owner": "agent",
      "pre": "fetched",
      "add": [
        "rebased"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "resolve_conflicts": {
      "owner": "agent",
      "pre": "rebased",
      "add": [],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "continue_rebase": {
      "owner": "agent",
      "pre": "rebased",
      "add": [],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_checks": {
      "owner": "agent",
      "pre": "rebased",
      "add": [
        "checks_run"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_result": {
      "owner": "agent",
      "pre": "rebased",
      "add": [
        "verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_repo",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "identify_default",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_default",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "rebase_branch",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "conflicts": [
            {
              "act": {
                "cap": "resolve_conflicts",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "continue_rebase",
                "by": "agent"
              }
            }
          ],
          "clean": []
        }
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "run_validation": [
            {
              "act": {
                "cap": "run_checks",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    },
    {
      "act": {
        "cap": "verify_result",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "rebased",
      "verified",
      "work_preserved"
    ]
  },
  "init_true": [
    "work_preserved",
    "needs:public_internet"
  ],
  "init_constraints": []
}
