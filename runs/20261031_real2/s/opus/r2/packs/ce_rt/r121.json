{
  "name": "security-model",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "resolve_policies": {
      "owner": "agent",
      "pre": true,
      "add": [
        "policies_resolved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_staleness": {
      "owner": "agent",
      "pre": "policies_resolved",
      "add": [
        "staleness_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_evidence": {
      "owner": "agent",
      "pre": true,
      "add": [
        "evidence_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_visibility": {
      "owner": "agent",
      "pre": true,
      "add": [
        "visibility_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "confirm_decisions": {
      "owner": "agent",
      "pre": "evidence_gathered",
      "add": [
        "decisions_confirmed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_policy": {
      "owner": "agent",
      "pre": {
        "and": [
          "decisions_confirmed",
          "evidence_gathered"
        ]
      },
      "add": [
        "policy_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_policy": {
      "owner": "agent",
      "pre": "policy_written",
      "add": [
        "policy_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "open_pull_request": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:github_account",
          "policy_written"
        ]
      },
      "add": [
        "pr_opened"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "resolve_policies",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_staleness",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_evidence",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_visibility",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "confirm_decisions",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "approve": [
            {
              "act": {
                "cap": "write_policy",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "verify_policy",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "open_pr": [
                    {
                      "act": {
                        "cap": "open_pull_request",
                        "by": "agent"
                      }
                    }
                  ],
                  "no_pr": []
                }
              }
            }
          ],
          "decline": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "policy_written",
      "policy_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
