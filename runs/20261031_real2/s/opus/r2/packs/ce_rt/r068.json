{
  "name": "pva-spec",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "verify_references": {
      "owner": "agent",
      "pre": "doctor_report_provided",
      "add": [
        "references_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_sources": {
      "owner": "agent",
      "pre": "references_verified",
      "add": [
        "requirements_collected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_spec": {
      "owner": "agent",
      "pre": "requirements_collected",
      "add": [
        "spec_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_matrix": {
      "owner": "agent",
      "pre": "requirements_collected",
      "add": [
        "matrix_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_evidence": {
      "owner": "agent",
      "pre": "requirements_collected",
      "add": [
        "evidence_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "add_test": {
      "owner": "agent",
      "pre": "matrix_written",
      "add": [
        "test_added"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "finalize_handoff": {
      "owner": "agent",
      "pre": {
        "and": [
          "spec_written",
          "matrix_written",
          "evidence_written"
        ]
      },
      "add": [
        "handoff_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_handoff": {
      "owner": "agent",
      "pre": "handoff_created",
      "add": [
        "check_passed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_report": {
      "owner": "agent",
      "pre": "check_passed",
      "add": [
        "report_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "verify_references",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_sources",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_spec",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_matrix",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_evidence",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "finalize",
        "body": [
          {
            "act": {
              "cap": "finalize_handoff",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "external": true,
              "branches": {
                "missing_test": [
                  {
                    "act": {
                      "cap": "add_test",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "finalize"
                  }
                ],
                "ready": []
              }
            }
          }
        ]
      }
    },
    {
      "act": {
        "cap": "check_handoff",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_report",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "handoff_created",
      "check_passed",
      "report_written"
    ]
  },
  "init_true": [
    "doctor_report_provided"
  ],
  "init_constraints": []
}
