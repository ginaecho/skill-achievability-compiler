{
  "name": "firecrawl-data-handling",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_repo": {
      "owner": "agent",
      "pre": true,
      "add": [
        "repo_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "document_inventory": {
      "owner": "agent",
      "pre": "repo_inspected",
      "add": [
        "inventory_documented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_envelope": {
      "owner": "agent",
      "pre": "inventory_documented",
      "add": [
        "envelope_validated",
        "provenance_preserved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "normalize_content": {
      "owner": "agent",
      "pre": "envelope_validated",
      "add": [
        "content_normalized",
        "hashes_computed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "sanitize_content": {
      "owner": "agent",
      "pre": "content_normalized",
      "add": [
        "content_sanitized"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_json": {
      "owner": "agent",
      "pre": "content_sanitized",
      "add": [
        "json_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "store_sensitive": {
      "owner": "agent",
      "pre": "json_validated",
      "add": [
        "sensitive_stored"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "separate_stores": {
      "owner": "agent",
      "pre": "json_validated",
      "add": [
        "stores_separated",
        "access_controlled"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_disposal": {
      "owner": "agent",
      "pre": "stores_separated",
      "add": [
        "disposal_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_repo",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "document_inventory",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_envelope",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "normalize_content",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "sanitize_content",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_json",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "approve_sensitive_storage": [
            {
              "act": {
                "cap": "store_sensitive",
                "by": "agent"
              }
            }
          ],
          "rag_only": []
        }
      }
    },
    {
      "act": {
        "cap": "separate_stores",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "implement_disposal",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "inventory_documented",
      "provenance_preserved",
      "content_sanitized",
      "json_validated",
      "stores_separated",
      "disposal_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
