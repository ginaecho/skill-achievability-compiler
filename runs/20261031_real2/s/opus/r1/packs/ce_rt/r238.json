{
  "name": "regression-hunt",
  "roles": [
    "coordinator",
    "user",
    "stage_agent"
  ],
  "capabilities": {
    "obtain_inputs": {
      "owner": "coordinator",
      "pre": true,
      "add": [
        "inputs_obtained"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "save_scope": {
      "owner": "coordinator",
      "pre": "inputs_obtained",
      "add": [
        "scope_saved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "init_registry": {
      "owner": "coordinator",
      "pre": "scope_saved",
      "add": [
        "registry_initialized"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_campaign": {
      "owner": "coordinator",
      "pre": "registry_initialized",
      "add": [
        "campaign_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "resolve_guidance": {
      "owner": "coordinator",
      "pre": true,
      "add": [
        "guidance_resolved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "save_guidance": {
      "owner": "coordinator",
      "pre": "guidance_resolved",
      "add": [
        "guidance_saved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "reserve_stage": {
      "owner": "coordinator",
      "pre": {
        "and": [
          "campaign_created",
          "guidance_saved"
        ]
      },
      "add": [
        "stage_reserved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "bind_launch_record": {
      "owner": "coordinator",
      "pre": "stage_reserved",
      "add": [
        "launch_bound"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "accept_record": {
      "owner": "coordinator",
      "pre": "launch_bound",
      "add": [
        "record_accepted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "update_ledger": {
      "owner": "coordinator",
      "pre": "record_accepted",
      "add": [
        "ledger_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "retry_stage": {
      "owner": "coordinator",
      "pre": "launch_bound",
      "add": [
        "previous_agent_stopped"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "compile_reports": {
      "owner": "coordinator",
      "pre": "ledger_updated",
      "add": [
        "reports_produced"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "obtain_inputs",
        "by": "coordinator"
      }
    },
    {
      "act": {
        "cap": "save_scope",
        "by": "coordinator"
      }
    },
    {
      "act": {
        "cap": "init_registry",
        "by": "coordinator"
      }
    },
    {
      "act": {
        "cap": "create_campaign",
        "by": "coordinator"
      }
    },
    {
      "act": {
        "cap": "resolve_guidance",
        "by": "coordinator"
      }
    },
    {
      "act": {
        "cap": "save_guidance",
        "by": "coordinator"
      }
    },
    {
      "rec": {
        "name": "dispatch",
        "body": [
          {
            "act": {
              "cap": "reserve_stage",
              "by": "coordinator"
            }
          },
          {
            "act": {
              "cap": "bind_launch_record",
              "by": "coordinator"
            }
          },
          {
            "spawn": {
              "role": "stage_agent"
            }
          },
          {
            "choice": {
              "by": "coordinator",
              "external": true,
              "branches": {
                "accept": [
                  {
                    "act": {
                      "cap": "accept_record",
                      "by": "coordinator"
                    }
                  },
                  {
                    "act": {
                      "cap": "update_ledger",
                      "by": "coordinator"
                    }
                  }
                ],
                "retry": [
                  {
                    "act": {
                      "cap": "retry_stage",
                      "by": "coordinator"
                    }
                  }
                ]
              }
            }
          },
          {
            "continue": "dispatch"
          }
        ]
      }
    },
    {
      "act": {
        "cap": "compile_reports",
        "by": "coordinator"
      }
    }
  ],
  "goal": {
    "and": [
      "reports_produced",
      "ledger_updated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
