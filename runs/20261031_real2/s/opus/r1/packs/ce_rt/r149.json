{
  "name": "agent-roundtable",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_mode": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      },
      "add": [
        "mode_chosen"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_brief": {
      "owner": "agent",
      "pre": true,
      "add": [
        "brief_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_deps": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:package_registries"
        ]
      },
      "add": [
        "deps_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_agents": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:agent_logins",
          "deps_installed"
        ]
      },
      "add": [
        "agents_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_debate": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:agent_logins",
          {
            "and": [
              "brief_written",
              "agents_checked",
              "mode_chosen"
            ]
          }
        ]
      },
      "add": [
        "debate_running"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_round": {
      "owner": "agent",
      "pre": "debate_running",
      "add": [],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_moderator_note": {
      "owner": "agent",
      "pre": "debate_running",
      "add": [
        "moderated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_synthesis": {
      "owner": "agent",
      "pre": "debate_running",
      "add": [
        "synthesis_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "finalize": {
      "owner": "agent",
      "pre": "synthesis_written",
      "add": [
        "finalized"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_handoff": {
      "owner": "agent",
      "pre": "finalized",
      "add": [
        "delivered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "ask_mode",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_brief",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_deps",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "check_agents",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_debate",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "rounds",
        "body": [
          {
            "act": {
              "cap": "read_round",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "user",
              "observed": true,
              "branches": {
                "steer": [
                  {
                    "act": {
                      "cap": "write_moderator_note",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "rounds"
                  }
                ],
                "ready": []
              }
            }
          }
        ]
      }
    },
    {
      "act": {
        "cap": "write_synthesis",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "objection": [
            {
              "act": {
                "cap": "write_synthesis",
                "by": "agent"
              }
            }
          ],
          "approved": []
        }
      }
    },
    {
      "act": {
        "cap": "finalize",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "handoff": [
            {
              "act": {
                "cap": "write_handoff",
                "by": "agent"
              }
            }
          ],
          "chat": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "synthesis_written",
      "finalized"
    ]
  },
  "init_true": [
    "needs:user_conversation",
    "needs:package_registries"
  ],
  "init_constraints": []
}
