{
  "name": "linear-install-auth",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_repo": {
      "owner": "agent",
      "pre": true,
      "add": [
        "repo_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "pin_sdk": {
      "owner": "agent",
      "pre": "repo_inspected",
      "add": [
        "sdk_pinned",
        "lockfile_committed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_auth": {
      "owner": "agent",
      "pre": "sdk_pinned",
      "add": [
        "auth_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_access": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:linear_credential",
          "auth_configured"
        ]
      },
      "add": [
        "access_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_repo",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "pin_sdk",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "personal_key": [
            {
              "act": {
                "cap": "configure_auth",
                "by": "agent"
              }
            }
          ],
          "oauth": [
            {
              "act": {
                "cap": "configure_auth",
                "by": "agent"
              }
            }
          ],
          "client_credentials": [
            {
              "act": {
                "cap": "configure_auth",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "verify_access",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "sdk_pinned",
      "lockfile_committed",
      "auth_configured",
      "access_verified"
    ]
