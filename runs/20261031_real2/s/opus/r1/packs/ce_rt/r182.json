{
  "name": "building-automl-pipelines",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "load_data": {
      "owner": "agent",
      "pre": true,
      "add": [
        "data_loaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "assess_data_quality": {
      "owner": "agent",
      "pre": "data_loaded",
      "add": [
        "data_assessed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_pipeline": {
      "owner": "agent",
      "pre": "data_assessed",
      "add": [
        "pipeline_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_automl": {
      "owner": "agent",
      "pre": {
        "and": [
          "pipeline_implemented",
          "data_loaded"
        ]
      },
      "add": [
        "model_trained",
        "best_model_selected",
        "model_evaluated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "load_data",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "assess_data_quality",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_pipeline",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_automl",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "pipeline_implemented",
      "model_trained",
      "best_model_selected",
      "model_evaluated"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
