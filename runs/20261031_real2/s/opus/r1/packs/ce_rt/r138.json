{
  "name": "microsoft-store-publisher",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "reserve_product": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:partner_center_account"
        ]
      },
      "add": [
        "product_reserved",
        "identity_captured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "upload_package": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:partner_center_account",
          {
            "and": [
              "package_inspected",
              "wack_passed"
            ]
          }
        ]
      },
      "add": [
        "package_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "complete_sections": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:partner_center_account",
          "package_validated"
        ]
      },
      "add": [
        "all_sections_complete"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "accept_agreement": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:partner_center_account"
        ]
      },
      "add": [
        "agreement_accepted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "submit_certification": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:partner_center_account",
          {
            "and": [
              "all_sections_complete",
              "package_validated",
              "wack_passed",
              "package_unsigned"
            ]
          }
        ]
      },
      "add": [
        "submitted_for_certification"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "monitor_certification": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:partner_center_account",
          "submitted_for_certification"
        ]
      },
      "add": [
        "monitored"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "reserve_product",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_package",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "inspect_msix",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_wack",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "upload_package",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "complete_sections",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "agreement_shown": [
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "approve": [
                    {
                      "act": {
                        "cap": "accept_agreement",
                        "by": "agent"
                      }
                    }
                  ],
                  "decline": []
                }
              }
            }
          ],
          "no_agreement": []
        }
      }
    },
    {
      "act": {
        "cap": "submit_certification",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "monitor": [
            {
              "act": {
                "cap": "monitor_certification",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "submitted_for_certification",
      "wack_passed",
      "package_validated",
      "all_sections_complete",
      "package_unsigned"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
