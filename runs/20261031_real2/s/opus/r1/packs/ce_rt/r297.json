{
  "name": "social-publishing",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "install_socialclaw": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:package_registry"
        ]
      },
      "add": [
        "socialclaw_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_api_key": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:socialclaw_account"
        ]
      },
      "add": [
        "api_key_set"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "upload_media": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:network",
          {
            "and": [
              "socialclaw_installed",
              "api_key_set"
            ]
          }
        ]
      },
      "add": [
        "media_uploaded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "publish_posts": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:network",
          {
            "and": [
              "socialclaw_installed",
              "api_key_set"
            ]
          }
        ]
      },
      "add": [
        "posts_published",
        "confirmation_received"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_analytics": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:network",
          "posts_published"
        ]
      },
      "add": [
        "analytics_retrieved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_socialclaw",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_api_key",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "with_media": [
            {
              "act": {
                "cap": "upload_media",
                "by": "agent"
              }
            }
          ],
          "no_media": []
        }
      }
    },
    {
      "act": {
        "cap": "publish_posts",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "pull_analytics": [
            {
              "act": {
                "cap": "fetch_analytics",
                "by": "agent"
              }
            }
          ],
          "skip_analytics": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "posts_published",
      "confirmation_received"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
