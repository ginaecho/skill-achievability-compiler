{
  "name": "link-building",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_context": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      },
      "add": [
        "context_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "ask_context": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:user_conversation"
        ]
      },
      "add": [
        "context_gathered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_page": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet",
          "context_gathered"
        ]
      },
      "add": [
        "page_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "find_prospects": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet",
          "context_gathered"
        ]
      },
      "add": [
        "prospects_found"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "qualify_prospects": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet",
          "prospects_found"
        ]
      },
      "add": [
        "prospects_qualified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_plan": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          {
            "and": [
              "gap_analyzed",
              "prospects_qualified"
            ]
          }
        ]
      },
      "add": [
        "plan_delivered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "context_file_present": [
            {
              "act": {
                "cap": "read_context",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "ask_context",
                "by": "agent"
              }
            }
          ],
          "no_context_file": [
            {
              "act": {
                "cap": "ask_context",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "check_page",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "link_gap",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "find_prospects",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "qualify_prospects",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_plan",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "plan_delivered",
      "gap_analyzed",
      "prospects_qualified"
    ]
  },
  "init_true": [
    "needs:local_filesystem",
    "needs:user_conversation",
    "needs:public_internet"
  ],
  "init_constraints": []
}
