{
  "name": "cantera",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "install_deps": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:package_registries",
          "needs:public_internet"
        ]
      },
      "add": [
        "deps_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "prepare_config": {
      "owner": "agent",
      "pre": true,
      "add": [
        "config_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_helper": {
      "owner": "agent",
      "pre": {
        "and": [
          "deps_installed",
          "config_ready"
        ]
      },
      "add": [
        "report_produced",
        "histories_written",
        "mechanism_snapshot",
        "conservation_checked",
        "delay_reported",
        "numerically_resolved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_deps",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "refine",
        "body": [
          {
            "act": {
              "cap": "prepare_config",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "run_helper",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "external": true,
              "branches": {
                "resolved": [],
                "refine_again": [
                  {
                    "continue": "refine"
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "goal": {
    "and": [
      "report_produced",
      "delay_reported",
      "conservation_checked",
      "mechanism_snapshot",
      "numerically_resolved"
    ]
  },
  "init_true": [
    "needs:package_registries",
    "needs:public_internet"
  ],
  "init_constraints": []
}
