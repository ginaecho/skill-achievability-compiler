{
  "name": "pva-spec",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "verify_references": {
      "owner": "agent",
      "pre": "doctor_report_ready",
      "add": [
        "references_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_reference": {
      "owner": "agent",
      "pre": true,
      "add": [
        "references_collected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "copy_templates": {
      "owner": "agent",
      "pre": "references_verified",
      "add": [
        "templates_copied"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_spec": {
      "owner": "agent",
      "pre": "templates_copied",
      "add": [
        "spec_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_matrix": {
      "owner": "agent",
      "pre": "spec_written",
      "add": [
        "matrix_written",
        "all_requirements_tested"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_evidence": {
      "owner": "agent",
      "pre": "spec_written",
      "add": [
        "evidence_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "link_test": {
      "owner": "agent",
      "pre": "matrix_written",
      "add": [
        "all_requirements_tested"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "finalize_handoff": {
      "owner": "agent",
      "pre": {
        "and": [
          "spec_written",
          "matrix_written",
          "evidence_written",
          "all_requirements_tested"
        ]
      },
      "add": [
        "handoff_created",
        "finalize_valid"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_handoff": {
      "owner": "agent",
      "pre": "handoff_created",
      "add": [
        "check_valid"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_report": {
      "owner": "agent",
      "pre": "check_valid",
      "add": [
        "report_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "verify_references",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "url_source": [
            {
              "act": {
                "cap": "fetch_reference",
                "by": "agent"
              }
            }
          ],
          "local_source": []
        }
      }
    },
    {
      "act": {
        "cap": "copy_templates",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_spec",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_matrix",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_evidence",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "finalize_loop",
        "body": [
          {
            "act": {
              "cap": "finalize_handoff",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "missing_test": [
                  {
                    "act": {
                      "cap": "link_test",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "finalize_loop"
                  }
                ],
                "complete": []
              }
            }
          }
        ]
      }
    },
    {
      "act": {
        "cap": "check_handoff",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_report",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "spec_written",
      "matrix_written",
      "evidence_written",
      "handoff_created",
      "finalize_valid",
      "check_valid",
      "report_written"
    ]
  },
  "init_true": [
    "doctor_report_ready"
  ],
  "init_constraints": []
}
