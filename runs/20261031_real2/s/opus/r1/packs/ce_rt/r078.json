{
  "name": "commit-craft",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "plan_series": {
      "owner": "agent",
      "pre": true,
      "add": [
        "series_planned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "stage_group": {
      "owner": "agent",
      "pre": "series_planned",
      "add": [
        "group_staged"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scan_secrets": {
      "owner": "agent",
      "pre": "group_staged",
      "add": [
        "staged_clean"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "lint_message": {
      "owner": "agent",
      "pre": "group_staged",
      "add": [
        "message_ok"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "commit_group": {
      "owner": "agent",
      "pre": {
        "and": [
          "staged_clean",
          "message_ok"
        ]
      },
      "add": [
        "group_committed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "lint_series": {
      "owner": "agent",
      "pre": "group_committed",
      "add": [
        "series_linted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_builds": {
      "owner": "agent",
      "pre": "group_committed",
      "add": [
        "all_build"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "plan_series",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "groups",
        "body": [
          {
            "act": {
              "cap": "stage_group",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "scan_secrets",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "lint_message",
              "by": "agent"
            }
          },
          {
            "act": {
              "cap": "commit_group",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "next_group": [
                  {
                    "continue": "groups"
                  }
                ],
                "done": []
              }
            }
          }
        ]
      }
    },
    {
      "act": {
        "cap": "lint_series",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_builds",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "series_planned",
      "group_committed",
      "staged_clean",
      "series_linted",
      "all_build"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
