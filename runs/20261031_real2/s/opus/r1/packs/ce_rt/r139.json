{
  "name": "npm-trusted-publishing",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "edit_workflow": {
      "owner": "agent",
      "pre": true,
      "add": [
        "oidc_permission",
        "registry_url_set",
        "npm_version_ok"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "remove_tokens": {
      "owner": "agent",
      "pre": true,
      "add": [
        "token_removed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fix_repository": {
      "owner": "agent",
      "pre": true,
      "add": [
        "repository_url_set"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "edit_workflow",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "remove_tokens",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fix_repository",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_trusted_publisher",
        "by": "user"
      }
    },
    {
      "act": {
        "cap": "publish_release",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "cleanup": [
            {
              "act": {
                "cap": "delete_old_token",
                "by": "user"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "oidc_permission",
      "npm_version_ok",
      "token_removed",
      "registry_url_set",
      "repository_url_set",
      "trusted_publisher_set",
      "release_succeeded"
    ]
  },
  "init_true": [
    "github_hosted_runner"
  ],
  "init_constraints": []
}
