{
  "name": "azure-logic-apps-standard-cli",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "verify_tooling": {
      "owner": "agent",
      "pre": true,
      "add": [
        "tooling_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_extension": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet",
          "tooling_verified"
        ]
      },
      "add": [
        "extension_available"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "scaffold_project": {
      "owner": "agent",
      "pre": "tooling_verified",
      "add": [
        "project_scaffolded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "author_workflow": {
      "owner": "agent",
      "pre": "project_scaffolded",
      "add": [
        "workflow_authored"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_identity": {
      "owner": "agent",
      "pre": "project_scaffolded",
      "add": [
        "identity_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_exclusions": {
      "owner": "agent",
      "pre": "project_scaffolded",
      "add": [
        "secrets_excluded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_project": {
      "owner": "agent",
      "pre": "workflow_authored",
      "add": [
        "validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_app": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:azure_account",
          "validated"
        ]
      },
      "add": [
        "deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "verify_tooling",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "install": [
            {
              "act": {
                "cap": "install_extension",
                "by": "agent"
              }
            }
          ],
          "already_present": []
        }
      }
    },
    {
      "act": {
        "cap": "scaffold_project",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "author_workflow",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_identity",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_exclusions",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_project",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "deploy": [
            {
              "act": {
                "cap": "deploy_app",
                "by": "agent"
              }
            }
          ],
          "local_only": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "project_scaffolded",
      "workflow_authored",
      "identity_configured",
      "secrets_excluded",
      "validated"
    ]
  },
  "init_true": [
    "needs:public_internet"
  ],
  "init_constraints": []
}
