{
  "name": "claude-design-curation",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_config": {
      "owner": "agent",
      "pre": true,
      "add": [
        "config_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_feedback": {
      "owner": "agent",
      "pre": "feedback_read",
      "add": [
        "feedback_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "tag_components": {
      "owner": "agent",
      "pre": "config_read",
      "add": [
        "components_tagged",
        "stale_paths"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_config",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "incoming_feedback": [
            {
              "act": {
                "cap": "fetch_feedback",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "implement_feedback",
                "by": "agent"
              }
            }
          ],
          "no_feedback": []
        }
      }
    },
    {
      "act": {
        "cap": "tag_components",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_overrides",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_check",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "upload",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "components_tagged",
      "overrides_generated",
      "check_passes",
      "uploaded",
      {
        "not": "stale_paths"
      }
    ]
  },
  "init_true": [],
  "init_constraints": []
}
