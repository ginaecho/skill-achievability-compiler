{
  "name": "go-quality-gates",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_repo": {
      "owner": "agent",
      "pre": true,
      "add": [
        "inventory_recorded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_lint_config": {
      "owner": "agent",
      "pre": "inventory_recorded",
      "add": [
        "lint_config_written",
        "maintainability_enforced"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_orchestrator": {
      "owner": "agent",
      "pre": "inventory_recorded",
      "add": [
        "orchestrator_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "extend_wiring": {
      "owner": "agent",
      "pre": "inventory_recorded",
      "add": [
        "orchestrator_written",
        "hooks_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_report": {
      "owner": "agent",
      "pre": "gates_verified",
      "add": [
        "report_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_repo",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "pin_tools",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_lint_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_lint_config",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "new_setup": [
            {
              "act": {
                "cap": "write_orchestrator",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "install_hooks",
                "by": "agent"
              }
            }
          ],
          "extend_existing": [
            {
              "act": {
                "cap": "extend_wiring",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "run_structural_check",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_coverage",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_gates",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_report",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "inventory_recorded",
      "maintainability_enforced",
      "structural_enforced",
      "coverage_fresh",
      "gates_verified",
      "hooks_installed",
      "report_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
