{
  "name": "execution-plans",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_code": {
      "owner": "agent",
      "pre": true,
      "add": [
        "code_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_plan": {
      "owner": "agent",
      "pre": {
        "and": [
          "design_accepted",
          "code_inspected"
        ]
      },
      "add": [
        "plan_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "review_plan": {
      "owner": "agent",
      "pre": "plan_written",
      "add": [
        "plan_reviewed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "render_tracker": {
      "owner": "agent",
      "pre": "plan_written",
      "add": [
        "tracker_rendered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_plan",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "review_plan",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "tracker_requested": [
            {
              "act": {
                "cap": "render_tracker",
                "by": "agent"
              }
            }
          ],
          "markdown_only": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "plan_written",
      "plan_reviewed"
    ]
  },
  "init_true": [
    "design_accepted"
  ],
  "init_constraints": []
}
