{
  "name": "tao-generate-od-defects",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "validate_inputs": {
      "owner": "agent",
      "pre": "inputs_provided",
      "add": [
        "inputs_validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "launch_workflow": {
      "owner": "agent",
      "pre": "inputs_validated",
      "add": [
        "checkpoints_mounted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_defects": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:cuda_gpus",
          "checkpoints_mounted"
        ]
      },
      "add": [
        "images_generated",
        "pseudo_labels_created",
        "coco_published",
        "binary_coco_published"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "validate_completion": {
      "owner": "agent",
      "pre": {
        "and": [
          "images_generated",
          "pseudo_labels_created",
          "coco_published",
          "binary_coco_published"
        ]
      },
      "add": [
        "outputs_validated",
        "summary_written",
        "status_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "validate_inputs",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "launch_workflow",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_defects",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "validate_completion",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "coco_published",
      "binary_coco_published",
      "outputs_validated",
      "summary_written",
      "status_written",
      "training_pool_not_mutated"
    ]
  },
  "init_true": [
    "inputs_provided",
    "training_pool_not_mutated"
  ],
  "init_constraints": []
}
