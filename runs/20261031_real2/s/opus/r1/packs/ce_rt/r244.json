{
  "name": "away-mode",
  "roles": [
    "agent",
    "user",
    "buddy"
  ],
  "capabilities": {
    "check_buddy": {
      "owner": "agent",
      "pre": true,
      "add": [
        "buddy_bound"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "pre_ask": {
      "owner": "agent",
      "pre": true,
      "add": [
        "questions_answered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_away_log": {
      "owner": "agent",
      "pre": "questions_answered",
      "add": [
        "away_log_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "update_log": {
      "owner": "agent",
      "pre": "timer_armed",
      "add": [
        "log_updated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "execute_action": {
      "owner": "agent",
      "pre": "buddy_bound",
      "add": [
        "action_executed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "reconcile_log": {
      "owner": "agent",
      "pre": "away_log_created",
      "add": [
        "log_reconciled"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "check_buddy",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "pre_ask",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_away_log",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "arm_timer",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "watch",
        "body": [
          {
            "act": {
              "cap": "update_log",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "decide": [
                  {
                    "msg": {
                      "from": "agent",
                      "to": "buddy",
                      "label": "propose"
                    }
                  },
                  {
                    "msg": {
                      "from": "buddy",
                      "to": "agent",
                      "label": "cosign"
                    }
                  },
                  {
                    "act": {
                      "cap": "execute_action",
                      "by": "agent"
                    }
                  }
                ],
                "hold": []
              }
            }
          },
          {
            "choice": {
              "by": "agent",
              "external": true,
              "branches": {
                "continue": [
                  {
                    "continue": "watch"
                  }
                ],
                "grant_ends": []
              }
            }
          }
        ]
      }
    },
    {
      "act": {
        "cap": "delete_timer",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "reconcile_log",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "away_log_created",
      "log_reconciled",
      "timer_deleted"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
