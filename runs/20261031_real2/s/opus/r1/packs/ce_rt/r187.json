{
  "name": "fathom-debug-bundle",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {},
  "protocol": [
    {
      "act": {
        "cap": "collect_diagnostics",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "redact",
        "body": [
          {
            "act": {
              "cap": "review_redact",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "still_sensitive": [
                  {
                    "continue": "redact"
                  }
                ],
                "clean": []
              }
            }
          }
        ]
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "reproduced": [
            {
              "act": {
                "cap": "reproduce_synthetic",
                "by": "agent"
              }
            }
          ],
          "cannot_reproduce": []
        }
      }
    },
    {
      "act": {
        "cap": "assemble_bundle",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "bundle_ready",
      "bundle_redacted",
      "owner_recorded",
      "scope_recorded",
      "evidence_collected",
      "escalation_path_ready"
    ]
  },
  "init_true": [
    "owner_identified",
    "destination_approved",
    "redaction_policy_set"
  ],
  "init_constraints": []
}
