{
  "name": "validate-bug",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "read_inputs": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem"
        ]
      },
      "add": [
        "inputs_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_validate": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:local_filesystem",
          "rerun_done"
        ]
      },
      "add": [
        "validate_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "read_inputs",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "compile_failure": [
            {
              "act": {
                "cap": "rerun_compile",
                "by": "agent"
              }
            }
          ],
          "runtime_poc": [
            {
              "act": {
                "cap": "rerun_runtime",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "write_validate",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "manifest_validate",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_checker",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "validate_written",
      "manifested",
      "checked"
    ]
  },
  "init_true": [
    "needs:local_filesystem"
  ],
  "init_constraints": []
}
