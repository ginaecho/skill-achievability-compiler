{
  "name": "task-execution-engine",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "get_next_task": {
      "owner": "agent",
      "pre": true,
      "add": [
        "task_selected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "implement_task": {
      "owner": "agent",
      "pre": "task_selected",
      "add": [
        "task_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_criteria": {
      "owner": "agent",
      "pre": "task_implemented",
      "add": [
        "criteria_met"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "mark_done": {
      "owner": "agent",
      "pre": "criteria_met",
      "add": [
        "status_recorded"
      ],
      "del": [
        "task_selected",
        "task_implemented",
        "criteria_met"
      ],
      "assigns": {},
      "nondet": {}
    },
    "mark_fail": {
      "owner": "agent",
      "pre": "task_selected",
      "add": [
        "status_recorded"
      ],
      "del": [
        "task_selected",
        "task_implemented",
        "criteria_met"
      ],
      "assigns": {},
      "nondet": {}
    },
    "show_status": {
      "owner": "agent",
      "pre": true,
      "add": [
        "all_tasks_processed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "rec": {
        "name": "execute",
        "body": [
          {
            "act": {
              "cap": "get_next_task",
              "by": "agent"
            }
          },
          {
            "choice": {
              "by": "agent",
              "external": true,
              "branches": {
                "has_task": [
                  {
                    "choice": {
                      "by": "agent",
                      "observed": true,
                      "branches": {
                        "implemented": [
                          {
                            "act": {
                              "cap": "implement_task",
                              "by": "agent"
                            }
                          },
                          {
                            "act": {
                              "cap": "verify_criteria",
                              "by": "agent"
                            }
                          },
                          {
                            "act": {
                              "cap": "mark_done",
                              "by": "agent"
                            }
                          }
                        ],
                        "blocked": [
                          {
                            "act": {
                              "cap": "mark_fail",
                              "by": "agent"
                            }
                          }
                        ]
                      }
                    }
                  },
                  {
                    "continue": "execute"
                  }
                ],
                "none_remain": [
                  {
                    "act": {
                      "cap": "show_status",
                      "by": "agent"
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ],
  "goal": "all_tasks_processed",
  "init_true": [],
  "init_constraints": []
}
