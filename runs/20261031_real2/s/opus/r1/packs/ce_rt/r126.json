{
  "name": "cypress-flake-fixer",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "scan_suite": {
      "owner": "agent",
      "pre": true,
      "add": [
        "findings_scanned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "measure_baseline": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:cypress_runner"
        ]
      },
      "add": [
        "baseline_recorded"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fix_tests": {
      "owner": "agent",
      "pre": "findings_scanned",
      "add": [
        "flakes_fixed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "rescan_suite": {
      "owner": "agent",
      "pre": "flakes_fixed",
      "add": [
        "rescan_done"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_runs": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:cypress_runner",
          "flakes_fixed"
        ]
      },
      "add": [
        "runs_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_report": {
      "owner": "agent",
      "pre": {
        "and": [
          "flakes_fixed",
          "rescan_done"
        ]
      },
      "add": [
        "report_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "scan_suite",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "specific_spec": [
            {
              "act": {
                "cap": "measure_baseline",
                "by": "agent"
              }
            }
          ],
          "whole_suite": []
        }
      }
    },
    {
      "act": {
        "cap": "fix_tests",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "rescan_suite",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "run_verification": [
            {
              "act": {
                "cap": "verify_runs",
                "by": "agent"
              }
            }
          ],
          "skip_verification": []
        }
      }
    },
    {
      "act": {
        "cap": "write_report",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "findings_scanned",
      "flakes_fixed",
      "report_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
