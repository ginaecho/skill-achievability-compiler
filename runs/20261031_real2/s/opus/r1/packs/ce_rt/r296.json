{
  "name": "service-mesh-observability",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {},
  "protocol": [
    {
      "act": {
        "cap": "configure_tracing",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_metrics",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "setup_visualization",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "set_alerts": [
            {
              "act": {
                "cap": "setup_alerts",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "tracing_configured",
      "metrics_configured",
      "visualization_ready"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
