{
  "name": "neon-realtime",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "write_sealed_query": {
      "owner": "agent",
      "pre": {
        "and": [
          "env_configured",
          "packages_installed"
        ]
      },
      "add": [
        "queries_sealed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_write_endpoint": {
      "owner": "agent",
      "pre": "packages_installed",
      "add": [
        "writes_wired"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_client": {
      "owner": "agent",
      "pre": "queries_sealed",
      "add": [
        "client_subscribed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "enable_realtime",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "pull_env",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_packages",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_sealed_query",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_write_endpoint",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_client",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "check_first": [
            {
              "act": {
                "cap": "check_query",
                "by": "agent"
              }
            }
          ],
          "skip_check": []
        }
      }
    },
    {
      "act": {
        "cap": "deploy",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "realtime_enabled",
      "queries_sealed",
      "writes_wired",
      "client_subscribed",
      "app_deployed"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
