    },
    "add_regression_test": {
      "owner": "agent",
      "pre": "root_cause_found",
      "add": [
        "regression_test_added"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "remove_debug_flags": {
      "owner": "agent",
      "pre": "root_cause_found",
      "add": [
        "debug_flags_removed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
