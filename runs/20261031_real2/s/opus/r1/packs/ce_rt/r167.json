{
  "name": "repo-publish",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "run_gates": {
      "owner": "agent",
      "pre": true,
      "add": [
        "gates_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "intelligent_commit": {
      "owner": "agent",
      "pre": "gates_pass",
      "add": [
        "committed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "bump_version": {
      "owner": "agent",
      "pre": "gates_pass",
      "add": [
        "versioned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "commit_release": {
      "owner": "agent",
      "pre": "versioned",
      "add": [
        "committed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "pull_rebase": {
      "owner": "agent",
      "pre": "committed",
      "add": [
        "synced"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "git_push": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:remote_write",
          {
            "and": [
              "committed",
              "synced"
            ]
          }
        ]
      },
      "add": [
        "pushed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_push": {
      "owner": "agent",
      "pre": "pushed",
      "add": [
        "verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "run_gates",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "release": [
            {
              "act": {
                "cap": "bump_version",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "commit_release",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "pull_rebase",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "git_push",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "verify_push",
                "by": "agent"
              }
            }
          ],
          "push": [
            {
              "act": {
                "cap": "intelligent_commit",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "pull_rebase",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "git_push",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "verify_push",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "pushed",
      "verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
