{
  "name": "rebase-current-branch",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_status": {
      "owner": "agent",
      "pre": true,
      "add": [
        "inspected",
        "on_feature_branch"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "detect_default": {
      "owner": "agent",
      "pre": "inspected",
      "add": [
        "default_identified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "fetch_default": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet",
          "default_identified"
        ]
      },
      "add": [
        "remote_ref_fetched"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "rebase_branch": {
      "owner": "agent",
      "pre": {
        "and": [
          "remote_ref_fetched",
          "on_feature_branch",
          "clean_tree"
        ]
      },
      "add": [
        "rebased"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "resolve_continue": {
      "owner": "agent",
      "pre": "remote_ref_fetched",
      "add": [
        "rebased"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_checks": {
      "owner": "agent",
      "pre": "rebased",
      "add": [
        "checks_run"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_result": {
      "owner": "agent",
      "pre": "rebased",
      "add": [
        "verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_status",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "detect_default",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "fetch_default",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "rebase_branch",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "external": true,
        "branches": {
          "conflicts": [
            {
              "rec": {
                "name": "resolve",
                "body": [
                  {
                    "act": {
                      "cap": "resolve_continue",
                      "by": "agent"
                    }
                  },
                  {
                    "continue": "resolve"
                  }
                ]
              }
            }
          ],
          "no_conflicts": []
        }
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "run_validation": [
            {
              "act": {
                "cap": "run_checks",
                "by": "agent"
              }
            }
          ],
          "skip_validation": []
        }
      }
    },
    {
      "act": {
        "cap": "verify_result",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "rebased",
      "verified"
    ]
  },
  "init_true": [
    "clean_tree",
    "needs:public_internet"
  ],
  "init_constraints": []
}
