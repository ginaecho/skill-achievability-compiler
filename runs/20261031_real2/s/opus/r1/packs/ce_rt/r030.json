{
  "name": "ts-quality-gates",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "inspect_repo": {
      "owner": "agent",
      "pre": true,
      "add": [
        "repo_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_oxlint": {
      "owner": "agent",
      "pre": "tools_installed",
      "add": [
        "oxlint_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_gates": {
      "owner": "agent",
      "pre": "oxlint_configured",
      "add": [
        "gates_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "wire_gate": {
      "owner": "agent",
      "pre": "gates_configured",
      "add": [
        "gate_wired"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_ci": {
      "owner": "agent",
      "pre": "gate_wired",
      "add": [
        "ci_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_repo",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_tools",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_prek",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_oxlint",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_gates",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "wire_gate",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "setup_hooks",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "add_ci": [
            {
              "act": {
                "cap": "configure_ci",
                "by": "agent"
              }
            }
          ],
          "skip_ci": []
        }
      }
    },
    {
      "act": {
        "cap": "run_gate",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "tools_installed",
      "oxlint_configured",
      "gates_configured",
      "gate_wired",
      "hooks_installed",
      "gate_passes"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
