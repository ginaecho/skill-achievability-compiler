{
  "name": "java-testcontainers",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "detect_version": {
      "owner": "agent",
      "pre": true,
      "add": [
        "version_detected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_deps": {
      "owner": "agent",
      "pre": "version_detected",
      "add": [
        "deps_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_test": {
      "owner": "agent",
      "pre": "deps_configured",
      "add": [
        "test_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_tests": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:docker",
          {
            "and": [
              "deps_configured",
              "test_written"
            ]
          }
        ]
      },
      "add": [
        "tests_pass"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "detect_version",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_deps",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_test",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_tests",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "also_ci": [
            {
              "act": {
                "cap": "run_in_ci",
                "by": "agent"
              }
            }
          ],
          "local_only": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "deps_configured",
      "test_written",
      "tests_pass"
    ]
  },
  "init_true": [
    "needs:docker"
  ],
  "init_constraints": []
}
