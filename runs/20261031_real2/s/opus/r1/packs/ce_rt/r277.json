{
  "name": "data-storytelling",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_references": {
      "owner": "agent",
      "pre": true,
      "add": [
        "patterns_available"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_visuals": {
      "owner": "agent",
      "pre": true,
      "add": [
        "visuals_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_report": {
      "owner": "agent",
      "pre": "visuals_created",
      "add": [
        "report_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
