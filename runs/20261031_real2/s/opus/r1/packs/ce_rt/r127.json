{
  "name": "foundry-agentic-loop",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "install_foundry_skill": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:package_registry"
        ]
      },
      "add": [
        "foundry_skill_available"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "lock_mode": {
      "owner": "agent",
      "pre": true,
      "add": [
        "mode_locked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_spec": {
      "owner": "agent",
      "pre": "mode_locked",
      "add": [
        "spec_frozen"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "build_app": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:package_registry",
          "checkpoint_passed"
        ]
      },
      "add": [
        "app_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_azd": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:azure_account",
          {
            "and": [
              "app_built",
              "agent_created"
            ]
          }
        ]
      },
      "add": [
        "app_deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_deployment": {
      "owner": "agent",
      "pre": "app_deployed",
      "add": [
        "deployment_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_foundry_skill",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "lock_mode",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_spec",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_foundry_project",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_integration_checkpoint",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "build_app",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_agent",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "deploy_azd",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify_deployment",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "spec_frozen",
      "checkpoint_passed",
      "agent_created",
      "app_deployed",
      "deployment_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
