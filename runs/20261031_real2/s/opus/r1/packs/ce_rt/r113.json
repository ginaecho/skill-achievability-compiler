{
  "name": "shopify-development",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "install_cli": {
      "owner": "agent",
      "pre": true,
      "add": [
        "cli_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "init_app": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:shopify_partner_account",
          "cli_installed"
        ]
      },
      "add": [
        "app_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "set_config": {
      "owner": "agent",
      "pre": "app_created",
      "add": [
        "config_set"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_extension": {
      "owner": "agent",
      "pre": "app_created",
      "add": [
        "extension_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_extension_code": {
      "owner": "agent",
      "pre": "extension_generated",
      "add": [
        "extension_implemented"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "deploy_app": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:shopify_partner_account",
          {
            "and": [
              "config_set",
              "extension_implemented"
            ]
          }
        ]
      },
      "add": [
        "app_deployed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_cli",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "init_app",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "generate_extension",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_extension_code",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "set_config",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "deploy_app",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "app_deployed",
      "extension_implemented"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
