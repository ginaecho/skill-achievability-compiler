{
  "name": "boltz2-nim",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_mode": {
      "owner": "agent",
      "pre": true,
      "add": [
        "mode_chosen"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "predict_hosted": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:ngc_api_key",
          "needs:network",
          "mode_chosen"
        ]
      },
      "add": [
        "structure_predicted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "start_local_nim": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:ngc_api_key",
          "needs:network",
          "needs:docker",
          "needs:gpu",
          "mode_chosen"
        ]
      },
      "add": [
        "nim_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "predict_local": {
      "owner": "agent",
      "pre": "nim_ready",
      "add": [
        "structure_predicted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "save_output": {
      "owner": "agent",
      "pre": "structure_predicted",
      "add": [
        "output_saved"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "read_fields": {
      "owner": "agent",
      "pre": "output_saved",
      "add": [
        "output_reported"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "ask_mode",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "hosted": [
            {
              "act": {
                "cap": "predict_hosted",
                "by": "agent"
              }
            }
          ],
          "local": [
            {
              "act": {
                "cap": "start_local_nim",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "predict_local",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "save_output",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_fields",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "structure_predicted",
      "output_saved",
      "output_reported"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
