{
  "name": "create-quarkus-project",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "generate_web": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:public_internet"
        ]
      },
      "add": [
        "project_zip"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "detect_env",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "cli": [
            {
              "act": {
                "cap": "install_cli",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "scaffold_cli",
                "by": "agent"
              }
            }
          ],
          "maven_plugin": [
            {
              "act": {
                "cap": "scaffold_maven",
                "by": "agent"
              }
            }
          ],
          "web_ui": [
            {
              "act": {
                "cap": "generate_web",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "unzip_project",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "run_dev",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "project_created",
      "dev_mode_running"
    ]
  },
  "init_true": [
    "needs:public_internet"
  ],
  "init_constraints": []
}
