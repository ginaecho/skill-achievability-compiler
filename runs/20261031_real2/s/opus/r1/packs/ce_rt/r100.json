{
  "name": "distributed-training-pytorch-lightning",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "install_lightning": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:package_registries"
        ]
      },
      "add": [
        "lightning_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_training_script": {
      "owner": "agent",
      "pre": true,
      "add": [
        "script_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "train_model": {
      "owner": "agent",
      "pre": {
        "and": [
          "lightning_installed",
          "script_written"
        ]
      },
      "add": [
        "model_trained"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "test_model": {
      "owner": "agent",
      "pre": "model_trained",
      "add": [
        "model_tested"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "install_lightning",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_training_script",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "train_model",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "also_test": [
            {
              "act": {
                "cap": "test_model",
                "by": "agent"
              }
            }
          ],
          "skip_test": []
        }
      }
    }
  ],
  "goal": "model_trained",
  "init_true": [
    "needs:package_registries"
  ],
  "init_constraints": []
}
