{
  "name": "cdf-autonomous-vehicle-dataset-generation",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "prepare_payload": {
      "owner": "agent",
      "pre": true,
      "add": [
        "payload_prepared"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "storage_check": {
      "owner": "agent",
      "pre": "payload_prepared",
      "add": [
        "storage_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "prepare_payload",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "storage_check",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "submit_run",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "monitor_run",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_results",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "payload_prepared",
      "run_submitted",
      "run_observed",
      "results_read"
    ]
  },
  "init_true": [
    "run_authorized"
  ],
  "init_constraints": []
}
