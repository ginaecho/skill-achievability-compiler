{
  "name": "fastapi-templates",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "write_structure": {
      "owner": "agent",
      "pre": true,
      "add": [
        "structure_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_core": {
      "owner": "agent",
      "pre": "structure_created",
      "add": [
        "config_written",
        "database_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_models_schemas": {
      "owner": "agent",
      "pre": "structure_created",
      "add": [
        "models_written",
        "schemas_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_services": {
      "owner": "agent",
      "pre": "models_written",
      "add": [
        "services_written",
        "async_patterns"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_api": {
      "owner": "agent",
      "pre": {
        "and": [
          "services_written",
          "database_written"
        ]
      },
      "add": [
        "routes_written",
        "dependency_injection"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_main": {
      "owner": "agent",
      "pre": "routes_written",
      "add": [
        "app_written",
        "error_handling"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_requirements": {
      "owner": "agent",
      "pre": true,
      "add": [
        "requirements_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_tests": {
      "owner": "agent",
      "pre": "app_written",
      "add": [
        "tests_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_structure",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_core",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_models_schemas",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_services",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_api",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_main",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_requirements",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_tests",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "run_the_tests": [
            {
              "act": {
                "cap": "run_tests",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "app_written",
      "dependency_injection",
      "async_patterns",
      "error_handling",
      "requirements_written",
      "tests_written"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
