{
  "name": "nvshmem-troubleshoot-and-report-bugs",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_artifacts": {
      "owner": "agent",
      "pre": "evidence_available",
      "add": [
        "evidence_record_built"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify_docs": {
      "owner": "agent",
      "pre": "version_known",
      "add": [
        "version_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "pre_start_failure": [
            {
              "act": {
                "cap": "inspect_artifacts",
                "by": "agent"
              }
            }
          ],
          "in_process_failure": [
            {
              "act": {
                "cap": "inspect_artifacts",
                "by": "agent"
              }
            }
          ]
        }
      }
    },
    {
      "act": {
        "cap": "verify_docs",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "evidence_record_built",
      "version_verified"
    ]
  },
  "init_true": [
    "evidence_available",
    "version_known"
  ],
  "init_constraints": []
}
