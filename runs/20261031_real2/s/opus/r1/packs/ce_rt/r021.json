{
  "name": "linear-ticket-triage",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "confirm_scope": {
      "owner": "agent",
      "pre": true,
      "add": [
        "scope_pinned"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "inspect_repo": {
      "owner": "agent",
      "pre": "issues_read",
      "add": [
        "repo_verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "confirm_scope",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "list_issues",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "read_issues",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "inspect_repo",
        "by": "agent"
      }
    },
    {
      "rec": {
        "name": "triage",
        "body": [
          {
            "choice": {
              "by": "agent",
              "observed": true,
              "branches": {
                "close": [
                  {
                    "act": {
                      "cap": "add_evidence_comment",
                      "by": "agent"
                    }
                  },
                  {
                    "act": {
                      "cap": "close_issue",
                      "by": "agent"
                    }
                  }
                ],
                "leave_open": []
              }
            }
          },
          {
            "continue": "triage"
          }
        ]
      }
    }
  ],
  "goal": {
    "and": [
      "issues_closed",
      "evidence_commented",
      "repo_verified"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
