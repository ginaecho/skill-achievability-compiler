{
  "name": "open-knowledge-vault",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "inspect_vault": {
      "owner": "agent",
      "pre": true,
      "add": [
        "vault_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "init_vault": {
      "owner": "agent",
      "pre": "vault_inspected",
      "add": [
        "bundle_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_notes": {
      "owner": "agent",
      "pre": "bundle_created",
      "add": [
        "notes_written",
        "sources_attached"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "refresh_indexes": {
      "owner": "agent",
      "pre": "notes_written",
      "add": [
        "indexes_refreshed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_dataview": {
      "owner": "agent",
      "pre": "bundle_created",
      "add": [
        "dataview_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "audit_vault": {
      "owner": "agent",
      "pre": "bundle_created",
      "add": [
        "okf_conformant"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect_vault",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "init_vault",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "write_notes",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "refresh_indexes",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "add_dataview": [
            {
              "act": {
                "cap": "install_dataview",
                "by": "agent"
              }
            }
          ],
          "markdown_only": []
        }
      }
    },
    {
      "act": {
        "cap": "audit_vault",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "bundle_created",
      "notes_written",
      "sources_attached",
      "indexes_refreshed",
      "okf_conformant"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
