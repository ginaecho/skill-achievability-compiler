{
  "name": "tellurium",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "setup_env": {
      "owner": "agent",
      "pre": {
        "and": [
          "needs:package_registries"
        ]
      },
      "add": [
        "env_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "inspect_model": {
      "owner": "agent",
      "pre": true,
      "add": [
        "model_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "configure_experiment": {
      "owner": "agent",
      "pre": "model_inspected",
      "add": [
        "experiment_configured"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_experiment": {
      "owner": "agent",
      "pre": {
        "and": [
          "env_ready",
          "experiment_configured"
        ]
      },
      "add": [
        "units_checked",
        "trajectories_computed",
        "source_model_exported",
        "sedml_created",
        "archive_exported",
        "csv_written",
        "replay_compared",
        "report_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "check_solver_sensitivity": {
      "owner": "agent",
      "pre": "trajectories_computed",
      "add": [
        "sensitivity_checked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "setup_env",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "inspect_model",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "configure_experiment",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_experiment",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "recheck_tolerances": [
            {
              "act": {
                "cap": "check_solver_sensitivity",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "units_checked",
      "source_model_exported",
      "archive_exported",
      "csv_written",
      "replay_compared",
      "report_written"
    ]
  },
  "init_true": [
    "needs:package_registries"
  ],
  "init_constraints": []
}
