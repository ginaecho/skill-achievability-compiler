{
  "name": "multi-agent-setup",
  "roles": [
    "agent"
  ],
  "capabilities": {
    "inspect": {
      "owner": "agent",
      "pre": true,
      "add": [
        "state_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "migrate_instructions": {
      "owner": "agent",
      "pre": "state_known",
      "add": [
        "agents_md_canonical",
        "instructions_preserved"
      ],
      "del": [
        "claude_md_present"
      ],
      "assigns": {},
      "nondet": {}
    },
    "link_skills": {
      "owner": "agent",
      "pre": "state_known",
      "add": [
        "skills_linked"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "verify": {
      "owner": "agent",
      "pre": {
        "and": [
          "agents_md_canonical",
          "skills_linked"
        ]
      },
      "add": [
        "verified"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "inspect",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "migrate_instructions",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "link_skills",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "verify",
        "by": "agent"
      }
    }
  ],
  "goal": {
    "and": [
      "agents_md_canonical",
      "instructions_preserved",
      {
        "not": "claude_md_present"
      },
      "skills_linked"
    ]
  },
  "init_true": [
    "claude_md_present"
  ],
  "init_constraints": []
}
