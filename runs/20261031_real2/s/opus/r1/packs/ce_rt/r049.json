{
  "name": "complexa-sweep",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "preflight": {
      "owner": "agent",
      "pre": true,
      "add": [
        "readiness_known"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "author_sweeper": {
      "owner": "agent",
      "pre": true,
      "add": [
        "sweeper_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "generate_configs": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:complexa_project",
          "sweeper_ready"
        ]
      },
      "add": [
        "configs_generated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_sweep": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:complexa_cli",
          "needs:gpu",
          {
            "and": [
              "configs_generated",
              "readiness_known"
            ]
          }
        ]
      },
      "add": [
        "sweep_run"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "collect_results": {
      "owner": "agent",
      "pre": "sweep_run",
      "add": [
        "results_collected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "rank_configs": {
      "owner": "agent",
      "pre": "results_collected",
      "add": [
        "summary_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "emit_manifest": {
      "owner": "agent",
      "pre": "summary_written",
      "add": [
        "manifest_emitted"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "preflight",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "author_sweeper",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "proceed": [
            {
              "act": {
                "cap": "generate_configs",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "run_sweep",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "collect_results",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "rank_configs",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "emit_manifest",
                "by": "agent"
              }
            }
          ],
          "cancel": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "summary_written",
      "manifest_emitted"
    ]
  },
  "init_true": [],
  "init_constraints": []
}
