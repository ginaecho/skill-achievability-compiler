{
  "name": "qiime2-amplicon",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "validate": {
      "owner": "agent",
      "pre": {
        "and": [
          "inputs_present",
          {
            "cmp": [
              {
                "-": [
                  {
                    "+": [
                      "trunc_f",
                      "trunc_r"
                    ]
                  },
                  "amplicon_max"
                ]
              },
              ">=",
              12
            ]
          }
        ]
      },
      "add": [
        "validated"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_qiime": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:network"
        ]
      },
      "add": [
        "qiime_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "obtain_classifier": {
      "owner": "agent",
      "pre": {
        "and": [
          false,
          "needs:network",
          "needs:trusted_classifier"
        ]
      },
      "add": [
        "classifier_ready"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "run_workflow": {
      "owner": "agent",
      "pre": {
        "and": [
          "validated",
          "qiime_installed",
          "classifier_ready"
        ]
      },
      "add": [
        "asvs_produced",
        "taxonomy_assigned",
        "provenance_retained"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "inspect_results": {
      "owner": "agent",
      "pre": "provenance_retained",
      "add": [
        "results_inspected"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "validate",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "install_qiime",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "obtain_classifier",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "run_workflow",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "inspect": [
            {
              "act": {
                "cap": "inspect_results",
                "by": "agent"
              }
            }
          ],
          "skip": []
        }
      }
    }
  ],
  "goal": {
    "and": [
      "asvs_produced",
      "taxonomy_assigned",
      "provenance_retained"
    ]
  },
  "init_true": [
    "inputs_present"
  ],
  "init_constraints": [
    {
      "cmp": [
        "trunc_f",
        "==",
        220
      ]
    },
    {
      "cmp": [
        "trunc_r",
        "==",
        200
      ]
    },
    {
      "cmp": [
        "amplicon_max",
        "==",
        300
      ]
    }
  ]
}
