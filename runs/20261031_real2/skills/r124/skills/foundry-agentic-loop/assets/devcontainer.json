{
  "name": "Agentic Loop",
  "image": "[host-1]",
  "features": {
    "[host-2]": {},
    "[host-3]": {
      "installBicep": true
    },
    "[host-4]": {
      "version": "1.35.1",
      "extensions": "[host-5].agents,[host-5].toolboxes,[host-5].skills,[host-5].connections"
    },
    "[host-6]": {}
  },
  "postCreateCommand": "pipx install uv==0.13.1 || pip install --user uv==0.13.1",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.azure-dev",
        "ms-azuretools.vscode-bicep",
        "TeamsDevApp.vscode-ai-foundry",
        "ms-windows-ai-studio.windows-ai-studio"
      ]
    }
  }
}
