{"timestamp": 1795627952.8869798, "type": "tool_start", "call": 2, "code": "\nimport csv, json\n\ndef lin(c):\n    c = c/255\n    return c/12.92 if c<=0.04045 else ((c+0.055)/1.055)**2.4\n\ndef lum(hexcol):\n    hexcol = hexcol.strip().lstrip('#')\n    r,g,b = int(hexcol[0:2],16), int(hexcol[2:4],16), int(hexcol[4:6],16)\n    R,G,B = lin(r), lin(g), lin(b)\n    return 0.2126*R+0.7152*G+0.0722*B\n\ndef contrast(h1,h2):\n    l1, l2 = lum(h1), lum(h2)\n    lighter, darker = max(l1,l2), min(l1,l2)\n    return (lighter+0.05)/(darker+0.05)\n\nwith open('/inputs/colors.csv', newline='') as f:\n    reader = csv.DictReader(f)\n    rows = list(reader)\n\ntotal_palettes = len(rows)\ntotal_pairs = 0\nfailures = []\npassing = 0\nfailing = 0\n\nfor row in rows:\n    pid = int(row['No'])\n    text = row['Text (Hex)']\n    bg = row['Background (Hex)']\n    cta = row['CTA (Hex)']\n    for role, (fg, bgc) in [('body_text', (text, bg)), ('cta_label', (text, cta))]:\n        total_pairs += 1\n        ratio = contrast(fg, bgc)\n        if ratio < 4.5:\n            failing += 1\n            failures.append({\"palette_id\": pid, \"role\": role, \"contrast_ratio\": f\"{ratio:.4f}\"})\n        else:\n            passing += 1\n\nfailures.sort(key=lambda x: (x['palette_id'], x['role']))\n\nresult = {\n    \"standard\": \"WCAG-2.2-AA-normal-text\",\n    \"threshold\": 4.5,\n    \"total_palettes\": total_palettes,\n    \"total_pairs\": total_pairs,\n    \"passing_pairs\": passing,\n    \"failing_pairs\": failing,\n    \"failures\": failures\n}\n\nwith open('/work/palette-contrast.json', 'w') as f:\n    json.dump(result, f, indent=2)\n\nprint(total_palettes, total_pairs, passing, failing)\nprint(len(failures))\n"}
