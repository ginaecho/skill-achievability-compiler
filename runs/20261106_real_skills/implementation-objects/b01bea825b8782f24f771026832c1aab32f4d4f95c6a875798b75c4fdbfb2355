def save(path: Path, value: dict) -> None:
    path.write_text(json.dumps(value, indent=2) + "\n", encoding="utf-8")


def digest(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def task_runtime(case: dict) -> dict:
    profile = case.get("runtime_profile", "python")
    if case.get("id") == SYMBOLIC and profile != "sympy":
        raise ValueError("The symbolic task requires its reviewed sympy runtime profile")
    if profile == "python":
        return RUNTIME
    if profile == "sqlite":
        return SQLITE_RUNTIME
    if profile == "sympy" and case.get("id") == SYMBOLIC:
        return SYMBOLIC_RUNTIME
    raise ValueError(f"Unreviewed task runtime profile: {profile}")


