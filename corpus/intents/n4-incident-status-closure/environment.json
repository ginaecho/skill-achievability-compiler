{
  "name": "n4-incident-status-closure-environment",
  "description": "An incident command workspace for updates and closure.",
  "tools": {
    "draft_update": "Drafts an incident update.",
    "send_status": "Sends an internal status update after the draft is ready.",
    "close_incident": "Closes the incident after the internal status is sent."
  },
  "grants": [],
  "lacks": [],
  "contracts": {
    "draft_update": {
      "add": [
        "update_drafted"
      ]
    },
    "send_status": {
      "pre": "update_drafted",
      "add": [
        "internal_status_sent"
      ]
    },
    "close_incident": {
      "pre": "internal_status_sent",
      "add": [
        "incident_closed"
      ]
    }
  },
  "states": {
    "customers_notified": "customers notified",
    "incident_closed": "incident closed",
    "internal_status_sent": "internal status sent",
    "update_drafted": "update drafted"
  },
  "init_true": []
}
