  "expected_reason": "OK",
  "source": "authored:natural",
  "required_tools": [
    "profile_feature_drift",
    "register_drift_report"
  ],
  "environment_grants": [
    "profile_feature_drift",
    "register_drift_report"
  ],
  "reference_pack": {
    "name": "n5_feature_drift_retry",
    "roles": [
      "monitor"
    ],
    "capabilities": {
      "profile_feature_drift": {
        "owner": "monitor",
        "add": [
          "profiled"
        ]
      },
      "register_drift_report": {
        "owner": "monitor",
        "pre": "profiled",
        "add": [
          "report_registered"
        ]
      }
    },
    "protocol": [
      {
        "rec": {
          "name": "DriftCheck",
          "body": [
            {
              "act": {
                "cap": "profile_feature_drift",
                "by": "monitor"
              }
            },
            {
              "choice": {
                "by": "monitor",
                "branches": {
                  "repeat": [
                    {
                      "continue": "DriftCheck"
                    }
                  ],
                  "ready": []
                }
              }
            }
          ]
        }
      },
      {
        "act": {
          "cap": "register_drift_report",
          "by": "monitor"
        }
      }
    ],
    "goal": "report_registered"
  },
  "note": "The retry loop has an exit branch and the final action establishes the goal."
}
