{
  "name": "n1-room-rate-ceiling-environment",
  "description": "Runtime for hotel reservations with quoting, reservation, and guest email actions.",
  "tools": {
    "quote_room": "Produces a room quote with nightly_rate at most 175 and records room_quoted.",
    "reserve_room": "Requires room_quoted and records room_reserved.",
    "email_guest": "Requires room_reserved and records guest_emailed."
  },
  "grants": [],
  "lacks": [],
  "contracts": {
    "quote_room": {
      "pre": true,
      "add": [
        "room_quoted"
      ],
      "del": [],
      "nondet": {
        "nightly_rate": {
          "cmp": [
            "nightly_rate",
            "<=",
            175
          ]
        }
      },
      "assigns": {}
    },
    "reserve_room": {
      "pre": "room_quoted",
      "add": [
        "room_reserved"
      ],
      "del": [],
      "nondet": {},
      "assigns": {}
    },
    "email_guest": {
      "pre": "room_reserved",
      "add": [
        "guest_emailed"
      ],
      "del": [],
      "nondet": {},
      "assigns": {}
    }
  },
  "states": {
    "guest_emailed": "guest emailed",
    "nightly_rate": "nightly rate",
    "room_quoted": "room quoted",
    "room_reserved": "room reserved"
  },
  "init_true": []
}
