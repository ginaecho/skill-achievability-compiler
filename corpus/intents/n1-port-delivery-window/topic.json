{
  "id": "n1-port-delivery-window",
  "title": "Book a port move within two days",
  "domain": "logistics/shipping",
  "category": "ENV_CONTRACT",
  "expected": "IMPOSSIBLE",
  "expected_reason": "GOAL_UNSAT",
  "source": "authored:natural",
  "required_tools": [
    "quote_port_move",
    "book_port_move",
    "notify_consignee"
  ],
  "environment_grants": [
    "quote_port_move",
    "book_port_move",
    "notify_consignee"
  ],
  "reference_pack": {
    "name": "n1-port-delivery-window",
    "roles": [
      "drayage_planner"
    ],
    "capabilities": {
      "quote_port_move": {
        "owner": "drayage_planner",
        "pre": true,
        "add": [
          "move_quoted"
        ],
        "del": [],
        "assigns": {},
        "nondet": {
          "transit_days": {
            "cmp": [
              "transit_days",
              ">=",
              4
            ]
          }
        }
      },
      "book_port_move": {
        "owner": "drayage_planner",
        "pre": "move_quoted",
        "add": [
          "move_booked"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "notify_consignee": {
        "owner": "drayage_planner",
        "pre": "move_booked",
        "add": [
          "consignee_notified"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      }
    },
    "protocol": [
      {
        "act": {
          "cap": "quote_port_move",
          "by": "drayage_planner"
        }
      },
      {
        "act": {
          "cap": "book_port_move",
          "by": "drayage_planner"
        }
      },
      {
        "act": {
          "cap": "notify_consignee",
          "by": "drayage_planner"
        }
      }
    ],
    "goal": {
      "and": [
        "move_booked",
        "consignee_notified",
        {
          "cmp": [
            "transit_days",
            "<=",
            2
          ]
        }
      ]
    },
    "init_true": [],
    "init_constraints": []
  },
  "note": "The granted quote range is incompatible with the two-day transit goal."
}
