{
  "name": "n1-port-delivery-window-environment",
  "description": "Runtime for port drayage quote, booking, and consignee notification.",
  "tools": {
    "quote_port_move": "Records move_quoted and sets transit_days to at least 4.",
    "book_port_move": "Requires move_quoted and records move_booked.",
    "notify_consignee": "Requires move_booked and records consignee_notified."
  },
  "grants": [],
  "lacks": [],
  "contracts": {
    "quote_port_move": {
      "pre": true,
      "add": [
        "move_quoted"
      ],
      "del": [],
      "nondet": {
        "transit_days": {
          "cmp": [
            "transit_days",
            ">=",
            4
          ]
        }
      },
      "assigns": {}
    },
    "book_port_move": {
      "pre": "move_quoted",
      "add": [
        "move_booked"
      ],
      "del": [],
      "nondet": {},
      "assigns": {}
    },
    "notify_consignee": {
      "pre": "move_booked",
      "add": [
        "consignee_notified"
      ],
      "del": [],
      "nondet": {},
      "assigns": {}
    }
  },
  "states": {
    "consignee_notified": "consignee notified",
    "move_booked": "move booked",
    "move_quoted": "move quoted",
    "transit_days": "transit days"
  },
  "init_true": []
}
