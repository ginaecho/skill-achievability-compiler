{
  "id": "n8-campaign-spend-plan",
  "title": "Campaign spend plan",
  "domain": "marketing",
  "category": "ACHIEVABLE",
  "expected": "ACHIEVABLE",
  "expected_reason": "OK",
  "source": "authored:natural",
  "required_tools": [
    "pull_metrics",
    "forecast_spend",
    "submit_plan"
  ],
  "environment_grants": [
    "pull_metrics",
    "forecast_spend",
    "submit_plan"
  ],
  "reference_pack": {
    "name": "n8_campaign_spend_plan",
    "roles": [
      "marketer"
    ],
    "capabilities": {
      "pull_metrics": {
        "owner": "marketer",
        "add": [
          "metrics_ready"
        ]
      },
      "forecast_spend": {
        "owner": "marketer",
        "pre": "metrics_ready",
        "add": [
          "forecast_ready"
        ],
        "nondet": {
          "spend": {
            "cmp": [
              "spend",
              "<=",
              950
            ]
          }
        }
      },
      "submit_plan": {
        "owner": "marketer",
        "pre": "forecast_ready",
        "add": [
          "plan_submitted"
        ]
      }
    },
    "protocol": [
      {
        "act": {
          "cap": "pull_metrics",
          "by": "marketer"
        }
      },
      {
        "act": {
          "cap": "forecast_spend",
          "by": "marketer"
        }
      },
      {
        "act": {
          "cap": "submit_plan",
          "by": "marketer"
        }
      }
    ],
    "goal": {
      "and": [
        "plan_submitted",
        {
          "cmp": [
            "spend",
            "<=",
            1000
          ]
        }
      ]
    }
  },
  "note": "The spend forecast range is inside the requested ceiling and the plan is submitted."
}