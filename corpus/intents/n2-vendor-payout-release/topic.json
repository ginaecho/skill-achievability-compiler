{
  "id": "n2-vendor-payout-release",
  "title": "Vendor payout release",
  "domain": "payments",
  "category": "ENV_CONTRACT",
  "expected": "IMPOSSIBLE",
  "expected_reason": "GOAL_UNSAT",
  "source": "authored:natural",
  "required_tools": [
    "validate_payee_record",
    "process_vendor_payout",
    "send_vendor_remittance"
  ],
  "environment_grants": [
    "validate_payee_record",
    "process_vendor_payout",
    "send_vendor_remittance"
  ],
  "reference_pack": {
    "name": "n2_vendor_payout_release",
    "roles": [
      "payments_specialist"
    ],
    "capabilities": {
      "validate_payee_record": {
        "owner": "payments_specialist",
        "add": [
          "payee_record_validated"
        ]
      },
      "process_vendor_payout": {
        "owner": "payments_specialist",
        "pre": "payee_record_validated",
        "add": [
          "payout_scheduled"
        ]
      },
      "send_vendor_remittance": {
        "owner": "payments_specialist",
        "pre": "payout_scheduled",
        "add": [
          "vendor_remittance_sent"
        ]
      }
    },
    "protocol": [
      {
        "act": {
          "cap": "validate_payee_record",
          "by": "payments_specialist"
        }
      },
      {
        "act": {
          "cap": "process_vendor_payout",
          "by": "payments_specialist"
        }
      },
      {
        "act": {
          "cap": "send_vendor_remittance",
          "by": "payments_specialist"
        }
      }
    ],
    "goal": {
      "and": [
        "payout_released",
        "vendor_remittance_sent"
      ]
    },
    "init_true": [],
    "init_constraints": []
  },
