{
  "id": "n8-article-copy-retry",
  "title": "Article copy review",
  "domain": "content publishing and media",
  "category": "ACHIEVABLE",
  "expected": "ACHIEVABLE",
  "expected_reason": "OK",
  "source": "authored:natural",
  "required_tools": [
    "check_draft",
    "revise_copy",
    "publish_article"
  ],
  "environment_grants": [
    "check_draft",
    "revise_copy",
    "publish_article"
  ],
  "reference_pack": {
    "name": "n8_article_copy_retry",
    "roles": [
      "editor"
    ],
    "capabilities": {
      "check_draft": {
        "owner": "editor",
        "add": [
          "draft_checked"
        ]
      },
      "revise_copy": {
        "owner": "editor",
        "pre": "draft_checked",
        "add": [
          "copy_revised"
        ]
      },
      "publish_article": {
        "owner": "editor",
        "pre": "draft_checked",
        "add": [
          "article_published"
        ]
      }
    },
    "protocol": [
      {
        "rec": {
          "name": "copy_cycle",
          "body": [
            {
              "act": {
                "cap": "check_draft",
                "by": "editor"
              }
            },
            {
              "choice": {
                "by": "editor",
                "branches": {
                  "revise": [
                    {
                      "act": {
                        "cap": "revise_copy",
                        "by": "editor"
                      }
                    },
                    {
                      "continue": "copy_cycle"
                    }
                  ],
                  "publish": [
                    {
                      "act": {
                        "cap": "publish_article",
                        "by": "editor"
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    ],
    "goal": "article_published"
  },
  "note": "The editor can take the publish branch after any number of revision cycles."
}