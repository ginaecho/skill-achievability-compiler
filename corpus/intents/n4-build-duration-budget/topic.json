{
  "id": "n4-build-duration-budget",
  "title": "Build duration budget",
  "domain": "CI/CD",
  "category": "ACHIEVABLE",
  "expected": "ACHIEVABLE",
  "expected_reason": "OK",
  "source": "authored:natural",
  "required_tools": [
    "queue_build",
    "collect_metrics"
  ],
  "environment_grants": [
    "queue_build",
    "collect_metrics"
  ],
  "reference_pack": {
    "name": "n4-build-duration-budget",
    "roles": [
      "ci_operator"
    ],
    "capabilities": {
      "queue_build": {
        "owner": "ci_operator",
        "add": [
          "build_finished"
        ],
        "nondet": {
          "duration_minutes": {
            "cmp": [
              "duration_minutes",
              "<=",
              12
            ]
          }
        }
      },
      "collect_metrics": {
        "owner": "ci_operator",
        "pre": "build_finished",
        "add": [
          "metrics_collected"
        ]
      }
    },
    "protocol": [
      {
        "act": {
          "cap": "queue_build",
          "by": "ci_operator"
        }
      },
      {
        "act": {
          "cap": "collect_metrics",
          "by": "ci_operator"
        }
      }
    ],
    "goal": {
      "and": [
        "metrics_collected",
        {
          "cmp": [
            "duration_minutes",
            "<=",
            15
          ]
        }
      ]
    }
  },
  "note": "The build duration range is within the requested threshold."
}