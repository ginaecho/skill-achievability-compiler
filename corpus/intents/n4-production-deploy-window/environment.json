{
  "name": "n4-production-deploy-window-environment",
  "description": "A production deployment controller.",
  "tools": {
    "build_release": "Builds the release artifact.",
    "deploy_production": "Deploys to production when the release is built and a window approval is present."
  },
  "grants": [],
  "lacks": [],
  "contracts": {
    "build_release": {
      "add": [
        "release_built"
      ]
    },
    "deploy_production": {
      "pre": {
        "and": [
          "release_built",
          "window_approved"
        ]
      },
      "add": [
        "production_deployed"
      ]
    }
  },
  "states": {
    "production_deployed": "production deployed",
    "release_built": "release built",
    "window_approved": "window approved"
  },
  "init_true": []
}
