{
  "id": "n2-receivables-dso-dashboard",
  "title": "Receivables DSO dashboard",
  "domain": "accounting",
  "category": "ENV_CONTRACT",
  "expected": "IMPOSSIBLE",
  "expected_reason": "GOAL_UNSAT",
  "source": "authored:natural",
  "required_tools": [
    "extract_receivables",
    "compute_dso_metric",
    "publish_ar_dashboard"
  ],
  "environment_grants": [
    "extract_receivables",
    "compute_dso_metric",
    "publish_ar_dashboard"
  ],
  "reference_pack": {
    "name": "n2_receivables_dso_dashboard",
    "roles": [
      "ar_analyst"
    ],
    "capabilities": {
      "extract_receivables": {
        "owner": "ar_analyst",
        "add": [
          "receivables_extracted"
        ]
      },
      "compute_dso_metric": {
        "owner": "ar_analyst",
        "pre": "receivables_extracted",
        "add": [
          "dso_metric_computed"
        ],
        "nondet": {
          "dso": {
            "cmp": [
              "dso",
              ">=",
              75
            ]
          }
        }
      },
      "publish_ar_dashboard": {
        "owner": "ar_analyst",
        "pre": "dso_metric_computed",
        "add": [
          "ar_dashboard_published"
        ]
      }
    },
    "protocol": [
      {
        "act": {
          "cap": "extract_receivables",
          "by": "ar_analyst"
        }
      },
      {
        "act": {
          "cap": "compute_dso_metric",
          "by": "ar_analyst"
        }
      },
      {
        "act": {
          "cap": "publish_ar_dashboard",
          "by": "ar_analyst"
        }
      }
    ],
    "goal": {
      "and": [
        "ar_dashboard_published",
        {
          "cmp": [
            "dso",
            "<",
            45
          ]
        }
      ]
    },
    "init_true": [],
    "init_constraints": []
  },
  "note": "The granted DSO metric range is incompatible with the requested numeric goal."
}
