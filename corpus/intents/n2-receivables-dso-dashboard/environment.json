{
  "name": "n2-receivables-dso-dashboard-environment",
  "description": "Accounts receivable runtime for DSO dashboard publication.",
  "tools": {
    "extract_receivables": "Extracts receivables and records receivables_extracted.",
    "compute_dso_metric": "Requires extracted receivables, records dso_metric_computed, and returns dso at least 75.",
    "publish_ar_dashboard": "Requires a computed DSO metric and records ar_dashboard_published."
  },
  "grants": [],
  "lacks": [],
  "contracts": {
    "extract_receivables": {
      "add": [
        "receivables_extracted"
      ]
    },
    "compute_dso_metric": {
      "pre": "receivables_extracted",
      "add": [
        "dso_metric_computed"
      ],
      "nondet": {
        "dso": {
          "cmp": [
            "dso",
            ">=",
            75
          ]
        }
      }
    },
    "publish_ar_dashboard": {
      "pre": "dso_metric_computed",
      "add": [
        "ar_dashboard_published"
      ]
    }
  },
  "states": {
    "ar_dashboard_published": "ar dashboard published",
    "dso": "dso",
    "dso_metric_computed": "dso metric computed",
    "receivables_extracted": "receivables extracted"
  },
  "init_true": []
}
