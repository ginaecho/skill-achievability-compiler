    "open_claim_file",
    "send_claim_response"
  ],
  "environment_grants": [
    "open_claim_file",
    "send_claim_response"
  ],
  "reference_pack": {
    "name": "n7_claim_response_window",
    "roles": [
      "benefits_coordinator"
    ],
    "capabilities": {
      "open_claim_file": {
        "owner": "benefits_coordinator",
        "add": [
          "claim_opened"
        ]
      },
      "send_claim_response": {
        "owner": "benefits_coordinator",
        "pre": "claim_opened",
        "add": [
          "response_sent"
        ],
        "nondet": {
          "response_days": {
            "cmp": [
              "response_days",
              "<=",
              4
            ]
          }
        }
      }
    },
    "protocol": [
      {
        "act": {
          "cap": "open_claim_file",
          "by": "benefits_coordinator"
        }
      },
      {
        "act": {
          "cap": "send_claim_response",
          "by": "benefits_coordinator"
        }
      }
    ],
    "goal": {
      "and": [
        "response_sent",
        {
          "cmp": [
            "response_days",
            "<=",
            5
          ]
        }
      ]
    }
  },
  "note": "The granted response tool always sets a response window within the requested bound."
}
