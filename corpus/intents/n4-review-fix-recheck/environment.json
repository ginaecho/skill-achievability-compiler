{
  "name": "n4-review-fix-recheck-environment",
  "description": "A pull request assistant runtime for review follow-up.",
  "tools": {
    "fetch_changes": "Loads pull request changes.",
    "suggest_fix": "Creates a suggested fix after changes are loaded.",
    "request_recheck": "Requests a recheck after a patchset is applied."
  },
  "grants": [],
  "lacks": [
    "patchset application"
  ],
  "contracts": {
    "fetch_changes": {
      "add": [
        "changes_loaded"
      ]
    },
    "suggest_fix": {
      "pre": "changes_loaded",
      "add": [
        "fix_suggested"
      ]
    },
    "request_recheck": {
      "pre": "patchset_applied",
      "add": [
        "recheck_requested"
      ]
    }
  },
  "states": {
    "changes_loaded": "changes loaded",
    "fix_suggested": "fix suggested",
    "patchset_applied": "patchset applied",
    "recheck_requested": "recheck requested"
  },
  "init_true": []
}
