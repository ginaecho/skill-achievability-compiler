    "build_standard_package": "Builds a standard package and records package_ready."
  },
  "grants": [],
  "lacks": [],
  "contracts": {
    "check_rights": {
      "add": [
        "rights_checked"
      ]
    },
    "build_rights_package": {
      "pre": "rights_checked",
      "add": [
        "package_ready"
      ]
    },
    "build_standard_package": {
      "add": [
        "package_ready"
      ]
    }
  },
  "states": {
    "package_ready": "package ready",
    "rights_checked": "rights checked"
  },
  "init_true": []
}
