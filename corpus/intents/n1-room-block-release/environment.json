    "release_group_link": "Requires room_block_created and contract_signed; records group_link_released."
  },
  "grants": [],
  "lacks": [],
  "contracts": {
    "create_room_block": {
      "pre": true,
      "add": [
        "room_block_created"
      ],
      "del": [],
      "nondet": {},
      "assigns": {}
    },
    "release_group_link": {
      "pre": {
        "and": [
          "room_block_created",
          "contract_signed"
        ]
      },
      "add": [
        "group_link_released"
      ],
      "del": [],
      "nondet": {},
      "assigns": {}
    }
  },
  "states": {
    "contract_signed": "contract signed",
    "group_link_released": "group link released",
    "room_block_created": "room block created"
  },
  "init_true": []
}
