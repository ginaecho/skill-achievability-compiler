{
  "id": "n5-service-latency-snapshot",
  "title": "Service latency snapshot",
  "domain": "analytics",
  "category": "ENV_CONTRACT",
  "expected": "IMPOSSIBLE",
  "expected_reason": "GOAL_UNSAT",
  "source": "authored:natural",
  "required_tools": [
    "query_service_metrics",
    "compute_latency_snapshot",
    "publish_latency_snapshot"
  ],
  "environment_grants": [
    "query_service_metrics",
    "compute_latency_snapshot",
    "publish_latency_snapshot"
  ],
  "reference_pack": {
    "name": "n5_service_latency_snapshot",
    "roles": [
      "analyst"
    ],
    "capabilities": {
      "query_service_metrics": {
        "owner": "analyst",
        "add": [
          "metrics_queried"
        ]
      },
      "compute_latency_snapshot": {
        "owner": "analyst",
        "pre": "metrics_queried",
        "add": [
          "snapshot_computed"
        ],
        "nondet": {
          "refresh_minutes": {
            "cmp": [
              "refresh_minutes",
              ">=",
              30
            ]
          }
        }
      },
      "publish_latency_snapshot": {
        "owner": "analyst",
        "pre": "snapshot_computed",
        "add": [
          "snapshot_published"
        ]
      }
    },
    "protocol": [
      {
        "act": {
          "cap": "query_service_metrics",
          "by": "analyst"
        }
      },
      {
        "act": {
          "cap": "compute_latency_snapshot",
          "by": "analyst"
        }
      },
      {
        "act": {
          "cap": "publish_latency_snapshot",
          "by": "analyst"
        }
      }
    ],
    "goal": {
      "and": [
        "snapshot_published",
        {
          "cmp": [
            "refresh_minutes",
            "<=",
            15
          ]
        }
      ]
    }
  },
  "note": "The granted snapshot computation yields refresh_minutes >= 30 while the goal requires <= 15."
}
