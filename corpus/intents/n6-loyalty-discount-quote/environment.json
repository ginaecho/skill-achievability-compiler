{
  "name": "n6-loyalty-discount-quote-environment",
  "description": "Runtime for a CRM loyalty quote workflow.",
  "tools": {
    "find_profile": "Finds the CRM profile and records profile_found.",
    "create_discount_quote": "Requires profile_found, creates a discount quote, records quote_created, and sets discount_pct from 10 through 20.",
    "send_quote": "Requires quote_created, sends the quote, and records quote_sent."
  },
  "grants": [],
  "lacks": [],
  "contracts": {
    "find_profile": {
      "pre": true,
      "add": [
        "profile_found"
      ],
      "del": [],
      "nondet": {},
      "assigns": {}
    },
    "create_discount_quote": {
      "pre": "profile_found",
      "add": [
        "quote_created"
      ],
      "del": [],
      "nondet": {
        "discount_pct": {
          "and": [
            {
              "cmp": [
                "discount_pct",
                ">=",
                10
              ]
            },
            {
              "cmp": [
                "discount_pct",
                "<=",
                20
              ]
            }
          ]
        }
      },
      "assigns": {}
    },
    "send_quote": {
      "pre": "quote_created",
      "add": [
        "quote_sent"
      ],
      "del": [],
      "nondet": {},
      "assigns": {}
    }
  },
  "states": {
    "discount_pct": "discount pct",
    "profile_found": "profile found",
    "quote_created": "quote created",
    "quote_sent": "quote sent"
  },
  "init_true": []
}
