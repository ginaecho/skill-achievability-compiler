{
  "id": "n4-flaky-suite-retry",
  "title": "Suite retry report",
  "domain": "CI/CD",
  "category": "ACHIEVABLE",
  "expected": "ACHIEVABLE",
  "expected_reason": "OK",
  "source": "authored:natural",
  "required_tools": [
    "run_suite",
    "publish_test_report"
  ],
  "environment_grants": [
    "run_suite",
    "publish_test_report"
  ],
  "reference_pack": {
    "name": "n4-flaky-suite-retry",
    "roles": [
      "test_runner"
    ],
    "capabilities": {
      "run_suite": {
        "owner": "test_runner",
        "add": [
          "suite_green"
        ]
      },
      "publish_test_report": {
        "owner": "test_runner",
        "pre": "suite_green",
        "add": [
          "report_shared"
        ]
      }
    },
    "protocol": [
      {
        "rec": {
          "name": "R",
          "body": [
            {
              "act": {
                "cap": "run_suite",
                "by": "test_runner"
              }
            },
            {
              "choice": {
                "by": "test_runner",
                "branches": {
                  "again": [
                    {
                      "continue": "R"
                    }
                  ],
                  "ready": []
                }
              }
            }
          ]
        }
      },
      {
        "act": {
          "cap": "publish_test_report",
          "by": "test_runner"
        }
      }
    ],
    "goal": "report_shared"
  },
  "note": "The retry loop has an exit branch and the report tool follows a green suite."
}