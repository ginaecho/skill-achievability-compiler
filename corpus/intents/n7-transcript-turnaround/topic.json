{
  "id": "n7-transcript-turnaround",
  "title": "Transcript turnaround target",
  "domain": "education",
  "category": "ENV_CONTRACT",
  "expected": "IMPOSSIBLE",
  "expected_reason": "GOAL_UNSAT",
  "source": "authored:natural",
  "required_tools": [
    "intake_transcript_request",
    "set_transcript_window",
    "send_transcript_status"
  ],
  "environment_grants": [
    "intake_transcript_request",
    "set_transcript_window",
    "send_transcript_status"
  ],
  "reference_pack": {
    "name": "n7_transcript_turnaround",
    "roles": [
      "records_officer"
    ],
    "capabilities": {
      "intake_transcript_request": {
        "owner": "records_officer",
        "add": [
          "request_entered"
        ]
      },
      "set_transcript_window": {
        "owner": "records_officer",
        "pre": "request_entered",
        "add": [
          "window_set"
        ],
        "nondet": {
          "business_days": {
            "cmp": [
              "business_days",
              ">=",
              10
            ]
          }
        }
      },
      "send_transcript_status": {
        "owner": "records_officer",
        "pre": "window_set",
        "add": [
          "status_sent"
        ]
      }
    },
    "protocol": [
      {
        "act": {
          "cap": "intake_transcript_request",
          "by": "records_officer"
        }
      },
      {
        "act": {
          "cap": "set_transcript_window",
          "by": "records_officer"
        }
      },
      {
        "act": {
          "cap": "send_transcript_status",
          "by": "records_officer"
        }
      }
    ],
    "goal": {
      "and": [
        "status_sent",
        {
          "cmp": [
            "business_days",
            "<=",
            5
          ]
        }
      ]
    }
  },
  "note": "The granted scheduling action always assigns a turnaround above the requested numeric bound."
}
