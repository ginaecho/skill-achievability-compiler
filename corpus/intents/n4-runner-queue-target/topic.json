{
  "id": "n4-runner-queue-target",
  "title": "Runner queue target",
  "domain": "CI/CD",
  "category": "ENV_CONTRACT",
  "expected": "IMPOSSIBLE",
  "expected_reason": "GOAL_UNSAT",
  "source": "authored:natural",
  "required_tools": [
    "start_runner",
    "notify_runner_ready"
  ],
  "environment_grants": [
    "start_runner",
    "notify_runner_ready"
  ],
  "reference_pack": {
    "name": "n4-runner-queue-target",
    "roles": [
      "ops_engineer"
    ],
    "capabilities": {
      "start_runner": {
        "owner": "ops_engineer",
        "add": [
          "runner_started"
        ],
        "nondet": {
          "wait_minutes": {
            "cmp": [
              "wait_minutes",
              ">=",
              30
            ]
          }
        }
      },
      "notify_runner_ready": {
        "owner": "ops_engineer",
        "pre": "runner_started",
        "add": [
          "runner_ready_notice"
        ]
      }
    },
    "protocol": [
      {
        "act": {
          "cap": "start_runner",
          "by": "ops_engineer"
        }
      },
      {
        "act": {
          "cap": "notify_runner_ready",
          "by": "ops_engineer"
        }
      }
    ],
    "goal": {
      "and": [
        "runner_ready_notice",
        {
          "cmp": [
            "wait_minutes",
            "<",
            10
          ]
        }
      ]
    }
  },
  "note": "The runner wait range conflicts with the requested numeric target."
}