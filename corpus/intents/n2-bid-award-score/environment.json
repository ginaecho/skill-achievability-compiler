{
  "name": "n2-bid-award-score-environment",
  "description": "Sourcing runtime for bid scoring and supplier awards.",
  "tools": {
    "collect_supplier_bids": "Collects bid responses and records supplier_bids_collected.",
    "score_bid_responses": "Requires collected bids, records bid_responses_scored, and returns score from 82 through 100.",
    "award_supplier": "Requires scored bid responses and records supplier_awarded."
  },
  "grants": [],
  "lacks": [],
  "contracts": {
    "collect_supplier_bids": {
      "add": [
        "supplier_bids_collected"
      ]
    },
    "score_bid_responses": {
      "pre": "supplier_bids_collected",
      "add": [
        "bid_responses_scored"
      ],
      "nondet": {
        "score": {
          "and": [
            {
              "cmp": [
                "score",
                ">=",
                82
              ]
            },
            {
              "cmp": [
                "score",
                "<=",
                100
              ]
            }
          ]
        }
      }
    },
    "award_supplier": {
      "pre": "bid_responses_scored",
      "add": [
        "supplier_awarded"
      ]
    }
  },
  "states": {
    "bid_responses_scored": "bid responses scored",
    "score": "score",
    "supplier_awarded": "supplier awarded",
    "supplier_bids_collected": "supplier bids collected"
  },
  "init_true": []
}
