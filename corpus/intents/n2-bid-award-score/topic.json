  ],
  "environment_grants": [
    "collect_supplier_bids",
    "score_bid_responses",
    "award_supplier"
  ],
  "reference_pack": {
    "name": "n2_bid_award_score",
    "roles": [
      "sourcing_manager"
    ],
    "capabilities": {
      "collect_supplier_bids": {
        "owner": "sourcing_manager",
        "add": [
          "supplier_bids_collected"
        ]
      },
      "score_bid_responses": {
        "owner": "sourcing_manager",
        "pre": "supplier_bids_collected",
        "add": [
          "bid_responses_scored"
        ],
        "nondet": {
          "score": {
            "and": [
              {
                "cmp": [
                  "score",
                  ">=",
                  82
                ]
              },
              {
                "cmp": [
                  "score",
                  "<=",
                  100
                ]
              }
            ]
          }
        }
      },
      "award_supplier": {
        "owner": "sourcing_manager",
        "pre": "bid_responses_scored",
        "add": [
          "supplier_awarded"
        ]
      }
    },
    "protocol": [
      {
        "act": {
          "cap": "collect_supplier_bids",
          "by": "sourcing_manager"
        }
      },
      {
        "act": {
          "cap": "score_bid_responses",
          "by": "sourcing_manager"
        }
      },
      {
        "act": {
          "cap": "award_supplier",
          "by": "sourcing_manager"
        }
      }
    ],
    "goal": {
      "and": [
        "supplier_awarded",
        {
          "cmp": [
            "score",
            ">=",
            80
          ]
        }
      ]
    },
    "init_true": [],
    "init_constraints": []
  },
  "note": "The scoring tool range satisfies the requested award score threshold."
