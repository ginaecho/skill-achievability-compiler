{
  "name": "n3-recruiting-shortlist-sla-environment",
  "description": "A workplace automation runtime for recruiting tasks.",
  "tools": {
    "search_candidate_pool": "Searches candidates and prepares a shortlist.",
    "send_shortlist_to_manager": "Sends a shortlist to the hiring manager."
  },
  "grants": [],
  "lacks": [],
  "contracts": {
    "search_candidate_pool": {
      "add": [
        "shortlist_ready"
      ],
      "nondet": {
        "turnaround_days": {
          "cmp": [
            "turnaround_days",
            ">=",
            5
          ]
        }
      }
    },
    "send_shortlist_to_manager": {
      "pre": "shortlist_ready",
      "add": [
        "shortlist_sent"
      ]
    }
  },
  "states": {
    "shortlist_ready": "shortlist ready",
    "shortlist_sent": "shortlist sent",
    "turnaround_days": "turnaround days"
  },
  "init_true": []
}
