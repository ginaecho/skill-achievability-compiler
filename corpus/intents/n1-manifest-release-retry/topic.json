{
  "id": "n1-manifest-release-retry",
  "title": "Retry manifest scan before release",
  "domain": "logistics/shipping",
  "category": "ACHIEVABLE",
  "expected": "ACHIEVABLE",
  "expected_reason": "OK",
  "source": "authored:natural",
  "required_tools": [
    "scan_manifest",
    "release_container"
  ],
  "environment_grants": [
    "scan_manifest",
    "release_container"
  ],
  "reference_pack": {
    "name": "n1-manifest-release-retry",
    "roles": [
      "yard_agent"
    ],
    "capabilities": {
      "scan_manifest": {
        "owner": "yard_agent",
        "pre": true,
        "add": [
          "manifest_found"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      },
      "release_container": {
        "owner": "yard_agent",
        "pre": "manifest_found",
        "add": [
          "container_released"
        ],
        "del": [],
        "assigns": {},
        "nondet": {}
      }
    },
    "protocol": [
      {
        "rec": {
          "name": "R",
          "body": [
            {
              "act": {
                "cap": "scan_manifest",
                "by": "yard_agent"
              }
            },
            {
              "choice": {
                "by": "yard_agent",
                "branches": {
                  "scan_again": [
                    {
                      "continue": "R"
                    }
                  ],
                  "ready": []
                }
              }
            }
          ]
        }
      },
      {
        "act": {
          "cap": "release_container",
          "by": "yard_agent"
        }
      }
    ],
    "goal": "container_released",
    "init_true": [],
    "init_constraints": []
  },
  "note": "The recursive scan has an exit branch and the release follows after the manifest is found."
}
