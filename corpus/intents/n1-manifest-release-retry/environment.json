{
  "name": "n1-manifest-release-retry-environment",
  "description": "Runtime for a yard agent scanning shipment manifests before container release.",
  "tools": {
    "scan_manifest": "Records manifest_found for a container.",
    "release_container": "Requires manifest_found and records container_released."
  },
  "grants": [],
  "lacks": [],
  "contracts": {
    "scan_manifest": {
      "pre": true,
      "add": [
        "manifest_found"
      ],
      "del": [],
      "nondet": {},
      "assigns": {}
    },
    "release_container": {
      "pre": "manifest_found",
      "add": [
        "container_released"
      ],
      "del": [],
      "nondet": {},
      "assigns": {}
    }
  },
  "states": {
    "container_released": "container released",
    "manifest_found": "manifest found"
  },
  "init_true": []
}
