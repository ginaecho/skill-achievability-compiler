{
  "name": "n4-pr-review-readiness-environment",
  "description": "A pull request review workspace.",
  "tools": {
    "scan_diff": "Scans the pull request diff and records that scanning is complete.",
    "post_review": "Posts a review after the diff scan completes.",
    "mark_ready": "Marks the pull request ready after the review is posted."
  },
  "grants": [],
  "lacks": [],
  "contracts": {
    "scan_diff": {
      "add": [
        "diff_scanned"
      ]
    },
    "post_review": {
      "pre": "diff_scanned",
      "add": [
        "review_posted"
      ]
    },
    "mark_ready": {
      "pre": "review_posted",
      "add": [
        "ready_for_merge"
      ]
    }
  },
  "states": {
    "diff_scanned": "diff scanned",
    "ready_for_merge": "ready for merge",
    "review_posted": "review posted"
  },
  "init_true": []
}
