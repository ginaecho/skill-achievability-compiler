{
  "id": "n2-quarterly-liquidity-brief",
  "title": "Quarterly liquidity brief",
  "domain": "finance",
  "category": "ACHIEVABLE",
  "expected": "ACHIEVABLE",
  "expected_reason": "OK",
  "source": "authored:natural",
  "required_tools": [
    "pull_cash_positions",
    "calculate_runway",
    "publish_treasury_brief"
  ],
  "environment_grants": [
    "pull_cash_positions",
    "calculate_runway",
    "publish_treasury_brief"
  ],
  "reference_pack": {
    "name": "n2_quarterly_liquidity_brief",
    "roles": [
      "treasury_analyst"
    ],
    "capabilities": {
      "pull_cash_positions": {
        "owner": "treasury_analyst",
        "add": [
          "cash_positions_pulled"
        ]
      },
      "calculate_runway": {
        "owner": "treasury_analyst",
        "pre": "cash_positions_pulled",
        "add": [
          "runway_calculated"
        ],
        "nondet": {
          "runway_days": {
            "and": [
              {
                "cmp": [
                  "runway_days",
                  ">=",
                  95
                ]
              },
              {
                "cmp": [
                  "runway_days",
                  "<=",
                  130
                ]
              }
            ]
          }
        }
      },
      "publish_treasury_brief": {
        "owner": "treasury_analyst",
        "pre": "runway_calculated",
        "add": [
          "treasury_brief_published"
        ]
      }
    },
    "protocol": [
      {
        "act": {
          "cap": "pull_cash_positions",
          "by": "treasury_analyst"
        }
      },
      {
        "act": {
          "cap": "calculate_runway",
          "by": "treasury_analyst"
        }
      },
      {
        "act": {
          "cap": "publish_treasury_brief",
          "by": "treasury_analyst"
        }
      }
    ],
    "goal": {
      "and": [
        "treasury_brief_published",
        {
          "cmp": [
            "runway_days",
            ">=",
            90
          ]
        }
      ]
    },
    "init_true": [],
    "init_constraints": []
  },
  "note": "The granted calculation range satisfies the runway target and the brief is published."
}
