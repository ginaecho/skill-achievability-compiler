{
  "id": "n3-timecard-audit-sample",
  "title": "Timecard audit sampling",
  "domain": "HR operations",
  "category": "ACHIEVABLE",
  "expected": "ACHIEVABLE",
  "expected_reason": "OK",
  "source": "authored:natural",
  "required_tools": [
    "sample_timecards",
    "publish_audit_summary"
  ],
  "environment_grants": [
    "sample_timecards",
    "publish_audit_summary"
  ],
  "reference_pack": {
    "name": "n3_timecard_audit_sample",
    "roles": [
      "auditor"
    ],
    "capabilities": {
      "sample_timecards": {
        "owner": "auditor",
        "add": [
          "sample_prepared"
        ],
        "nondet": {
          "sample_count": {
            "and": [
              {
                "cmp": [
                  "sample_count",
                  ">=",
                  12
                ]
              },
              {
                "cmp": [
                  "sample_count",
                  "<=",
                  18
                ]
              }
            ]
          }
        }
      },
      "publish_audit_summary": {
        "owner": "auditor",
        "pre": "sample_prepared",
        "add": [
          "summary_published"
        ]
      }
    },
    "protocol": [
      {
        "act": {
          "cap": "sample_timecards",
          "by": "auditor"
        }
      },
      {
        "act": {
          "cap": "publish_audit_summary",
          "by": "auditor"
        }
      }
    ],
    "goal": {
      "and": [
        "summary_published",
        {
          "cmp": [
            "sample_count",
            ">=",
            10
          ]
        },
        {
          "cmp": [
            "sample_count",
            "<=",
            20
          ]
        }
      ]
    }
  },
  "note": "The sample count range satisfies the numeric goal."
}
