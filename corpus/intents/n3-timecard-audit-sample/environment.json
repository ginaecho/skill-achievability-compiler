{
  "name": "n3-timecard-audit-sample-environment",
  "description": "A workplace automation runtime for HR operations tasks.",
  "tools": {
    "sample_timecards": "Builds a timecard audit sample.",
    "publish_audit_summary": "Publishes the audit summary."
  },
  "grants": [],
  "lacks": [],
  "contracts": {
    "sample_timecards": {
      "add": [
        "sample_prepared"
      ],
      "nondet": {
        "sample_count": {
          "and": [
            {
              "cmp": [
                "sample_count",
                ">=",
                12
              ]
            },
            {
              "cmp": [
                "sample_count",
                "<=",
                18
              ]
            }
          ]
        }
      }
    },
    "publish_audit_summary": {
      "pre": "sample_prepared",
      "add": [
        "summary_published"
      ]
    }
  },
  "states": {
    "sample_count": "sample count",
    "sample_prepared": "sample prepared",
    "summary_published": "summary published"
  },
  "init_true": []
}
