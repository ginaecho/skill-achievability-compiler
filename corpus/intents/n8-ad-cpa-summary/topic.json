{
  "id": "n8-ad-cpa-summary",
  "title": "Ad CPA summary",
  "domain": "marketing",
  "category": "ENV_CONTRACT",
  "expected": "IMPOSSIBLE",
  "expected_reason": "GOAL_UNSAT",
  "source": "authored:natural",
  "required_tools": [
    "load_ad_data",
    "optimize_bid",
    "publish_summary"
  ],
  "environment_grants": [
    "load_ad_data",
    "optimize_bid",
    "publish_summary"
  ],
  "reference_pack": {
    "name": "n8_ad_cpa_summary",
    "roles": [
      "analyst"
    ],
    "capabilities": {
      "load_ad_data": {
        "owner": "analyst",
        "add": [
          "ad_data_loaded"
        ]
      },
      "optimize_bid": {
        "owner": "analyst",
        "pre": "ad_data_loaded",
        "add": [
          "bid_optimized"
        ],
        "nondet": {
          "cpa": {
            "cmp": [
              "cpa",
              ">=",
              75
            ]
          }
        }
      },
      "publish_summary": {
        "owner": "analyst",
        "pre": "bid_optimized",
        "add": [
          "summary_published"
        ]
      }
    },
    "protocol": [
      {
        "act": {
          "cap": "load_ad_data",
          "by": "analyst"
        }
      },
      {
        "act": {
          "cap": "optimize_bid",
          "by": "analyst"
        }
      },
      {
        "act": {
          "cap": "publish_summary",
          "by": "analyst"
        }
      }
    ],
    "goal": {
      "and": [
        "summary_published",
        {
          "cmp": [
            "cpa",
            "<=",
            50
          ]
        }
      ]
    }
  },
  "note": "The granted bid optimizer's numeric range conflicts with the CPA goal."
}