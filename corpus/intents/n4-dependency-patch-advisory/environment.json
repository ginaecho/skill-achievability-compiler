{
  "name": "n4-dependency-patch-advisory-environment",
  "description": "A repository maintenance runtime for dependency work.",
  "tools": {
    "inspect_deps": "Inspects dependency manifests and records inspection.",
    "patch_manifest": "Patches the manifest after inspection."
  },
  "grants": [],
  "lacks": [
    "advisory publishing"
  ],
  "contracts": {
    "inspect_deps": {
      "add": [
        "deps_inspected"
      ]
    },
    "patch_manifest": {
      "pre": "deps_inspected",
      "add": [
        "manifest_patched"
      ]
    }
  },
  "states": {
    "advisory_published": "advisory published",
    "deps_inspected": "deps inspected",
    "manifest_patched": "manifest patched"
  },
  "init_true": []
}
