{
  "name": "algorithmic-art",
  "roles": [
    "assistant"
  ],
  "capabilities": {
    "read_template_viewer": {
      "owner": "assistant",
      "pre": true,
      "add": [
        "viewer_template_read"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_philosophy_md": {
      "owner": "assistant",
      "pre": true,
      "add": [
        "philosophy_md_written"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "write_single_html_artifact": {
      "owner": "assistant",
      "pre": "viewer_template_read",
      "add": [
        "html_artifact_written",
        "seed_controls_present",
        "parameter_controls_present",
        "actions_present",
        "template_structure_preserved",
        "self_contained_html",
        "p5js_inline",
        "reproducible_seeded_randomness"
      ],
      "del": [],
      "assigns": {},
      "nondet": {
        "philosophy_paragraphs": {
          "and": [
            {
              "cmp": [
                "philosophy_paragraphs",
                ">=",
                4
              ]
            },
            {
              "cmp": [
                "philosophy_paragraphs",
                "<=",
                6
              ]
            }
          ]
        }
      }
    }
  },
  "protocol": [
    {
      "act": {
        "cap": "write_philosophy_md",
        "by": "assistant"
      }
    },
    {
      "act": {
        "cap": "read_template_viewer",
        "by": "assistant"
      }
    },
    {
      "act": {
        "cap": "write_single_html_artifact",
        "by": "assistant"
      }
    }
  ],
  "goal": {
    "and": [
      "philosophy_md_written",
      "html_artifact_written",
      "viewer_template_read",
      "seed_controls_present",
      "parameter_controls_present",
      "actions_present",
      "template_structure_preserved",
      "self_contained_html",
      "p5js_inline",
      "reproducible_seeded_randomness",
      {
        "and": [
          {
            "cmp": [
              "philosophy_paragraphs",
              ">=",
              4
            ]
          },
          {
            "cmp": [
              "philosophy_paragraphs",
              "<=",
              6
            ]
          }
        ]
      }
    ]
  },
  "init_true": [],
  "init_constraints": []
}
