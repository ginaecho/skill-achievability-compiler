{
  "name": "webapp-testing",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "read_html_file": {
      "owner": "agent",
      "pre": true,
      "add": [
        "html_read"
      ],
      "del": []
    },
    "run_help_for_with_server": {
      "owner": "agent",
      "pre": true,
      "add": [
        "with_server_help_seen"
      ],
      "del": []
    },
    "run_with_server_playwright_script": {
      "owner": "agent",
      "pre": "with_server_help_seen",
      "add": [
        "server_running",
        "page_loaded",
        "networkidle_reached"
      ],
      "del": []
    },
    "run_playwright_on_running_server": {
      "owner": "agent",
      "pre": "server_running",
      "add": [
        "page_loaded",
        "networkidle_reached"
      ],
      "del": []
    },
    "inspect_rendered_dom": {
      "owner": "agent",
      "pre": "networkidle_reached",
      "add": [
        "dom_inspected",
        "selectors_identified"
      ],
      "del": []
    },
    "take_screenshot": {
      "owner": "agent",
      "pre": "networkidle_reached",
      "add": [
        "screenshot_captured"
      ],
      "del": []
    },
    "write_playwright_script": {
      "owner": "agent",
      "pre": true,
      "add": [
        "playwright_script_written",
        "browser_will_be_closed"
      ],
      "del": []
    },
    "execute_actions_with_selectors": {
      "owner": "agent",
      "pre": {
        "and": [
          "playwright_script_written",
          "selectors_identified"
        ]
      },
      "add": [
        "frontend_actions_executed"
      ],
      "del": []
    },
    "view_browser_logs": {
      "owner": "agent",
      "pre": "page_loaded",
      "add": [
        "browser_logs_viewed"
      ],
      "del": []
    },
    "close_browser": {
      "owner": "agent",
      "pre": "page_loaded",
      "add": [
        "browser_closed"
      ],
      "del": []
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "static_html": [
            {
              "act": {
                "cap": "read_html_file",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "agent",
                "observed": true,
                "branches": {
                  "selectors_found": [
                    {
                      "act": {
                        "cap": "write_playwright_script",
                        "by": "agent"
                      }
                    }
                  ],
                  "treat_as_dynamic": [
                    {
                      "choice": {
                        "by": "agent",
                        "observed": true,
                        "branches": {
                          "server_not_running": [
                            {
                              "act": {
                                "cap": "run_help_for_with_server",
                                "by": "agent"
                              }
                            },
                            {
                              "act": {
                                "cap": "write_playwright_script",
                                "by": "agent"
                              }
                            },
                            {
                              "act": {
                                "cap": "run_with_server_playwright_script",
                                "by": "agent"
                              }
                            },
                            {
                              "act": {
                                "cap": "take_screenshot",
                                "by": "agent"
                              }
                            },
                            {
                              "act": {
                                "cap": "inspect_rendered_dom",
                                "by": "agent"
                              }
                            },
                            {
                              "act": {
                                "cap": "execute_actions_with_selectors",
                                "by": "agent"
                              }
                            },
                            {
                              "choice": {
                                "by": "agent",
                                "observed": true,
                                "branches": {
                                  "view_logs": [
                                    {
                                      "act": {
                                        "cap": "view_browser_logs",
                                        "by": "agent"
                                      }
                                    }
                                  ],
                                  "skip_logs": []
                                }
                              }
                            },
                            {
                              "act": {
                                "cap": "close_browser",
                                "by": "agent"
                              }
                            }
                          ],
                          "server_running": [
                            {
                              "act": {
                                "cap": "write_playwright_script",
                                "by": "agent"
                              }
                            },
                            {
                              "act": {
                                "cap": "run_playwright_on_running_server",
                                "by": "agent"
                              }
                            },
                            {
                              "act": {
                                "cap": "take_screenshot",
                                "by": "agent"
                              }
                            },
                            {
                              "act": {
                                "cap": "inspect_rendered_dom",
                                "by": "agent"
                              }
                            },
                            {
                              "act": {
                                "cap": "execute_actions_with_selectors",
                                "by": "agent"
                              }
                            },
                            {
                              "choice": {
                                "by": "agent",
                                "observed": true,
                                "branches": {
                                  "view_logs": [
                                    {
                                      "act": {
                                        "cap": "view_browser_logs",
                                        "by": "agent"
                                      }
                                    }
                                  ],
                                  "skip_logs": []
                                }
                              }
                            },
                            {
                              "act": {
                                "cap": "close_browser",
                                "by": "agent"
                              }
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          ],
          "dynamic_webapp": [
            {
              "choice": {
                "by": "agent",
                "observed": true,
                "branches": {
                  "server_not_running": [
                    {
                      "act": {
                        "cap": "run_help_for_with_server",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "write_playwright_script",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "run_with_server_playwright_script",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "take_screenshot",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "inspect_rendered_dom",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "execute_actions_with_selectors",
                        "by": "agent"
                      }
                    },
                    {
                      "choice": {
                        "by": "agent",
                        "observed": true,
                        "branches": {
                          "view_logs": [
                            {
                              "act": {
                                "cap": "view_browser_logs",
                                "by": "agent"
                              }
                            }
                          ],
                          "skip_logs": []
                        }
                      }
                    },
                    {
                      "act": {
                        "cap": "close_browser",
                        "by": "agent"
                      }
                    }
                  ],
                  "server_running": [
                    {
                      "act": {
                        "cap": "write_playwright_script",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "run_playwright_on_running_server",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "take_screenshot",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "inspect_rendered_dom",
                        "by": "agent"
                      }
                    },
                    {
                      "act": {
                        "cap": "execute_actions_with_selectors",
                        "by": "agent"
                      }
                    },
                    {
                      "choice": {
                        "by": "agent",
                        "observed": true,
                        "branches": {
                          "view_logs": [
                            {
                              "act": {
                                "cap": "view_browser_logs",
                                "by": "agent"
                              }
                            }
                          ],
                          "skip_logs": []
                        }
                      }
                    },
                    {
                      "act": {
                        "cap": "close_browser",
                        "by": "agent"
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "or": [
      {
        "and": [
          "playwright_script_written",
          "browser_closed"
        ]
      },
      {
        "and": [
          "frontend_actions_executed",
          "browser_closed"
        ]
      },
      {
        "and": [
          "screenshot_captured",
          "browser_closed"
        ]
      },
      {
        "and": [
          "browser_logs_viewed",
          "browser_closed"
        ]
      }
    ]
  },
  "init_true": [],
  "init_constraints": []
}
