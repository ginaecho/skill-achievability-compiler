{
  "name": "slack-gif-creator",
  "roles": [
    "agent",
    "user"
  ],
  "capabilities": {
    "ask_clarifying_question": {
      "owner": "agent",
      "pre": true,
      "add": [
        "clarification_obtained"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "inspect_user_upload": {
      "owner": "agent",
      "pre": true,
      "add": [
        "upload_available"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "install_dependencies": {
      "owner": "agent",
      "pre": true,
      "add": [
        "deps_installed"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    },
    "create_gif": {
      "owner": "agent",
      "pre": {
        "and": [
          "deps_installed"
        ]
      },
      "add": [
        "gif_created"
      ],
      "del": [],
      "assigns": {},
      "nondet": {
        "gif_width": {
          "or": [
            {
              "cmp": [
                "gif_width",
                "==",
                128
              ]
            },
            {
              "cmp": [
                "gif_width",
                "==",
                480
              ]
            }
          ]
        },
        "gif_height": {
          "or": [
            {
              "cmp": [
                "gif_height",
                "==",
                128
              ]
            },
            {
              "cmp": [
                "gif_height",
                "==",
                480
              ]
            }
          ]
        },
        "gif_fps": {
          "and": [
            {
              "cmp": [
                "gif_fps",
                ">=",
                10
              ]
            },
            {
              "cmp": [
                "gif_fps",
                "<=",
                30
              ]
            }
          ]
        },
        "gif_duration_sec": true,
        "gif_num_colors": {
          "and": [
            {
              "cmp": [
                "gif_num_colors",
                ">=",
                48
              ]
            },
            {
              "cmp": [
                "gif_num_colors",
                "<=",
                128
              ]
            }
          ]
        }
      }
    },
    "optimize_gif": {
      "owner": "agent",
      "pre": {
        "and": [
          "gif_created"
        ]
      },
      "add": [
        "gif_optimized"
      ],
      "del": [],
      "assigns": {},
      "nondet": {
        "gif_width": {
          "or": [
            {
              "cmp": [
                "gif_width",
                "==",
                128
              ]
            },
            {
              "cmp": [
                "gif_width",
                "==",
                480
              ]
            }
          ]
        },
        "gif_height": {
          "or": [
            {
              "cmp": [
                "gif_height",
                "==",
                128
              ]
            },
            {
              "cmp": [
                "gif_height",
                "==",
                480
              ]
            }
          ]
        },
        "gif_fps": {
          "and": [
            {
              "cmp": [
                "gif_fps",
                ">=",
                10
              ]
            },
            {
              "cmp": [
                "gif_fps",
                "<=",
                30
              ]
            }
          ]
        },
        "gif_num_colors": {
          "and": [
            {
              "cmp": [
                "gif_num_colors",
                ">=",
                48
              ]
            },
            {
              "cmp": [
                "gif_num_colors",
                "<=",
                128
              ]
            }
          ]
        }
      }
    },
    "validate_gif": {
      "owner": "agent",
      "pre": {
        "or": [
          "gif_created",
          "gif_optimized"
        ]
      },
      "add": [],
      "del": [],
      "assigns": {},
      "nondet": {
        "slack_ready": {
          "or": [
            {
              "cmp": [
                "slack_ready",
                "==",
                0
              ]
            },
            {
              "cmp": [
                "slack_ready",
                "==",
                1
              ]
            }
          ]
        }
      }
    },
    "deliver_gif": {
      "owner": "agent",
      "pre": {
        "or": [
          "gif_created",
          "gif_optimized"
        ]
      },
      "add": [
        "gif_delivered"
      ],
      "del": [],
      "assigns": {},
      "nondet": {}
    }
  },
  "protocol": [
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "ask_for_details": [
            {
              "act": {
                "cap": "ask_clarifying_question",
                "by": "agent"
              }
            }
          ],
          "proceed": []
        }
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "use_uploaded_image": [
            {
              "act": {
                "cap": "inspect_user_upload",
                "by": "agent"
              }
            }
          ],
          "draw_from_scratch": []
        }
      }
    },
    {
      "act": {
        "cap": "install_dependencies",
        "by": "agent"
      }
    },
    {
      "act": {
        "cap": "create_gif",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "user",
        "observed": true,
        "branches": {
          "make_file_smaller": [
            {
              "act": {
                "cap": "optimize_gif",
                "by": "agent"
              }
            }
          ],
          "no_size_reduction_request": []
        }
      }
    },
    {
      "act": {
        "cap": "validate_gif",
        "by": "agent"
      }
    },
    {
      "choice": {
        "by": "agent",
        "observed": true,
        "branches": {
          "valid": [
            {
              "act": {
                "cap": "deliver_gif",
                "by": "agent"
              }
            }
          ],
          "invalid": [
            {
              "act": {
                "cap": "create_gif",
                "by": "agent"
              }
            },
            {
              "choice": {
                "by": "user",
                "observed": true,
                "branches": {
                  "make_file_smaller": [
                    {
                      "act": {
                        "cap": "optimize_gif",
                        "by": "agent"
                      }
                    }
                  ],
                  "no_size_reduction_request": []
                }
              }
            },
            {
              "act": {
                "cap": "validate_gif",
                "by": "agent"
              }
            },
            {
              "act": {
                "cap": "deliver_gif",
                "by": "agent"
              }
            }
          ]
        }
      }
    }
  ],
  "goal": {
    "and": [
      "gif_delivered",
      {
        "cmp": [
          "gif_width",
          "==",
          128
        ]
      },
      {
        "cmp": [
          "gif_height",
          "==",
          128
        ]
      },
      {
        "cmp": [
          "gif_fps",
          ">=",
          10
        ]
      },
      {
        "cmp": [
          "gif_fps",
          "<=",
          30
        ]
      },
      {
        "cmp": [
          "gif_num_colors",
          ">=",
          48
        ]
      },
      {
        "cmp": [
          "gif_num_colors",
          "<=",
          128
        ]
      },
      {
        "cmp": [
          "slack_ready",
          "==",
          1
        ]
      }
    ]
  },
  "init_true": [],
  "init_constraints": []
}
