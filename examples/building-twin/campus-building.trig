# A larger, made-up building graph for the skillc twin demo, written by make_campus.py.
# No real tenant data.
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix rec:   <https://w3id.org/rec#> .
@prefix ref:   <https://brickschema.org/schema/Brick/ref#> .
@prefix bacnet: <http://data.ashrae.org/bacnet/2020#> .
@prefix unit:  <http://qudt.org/vocab/unit/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:    <urn:bdt:campus:> .

# The ontology graph: vocabulary only. It never counts as building evidence.
<bdt:ontology:vendor> {
  ex:VendorTempSP rdfs:subClassOf brick:Zone_Air_Temperature_Setpoint .
  ex:WeeklySchedule rdfs:subClassOf ex:Schedule .
  ex:OperatingPolicy rdfs:subClassOf ex:Policy .
}

# The tenant instance graph.
<bdt:tenant:campus> {
  ex:hq a brick:Building ; brick:timezone "Europe/Berlin" .
  ex:policy_office_hours a ex:OperatingPolicy ; ex:permittedHours "06:00-20:00" ; ex:minSetpoint 18.0 ; ex:maxSetpoint 24.0 .

  # Floor 1
  ex:floor1 a brick:Floor ; brick:isPartOf ex:hq .
  ex:ahu1 a brick:AHU ; brick:isPartOf ex:floor1 ; brick:feeds ex:vav11, ex:vav12, ex:vav13 .
  ex:zone11 a brick:HVAC_Zone ; brick:isPartOf ex:floor1 ; brick:hasPart ex:room111, ex:room112 .
  ex:room111 a brick:Room .
  ex:room112 a brick:Room .
  ex:vav11 a brick:VAV ; brick:feeds ex:zone11 ; brick:hasPoint ex:sp11, ex:occ11 .
  ex:occ11 a brick:Occupancy_Status .
  ex:sp11 a ex:VendorTempSP ;
      brick:hasUnit unit:DEG_C ;
      ex:priorityArray [ ex:activePriority 9 ; ex:relinquishDefault 21.0 ] ;
      brick:minPresentValue 16.0 ; brick:maxPresentValue 26.0 ;
      ref:hasExternalReference [ a ref:BACnetReference ; bacnet:object-identifier "analog-value,11" ] , [ a ref:TimeseriesReference ; ref:hasTimeseriesId "ts-sp11" ] .
  ex:sched11 a ex:WeeklySchedule ; ex:appliesTo ex:vav11 ;
      ex:weeklySchedule [ ex:monday "07:00-19:00" ; ex:saturday "08:00-13:00" ] ;
      ex:exceptionSchedule [ ex:date "2026-12-25" ] .
  ex:zone11 ex:operatingPolicy ex:policy_office_hours .
  ex:zone12 a brick:HVAC_Zone ; brick:isPartOf ex:floor1 ; brick:hasPart ex:room121, ex:room122 .
  ex:room121 a brick:Room .
  ex:room122 a brick:Room .
  ex:vav12 a brick:VAV ; brick:feeds ex:zone12 ; brick:hasPoint ex:sp12 .
  ex:sp12 a brick:Zone_Air_Temperature_Setpoint ;
      brick:hasUnit unit:DEG_C ;
      ex:priorityArray [ ex:activePriority 10 ; ex:relinquishDefault 21.0 ] ;
      ref:hasExternalReference [ a ref:BACnetReference ; bacnet:object-identifier "analog-value,12" ] , [ a ref:TimeseriesReference ; ref:hasTimeseriesId "ts-sp12" ] .
  ex:sched12 a ex:WeeklySchedule ; ex:appliesTo ex:vav12 ;
      ex:weeklySchedule [ ex:monday "07:00-19:00" ; ex:saturday "08:00-13:00" ] ;
      ex:exceptionSchedule [ ex:date "2026-12-25" ] .
  ex:zone12 ex:operatingPolicy ex:policy_office_hours .
  ex:zone13 a brick:HVAC_Zone ; brick:isPartOf ex:floor1 ; brick:hasPart ex:room131, ex:room132 .
  ex:room131 a brick:Room .
  ex:room132 a brick:Room .
  ex:vav13 a brick:VAV ; brick:feeds ex:zone13 ; brick:hasPoint ex:sp13 .
  ex:sp13 a brick:Zone_Air_Temperature_Setpoint ;
      brick:hasUnit unit:DEG_C ;
      ex:priorityArray [ ex:activePriority 11 ; ex:relinquishDefault 21.0 ] ;
      brick:minPresentValue 16.0 ; brick:maxPresentValue 26.0 ;
      ref:hasExternalReference [ a ref:TimeseriesReference ; ref:hasTimeseriesId "ts-sp13" ] .
  ex:sched13 a ex:WeeklySchedule ; ex:appliesTo ex:vav13 ;
      ex:weeklySchedule [ ex:monday "07:00-19:00" ; ex:saturday "08:00-13:00" ] ;
      ex:exceptionSchedule [ ex:date "2026-12-25" ] .
  ex:zone13 ex:operatingPolicy ex:policy_office_hours .

  # Floor 2
  ex:floor2 a brick:Floor ; brick:isPartOf ex:hq .
  ex:ahu2 a brick:AHU ; brick:isPartOf ex:floor2 ; brick:feeds ex:vav21, ex:vav22, ex:vav23 .
  ex:zone21 a brick:HVAC_Zone ; brick:isPartOf ex:floor2 ; brick:hasPart ex:room211, ex:room212 .
  ex:room211 a brick:Room .
  ex:room212 a brick:Room .
  ex:vav21 a brick:VAV ; brick:feeds ex:zone21 ; brick:hasPoint ex:sp21, ex:occ21 .
  ex:occ21 a brick:Occupancy_Status .
  ex:sp21 a ex:VendorTempSP ;
      brick:hasUnit unit:DEG_C ;
      ex:priorityArray [ ex:activePriority 9 ; ex:relinquishDefault 21.0 ] ;
      brick:minPresentValue 16.0 ; brick:maxPresentValue 26.0 ;
      ref:hasExternalReference [ a ref:BACnetReference ; bacnet:object-identifier "analog-value,21" ] , [ a ref:TimeseriesReference ; ref:hasTimeseriesId "ts-sp21" ] .
  ex:sched21 a ex:WeeklySchedule ; ex:appliesTo ex:vav21 ;
      ex:weeklySchedule [ ex:monday "07:00-19:00" ; ex:saturday "08:00-13:00" ] ;
      ex:exceptionSchedule [ ex:date "2026-12-25" ] .
  ex:zone22 a brick:HVAC_Zone ; brick:isPartOf ex:floor2 ; brick:hasPart ex:room221, ex:room222 .
  ex:room221 a brick:Room .
  ex:room222 a brick:Room .
  ex:vav22 a brick:VAV ; brick:feeds ex:zone22 ; brick:hasPoint ex:sp22 .
  ex:sp22 a brick:Zone_Air_Temperature_Setpoint ;
      brick:hasUnit unit:DEG_C ;
      ex:priorityArray [ ex:activePriority 10 ; ex:relinquishDefault 21.0 ] ;
      ref:hasExternalReference [ a ref:BACnetReference ; bacnet:object-identifier "analog-value,22" ] , [ a ref:TimeseriesReference ; ref:hasTimeseriesId "ts-sp22" ] .
  ex:sched22 a ex:WeeklySchedule ; ex:appliesTo ex:vav22 ;
      ex:weeklySchedule [ ex:monday "07:00-19:00" ; ex:saturday "08:00-13:00" ] ;
      ex:exceptionSchedule [ ex:date "2026-12-25" ] .
  ex:zone23 a brick:HVAC_Zone ; brick:isPartOf ex:floor2 ; brick:hasPart ex:room231, ex:room232 .
  ex:room231 a brick:Room .
  ex:room232 a brick:Room .
  ex:vav23 a brick:VAV ; brick:feeds ex:zone23 ; brick:hasPoint ex:sp23 .
  ex:sp23 a brick:Zone_Air_Temperature_Setpoint ;
      brick:hasUnit unit:DEG_C ;
      ex:priorityArray [ ex:activePriority 11 ; ex:relinquishDefault 21.0 ] ;
      brick:minPresentValue 16.0 ; brick:maxPresentValue 26.0 ;
      ref:hasExternalReference [ a ref:TimeseriesReference ; ref:hasTimeseriesId "ts-sp23" ] .
  ex:sched23 a ex:WeeklySchedule ; ex:appliesTo ex:vav23 ;
      ex:weeklySchedule [ ex:monday "07:00-19:00" ; ex:saturday "08:00-13:00" ] ;
      ex:exceptionSchedule [ ex:date "2026-12-25" ] .

  # Floor 3
  ex:floor3 a brick:Floor ; brick:isPartOf ex:hq .
  ex:ahu3 a brick:AHU ; brick:isPartOf ex:floor3 ; brick:feeds ex:vav31, ex:vav32, ex:vav33 .
  ex:zone31 a brick:HVAC_Zone ; brick:isPartOf ex:floor3 ; brick:hasPart ex:room311, ex:room312 .
