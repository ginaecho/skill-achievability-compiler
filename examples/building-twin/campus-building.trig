      ref:hasExternalReference [ a ref:BACnetReference ; bacnet:object-identifier "analog-value,32" ] , [ a ref:TimeseriesReference ; ref:hasTimeseriesId "ts-sp32" ] .
  ex:zone33 a brick:HVAC_Zone ; brick:isPartOf ex:floor3 ; brick:hasPart ex:room331, ex:room332 .
  ex:room331 a brick:Room .
  ex:room332 a brick:Room .
  ex:vav33 a brick:VAV ; brick:feeds ex:zone33 ; brick:hasPoint ex:sp33 .
  ex:sp33 a brick:Zone_Air_Temperature_Setpoint ;
      brick:hasUnit unit:DEG_C ;
      ex:priorityArray [ ex:activePriority 11 ; ex:relinquishDefault 21.0 ] ;
      brick:minPresentValue 16.0 ; brick:maxPresentValue 26.0 ;
      ref:hasExternalReference [ a ref:TimeseriesReference ; ref:hasTimeseriesId "ts-sp33" ] .

  # An orphan set point: no equipment, place, limits or references.
  ex:sp_orphan a brick:Room_Air_Temperature_Setpoint .
}
