          "pipeline_forecast_loaded"
        ]
      },
      "add": [
        "revenue_insight_ready"
      ]
    },
    "present_sales_insight": {
      "pre": {
        "and": [
          "revenue_insight_ready"
        ]
      },
      "add": [
        "sales_insight_presented"
      ]
    }
  },
  "states": {
    "deal_health_loaded": "Access the relevant deal-health data.",
    "pipeline_forecast_loaded": "Access pipeline status and revenue forecasts.",
