{
  "provenance": "Locally authored test assumptions, NOT a probe of the named organization.",
  "grants": [
    "prepare_managed_agent",
    "deploy_managed_agent",
    "monitor_agent_activity",
    "update_managed_agent"
  ],
  "contracts": {
    "prepare_managed_agent": {
      "pre": true,
      "add": [
        "agent_prepared"
      ]
    },
    "deploy_managed_agent": {
      "pre": {
        "and": [
          "agent_prepared"
        ]
      },
      "add": [
        "agent_deployed"
      ]
    },
    "monitor_agent_activity": {
      "pre": {
        "and": [
          "agent_deployed"
        ]
      },
      "add": [
        "activity_observed"
      ]
    },
    "update_managed_agent": {
      "pre": {
        "and": [
          "activity_observed"
        ]
      },
      "add": [
        "managed_update_applied"
      ]
    }
  },
  "states": {
    "agent_prepared": "Prepare an agent for managed enterprise deployment.",
    "agent_deployed": "Deploy the prepared agent under enterprise management.",
    "activity_observed": "Monitor the deployed agent's activity.",
    "managed_update_applied": "Apply a managed lifecycle update to the agent."
  },
  "init_true": []
}
