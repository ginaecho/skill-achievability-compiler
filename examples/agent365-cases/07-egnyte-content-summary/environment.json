{
  "provenance": "Locally authored test assumptions, NOT a probe of the named organization.",
  "grants": [
    "scan_egnyte_files",
    "summarize_enterprise_content",
    "share_content_summary"
  ],
  "contracts": {
    "scan_egnyte_files": {
      "pre": true,
      "add": [
        "files_scanned"
      ]
    },
    "summarize_enterprise_content": {
      "pre": {
        "and": [
          "files_scanned"
        ]
      },
      "add": [
        "content_summary_ready"
      ]
    },
    "share_content_summary": {
      "pre": {
        "and": [
          "content_summary_ready"
        ]
      },
      "add": [
        "content_summary_shared"
      ]
    }
  },
  "states": {
    "files_scanned": "Scan the relevant files in Egnyte storage.",
    "content_summary_ready": "Summarize the scanned enterprise content.",
    "content_summary_shared": "Share the summary in the intended Teams conversation."
  },
  "init_true": []
}
