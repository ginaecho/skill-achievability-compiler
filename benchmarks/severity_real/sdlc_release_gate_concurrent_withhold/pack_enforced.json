{
 "name": "sdlc_release_gate_concurrent_withhold_enforced",
 "roles": [
  "Author",
  "QualityReviewer",
  "SecurityReviewer",
  "ArchReviewer",
  "ResponsibleAIReviewer",
  "Merger",
  "DevOps"
 ],
 "capabilities": {
  "address_comments": {
   "owner": "Author",
   "add": [
    "findings_addressed"
   ]
  },
  "deploy": {
   "owner": "DevOps",
   "add": [
    "deployed"
   ],
   "pre": {
    "or": [
     {
      "not": "open_findings"
     },
     "findings_addressed"
    ]
   }
  },
  "withhold": {
   "owner": "DevOps",
   "add": [
    "withheld"
   ]
  }
 },
 "protocol": [
  {
   "rec": {
    "name": "ReviewLoop",
    "body": [
     {
      "msg": {
       "from": "Author",
       "to": "QualityReviewer",
       "label": "Submit"
      }
     },
     {
      "msg": {
       "from": "Author",
       "to": "SecurityReviewer",
       "label": "Submit"
      }
     },
     {
      "msg": {
       "from": "Author",
       "to": "ArchReviewer",
       "label": "Submit"
      }
     },
     {
      "msg": {
       "from": "Author",
       "to": "ResponsibleAIReviewer",
       "label": "Submit"
      }
     },
     {
      "msg": {
       "from": "QualityReviewer",
       "to": "Merger",
       "label": "QualityVerdict"
      }
     },
     {
      "msg": {
       "from": "SecurityReviewer",
       "to": "Merger",
       "label": "SecurityVerdict"
      }
     },
     {
      "msg": {
       "from": "ArchReviewer",
       "to": "Merger",
       "label": "ArchVerdict"
      }
     },
     {
      "msg": {
       "from": "ResponsibleAIReviewer",
       "to": "Merger",
       "label": "RaiVerdict"
      }
     },
     {
      "choice": {
       "by": "Merger",
       "to": "Author",
       "branches": {
        "revise": [
         {
          "msg": {
           "from": "Merger",
           "to": "Author",
           "label": "ReviseAuthor"
          }
         },
         {
          "act": {
           "cap": "address_comments",
           "by": "Author"
          }
         },
         {
          "msg": {
           "from": "Merger",
           "to": "QualityReviewer",
           "label": "AgainQuality"
          }
         },
         {
          "msg": {
           "from": "Merger",
           "to": "SecurityReviewer",
           "label": "AgainSecurity"
          }
         },
         {
          "msg": {
           "from": "Merger",
           "to": "ArchReviewer",
           "label": "AgainArch"
          }
         },
         {
          "msg": {
           "from": "Merger",
           "to": "ResponsibleAIReviewer",
           "label": "AgainRai"
          }
         },
         {
          "msg": {
           "from": "Merger",
           "to": "DevOps",
           "label": "AgainDevOps"
          }
         },
         {
          "continue": "ReviewLoop"
         }
        ],
        "reject": [
         {
          "msg": {
           "from": "Merger",
           "to": "Author",
           "label": "RejectedAuthor"
          }
         },
         {
          "msg": {
           "from": "Merger",
           "to": "QualityReviewer",
           "label": "CancelQuality"
          }
         },
         {
          "msg": {
           "from": "Merger",
           "to": "SecurityReviewer",
           "label": "CancelSecurity"
          }
         },
         {
          "msg": {
           "from": "Merger",
           "to": "ArchReviewer",
           "label": "CancelArch"
          }
         },
         {
          "msg": {
           "from": "Merger",
           "to": "ResponsibleAIReviewer",
           "label": "CancelRai"
          }
         },
         {
          "msg": {
           "from": "Merger",
           "to": "DevOps",
           "label": "NoDeploy"
          }
         },
         {
          "act": {
           "cap": "withhold",
           "by": "DevOps"
          }
         },
         {
          "msg": {
           "from": "DevOps",
           "to": "Merger",
           "label": "Withheld"
          }
         }
        ],
        "approve": [
         {
          "msg": {
           "from": "Merger",
           "to": "Author",
           "label": "ApprovedAuthor"
          }
         },
         {
          "msg": {
           "from": "Merger",
           "to": "QualityReviewer",
           "label": "StopQuality"
          }
         },
         {
          "msg": {
           "from": "Merger",
           "to": "SecurityReviewer",
           "label": "StopSecurity"
          }
         },
         {
          "msg": {
           "from": "Merger",
           "to": "ArchReviewer",
           "label": "StopArch"
          }
         },
         {
          "msg": {
           "from": "Merger",
           "to": "ResponsibleAIReviewer",
           "label": "StopRai"
          }
         },
         {
          "msg": {
           "from": "Merger",
           "to": "DevOps",
           "label": "Deploy"
          }
         },
         {
          "act": {
           "cap": "deploy",
           "by": "DevOps"
          }
         },
         {
          "msg": {
           "from": "DevOps",
           "to": "Merger",
           "label": "Deployed"
          }
         }
        ]
       },
       "guards": {
        "revise": {
         "and": [
          "open_findings",
          {
           "not": "findings_addressed"
          }
         ]
        },
        "approve": {
         "or": [
          {
           "not": "open_findings"
          },
          "findings_addressed"
         ]
        },
        "reject": "unfixable_findings"
       }
      }
     }
    ]
   }
  }
 ],
 "goal": {
  "and": [
   "deployed",
   {
    "or": [
     {
      "not": "open_findings"
     },
     "findings_addressed"
    ]
   }
  ]
 },
 "init_true": [
  "open_findings"
 ],
 "irreversible": [
  "deploy"
 ]
}
