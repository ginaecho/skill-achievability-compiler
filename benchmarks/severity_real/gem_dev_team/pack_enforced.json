{
 "name": "gem_dev_team_enforced",
 "roles": [
  "Orchestrator",
  "Planner",
  "Implementer",
  "Reviewer",
  "Critic",
  "BrowserTester",
  "DevOps"
 ],
 "capabilities": {
  "make_plan": {
   "owner": "Planner",
   "add": [
    "planned"
   ]
  },
  "review_plan": {
   "owner": "Reviewer",
   "add": [
    "plan_approved"
   ]
  },
  "critique": {
   "owner": "Critic",
   "add": [
    "critiqued"
   ]
  },
  "implement": {
   "owner": "Implementer",
   "add": [
    "built"
   ]
  },
  "run_tests": {
   "owner": "BrowserTester",
   "add": [
    "tests_run"
   ]
  },
  "replan": {
   "owner": "Planner",
   "add": [
    "replanned"
   ]
  },
  "deploy": {
   "owner": "DevOps",
   "add": [
    "deployed"
   ],
   "pre": {
    "and": [
     "plan_approved",
     {
      "or": [
       {
        "not": "tests_red"
       },
       "replanned"
      ]
     },
     {
      "or": [
       {
        "not": "high_risk"
       },
       "critiqued"
      ]
     }
    ]
   }
  }
 },
 "protocol": [
  {
   "msg": {
    "from": "Orchestrator",
    "to": "Planner",
    "label": "RequestPlan"
   }
  },
  {
   "act": {
    "cap": "make_plan",
    "by": "Planner"
   }
  },
  {
   "msg": {
    "from": "Planner",
    "to": "Orchestrator",
    "label": "PlanReady"
   }
  },
  {
   "choice": {
    "by": "Orchestrator",
    "to": "Reviewer",
    "branches": {
     "skip_critic": [
      {
       "msg": {
        "from": "Orchestrator",
        "to": "Reviewer",
        "label": "ReviewPlan"
       }
      },
      {
       "act": {
        "cap": "review_plan",
        "by": "Reviewer"
       }
      },
      {
       "msg": {
        "from": "Reviewer",
        "to": "Orchestrator",
        "label": "PlanApproved"
       }
      },
      {
       "msg": {
        "from": "Orchestrator",
        "to": "Critic",
        "label": "SkipCritique"
       }
      }
     ],
     "with_critic": [
      {
       "msg": {
        "from": "Orchestrator",
        "to": "Reviewer",
        "label": "ReviewPlan"
       }
      },
      {
       "act": {
        "cap": "review_plan",
        "by": "Reviewer"
       }
      },
      {
       "msg": {
        "from": "Reviewer",
        "to": "Orchestrator",
        "label": "PlanApproved"
       }
      },
      {
       "msg": {
        "from": "Orchestrator",
        "to": "Critic",
        "label": "Critique"
       }
      },
      {
       "act": {
        "cap": "critique",
        "by": "Critic"
       }
      },
      {
       "msg": {
        "from": "Critic",
        "to": "Orchestrator",
        "label": "CritiqueDone"
       }
      }
     ]
    },
    "guards": {
     "skip_critic": {
      "not": "high_risk"
     },
     "with_critic": "high_risk"
    }
   }
  },
  {
   "rec": {
    "name": "ImplementLoop",
    "body": [
     {
      "msg": {
       "from": "Orchestrator",
       "to": "Implementer",
       "label": "Implement"
      }
     },
     {
      "act": {
       "cap": "implement",
       "by": "Implementer"
      }
     },
     {
      "msg": {
       "from": "Implementer",
       "to": "Orchestrator",
       "label": "Built"
      }
     },
     {
      "msg": {
       "from": "Orchestrator",
       "to": "BrowserTester",
       "label": "RunTests"
      }
     },
     {
      "act": {
       "cap": "run_tests",
       "by": "BrowserTester"
      }
     },
     {
      "msg": {
       "from": "BrowserTester",
       "to": "Orchestrator",
       "label": "TestResult"
      }
     },
     {
      "choice": {
       "by": "Orchestrator",
       "to": "Planner",
       "branches": {
        "tests_failed": [
         {
          "msg": {
           "from": "Orchestrator",
           "to": "Planner",
           "label": "Replan"
          }
         },
         {
          "act": {
           "cap": "replan",
           "by": "Planner"
          }
         },
         {
          "msg": {
           "from": "Planner",
           "to": "Orchestrator",
           "label": "Replanned"
          }
         },
         {
          "msg": {
           "from": "Orchestrator",
           "to": "Implementer",
           "label": "LoopImpl"
          }
         },
         {
          "msg": {
           "from": "Orchestrator",
           "to": "BrowserTester",
           "label": "LoopTest"
          }
         },
         {
          "msg": {
           "from": "Orchestrator",
           "to": "DevOps",
           "label": "LoopDeploy"
          }
         },
         {
          "continue": "ImplementLoop"
         }
        ],
        "tests_passed": [
         {
          "msg": {
           "from": "Orchestrator",
           "to": "Planner",
           "label": "DonePlan"
          }
         },
         {
          "msg": {
           "from": "Orchestrator",
           "to": "Implementer",
           "label": "DoneImpl"
          }
         },
         {
          "msg": {
           "from": "Orchestrator",
           "to": "BrowserTester",
           "label": "DoneTest"
          }
         },
         {
          "msg": {
           "from": "Orchestrator",
           "to": "DevOps",
           "label": "Deploy"
          }
         },
         {
          "act": {
           "cap": "deploy",
           "by": "DevOps"
          }
         },
         {
          "msg": {
           "from": "DevOps",
           "to": "Orchestrator",
           "label": "Deployed"
          }
         }
        ]
       },
       "guards": {
        "tests_failed": {
         "and": [
          "tests_red",
          {
           "not": "replanned"
          }
         ]
        },
        "tests_passed": {
         "or": [
          {
           "not": "tests_red"
          },
          "replanned"
         ]
        }
       }
      }
     }
    ]
   }
  }
 ],
 "goal": {
  "and": [
   "deployed",
   "plan_approved",
   {
    "or": [
     {
      "not": "high_risk"
     },
     "critiqued"
    ]
   }
  ]
 },
 "init_true": [
  "high_risk",
  "tests_red"
 ],
 "irreversible": [
  "deploy"
 ]
}
