{
 "schema": "skillc.intent/1",
 "name": "building-topology",
 "description": "Model a building's topology (building, floors, rooms) as a queryable Azure Digital Twins graph, built from floor plans in blob storage.",
 "catalog": "azure",
 "target": {"scope": "/subscriptions/{subscription}/resourceGroups/rg-building", "location": "westeurope"},
 "params": {"name": "bldg-twins"},
 "data": [
  {"id": "building_plans",
   "store": "/subscriptions/{subscription}/resourceGroups/rg-data/providers/Microsoft.Storage/storageAccounts/bldgplans",
   "path": "floorplans", "format": "IFC / CSV room lists"}
 ],
 "goal": ["dt_instance", "building_data", "dt_models", "topology_twins", "topology_relationships", "topology_queryable"]
}
