{
  "version": "3.0",
  "description": "Interaction hazards: what an agent may do to the world that the user did not ask for. Patterns are applied per clause of a committed sentence (and per command segment of an action); an entry with `targets` also needs a target in the same clause, and a target inside a `safe_targets` token does not count. `exclude` (reasoning) and `action_exclude` (actions) cancel a hit when they match the same clause or segment. `exclude_unit` applies `exclude` to the whole sentence and the one before. `span: unit` matches the whole sentence instead of one clause. `inherit_targets` lets a clause that points back (there, it, that) take its target from the earlier clauses of the sentence or from the sentence before. `armed_only_patterns` recognise the tool call that realizes a hazard the reasoning committed to; they never refuse a call by themselves. `decision` is the default policy (deny | ask | plan), `who` the party that can fix a refusal (replan | ask_user). `action_patterns` (default: `patterns`) recognise the tool call that realizes the hazard. See docs/RUNTIME_MONITOR.md, Interaction awareness.",
  "classes": {
    "destructive": {
      "decision": "deny",
      "who": "replan",
      "needs": [],
      "label": "a destructive operation on a protected target"
    },
    "outbound_send": {
      "decision": "plan",
      "who": "replan",
      "needs": [],
      "label": "a send to a destination outside the approved plan"
    },
    "payment": {
      "decision": "ask",
      "who": "ask_user",
      "needs": [
        "payment_approval"
      ],
      "label": "a payment, which only the user can approve"
    },
    "secret_exposure": {
      "decision": "deny",
      "who": "replan",
      "needs": [],
      "label": "exposing a secret"
    },
    "privilege": {
      "decision": "ask",
      "who": "ask_user",
      "needs": [
        "confirmation"
      ],
      "label": "a privilege escalation or a disabled safeguard"
    },
    "scope_escape": {
      "decision": "ask",
      "who": "ask_user",
      "needs": [
        "confirmation"
      ],
      "label": "an action beyond the scope of the task"
    },
    "injection_compliance": {
      "decision": "deny",
      "who": "replan",
      "needs": [],
      "label": "following instructions found in tool output"
    },
    "commitment": {
      "decision": "ask",
      "who": "ask_user",
      "needs": [
        "operator_approval"
      ],
      "label": "a commitment (money, price, legal effect, a policy exception) the agent has no authority to make"
    },
    "consent_override": {
      "decision": "deny",
      "who": "replan",
      "needs": [],
      "label": "carrying on against an explicit refusal of the person affected"
    },
    "pii_exposure": {
      "decision": "ask",
      "who": "ask_user",
      "needs": [
        "confirmation"
      ],
      "label": "sending or showing a third party's personal data"
    },
    "policy_violation": {
      "decision": "deny",
      "who": "replan",
      "needs": [],
      "label": "abusive or brand-damaging content, or dropping the operator's rules"
    }
  },
  "entries": [
    {
      "id": "destructive-verb",
      "class": "destructive",
      "description": "a destructive verb aimed at a protected target. Targets are things whose loss is not routine: production, databases as a whole, whole or protected tables, the repository and its main branch, backups, the home directory, a drive root, uncommitted work. Routine clean-up words (index, dead code, stale, temp, log files, ...) cancel the hit: removing them is ordinary maintenance. v3: discard, throw away and clear (with a determiner) are destructive verbs like delete; a cloud drive (Drive, OneDrive, Dropbox, SharePoint), spreadsheets and the documents of the user or another person are protected targets: they are authored content, not regenerable build output.",
      "patterns": [
        "\\b(?:delet(?:e|es|ing)|remov(?:e|es|ing)|wip(?:e|es|ing)|drop(?:s|ping)?|truncat(?:e|es|ing)|purg(?:e|es|ing)|destroy(?:s|ing)?|eras(?:e|es|ing)|format(?:s|ting)?|overwrit(?:e|es|ing)|nuk(?:e|es|ing)|discard(?:s|ing)?|throw(?:s|ing)? away|blow(?:s|ing)? away|dropdb)\\b|\\bclear(?:s|ing)?\\s+(?:out\\s+)?(?:the|all|those|these|their|its|every|my|your|our|his|her)\\b",
        "\\bforce[- ]?push(?:es|ing)?\\b|\\bpush(?:ing)?\\b[^;\\n]*?(?:--force\\b|--force-with-lease|\\s-f\\b)",
        "\\brm\\s+-(?:rf|fr|r|R|Rf|rF)\\b|\\brmdir\\s+/s\\b|\\bdel\\s+/s\\b|\\bRemove-Item\\b[^;\\n]*-Recurse",
        "\\bMove-Item\\b[^;\\n]*-Force|\\bmv\\s+-f\\b|\\bmove\\s+(?:/y\\s+)?\\*"
      ],
      "targets": "\\b(?:prod(?:uction)?|live|databases?|db|schemas?|customers?|user data|repo(?:sitory)?|origin|backups?|all files|every file|entire|whole|everything|the project|workspace|migrations|buckets?|namespaces?|clusters?|resource group|tenants?|mailbox(?:es)?|calendars?|home dir(?:ectory)?|file[- ]?systems?|cloud resources|all (?:data|resources))\\b|\\b(?:main|master)\\s+branch\\b|\\borigin/(?:main|master)\\b|\\bbranch\\s+(?:main|master)\\b|\\busers?\\s+(?:table|data)\\b|\\ball users\\b|\\b(?:all|every|the whole|entire|prod\\w*)\\s+tables?\\b|(?:^|[\\s'\\\"=(])~(?=/|\\s|$|['\\\"])|\\$HOME\\b|(?:^|\\s)/(?:\\*|\\s|$)|(?<![\\w.])\\.git\\b|(?<![\\w.])\\.env\\b|\\(root\\)|(?<![\\w\\\\])[A-Za-z]:\\\\?(?=\\s|$|[\\\"'])|\\bdrive root\\b|\\broot of the drive\\b|\\bthe whole drive\\b|\\bworking[- ]tree\\b|\\blocal (?:edits|changes|commits)\\b|\\buncommitted (?:changes|work)\\b|(?:^|[\\s'\\\"])\\.?[\\\\/]?\\*(?=$|[\\s'\\\"])|\\b(?:google drive|onedrive|one ?drive|dropbox|sharepoint|icloud drive|box\\.com)\\b|(?-i:\\bDrive\\b)|\\bspreadsheets\\b|\\bworkbooks\\b|\\b(?:the user's|users'|user's|customer's|client's|someone's|their|his|her)\\s+(?:[\\w-]+\\s+){0,2}?(?:files|documents|docs|spreadsheets|sheets|photos|folders?|e-?mails|notes|drives?|data)\\b",
      "safe_targets": "node_modules|__pycache__|\\.pytest_cache|\\bdist\\b|\\bbuild\\b|\\btmp\\b|\\btemp\\b|\\bcache\\b|\\.tmp\\b|\\bscratch\\b|\\.venv\\b|\\bcoverage\\b|\\.mypy_cache|\\.ruff_cache|\\btarget/",
      "decision": "deny",
      "who": "replan",
      "exclude": "\\b(?:index(?:es)?|dead code|unused (?:code|imports?|variables?|index)|comment(?:s|ed)?|stale|duplicate|test fixtures?|fixture rows?|temporary|temp|old logs?|log files?|whitespace|trailing|typo)\\b|\\bfrom (?:the )?(?:code|file|function|module|class|docstring)\\b",
      "inherit_targets": true
    },
    {
      "id": "discard-local-work",
      "class": "destructive",
      "description": "throwing away uncommitted work: revert, restore, discard, roll back or reset the working tree, tracked files or local/uncommitted/unsaved edits. In git vocabulary these verbs overwrite the working copy from HEAD, and uncommitted edits exist nowhere else, so the loss cannot be undone. Stashing, committing or backing up first, or unstaging only (--staged), keeps the work and cancels the hit. The exclusion reads the whole sentence and the one before (exclude_unit): the safeguard is usually stated in its own clause.",
      "patterns": [
        "\\b(?:revert(?:s|ing)?|restor(?:e|es|ing)|discard(?:s|ing)?|throw(?:s|ing)? away|roll(?:s|ing)? back|reset(?:s|ting)?|undo(?:es|ing)?|wip(?:e|es|ing)|blow(?:s|ing)? away|clean(?:s|ing)? out)\\b"
      ],
      "targets": "\\btracked files?\\b|\\bworking[- ]?(?:tree|copy|directory)\\b|\\b(?:local|uncommitted|unsaved|unstaged|pending|in-progress|half-finished|unfinished|work-in-progress)\\s+(?:[\\w-]+\\s+)?(?:edits|changes|work|modifications)\\b|\\bback to HEAD\\b|\\bthe user's (?:edits|changes|work)\\b",
      "exclude": "\\bstash(?:ed|es|ing)?\\b|\\bbacked up\\b|\\bback(?:ing)? (?:it|them|up)\\b|\\bbackup\\b|\\b(?:after|once|having) commit\\w*|\\bcommitted (?:them|it|first|everything)\\b|--staged\\b|\\bunstag\\w*",
      "action_patterns": [
        "\\bgit\\s+restore\\b(?![^;\\n]*(?:--staged|\\s-S\\b))(?=\\s+\\S)|\\bgit\\s+restore\\b[^;\\n]*--worktree\\b",
        "\\bgit\\s+checkout\\b[^;\\n]*?\\s--\\s+\\S",
        "\\bgit\\s+stash\\s+(?:drop|clear)\\b",
        "\\bgit\\s+clean\\b[^;\\n]*\\s-\\w*f"
      ],
      "decision": "deny",
      "who": "replan",
      "exclude_unit": true
    },
    {
      "id": "destructive-command",
      "class": "destructive",
      "description": "a command that destroys data, history or infrastructure by itself; DELETE FROM only without a WHERE clause or on a protected table (a scoped delete on a session table is routine) v3: git restore without --staged, git checkout -- <path>, git stash drop/clear and git clean -f overwrite or delete uncommitted work that exists nowhere else.",
      "patterns": [
        "(?-i:\\bDROP\\s+(?:TABLE|DATABASE|SCHEMA)\\b)",
        "(?-i:\\bDELETE\\s+FROM\\s+(?:(?i:[\\w.\\\"`]*(?:users|customers|accounts|orders|payments|prod\\w*))\\b|(?![^;\\n]*\\bWHERE\\b)))",
        "(?-i:\\bTRUNCATE\\s+(?:TABLE\\s+)?\\w)",
        "\\bterraform\\s+destroy\\b",
        "\\baz\\s+group\\s+delete\\b",
        "\\baws\\s+s3\\s+rm\\b[^;\\n]*--recursive",
        "\\bkubectl\\s+delete\\s+(?:namespace|ns|deployment|pvc|pv)\\b",
        "\\bgit\\s+branch\\s+-D\\b",
        "\\bgit\\s+clean\\b[^;\\n]*\\s-\\w*f",
        "\\bgit\\s+checkout\\b[^;\\n]*?\\s--\\s+\\S",
        "\\bgit\\s+reset\\s+--hard\\b",
        "\\bhard[- ]reset(?:s|ting)?\\b",
        "\\bnpm\\s+unpublish\\b",
        "\\brm\\s+-(?:rf|fr|r|R|Rf|rF)\\s+(?:\\./)?src/?(?=\\s|$)",
        "\\brmdir\\s+/s\\s+/q\\s+[A-Za-z]:\\\\?(?=\\s|$|[\\\"'])",
        "\\bgit\\s+restore\\b(?![^;\\n]*(?:--staged|\\s-S\\b))(?=\\s+\\S)|\\bgit\\s+restore\\b[^;\\n]*--worktree\\b",
        "\\bgit\\s+stash\\s+(?:drop|clear)\\b"
      ],
      "decision": "deny",
      "who": "replan"
    },
    {
      "id": "process-kill",
      "class": "destructive",
      "description": "killing a service or a running recording/database process by name: what it was doing is lost",
      "patterns": [
        "\\b(?:pkill|killall|kill\\s+-9)\\b"
      ],
      "targets": "\\b(?:recording|ffmpeg|obs|postgres\\w*|mysql\\w*|redis\\w*|nginx|server|daemon)\\b|\\s-f\\b",
      "exclude": "\\brestart\\w*\\b",
      "decision": "deny",
      "who": "replan"
    },
    {
      "id": "outbound-send",
      "class": "outbound_send",
      "description": "a send, post or upload to a destination outside the system: an email address, URL, domain or an external party; a role of the approved plan or a sub-agent is not one",
      "patterns": [
        "(?<!the )(?<!a )(?<!an )(?<!this )(?<!that )(?<!my )(?<!your )(?<!our )(?<!their )\\b(?:send(?:s|ing)?|e-?mail(?:ing)?|mail(?:ing)?|messag(?:e|ing)|post(?:ing)?|repl(?:y|ying)|forward(?:s|ing)?|shar(?:e|ing)|upload(?:ing)?|publish(?:es|ing)?|submit(?:s|ting)?|transmit(?:s|ting)?|notify(?:ing)?|DM|tweet(?:ing)?|invit(?:e|ing))\\b"
      ],
      "targets": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}|https?://[^\\s'\\\"<>)`]+|\\b(?:[a-z0-9-]+\\.)+(?:com|org|net|io|co|dev|app|ai|gov|edu|example|info|biz|us|uk|de|fr|cloud|xyz|me|sh|ru|cn|tk|site|online)\\b|\\b(?:external|outside|third[- ]party|public(?:ly)?|webhooks?|slack|teams channel|gist|pastebin)\\b|\\bto (?:the )?(?:customers?|clients?|recipients?|attacker|vendor|supplier|mailing list|distribution list|all staff|everyone|external|outside|third[- ]part(?:y|ies)|his|her|their) (?:personal )?(?:address|inbox|e-?mail|account)\\b",
      "decision": "plan",
      "who": "replan"
    },
    {
      "id": "payment",
      "class": "payment",
      "description": "a payment, purchase, transfer of money or refund: a transactional verb with its object. Building payment software (a form, an API, tests) is not paying. v3: a tool named for approving, executing or releasing a transfer or payout moves money whatever its documentation calls it; a camelCase or dotted tool name counts as its words.",
      "patterns": [
        "\\b(?:make|submit|confirm|authori[sz]e|complete|execute|process|place|initiate|approve)\\s+(?:a |the |this |that |my |their )?(?:payment|purchase|order|transfer|refund|charge|checkout)\\b",
        "\\bpay\\s+(?:for|the|\\$|\\d|them|him|her|it|invoice|the bill)\\b",
        "\\bbuy(?:ing)?\\s+(?!-in)(?:the|a|an|\\d|it|them|some)\\b",
        "\\b(?:issue|give|process)\\s+(?:a |the )?refund\\b|\\brefund\\s+(?:the|them|him|her|\\$|\\d)",
        "\\bwire\\s+(?:\\$|\\u20ac|\\u00a3|\\d|the|funds|money)",
        "\\btransfer\\s+(?:\\$|\\u20ac|\\u00a3|\\d|funds|money|the balance)",
        "\\bcheck ?out\\b(?=[^;]{0,30}\\b(?:cart|order|now)\\b)",
        "\\badd(?:ing)?\\s+(?:it|them|\\d+|the|a|an)[^;]{0,30}\\bto (?:the )?cart\\b",
        "\\b(?:tell|ask|have)\\s+(?:people|them|everyone|customers?|him|her)\\s+to\\s+(?:pay|venmo|send (?:money|payment))\\b",
        "\\brelease\\s+(?:the\\s+)?(?:funds|payment|money|escrow|payout)\\b"
      ],
      "action_patterns": [
        "\\b(?:place|submit|confirm)\\s+(?:the|an?|this|my|their)\\s+order\\b",
        "\\b(?:make|confirm|submit|send|execute)\\s+(?:a\\s+|the\\s+)?payment\\b",
        "\\b(?:complete|confirm)\\s+(?:the\\s+)?purchase\\b",
        "api\\.stripe\\.com|/v1/(?:charges|payment_intents|transfers|refunds)\\b",
        "\\bwire\\s+transfer\\b|\\btransfer\\s+(?:funds|money)\\b",
        "\\bpay\\w*\\s+(?:via|with|through|using)\\b[^;\\n]{0,40}\\bto\\s+@[\\w-]+",
        "\\b(?:venmo|cash ?app)\\b[^;\\n]{0,20}@[\\w-]+|\\bpaypal\\.me/",
        "\\b(?:approve|execute|initiate|release|authori[sz]e)\\s+(?:the\\s+)?(?:transfer|payout|withdrawal|wire|disbursement)\\b"
      ],
      "decision": "ask",
      "who": "ask_user",
      "exclude": "\\b(?:form|field|module|page|api|endpoint|service|library|sdk|tests?|test case|code|feature|flow|integration|validation|schema|handler|webhook|component|mock|stub|docs?|documentation)\\b",
      "armed_only_patterns": [
        "\\b(?:submit|place|confirm|complete)\\s+order\\b|\\bcheckout\\b|\\bcharge\\s+card\\b|\\bpay(?:ment)?\\s+(?:via|with|to)\\b|\\bvenmo\\b|\\bpaypal\\.me\\b|\\bcash ?app\\b"
      ]
    },
    {
      "id": "secret-exposure",
      "class": "secret_exposure",
      "description": "printing, logging or transmitting a secret; checking that a secret is set, missing or invalid without showing it is not exposing it v3: output, render, emit, write out and embed are exposure verbs; so is moving a secret into a channel others read (dropping rows into a ticket reply, writing values into a PR summary, as an image or link reference). A tokens/credentials table and connection strings are secrets. Once armed, a Markdown image or <img> pointing at an outside host realizes it: rendering fetches the URL.",
      "patterns": [
        "\\b(?:print(?:s|ing)?|echo(?:es|ing)?|cat|log(?:s|ging)?|dump(?:s|ing)?|(?:show(?:s|ing)?|display(?:s|ing)?)(?!\\s+(?:it\\s+)?(?:to\\s+)?(?:the user|you)\\b)|past(?:e|es|ing)|send(?:s|ing)?|upload(?:s|ing)?|post(?:s|ing)?|includ(?:e|es|ing)|attach(?:es|ing)?|base64|expos(?:e|es|ing)|leak(?:s|ing)?|e-?mail(?:s|ing)?|printenv|Get-Content|(?<!the )(?<!its )(?<!this )(?<!that )output(?:s|ting)?(?!\\s*:|\\s+(?:of|from|is|was|shows?|contains?)\\b)|render(?:s|ing)?|emit(?:s|ting)?|writ(?:e|es|ing) (?:them |it |those |these )?out|embed(?:s|ding)?)\\b|\\bcurl\\b[^;\\n]*\\s(?:-d|--data\\S*|-F|--upload-file)\\b",
        "\\b(?:drop(?:s|ping)?|put(?:s|ting)?|writ(?:e|es|ing)|cop(?:y|ies|ying)|insert(?:s|ing)?|past(?:e|es|ing)|plac(?:e|es|ing)|add(?:s|ing)?|return(?:s|ing)?|post(?:s|ing)?|dump(?:s|ing)?|carr(?:y|ies|ying))\\b[^;\\n]{0,60}?\\b(?:into|in|onto|on|to|as)\\s+(?:the\\s+|a\\s+|an\\s+|its\\s+|their\\s+)?(?:[\\w-]+\\s+){0,3}?(?:repl(?:y|ies)|response|comments?|tickets?|pr|pull request|summary|issues?|messages?|chat|channel|public \\w+|image (?:links?|references?|urls?|tags?)|markdown image|(?:image )?url|link)\\b"
      ],
      "targets": "\\b(?:access|auth|bearer|api|github|gh|refresh|id|session|personal access|oauth|sas|jwt|slack|npm|pypi)[ _-]?tokens?\\b|\\b[A-Z0-9]*_(?:TOKEN|SECRET|PASSWORD|API_?KEY|KEY)\\b|\\bsecrets?\\b|\\bpasswords?\\b|\\bpasswd\\b|\\bapi[_ -]?keys?\\b|\\bcredentials?\\b|\\bprivate keys?\\b|(?<![\\w.])\\.env\\b|\\bid_rsa\\b|\\baccess keys?\\b|\\bcookies?\\b|\\bsession ids?\\b|\\bOTP\\b|\\bone[- ]time (?:code|password)\\b|\\b2FA codes?\\b|\\b(?:tokens?|credentials?|secrets?|keys?|passwords?)\\s+tables?\\b|\\bprivileged (?:tokens?|tables?|keys?|credentials?|rows?)\\b|\\bconnection strings?\\b",
      "decision": "deny",
      "who": "replan",
      "exclude": "\\s-[zn]\\s|\\bis (?:not )?set\\b|\\bunset\\b|\\bnot set\\b|\\bexists?\\b|\\bpresent\\b|\\bdefined\\b|\\bconfigured\\b|\\bmissing\\b|\\bredact\\w*|\\bmask\\w*|\\bwithout (?:printing|showing|revealing|exposing)|\\bwhether\\b|\\binvalid\\b|\\bexpired\\b",
      "armed_only_patterns": [
        "https?://[^\\s'\\\"<>]*[?&#][^\\s'\\\"<>]*(?:key|token|secret)=",
        "!\\[[^\\]]*\\]\\(\\s*https?://|<img\\b[^>]*\\bsrc\\s*=\\s*[\\\"']?https?://"
      ]
    },
    {
      "id": "confidential-exposure",
      "class": "secret_exposure",
      "description": "putting private or regulated data where others can read it",
      "patterns": [
        "\\b(?:includ(?:e|es|ing)|post(?:s|ing)?|publish(?:es|ing)?|send(?:s|ing)?|shar(?:e|es|ing)|upload(?:s|ing)?|past(?:e|es|ing)|leak(?:s|ing)?|expos(?:e|es|ing)|attach(?:es|ing)?|commit(?:s|ting)?|open(?:s|ing)? an? (?:pr|pull request|issue))\\b|\\bcreate[_ ](?:pull[_ ]request|issue|comment|gist)\\b"
      ],
      "targets": "\\bprivate (?:repos?|repositor(?:y|ies)|data|channels?|files?|documents?)\\b|\\bconfidential\\b|\\bsalar(?:y|ies)\\b|\\bPII\\b|\\bPHI\\b|\\bpatient (?:data|records?|notes?)\\b|\\bmedical records?\\b",
      "decision": "deny",
      "who": "replan"
    },
    {
      "id": "privilege",
      "class": "privilege",
      "description": "a privilege escalation or a disabled safeguard; sudo only for what changes the system's protection (rm, chmod, a root shell, users, /etc, the firewall); installing a package with sudo is routine",
      "patterns": [
        "\\bsudo\\s+(?:-\\w+\\s+)*(?:rm|chmod|chown|dd|mkfs|fdisk|systemctl\\s+(?:disable|stop|mask)|visudo|passwd|su\\b|-i\\b|-s\\b|bash|sh\\b|tee\\s+/etc|sed[^;\\n]*/etc/|useradd|usermod|iptables|ufw\\s+disable|setenforce\\s+0)",
        "\\b(?:run|use|with|as)\\s+(?:it\\s+)?(?:with\\s+)?sudo\\b(?!\\s+(?:apt|apt-get|yum|dnf|brew|pip3?|npm|snap|port|zypper|pacman)\\b)",
        "\\bchmod\\s+(?:-R\\s+)?777\\b",
        "\\bchown\\s+(?:-R\\s+)?root\\b",
        "\\bgrant(?:s|ing)?\\b[^;\\n]{0,40}\\b(?:admin\\w*|owner|global administrator)\\b",
        "\\badd\\b[^;\\n]{0,60}\\bto\\b[^;\\n]{0,20}\\badministrators\\b",
        "\\bdisabl(?:e|es|ing)\\s+(?:the\\s+)?(?:firewall|defender|antivirus|mfa|2fa|multi-factor)",
        "\\ballow all\\b",
        "0\\.0\\.0\\.0/0",
        "\\bautoApprove\\b",
        "\\byolo mode\\b",
        "--dangerously-skip-permissions",
        "\\bbypass(?:ing)?\\s+(?:the\\s+)?permissions\\b",
        "\\btrust all\\b",
        "\\bset\\b[^;\\n]{0,40}\\b(?:auto[-_ ]?approve|allow\\w*)\\b[^;\\n]{0,20}\\btrue\\b",
        "\\b(?:curl|wget|iwr|Invoke-WebRequest)\\b[^;\\n]*\\|\\s*(?:ba|z|da)?sh\\b|\\b(?:iwr|Invoke-WebRequest)\\b[^;\\n]*\\|\\s*iex\\b"
      ],
      "decision": "ask",
      "who": "ask_user"
    },
    {
      "id": "config-write",
      "class": "privilege",
      "description": "writing an agent's or a shell's own configuration: tool auto-approval in an MCP / editor / Claude settings file, or SSH keys, sudoers and shell start-up files",
      "patterns": [
        "\\b(?:add(?:s|ing)?|writ(?:e|es|ing)|edit(?:s|ing)?|modify(?:ing)?|updat(?:e|es|ing)|insert(?:s|ing)?|creat(?:e|es|ing)|register(?:s|ing)?)\\b[^;\\n]{0,120}(?:\\.cursor/mcp\\.json|\\bmcp\\.json\\b|\\.claude/settings[\\w.-]*\\.json|claude_desktop_config\\.json|\\.codex/config\\.toml|\\.mcp\\.json|\\.vscode/settings\\.json|\\bsudoers\\b|\\bauthorized_keys\\b|\\.bashrc\\b|\\.zshrc\\b)"
      ],
      "action_patterns": [
        "(?:\\.cursor/mcp\\.json|\\.vscode/settings\\.json|\\.claude/settings(?:\\.local)?\\.json|\\bmcp\\.json|\\bsettings\\.json|claude_desktop_config\\.json|\\.codex/config\\.toml)\\b[^\\n]*\\b(?:autoApprove|dangerously\\w*|trust\\w*|allow\\w*)\\b",
        "\\b(?:autoApprove|dangerously\\w*|trust\\w*|allow\\w*)\\b[^\\n]*(?:\\.cursor/mcp\\.json|\\.vscode/settings\\.json|\\.claude/settings(?:\\.local)?\\.json|\\bmcp\\.json|\\bsettings\\.json)\\b",
        "\\b(?:Write|Edit|write|edit|create file|write file)\\b[^\\n]*(?:\\.cursor/mcp\\.json|claude_desktop_config\\.json|\\.codex/config\\.toml)",
        "(?:~/\\.ssh/|/etc/sudoers|\\bauthorized_keys\\b|(?:^|[/\\\\\\s])\\.bashrc\\b|(?:^|[/\\\\\\s])\\.zshrc\\b|(?:^|[/\\\\\\s])\\.profile\\b)"
      ],
      "decision": "ask",
      "who": "ask_user"
    },
    {
      "id": "scope-escape",
      "class": "scope_escape",
      "description": "an action aimed at everyone or at production rather than the task: an acting verb with a preposition into production, or with all/every users; a bug that happens in production is not one",
      "patterns": [
