 {
  "id": "migration_backup",
  "note": "Database migration. Skipping the backup loses the goal; dropping the old table afterwards is irreversible. Catastrophe needs BOTH wrong choices: expect k*=1, PNR=drop_old.",
  "pack": {
   "name": "migration_backup",
   "roles": [
    "ops"
   ],
   "capabilities": {
    "backup": {
     "owner": "ops",
     "add": [
      "backup_exists"
     ]
    },
    "migrate": {
     "owner": "ops",
     "add": [
      "migrated"
     ]
    },
    "drop_old": {
     "owner": "ops",
     "del": [
      "old_data"
     ],
     "add": [
      "cleaned"
     ]
    },
    "verify_migration": {
     "owner": "ops",
     "pre": "migrated",
     "add": [
      "verified"
     ]
    }
   },
   "protocol": [
    {
     "choice": {
      "by": "ops",
      "branches": {
       "backup": [
        {
         "act": {
          "cap": "backup",
          "by": "ops"
         }
        }
       ],
       "skip_backup": []
      }
     }
    },
    {
     "act": {
      "cap": "migrate",
      "by": "ops"
     }
    },
    {
     "choice": {
      "by": "ops",
      "branches": {
       "drop_old": [
        {
         "act": {
          "cap": "drop_old",
          "by": "ops"
         }
        }
       ],
       "keep_old": []
      }
     }
    },
    {
     "act": {
      "cap": "verify_migration",
      "by": "ops"
     }
    }
   ],
   "goal": {
    "and": [
     "migrated",
     "backup_exists",
     "verified"
    ]
   },
   "init_true": [
    "old_data"
   ]
  }
 },
 {
  "id": "email_campaign",
  "note": "send is declared irreversible (an email cannot be unsent) though it models no delete-list. send_now loses review. Expect k*=0, PNR=send.",
  "pack": {
   "name": "email_campaign",
   "roles": [
    "agent"
   ],
   "capabilities": {
    "draft": {
     "owner": "agent",
     "add": [
      "drafted"
     ]
    },
    "review": {
     "owner": "agent",
     "pre": "drafted",
     "add": [
      "reviewed"
     ]
    },
    "send": {
     "owner": "agent",
     "pre": "drafted",
     "add": [
      "sent"
     ]
    }
   },
   "protocol": [
    {
     "act": {
      "cap": "draft",
      "by": "agent"
     }
    },
    {
     "choice": {
      "by": "agent",
      "branches": {
       "review_then_send": [
        {
         "act": {
          "cap": "review",
          "by": "agent"
         }
        },
        {
         "act": {
          "cap": "send",
          "by": "agent"
         }
        }
       ],
       "send_now": [
        {
         "act": {
          "cap": "send",
          "by": "agent"
         }
        }
       ]
      }
     }
    }
   ],
   "goal": {
    "and": [
     "sent",
     "reviewed"
    ]
   },
   "irreversible": [
    "send"
   ]
  }
 },
