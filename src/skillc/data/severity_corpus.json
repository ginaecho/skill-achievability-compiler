[
 {
  "id": "booking_fastpath",
  "note": "Paper's running example. fast skips verification; purchase spends funds irreversibly. Expect k*=0, PNR=purchase.",
  "pack": {
   "name": "booking_fastpath",
   "roles": [
    "p",
    "q"
   ],
   "capabilities": {
    "verify": {
     "owner": "q",
     "add": [
      "verified"
     ]
    },
    "purchase": {
     "owner": "q",
     "add": [
      "booked"
     ],
     "del": [
      "funds"
     ]
    }
   },
   "protocol": [
    {
     "choice": {
      "by": "p",
      "branches": {
       "safe": [
        {
         "msg": {
          "from": "p",
          "to": "q",
          "label": "safe"
         }
        },
        {
         "act": {
          "cap": "verify",
          "by": "q"
         }
        },
        {
         "act": {
          "cap": "purchase",
          "by": "q"
         }
        }
       ],
       "fast": [
        {
         "msg": {
          "from": "p",
          "to": "q",
          "label": "fast"
         }
        },
        {
         "act": {
          "cap": "purchase",
          "by": "q"
         }
        }
       ]
      },
      "to": "q"
     }
    }
   ],
   "goal": {
    "and": [
     "booked",
     "verified"
    ]
   },
   "init_true": [
    "funds"
   ]
  }
 },
