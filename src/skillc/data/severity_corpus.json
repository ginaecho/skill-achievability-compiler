 {
  "id": "order_fulfilment",
  "note": "The bank's approve/decline is an environment move (external, demonic). ship is irreversible. ship_then_charge ships before knowing the answer: on decline the order is shipped AND refunded -- the second goal disjunct requires not-shipped, so neither holds. Expect k*=0, PNR=ship. charge_then_ship is safe because charge is reversible via refund.",
  "pack": {
   "name": "order_fulfilment",
   "roles": [
    "agent",
    "bank"
   ],
   "capabilities": {
    "reserve": {
     "owner": "agent",
     "add": [
      "reserved"
     ]
    },
    "charge": {
     "owner": "agent",
     "add": [
      "charged"
     ],
     "del": [
      "unpaid"
     ]
    },
    "refund": {
     "owner": "agent",
     "pre": "charged",
     "add": [
      "unpaid"
     ],
     "del": [
      "charged"
     ]
    },
    "ship": {
     "owner": "agent",
     "pre": "reserved",
     "add": [
      "shipped"
     ]
    },
    "cancel": {
     "owner": "agent",
     "add": [
      "cancelled"
     ]
    }
   },
   "protocol": [
    {
     "act": {
      "cap": "reserve",
      "by": "agent"
     }
    },
    {
     "choice": {
      "by": "agent",
      "branches": {
       "charge_then_ship": [
        {
         "act": {
          "cap": "charge",
          "by": "agent"
         }
        },
        {
         "choice": {
          "by": "bank",
          "branches": {
           "approved": [
            {
             "act": {
              "cap": "ship",
              "by": "agent"
             }
            }
           ],
           "declined": [
            {
             "act": {
              "cap": "refund",
              "by": "agent"
             }
            },
            {
             "act": {
              "cap": "cancel",
              "by": "agent"
             }
            }
           ]
          },
          "external": true,
          "to": "agent"
         }
        }
       ],
       "ship_then_charge": [
        {
         "act": {
          "cap": "ship",
          "by": "agent"
         }
        },
        {
         "act": {
          "cap": "charge",
          "by": "agent"
         }
        },
        {
         "choice": {
          "by": "bank",
          "branches": {
           "approved": [],
           "declined": [
            {
             "act": {
              "cap": "refund",
              "by": "agent"
             }
            },
            {
             "act": {
              "cap": "cancel",
              "by": "agent"
             }
            }
           ]
          },
          "external": true,
          "to": "agent"
         }
        }
       ]
      },
      "to": "bank"
     }
    }
   ],
   "goal": {
    "or": [
     {
      "and": [
       "shipped",
       "charged"
      ]
     },
     {
      "and": [
       "cancelled",
       "unpaid",
       {
        "not": "shipped"
       }
      ]
     }
    ]
   },
   "init_true": [
    "unpaid"
   ],
   "irreversible": [
    "ship"
   ]
  }
 },
 {
  "id": "retry_then_purge",
  "note": "A retry loop (regular protocol). retry keeps the goal reachable; give_up_and_purge destroys records with the goal lost. Expect k*=0, PNR=purge; exercises Regular.v's loop/budget interaction.",
  "pack": {
   "name": "retry_then_purge",
   "roles": [
    "agent"
   ],
   "capabilities": {
    "attempt": {
     "owner": "agent",
     "add": [
      "attempted"
     ]
    },
    "record_ok": {
     "owner": "agent",
     "pre": "attempted",
     "add": [
      "done"
     ]
    },
    "purge": {
     "owner": "agent",
     "del": [
      "records"
     ],
     "add": [
      "purged"
     ]
    }
   },
   "protocol": [
    {
     "rec": {
      "name": "L",
      "body": [
       {
        "act": {
         "cap": "attempt",
         "by": "agent"
        }
       },
       {
        "choice": {
         "by": "agent",
         "branches": {
          "ok": [
           {
            "act": {
             "cap": "record_ok",
             "by": "agent"
            }
           }
          ],
          "fail": [
           {
            "choice": {
             "by": "agent",
             "branches": {
              "retry": [
               {
                "continue": "L"
               }
              ],
              "give_up_and_purge": [
               {
                "act": {
                 "cap": "purge",
                 "by": "agent"
                }
               }
              ]
             }
            }
           }
          ]
         }
        }
       }
      ]
     }
    }
   ],
   "goal": "done",
   "init_true": [
    "records"
   ]
  }
 },
 {
  "id": "shipping_detour",
