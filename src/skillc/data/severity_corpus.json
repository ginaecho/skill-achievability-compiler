 {
  "id": "deploy_with_rollback",
  "note": "deploy deletes old_version_live, but rollback re-establishes it, so deploy is NOT a point of no return. deploy_now loses the goal (no canary) but harms nothing. Expect tolerant at every k; the wrong branch is Futile.",
  "pack": {
   "name": "deploy_with_rollback",
   "roles": [
    "ops"
   ],
   "capabilities": {
    "canary": {
     "owner": "ops",
     "add": [
      "canary_ok"
     ]
    },
    "deploy": {
     "owner": "ops",
     "add": [
      "deployed"
     ],
     "del": [
      "old_version_live"
     ]
    },
    "rollback": {
     "owner": "ops",
     "pre": "deployed",
     "add": [
      "old_version_live"
     ],
     "del": [
      "deployed"
     ]
    },
    "smoke_test": {
     "owner": "ops",
     "pre": "deployed",
     "add": [
      "tested"
     ]
    }
   },
   "protocol": [
    {
     "choice": {
      "by": "ops",
      "branches": {
       "canary_first": [
        {
         "act": {
          "cap": "canary",
          "by": "ops"
         }
        },
        {
         "act": {
          "cap": "deploy",
          "by": "ops"
         }
        }
       ],
       "deploy_now": [
        {
         "act": {
          "cap": "deploy",
          "by": "ops"
         }
        }
       ]
      }
     }
    },
    {
     "act": {
      "cap": "smoke_test",
      "by": "ops"
     }
    }
   ],
   "goal": {
    "and": [
     "deployed",
     "canary_ok",
     "tested"
    ]
   },
   "init_true": [
    "old_version_live"
   ]
  }
 },
