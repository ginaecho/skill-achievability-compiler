  "pack": {
   "name": "release_with_audit",
   "roles": [
    "ops",
    "auditor"
   ],
   "init_true": [
    "old_live"
   ],
   "capabilities": {
    "canary": {
     "owner": "ops",
     "add": [
      "canary_ok"
     ]
    },
    "deploy": {
     "owner": "ops",
     "add": [
      "deployed"
     ],
     "del": [
      "old_live"
     ]
    },
    "smoke_test": {
     "owner": "ops",
     "pre": "deployed",
     "add": [
      "tested"
     ]
    },
    "log": {
     "owner": "auditor",
     "add": [
      "logged"
     ]
    }
   },
   "goal": {
    "and": [
     "deployed",
     "canary_ok",
     "tested"
    ]
   },
   "protocol": [
    {
     "choice": {
      "by": "ops",
      "branches": {
       "canary_first": [
        {
         "act": {
          "cap": "canary",
          "by": "ops"
         }
        },
        {
         "act": {
          "cap": "deploy",
          "by": "ops"
         }
        }
       ],
       "deploy_now": [
        {
         "act": {
          "cap": "deploy",
          "by": "ops"
         }
        }
       ]
      },
      "to": "auditor"
     }
    },
    {
     "act": {
      "cap": "log",
      "by": "auditor"
     }
    },
    {
     "act": {
      "cap": "smoke_test",
      "by": "ops"
     }
    }
   ]
  }
